#!/bin/bash
# Refresh the OPR advisory sidecar without rebuilding any package.
# (omacom/omarchy-pkgs#378, first milestone)
#
# Reads the channel's pacman database for the published package set, merges
# per-package CVE reports from a feed directory, and writes one file per
# artifact:
#   <repo>/<channel>/<arch>/<pkgname>-<pkgver>-<pkgrel>-<arch>.advisory.json
#   plus a detached .sig, beside the package archive
# A refresh replaces only the artifacts whose advisory changed. Package
# archives are never touched.
#
# Feed directory layout (OPR-operated ingest input, not checked-in CVE data):
#   <feed>/<pkgname>/<pkgver>-<pkgrel>/<arch>.json
#   e.g. feed/mise-bin/1.0.0-1/x86_64.json:
#   {
#     "pkgname": "mise-bin", "pkgver": "1.0.0", "pkgrel": "1", "arch": "x86_64",
#     "cve_ids": ["CVE-2026-12345"],
#     "cve_max_severity": "HIGH", "severity_scale": "CVSSv3",
#     "advisory_as_of": "2026-09-10T00:00:00Z",
#     "scan_source": "osv.dev", "note": "optional context"
#   }
# A missing file means "not yet scanned" (scan_status=missing, fail-open).
# A feed for another version never stamps the live package.
# An unreadable file or a severity without a scale means scan_status=error.
# Preferred live source is OSV (https://osv.dev); NVD/vendor feeds map onto
# the same fields. Only the fields above are read; unknown keys are ignored.
#
# Usage:
#   bin/sync-advisories [--mirror edge] [--arch x86_64] [--package mise-bin...]
#                       [--feed ./advisories-feed] [--stale-after 72h]
#                       [--dry-run] [--no-sign]

set -euo pipefail

BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
# shellcheck source=../helpers/paths.sh
source "$BUILD_ROOT/helpers/paths.sh"
# shellcheck source=../helpers/message-helpers.sh
source "$BUILD_ROOT/helpers/message-helpers.sh"
# shellcheck source=../helpers/advisory-helpers.sh
source "$BUILD_ROOT/helpers/advisory-helpers.sh"

FEED_DIR=""
STALE_AFTER="72h"
DRY_RUN=false
NO_SIGN=false
PACKAGES=()

usage() {
  cat <<EOF
Usage: $0 [OPTIONS]

Refresh OPR advisory files for one channel/arch without rebuilding.

Options:
  --mirror <edge|rc|stable>   Channel (default: edge; --channel is accepted too)
  --channel <name>            Alias for --mirror
  --arch <x86_64|aarch64>     Architecture (default: x86_64)
  --package <names...>        Refresh only the named package(s)
  --feed <dir>                Versioned JSON feed dir (default: ./advisories-feed;
                              <pkgname>/<pkgver>-<pkgrel>/<arch>.json)
  --stale-after <duration>    Mark scans older than this stale (default: 72h;
                              bare seconds or s/m/h/d suffix)
  --dry-run                   Show the plan; write nothing
  --no-sign                   Write advisory files without a detached .sig
  -h, --help                  Show this help message
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  --mirror | --channel)
    [[ $# -ge 2 ]] || {
      print_error "$1 requires a value"
      exit 1
    }
    MIRROR="$2"
    require_valid_mirror "$MIRROR"
    update_arch_paths
    shift 2
    ;;
  --arch)
    [[ $# -ge 2 ]] || {
      print_error "--arch requires a value"
      exit 1
    }
    require_valid_arch "$2"
    ARCH="$2"
    update_arch_paths
    shift 2
    ;;
  --package)
    shift
    while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do
      PACKAGES+=("$1")
      shift
    done
    [[ ${#PACKAGES[@]} -gt 0 ]] || {
      print_error "--package requires at least one package name"
      exit 1
    }
    ;;
  --feed)
    [[ $# -ge 2 ]] || {
      print_error "--feed requires a value"
      exit 1
    }
    FEED_DIR="$2"
    shift 2
    ;;
  --stale-after)
    [[ $# -ge 2 ]] || {
      print_error "--stale-after requires a value"
      exit 1
    }
    STALE_AFTER="$2"
    shift 2
    ;;
  --dry-run)
    DRY_RUN=true
    shift
    ;;
  --no-sign)
    NO_SIGN=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    print_error "Unknown option: $1"
    usage >&2
    exit 1
    ;;
  esac
done

[[ -z "$FEED_DIR" ]] && FEED_DIR="$BUILD_ROOT/advisories-feed"
STALE_SECONDS=$(advisory_duration_seconds "$STALE_AFTER") || {
  print_error "Invalid --stale-after value: $STALE_AFTER (use e.g. 72h, 2d, 3600)"
  exit 1
}

DB_FILE="$REPO_DIR/omarchy.db.tar.zst"
[[ -f "$DB_FILE" ]] || {
  print_error "Repository database not found: $DB_FILE"
  exit 1
}
NOW_UTC=$(date -u +%Y-%m-%dT%H:%M:%SZ)
NOW_EPOCH=$(date -u +%s)

print_header "Sync Advisories ($MIRROR/$ARCH)"
print_info "Database: $DB_FILE"
print_info "Advisories: $REPO_DIR/*.advisory.json"
print_info "Feed:     $FEED_DIR"
print_info "Stale after: $STALE_AFTER"
[[ ${#PACKAGES[@]} -gt 0 ]] && print_info "Packages: ${PACKAGES[*]}"

# Manifest: NAME<TAB>VERSION(pkgver-pkgrel)<TAB>ARCH<TAB>FILENAME per db entry.
read_db_manifest() {
  tar -xOf "$DB_FILE" --wildcards '*/desc' 2>/dev/null | awk '
    function emit() {
      if (name != "" && version != "" && filename != "")
        printf "%s\t%s\t%s\t%s\n", name, version, arch, filename
      name=""; version=""; arch=""; filename=""
    }
    $0 == "%FILENAME%" { emit(); getline; filename=$0; next }
    $0 == "%NAME%" { getline; name=$0; next }
    $0 == "%VERSION%" { getline; version=$0; next }
    $0 == "%ARCH%" { getline; arch=$0; next }
    END { emit() }
  '
}

package_wanted() {
  [[ ${#PACKAGES[@]} -eq 0 ]] && return 0
  local name="$1"
  local want
  for want in "${PACKAGES[@]}"; do
    [[ "$want" == "$name" ]] && return 0
  done
  return 1
}

split_pkgver_pkgrel() {
  # VERSION is pkgver-pkgrel where pacman splits on the LAST hyphen.
  local version="$1"
  local pkgrel="${version##*-}"
  local pkgver="${version%-*}"
  printf '%s\t%s\n' "$pkgver" "$pkgrel"
}

iso_of_file_mtime() {
  date -u -d "@$(stat -c %Y "$1")" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null ||
    date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ
}

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
ENTRIES="$WORK/entries.jsonl"
: >"$ENTRIES"

OK_COUNT=0
STALE_COUNT=0
MISSING_COUNT=0
ERROR_COUNT=0

while IFS=$'\t' read -r name version db_arch filename; do
  package_wanted "$name" || continue
  IFS=$'\t' read -r pkgver pkgrel < <(split_pkgver_pkgrel "$version")
  key=$(advisory_identity_key "$name" "$pkgver" "$pkgrel" "$ARCH")
  feed=$(advisory_feed_path "$FEED_DIR" "$name" "$pkgver" "$pkgrel" "$ARCH")

  if [[ ! -f "$feed" ]]; then
    MISSING_COUNT=$((MISSING_COUNT + 1))
    jq -c -n --arg key "$key" --arg name "$name" --arg pkgver "$pkgver" --arg pkgrel "$pkgrel" \
      --arg arch "$ARCH" --arg artifact "$filename" \
      '{key: $key, value: {pkgname: $name, pkgver: $pkgver, pkgrel: $pkgrel, arch: $arch,
        artifact: $artifact, cve_ids: [], cve_max_severity: "NONE",
        severity_scale: "CVSSv3", advisory_as_of: null, scanned_at: null,
        scan_source: null, scan_status: "missing",
        note: "Not yet scanned by OPR ingest; visible, fail-open."}}' \
      >>"$ENTRIES"
    continue
  fi

  if ! feed_json=$(jq -c '.' "$feed" 2>/dev/null); then
    ERROR_COUNT=$((ERROR_COUNT + 1))
    jq -c -n --arg key "$key" --arg name "$name" --arg pkgver "$pkgver" --arg pkgrel "$pkgrel" \
      --arg arch "$ARCH" --arg artifact "$filename" --arg now "$NOW_UTC" \
      --arg source "feed-parse" \
      '{key: $key, value: {pkgname: $name, pkgver: $pkgver, pkgrel: $pkgrel, arch: $arch,
        artifact: $artifact, cve_ids: [], cve_max_severity: "UNKNOWN",
        severity_scale: "CVSSv3", advisory_as_of: null, scanned_at: $now,
        scan_source: $source, scan_status: "error",
        note: "OPR ingest could not parse the feed report; visible, fail-open."}}' \
      >>"$ENTRIES"
    continue
  fi

  feed_name=$(jq -r '.pkgname // empty' <<<"$feed_json")
  feed_pkgver=$(jq -r '.pkgver // empty' <<<"$feed_json")
  feed_pkgrel=$(jq -r '.pkgrel // empty' <<<"$feed_json")
  feed_arch=$(jq -r '.arch // empty' <<<"$feed_json")
  if [[ -n $feed_name && $feed_name != "$name" ]] ||
    [[ -n $feed_pkgver && $feed_pkgver != "$pkgver" ]] ||
    [[ -n $feed_pkgrel && $feed_pkgrel != "$pkgrel" ]] ||
    [[ -n $feed_arch && $feed_arch != "$ARCH" ]]; then
    ERROR_COUNT=$((ERROR_COUNT + 1))
    jq -c -n --arg key "$key" --arg name "$name" --arg pkgver "$pkgver" --arg pkgrel "$pkgrel" \
      --arg arch "$ARCH" --arg artifact "$filename" --arg now "$NOW_UTC" \
      '{key: $key, value: {pkgname: $name, pkgver: $pkgver, pkgrel: $pkgrel, arch: $arch,
        artifact: $artifact, cve_ids: [], cve_max_severity: "UNKNOWN",
        severity_scale: "CVSSv3", advisory_as_of: null, scanned_at: $now,
        scan_source: "feed-identity", scan_status: "error",
        note: "Feed identity does not match the published package version; visible, fail-open."}}' \
      >>"$ENTRIES"
    continue
  fi

  cve_ids=$(jq -c '.cve_ids // []' <<<"$feed_json")
  severity=$(jq -r '.cve_max_severity // "NONE"' <<<"$feed_json")
  scale=$(jq -r '.severity_scale // "CVSSv3"' <<<"$feed_json")
  advisory_as_of=$(jq -r '.advisory_as_of // ""' <<<"$feed_json")
  scan_source=$(jq -r '.scan_source // "osv.dev"' <<<"$feed_json")
  note=$(jq -r '.note // ""' <<<"$feed_json")
  scanned_at=$(jq -r '.scanned_at // empty' <<<"$feed_json")
  [[ -z "$advisory_as_of" ]] && advisory_as_of=$(iso_of_file_mtime "$feed")
  [[ -z "$scanned_at" ]] && scanned_at="$NOW_UTC"

  # A claimed severity without a stated scale is a feed bug: fail closed on
  # the entry (status=error), fail open on policy (never block).
  if [[ "$severity" != "NONE" && "$severity" != "UNKNOWN" && -z "$scale" ]]; then
    ERROR_COUNT=$((ERROR_COUNT + 1))
    jq -c -n --arg key "$key" --arg name "$name" --arg pkgver "$pkgver" --arg pkgrel "$pkgrel" \
      --arg arch "$ARCH" --arg artifact "$filename" --arg now "$NOW_UTC" \
      --argjson cve_ids "$cve_ids" --arg severity "$severity" \
      --arg as_of "$advisory_as_of" --arg source "$scan_source" \
      '{key: $key, value: {pkgname: $name, pkgver: $pkgver, pkgrel: $pkgrel, arch: $arch,
        artifact: $artifact, cve_ids: $cve_ids, cve_max_severity: $severity,
        severity_scale: "", advisory_as_of: $as_of, scanned_at: $now,
        scan_source: $source, scan_status: "error",
        note: "Feed claimed a severity without stating its scale; needs OPR triage."}}' \
      >>"$ENTRIES"
    continue
  fi

  as_of_epoch=$(date -u -d "$advisory_as_of" +%s 2>/dev/null || echo 0)
  if [[ "$as_of_epoch" -le 0 ]]; then
    ERROR_COUNT=$((ERROR_COUNT + 1))
    jq -c -n --arg key "$key" --arg name "$name" --arg pkgver "$pkgver" --arg pkgrel "$pkgrel" \
      --arg arch "$ARCH" --arg artifact "$filename" --arg now "$NOW_UTC" \
      --argjson cve_ids "$cve_ids" --arg severity "$severity" \
      --arg scale "$scale" --arg as_of "$advisory_as_of" --arg source "$scan_source" \
      --arg note "$note" \
      '{key: $key, value: {pkgname: $name, pkgver: $pkgver, pkgrel: $pkgrel, arch: $arch,
        artifact: $artifact, cve_ids: $cve_ids, cve_max_severity: $severity,
        severity_scale: $scale, advisory_as_of: $as_of, scanned_at: $now,
        scan_source: $source, scan_status: "error",
        note: (if $note == "" then "Feed advisory timestamp is unreadable; needs OPR triage." else $note end)}}' \
      >>"$ENTRIES"
    continue
  fi

  age=$((NOW_EPOCH - as_of_epoch))
  if [[ "$age" -gt "$STALE_SECONDS" ]]; then
    status="stale"
    STALE_COUNT=$((STALE_COUNT + 1))
    status_note="Scan is older than $STALE_AFTER; visible, fail-open."
    [[ -n "$note" ]] && status_note="$note"
  else
    status="ok"
    OK_COUNT=$((OK_COUNT + 1))
    status_note="$note"
  fi

  jq -c -n --arg key "$key" --arg name "$name" --arg pkgver "$pkgver" --arg pkgrel "$pkgrel" \
    --arg arch "$ARCH" --arg artifact "$filename" --arg now "$NOW_UTC" \
    --argjson cve_ids "$cve_ids" --arg severity "$severity" \
    --arg scale "$scale" --arg as_of "$advisory_as_of" --arg source "$scan_source" \
    --arg status "$status" --arg note "$status_note" --arg scanned_at "$scanned_at" \
    '{key: $key, value: {pkgname: $name, pkgver: $pkgver, pkgrel: $pkgrel, arch: $arch,
      artifact: $artifact, cve_ids: $cve_ids, cve_max_severity: $severity,
      severity_scale: $scale, advisory_as_of: $as_of, scanned_at: $scanned_at,
      scan_source: $source, scan_status: $status, note: $note}}' \
    >>"$ENTRIES"
done < <(read_db_manifest)

print_info "ok=$OK_COUNT stale=$STALE_COUNT missing=$MISSING_COUNT error=$ERROR_COUNT"

sign_advisory_file() {
  local path="$1"
  if [[ -n "${GPG_PRIVATE_KEY:-}" && -n "${GPG_PASSPHRASE:-}" ]]; then
    local key_home key_id
    key_home=$(mktemp -d)
    chmod 700 "$key_home"
    echo "$GPG_PRIVATE_KEY" | GNUPGHOME="$key_home" gpg --batch --import 2>/dev/null
    key_id=$(GNUPGHOME="$key_home" gpg --list-secret-keys --keyid-format LONG 2>/dev/null |
      grep "^sec" | head -1 | awk '{print $2}' | cut -d/ -f2)
    GNUPGHOME="$key_home" gpg --batch --yes --pinentry-mode loopback \
      --passphrase "$GPG_PASSPHRASE" --detach-sign --no-armor \
      --local-user "$key_id" -o "$path.sig" "$path"
    rm -rf "$key_home"
    return 0
  fi
  if command -v gpg >/dev/null 2>&1 && gpg --list-secret-keys >/dev/null 2>&1; then
    gpg --batch --yes --detach-sign --no-armor -o "$path.sig" "$path"
    return 0
  fi
  return 1
}

WROTE=0
UNCHANGED=0
while IFS= read -r row; do
  [[ -n "$row" ]] || continue
  name=$(jq -r '.value.pkgname' <<<"$row")
  pkgver=$(jq -r '.value.pkgver' <<<"$row")
  pkgrel=$(jq -r '.value.pkgrel' <<<"$row")
  arch=$(jq -r '.value.arch' <<<"$row")
  filename=$(advisory_artifact_name "$name" "$pkgver" "$pkgrel" "$arch")
  rendered="$WORK/$filename"
  jq -c -S --argjson schema "$ADVISORY_SCHEMA_VERSION" '.value + {schema: $schema}' <<<"$row" >"$rendered"
  advisory_validate_sidecar "$rendered"
  dest="$REPO_DIR/$filename"
  if [[ -f "$dest" ]] && cmp -s "$rendered" "$dest"; then
    UNCHANGED=$((UNCHANGED + 1))
  elif [[ "$DRY_RUN" == true ]]; then
    echo "  would write: $filename"
    WROTE=$((WROTE + 1))
  else
    cp "$rendered" "$dest"
    WROTE=$((WROTE + 1))
    if [[ "$NO_SIGN" == true ]]; then
      rm -f "$dest.sig"
    elif sign_advisory_file "$dest"; then
      :
    else
      print_warning "No GPG key available; leaving $filename unsigned"
    fi
  fi
  # Drop a file left by the earlier advisories/ subdirectory layout.
  if [[ "$DRY_RUN" != true ]]; then
    legacy="$REPO_DIR/advisories/${name}-${pkgver}-${pkgrel}-${arch}.json"
    rm -f "$legacy" "$legacy.sig"
  fi
done <"$ENTRIES"

print_info "wrote=$WROTE unchanged=$UNCHANGED"

if [[ "$DRY_RUN" == true ]]; then
  print_warning "Dry run: advisory files unchanged"
  exit 0
fi

# The channel-wide document and the advisories/ directory are not the
# published form. Drop a leftover copy so readers do not keep using it.
rm -f "$REPO_DIR/omarchy.advisories.json" "$REPO_DIR/omarchy.advisories.json.sig"
rmdir "$REPO_DIR/advisories" 2>/dev/null || true
print_success "Advisory files are beside their packages in $REPO_DIR (package archives unchanged)"
