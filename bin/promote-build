#!/bin/bash
# Promote only the sealed, signed artifacts in the host-owned build manifest.
set -euo pipefail

BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
source "$BUILD_ROOT/helpers/message-helpers.sh"
source "$BUILD_ROOT/helpers/paths.sh"
source "$BUILD_ROOT/helpers/lock-helpers.sh"
source "$BUILD_ROOT/helpers/docker-helpers.sh"

DRY_RUN=false
while [[ $# -gt 0 ]]; do
  case $1 in
    --arch) ARCH=$2; require_valid_arch "$ARCH"; update_arch_paths; shift 2 ;;
    --mirror) MIRROR=$2; require_valid_mirror "$MIRROR"; update_arch_paths; shift 2 ;;
    --dry-run) DRY_RUN=true; shift ;;
    -h|--help)
      echo "Usage: $0 [--arch <arch>] [--mirror <channel>] [--dry-run]"
      echo "Promote the verified build manifest; --dry-run previews unsigned approved outputs."
      exit 0
      ;;
    *) print_error "Unknown option: $1"; exit 1 ;;
  esac
done
require_valid_arch "$ARCH"
require_valid_mirror "$MIRROR"
acquire_release_lock || exit 1

print_header "Promote Build to Production"
if [[ ! -f "$PUBLICATION_MANIFEST" ]]; then
  shopt -s nullglob
  pending=("$BUILD_OUTPUT_DIR"/*.pkg.tar.zst)
  if (( ${#pending[@]} )); then
    print_error "No approved build manifest. Rebuild or explicitly approve the selected prebuilt jobs."
    exit 1
  fi
  print_info "No approved packages to promote"
  exit 0
fi

check_engine
TOOL_ARCH=$(docker_native_arch)
build_docker_image "$BUILD_DIR" "$TOOL_ARCH" "$MIRROR"
user_args=()
[[ "$CONTAINER_ENGINE" != docker ]] || user_args=(--user "$(id -u):$(id -g)")
verify_args=()
[[ $DRY_RUN != true ]] || verify_args=(--unsigned)
listing=$("$CONTAINER_ENGINE" run "${CONTAINER_RUN_ARGS[@]}" --rm "${user_args[@]}" \
  "$(get_platform_arg "$TOOL_ARCH")" -e ARCH="$ARCH" -e MIRROR="$MIRROR" \
  -v "$BUILD_ROOT/build-output:/build-output:ro" -v "$PUBLICATION_DIR:/publication:ro" \
  -v "$BUILD_DIR:/build:ro" -v "$BUILD_ROOT/helpers:/helpers:ro" -v "$PKGBUILDS_DIR:/pkgbuilds:ro" \
  "omarchy-pkg-builder:latest-$TOOL_ARCH-$MIRROR" /build/verify-publication.sh "${verify_args[@]}")
mapfile -t packages <<< "$listing"

if [[ $DRY_RUN == true ]]; then
  printf '  - %s\n' "${packages[@]}"
  exit 0
fi

mkdir -p "$REPO_DIR"
declare -A present=()
for filename in "${packages[@]}"; do
  if [[ -e "$REPO_DIR/$filename" || -L "$REPO_DIR/$filename" ]]; then
    if [[ ! -L "$REPO_DIR/$filename" && -f "$REPO_DIR/$filename" ]] &&
      cmp -s "$PUBLICATION_DIR/packages/$filename" "$REPO_DIR/$filename"; then
      present["$filename"]=1
    else
      print_error "Refusing to replace published package with different contents: $filename"
      exit 1
    fi
  fi
done

staged=""
trap '[[ -z ${staged:-} ]] || rm -f -- "$staged"' EXIT
publish_file() {
  staged=$(mktemp "$REPO_DIR/.publish.XXXXXX")
  install -m644 -- "$1" "$staged"
  mv -T -- "$staged" "$2"
  staged=""
}

for filename in "${packages[@]}"; do
  if [[ -z ${present[$filename]:-} ]]; then
    publish_file "$PUBLICATION_DIR/packages/$filename" "$REPO_DIR/$filename"
  fi
  # Keep a prior signature for byte-identical packages, preserving idempotence.
  if [[ -z ${present[$filename]:-} || ! -f "$REPO_DIR/$filename.sig" ]]; then
    publish_file "$PUBLICATION_DIR/signatures/$filename.sig" "$REPO_DIR/$filename.sig"
  fi
done

# Only the manifest's files are ours to remove; other staged files stay unsigned.
for filename in "${packages[@]}"; do
  rm -f -- "$BUILD_OUTPUT_DIR/$filename" "$BUILD_OUTPUT_DIR/$filename.sig"
done
rm -f "$BUILD_OUTPUT_DIR"/omarchy-build.db* "$BUILD_OUTPUT_DIR"/omarchy-build.files*
# Keep the complete sealed input until promotion and staging cleanup finish, so
# an interrupted run can repeat verification. Retire approval before its files.
rm -f "$PUBLICATION_MANIFEST"
for filename in "${packages[@]}"; do
  rm -f -- "$PUBLICATION_DIR/packages/$filename" "$PUBLICATION_DIR/signatures/$filename.sig"
done
rm -f "$PUBLICATION_DIR/manifest.json.sig" "$PUBLICATION_DIR/signing-key.gpg"
print_success "Promoted ${#packages[@]} verified package(s)"
