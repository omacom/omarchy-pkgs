#!/bin/bash
# Sign the host-approved publication manifest and sealed package copies.

set -euo pipefail

BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
source "$BUILD_ROOT/helpers/message-helpers.sh"
source "$BUILD_ROOT/helpers/docker-helpers.sh"
source "$BUILD_ROOT/helpers/paths.sh"
source "$BUILD_ROOT/helpers/lock-helpers.sh"

print_header "Sign Packages"

# Parse arguments
while (( $# > 0 )); do
  case $1 in
  --arch)
    (( $# >= 2 )) || { print_error "Missing --arch value"; exit 1; }
    ARCH="$2"
    shift 2
    ;;
  --mirror)
    (( $# >= 2 )) || { print_error "Missing --mirror value"; exit 1; }
    MIRROR="$2"
    shift 2
    ;;
  -h | --help)
    echo "Usage: $0 [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --arch <arch>      Target architecture (x86_64 or aarch64, default: x86_64)"
    echo "  --mirror <mirror>  Mirror to use (edge, rc, or stable, default: edge)"
    echo "  -h, --help         Show this help message"
    echo ""
    echo "This script signs the approved publication handoff."
    exit 0
    ;;
  *)
    print_error "Unknown option: $1"
    exit 1
    ;;
  esac
done

require_valid_arch "$ARCH"
require_valid_mirror "$MIRROR"
update_arch_paths
acquire_release_lock

print_info "Target architecture: $ARCH"
print_info "Mirror: $MIRROR"
print_info "Build output: $BUILD_OUTPUT_DIR"

# Check the selected container engine is available
check_engine

# Signing is architecture-independent, so run its utility container natively
# on either an x86_64 or ARM host.
TOOL_ARCH=$(docker_native_arch) || {
  print_error "Unsupported host architecture: $(uname -m)"
  exit 1
}
build_docker_image "$BUILD_DIR" "$TOOL_ARCH" "$MIRROR"

print_info "Running package signing..."

# The signer alone writes the host-owned publication area. Docker uses the
# caller's uid/gid; Podman's keep-id mapping reaches the image's builder uid.
install -d -m700 "$PUBLICATION_DIR"
run_user=()
if [[ $CONTAINER_ENGINE == "docker" ]]; then
  run_user=(--user "$(id -u):$(id -g)")
fi

# Run the signing script in the host-native image.
"$CONTAINER_ENGINE" run "${CONTAINER_RUN_ARGS[@]}" "${run_user[@]}" --rm "$(get_platform_arg "$TOOL_ARCH")" \
  -e ARCH="$ARCH" \
  -e MIRROR="$MIRROR" \
  -e GPG_PRIVATE_KEY \
  -e GPG_PASSPHRASE \
  -e PUBLICATION_DIR=/publication \
  -e PKGBUILDS_DIR=/pkgbuilds \
  -e HELPERS_DIR=/helpers \
  -v "$BUILD_ROOT/build-output:/build-output:ro" \
  -v "$PKGBUILDS_DIR:/pkgbuilds:ro" \
  -v "$BUILD_ROOT/helpers:/helpers:ro" \
  -v "$PUBLICATION_DIR:/publication" \
  -v "$BUILD_DIR:/build:ro" \
  "omarchy-pkg-builder:latest-$TOOL_ARCH-$MIRROR" /build/sign.sh
print_success "Package signing completed successfully!"
