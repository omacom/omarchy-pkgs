#!/bin/bash
# omarchy-release — the front door for cutting Omarchy releases.
#
# A release train has three human moments, each one command:
#   start  open the train: a patch gets a release branch + staging PR; a
#          minor/major advances edge -> rc (all, some or none of it) and cuts
#          its first candidate
#   rc     cut a candidate: pin PKGBUILDs to the train's head, publish to rc
#          and edge
#   ship   make it official: final pins, promote rc -> stable, tag, GH release,
#          ISO, website
#
# Run bare `omarchy-release` to be shepherded: it observes reality (branches,
# pins, published channels, tags) and offers the correct next step. Every
# subcommand is idempotent — a re-run checks what is already done and skips it.
#
# Two kinds of train. A patch (4.0.2) cherry-picks onto release branch v4-0-2
# and pins untagged 4.0.2rcN candidates from it. A minor/major (4.5.0) takes
# everything, so it follows the dev branch itself: each candidate tags its tip
# v4.5.0-rcN, and those tags are what mark the train open. Either way shipping
# tags v4.0.2 / v4.5.0, which closes it. `start` is the only place a version is
# typed.

set -e

BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
source "$BUILD_ROOT/helpers/message-helpers.sh"
source "$BUILD_ROOT/helpers/docker-helpers.sh"
source "$BUILD_ROOT/helpers/paths.sh"

UPSTREAM_URL="${OMARCHY_UPSTREAM_URL:-https://github.com/omacom/omarchy.git}"
UPSTREAM_REPO="${OMARCHY_UPSTREAM_REPO:-omacom/omarchy}"
PKGS_REPO="${OMARCHY_PKGS_REPO:-omacom/omarchy-pkgs}"
SITE_REPO="${OMARCHY_SITE_REPO:-omacom/omarchy-site}"
ISO_REPO="${OMARCHY_ISO_REPO:-omacom/omarchy-iso}"
DEV_BRANCH="${OMARCHY_DEV_BRANCH:-quattro}"

PKGS_DB_BASE="${OMARCHY_PKGS_DB_BASE:-https://pkgs.omarchy.org}"
# The first CI architecture supplies the version-ordering floor when cutting
# pins. Readiness checks below still verify every architecture CI publishes
# before an RC or final release can move forward.
OBSERVED_ARCH=$(reference_arch)
RC_DB_URL="$PKGS_DB_BASE/rc/$OBSERVED_ARCH/omarchy.db.tar.zst"
# The Arch mirrors rc and stable packages are built and run against: Arch's
# for x86_64, Arch Linux ARM's for aarch64.
RC_ARCH_MIRROR="${OMARCHY_RC_ARCH_MIRROR:-https://rc-mirror.omarchy.org}"
STABLE_ARCH_MIRROR="${OMARCHY_STABLE_ARCH_MIRROR:-https://stable-mirror.omarchy.org}"
RC_ARM_MIRROR="${OMARCHY_RC_ARM_MIRROR:-https://arm-rc-mirror.omarchy.org}"
STABLE_ARM_MIRROR="${OMARCHY_STABLE_ARM_MIRROR:-https://arm-stable-mirror.omarchy.org}"

SRCDEST_DIR="$BUILD_ROOT/.srcdest"
MIRROR_CLONE="$SRCDEST_DIR/omarchy"          # bare mirror (shared with bin/omarchy-pkgs)
WORK_CLONE="$SRCDEST_DIR/omarchy-work"       # working clone for pick/cherry-pick
RC_WORKTREE="$BUILD_ROOT/.worktrees/rc"      # pkgs repo rc branch worktree

ASSUME_YES=false

show_usage() {
  cat <<EOF
Usage: $0 [command] [options]

Run with no command to be shepherded through whatever the next step is.

Commands:
  start [X.Y.Z]      Open a release train. A patch creates branch vX-Y-Z on
                     $UPSTREAM_REPO from the previous tag and opens the
                     release-notes staging PR. A minor/major asks whether to
                     promote edge -> rc (promote.yml), then cuts its first
                     candidate from $DEV_BRANCH
  pick [pr#|sha ...] (patch) Cherry-pick merged PRs onto the release branch; with
                     no args, choose from a list of merged $DEV_BRANCH PRs
  rc                 Cut the next X.Y.ZrcN, build it into rc and carry it to edge
                     (release-rc.yml). A minor/major tags $DEV_BRANCH's tip
                     vX.Y.Z-rcN first
  ship               Tag, final pins, promote rc -> stable (promote.yml), draft
                     GitHub release, ISO (prompted), website bump
  status             Show where the train stands (read-only)
  doctor             Verify every credential and connection the flow needs
  self-test          Run helper unit tests

Options:
  --yes              Skip confirmation prompts (for scripting/CI)
  --iso / --no-iso   (rc, ship) Build the ISO without asking / skip it
  --no-wait          (rc, ship) Do not poll for the published build
  --promote-edge[="PKGBASE ..."]
                     (start, minor/major) Carry edge into rc without asking:
                     everything, or only the listed pkgbases. --yes alone
                     carries everything
  --no-promote-edge  (start, minor/major) Keep rc's packages; carry nothing
  -h, --help         Show this help
EOF
}

confirm() {
  local prompt="$1" reply
  [[ "$ASSUME_YES" == true ]] && return 0
  read -r -p "$prompt [y/N] " reply
  [[ "$reply" =~ ^[Yy]$ ]]
}

# --- version <-> branch ------------------------------------------------------

version_to_branch() { # 4.0.2 -> v4-0-2
  local v="${1#v}"
  [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  echo "v${v//./-}"
}

branch_to_version() { # v4-0-2 -> 4.0.2
  local b="$1"
  [[ "$b" =~ ^v([0-9]+)-([0-9]+)-([0-9]+)$ ]] || return 1
  echo "${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.${BASH_REMATCH[3]}"
}

version_is_patch() { # Z > 0
  [[ "$1" =~ ^[0-9]+\.[0-9]+\.([0-9]+)$ ]] && ((BASH_REMATCH[1] > 0))
}

previous_patch_tag() { # 4.0.2 -> v4.0.1
  [[ "$1" =~ ^([0-9]+\.[0-9]+)\.([0-9]+)$ ]] || return 1
  echo "v${BASH_REMATCH[1]}.$((BASH_REMATCH[2] - 1))"
}

# --- upstream queries --------------------------------------------------------

ls_remote() { git ls-remote "$UPSTREAM_URL" "$@"; }

tag_exists() { [[ -n "$(ls_remote "refs/tags/$1" | head -1)" ]]; }

branch_head() { ls_remote "refs/heads/$1" | awk '{print $1}'; }

resolve_tag_commit() {
  local tag="$1" peeled sha
  peeled=$(ls_remote "refs/tags/$tag^{}" | awk '{print $1}')
  sha=$(ls_remote "refs/tags/$tag" | awk '{print $1}')
  echo "${peeled:-$sha}"
}

upstream_tags() { ls_remote --tags 'refs/tags/v*' | awk -F/ '!/\^\{\}$/{print $3}'; }

rc_tag() { echo "v$1-rc$2"; } # 4.5.0 3 -> v4.5.0-rc3

# Reads tag names on stdin. Versions with at least one vX.Y.Z-rcN tag: the
# minor/major trains that have cut a candidate.
rc_tag_versions() {
  sed -nE 's/^v([0-9]+\.[0-9]+\.[0-9]+)-rc[0-9]+$/\1/p' | sort -u
}

# Reads tag names on stdin. The highest N among v<version>-rcN; empty when the
# train has none yet.
newest_rc_number() { # newest_rc_number <version>
  sed -nE "s/^v${1//./\\.}-rc([0-9]+)\$/\\1/p" | sort -n | tail -1
}

# The newest release train as "<version> <ref>", optionally only untagged
# ones. <ref> is the release branch vX-Y-Z for a patch train and $DEV_BRANCH
# for a minor/major one. Shipping tags the version, so "tag exists" is what
# closes a train — but ship itself also needs to find a tagged train whose
# remaining steps (release, ISO, website) didn't finish, so it can resume.
newest_train() { # newest_train [--untagged]
  local untagged_only=false
  [[ "${1:-}" == "--untagged" ]] && untagged_only=true
  local tags branch ver ref best_ver="" best_ref=""
  tags=$(upstream_tags)
  while read -r ver ref; do
    [[ -n "$ver" ]] || continue
    if [[ "$untagged_only" == true ]] && grep -Fxq "v$ver" <<<"$tags"; then
      continue
    fi
    if [[ -z "$best_ver" ]] || [[ $(vercmp "$ver" "$best_ver") -gt 0 ]]; then
      best_ver="$ver" best_ref="$ref"
    fi
  done < <(
    while IFS= read -r branch; do
      ver=$(branch_to_version "$branch") && echo "$ver $branch"
    done < <(ls_remote 'refs/heads/v*' | awk -F/ '{print $3}')
    rc_tag_versions <<<"$tags" | sed "s|\$| $DEV_BRANCH|"
  )
  [[ -n "$best_ver" ]] && echo "$best_ver $best_ref"
}

open_train() { newest_train --untagged; }

follows_dev_branch() { [[ "$1" == "$DEV_BRANCH" ]]; } # follows_dev_branch <ref>

# Reads go over anonymous HTTPS; pushes go over SSH like every checkout the
# operator owns. Pushing over HTTPS would drag in git's credential-helper
# config, which breaks the moment a stale absolute gh path is baked into it.
ssh_push_url() { # https://github.com/a/b.git -> git@github.com:a/b.git
  local url="$1"
  if [[ "$url" =~ ^https://github\.com/(.+)$ ]]; then
    echo "git@github.com:${BASH_REMATCH[1]}"
  else
    echo "$url"
  fi
}
UPSTREAM_PUSH_URL="${OMARCHY_UPSTREAM_PUSH_URL:-$(ssh_push_url "$UPSTREAM_URL")}"

ensure_mirror_clone() {
  if [[ -d "$MIRROR_CLONE" ]]; then
    # A clone from before the repository moved still names its old URL, and
    # makepkg refuses a source whose cached clone points elsewhere.
    git -C "$MIRROR_CLONE" remote set-url origin "$UPSTREAM_URL"
    git -C "$MIRROR_CLONE" fetch --quiet origin
  else
    mkdir -p "$SRCDEST_DIR"
    print_info "Cloning $UPSTREAM_URL (cached in $SRCDEST_DIR)..."
    git clone --mirror --quiet "$UPSTREAM_URL" "$MIRROR_CLONE"
  fi
  git -C "$MIRROR_CLONE" remote set-url --push origin "$UPSTREAM_PUSH_URL"
}

# A clone made with `git clone --mirror` sets remote.origin.mirror=true. Git
# otherwise rejects an explicit SHA:ref push as an invalid combination with
# mirror mode, so disable that remote setting for narrowly targeted pushes.
push_upstream_ref() { # push_upstream_ref <source-sha> <destination-ref>
  git -c remote.origin.mirror=false -C "$MIRROR_CLONE" push --quiet origin "$1:$2"
}

ensure_work_clone() {
  if [[ -d "$WORK_CLONE" ]]; then
    git -C "$WORK_CLONE" remote set-url origin "$UPSTREAM_URL"
    git -C "$WORK_CLONE" fetch --quiet origin
  else
    mkdir -p "$SRCDEST_DIR"
    print_info "Cloning $UPSTREAM_URL working copy..."
    git clone --quiet "$UPSTREAM_URL" "$WORK_CLONE"
  fi
  git -C "$WORK_CLONE" remote set-url --push origin "$UPSTREAM_PUSH_URL"
}

# --- published channel state -------------------------------------------------

# The Arch snapshot a mirror serves: its lastsync stamp. Returns 2 when the
# mirror cannot be read.
mirror_lastsync() {
  local stamp
  stamp=$(curl -sf "$1/lastsync?$(date +%s%N)") || return 2
  [[ $stamp =~ ^[0-9]+$ ]] || return 2
  echo "$stamp"
}

# A channel's Arch mirror for an architecture: arch_mirror rc|stable <arch>.
arch_mirror() {
  local channel="$1" arch="$2"
  if [[ $arch == "aarch64" ]]; then
    if [[ $channel == "rc" ]]; then echo "$RC_ARM_MIRROR"; else echo "$STABLE_ARM_MIRROR"; fi
  else
    if [[ $channel == "rc" ]]; then echo "$RC_ARCH_MIRROR"; else echo "$STABLE_ARCH_MIRROR"; fi
  fi
}

# Stable packages were built and tested against rc's Arch snapshot. Promoted
# while the stable mirror still serves an older one, they install against
# libraries they were not built for (omarchy#15785). The mirror goes first, on
# every architecture CI publishes: omarchy-mirror-sync-stable-from-rc on the
# mirror host copies rc's x86_64 snapshot, lastsync included, to stable, and
# omarchy-mirror-promote-arm on the ARM mirror host Arch Linux ARM's. With an
# architecture, only that one's mirrors are compared.
stable_mirror_matches_rc() {
  local arch rc stable status=0
  for arch in ${1:-$(ci_arches)}; do
    rc=$(mirror_lastsync "$(arch_mirror rc "$arch")") || return 2
    stable=$(mirror_lastsync "$(arch_mirror stable "$arch")") || return 2
    [[ $rc == "$stable" ]] || status=1
  done
  return $status
}

# What to run on an architecture's mirror host when the stamps differ:
# mirror_sync_hint <rc stamp> <stable stamp> [arch]. Normally stable is
# behind and takes rc's snapshot. Stable newer than rc means something synced
# it from upstream, which omarchy-mirror no longer does (omarchy-mirror#13);
# copying rc over it would roll stable users' Arch packages back, so the hint
# gives rc stable's snapshot by hand instead. An unreadable stamp suggests no
# copy at all.
mirror_sync_hint() {
  local rc="$1" stable="$2" arch="${3:-x86_64}"
  if [[ ! $rc =~ ^[0-9]+$ || ! $stable =~ ^[0-9]+$ ]]; then
    echo "Check that $(arch_mirror rc "$arch") and $(arch_mirror stable "$arch") both answer /lastsync, then ship again"
  elif ((stable > rc)); then
    if [[ $arch == "aarch64" ]]; then
      echo "Stable is newer than rc, so copying rc to stable would roll it back; find what synced stable from upstream. On the ARM mirror host, give rc stable's snapshot with omarchy-mirror-promote-arm --from omarchy:omarchy-mirror-arm-stable --to omarchy:omarchy-mirror-arm-rc, test rc on it, then ship again"
    else
      echo "Stable is newer than rc, so copying rc to stable would roll it back; find what synced stable from upstream. On the mirror host, give rc stable's snapshot with omarchy-mirror-copy-stage --from /mnt/arch-mirror-stable/ --to /mnt/arch-mirror-rc/ --r2 omarchy:omarchy-mirror-rc, test rc on it, then ship again"
    fi
  elif [[ $arch == "aarch64" ]]; then
    echo "On the ARM mirror host, run omarchy-mirror-promote-arm --from omarchy:omarchy-mirror-arm-rc --to omarchy:omarchy-mirror-arm-stable, then ship again"
  else
    echo "Run omarchy-mirror-sync-stable-from-rc on the mirror host, then ship again"
  fi
}

# Prints omarchy's published version in a channel; empty when absent, rc 2 when
# the database cannot be read (callers must not mistake an outage for absence).
published_version() {
  local channel="$1" arch="${2:-$OBSERVED_ARCH}" tmp descs
  tmp=$(mktemp) || return 2
  # A unique query string busts the CDN cache: right after a sync the plain
  # URL can keep serving the previous db for a while, which reads as "not
  # published yet" to status, the wait loop, and ship's pre-checks.
  if ! curl -sf "$PKGS_DB_BASE/$channel/$arch/omarchy.db.tar.zst?$(date +%s%N)" -o "$tmp"; then
    rm -f "$tmp"
    return 2
  fi
  if ! descs=$(tar -xO --zstd -f "$tmp" --wildcards '*/desc' 2>/dev/null); then
    rm -f "$tmp"
    return 2
  fi
  rm -f "$tmp"
  awk '
    function emit() {
      if (!found && name == "omarchy" && version != "") { print version; found = 1 }
      name = ""; version = ""
    }
    $0 == "%FILENAME%" { emit(); next }
    $0 == "%NAME%"    { getline; name = $0; next }
    $0 == "%VERSION%" { getline; version = $0; next }
    END { emit() }
  ' <<<"$descs"
}

all_arches_at_version() { # all_arches_at_version <channel> <pkgver>
  local channel="$1" want="$2" arch got
  for arch in $(ci_arches); do
    got=$(published_version "$channel" "$arch" 2>/dev/null) || return 1
    [[ "${got%-*}" == "$want" ]] || return 1
  done
}

# The rc branch of THIS repo carries the current pins. Read them without
# touching the working tree.
rc_branch_pin() { # prints "pkgver commit", empty when no rc branch
  local ref="origin/rc" pkgbuild
  git -C "$BUILD_ROOT" fetch --quiet origin rc 2>/dev/null || true
  pkgbuild=$(git -C "$BUILD_ROOT" show "$ref:pkgbuilds/omarchy/PKGBUILD" 2>/dev/null) || return 0
  local pkgver commit
  pkgver=$(grep -E '^pkgver=' <<<"$pkgbuild" | head -1 | cut -d= -f2)
  commit=$(grep -E '^_commit=' <<<"$pkgbuild" | head -1 | cut -d= -f2 | tr -d "'\"")
  [[ -n "$pkgver" ]] && echo "$pkgver $commit"
}

# --- package workflows -------------------------------------------------------
#
# The pair is built and channels move in GitHub Actions, on the bucket itself:
# release-rc.yml builds the rc branch's pins into rc and carries them to edge,
# and promote.yml carries one channel into the next. Each run records who
# started it and what moved.

# Starts a workflow on this repo's master and prints its run. With --wait it
# follows the run to the end and fails when the run does.
dispatch_workflow() { # dispatch_workflow [--wait] <workflow file> [-f key=value ...]
  local wait=false file since run=""
  [[ "$1" == "--wait" ]] && { wait=true; shift; }
  file="$1"
  shift
  since=$(date -u -d '-10 seconds' +%Y-%m-%dT%H:%M:%SZ)
  gh workflow run "$file" -R "$PKGS_REPO" --ref master "$@" || return 1
  # The dispatch returns before the run exists; find it by when it started.
  local tries
  for ((tries = 0; tries < 30; tries++)); do
    run=$(gh run list -R "$PKGS_REPO" --workflow "$file" --event workflow_dispatch --limit 10 \
      --json databaseId,createdAt --jq "[.[] | select(.createdAt >= \"$since\")] | last | .databaseId // empty" 2>/dev/null) || run=""
    [[ -n "$run" ]] && break
    sleep 2
  done
  if [[ -z "$run" ]]; then
    print_error "Started $file but could not find its run: https://github.com/$PKGS_REPO/actions/workflows/$file"
    return 1
  fi
  print_info "$file: https://github.com/$PKGS_REPO/actions/runs/$run"
  [[ "$wait" == true ]] || return 0
  gh run watch "$run" -R "$PKGS_REPO" --exit-status --interval 30
}

# Builds the pinned release pair from the rc branch into rc, then edge
# (release-rc.yml).
trigger_rc_build() { # trigger_rc_build [--wait]
  print_info "Building the release candidate in GitHub Actions..."
  dispatch_workflow "$@" release-rc.yml
}

# Carries <from> into <to> on every architecture (promote.yml), and waits for
# it. With pkgbases, only those move.
promote_channel() { # promote_channel <from> <to> [pkgbases]
  print_info "Promoting $1 -> $2${3:+ (only $3)} in GitHub Actions..."
  dispatch_workflow --wait promote.yml -f direction="$1 -> $2" ${3:+-f packages="$3"}
}

# What start does with edge for a minor/major: "all", "none", or the pkgbases
# to carry. Reads an interactive reply; empty when it has to ask again.
edge_promotion_choice() { # edge_promotion_choice <reply>
  local reply
  reply=$(xargs <<<"$1")
  case "$reply" in
    a | all) echo all ;;
    n | none) echo none ;;
    *) echo "$reply" ;;
  esac
}

wait_for_published() { # wait_for_published <channel> <version> [timeout-seconds]
  local channel="$1" want="$2" timeout="${3:-3600}" waited=0 arch got pending
  print_info "Waiting for $want in $channel for: $(ci_arches | tr '\n' ' ')"
  while ((waited < timeout)); do
    pending=""
    for arch in $(ci_arches); do
      got=$(published_version "$channel" "$arch" 2>/dev/null) || got=""
      [[ "${got%-*}" == "$want" ]] || pending+=" $arch=${got:-unreachable}"
    done
    if [[ -z "$pending" ]]; then
      print_success "$channel now serves omarchy $want on every published architecture"
      return 0
    fi
    sleep 60
    waited=$((waited + 60))
    printf '.' >&2
  done
  echo "" >&2
  print_warning "Timed out waiting for $want in $channel (pending:$pending)"
  print_info "The build may still be running — re-run this command to resume."
  return 1
}

# --- pkgs rc branch (pin commits) --------------------------------------------

# The rc branch is rebuilt as origin/master + pin commit(s) for each cut and
# force-pushed; release-rc.yml takes the pins from it. History on it is
# disposable — the pins fully describe the release.
prepare_rc_worktree() {
  git -C "$BUILD_ROOT" fetch --quiet origin
  if [[ ! -d "$RC_WORKTREE" ]]; then
    mkdir -p "$(dirname "$RC_WORKTREE")"
    git -C "$BUILD_ROOT" worktree add --quiet -B rc "$RC_WORKTREE" origin/master
  else
    git -C "$RC_WORKTREE" checkout --quiet -B rc origin/master
    git -C "$RC_WORKTREE" reset --quiet --hard origin/master
  fi
}

cut_pins() { # cut_pins <omarchy-pkgs release args...>
  prepare_rc_worktree
  # The pin engine's "edge DB" is the ordering floor and rc auto-numbering
  # source; in the pipeline model that floor is the rc channel.
  (cd "$RC_WORKTREE" &&
    OMARCHY_EDGE_DB_URL="$RC_DB_URL" OMARCHY_RELEASE_CHANNELS="rc + edge via release-rc.yml (stable only by promotion in ship)" \
      bin/omarchy-pkgs release "$@" --no-push --yes)
  git -C "$RC_WORKTREE" push --force-with-lease origin rc
}

# --- ISO ---------------------------------------------------------------------

iso_checkout() { # prints a usable omarchy-iso checkout, cloning to tmp if needed
  if [[ -n "${OMARCHY_ISO_DIR:-}" && -d "${OMARCHY_ISO_DIR:-}" ]]; then
    echo "$OMARCHY_ISO_DIR"
    return 0
  fi
  if [[ -d "$BUILD_ROOT/../omarchy-iso/.git" ]]; then
    realpath "$BUILD_ROOT/../omarchy-iso"
    return 0
  fi
  local tmp="$SRCDEST_DIR/omarchy-iso"
  if [[ -d "$tmp" ]]; then
    git -C "$tmp" remote set-url origin "https://github.com/$ISO_REPO.git"
    git -C "$tmp" pull --ff-only --quiet || true
  else
    print_info "Cloning $ISO_REPO..." >&2
    git clone --quiet "https://github.com/$ISO_REPO.git" "$tmp"
  fi
  echo "$tmp"
}

# The ISO builds natively for the machine this runs on: built for the other
# architecture it would run emulated, slowly and fragile. Each architecture is
# released from a machine of its own; x86_64 needs no --arch, so it works with
# an omarchy-iso that predates the option.
iso_release_command() { # iso_release_command <arch> <version> [--rc]
  echo "bin/omarchy-iso-release ${3:+$3 }$([[ $1 == x86_64 ]] || echo "--arch $1 ")$2"
}

build_iso() { # build_iso <version> [--rc]
  local version="$1" rc_flag="${2:-}" dir arch other
  arch=$(uname -m)
  other=x86_64
  [[ $arch == x86_64 ]] && other=aarch64
  dir=$(iso_checkout) || return 1
  if [[ -z "$CONTAINER_ENGINE" ]] || ! "$CONTAINER_ENGINE" info >/dev/null 2>&1; then
    print_warning "No container engine is available — cannot build the ISO here. Run on a Docker or Podman machine:"
    echo "  cd $dir && $(iso_release_command "$arch" "$version" "$rc_flag")"
    return 1
  fi
  print_info "Building ${rc_flag:+RC }$arch ISO $version (this takes a while)..."
  print_info "The $other ISO builds on a $other machine: cd omarchy-iso && $(iso_release_command "$other" "$version" "$rc_flag")"
  # shellcheck disable=SC2046 # the command is split into its arguments on purpose
  (cd "$dir" && PATH="$dir/bin:$PATH" $(iso_release_command "$arch" "$version" "$rc_flag"))
}

maybe_iso() { # maybe_iso <version> <rc|final> <iso_mode: ask|yes|no>
  local version="$1" kind="$2" mode="$3" rc_flag=""
  [[ "$kind" == "rc" ]] && rc_flag="--rc"
  case "$mode" in
  no) return 0 ;;
  yes) build_iso "$version" "$rc_flag" ;;
  ask)
    if confirm "Build and upload the ${kind} $(uname -m) ISO for $version on this machine?"; then
      build_iso "$version" "$rc_flag"
    fi
    ;;
  esac
}

# --- website -----------------------------------------------------------------

update_website() { # update_website <version>
  local version="$1" tmp="$SRCDEST_DIR/omarchy-site"
  print_info "Updating $SITE_REPO ISO references to $version..."
  if [[ -d "$tmp" ]]; then
    git -C "$tmp" fetch --quiet origin && git -C "$tmp" reset --quiet --hard origin/HEAD
  else
    git clone --quiet "git@github.com:$SITE_REPO.git" "$tmp" || {
      print_warning "Could not clone $SITE_REPO — update the ISO URL there manually"
      return 1
    }
  fi
  local matches
  matches=$(grep -rIlE 'omarchy-[0-9]+\.[0-9]+\.[0-9]+(-rc)?\.iso' "$tmp" --exclude-dir=.git || true)
  if [[ -z "$matches" ]]; then
    print_warning "No omarchy-<version>.iso references found in $SITE_REPO — update it manually"
    return 1
  fi
  echo "$matches" | while IFS= read -r f; do
    sed -i -E "s/omarchy-[0-9]+\.[0-9]+\.[0-9]+\.iso/omarchy-$version.iso/g" "$f"
    echo "  updated: ${f#"$tmp"/}"
  done
  if git -C "$tmp" diff --quiet; then
    print_info "Website already references $version"
    return 0
  fi
  git -C "$tmp" --no-pager diff --stat
  confirm "Push this ISO URL bump to $SITE_REPO?" || {
    print_info "Left uncommitted in $tmp"
    return 1
  }
  git -C "$tmp" commit --quiet -am "Point ISO download at omarchy-$version.iso" &&
    git -C "$tmp" push --quiet origin HEAD
  print_success "Website updated to omarchy-$version.iso"
}

# --- commands ----------------------------------------------------------------

cmd_start() {
  local version="${1:-}"
  if [[ -z "$version" ]]; then
    read -r -p "Version to release (X.Y.Z): " version
  fi
  version="${version#v}"
  if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    print_error "Invalid version '$version' (expected X.Y.Z)"
    exit 1
  fi
  local branch
  branch=$(version_to_branch "$version")

  print_header "Open release train $version"

  if tag_exists "v$version"; then
    print_error "v$version is already tagged on $UPSTREAM_REPO — this train has shipped"
    exit 1
  fi

  if ! version_is_patch "$version"; then
    start_dev_train "$version"
    return
  fi

  # A patch branches from the previous tag and takes fixes by cherry-pick.
  local base_ref base_sha
  base_ref=$(previous_patch_tag "$version")
  if ! tag_exists "$base_ref"; then
    print_error "Base tag $base_ref not found on $UPSTREAM_REPO"
    exit 1
  fi
  base_sha=$(resolve_tag_commit "$base_ref")

  if [[ -n "$(branch_head "$branch")" ]]; then
    print_success "Release branch $branch already exists — adopting it"
  else
    print_info "Release type: patch — branching $branch from $base_ref (${base_sha:0:12})"
    confirm "Create branch $branch on $UPSTREAM_REPO?" || exit 1
    ensure_mirror_clone
    push_upstream_ref "$base_sha" "refs/heads/$branch"
    print_success "Created $branch"
  fi

  # Staging PR: the body is the release-notes staging ground. A branch with no
  # commits beyond its base cannot carry a PR yet; created lazily by pick.
  if command -v gh >/dev/null; then
    if gh pr view "$branch" --repo "$UPSTREAM_REPO" >/dev/null 2>&1; then
      print_success "Staging PR for $branch already open"
    elif ! gh pr create --repo "$UPSTREAM_REPO" --draft --base "$DEV_BRANCH" --head "$branch" \
      --title "Release v$version" \
      --body "Staging ground for the v$version release notes. Edit this body — it becomes the GitHub release text." 2>/dev/null; then
      print_info "Staging PR not created yet (no commits on $branch) — it opens after the first pick"
    fi
  fi

  print_info "Patch train: rc already mirrors stable — nothing to advance"
  echo ""
  print_success "Train $version is open"
  print_info "Next: omarchy-release pick   (cherry-pick fixes), then omarchy-release rc"
}

# A minor/major takes everything on the dev branch, so it has no branch of its
# own: it is open once its first v<version>-rc1 tag exists, which this cuts.
start_dev_train() { # start_dev_train <version>
  local version="$1" open
  open=$(open_train) || open=""
  if [[ "$open" == "$version $DEV_BRANCH" ]]; then
    print_success "Train $version is already open on $DEV_BRANCH"
    print_info "Next: omarchy-release rc   (tags $DEV_BRANCH's tip as the next candidate)"
    return 0
  fi
  # Opening this one advances rc's whole package set under the other.
  if [[ -n "$open" ]]; then
    print_error "Train ${open% *} is still open on ${open#* } — ship it before starting $version"
    exit 1
  fi
  print_info "Release type: minor/major — candidates are tagged on $DEV_BRANCH as $(rc_tag "$version" N)"

  # A feature rc tests against a fresh Arch snapshot. rc and stable still
  # sharing one means rc has not taken it since the last ship.
  local arch
  for arch in $(ci_arches); do
    stable_mirror_matches_rc "$arch" || continue
    print_warning "rc's $arch Arch mirror still serves stable's snapshot"
    if [[ $arch == "aarch64" ]]; then
      echo "A minor/major train tests against a fresh one: run omarchy-mirror-promote-arm --from omarchy:omarchy-mirror-arm --to omarchy:omarchy-mirror-arm-rc on the ARM mirror host first."
    else
      echo "A minor/major train tests against a fresh one: run omarchy-mirror-sync-rc on the mirror host first."
    fi
    confirm "Open the train on the current snapshot anyway?" || exit 1
  done

  # A minor/major usually ships what has collected on edge, so RC testing
  # runs against it: carry edge forward into rc, since shipping promotes all
  # of rc to stable. Holding some or all of it back keeps rc at what it serves
  # now, say right after a promotion, so new edge packages stay out of the
  # RCs. A failed advance must not pass silently — RCs would test against a
  # set nobody chose.
  local promote="$PROMOTE_EDGE"
  if [[ -z "$promote" && "$ASSUME_YES" == true ]]; then
    promote=all
  fi
  while [[ -z "$promote" ]]; do
    echo "Carry edge's newer packages into rc for this train? Shipping takes rc to stable."
    echo "  Preview: gh workflow run promote.yml -R $PKGS_REPO -f direction=\"edge -> rc\" -f dry_run=true"
    local reply
    read -r -p "[a]ll, [n]one, or the pkgbases to carry: " reply
    promote=$(edge_promotion_choice "$reply")
  done
  local only=""
  [[ "$promote" == all ]] || only="$promote"
  if [[ "$promote" == none ]]; then
    print_info "Holding edge back — rc keeps its current packages"
  elif ! promote_channel edge rc "$only"; then
    print_error "edge → rc advance did not complete — the train is NOT open"
    echo "Fix the advance (it is idempotent), then re-run: omarchy-release start $version"
    exit 1
  fi

  cmd_rc "$ISO_MODE" "$WAIT" "$version"
}

cmd_pick() {
  local train branch version
  train=$(open_train) || true
  if [[ -z "$train" ]]; then
    print_error "No open release train — run: omarchy-release start"
    exit 1
  fi
  version="${train% *}" branch="${train#* }"
  if follows_dev_branch "$branch"; then
    print_error "$version follows $DEV_BRANCH and takes everything on it — there is nothing to pick"
    echo "Merge the change to $DEV_BRANCH, then cut the next candidate: omarchy-release rc"
    exit 1
  fi
  print_header "Pick changes onto $branch ($version)"

  ensure_work_clone
  git -C "$WORK_CLONE" checkout --quiet -B "$branch" "origin/$branch"

  # Changes usually reach a release branch as BACKPORTS — cherry-picks with
  # new SHAs — so ancestry of the original quattro merge commit proves nothing
  # on a patch branch. Detect equivalence the way it is actually recorded:
  # the branch's own commit messages since it left quattro name the PR
  # ("backport of #N", squash titles "(#N)") or the source commit
  # ("cherry picked from commit <sha>", which pick -x writes) — or, failing
  # both, repeat its title verbatim.
  local base_commit base_date branch_log
  base_commit=$(git -C "$WORK_CLONE" merge-base "origin/$branch" "origin/$DEV_BRANCH" 2>/dev/null) || base_commit=""
  base_date=""
  if [[ -n "$base_commit" ]]; then
    base_date=$(TZ=UTC git -C "$WORK_CLONE" log -1 --format=%cd \
      --date=format-local:'%Y-%m-%dT%H:%M:%SZ' "$base_commit" 2>/dev/null) || base_date=""
  fi
  branch_log=$(git -C "$WORK_CLONE" log --format='%s %b' "origin/$branch" ${base_commit:+--not "$base_commit"} 2>/dev/null)
  # Subjects alone, with any trailing "(#N)" stripped, so a change re-applied by
  # hand — no PR number, no cherry-pick trailer — is still recognised by title.
  local branch_subjects
  branch_subjects=$(git -C "$WORK_CLONE" log --format='%s' "origin/$branch" ${base_commit:+--not "$base_commit"} 2>/dev/null |
    sed -E 's/ \(#[0-9]+\)$//')

  already_on_branch() { # already_on_branch <merge-sha> <pr-number-or-empty> <title-or-empty>
    local sha="$1" number="$2" title="$3"
    if [[ -n "$sha" ]]; then
      git -C "$WORK_CLONE" merge-base --is-ancestor "$sha" "origin/$branch" 2>/dev/null && return 0
      grep -q "cherry picked from commit $sha" <<<"$branch_log" && return 0
    fi
    if [[ -n "$number" ]]; then
      grep -qE "#$number([^0-9]|$)" <<<"$branch_log" && return 0
    fi
    if [[ -n "$title" ]]; then
      grep -Fxq "$title" <<<"$branch_subjects" && return 0
    fi
    return 1
  }

  local -a shas=() labels=()
  if [[ $# -gt 0 ]]; then
    local arg sha title
    for arg in "$@"; do
      if [[ "$arg" =~ ^[0-9]+$ ]]; then
        sha=$(gh pr view "$arg" --repo "$UPSTREAM_REPO" --json mergeCommit --jq '.mergeCommit.oid' 2>/dev/null)
        title=$(gh pr view "$arg" --repo "$UPSTREAM_REPO" --json title --jq '.title' 2>/dev/null)
        if [[ -z "$sha" || "$sha" == "null" ]]; then
          print_error "PR #$arg has no merge commit (not merged?)"
          exit 1
        fi
        if already_on_branch "$sha" "$arg" "$title"; then
          print_info "PR #$arg is already on $branch — skipping"
          continue
        fi
        shas+=("$sha") labels+=("PR #$arg: $title")
      else
        if already_on_branch "$arg" "" ""; then
          print_info "commit $arg is already on $branch — skipping"
          continue
        fi
        shas+=("$arg") labels+=("commit $arg")
      fi
    done
  else
    # Interactive: merged dev-branch PRs not already on the release branch
    # (by ancestry, backport reference, cherry-pick trailer, or title), oldest
    # first so picks apply in merge order.
    print_info "Loading merged $DEV_BRANCH PRs not yet on $branch..."
    # gh pr list orders by CREATION date, so a plain --limit window silently
    # drops long-lived PRs — opened early, merged recently — which are exactly
    # the ones a release branch still needs. Pull a wide window and bound it by
    # the branch point instead: anything merged into $DEV_BRANCH before $branch
    # left it is already here by ancestry.
    local list jq_pick
    jq_pick='sort_by(.mergedAt) | .[] | "\(.mergeCommit.oid)\t\(.number)\t\(.title)"'
    [[ -n "$base_date" ]] && jq_pick="[.[] | select(.mergedAt >= \"$base_date\")] | $jq_pick"
    list=$(gh pr list --repo "$UPSTREAM_REPO" --state merged --base "$DEV_BRANCH" \
      --limit 300 --json number,title,mergeCommit,mergedAt --jq "$jq_pick")
    local -a cand_shas=() cand_labels=()
    local sha number title
    while IFS=$'\t' read -r sha number title; do
      [[ -z "$sha" || "$sha" == "null" ]] && continue
      already_on_branch "$sha" "$number" "$title" && continue
      cand_shas+=("$sha") cand_labels+=("#$number $title")
    done <<<"$list"
    if [[ ${#cand_shas[@]} -eq 0 ]]; then
      print_success "Nothing to pick — every $DEV_BRANCH PR merged since $branch opened is already on it"
      exit 0
    fi
    echo ""
    local i
    for i in "${!cand_labels[@]}"; do
      printf '  %2d) %s\n' "$((i + 1))" "${cand_labels[$i]}"
    done
    echo ""
    local selection
    read -r -p "Pick which? (e.g. 1,3-5 or 'all'): " selection
    if [[ "$selection" == "all" ]]; then
      shas=("${cand_shas[@]}") labels=("${cand_labels[@]}")
    else
      local part
      for part in ${selection//,/ }; do
        if [[ "$part" =~ ^([0-9]+)-([0-9]+)$ ]]; then
          for ((i = BASH_REMATCH[1]; i <= BASH_REMATCH[2]; i++)); do
            shas+=("${cand_shas[$((i - 1))]}") labels+=("${cand_labels[$((i - 1))]}")
          done
        elif [[ "$part" =~ ^[0-9]+$ ]]; then
          shas+=("${cand_shas[$((part - 1))]}") labels+=("${cand_labels[$((part - 1))]}")
        fi
      done
    fi
  fi

  [[ ${#shas[@]} -eq 0 ]] && { print_info "Nothing selected."; exit 0; }

  local i
  for i in "${!shas[@]}"; do
    print_info "Cherry-picking ${labels[$i]}..."
    if ! git -C "$WORK_CLONE" cherry-pick -x -m 1 "${shas[$i]}" 2>/dev/null &&
      ! { git -C "$WORK_CLONE" cherry-pick --abort 2>/dev/null; git -C "$WORK_CLONE" cherry-pick -x "${shas[$i]}"; }; then
      print_error "Cherry-pick conflict on ${labels[$i]}"
      echo "Resolve it in $WORK_CLONE (git cherry-pick --continue), push, and re-run."
      exit 1
    fi
  done

  git -C "$WORK_CLONE" push --quiet origin "$branch"
  print_success "Picked ${#shas[@]} change(s) onto $branch"

  # The staging PR can exist now that the branch has commits of its own.
  if command -v gh >/dev/null && ! gh pr view "$branch" --repo "$UPSTREAM_REPO" >/dev/null 2>&1; then
    gh pr create --repo "$UPSTREAM_REPO" --draft --base "$DEV_BRANCH" --head "$branch" \
      --title "Release v$version" \
      --body "Staging ground for the v$version release notes. Edit this body — it becomes the GitHub release text." 2>/dev/null &&
      print_success "Opened the release-notes staging PR" || true
  fi
  print_info "Next: omarchy-release rc"
}

cmd_rc() { # cmd_rc <iso_mode> <wait> [version]  (version: start opening a minor/major)
  local iso_mode="$1" wait="$2" train ref version
  if [[ -n "${3:-}" ]]; then
    version="$3" ref="$DEV_BRANCH"
  else
    train=$(open_train) || true
    if [[ -z "$train" ]]; then
      print_error "No open release train — run: omarchy-release start"
      exit 1
    fi
    version="${train% *}" ref="${train#* }"
  fi
  print_header "Cut RC for train $version"

  local head
  head=$(branch_head "$ref")
  print_info "$ref head: ${head:0:12}"

  # Idempotence: if the current rc pin already matches the head and is
  # published, there is nothing to cut.
  local pin
  pin=$(rc_branch_pin)
  if [[ -n "$pin" ]]; then
    local pin_ver="${pin%% *}" pin_commit="${pin##* }"
    if [[ "$pin_commit" == "$head" && "$pin_ver" =~ ^${version//./\\.}rc[0-9]+$ ]]; then
      if all_arches_at_version rc "$pin_ver"; then
        print_success "$pin_ver is already cut from this head and published to rc on every architecture"
        maybe_iso "$pin_ver" rc "$iso_mode"
        return 0
      fi
      print_info "$pin_ver is pinned from this head but not published yet — re-triggering the build"
      if [[ "$wait" == true ]]; then
        trigger_rc_build --wait || return 1
        wait_for_published rc "$pin_ver" || return 1
      else
        trigger_rc_build || return 1
      fi
      maybe_iso "$pin_ver" rc "$iso_mode"
      return 0
    fi
  fi

  if follows_dev_branch "$ref"; then
    # The tag is the candidate: pin from it so the PKGBUILDs record it. A
    # newest tag already on this head is a cut that stopped before pinning.
    local tags n tag
    tags=$(upstream_tags)
    n=$(newest_rc_number "$version" <<<"$tags")
    if [[ -n "$n" && "$(resolve_tag_commit "$(rc_tag "$version" "$n")")" == "$head" ]]; then
      tag=$(rc_tag "$version" "$n")
      print_info "$tag already tags this head — pinning it"
    else
      tag=$(rc_tag "$version" "$((${n:-0} + 1))")
      confirm "Tag $DEV_BRANCH@${head:0:12} as $tag on $UPSTREAM_REPO, pin omarchy + omarchy-settings to it and publish to rc + edge?" || exit 1
      ensure_mirror_clone
      push_upstream_ref "$head" "refs/tags/$tag"
      if [[ "$(resolve_tag_commit "$tag")" != "$head" ]]; then
        print_error "Tag push completed but $tag does not resolve to ${head:0:12}"
        exit 1
      fi
      print_success "Tagged $tag at ${head:0:12}"
    fi
    cut_pins "$tag"
  else
    confirm "Pin omarchy + omarchy-settings to $ref@${head:0:12} as the next ${version}rcN and publish to rc + edge?" || exit 1
    cut_pins rc --base "$version" --ref "$ref"
  fi

  local new_pin new_ver
  new_pin=$(rc_branch_pin)
  new_ver="${new_pin%% *}"
  print_success "Pinned $new_ver (rc branch pushed)"

  if [[ "$wait" == true ]]; then
    trigger_rc_build --wait || return 1
    wait_for_published rc "$new_ver" || return 1
  else
    trigger_rc_build || return 1
  fi
  maybe_iso "$new_ver" rc "$iso_mode"
  echo ""
  if follows_dev_branch "$ref"; then
    print_info "Test the candidate, then: omarchy-release ship  (or rc again to take $DEV_BRANCH's newer commits)"
  else
    print_info "Test the candidate, then: omarchy-release ship  (or pick + rc again)"
  fi
}

cmd_ship() {
  local iso_mode="$1" wait="$2"
  local train branch version
  train=$(open_train) || true
  if [[ -z "$train" ]]; then
    # A tagged train whose later steps (release, ISO, website) failed is
    # invisible to open_train — find it so a re-run can resume.
    train=$(newest_train) || true
    if [[ -z "$train" ]]; then
      print_error "No release train found — nothing to ship"
      exit 1
    fi
    version="${train% *}" branch="${train#* }"
    if all_arches_at_version stable "$version" &&
      gh release view "v$version" --repo "$UPSTREAM_REPO" >/dev/null 2>&1; then
      print_success "Nothing to ship — $version is tagged, released, and live on stable"
      exit 0
    fi
    print_info "Resuming tagged-but-incomplete train $version"
  else
    version="${train% *}" branch="${train#* }"
  fi
  print_header "Ship $version"

  local head pin pin_ver pin_commit
  head=$(branch_head "$branch")
  pin=$(rc_branch_pin)
  pin_ver="${pin%% *}"
  pin_commit="${pin##* }"

  # The ship guard: only the exact commit an RC was cut from may ship. There
  # is no override — a moved release branch means an untested tree; cut
  # another rc. The dev branch moves on by design, so a minor/major ships its
  # newest candidate: that rc tag's commit must be the one pinned.
  if [[ -z "$pin" ]]; then
    print_error "No RC has been cut for $version — run: omarchy-release rc"
    exit 1
  fi
  if [[ "$pin_ver" == "$version" ]]; then
    # Final already pinned (resume path). The artifacts come from pin_commit;
    # a branch that moved afterwards changes nothing already built or tagged.
    if [[ -n "$head" && "$head" != "$pin_commit" ]] && ! follows_dev_branch "$branch"; then
      print_warning "$branch moved after the final was pinned — shipping the pinned ${pin_commit:0:12}; newer commits need the next patch train"
    fi
  else
    if [[ ! "$pin_ver" =~ ^${version//./\\.}rc[0-9]+$ ]]; then
      print_error "No RC has been cut for $version (rc branch pins $pin_ver) — run: omarchy-release rc"
      exit 1
    fi
    if follows_dev_branch "$branch"; then
      local n newest_tag
      n=$(upstream_tags | newest_rc_number "$version")
      newest_tag=$(rc_tag "$version" "${n:-0}")
      if [[ -z "$n" || "$pin_ver" != "${version}rc$n" || "$(resolve_tag_commit "$newest_tag")" != "$pin_commit" ]]; then
        print_error "The rc branch pins $pin_ver from ${pin_commit:0:12}, which is not the newest candidate ${n:+$newest_tag}"
        echo "Pin and publish the newest candidate first: omarchy-release rc"
        exit 1
      fi
      if [[ "$pin_commit" != "$head" ]]; then
        print_info "$DEV_BRANCH has moved on since $newest_tag — shipping the tested ${pin_commit:0:12}; newer commits wait for the next train"
      fi
    elif [[ "$pin_commit" != "$head" ]]; then
      local behind
      behind=$(git -C "$WORK_CLONE" rev-list --count "$pin_commit..origin/$branch" 2>/dev/null || echo "?")
      print_error "$branch has moved since $pin_ver was cut ($behind commit(s) untested)"
      echo "Only a commit an RC was cut from can ship. Cut another candidate:"
      echo "  omarchy-release rc"
      exit 1
    fi
    if ! all_arches_at_version rc "$pin_ver"; then
      print_error "$pin_ver is pinned but is not published for every architecture"
      echo "Wait for it (or re-run: omarchy-release rc), then ship."
      exit 1
    fi
  fi

  echo ""
  print_info "This will, in order (steps already done are skipped):"
  echo "  1. Tag v$version at the tested $branch@${pin_commit:0:12} on $UPSTREAM_REPO"
  echo "  2. Pin the final $version from that tag and publish it to rc + edge"
  echo "  3. Promote the rc channel to stable (packages + signatures + db), once the"
  echo "     stable Arch mirror serves rc's snapshot"
  echo "  4. Merge the final pins to master (the repo record)"
  if follows_dev_branch "$branch"; then
    echo "  5. Create a draft GitHub release with notes generated from the merged PRs"
  else
    echo "  5. Create a draft GitHub release from the staging PR body"
  fi
  echo "  6. Build + upload the final ISO (${iso_mode})"
  echo "  7. Point the website at the new ISO"
  echo ""
  confirm "Ship $version?" || exit 1

  # 1. Tag the exact commit the tested RC was built from before any final
  # package metadata is written or published. A pre-existing tag is only safe
  # to reuse when it resolves to that same commit.
  local tag_commit
  if tag_exists "v$version"; then
    tag_commit=$(resolve_tag_commit "v$version")
    if [[ "$tag_commit" != "$pin_commit" ]]; then
      print_error "Tag v$version points to ${tag_commit:0:12}, not the tested ${pin_commit:0:12}"
      echo "Refusing to publish final package metadata for the wrong source commit."
      exit 1
    fi
    print_success "1/7 Tag v$version already exists at ${pin_commit:0:12}"
  else
    ensure_mirror_clone
    push_upstream_ref "$pin_commit" "refs/tags/v$version"
    tag_commit=$(resolve_tag_commit "v$version")
    if [[ "$tag_commit" != "$pin_commit" ]]; then
      print_error "Tag push completed but v$version resolves to '${tag_commit:-nothing}'"
      echo "Expected the tested commit $pin_commit; refusing to continue."
      exit 1
    fi
    print_success "1/7 Tagged v$version at ${pin_commit:0:12}"
  fi

  # 2. Final pins into rc. Resolve the tag we just established so the final
  # PKGBUILDs record both its provenance and its exact commit.
  local stable_pub
  if all_arches_at_version rc "$version"; then
    print_success "2/7 Final $version already published to rc on every architecture"
  else
    if [[ "$pin_ver" != "$version" ]]; then
      print_info "2/7 Pinning final $version from tag v$version..."
      cut_pins "v$version"
    else
      print_info "2/7 Final $version pinned — re-triggering build"
    fi
    trigger_rc_build --wait || exit 1
    wait_for_published rc "$version" || exit 1
  fi

  # 3. Promote rc -> stable
  if all_arches_at_version stable "$version"; then
    print_success "3/7 Stable already serves $version on every architecture"
  else
    local arch rc_sync stable_sync behind=0
    for arch in $(ci_arches); do
      stable_mirror_matches_rc "$arch" && continue
      rc_sync=$(mirror_lastsync "$(arch_mirror rc "$arch")") || rc_sync=unreadable
      stable_sync=$(mirror_lastsync "$(arch_mirror stable "$arch")") || stable_sync=unreadable
      print_error "3/7 The stable $arch Arch mirror does not serve rc's snapshot yet (lastsync: rc $rc_sync, stable $stable_sync)"
      print_info "$(mirror_sync_hint "$rc_sync" "$stable_sync" "$arch")"
      behind=1
    done
    ((behind == 0)) || exit 1
    print_success "3/7 The stable Arch mirrors serve rc's snapshot: $(ci_arches | paste -sd' ')"
    promote_channel rc stable || exit 1
    if ! all_arches_at_version stable "$version"; then
      print_error "Promotion ran but stable does not serve $version on every architecture"
      exit 1
    fi
    stable_pub=$(published_version stable 2>/dev/null) || stable_pub="$version"
    print_success "3/7 Promoted to stable: omarchy $stable_pub on every architecture"
  fi

  # 4. Final pins onto master: the repo record. Edge already serves the final
  # from step 2, so the merge's publish finds nothing to build.
  local master_ver
  master_ver=$(git -C "$BUILD_ROOT" show origin/master:pkgbuilds/omarchy/PKGBUILD 2>/dev/null | grep -E '^pkgver=' | head -1 | cut -d= -f2)
  if [[ "$master_ver" == "$version" ]]; then
    print_success "4/7 master already carries the $version pins"
  else
    local pin_sha
    pin_sha=$(git -C "$BUILD_ROOT" rev-parse origin/rc 2>/dev/null || true)
    print_info "4/7 Bringing the final pin commit to master..."
    local sync_wt="$BUILD_ROOT/.worktrees/master-sync"
    git -C "$BUILD_ROOT" fetch --quiet origin
    if [[ ! -d "$sync_wt" ]]; then
      git -C "$BUILD_ROOT" worktree add --quiet -B release-master-sync "$sync_wt" origin/master
    else
      git -C "$sync_wt" checkout --quiet -B release-master-sync origin/master
    fi
    if (cd "$sync_wt" && git cherry-pick "$pin_sha" && git push --quiet origin HEAD:master); then
      print_success "4/7 Final pins merged to master"
    else
      (cd "$sync_wt" && git cherry-pick --abort 2>/dev/null || true)
      print_warning "4/7 Could not fast-path the pins to master — cherry-pick $pin_sha onto master manually"
    fi
  fi

  # 5. Draft GitHub release from the staging PR body, or for a minor/major,
  # which has no staging PR, from GitHub's notes for the PRs since the last
  # release. Requiring the tag makes this fail closed if step 1 did not finish
  # instead of letting gh create the tag from the default branch.
  if gh release view "v$version" --repo "$UPSTREAM_REPO" >/dev/null 2>&1; then
    print_success "5/7 GitHub release v$version already exists"
  else
    local -a notes_args
    if follows_dev_branch "$branch"; then
      notes_args=(--generate-notes)
    else
      local notes
      notes=$(gh pr view "$branch" --repo "$UPSTREAM_REPO" --json body --jq '.body' 2>/dev/null) || notes=""
      if [[ -z "$notes" || "$notes" == "null" ]]; then
        notes="Omarchy $version"
        print_warning "No staging PR body found — using a bare title; edit the release afterwards"
      fi
      notes_args=(--notes "$notes")
    fi
    gh release create "v$version" --repo "$UPSTREAM_REPO" --title "v$version" \
      "${notes_args[@]}" --draft --verify-tag
    print_success "5/7 Draft GitHub release v$version created"
  fi

  # 6. ISO
  maybe_iso "$version" final "$iso_mode" || true

  # 7. Website (only meaningful once the final ISO exists)
  if [[ "$iso_mode" != "no" ]]; then
    update_website "$version" || true
  else
    print_info "7/7 --no-iso: leaving the website untouched"
  fi

  echo ""
  print_success "Shipped $version — rc and stable are in parity for the next patch train"
  if ! follows_dev_branch "$branch"; then
    print_info "Close the loop: merge or close the staging PR for $branch on $UPSTREAM_REPO"
  fi
}

# --- status / shepherd -------------------------------------------------------

gather_status() {
  EDGE_VER=$(published_version edge 2>/dev/null) || EDGE_VER="<unreachable>"
  RC_VER=$(published_version rc 2>/dev/null) || RC_VER="<unreachable>"
  STABLE_VER=$(published_version stable 2>/dev/null) || STABLE_VER="<unreachable>"
  local train
  train=$(open_train 2>/dev/null) || train=""
  TRAIN=""
  TRAIN_VER=""
  TRAIN_HEAD=""
  PIN=""
  if [[ -n "$train" ]]; then
    TRAIN_VER="${train% *}" TRAIN="${train#* }"
    TRAIN_HEAD=$(branch_head "$TRAIN")
    PIN=$(rc_branch_pin)
  fi
}

next_step() { # prints "<command>|<description>"
  if [[ -z "$TRAIN" ]]; then
    # A tagged train may still have unfinished ship steps (release/ISO/site).
    local last last_ver
    last=$(newest_train 2>/dev/null) || last=""
    if [[ -n "$last" && "$STABLE_VER" != "<unreachable>" ]]; then
      last_ver="${last% *}"
      if ! all_arches_at_version stable "$last_ver" ||
        { command -v gh >/dev/null && ! gh release view "v$last_ver" --repo "$UPSTREAM_REPO" >/dev/null 2>&1; }; then
        echo "ship|$last_ver is tagged but not fully shipped — resume ship"
        return
      fi
    fi
    echo "start|No open train — start the next release"
    return
  fi
  local pin_ver="${PIN%% *}" pin_commit="${PIN##* }"
  if [[ -z "$PIN" || ! "$pin_ver" =~ ^${TRAIN_VER//./\\.}(rc[0-9]+)?$ ]]; then
    echo "rc|Cut the first candidate for $TRAIN_VER"
  elif [[ "$pin_ver" == "$TRAIN_VER" ]]; then
    echo "ship|Final $TRAIN_VER is pinned — finish shipping (re-runs are safe)"
  elif [[ "$pin_commit" != "$TRAIN_HEAD" ]] && ! follows_dev_branch "$TRAIN"; then
    echo "rc|$TRAIN has commits newer than $pin_ver — cut the next candidate"
  elif ! all_arches_at_version rc "$pin_ver"; then
    echo "rc|$pin_ver is pinned but not published — re-run rc to re-trigger/wait"
  elif [[ "$pin_commit" != "$TRAIN_HEAD" ]]; then
    # The dev branch never stops moving; whether to take it is a judgment call.
    echo "ship|$pin_ver is published to rc — test it, then ship (or rc again to take $TRAIN's newer commits)"
  else
    echo "ship|$pin_ver is published to rc — test it, then ship"
  fi
}

print_status() {
  print_header "Omarchy release status"
  echo "  Channels (omarchy):"
  echo "    edge:   $EDGE_VER"
  echo "    rc:     $RC_VER"
  echo "    stable: $STABLE_VER"
  echo ""
  if [[ -z "$TRAIN" ]]; then
    echo "  No open release train."
  else
    if follows_dev_branch "$TRAIN"; then
      echo "  Open train: $TRAIN_VER (follows $TRAIN @ ${TRAIN_HEAD:0:12})"
    else
      echo "  Open train: $TRAIN_VER (branch $TRAIN @ ${TRAIN_HEAD:0:12})"
    fi
    if [[ -n "$PIN" ]]; then
      echo "  Current pin: ${PIN%% *} from commit ${PIN##* }"
    else
      echo "  Current pin: <none>"
    fi
  fi
  echo ""
  local step
  step=$(next_step)
  echo "  Next: omarchy-release ${step%%|*}  — ${step#*|}"
}

cmd_shepherd() {
  gather_status
  print_status
  local step cmd
  step=$(next_step)
  cmd="${step%%|*}"
  echo ""
  if confirm "Run 'omarchy-release $cmd' now?"; then
    case "$cmd" in
    start) cmd_start ;;
    pick) cmd_pick ;;
    rc) cmd_rc "$ISO_MODE" "$WAIT" ;;
    ship) cmd_ship "$ISO_MODE" "$WAIT" ;;
    esac
  fi
}

# --- doctor ------------------------------------------------------------------

cmd_doctor() {
  print_header "omarchy-release doctor"
  local failures=0
  check() {
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then
      print_success "$label"
    else
      print_error "$label"
      failures=$((failures + 1))
    fi
  }
  check "git available" command -v git
  check "gh available" command -v gh
  check "gh authenticated" gh auth status
  check "gh can see $UPSTREAM_REPO" gh repo view "$UPSTREAM_REPO"
  check "gh can see $SITE_REPO" gh repo view "$SITE_REPO"
  check "gh can run release-rc.yml on $PKGS_REPO" gh workflow view release-rc.yml -R "$PKGS_REPO"
  check "gh can run promote.yml on $PKGS_REPO" gh workflow view promote.yml -R "$PKGS_REPO"
  check "vercmp available (pacman)" command -v vercmp
  check "makepkg available (checksums)" command -v makepkg
  check "curl available" command -v curl
  check "upstream reachable ($UPSTREAM_URL)" git ls-remote "$UPSTREAM_URL" HEAD
  local ch arch
  for ch in edge rc stable; do
    for arch in $(ci_arches); do
      if published_version "$ch" "$arch" >/dev/null 2>&1; then
        print_success "$ch/$arch channel db readable"
      else
        print_error "$ch/$arch channel db readable"
        failures=$((failures + 1))
      fi
    done
  done
  if [[ -n "$CONTAINER_ENGINE" ]] && "$CONTAINER_ENGINE" info >/dev/null 2>&1; then
    print_success "$CONTAINER_ENGINE available (ISO builds possible here)"
  else
    print_warning "container engine unavailable — ISO builds will print instructions instead"
  fi
  echo ""
  if ((failures == 0)); then
    print_success "Ready to release"
  else
    print_error "$failures check(s) failed"
    exit 1
  fi
}

# --- self-test ---------------------------------------------------------------

cmd_self_test() {
  local failures=0
  expect() { # expect <label> <got> <want>
    if [[ "$2" == "$3" ]]; then
      echo "  ok: $1"
    else
      echo "  FAIL: $1 — got '$2', want '$3'"
      failures=$((failures + 1))
    fi
  }
  print_header "omarchy-release self-test"
  expect "version_to_branch 4.0.2" "$(version_to_branch 4.0.2)" "v4-0-2"
  expect "version_to_branch v4.1.0" "$(version_to_branch v4.1.0)" "v4-1-0"
  expect "version_to_branch garbage rejects" "$(version_to_branch 4.0 2>/dev/null || echo reject)" "reject"
  expect "branch_to_version v4-0-2" "$(branch_to_version v4-0-2)" "4.0.2"
  expect "branch_to_version v10-2-33" "$(branch_to_version v10-2-33)" "10.2.33"
  expect "branch_to_version quattro rejects" "$(branch_to_version quattro 2>/dev/null || echo reject)" "reject"
  expect "version_is_patch 4.0.2" "$(version_is_patch 4.0.2 && echo yes || echo no)" "yes"
  expect "version_is_patch 4.1.0" "$(version_is_patch 4.1.0 && echo yes || echo no)" "no"
  expect "version_is_patch 5.0.0" "$(version_is_patch 5.0.0 && echo yes || echo no)" "no"
  expect "previous_patch_tag 4.0.2" "$(previous_patch_tag 4.0.2)" "v4.0.1"
  expect "previous_patch_tag 4.0.10" "$(previous_patch_tag 4.0.10)" "v4.0.9"
  expect "rc_tag 4.5.0 3" "$(rc_tag 4.5.0 3)" "v4.5.0-rc3"
  expect "x86_64 ISO needs no --arch" "$(iso_release_command x86_64 4.5.0rc1 --rc)" "bin/omarchy-iso-release --rc 4.5.0rc1"
  expect "aarch64 ISO names its arch" "$(iso_release_command aarch64 4.5.0rc1 --rc)" "bin/omarchy-iso-release --rc --arch aarch64 4.5.0rc1"
  expect "final aarch64 ISO" "$(iso_release_command aarch64 4.5.0)" "bin/omarchy-iso-release --arch aarch64 4.5.0"
  expect "edge_promotion_choice a" "$(edge_promotion_choice a)" "all"
  expect "edge_promotion_choice none" "$(edge_promotion_choice ' none ')" "none"
  expect "edge_promotion_choice pkgbases" "$(edge_promotion_choice '  omakade   omacharts ')" "omakade omacharts"
  expect "edge_promotion_choice empty asks again" "$(edge_promotion_choice '   ')" ""

  # Minor/major trains are found by their rc tags on the dev branch; patch
  # trains by their release branches. This replaces the network reader for
  # this process; self-test exits immediately afterwards.
  TEST_TAGS=$'v4.0.0-beta3\nv4.0.0\nv4.0.5\nv4.0.6\nv4.5.0-rc1\nv4.5.0-rc2\nv4.5.0-rc10\nv4.50.0-rc7\nv4.6.0-rc1x'
  TEST_BRANCHES=$'v4-0-5\nv4-0-6\nvoxtype-cohere-vulkan'
  ls_remote() {
    case "$*" in
      "--tags refs/tags/v*") sed 's|^|0000000000000000000000000000000000000000\trefs/tags/|' <<<"$TEST_TAGS" ;;
      "refs/heads/v*") sed 's|^|0000000000000000000000000000000000000000\trefs/heads/|' <<<"$TEST_BRANCHES" ;;
    esac
  }
  expect "rc_tag_versions ignores betas and malformed tags" "$(rc_tag_versions <<<"$TEST_TAGS" | tr '\n' ' ')" "4.5.0 4.50.0 "
  expect "newest_rc_number orders numerically" "$(newest_rc_number 4.5.0 <<<"$TEST_TAGS")" "10"
  expect "newest_rc_number does not match a longer version" "$(newest_rc_number 4.5.0 <<<"v4.50.0-rc7")" ""
  expect "newest_rc_number with no candidates" "$(newest_rc_number 4.7.0 <<<"$TEST_TAGS")" ""
  TEST_TAGS=$'v4.0.5\nv4.0.6\nv4.5.0-rc1\nv4.5.0-rc2'
  expect "an rc-tagged minor is an open train on the dev branch" "$(open_train)" "4.5.0 $DEV_BRANCH"
  TEST_TAGS+=$'\nv4.5.0'
  expect "the final tag closes a minor train" "$(open_train || echo none)" "none"
  expect "a shipped minor stays findable for resume" "$(newest_train)" "4.5.0 $DEV_BRANCH"
  TEST_BRANCHES+=$'\nv4-5-1'
  expect "a patch train after it follows its branch" "$(open_train)" "4.5.1 v4-5-1"
  TEST_TAGS=$'v4.0.5' TEST_BRANCHES=$'v4-0-5\nv4-0-6'
  expect "an untagged patch branch is the open train" "$(open_train)" "4.0.6 v4-0-6"
  expect "follows_dev_branch $DEV_BRANCH" "$(follows_dev_branch "$DEV_BRANCH" && echo yes || echo no)" "yes"
  expect "follows_dev_branch v4-0-6" "$(follows_dev_branch v4-0-6 && echo yes || echo no)" "no"

  # Keep release readiness fail-closed when only one architecture has reached
  # the requested version. This replaces the network reader for this process;
  # self-test exits immediately afterwards.
  published_version() {
    case "$2" in
      x86_64) echo "${TEST_X86_VERSION:-4.0.2-1}" ;;
      aarch64) echo "${TEST_ARM_VERSION:-4.0.2-1}" ;;
    esac
  }
  CI_ARCHES=x86_64
  expect "x86-only readiness" "$(all_arches_at_version rc 4.0.2 && echo ready || echo blocked)" "ready"
  CI_ARCHES=aarch64
  expect "ARM-only readiness" "$(all_arches_at_version rc 4.0.2 && echo ready || echo blocked)" "ready"
  CI_ARCHES="x86_64 aarch64"
  TEST_ARM_VERSION=4.0.1-1
  expect "mixed versions block release" "$(all_arches_at_version rc 4.0.2 && echo ready || echo blocked)" "blocked"
  TEST_ARM_VERSION=4.0.2-1
  expect "both architectures ready" "$(all_arches_at_version rc 4.0.2 && echo ready || echo blocked)" "ready"

  # Ship promotes packages only once stable's Arch mirror serves rc's snapshot,
  # on every architecture.
  mirror_lastsync() {
    case "$1" in
      "$RC_ARCH_MIRROR") [[ ${TEST_RC_SYNC-1792185002} ]] && echo "${TEST_RC_SYNC-1792185002}" || return 2 ;;
      "$STABLE_ARCH_MIRROR") [[ ${TEST_STABLE_SYNC-1792185002} ]] && echo "${TEST_STABLE_SYNC-1792185002}" || return 2 ;;
      "$RC_ARM_MIRROR") [[ ${TEST_ARM_RC_SYNC-1792494243} ]] && echo "${TEST_ARM_RC_SYNC-1792494243}" || return 2 ;;
      "$STABLE_ARM_MIRROR") [[ ${TEST_ARM_STABLE_SYNC-1792494243} ]] && echo "${TEST_ARM_STABLE_SYNC-1792494243}" || return 2 ;;
      *) return 2 ;;
    esac
  }
  expect "mirror on rc's snapshot" "$(stable_mirror_matches_rc && echo ready || echo blocked)" "ready"
  TEST_STABLE_SYNC=1792286001
  expect "mirror on another snapshot blocks" "$(stable_mirror_matches_rc && echo ready || echo blocked)" "blocked"
  TEST_STABLE_SYNC=""
  expect "unreadable mirror blocks" "$(stable_mirror_matches_rc && echo ready || echo blocked)" "blocked"
  expect "stable ahead of rc is not rolled back" "$(mirror_sync_hint 1792185002 1792286001 | grep -o 'omarchy-mirror-[a-z-]*' | head -1) $(mirror_sync_hint 1792185002 1792286001 | grep -o 'to /mnt/arch-mirror-[a-z]*')" "omarchy-mirror-copy-stage to /mnt/arch-mirror-rc"
  expect "an unreadable mirror suggests no copy" "$(mirror_sync_hint 1792185002 unreadable | grep -o 'omarchy-mirror-sync-[a-z-]*' || echo none)" "none"
  expect "stable behind rc takes rc's snapshot" "$(mirror_sync_hint 1792286001 1792185002 | grep -o 'omarchy-mirror-sync-[a-z-]*')" "omarchy-mirror-sync-stable-from-rc"
  TEST_STABLE_SYNC=1792185002
  TEST_ARM_STABLE_SYNC=1791398870
  expect "an ARM mirror on another snapshot blocks" "$(stable_mirror_matches_rc && echo ready || echo blocked)" "blocked"
  expect "x86_64 alone is on rc's snapshot" "$(stable_mirror_matches_rc x86_64 && echo ready || echo blocked)" "ready"
  expect "aarch64 alone is not" "$(stable_mirror_matches_rc aarch64 && echo ready || echo blocked)" "blocked"
  TEST_ARM_STABLE_SYNC=""
  expect "an unreadable ARM mirror blocks" "$(stable_mirror_matches_rc && echo ready || echo blocked)" "blocked"
  CI_ARCHES=x86_64
  expect "an x86_64-only release does not read the ARM mirrors" "$(stable_mirror_matches_rc && echo ready || echo blocked)" "ready"
  CI_ARCHES="x86_64 aarch64"
  expect "ARM stable behind rc takes rc's snapshot" "$(mirror_sync_hint 1792494243 1791398870 aarch64 | grep -o 'omarchy-mirror-promote-arm --from [^ ]* --to [^ ,]*')" "omarchy-mirror-promote-arm --from omarchy:omarchy-mirror-arm-rc --to omarchy:omarchy-mirror-arm-stable"
  expect "ARM stable ahead of rc is not rolled back" "$(mirror_sync_hint 1791398870 1792494243 aarch64 | grep -o 'omarchy-mirror-promote-arm --from [^ ]* --to [^ ,]*')" "omarchy-mirror-promote-arm --from omarchy:omarchy-mirror-arm-stable --to omarchy:omarchy-mirror-arm-rc"
  expect "an unreadable ARM mirror names its hosts" "$(mirror_sync_hint 1792494243 unreadable aarch64 | grep -o 'https://arm-[a-z]*-mirror.omarchy.org' | paste -sd' ')" "https://arm-rc-mirror.omarchy.org https://arm-stable-mirror.omarchy.org"
  echo ""
  if ((failures == 0)); then
    print_success "Self-test passed"
  else
    print_error "$failures self-test failure(s)"
    exit 1
  fi
}

# --- dispatch ----------------------------------------------------------------

COMMAND=""
ISO_MODE="ask"
WAIT=true
PROMOTE_EDGE=""
ARGS=()
while [[ $# -gt 0 ]]; do
  case $1 in
  --yes) ASSUME_YES=true; shift ;;
  --iso) ISO_MODE="yes"; shift ;;
  --no-iso) ISO_MODE="no"; shift ;;
  --no-wait) WAIT=false; shift ;;
  --promote-edge) PROMOTE_EDGE=all; shift ;;
  --promote-edge=*) PROMOTE_EDGE=$(edge_promotion_choice "${1#*=}"); shift ;;
  --no-promote-edge) PROMOTE_EDGE=none; shift ;;
  -h | --help) show_usage; exit 0 ;;
  start | pick | rc | ship | status | doctor | self-test)
    COMMAND="$1"; shift ;;
  *)
    ARGS+=("$1"); shift ;;
  esac
done

case "$COMMAND" in
start) cmd_start "${ARGS[@]}" ;;
pick) cmd_pick "${ARGS[@]}" ;;
rc) cmd_rc "$ISO_MODE" "$WAIT" ;;
ship) cmd_ship "$ISO_MODE" "$WAIT" ;;
status) gather_status; print_status ;;
doctor) cmd_doctor ;;
self-test) cmd_self_test ;;
"") cmd_shepherd ;;
*) print_error "Unknown command: $COMMAND"; show_usage; exit 1 ;;
esac
