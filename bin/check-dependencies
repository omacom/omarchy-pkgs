#!/bin/bash
# List every dependency an upgrade cannot meet.
#
# Usage: bin/check-dependencies <omarchy db> <arch repo db>...
#   The databases in pacman.conf order: Omarchy's first, then core, extra and
#   the rest, as every Omarchy machine lists them.
# Output: <package>TAB<dependency>, one per line, sorted.
#
# pacman -Syu takes every package from the first repository that has its
# name, replaces a package that one of those lists in `replaces` (from a
# repository at or before the replaced one's, and for a versioned entry only
# when the version matches), and then needs each dependency met by one of
# the result, by name or by what it provides; an unversioned provision never
# meets a versioned dependency. This applies that rule to every package an
# upgrade could take, in every repository, and prints each dependency
# nothing meets. On 2026-10-28 it prints omarchy-hyprland-titlebars needing
# hyprland=0.56.2 once the first hyprland is extra's 0.57.0, whatever older
# copy another repository has.
#
# Callers compare two runs (before and after a publish or a mirror sync) and
# fail on lines only the second has, so what was already broken does not
# block an unrelated change. A dependency met only by a provider that
# conflicts with the package it replaces is counted as met: telling those
# apart needs the machine's installed set. Needs bsdtar and pacman's vercmp.
set -euo pipefail

(( $# >= 2 )) || { echo "usage: ${0##*/} <omarchy db> <arch repo db>..." >&2; exit 2; }

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# meets <version> <op> <wanted>: whether <version> satisfies <op><wanted>.
# Most versioned dependencies are sonames met by the same string: no fork.
meets() {
  local c
  if [[ $1 == "$3" && $2 == *=* ]]; then return 0; fi
  c=$(vercmp "$1" "$3")
  case $2 in
    '=') (( c == 0 )) ;;
    '>=') (( c >= 0 )) ;;
    '<=') (( c <= 0 )) ;;
    '>') (( c > 0 )) ;;
    '<') (( c < 0 )) ;;
    *) return 1 ;;
  esac
}

# P<TAB>rank<TAB>name<TAB>version, and D, V and R lines for dependencies,
# provisions and replacements, rank 1 being the first database.
rank=0
for db in "$@"; do
  rank=$((rank + 1))
  # Arch Linux ARM still writes the older layout, with dependencies and
  # provisions in a separate `depends` file next to `desc`. Reverse order
  # puts each entry's desc (and its %NAME%) before its depends.
  mkdir "$work/db$rank"
  bsdtar -xf "$db" -C "$work/db$rank"
  find "$work/db$rank" -mindepth 2 -maxdepth 2 \( -name desc -o -name depends \) | sort -r | xargs -r cat |
  awk -v rank="$rank" -v OFS='\t' '
    /^%NAME%$/ { getline; name = $0; next }
    /^%VERSION%$/ { getline; print "P", rank, name, $0; next }
    /^%DEPENDS%$/ { while ((getline line) > 0 && line != "") print "D", rank, name, line; next }
    /^%PROVIDES%$/ { while ((getline line) > 0 && line != "") print "V", rank, name, line; next }
    /^%REPLACES%$/ { while ((getline line) > 0 && line != "") print "R", rank, name, line; next }'
done > "$work/table"

# The packages an upgrade replaces: <replaced>TAB<op>TAB<wanted>TAB<its
# version>, op and wanted "-" for an unversioned entry: read collapses
# empty fields between tabs.
awk -F'\t' -v OFS='\t' '
  $1 == "P" { if (!($3 in rank) || $2 < rank[$3]) { rank[$3] = $2; version[$3] = $4 }; next }
  $1 == "R" { repl[++nr] = $0 }
  END {
    for (i = 1; i <= nr; i++) {
      split(repl[i], f, FS)
      if (!(f[3] in rank) || rank[f[3]] != f[2]) continue
      r = f[4]; op = "-"; wanted = "-"
      if (match(r, /(>=|<=|=|<|>)/)) { op = substr(r, RSTART, RLENGTH); wanted = substr(r, RSTART + RLENGTH); r = substr(r, 1, RSTART - 1) }
      if (r != f[3] && (r in rank) && f[2] <= rank[r]) print r, op, wanted, version[r]
    }
  }' "$work/table" |
while IFS=$'\t' read -r replaced op wanted have; do
  if [[ $op == - ]] || meets "$have" "$op" "$wanted"; then echo "$replaced"; fi
done | sort -u > "$work/gone"

# Each dependency of each package an upgrade takes, with every candidate
# that could meet it: a version, "-" for an unversioned provision, or "none".
awk -F'\t' -v OFS='\t' '
  FILENAME == ARGV[1] { gone[$1] = 1; next }
  $1 == "P" { if (!($3 in rank) || $2 < rank[$3]) { rank[$3] = $2; version[$3] = $4 }; next }
  $1 == "D" { dep[++nd] = $0; next }
  $1 == "V" { prov[++np] = $0; next }
  function base(s) { sub(/[<>=].*/, "", s); return s }
  function taken(name, r) { return (name in rank) && rank[name] == r && !(name in gone) }
  END {
    for (i = 1; i <= np; i++) {
      split(prov[i], f, FS)
      if (!taken(f[3], f[2])) continue
      p = base(f[4]); v = index(f[4], "=") ? substr(f[4], index(f[4], "=") + 1) : "-"
      provides[p] = provides[p] SUBSEP v
    }
    for (i = 1; i <= nd; i++) {
      split(dep[i], f, FS)
      if (!taken(f[3], f[2])) continue
      name = base(f[4]); any = 0
      if ((name in rank) && !(name in gone)) { print f[3], f[4], version[name]; any = 1 }
      m = split(provides[name], pv, SUBSEP)
      for (j = 2; j <= m; j++) { print f[3], f[4], pv[j]; any = 1 }
      if (!any) print f[3], f[4], "none"
    }
  }' "$work/gone" "$work/table" |
sort -u > "$work/candidates"

# A dependency is met when any candidate meets it.
declare -A met=()
while IFS=$'\t' read -r package dependency candidate; do
  key="$package"$'\t'"$dependency"
  [[ -n ${met[$key]+x} ]] || met[$key]=0
  if [[ ${met[$key]} == 1 || $candidate == none ]]; then continue; fi
  if [[ $dependency =~ ^[^\<\>=]+(>=|<=|=|<|>)(.+)$ ]]; then
    if [[ $candidate != - ]] && meets "$candidate" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"; then met[$key]=1; fi
  else
    met[$key]=1
  fi
done < "$work/candidates"
for key in "${!met[@]}"; do
  if [[ ${met[$key]} == 0 ]]; then printf '%s\n' "$key"; fi
done | sort
