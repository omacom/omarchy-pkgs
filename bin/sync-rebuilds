#!/usr/bin/env python3
"""Bump pkgrel for packages that must be rebuilt when a dependency changes.

A package opts in by naming trigger dependencies in .omarchy/package.json:

  { "source": "aur", "sync": false, "rebuild_on": ["qt6-base"] }

The versions the current pkgrel was bumped for are recorded per published
architecture in rebuilt_against, and written by this command:

  { "rebuild_on": ["qt6-base"], "rebuilt_against": {
      "x86_64": { "qt6-base": "6.11.2-3" },
      "aarch64": { "qt6-base": "6.11.2-2" }
  } }

Per-package edits are staged and validated before either PKGBUILD or
.omarchy/package.json is replaced, and PKGBUILD is rolled back atomically if
committing metadata fails or the process is interrupted between renames.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
VALID_ARCHES = ("x86_64", "aarch64")
OFFICIAL_REPOS = frozenset({"core", "extra", "multilib", "core-debug", "extra-debug"})
PUBLISHED_MIRRORS = ("edge", "stable")
ALARM_REPOS = ("core", "extra", "alarm", "aur")

PKGREL_RE = re.compile(r"^[0-9]+(?:\.[0-9]+)?$")
PKGREL_LINE_RE = re.compile(r"^pkgrel=.*$", re.MULTILINE)
ALPM_VER_RE = re.compile(r"^[0-9A-Za-z._+~:-]+$")
DEPENDS_START_RE = re.compile(r"^([ \t]*)(depends(?:_[A-Za-z0-9_]+)?)(\+?=)\(")
HEREDOC_RE = re.compile(
    r"(?:^|[^<])(<<-?)[ \t]*(\\?[A-Za-z_][A-Za-z0-9_]*|'[^']+'|\"[^\"]+\")"
)


class SyncError(Exception):
    """Operational or validation failure for a package or repository."""


def print_header(text: str) -> None:
    print("================================")
    print(text)
    print("================================")


def print_info(text: str) -> None:
    print(f"==> {text}")


def print_success(text: str) -> None:
    print(f"✓ {text}")


def print_warning(text: str) -> None:
    print(f"⚠ {text}", file=sys.stderr)


def print_error(text: str) -> None:
    print(f"✗ {text}", file=sys.stderr)


def get_pkgbuilds_dir() -> Path:
    env_dir = os.environ.get("PKGBUILDS_DIR")
    return Path(env_dir) if env_dir else ROOT / "pkgbuilds"


def get_ci_arches() -> list[str]:
    raw = (os.environ.get("CI_ARCHES") or "x86_64 aarch64").split()
    for arch in raw:
        if arch not in VALID_ARCHES:
            raise SyncError(
                f"Invalid architecture: {arch} (must be one of: {' '.join(VALID_ARCHES)})"
            )
    return raw


def vercmp(a: str, b: str) -> int:
    proc = subprocess.run(["vercmp", a, b], capture_output=True, text=True, check=False)
    if proc.returncode != 0:
        raise SyncError(f"vercmp failed comparing {a!r} and {b!r}")
    return int(proc.stdout.strip())


def version_pkgver(version: str) -> str:
    """Return pkgver with any epoch and pkgrel removed."""
    if ":" in version:
        version = version.split(":", 1)[1]
    return version.rsplit("-", 1)[0]


def version_normalized(version: str) -> str:
    """Return a full version with any zero epoch omitted, matching makepkg."""
    return version[2:] if version.startswith("0:") else version


def version_without_pkgrel(version: str) -> str:
    """Return [epoch:]pkgver with pkgrel removed and zero epoch omitted."""
    return version_normalized(version).rsplit("-", 1)[0]


def bump_pkgrel(pkgrel: str) -> str | None:
    """2 -> 3, and 1.1 -> 1.2. Reject anything else."""
    if not PKGREL_RE.match(pkgrel):
        return None
    if "." in pkgrel:
        head, tail = pkgrel.rsplit(".", 1)
        return f"{head}.{int(tail) + 1}"
    return str(int(pkgrel) + 1)


@dataclass(frozen=True)
class RecipeFields:
    pkgver: str
    pkgrel: str
    epoch: str
    arches: tuple[str, ...]


def read_pkgbuild_fields(pkgdir: Path, arch: str = "x86_64") -> RecipeFields | None:
    """Source PKGBUILD once with CARCH set and return version and arch fields."""
    env = os.environ.copy()
    env.pop("OMARCHY_SRC", None)
    env["CARCH"] = arch
    script = (
        'source PKGBUILD >/dev/null 2>&1 || exit 1\n'
        'printf "pkgver\\t%s\\npkgrel\\t%s\\nepoch\\t%s\\n" "${pkgver:-}" "${pkgrel:-}" "${epoch:-}"\n'
        'for a in "${arch[@]}"; do printf "arch\\t%s\\n" "$a"; done\n'
    )
    proc = subprocess.run(
        ["bash", "-c", script], cwd=pkgdir, env=env, capture_output=True, text=True, check=False
    )
    if proc.returncode != 0:
        return None
    pkgver = pkgrel = epoch = ""
    arches: list[str] = []
    for line in proc.stdout.splitlines():
        key, sep, val = line.partition("\t")
        if not sep:
            continue
        if key == "pkgver":
            pkgver = val
        elif key == "pkgrel":
            pkgrel = val
        elif key == "epoch":
            epoch = val
        elif key == "arch" and val:
            arches.append(val)
    return RecipeFields(pkgver=pkgver, pkgrel=pkgrel, epoch=epoch, arches=tuple(arches))


def package_supports_arch(pkgdir: Path, target: str) -> bool:
    fields = read_pkgbuild_fields(pkgdir, target)
    return fields is not None and ("any" in fields.arches or target in fields.arches)


def format_carried_version(fields: RecipeFields) -> str | None:
    if not fields.pkgver or not fields.pkgrel:
        return None
    epoch = "" if fields.epoch in ("", "0") else fields.epoch
    return f"{epoch}:{fields.pkgver}-{fields.pkgrel}" if epoch else f"{fields.pkgver}-{fields.pkgrel}"


def carried_version(arch: str, pkgdir: Path) -> str | None:
    fields = read_pkgbuild_fields(pkgdir, arch)
    return format_carried_version(fields) if fields else None


def resolve_carried_trigger(pkgbuilds_dir: Path, arch: str, trigger: str) -> tuple[bool, str | None]:
    """Return (is_carried, version) with a single PKGBUILD source."""
    pkgdir = pkgbuilds_dir / trigger
    if not ((pkgdir / "PKGBUILD").is_file() and (pkgdir / ".omarchy" / "package.json").is_file()):
        return False, None
    fields = read_pkgbuild_fields(pkgdir, arch)
    if fields is None or ("any" not in fields.arches and arch not in fields.arches):
        return False, None
    return True, format_carried_version(fields)


def parse_alpm_desc_stream(text: str) -> list[tuple[str, str, str]]:
    """Parse concatenated ALPM desc files into (name, base, version) tuples."""
    entries: list[tuple[str, str, str]] = []
    name = base = version = ""
    lines = iter(text.splitlines())

    def emit() -> None:
        nonlocal name, base, version
        if name and version:
            entries.append((name, base, version))
        name = base = version = ""

    for line in lines:
        if line == "%FILENAME%":
            emit()
        elif line == "%NAME%":
            if name and version:
                emit()
            name = next(lines, "")
        elif line == "%BASE%":
            base = next(lines, "")
        elif line == "%VERSION%":
            version = next(lines, "")
    emit()
    return entries


def extract_db_entries(db_path: Path) -> list[tuple[str, str, str]] | None:
    """Validate a repo tarball and extract all (name, base, version) entries."""
    listing = subprocess.run(
        ["tar", "-tf", str(db_path)], capture_output=True, text=True, check=False
    )
    if listing.returncode != 0:
        return None
    if not any(line.endswith("/desc") for line in listing.stdout.splitlines()):
        return []
    extract = subprocess.run(
        ["tar", "-xOf", str(db_path), "--wildcards", "*/desc"],
        capture_output=True,
        text=True,
        check=False,
    )
    if extract.returncode != 0:
        return None
    return parse_alpm_desc_stream(extract.stdout)


@dataclass
class RepoCache:
    temp_dir: Path
    ci_arches: list[str]
    published_base_url: str = field(
        default_factory=lambda: os.environ.get(
            "OMARCHY_PUBLISHED_BASE_URL", "https://pkgs.omarchy.org"
        )
    )
    alarm_base_url: str = field(
        default_factory=lambda: os.environ.get(
            "OMARCHY_ALARM_BASE_URL", "https://arm-mirror.omarchy.org/aarch64"
        )
    )
    published_loaded: bool = False
    published_versions: dict[str, str] = field(default_factory=dict)
    edge_versions: dict[tuple[str, str], str] = field(default_factory=dict)
    edge_read: set[str] = field(default_factory=set)
    alarm_repos: dict[str, dict[str, str]] = field(default_factory=dict)

    def _download(self, url: str, dest: Path) -> bool:
        proc = subprocess.run(
            ["curl", "-fsSL", "--max-time", "120", "-o", str(dest), url],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        return proc.returncode == 0

    def native_repo_version(self, package: str) -> str | None:
        env = os.environ.copy()
        env["LC_ALL"] = "C"
        proc = subprocess.run(
            ["pacman", "-Si", package], env=env, capture_output=True, text=True, check=False
        )
        if proc.returncode != 0:
            return None
        repo = ""
        for line in proc.stdout.splitlines():
            key, sep, val = line.partition(":")
            if not sep:
                continue
            key, val = key.strip(), val.strip()
            if key == "Repository":
                repo = val
            elif key == "Version" and repo in OFFICIAL_REPOS:
                return val
        return None

    def _load_alarm_repo(self, repo: str) -> dict[str, str]:
        if repo in self.alarm_repos:
            return self.alarm_repos[repo]
        db = self.temp_dir / f"alarm-{repo}.db"
        if not self._download(f"{self.alarm_base_url}/{repo}/{repo.split('/')[-1]}.db", db):
            raise SyncError(f"Could not read the aarch64 {repo} repository database")
        entries = extract_db_entries(db)
        if entries is None:
            raise SyncError(f"Unreadable aarch64 {repo} repository database")
        index: dict[str, str] = {}
        for name, base, version in entries:
            index.setdefault(name, version)
            if base and base != name:
                index.setdefault(base, version)
        self.alarm_repos[repo] = index
        return index

    def repo_version(self, arch: str, package: str) -> str | None:
        if arch == "x86_64":
            return self.native_repo_version(package)
        if arch == "aarch64":
            for repo in ALARM_REPOS:
                index = self._load_alarm_repo(repo)
                if package in index:
                    return index[package]
            return None
        raise SyncError(f"Unsupported architecture: {arch}")

    def _remember_published(self, name: str, version: str) -> None:
        known = self.published_versions.get(name)
        if not known or vercmp(version, known) > 0:
            self.published_versions[name] = version

    def load_published_versions(self) -> None:
        if self.published_loaded:
            return
        self.published_loaded = True
        for arch in self.ci_arches:
            for mirror in PUBLISHED_MIRRORS:
                db = self.temp_dir / f"published-{mirror}-{arch}.db.tar.zst"
                url = f"{self.published_base_url}/{mirror}/{arch}/omarchy.db.tar.zst"
                if not self._download(url, db):
                    print_warning(
                        f"Could not read the published {mirror}/{arch} database; "
                        "bumps are not checked against it this run"
                    )
                    continue
                entries = extract_db_entries(db)
                if entries is None:
                    print_warning(
                        f"Unreadable published {mirror}/{arch} database; "
                        "bumps are not checked against it this run"
                    )
                    continue
                if mirror == "edge":
                    self.edge_read.add(arch)
                for name, base, version in entries:
                    if name and version:
                        self._remember_published(name, version)
                    if base and version:
                        self._remember_published(base, version)
                    if mirror == "edge" and version:
                        if name:
                            self.edge_versions[(arch, name)] = version
                        if base:
                            self.edge_versions[(arch, base)] = version

    def published_version(self, package: str) -> str | None:
        self.load_published_versions()
        return self.published_versions.get(package)


def rewrite_pkgrel_text(text: str, next_pkgrel: str) -> str:
    matches = list(PKGREL_LINE_RE.finditer(text))
    if len(matches) != 1:
        raise SyncError(f"Expected exactly one pkgrel assignment (found {len(matches)})")
    m = matches[0]
    return text[: m.start()] + f"pkgrel={next_pkgrel}" + text[m.end() :]


@dataclass(frozen=True)
class PinRule:
    pin_pkgver: str
    pin_full: str
    conflict_pkgver: bool = False
    conflict_full: bool = False
    partial_arch: bool = False
    reason: str = ""


def _build_array_pin_rules(
    current: dict[str, dict[str, str]], missing_arch: str | None
) -> dict[str, dict[str, PinRule]]:
    rules: dict[str, dict[str, PinRule]] = {}
    by_trigger: dict[str, list[str]] = {}

    for arch, triggers in current.items():
        rules[f"depends_{arch}"] = {
            trigger: PinRule(
                pin_pkgver=version_without_pkgrel(version),
                pin_full=version_normalized(version),
            )
            for trigger, version in triggers.items()
        }
        for trigger, version in triggers.items():
            by_trigger.setdefault(trigger, []).append(version)

    shared_rules: dict[str, PinRule] = {}
    for trigger, versions in by_trigger.items():
        pkgvers = [version_without_pkgrel(v) for v in versions]
        fulls = [version_normalized(v) for v in versions]
        conflict_pkgver = len(set(pkgvers)) > 1
        conflict_full = len(set(fulls)) > 1
        if conflict_pkgver or conflict_full:
            reason = "versions differ across architectures"
        elif missing_arch:
            reason = f"supported architecture {missing_arch} is not covered by this run"
        else:
            reason = ""
        shared_rules[trigger] = PinRule(
            pin_pkgver=pkgvers[0],
            pin_full=fulls[0],
            conflict_pkgver=conflict_pkgver,
            conflict_full=conflict_full,
            partial_arch=missing_arch is not None,
            reason=reason,
        )
    rules["depends"] = shared_rules
    return rules


def _rewrite_pin_token(token: str, array_name: str, rules: dict[str, PinRule]) -> str:
    name, sep, ver = token.partition("=")
    if not sep or name not in rules or not ALPM_VER_RE.match(ver):
        return token
    rule = rules[name]
    if "-" in ver:
        if rule.conflict_full or (rule.partial_arch and ver != rule.pin_full):
            raise SyncError(f"Cannot move {array_name} pin for {name} ({rule.reason})")
        return f"{name}={rule.pin_full}"
    if rule.conflict_pkgver or (rule.partial_arch and ver != rule.pin_pkgver):
        raise SyncError(f"Cannot move {array_name} pin for {name} ({rule.reason})")
    return f"{name}={rule.pin_pkgver}"


def _is_delim(line: str, idx: int) -> bool:
    return idx >= len(line) or line[idx] in (" ", "\t", ")")


HEREDOC_PREFIX_RE = re.compile(r"(?:^|[^<])<<-?[ \t]*$")


def _scan_outer_line(line: str, quote: str | None) -> tuple[str, str | None]:
    """Scan a non-depends line, tracking multiline single/double quotes and returning
    the unquoted code portion (preserving quoted heredoc delimiters) before `#`."""
    code: list[str] = []
    keep_quoted = False
    i = 0
    n = len(line)
    while i < n:
        c = line[i]
        if quote == "'":
            if keep_quoted:
                code.append(c)
            if c == "'":
                quote = None
                keep_quoted = False
            i += 1
        elif quote == '"':
            if c == "\\" and i + 1 < n:
                if keep_quoted:
                    code.append(line[i : i + 2])
                i += 2
            elif c == '"':
                if keep_quoted:
                    code.append(c)
                quote = None
                keep_quoted = False
                i += 1
            else:
                if keep_quoted:
                    code.append(c)
                i += 1
        else:
            if c == "\\" and i + 1 < n:
                code.append(line[i : i + 2])
                i += 2
            elif c == "'" or c == '"':
                keep_quoted = bool(HEREDOC_PREFIX_RE.search("".join(code)))
                quote = c
                if keep_quoted:
                    code.append(c)
                i += 1
            elif c == "#" and (i == 0 or line[i - 1] in (" ", "\t", ";", "(")):
                break
            else:
                code.append(c)
                i += 1
    return "".join(code), quote


def rewrite_pins_text(
    text: str,
    current: dict[str, dict[str, str]],
    missing_arch: str | None = None,
) -> str:
    """Move exact trigger pins inside depends / depends_<arch> arrays (=() and +=())."""
    array_rules = _build_array_pin_rules(current, missing_arch)
    out_lines: list[str] = []
    active_array: str | None = None
    outer_quote: str | None = None
    heredoc_queue: list[tuple[str, bool]] = []

    for raw_line in text.splitlines(keepends=True):
        if raw_line.endswith("\r\n"):
            line, eol = raw_line[:-2], "\r\n"
        elif raw_line.endswith("\n"):
            line, eol = raw_line[:-1], "\n"
        else:
            line, eol = raw_line, ""

        if heredoc_queue:
            delim, strip_tabs = heredoc_queue[0]
            check = line.lstrip("\t") if strip_tabs else line
            if check == delim:
                heredoc_queue.pop(0)
            out_lines.append(raw_line)
            continue

        i = 0
        out: list[str] = []

        if active_array is None:
            if outer_quote is not None:
                _, outer_quote = _scan_outer_line(line, outer_quote)
                out_lines.append(raw_line)
                continue
            m = DEPENDS_START_RE.match(line)
            if m and m.group(2) in array_rules:
                active_array = m.group(2)
                out.append(line[: m.end()])
                i = m.end()
            else:
                code_part, outer_quote = _scan_outer_line(line, None)
                for hd in HEREDOC_RE.finditer(code_part):
                    heredoc_queue.append(
                        (hd.group(2).strip("'\"\\"), hd.group(1) == "<<-")
                    )
                out_lines.append(raw_line)
                continue

        rules = array_rules[active_array]
        n = len(line)
        while i < n:
            c = line[i]
            if c in (" ", "\t"):
                out.append(c)
                i += 1
            elif c == "#":
                out.append(line[i:])
                break
            elif c == ")":
                out.append(line[i:])
                active_array = None
                break
            elif c == "'":
                j = line.find("'", i + 1)
                if j == -1:
                    out.append(line[i:])
                    active_array = None
                    outer_quote = "'"
                    break
                if not _is_delim(line, j + 1):
                    out.append(line[i:])
                    active_array = None
                    _, outer_quote = _scan_outer_line(line[i:], None)
                    break
                out.append("'" + _rewrite_pin_token(line[i + 1 : j], active_array, rules) + "'")
                i = j + 1
            elif c == '"':
                j = i + 1
                while j < n:
                    if line[j] == "\\" and j + 1 < n:
                        j += 2
                        continue
                    if line[j] == '"':
                        break
                    j += 1
                if j >= n:
                    out.append(line[i:])
                    active_array = None
                    outer_quote = '"'
                    break
                if not _is_delim(line, j + 1):
                    out.append(line[i:])
                    active_array = None
                    _, outer_quote = _scan_outer_line(line[i:], None)
                    break
                tok = line[i + 1 : j]
                if "$(" in tok or "`" in tok:
                    out.append(line[i:])
                    active_array = None
                    break
                out.append('"' + _rewrite_pin_token(tok, active_array, rules) + '"')
                i = j + 1
            else:
                j = i
                while j < n and line[j] not in (" ", "\t", ")"):
                    j += 1
                tok = line[i:j]
                if tok == "\\" and j == n:
                    out.append(tok)
                    i = j
                elif (
                    "$(" in tok
                    or "`" in tok
                    or "'" in tok
                    or '"' in tok
                    or (j == n and tok.endswith("\\"))
                ):
                    out.append(line[i:])
                    active_array = None
                    break
                else:
                    out.append(_rewrite_pin_token(tok, active_array, rules))
                    i = j

        out_lines.append("".join(out) + eol)

    return "".join(out_lines)


VAR_REF_RE = re.compile(r"\$\{?([A-Za-z_][A-Za-z0-9_]*)")
RANGE_OP_RE = re.compile(r">=|<=|>|<")
LITERAL_PKG_RE = re.compile(r"^[a-z0-9@_+][a-z0-9@._+-]*$")


def _split_bash_array_words(rhs: str) -> list[tuple[str, bool]]:
    """Split a declare -f array RHS `(...)` into (unquoted_text, is_single_quoted) pairs."""
    inner = rhs.strip()
    if inner.startswith("(") and inner.endswith(")"):
        inner = inner[1:-1]
    words: list[tuple[str, bool]] = []
    i = 0
    n = len(inner)
    while i < n:
        while i < n and inner[i] in (" ", "\t", "\n"):
            i += 1
        if i >= n:
            break
        parts: list[str] = []
        only_single = True
        while i < n and inner[i] not in (" ", "\t", "\n"):
            c = inner[i]
            if c == "'":
                j = inner.find("'", i + 1)
                if j == -1:
                    parts.append(inner[i + 1 :])
                    i = n
                else:
                    parts.append(inner[i + 1 : j])
                    i = j + 1
            elif c == '"':
                only_single = False
                i += 1
                while i < n and inner[i] != '"':
                    if inner[i] == "\\" and i + 1 < n:
                        parts.append(inner[i : i + 2])
                        i += 2
                    else:
                        parts.append(inner[i])
                        i += 1
                if i < n:
                    i += 1
            elif c == "\\" and i + 1 < n:
                only_single = False
                parts.append(inner[i : i + 2])
                i += 2
            else:
                only_single = False
                parts.append(c)
                i += 1
        words.append(("".join(parts), only_single))
    return words


def _check_func_depends_rhs(
    fn: str,
    attr: str,
    rhs: str,
    globals_set: set[str],
    locals_set: set[str],
    triggers: set[str],
) -> None:
    """Reject unresolved local/command expansions that could hide a stale exact trigger pin,
    while allowing range constraints like `"$_kernel>=$needs"` and non-trigger pins."""
    for raw, is_single_quoted in _split_bash_array_words(rhs):
        if is_single_quoted:
            continue
        has_cmd = "$(" in raw or "`" in raw
        refs = VAR_REF_RE.findall(raw)
        unresolved = [r for r in refs if r not in globals_set or r in locals_set]
        if not has_cmd and not unresolved:
            continue

        # A range operator (>=, <=, >, <) outside ${...} with a resolved
        # left-hand side can never produce an exact `trigger=version` pin.
        masked = re.sub(r"\$\{[^}]*\}", lambda m: " " * len(m.group(0)), raw)
        range_match = RANGE_OP_RE.search(masked)
        if range_match:
            lhs = raw[: range_match.start()]
            lhs_refs = VAR_REF_RE.findall(lhs)
            if (
                "$(" not in lhs
                and "`" not in lhs
                and all(r in globals_set and r not in locals_set for r in lhs_refs)
            ):
                continue

        # An exact `name=...` for a literal package name outside rebuild_on is
        # not a trigger pin.
        if "=" in raw:
            lhs = raw.split("=", 1)[0]
            if LITERAL_PKG_RE.match(lhs) and lhs not in triggers:
                continue

        if has_cmd:
            raise SyncError(f"Cannot verify command substitution in {attr} inside {fn}")
        raise SyncError(
            f"Cannot verify function-local {unresolved[0]} in {attr} inside {fn}"
        )


def validate_staged_pkgbuild(
    package_dir: Path,
    staged_path: Path,
    next_pkgrel: str,
    current: dict[str, dict[str, str]],
) -> None:
    """Verify valid shell, expected pkgrel readback, and no stale exact trigger pins."""
    staged_path = staged_path.resolve()
    if subprocess.run(
        ["bash", "-n", str(staged_path)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode != 0:
        raise SyncError("Rewritten PKGBUILD is not valid shell")

    script = r"""
source "$1" >/dev/null 2>&1 || exit 1
printf 'PKGREL\t%s\n' "${pkgrel:-}"
compgen -v | while IFS= read -r v; do printf 'GLOBAL\t%s\n' "$v"; done
arch_var="depends_${PIN_ARCH}[@]"
for d in "${depends[@]}" "${!arch_var}"; do
  printf 'DEP\t%s\n' "$d"
done
strip_heredocs() {
  awk '
    BEGIN { hd = ""; strip = 0 }
    hd != "" {
      chk = $0
      if (strip) sub(/^\t+/, "", chk)
      if (chk == hd) { hd = ""; strip = 0 }
      next
    }
    {
      print
      if (match($0, /(^|[^<])<<-?[ \t]*(\\?[A-Za-z_][A-Za-z0-9_]*|\047[^\047]+\047|"[^"]+")/)) {
        t = substr($0, RSTART, RLENGTH)
        sub(/^[^<]/, "", t)
        strip = (substr(t, 1, 3) == "<<-")
        sub(/^<<-?[ \t]*/, "", t)
        gsub(/[\047"\\]/, "", t)
        hd = t
      }
    }
  '
}
collect_fn() {
  local fn="$1" attr="$2" body line decl rhs tmp loc
  declare -F "$fn" >/dev/null 2>&1 || return 0
  body=$(declare -f "$fn" | strip_heredocs)
  if grep -Eq "^[[:space:]]+${attr}(\[|\+?=([^(]|$))" <<<"$body"; then
    printf 'ERR\tCannot verify non-array %s assignment inside %s\n' "$attr" "$fn"
    return 1
  fi
  while IFS= read -r loc; do
    [[ -n "$loc" ]] && printf 'LOCAL\t%s\t%s\n' "$fn" "$loc"
  done < <(
    awk '
      {
        line = $0
        sub(/^[ \t]+/, "", line)
        if (line ~ /^(local|declare|typeset)[ \t]/) {
          sub(/^(local|declare|typeset)[ \t]+/, "", line)
          sub(/;[ \t]*$/, "", line)
          n = split(line, parts, /[ \t]+/)
          for (i = 1; i <= n; i++) {
            tok = parts[i]
            if (tok ~ /^-/) continue
            sub(/=.*/, "", tok)
            if (tok ~ /^[A-Za-z_][A-Za-z0-9_]*$/) print tok
          }
        }
      }
    ' <<<"$body"
  )
  while IFS= read -r line; do
    decl="${line#"${line%%[![:space:]]*}"}"
    decl="${decl%;}"
    rhs="${decl#*=}"
    printf 'FUNC_RHS\t%s\t%s\t%s\n' "$fn" "$attr" "$rhs"
    if [[ "$rhs" != *'$('* && "$rhs" != *'`'* ]]; then
      tmp=()
      eval "tmp=$rhs" 2>/dev/null || true
      for d in "${tmp[@]}"; do
        printf 'DEP\t%s\n' "$d"
      done
    fi
  done < <(grep -E "^[[:space:]]+${attr}\+?=\(" <<<"$body" || true)
}
collect_fn package depends || exit 2
collect_fn package "depends_${PIN_ARCH}" || exit 2
for name in "${pkgname[@]}"; do
  collect_fn "package_$name" depends || exit 2
  collect_fn "package_$name" "depends_${PIN_ARCH}" || exit 2
done
"""

    for arch, triggers in current.items():
        env = os.environ.copy()
        env.pop("OMARCHY_SRC", None)
        env["CARCH"] = arch
        env["PIN_ARCH"] = arch
        proc = subprocess.run(
            ["bash", "-c", script, "_", str(staged_path)],
            cwd=package_dir,
            env=env,
            capture_output=True,
            text=True,
            check=False,
        )
        if proc.returncode != 0:
            for line in proc.stdout.splitlines():
                if line.startswith("ERR\t"):
                    raise SyncError(line.split("\t", 1)[1])
            raise SyncError(f"Could not evaluate rewritten PKGBUILD for {arch}")

        pkgrel_read = ""
        globals_set: set[str] = set()
        locals_by_fn: dict[str, set[str]] = {}
        func_rhs_list: list[tuple[str, str, str]] = []
        deps: list[str] = []

        for line in proc.stdout.splitlines():
            kind, sep, rest = line.partition("\t")
            if not sep:
                continue
            if kind == "PKGREL":
                pkgrel_read = rest
            elif kind == "GLOBAL":
                globals_set.add(rest)
            elif kind == "LOCAL":
                fn, _, var = rest.partition("\t")
                locals_by_fn.setdefault(fn, set()).add(var)
            elif kind == "FUNC_RHS":
                fn, _, tail = rest.partition("\t")
                attr, _, rhs = tail.partition("\t")
                func_rhs_list.append((fn, attr, rhs))
            elif kind == "DEP":
                deps.append(rest)

        if pkgrel_read != next_pkgrel:
            raise SyncError(
                f"Rewritten PKGBUILD reads back pkgrel={pkgrel_read}, not {next_pkgrel}"
            )

        trigger_names = set(triggers.keys())
        for fn, attr, rhs in func_rhs_list:
            _check_func_depends_rhs(
                fn, attr, rhs, globals_set, locals_by_fn.get(fn, set()), trigger_names
            )

        for trigger, version in triggers.items():
            pin_pkgver = version_without_pkgrel(version)
            pin_full = version_normalized(version)
            prefix = f"{trigger}="
            for dep in deps:
                if not dep.startswith(prefix):
                    continue
                eff_ver = dep[len(prefix) :]
                expected = pin_full if "-" in eff_ver else pin_pkgver
                if eff_ver != expected:
                    raise SyncError(
                        f"Effective {arch} dependency pin '{dep}' does not match "
                        f"target '{trigger}={expected}'"
                    )
def normalize_recorded(recorded: object) -> dict[str, dict[str, str]]:
    if not isinstance(recorded, dict) or not recorded:
        return {}
    if all(isinstance(v, str) for v in recorded.values()):
        return {"x86_64": dict(recorded)}
    return {k: dict(v) for k, v in recorded.items() if isinstance(v, dict)}


def build_updated_metadata(
    metadata: dict,
    recorded: dict[str, dict[str, str]],
    current: dict[str, dict[str, str]],
    suffix: str,
) -> dict:
    updated = dict(metadata)
    by_arch = {k: dict(v) for k, v in recorded.items()}
    for arch, triggers in current.items():
        merged = dict(by_arch.get(arch, {}))
        merged.update(triggers)
        by_arch[arch] = merged
    updated["rebuilt_against"] = by_arch
    if suffix:
        pkgrel_obj = dict(updated["pkgrel"]) if isinstance(updated.get("pkgrel"), dict) else {}
        pkgrel_obj["suffix"] = int(suffix)
        updated["pkgrel"] = pkgrel_obj
    return updated


def _write_staged_file(target: Path, content: bytes, mode: int, prefix: str) -> Path:
    fd, tmp_name = tempfile.mkstemp(dir=target.parent, prefix=prefix)
    tmp_path = Path(tmp_name)
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(content)
        os.chmod(tmp_path, mode)
    except BaseException:
        tmp_path.unlink(missing_ok=True)
        raise
    return tmp_path


def apply_package_update(
    package_dir: Path,
    orig_metadata: dict,
    recorded: dict[str, dict[str, str]],
    next_pkgrel: str,
    current: dict[str, dict[str, str]],
    suffix: str,
    *,
    temp_dir: Path,
    dry_run: bool = False,
) -> None:
    """Stage, validate, and transactionally commit PKGBUILD and package.json."""
    pkgbuild = package_dir / "PKGBUILD"
    metadata_path = package_dir / ".omarchy" / "package.json"

    orig_pkgbuild_bytes = pkgbuild.read_bytes()
    orig_pkgbuild_text = orig_pkgbuild_bytes.decode("utf-8")
    orig_pkgbuild_mode = pkgbuild.stat().st_mode & 0o7777
    orig_meta_mode = metadata_path.stat().st_mode & 0o7777

    missing_arch = next(
        (a for a in VALID_ARCHES if a not in current and package_supports_arch(package_dir, a)),
        None,
    )

    new_pkgbuild_text = rewrite_pkgrel_text(orig_pkgbuild_text, next_pkgrel)
    new_pkgbuild_text = rewrite_pins_text(new_pkgbuild_text, current, missing_arch)
    new_pkgbuild_bytes = new_pkgbuild_text.encode("utf-8")

    validate_copy = temp_dir / f"PKGBUILD.{package_dir.name}.check"
    try:
        validate_copy.write_bytes(new_pkgbuild_bytes)
        validate_staged_pkgbuild(package_dir, validate_copy, next_pkgrel, current)
    finally:
        validate_copy.unlink(missing_ok=True)

    new_metadata = build_updated_metadata(orig_metadata, recorded, current, suffix)
    new_metadata_bytes = (
        json.dumps(new_metadata, indent=2, ensure_ascii=False) + "\n"
    ).encode("utf-8")

    if dry_run:
        return

    pkgbuild_scratch: Path | None = None
    metadata_scratch: Path | None = None
    pkgbuild_backup: Path | None = None

    try:
        pkgbuild_scratch = _write_staged_file(
            pkgbuild, new_pkgbuild_bytes, orig_pkgbuild_mode, ".PKGBUILD.sync-rebuilds."
        )
        metadata_scratch = _write_staged_file(
            metadata_path, new_metadata_bytes, orig_meta_mode, ".package.json.sync-rebuilds."
        )
        pkgbuild_backup = _write_staged_file(
            pkgbuild, orig_pkgbuild_bytes, orig_pkgbuild_mode, ".PKGBUILD.sync-rebuilds-backup."
        )

        os.replace(pkgbuild_scratch, pkgbuild)
        os.replace(metadata_scratch, metadata_path)
    except BaseException:
        # Derive exact commit state from the atomic-rename source paths: if
        # PKGBUILD already landed (scratch gone) and metadata has not (scratch
        # still exists), roll back PKGBUILD by rename.
        if (
            pkgbuild_backup is not None
            and pkgbuild_backup.exists()
            and pkgbuild_scratch is not None
            and not pkgbuild_scratch.exists()
            and metadata_scratch is not None
            and metadata_scratch.exists()
        ):
            try:
                os.replace(pkgbuild_backup, pkgbuild)
                pkgbuild_backup = None
            except OSError as rb_exc:
                print_error(
                    f"  Failed to roll back {pkgbuild}: {rb_exc}; "
                    f"backup preserved at {pkgbuild_backup}"
                )
                pkgbuild_backup = None
        raise
    finally:
        for path in (pkgbuild_scratch, metadata_scratch, pkgbuild_backup):
            if path is not None:
                path.unlink(missing_ok=True)


def package_sync_enabled(metadata: dict) -> bool:
    return metadata.get("source") == "aur" and metadata.get("sync", True) is not False


@dataclass
class SyncStats:
    updated: int = 0
    skipped: int = 0
    failed: int = 0


def sync_package(
    package: str,
    pkgbuilds_dir: Path,
    repo_cache: RepoCache,
    stats: SyncStats,
    *,
    specific_mode: bool,
    dry_run: bool,
) -> None:
    package_dir = pkgbuilds_dir / package
    pkgbuild = package_dir / "PKGBUILD"
    metadata_path = package_dir / ".omarchy" / "package.json"

    if not pkgbuild.is_file():
        print_error(f"Package {package} has no PKGBUILD")
        stats.failed += 1
        return

    metadata: dict = {}
    if metadata_path.is_file():
        try:
            loaded = json.loads(metadata_path.read_text(encoding="utf-8"))
            if not isinstance(loaded, dict):
                raise ValueError("metadata is not a JSON object")
            metadata = loaded
        except (OSError, ValueError):
            print_error(f"Unreadable metadata, skipping {package}: {metadata_path}")
            stats.failed += 1
            return

    raw_triggers = metadata.get("rebuild_on")
    if raw_triggers is None or raw_triggers == []:
        if specific_mode:
            print_error(f"Package {package} does not declare rebuild_on")
            stats.failed += 1
        else:
            print_info(f"Skipping {package}: no rebuild triggers")
            stats.skipped += 1
        return
    if not isinstance(raw_triggers, list) or not all(isinstance(t, str) and t for t in raw_triggers):
        print_error(f"Malformed rebuild_on in {metadata_path}; skipping {package}")
        stats.failed += 1
        return
    triggers: list[str] = raw_triggers

    print_info(f"Checking {package} against {' '.join(triggers)}...")

    current: dict[str, dict[str, str]] = {}
    first_fields: RecipeFields | None = None
    for arch in repo_cache.ci_arches:
        fields = read_pkgbuild_fields(package_dir, arch)
        if fields is None or ("any" not in fields.arches and arch not in fields.arches):
            continue
        if first_fields is None:
            first_fields = fields
        arch_current: dict[str, str] = {}
        for trigger in triggers:
            is_carried, version = resolve_carried_trigger(pkgbuilds_dir, arch, trigger)
            if is_carried:
                if not version:
                    print_error(
                        f"  Could not read the {arch} version of {trigger} from its recipe; "
                        f"leaving {package} alone"
                    )
                    stats.failed += 1
                    return
                repo_cache.load_published_versions()
                if arch not in repo_cache.edge_read:
                    print_error(
                        f"  Could not read the published edge/{arch} database for {trigger}; "
                        f"leaving {package} alone"
                    )
                    stats.failed += 1
                    return
                if repo_cache.edge_versions.get((arch, trigger)) != version:
                    print_warning(
                        f"  {trigger} {version} is not published on edge/{arch} yet; "
                        f"leaving {package} alone until it is"
                    )
                    stats.skipped += 1
                    return
            else:
                try:
                    version = repo_cache.repo_version(arch, trigger)
                except SyncError as exc:
                    print_error(f"  {exc}; leaving {package} alone")
                    stats.failed += 1
                    return
            if not version:
                print_error(
                    f"  {trigger} is in no {arch} repository; leaving {package} alone"
                )
                stats.failed += 1
                return
            arch_current[trigger] = version
        current[arch] = arch_current

    if not current or first_fields is None:
        print_info("  Skipping: not built for any published architecture")
        stats.skipped += 1
        return

    recorded = normalize_recorded(metadata.get("rebuilt_against"))
    moved_parts = [
        f"{arch}/{trigger} {recorded.get(arch, {}).get(trigger) or 'unrecorded'} -> {version}"
        for arch, arch_triggers in current.items()
        for trigger, version in arch_triggers.items()
        if recorded.get(arch, {}).get(trigger) != version
    ]
    if not moved_parts:
        print_info("  Already rebuilt against every published architecture")
        stats.skipped += 1
        return
    moved = ", ".join(moved_parts)

    pkgrel, pkgver, epoch = first_fields.pkgrel, first_fields.pkgver, first_fields.epoch
    suffix = ""
    if package_sync_enabled(metadata):
        if "." in pkgrel:
            next_pkgrel = bump_pkgrel(pkgrel)
            suffix = next_pkgrel.rsplit(".", 1)[1] if next_pkgrel else ""
        else:
            next_pkgrel = f"{pkgrel}.1" if PKGREL_RE.match(pkgrel) else None
            suffix = "1"
    else:
        next_pkgrel = bump_pkgrel(pkgrel)

    if not next_pkgrel:
        print_error(f"  Cannot bump pkgrel={pkgrel} for {package}; bump it by hand")
        stats.failed += 1
        return

    epoch_prefix = f"{epoch}:" if epoch and epoch != "0" else ""
    old_version = f"{epoch_prefix}{pkgver}-{pkgrel}"
    new_version = f"{epoch_prefix}{pkgver}-{next_pkgrel}"

    if vercmp(new_version, old_version) <= 0:
        print_error(f"  pkgrel {pkgrel} -> {next_pkgrel} would not be an upgrade for {package}")
        stats.failed += 1
        return

    floor = repo_cache.published_version(package)
    if floor and version_pkgver(floor) == pkgver and vercmp(new_version, floor) <= 0:
        print_error(
            f"  {new_version} would not be an upgrade over the published {floor}; "
            f"leaving {package} alone"
        )
        stats.failed += 1
        return

    try:
        apply_package_update(
            package_dir,
            metadata,
            recorded,
            next_pkgrel,
            current,
            suffix,
            temp_dir=repo_cache.temp_dir,
            dry_run=dry_run,
        )
    except (SyncError, OSError, ValueError) as exc:
        print_error(f"  Failed to update {package}: {exc}")
        stats.failed += 1
        return

    verb = "Would bump" if dry_run else "pkgrel"
    print_success(f"  {moved}; {verb} {pkgrel} -> {next_pkgrel}")
    stats.updated += 1


def discover_packages(pkgbuilds_dir: Path, stats: SyncStats) -> list[str]:
    if not pkgbuilds_dir.is_dir():
        return []
    selected: list[str] = []
    for entry in sorted(pkgbuilds_dir.iterdir()):
        if not entry.is_dir():
            continue
        metadata_path = entry / ".omarchy" / "package.json"
        if not ((entry / "PKGBUILD").is_file() and metadata_path.is_file()):
            continue
        try:
            data = json.loads(metadata_path.read_text(encoding="utf-8"))
            if not isinstance(data, dict):
                raise ValueError("metadata is not a JSON object")
        except (OSError, ValueError):
            print_error(f"Unreadable metadata, skipping {entry.name}: {metadata_path}")
            stats.failed += 1
            continue
        if "rebuild_on" in data and data["rebuild_on"] not in (None, []):
            selected.append(entry.name)
    return selected


def run_sync(packages: list[str], *, dry_run: bool = False) -> int:
    pkgbuilds_dir = get_pkgbuilds_dir()
    ci_arches = get_ci_arches()
    stats = SyncStats()

    with tempfile.TemporaryDirectory(prefix="sync-rebuilds-") as tmp:
        repo_cache = RepoCache(temp_dir=Path(tmp), ci_arches=ci_arches)
        specific_mode = len(packages) > 0
        targets = packages if specific_mode else discover_packages(pkgbuilds_dir, stats)
        for package in targets:
            sync_package(
                package,
                pkgbuilds_dir,
                repo_cache,
                stats,
                specific_mode=specific_mode,
                dry_run=dry_run,
            )

    print("")
    if stats.failed > 0:
        print_error("Rebuild trigger sync completed with failures")
    else:
        print_success("Rebuild trigger sync complete!")
    print(f"  Target: {pkgbuilds_dir}")
    print(f"  Updated: {stats.updated}")
    print(f"  Skipped: {stats.skipped}")
    print(f"  Failed: {stats.failed}")
    return 0 if stats.failed == 0 else 1


def run_self_test() -> int:
    test_script = ROOT / "tests" / "sync-rebuilds.py"
    if not test_script.is_file():
        print_error(f"Self-test suite not found: {test_script}")
        return 1
    return subprocess.run([sys.executable, str(test_script)], check=False).returncode


def check_required_tools() -> None:
    for tool in ("pacman", "vercmp", "curl", "tar"):
        if shutil.which(tool) is None:
            raise SyncError(f"{tool} not found: rebuild trigger sync cannot run")


class _SyncParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        print_error(message)
        sys.exit(1)


def build_parser() -> argparse.ArgumentParser:
    parser = _SyncParser(
        prog="sync-rebuilds",
        allow_abbrev=False,
        description=(
            "Bump pkgrel for packages that must be rebuilt when a dependency "
            "changes underneath them."
        ),
    )
    parser.add_argument(
        "packages",
        nargs="*",
        metavar="PACKAGE",
        help="One or more package names to update (default: all packages declaring rebuild_on)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Validate and print planned bumps without modifying any files",
    )
    parser.add_argument(
        "--self-test",
        action="store_true",
        help="Run the regression test suite and exit",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    def _handle_sigterm(_signum: int, _frame: object) -> None:
        raise SystemExit(143)

    signal.signal(signal.SIGTERM, _handle_sigterm)

    args = build_parser().parse_args(argv)
    if args.self_test:
        return run_self_test()

    try:
        check_required_tools()
        print_header("Rebuild Trigger Sync")
        return run_sync(args.packages, dry_run=args.dry_run)
    except SyncError as exc:
        print_error(str(exc))
        return 1


if __name__ == "__main__":
    sys.exit(main())
