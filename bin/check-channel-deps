#!/bin/bash
# Check that a promotion leaves every dependency in the destination channel
# resolving, for one architecture, and say which pkgbase to hold back when it
# does not.
#
#   check-channel-deps --channel <rc|stable> --arch <arch> \
#     --source <db|dir> --before <db|dir> --after <db|dir> \
#     [--holds FILE] [--record FILE]
#
# The source channel, and the destination before the promotion and as it
# would leave it, come as package databases (omarchy.db.tar.zst, or the
# directory it unpacks to).
#
# A dependency counts when its name is one this repository serves: a package
# or a provides in any of the three. Every other name comes from the Arch
# base, which this check does not see. A counted dependency resolves when a
# package in the destination provides it, version included, as pacman
# decides.
#
# A problem is a dependency that would not resolve after the promotion and
# did resolve before it, or was not there before. Each one has a pkgbase
# whose move causes it: the package's own, when its new version needs what
# the destination would not have, or the provider's, when its new version no
# longer satisfies a package that stays. --holds writes one
# "<pkgbase>\t<problem>" line per problem, for bin/promote-channel to take
# those pkgbases out of its plan. A dependency that was already unresolved
# before is reported but is not a problem, so one old break does not hold
# anything back.
#
# Exit status: 0 when nothing is a problem, 1 when something is, 2 on a
# usage error. --record appends one JSON line:
# {"type":"deps", arch, channel, result: "pass"|"refused",
#  problems: [{package, dependency, problem, hold}], existing: [...the same]}.
set -euo pipefail
BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
source "$BUILD_ROOT/helpers/message-helpers.sh"

RECORD=/dev/null HOLDS=/dev/null
SOURCE="" BEFORE="" AFTER=""
while [[ $# -gt 0 ]]; do
  case $1 in
  --channel) CHANNEL=$2; shift 2 ;;
  --arch) ARCH=$2; shift 2 ;;
  --source) SOURCE=$2; shift 2 ;;
  --before) BEFORE=$2; shift 2 ;;
  --after) AFTER=$2; shift 2 ;;
  --holds) HOLDS=$2; shift 2 ;;
  --record) RECORD=$2; shift 2 ;;
  -h|--help) sed -n '2,33p' "$0"; exit 0 ;;
  *) print_error "Unknown argument: $1"; exit 2 ;;
  esac
done
usage() { print_error "$1"; exit 2; }
[[ -n ${CHANNEL:-} && -n ${ARCH:-} ]] || usage "--channel and --arch are required"
[[ -n $SOURCE && -n $AFTER ]] || usage "--source and --after are required"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

unpack() { # unpack <db|dir|""> <dir>: a database's entries as <dir>/<name-version>/desc
  mkdir -p "$2"
  if [[ -d $1 ]]; then
    cp -R "$1/." "$2/"
  elif [[ -f $1 ]]; then
    bsdtar -xf "$1" -C "$2" --include '*/desc'
  elif [[ -n $1 ]]; then
    usage "No database at $1"
  fi
}
# One line per package: name|version|base|depends|provides, the lists
# space-separated.
entries() { # entries <dir>
  find "$1" -name desc -print0 | xargs -0r awk '
    function flush() { if (name != "") print name "|" ver "|" base "|" deps "|" provs; name = ver = base = deps = provs = ""; section = "" }
    FNR == 1 { flush() }
    /^%[A-Z0-9]+%$/ { section = $0; next }
    /^$/ { section = ""; next }
    section == "%NAME%" { name = $0 }
    section == "%VERSION%" { ver = $0 }
    section == "%BASE%" { base = $0 }
    section == "%DEPENDS%" { deps = deps (deps == "" ? "" : " ") $0 }
    section == "%PROVIDES%" { provs = provs (provs == "" ? "" : " ") $0 }
    END { flush() }' | awk -F'|' '$3 == "" { $3 = $1 } 1' OFS='|' | sort
}
for view in source before after; do
  dir=${view^^}
  unpack "${!dir}" "$WORK/$view"
  entries "$WORK/$view" > "$WORK/$view.tsv"
done

# Who in a view provides what: "<name>\t<version or empty>" per provider.
declare -A SERVED=() SOURCE_PROV=() BEFORE_PROV=() AFTER_PROV=()
index() { # index <tsv> <array name>
  local -n idx=$2
  local name ver base deps provs p
  while IFS='|' read -r name ver base deps provs; do
    idx[$name]+="$name"$'\t'"$ver"$'\n'
    SERVED[$name]=1
    for p in $provs; do
      if [[ $p == *=* ]]; then idx[${p%%=*}]+="$name"$'\t'"${p#*=}"$'\n'; SERVED[${p%%=*}]=1
      else idx[$p]+="$name"$'\t'$'\n'; SERVED[$p]=1
      fi
    done
  done < "$1"
}
index "$WORK/source.tsv" SOURCE_PROV
index "$WORK/before.tsv" BEFORE_PROV
index "$WORK/after.tsv" AFTER_PROV

# What the promotion moves: a package whose version after is not the one
# before. Pkgbases come from the view the package is in.
declare -A B_VER=() B_BASE=() A_BASE=() MOVED=()
while IFS='|' read -r name ver base _; do B_VER[$name]=$ver B_BASE[$name]=$base; done < "$WORK/before.tsv"
while IFS='|' read -r name ver base _; do
  A_BASE[$name]=$base
  [[ ${B_VER[$name]:-} == "$ver" ]] || MOVED[$name]=1
done < "$WORK/after.tsv"

split_dep() { # split_dep <dep>: prints "name op version" (op and version may be empty)
  if [[ $1 =~ ^([^<>=]+)(>=|<=|=|<|>)(.+)$ ]]; then
    echo "${BASH_REMATCH[1]} ${BASH_REMATCH[2]} ${BASH_REMATCH[3]}"
  else
    echo "$1"
  fi
}
satisfies() { # satisfies <provided version or ""> <op> <version>: as pacman decides
  local have=$1 op=$2 want=$3 c
  [[ -z $op ]] && return 0
  [[ -n $have ]] || return 1
  c=$(vercmp "$have" "$want")
  case $op in
  '>=') (( c >= 0 )) ;; '<=') (( c <= 0 )) ;; '=') (( c == 0 )) ;; '>') (( c > 0 )) ;; '<') (( c < 0 )) ;;
  esac
}
resolves() { # resolves <providers> <op> <version>
  local p pver
  while IFS=$'\t' read -r p pver; do
    [[ -n $p ]] || continue
    satisfies "$pver" "$2" "$3" && return 0
  done <<<"$1"
  return 1
}

# unresolved <view>: "<package>\t<dependency>" for every counted dependency
# the view does not satisfy.
unresolved() {
  local -n prov=${1^^}_PROV
  local name ver base deps _ dep dname op want
  while IFS='|' read -r name ver base deps _; do
    for dep in $deps; do
      read -r dname op want <<<"$(split_dep "$dep")"
      [[ -n ${SERVED[$dname]:-} ]] || continue
      resolves "${prov[$dname]:-}" "${op:-}" "${want:-}" && continue
      printf '%s\t%s\n' "$name" "$dep"
    done
  done < "$WORK/$1.tsv"
}
unresolved before | sort -u > "$WORK/before.broken"
unresolved after | sort -u > "$WORK/after.broken"
comm -23 "$WORK/after.broken" "$WORK/before.broken" > "$WORK/new.broken"
comm -12 "$WORK/after.broken" "$WORK/before.broken" > "$WORK/old.broken"

# Say what is missing and which package in the source channel would fix it.
explain() { # explain <package> <dependency>
  local dname op want offered fix="" p pver
  read -r dname op want <<<"$(split_dep "$2")"
  offered=$(awk -F'\t' -v d="$dname" 'NF && $1 != "" {
    printf "%s%s", (n++ ? ", " : ""), ($1 == d ? $1 " " $2 : d ($2 == "" ? "" : "=" $2) " (from " $1 ")") }' <<<"${AFTER_PROV[$dname]:-}")
  while IFS=$'\t' read -r p pver; do
    [[ -n $p ]] || continue
    satisfies "$pver" "${op:-}" "${want:-}" && { fix=$p; break; }
  done <<<"${SOURCE_PROV[$dname]:-}"
  if [[ -n $offered ]]; then
    printf '%s needs %s; %s/%s would offer only %s' "$1" "$2" "$CHANNEL" "$ARCH" "$offered"
  else
    printf '%s needs %s; %s/%s would not have %s' "$1" "$2" "$CHANNEL" "$ARCH" "$dname"
  fi
  [[ -n $fix && -z ${MOVED[$fix]:-} ]] && printf ' (promote %s with it)' "$fix"
  return 0
}
# The pkgbases whose move causes a problem, one per line: the package's own
# when it moves, else every provider of the dependency that moves.
culprits() { # culprits <package> <dependency>
  local dname p
  if [[ -n ${MOVED[$1]:-} ]]; then echo "${A_BASE[$1]}"; return; fi
  read -r dname _ <<<"$(split_dep "$2")"
  while IFS=$'\t' read -r p _; do
    [[ -n $p && -n ${MOVED[$p]:-} ]] && echo "${A_BASE[$p]}"
  done <<<"${AFTER_PROV[$dname]:-}"
  # A provider that moved and stopped providing the name.
  while IFS=$'\t' read -r p _; do
    [[ -n $p && -n ${A_BASE[$p]:-} && -n ${MOVED[$p]:-} ]] && echo "${A_BASE[$p]}"
  done <<<"${BEFORE_PROV[$dname]:-}"
  return 0
}
: > "$WORK/new.txt"
while IFS=$'\t' read -r name dep; do
  text=$(explain "$name" "$dep")
  bases=$(culprits "$name" "$dep" | sort -u | paste -sd' ' -)
  printf '%s\t%s\t%s\t%s\n' "$name" "$dep" "$text" "$bases" >> "$WORK/new.txt"
done < "$WORK/new.broken"
: > "$WORK/old.txt"
while IFS=$'\t' read -r name dep; do
  printf '%s\t%s\t%s\t\n' "$name" "$dep" "$(explain "$name" "$dep")" >> "$WORK/old.txt"
done < "$WORK/old.broken"

finish() { # finish <result>
  jq -nc --arg arch "$ARCH" --arg channel "$CHANNEL" --arg result "$1" \
    --rawfile new "$WORK/new.txt" --rawfile old "$WORK/old.txt" '
    def rows: split("\n") | map(select(length > 0) | split("\t") | {package: .[0], dependency: .[1], problem: .[2], hold: (.[3] // "" | split(" ") | map(select(length > 0)))});
    {type:"deps", arch:$arch, channel:$channel, result:$result, problems: ($new | rows), existing: ($old | rows | map(del(.hold)))}' >> "$RECORD"
}

if [[ -s $WORK/old.txt ]]; then
  print_warning "Already unresolved in $CHANNEL/$ARCH before this promotion, so not held against it:"
  cut -f3 "$WORK/old.txt" | while IFS= read -r text; do print_step "$text"; done
fi
: > "$HOLDS"
if [[ -s $WORK/new.txt ]]; then
  print_warning "This promotion would leave dependencies in $CHANNEL/$ARCH unresolved:"
  while IFS=$'\t' read -r _ _ text bases; do
    print_step "$text${bases:+ (moving $bases)}"
    for b in $bases; do printf '%s\t%s\n' "$b" "$text" >> "$HOLDS"; done
  done < "$WORK/new.txt"
  finish refused
  exit 1
fi
print_success "Dependencies: everything $CHANNEL/$ARCH serves still resolves"
finish pass
