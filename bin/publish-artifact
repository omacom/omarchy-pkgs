#!/bin/bash
# Publish built packages into one channel of the remote repository,
# incrementally and immutably.
#
#   publish-artifact --mirror <edge|rc|stable> --arch <arch> [--init] <pkg files...>
#
# What it does, in order:
#   1. pull the channel's current database from the remote and drop every
#      package the channel already serves at that version or newer: a channel
#      only ever moves forward
#   2. refuse if any remaining filename already exists on the remote with
#      different bytes
#   3. sign each package (or verify and reuse an existing remote .sig)
#   4. repo-add the packages into the pulled database (replaces the entry
#      for that name; nothing else in the channel is touched)
#   5. upload packages, then signatures, then the database last
#
# Never overwrites: uploads use --ignore-existing for packages and the
# pre-check in step 2 makes a same-name collision a hard failure rather than
# a silent skip. The database is the only object rewritten, and it is
# uploaded only after every file it references is present.
#
# Pass --init when bootstrapping a brand-new channel that has no database yet.
# Without --init, a missing database or rclone listing error fails closed.
#
# The remote is an rclone remote (REMOTE, default the production one);
# OMARCHY_PUBLISH_PREFIX can point a proof run at a scratch prefix.
set -euo pipefail
BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
source "$BUILD_ROOT/helpers/message-helpers.sh"
source "$BUILD_ROOT/helpers/paths.sh"

REMOTE=${REMOTE:-pkgs.omarchy.org:omarchy-pkgs}
PREFIX=${OMARCHY_PUBLISH_PREFIX:-}
INIT=false
FILES=()
while [[ $# -gt 0 ]]; do
  case $1 in
  --mirror) MIRROR=$2; require_valid_mirror "$MIRROR"; shift 2 ;;
  --arch) ARCH=$2; require_valid_arch "$ARCH"; shift 2 ;;
  --remote) REMOTE=$2; shift 2 ;;
  --init) INIT=true; shift ;;
  -h|--help) sed -n '2,27p' "$0"; exit 0 ;;
  -*) print_error "Unknown option: $1"; exit 1 ;;
  *) FILES+=("$1"); shift ;;
  esac
done
(( ${#FILES[@]} )) || { print_error "No package files given"; exit 1; }
: "${GPG_PRIVATE_KEY:?}"; GPG_PASSPHRASE=${GPG_PASSPHRASE-}

DEST="$REMOTE/${PREFIX:+$PREFIX/}$MIRROR/$ARCH"
WORK=$(mktemp -d)
cleanup() {
  local rc=$?
  trap '' INT TERM HUP
  if [[ -d $WORK/gnupg ]]; then
    GNUPGHOME="$WORK/gnupg" timeout -k 1 5 gpgconf --kill all >/dev/null 2>&1 || true
    GNUPGHOME="$WORK/gnupg" timeout -k 1 5 gpgconf --remove-socketdir >/dev/null 2>&1 || true
  fi
  if ! rm -rf "$WORK"; then
    print_error "Failed to remove temporary directory $WORK"
    (( rc == 0 )) && rc=1
  fi
  exit "$rc"
}
trap cleanup EXIT
print_header "Publish to $DEST"

# --- 0. sanity: every file is a package, named as makepkg names it ---------
declare -A PKG_NAME=() PKG_VER=()
for f in "${FILES[@]}"; do
  [[ -f "$f" && "$f" == *.pkg.tar.* && "$f" != *.sig ]] || { print_error "Not a package file: $f"; exit 1; }
  pkginfo=$(bsdtar -xOf "$f" .PKGINFO)
  meta=$(awk -F' = ' '
    $1=="pkgname"{n++; name=$2}
    $1=="pkgver"{v++; ver=$2}
    $1=="arch"{a++; pkgarch=$2}
    END{if (n!=1 || v!=1 || a!=1) exit 1; printf "%s\t%s\t%s\n", name, ver, pkgarch}' <<<"$pkginfo") || {
      print_error "Malformed .PKGINFO in $(basename "$f")"; exit 1; }
  IFS=$'\t' read -r name ver pkgarch <<<"$meta"
  [[ "$(basename "$f")" == "$name-$ver-$pkgarch.pkg.tar."* ]] || {
    print_error "Filename does not match PKGINFO ($name-$ver-$pkgarch): $(basename "$f")"; exit 1; }
  [[ "$pkgarch" == any || "$pkgarch" == "$ARCH" ]] || { print_error "$f is $pkgarch, publishing to $ARCH"; exit 1; }
  PKG_NAME[$f]=$name
  PKG_VER[$f]=$ver
done

# --- 1. pull the current database -----------------------------------------
mkdir -p "$WORK/repo"
lsf_rc=0
listing=$(rclone lsf "$DEST/" --s3-no-head 2>"$WORK/lsf.err") || lsf_rc=$?
if (( lsf_rc != 0 )); then
  # Local paths return exit 3 (directory not found) before first write;
  # S3/R2 remotes return exit 0 for an empty prefix and exit 3 for NoSuchBucket.
  if [[ $INIT == true && $lsf_rc -eq 3 && $DEST != :* && ! $DEST =~ ^[^/]+: ]]; then
    listing=""
  else
    cat "$WORK/lsf.err" >&2
    print_error "Failed to list $DEST (rclone exited $lsf_rc)"
    exit 1
  fi
fi
if grep -qxF 'omarchy.db.tar.zst' <<<"$listing"; then
  rclone copy "$DEST" "$WORK/repo" --s3-no-head --filter '+ /omarchy.db.tar.zst' --filter '+ /omarchy.files.tar.zst' --filter '- *'
  [[ -f "$WORK/repo/omarchy.db.tar.zst" ]] || { print_error "Failed to pull omarchy.db.tar.zst from $DEST"; exit 1; }
  [[ -f "$WORK/repo/omarchy.files.tar.zst" ]] || { print_error "Failed to pull omarchy.files.tar.zst from $DEST"; exit 1; }
  db_list=$(tar -tf "$WORK/repo/omarchy.db.tar.zst")
  files_list=$(tar -tf "$WORK/repo/omarchy.files.tar.zst")
  db_entries=$(grep -c '/$' <<<"$db_list" || true)
  print_info "Pulled current database ($db_entries entries)"
elif [[ $INIT == true ]]; then
  if grep -qE '^omarchy\.(db|files)(\.|$)' <<<"$listing"; then
    print_error "Refusing --init at $DEST: partial database artifacts exist without omarchy.db.tar.zst"
    exit 1
  fi
  print_warning "No database at $DEST — creating a new one"
else
  print_error "No database at $DEST; pass --init to initialize a new channel"
  exit 1
fi

# A channel only moves forward. Whatever it already serves at this version or
# newer is left alone: a stale artifact (built before the channel moved on), a
# re-run of a slot that already landed, an RC carried into an edge that is
# ahead of it.
if [[ -f "$WORK/repo/omarchy.db.tar.zst" ]] && (( db_entries > 0 )); then
  served=$(tar -xO --zstd -f "$WORK/repo/omarchy.db.tar.zst" --wildcards '*/desc' 2>/dev/null | awk '
    $0 == "%NAME%"    { getline; name = $0; next }
    $0 == "%VERSION%" { getline; print name, $0 }')
  keep=()
  for f in "${FILES[@]}"; do
    name=${PKG_NAME[$f]}
    ver=${PKG_VER[$f]}
    have=$(awk -v n="$name" '$1 == n {print $2; exit}' <<<"$served")
    if [[ -n "$have" ]] && (( $(vercmp "$ver" "$have") <= 0 )); then
      print_info "$MIRROR already serves $name $have, skipping $(basename "$f")"
    else
      keep+=("$f")
    fi
  done
  if (( ${#keep[@]} == 0 )); then
    print_success "Nothing newer than what $DEST serves; nothing published"
    exit 0
  fi
  FILES=("${keep[@]}")
fi

# --- 2. same-name collisions ----------------------------------------------
# A filename must mean one set of bytes across every channel. What reaches
# here is newer than anything the channel serves, so a file it already holds
# is one whose database entry never landed or was lost (a run that failed
# after uploading, a concurrent publish). The same bytes are fine: the upload
# is skipped and only the database entry is added. Different bytes under a
# name the channel already has is the one thing this must never do.
for f in "${FILES[@]}"; do
  b=$(basename "$f")
  grep -qxF "$b" <<<"$listing" || continue
  remote_sum=$(rclone hashsum md5 "$DEST/$b" --s3-no-head 2>/dev/null | awk '{print $1}')
  if [[ ! $remote_sum =~ ^[0-9a-fA-F]{32}$ ]]; then
    remote_sum=$(rclone cat "$DEST/$b" --s3-no-head | md5sum | awk '{print $1}')
  fi
  local_sum=$(md5sum "$f" | awk '{print $1}')
  if [[ -n "$remote_sum" && "$remote_sum" == "$local_sum" ]]; then
    print_info "Already published with identical bytes, adding to the database only: $b"
  else
    print_error "Already published with DIFFERENT bytes, refusing to overwrite: $b"
    echo "  Bump pkgrel; published filenames are immutable."
    exit 1
  fi
done

# --- 3. sign ---------------------------------------------------------------
export GNUPGHOME="$WORK/gnupg"; mkdir -m 700 "$GNUPGHOME"
echo "$GPG_PRIVATE_KEY" | gpg --batch --quiet --import
KEY_ID=$(gpg --list-secret-keys --with-colons | awk -F: '$1=="sec"{print $5; exit}')
[[ -n "$KEY_ID" ]] || { print_error "No secret key imported"; exit 1; }
for f in "${FILES[@]}"; do
  b=$(basename "$f")
  cp "$f" "$WORK/repo/$b"
  if grep -qxF "$b.sig" <<<"$listing"; then
    rclone copyto "$DEST/$b.sig" "$WORK/repo/$b.sig" --s3-no-head
    gpg --batch --quiet --verify "$WORK/repo/$b.sig" "$WORK/repo/$b" || {
      print_error "Existing remote signature $b.sig does not verify against $b"
      exit 1
    }
    print_step "reused existing signature $b.sig"
  else
    gpg --batch --yes --pinentry-mode loopback --passphrase "$GPG_PASSPHRASE" \
      --detach-sign --no-armor --local-user "$KEY_ID" "$WORK/repo/$b"
    print_step "signed $b"
  fi
done

# --- 4. repo-add (replaces the entry for each pkgname) ---------------------
# If an earlier run uploaded omarchy.files before failing to upload omarchy.db.tar.zst,
# strip any stale omarchy.files entry for an incoming pkgname so repo-add does not nest it.
if [[ -f "$WORK/repo/omarchy.files.tar.zst" ]]; then
  stale_excludes=()
  while IFS= read -r dir; do
    [[ -n "$dir" ]] || continue
    grep -qxF "$dir" <<<"$db_list" && continue
    d=${dir%/}
    for f in "${FILES[@]}"; do
      if [[ "${d%-*-*}" == "${PKG_NAME[$f]}" ]]; then
        stale_excludes+=(--exclude "$d" --exclude "$d/*")
        break
      fi
    done
  done < <(grep '/$' <<<"$files_list" || true)
  if (( ${#stale_excludes[@]} )); then
    bsdtar --zstd -cf "$WORK/repo/omarchy.files.tar.zst.clean" "${stale_excludes[@]}" "@$WORK/repo/omarchy.files.tar.zst"
    mv "$WORK/repo/omarchy.files.tar.zst.clean" "$WORK/repo/omarchy.files.tar.zst"
  fi
fi
( cd "$WORK/repo" && repo-add --quiet --include-sigs omarchy.db.tar.zst "${FILES[@]/#*\//}" )
db_out=$(tar -tf "$WORK/repo/omarchy.db.tar.zst")
files_out=$(tar -tf "$WORK/repo/omarchy.files.tar.zst")
cmp -s <( (grep '/$' <<<"$db_out" || true) | sort ) \
       <( (grep '/$' <<<"$files_out" || true) | sort ) || {
  print_error "Refusing upload: omarchy.db.tar.zst and omarchy.files.tar.zst entries diverge"
  exit 1
}
print_info "Database now has $(grep -c '/$' <<<"$db_out" || true) entries"

# --- 5. upload: packages, signatures, database last -----------------------
rclone copy "$WORK/repo" "$DEST" --s3-no-head --ignore-existing --filter '- *.sig' --filter '+ *.pkg.tar.*' --filter '- *'
rclone copy "$WORK/repo" "$DEST" --s3-no-head --ignore-existing --filter '+ *.pkg.tar.*.sig' --filter '- *'
# Re-verify every referenced file and its signature (size and MD5) before metadata goes up.
: > "$WORK/expected.list"
for f in "${FILES[@]}"; do
  b=$(basename "$f")
  printf '%s\n%s.sig\n' "$b" "$b" >> "$WORK/expected.list"
done
listing=$(rclone lsf --format shp --hash md5 --files-from-raw "$WORK/expected.list" "$DEST/" --s3-no-head)
declare -A REMOTE_SIZE=() REMOTE_MD5=()
while IFS=';' read -r remote_size remote_md5 remote_path; do
  [[ -n "$remote_path" ]] || continue
  REMOTE_SIZE[$remote_path]=$remote_size
  REMOTE_MD5[$remote_path]=$remote_md5
done <<<"$listing"
while IFS= read -r obj; do
  [[ -v REMOTE_SIZE[$obj] ]] || { print_error "Upload incomplete: $obj"; exit 1; }
  [[ "${REMOTE_SIZE[$obj]}" == "$(stat -c%s "$WORK/repo/$obj")" ]] || { print_error "Remote size mismatch for $obj"; exit 1; }
  remote_md5=${REMOTE_MD5[$obj]}
  local_md5=$(md5sum "$WORK/repo/$obj" | awk '{print $1}')
  if [[ -z "$remote_md5" ]]; then
    remote_md5=$(rclone cat "$DEST/$obj" --s3-no-head | md5sum | awk '{print $1}')
  fi
  [[ "$remote_md5" == "$local_md5" ]] || { print_error "Remote checksum mismatch for $obj"; exit 1; }
done < "$WORK/expected.list"
# Upload exact metadata keys in order, with omarchy.db.tar.zst last as the retry
# commit point; never uploads repo-add .old backups.
rclone copyto "$WORK/repo/omarchy.files.tar.zst" "$DEST/omarchy.files.tar.zst" --s3-no-head --checksum
rclone copyto "$WORK/repo/omarchy.files.tar.zst" "$DEST/omarchy.files" --s3-no-head --checksum
rclone copyto "$WORK/repo/omarchy.db.tar.zst" "$DEST/omarchy.db" --s3-no-head --checksum
rclone copyto "$WORK/repo/omarchy.db.tar.zst" "$DEST/omarchy.db.tar.zst" --s3-no-head --checksum
print_success "Published ${#FILES[@]} package(s) to $DEST"
