#!/bin/bash
# For one build-matrix entry, say which of its slots (channel/architecture
# databases) already index master's version of the package.
#
#   publish-slots <package> <channels> <publish_arches>
#
# channels and publish_arches are the matrix entry's values, separated by
# spaces or commas. Output, one line per slot:
#   edge/x86_64 current
#   edge/aarch64 missing
#
# publish.yml asks this before deciding a package is already published. An
# entry publishes into several databases: every architecture for arch=any,
# every channel for the fast ring. Asking only the one the package was built
# for calls it done while the others never received it. Each slot is planned
# by bin/build, so "current" means what it means everywhere else.
#
# Exits non-zero when a slot could not be planned: unknown must never read
# as current.
set -euo pipefail
BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
source "$BUILD_ROOT/helpers/paths.sh"

(( $# == 3 )) || { sed -n '2,10p' "$0" >&2; exit 1; }
package=$1
for mirror in ${2//,/ }; do
  require_valid_mirror "$mirror"
  for arch in ${3//,/ }; do
    require_valid_arch "$arch"
    plan=$("$BUILD_ROOT/bin/build" --dry-run --mirror "$mirror" --arch "$arch" --package "$package" 2>&1 | grep -E '^==> Plan complete' || true)
    [[ -n "$plan" ]] || { echo "publish-slots: no build plan for $package in $mirror/$arch" >&2; exit 1; }
    # "Packages that would build:" followed by nothing means none.
    if [[ -z "$(sed -E 's/.*would build: *//' <<<"$plan" | tr -d '[:space:]')" ]]; then
      echo "$mirror/$arch current"
    else
      echo "$mirror/$arch missing"
    fi
  done
done
