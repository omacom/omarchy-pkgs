#!/bin/bash
# Validate unsigned T2 outputs in a fresh local container. No host forwarding.
set -euo pipefail
BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
source "$BUILD_ROOT/helpers/message-helpers.sh"
source "$BUILD_ROOT/helpers/docker-helpers.sh"
source "$BUILD_ROOT/helpers/paths.sh"
if [[ $# -ne 0 ]]; then
  echo "Usage: $0 (reads build-output/edge/x86_64; builds must finish first)" >&2
  exit 1
fi
check_engine
exec "$CONTAINER_ENGINE" run "${CONTAINER_RUN_ARGS[@]}" --rm --platform=linux/amd64 \
  -v "$BUILD_ROOT/build-output/edge/x86_64:/packages:ro" \
  -v "$BUILD_ROOT/build:/build:ro" \
  -v "$BUILD_ROOT/pkgbuilds/apple-bcm-firmware/intel-firmware.sha256:/t2-firmware-manifest:ro" \
  omarchy-pkg-builder:latest-x86_64-edge /build/validate-t2.sh
