#!/bin/bash
# Print what bin/promote-channel needs to know about every recipe, one line
# per package directory and CI architecture:
#
#   <arch> TAB <pkgbase> TAB <directory> TAB <yes|no>
#
# pkgbase is what the recipe builds for that architecture (not always the
# directory's name: pkgbuilds/yaru-icon-theme builds yaru), and the last
# field says whether it still builds for it at all.
#
# promote.yml writes it in a job of its own; promotion reads it instead of
# the recipes.
set -euo pipefail
BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
source "$BUILD_ROOT/helpers/paths.sh"
source "$BUILD_ROOT/helpers/package-metadata.sh"

while IFS= read -r pkgdir; do
  for arch in $(ci_arches); do
    builds=no
    package_supports_arch "$pkgdir" "$arch" && builds=yes
    printf '%s\t%s\t%s\t%s\n' "$arch" "$(package_pkgbase "$pkgdir" "$arch")" "${pkgdir##*/}" "$builds"
  done
done < <(package_dirs)
