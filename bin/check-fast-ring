#!/bin/bash
# Check that fast-ring packages built against edge run on the channels the
# fast ring publishes them to without waiting for a release. See
# helpers/fast-ring-check.sh for what is checked and why.
#
# Usage: bin/check-fast-ring --arch <arch> --channels "<channel>..." <package file>...
#   Each channel other than edge gets a fresh container from the edge
#   builder image (omarchy-pkg-builder:latest-<arch>-edge, which bin/build
#   leaves behind), pointed at that channel's repositories.
set -euo pipefail
BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
source "$BUILD_ROOT/helpers/message-helpers.sh"
source "$BUILD_ROOT/helpers/docker-helpers.sh"
source "$BUILD_ROOT/helpers/paths.sh"

channels=""
while [[ $# -gt 0 && $1 == --* ]]; do
  case $1 in
    --arch) ARCH=${2:?Missing architecture}; shift 2 ;;
    --channels) channels=${2?Missing channels}; shift 2 ;;
    *) print_error "Unknown option: $1"; exit 2 ;;
  esac
done
require_valid_arch "$ARCH"
(( $# )) || { print_error "No package files given"; exit 2; }
check_engine

image="omarchy-pkg-builder:latest-$ARCH-edge"
"$CONTAINER_ENGINE" image inspect "$image" >/dev/null 2>&1 || {
  print_error "Builder image $image is missing; run bin/build for $ARCH first"
  exit 1
}

files=()
mounts=()
for file in "$@"; do
  file=$(realpath "$file")
  files+=("/check/${file##*/}")
  mounts+=(-v "$file:/check/${file##*/}:ro")
done

failed=()
for channel in $channels; do
  [[ $channel == edge ]] && continue
  validate_mirror "$channel" || { print_error "Invalid channel: $channel"; exit 2; }
  print_info "Checking ${files[*]##*/} against $channel ($ARCH)..."
  if ! "$CONTAINER_ENGINE" run --rm --user root "$(get_platform_arg "$ARCH")" \
    -v "$BUILD_ROOT/helpers:/helpers:ro" "${mounts[@]}" "$image" \
    bash -c '/helpers/fast-ring-check.sh prepare "$1" "$2" >/dev/null && /helpers/fast-ring-check.sh check "${@:3}"' \
    _ "$channel" "$ARCH" "${files[@]}"; then
    failed+=("$channel")
  fi
done

if (( ${#failed[@]} )); then
  print_error "Not safe on the fast ring: fails on ${failed[*]} ($ARCH)."
  print_info "Drop \"release_ring\": \"fast\" so the package reaches rc and stable with the release, or fix the build."
  exit 1
fi
print_success "Fast-ring check passed ($ARCH)"
