#!/bin/bash
# Check that fast-ring packages built against edge run on the channels the
# fast ring publishes them to without waiting for a release. See
# helpers/fast-ring-check.sh for what is checked and why.
#
# Usage: bin/check-fast-ring --arch <arch> --channels "<channel>..." [--compiled] <package file>...
#   --compiled: this repository compiles the package (its PKGBUILD has a
#   build()), so linking Qt or libpython ties it to rebuilds.
#   Edge and each other channel get a fresh container from the edge builder
#   image (omarchy-pkg-builder:latest-<arch>-edge, which bin/build leaves
#   behind), pointed at that channel's repositories. A channel fails on a
#   problem edge does not share, or on a rule the fast ring never allows.
set -euo pipefail
BUILD_ROOT=$(realpath "${BASH_SOURCE[0]%/*}/..")
source "$BUILD_ROOT/helpers/message-helpers.sh"
source "$BUILD_ROOT/helpers/docker-helpers.sh"
source "$BUILD_ROOT/helpers/paths.sh"

channels=""
compiled=0
while [[ $# -gt 0 && $1 == --* ]]; do
  case $1 in
    --arch) ARCH=${2:?Missing architecture}; shift 2 ;;
    --channels) channels=${2?Missing channels}; shift 2 ;;
    --compiled) compiled=1; shift ;;
    *) print_error "Unknown option: $1"; exit 2 ;;
  esac
done
require_valid_arch "$ARCH"
(( $# )) || { print_error "No package files given"; exit 2; }
check_engine

image="omarchy-pkg-builder:latest-$ARCH-edge"
"$CONTAINER_ENGINE" image inspect "$image" >/dev/null 2>&1 || {
  print_error "Builder image $image is missing; run bin/build for $ARCH first"
  exit 1
}

files=()
mounts=()
for file in "$@"; do
  file=$(realpath "$file")
  files+=("/check/${file##*/}")
  # --mount, not -v: an epoch puts a colon in the filename.
  mounts+=(--mount "type=bind,src=$file,dst=/check/${file##*/},readonly")
done

results=$(mktemp -d)
trap 'rm -rf "$results"' EXIT
chmod 777 "$results"

# inspect <channel>: install the packages on <channel> and record what would
# break there in $results/<channel>.
inspect() {
  print_info "Inspecting ${files[*]##*/} on $1 ($ARCH)..."
  "$CONTAINER_ENGINE" run --rm --user root "$(get_platform_arg "$ARCH")" -e COMPILED="$compiled" \
    -v "$BUILD_ROOT/helpers:/helpers:ro" -v "$results:/results" "${mounts[@]}" "$image" \
    bash -c '/helpers/fast-ring-check.sh prepare "$1" "$2" >/dev/null && /helpers/fast-ring-check.sh check "/results/$1" "${@:3}" >/dev/null' \
    _ "$1" "$ARCH" "${files[@]}" || {
    print_error "The check itself failed on $1 ($ARCH); see the output above"
    exit 1
  }
}

# Edge is the baseline: the build environment's own view of the package.
inspect edge

failed=()
# Arch Linux ARM has no snapshots: every aarch64 channel runs the same live
# repositories as edge, so only the rules can differ, and edge shows them.
# aarch64 rc and stable also carry only the fast ring, without omarchy
# itself, so no Omarchy machine resolves dependencies against them.
if [[ $ARCH == aarch64 ]]; then
  problems=$(awk -F'\t' '$1 == "rule"' "$results/edge")
  if [[ -n $problems ]]; then
    print_error "Breaks the fast ring's rules:"
    awk -F'\t' '{ printf "  %s: %s\n", $2, $3 }' <<<"$problems"
    failed+=(edge)
  fi
  channels=""
fi
for channel in $channels; do
  [[ $channel == edge ]] && continue
  validate_mirror "$channel" || { print_error "Invalid channel: $channel"; exit 2; }
  inspect "$channel"
  problems=$(bash -c 'source "$1"; channel_failures "$2" "$3"' _ \
    "$BUILD_ROOT/helpers/fast-ring-check.sh" "$results/edge" "$results/$channel")
  if [[ -n $problems ]]; then
    print_error "Fails on $channel:"
    awk -F'\t' '{ printf "  %s: %s\n", $2, $3 }' <<<"$problems"
    failed+=("$channel")
  fi
done

if (( ${#failed[@]} )); then
  print_error "Not safe on the fast ring: fails on ${failed[*]} ($ARCH)."
  print_info "Drop \"release_ring\": \"fast\" so the package reaches rc and stable with the release, or fix the build."
  exit 1
fi
print_success "Fast-ring check passed ($ARCH)"
