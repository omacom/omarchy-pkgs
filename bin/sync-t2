#!/usr/bin/env python3
"""Import a reviewed T2 source commit into the local package recipes.

Unlike a version-only feed, a kernel update must carry its matching configuration,
patch pin and signatures together. This command never builds or publishes.
"""
import argparse
import difflib
import hashlib
import json
from pathlib import Path
import re
import shutil
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
SOURCES = {
    "linux-t2": "NoaHimesaka1873/linux-t2-arch",
    "apple-t2-audio-config": "deqrocks/t2bce",
    "t2fanrd": "GnomedDev/t2fanrd",
    "apple-bcm-firmware": "omacom/apple-bcm-firmware",
}


def run(*args, **kwargs):
    return subprocess.check_output(args, **kwargs)


def scalar(recipe, name):
    matches = re.findall(rf"^{re.escape(name)}=([0-9A-Za-z._]+)$", recipe, re.M)
    if len(matches) != 1:
        raise ValueError(f"Expected one literal {name} assignment")
    return matches[0]


def replace_scalar(recipe, name, value):
    scalar(recipe, name)
    return re.sub(rf"^{re.escape(name)}=.*$", f"{name}={value}", recipe, flags=re.M)


def firmware_manifest(repo, commit, previous):
    """Hash Git blobs, preserving existing Intel filename coverage on updates."""
    pattern = r"(brcmfmac(?:4355c1|4364b2|4364b3|4377b3)-|brcmbt4377b3-)[A-Za-z0-9,._-]+"
    entries = run("git", "-C", str(repo), "ls-tree", "-rz", commit,
                  "lib/firmware/brcm").decode().split("\0")
    hashes = {}
    for entry in filter(None, entries):
        attributes, path = entry.split("\t", 1)
        name = path.removeprefix("lib/firmware/brcm/")
        if not re.fullmatch(pattern, name):
            continue
        mode, kind, oid = attributes.split()
        if mode != "100644" or kind != "blob":
            raise ValueError(f"Firmware must be regular data: {path}")
        content = run("git", "-C", str(repo), "cat-file", "blob", oid)
        if not content:
            raise ValueError(f"Empty firmware: {path}")
        hashes[name] = hashlib.sha256(content).hexdigest()
    old_names = {line.split()[1] for line in previous.splitlines()}
    if not hashes or old_names - hashes.keys():
        raise ValueError("Firmware import would remove existing Intel filenames; review coverage explicitly")
    return "".join(f"{digest}  {name}\n" for name, digest in sorted(hashes.items())).encode()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("package", choices=SOURCES)
    parser.add_argument("commit", help="reviewed full 40-character upstream commit")
    parser.add_argument("--check", action="store_true", help="show the diff without writing")
    parser.add_argument("--firmware-version", help="reviewed macOS version of the firmware Git tree, not release assets")
    parser.add_argument("--pkgrel", help="firmware-only local release, e.g. 1.2 for a same-macOS update (default 1.1)")
    args = parser.parse_args()
    if not re.fullmatch(r"[0-9a-f]{40}", args.commit):
        parser.error("commit must be a full lowercase Git SHA-1")
    if args.package == "apple-bcm-firmware":
        if not args.firmware_version or not re.fullmatch(r"[0-9]+(?:\.[0-9]+)+", args.firmware_version):
            parser.error("firmware requires --firmware-version with the reviewed macOS version")
        if args.pkgrel and not re.fullmatch(r"[1-9][0-9]*\.[1-9][0-9]*", args.pkgrel):
            parser.error("--pkgrel must be a positive dotted local release")
    elif args.firmware_version or args.pkgrel:
        parser.error("--firmware-version and --pkgrel apply only to apple-bcm-firmware")
    if not shutil.which("vercmp"):
        parser.error("vercmp (pacman) is required for upgrade ordering")
    package = ROOT / "pkgbuilds" / args.package
    current = (package / "PKGBUILD").read_text()
    metadata = json.loads((package / ".omarchy/package.json").read_text())
    with tempfile.TemporaryDirectory(prefix="omarchy-sync-t2-") as tmp:
        tmp = Path(tmp)
        repo = tmp / "upstream"
        run("git", "clone", "--quiet", "--no-checkout", "--filter=blob:none",
            f"https://github.com/{SOURCES[args.package]}.git", str(repo))
        resolved = run("git", "-C", str(repo), "rev-parse", f"{args.commit}^{{commit}}", text=True).strip()
        if resolved != args.commit:
            raise ValueError("Commit did not resolve exactly")

        files = {}
        if args.package == "linux-t2":
            # Do not execute the upstream recipe. Preserve its verified source
            # checksums/signatures and config as a unit, then apply our diff.
            for name in ("PKGBUILD", "config.x86_64", "LICENSE"):
                files[name] = run("git", "-C", str(repo), "show", f"{args.commit}:{name}")
                (tmp / name).write_bytes(files[name])
            for patch in sorted((package / ".omarchy/patches").glob("*.patch")):
                run("git", "apply", "--check", str(patch), cwd=tmp)
                run("git", "apply", str(patch), cwd=tmp)
            candidate = (tmp / "PKGBUILD").read_text()
            # A dotted Omarchy revision upgrades from the corresponding mirror
            # build without taking over upstream's integer release numbering.
            candidate = replace_scalar(candidate, "pkgrel", scalar(candidate, "pkgrel") + ".1")
        else:
            if args.package == "apple-bcm-firmware":
                version = args.firmware_version
                files["intel-firmware.sha256"] = firmware_manifest(
                    repo, args.commit, (package / "intel-firmware.sha256").read_text())
            else:
                count = run("git", "-C", str(repo), "rev-list", "--count", args.commit, text=True).strip()
                prefix = "0.4.r" if args.package == "apple-t2-audio-config" else "r"
                separator = ".g" if args.package == "apple-t2-audio-config" else "."
                version = f"{prefix}{count}{separator}{args.commit[:7]}"
            archive = tmp / "source.tar.gz"
            run("curl", "--fail", "--silent", "--show-error", "--location", "--retry", "3",
                f"https://github.com/{SOURCES[args.package]}/archive/{args.commit}.tar.gz", "-o", str(archive))
            import gzip
            served_commit = run("git", "get-tar-commit-id", input=gzip.decompress(archive.read_bytes())).decode().strip()
            if served_commit != args.commit:
                raise ValueError("Source archive does not match the requested commit")
            sums = [hashlib.sha256(archive.read_bytes()).hexdigest()]
            if args.package == "t2fanrd":
                sums += [hashlib.sha256((package / name).read_bytes()).hexdigest()
                         for name in ("t2fanrd.service", "t2fand.conf")]
            elif args.package == "apple-bcm-firmware":
                sums += [hashlib.sha256(files["intel-firmware.sha256"]).hexdigest(),
                         hashlib.sha256((package / "PROVENANCE.md").read_bytes()).hexdigest()]
            candidate = replace_scalar(current, "_commit", args.commit)
            candidate = replace_scalar(candidate, "pkgver", version)
            candidate = replace_scalar(candidate, "pkgrel", args.pkgrel or "1.1")
            candidate, replacements = re.subn(r"^sha256sums=\([^)]*\)",
                "sha256sums=(" + "\n            ".join(f"'{s}'" for s in sums) + ")",
                candidate, flags=re.M)
            if replacements != 1:
                raise ValueError("Expected one sha256sums array")

        old_version = scalar(current, "pkgver") + "-" + scalar(current, "pkgrel")
        new_version = scalar(candidate, "pkgver") + "-" + scalar(candidate, "pkgrel")
        ordering = int(run("vercmp", new_version, old_version, text=True))
        if ordering < 0:
            raise ValueError(f"Refusing downgrade: {old_version} -> {new_version}")
        files["PKGBUILD"] = candidate.encode()
        metadata["upstream_commit"] = args.commit
        files[".omarchy/package.json"] = (json.dumps(metadata, indent=2) + "\n").encode()
        changed = {name: content for name, content in files.items()
                   if not (package / name).exists() or (package / name).read_bytes() != content}
        if changed and ordering == 0:
            raise ValueError("Source or recipe changed without a version increase; bump pkgrel deliberately")
        for name, content in changed.items():
            before = (package / name).read_text() if (package / name).exists() else ""
            print("".join(difflib.unified_diff(before.splitlines(True), content.decode().splitlines(True),
                  fromfile=f"a/pkgbuilds/{args.package}/{name}", tofile=f"b/pkgbuilds/{args.package}/{name}")), end="")
        if args.check:
            print(f"{args.package}: {len(changed)} file(s) would change")
            return
        # All retrieval, patch and ordering checks finish before the first edit.
        for name, content in changed.items():
            (package / name).write_bytes(content)
        print(f"{args.package}: {len(changed)} file(s) updated; review and build before committing")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, subprocess.CalledProcessError) as error:
        raise SystemExit(str(error))
