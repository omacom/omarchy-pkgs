#!/bin/bash
# Put a publish report on the PR that merged a commit: edit the report
# already there, or add one.
#
#   publish-report-post --repo OWNER/NAME --commit SHA [--edit-only] BODY
#
# BODY is bin/publish-report's output, which ends in the marker
# <!-- publish-report SHA -->. The PR is the one GitHub links to the merge
# commit. A comment of github-actions[bot] carrying that marker is edited
# in place, so a rerun or a later promotion redraws one report and
# notifies no one. Without one, a new comment is added, unless
# --edit-only, which then does nothing.
#
# Needs gh with GH_TOKEN allowed to write pull requests. Exits 0 when the
# commit has no PR (a manual dispatch runs from master's head, whose PR
# merged something else).
set -euo pipefail

REPO=""
COMMIT=""
EDIT_ONLY=false
BODY=""
while [[ $# -gt 0 ]]; do
  case $1 in
  --repo) REPO=$2; shift 2 ;;
  --commit) COMMIT=$2; shift 2 ;;
  --edit-only) EDIT_ONLY=true; shift ;;
  -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
  -*) echo "Unknown option: $1" >&2; exit 64 ;;
  *) [[ -z $BODY ]] || { echo "One body only" >&2; exit 64; }; BODY=$1; shift ;;
  esac
done
[[ -n $REPO && -n $COMMIT && -s $BODY ]] || { echo "Usage: publish-report-post --repo OWNER/NAME --commit SHA [--edit-only] BODY" >&2; exit 64; }

pr=$(gh api "repos/$REPO/commits/$COMMIT/pulls" --jq '[.[] | select(.merged_at != null)][0].number // empty')
if [[ -z $pr ]]; then
  echo "no merged PR for $COMMIT; nothing posted"
  exit 0
fi

marker="<!-- publish-report $COMMIT -->"
comment=$(gh api --paginate "repos/$REPO/issues/$pr/comments" \
  --jq ".[] | select(.user.login == \"github-actions[bot]\" and (.body | contains(\"$marker\"))) | .id" | tail -1)
if [[ -n $comment ]]; then
  gh api -X PATCH "repos/$REPO/issues/comments/$comment" -F "body=@$BODY" >/dev/null
  echo "updated the report on #$pr"
elif [[ $EDIT_ONLY == true ]]; then
  echo "#$pr has no report for $COMMIT; nothing edited"
else
  gh api -X POST "repos/$REPO/issues/$pr/comments" -F "body=@$BODY" >/dev/null
  echo "commented on #$pr"
fi
