#!/usr/bin/env python3
"""Compare the HDA type layouts a DKMS module was built with against its kernel.

The audio package compiles prepared private HDA headers from a vanilla kernel
release. A stock or fallback kernel can patch those headers, so every type the
module carries in its own BTF must match the same-named type in the kernel's
HDA modules. Types the kernel does not define are driver-local and ignored.

Usage: compare-hda-btf-layouts VMLINUX MODULE KERNEL_MODULE...
"""

import re
import subprocess
import sys

TYPE_START = re.compile(r"^(struct|union|enum) (\w+) \{")
# Layout summaries vary with cacheline annotations, not with the layout itself.
ANNOTATION = re.compile(r"\s*/\* (---|XXX|sum members|paddings|last cacheline|BRAIN)")


def layouts(path, base=None):
    command = ["pahole", "-F", "btf"]
    if base:
        command += ["--btf_base", base]
    output = subprocess.run(
        command + [path], check=True, capture_output=True, text=True
    ).stdout

    types = {}
    name = None
    lines = []
    for line in output.splitlines(keepends=True):
        match = TYPE_START.match(line)
        if name is None:
            if match:
                name = f"{match.group(1)} {match.group(2)}"
                lines = [line]
            continue
        lines.append(line)
        if line.startswith("}"):
            body = "".join(l for l in lines if not ANNOTATION.match(l))
            types.setdefault(name, set()).add(body)
            name = None
    return types


def main(argv):
    if len(argv) < 4:
        print(__doc__.strip().splitlines()[-1], file=sys.stderr)
        return 2

    vmlinux, module, kernel_modules = argv[1], argv[2], argv[3:]
    base = layouts(vmlinux)
    own = {
        name: bodies
        for name, bodies in layouts(module, vmlinux).items()
        if base.get(name) != bodies
    }
    kernel = {}
    for path in kernel_modules:
        for name, bodies in layouts(path, vmlinux).items():
            kernel.setdefault(name, set()).update(bodies)

    shared = sorted(name for name in own if name in kernel)
    mismatched = [name for name in shared if not own[name] & kernel[name]]

    if not shared:
        print("No HDA types shared with the kernel; module BTF is missing", file=sys.stderr)
        return 1
    for name in mismatched:
        print(f"Layout differs from the kernel: {name}", file=sys.stderr)
    print(f"{len(shared)} shared HDA types, {len(mismatched)} mismatched")
    return 1 if mismatched else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
