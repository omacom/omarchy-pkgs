[Unit]
Description=Check PKGBUILD versions against published repo versions
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/root/omarchy-pkgs/bin/check-versions --pull
Environment=OMARCHY_STATE_DIR=/root/.state
WorkingDirectory=/root/omarchy-pkgs

[Install]
WantedBy=multi-user.target
