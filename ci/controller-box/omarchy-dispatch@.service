[Unit]
Description=Dispatch the %i workflow
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=controller
EnvironmentFile=/etc/omarchy-controller.env
# The checkout is kept current by omarchy-controller.service's minute pull.
ExecStart=/opt/omarchy-pkgs/ci/dispatch.sh %i
TimeoutStartSec=60
