[Unit]
Description=Dispatch sync-rebuilds when the edge mirror publishes a new sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=controller
EnvironmentFile=/etc/omarchy-controller.env
# Holds the last mirror lastsync it acted on.
StateDirectory=omarchy-rebuilds-on-mirror-sync
# The checkout is kept current by omarchy-controller.service's minute pull.
ExecStart=/opt/omarchy-pkgs/ci/dispatch-on-mirror-sync.sh
TimeoutStartSec=90
