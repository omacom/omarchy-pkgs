# Audio DSP, compute DSP and GPU firmware for the HP EliteBook Ultra G1q. The firmware only runs
# if it is signed for this board by HP, so linux-firmware cannot carry it until the OEM submits
# it. The OEM ships it in its Windows driver download, which this recipe unpacks without running.
# The files are installed unmodified, under the names the device tree requests, and checked
# against the SHA-256 each was matched to.
#
# Generated from https://arewearmyet.com/firmware-sources.json by bin/snapdragon-firmware-recipes;
# change the table, not this file.

pkgname=hp-elitebook-ultra-g1q-firmware
pkgver=20261102
pkgrel=1
pkgdesc='Audio DSP, compute DSP and GPU firmware for the HP EliteBook Ultra G1q'
arch=('aarch64')
url='https://ftp.hp.com/pub/softpaq/sp171501-172000/sp171528.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1e80100-hp-elitebook-ultra-g1q')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  "hp-sp171528.exe::https://ftp.hp.com/pub/softpaq/sp171501-172000/sp171528.exe"
)
noextract=('hp-sp171528.exe')
sha256sums=('3937fa23b6cf28fae5161d1aa717043b4fcb119300e7478a76405a6617460978')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'hp-sp171528.exe' 'hp-sp171528' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'hp-sp171528/src/Driver/1ADSP_8600_1.0_1115/adsp_dtbs.elf' "$fw/qcom/x1e80100/hp/elitebook-ultra-g1q/adsp_dtbs.elf"
  install -Dm644 'hp-sp171528/src/Driver/1ADSP_8600_1.0_1115/adspr.jsn' "$fw/qcom/x1e80100/hp/elitebook-ultra-g1q/adspr.jsn"
  install -Dm644 'hp-sp171528/src/Driver/1ADSP_8600_1.0_1115/adsps.jsn' "$fw/qcom/x1e80100/hp/elitebook-ultra-g1q/adsps.jsn"
  install -Dm644 'hp-sp171528/src/Driver/1ADSP_8600_1.0_1115/adspua.jsn' "$fw/qcom/x1e80100/hp/elitebook-ultra-g1q/adspua.jsn"
  install -Dm644 'hp-sp171528/src/Driver/1ADSP_8600_1.0_1115/battmgr.jsn' "$fw/qcom/x1e80100/hp/elitebook-ultra-g1q/battmgr.jsn"
  install -Dm644 'hp-sp171528/src/Driver/1qcnspmcdm_ext_cdsp8380_8700/cdsp_dtbs.elf' "$fw/qcom/x1e80100/hp/elitebook-ultra-g1q/cdsp_dtbs.elf"
