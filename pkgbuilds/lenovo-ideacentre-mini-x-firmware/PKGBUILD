# Audio DSP, compute DSP, GPU and video firmware for the Lenovo IdeaCentre Mini x. The firmware
# only runs if it is signed for this board by Lenovo, so linux-firmware cannot carry it until the
# OEM submits it. The OEM ships it in its Windows driver download, which this recipe unpacks
# without running. Each file is checked against the SHA-256 it was matched to and installed under
# the name the device tree requests, compressed with xz. The kernel tries a plain name, then .zst,
# then .xz, so once linux-firmware ships the same file, its copy is the one loaded, and the two
# packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=lenovo-ideacentre-mini-x-firmware
pkgver=20261102
pkgrel=2
pkgdesc='Audio DSP, compute DSP, GPU and video firmware for the Lenovo IdeaCentre Mini x'
arch=('aarch64')
url='https://download.lenovo.com/pccbbs/desktop/u9corhdus14lcfc.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1e80100-lenovo-91b6')
makedepends=('7zip' 'innoextract')
options=('!strip' '!debug')
source=(
  'lenovo-u9corhdus14lcfc.exe::https://download.lenovo.com/pccbbs/desktop/u9corhdus14lcfc.exe'
)
noextract=('lenovo-u9corhdus14lcfc.exe')
sha256sums=('8eec6ef5040c6076af95bdc0d53f9510e41f18f6cf0a5f3abcfb8d88275e1b4d')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'lenovo-u9corhdus14lcfc.exe' 'lenovo-u9corhdus14lcfc' inno
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'lenovo-u9corhdus14lcfc/code$GetExtractPath$/Drivers/Mini8800_adsp/adsp_dtbs.elf' "$fw"/'qcom/x1e80100/LENOVO/91B6/adsp_dtbs.elf'
  install -Dm644 'lenovo-u9corhdus14lcfc/code$GetExtractPath$/Drivers/Mini8800_adsp/adspr.jsn' "$fw"/'qcom/x1e80100/LENOVO/91B6/adspr.jsn'
  install -Dm644 'lenovo-u9corhdus14lcfc/code$GetExtractPath$/Drivers/Mini8800_adsp/adsps.jsn' "$fw"/'qcom/x1e80100/LENOVO/91B6/adsps.jsn'
  install -Dm644 'lenovo-u9corhdus14lcfc/code$GetExtractPath$/Drivers/Mini8800_adsp/adspua.jsn' "$fw"/'qcom/x1e80100/LENOVO/91B6/adspua.jsn'
  install -Dm644 'lenovo-u9corhdus14lcfc/code$GetExtractPath$/Drivers/Mini8800_adsp/battmgr.jsn' "$fw"/'qcom/x1e80100/LENOVO/91B6/battmgr.jsn'
  install -Dm644 'lenovo-u9corhdus14lcfc/code$GetExtractPath$/Drivers/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1e80100/LENOVO/91B6/cdsp_dtbs.elf'
  install -Dm644 'lenovo-u9corhdus14lcfc/code$GetExtractPath$/Drivers/qcnspmcdm_ext_cdsp8380/cdspr.jsn' "$fw"/'qcom/x1e80100/LENOVO/91B6/cdspr.jsn'
  install -Dm644 'lenovo-u9corhdus14lcfc/code$GetExtractPath$/Drivers/Mini8800_adsp/qcadsp8380.mbn' "$fw"/'qcom/x1e80100/LENOVO/91B6/qcadsp8380.mbn'
  install -Dm644 'lenovo-u9corhdus14lcfc/code$GetExtractPath$/Drivers/qcnspmcdm_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1e80100/LENOVO/91B6/qccdsp8380.mbn'
  install -Dm644 'lenovo-u9corhdus14lcfc/code$GetExtractPath$/Drivers/qcdx8380/qcdxkmsuc8380.mbn' "$fw"/'qcom/x1e80100/LENOVO/91B6/qcdxkmsuc8380.mbn'
  install -Dm644 'lenovo-u9corhdus14lcfc/code$GetExtractPath$/Drivers/qcdx8380/qcvss8380.mbn' "$fw"/'qcom/x1e80100/LENOVO/91B6/qcvss8380.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
45a3e59073735da7bab8cf3eaa9afaacd36093ab1c2b603255a95091127df020  qcom/x1e80100/LENOVO/91B6/adsp_dtbs.elf
4b9566fcfdc1656c38d8158d79db6964e9c4b57a6e42b46241e8d63aabc42d8d  qcom/x1e80100/LENOVO/91B6/adspr.jsn
19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e  qcom/x1e80100/LENOVO/91B6/adsps.jsn
d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d  qcom/x1e80100/LENOVO/91B6/adspua.jsn
b8aad1d149128f414eb1fd6fcbb6e0a5b7dabcd2cba001599e1ce9a0e2e291a4  qcom/x1e80100/LENOVO/91B6/battmgr.jsn
8880a7a2252e7951b1bc7c14869c8c37062583ba26b21fee6194c593e3447a7e  qcom/x1e80100/LENOVO/91B6/cdsp_dtbs.elf
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x1e80100/LENOVO/91B6/cdspr.jsn
e1f325b81fe8b2b4e40f8a5756a16fa2f5aaeebdee98430d44cf64d914d2b56e  qcom/x1e80100/LENOVO/91B6/qcadsp8380.mbn
