# Maintainer: Jason Lee <huacnlee@gmail.com>

pkgname=omasend
pkgver=0.1.4
pkgrel=1
pkgdesc='Omarchy-native LocalSend client'
arch=('x86_64' 'aarch64')
url='https://github.com/huacnlee/omasend'
license=('MIT')

depends=(
  'fontconfig'
  'freetype2'
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
  'libxkbcommon'
  'libxkbcommon-x11'
  'libxcb'
  'omarchy'
  'openssl'
  'vulkan-icd-loader'
  'wayland'
  'zstd'
)
optdepends=('wl-clipboard: paste clipboard content on Wayland')

# Release artifacts are already stripped, so there are no debug symbols to split.
options=('!debug' '!strip')

source=('LICENSE')
source_x86_64=(
  "$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver-x86_64-unknown-linux-gnu.tar.gz"
)
source_aarch64=(
  "$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver-aarch64-unknown-linux-gnu.tar.gz"
)
sha256sums=('a7bb7bac82b24d5ad7c89d01121ff8a144bf147e043624811458266d4ed423bc')
sha256sums_x86_64=('337a2e22be0fc00a5688686c2bb07203bf699af71a9fc2685ae087e02b2e5413')
sha256sums_aarch64=('cd48d3ade3174d187db1598bc1f30f927642877a06c7a182a1471981920bac0d')

package() {
  install -Dm755 omasend "$pkgdir/usr/bin/omasend"
  install -Dm644 packaging/omasend.desktop \
    "$pkgdir/usr/share/applications/omasend.desktop"
  install -Dm644 assets/omasend.png \
    "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/omasend.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
