[Unit]
Description=Aurora Mesa graphics provider for FEX (x86 guest)
After=local-fs.target
ConditionPathExists=/usr/share/guestos/fex-mesa/graphics_provider.json
# The layer uses the Arch Linux FEX rootfs layout (x86_64 in /usr/lib, i686 in
# /usr/lib32); over another layout its drivers would be invisible.
ConditionPathIsDirectory=/usr/share/guestos/fex-mesa/usr/lib32
ConditionPathIsDirectory=/usr/share/guestos/aurora-fex-mesa-layer/usr

[Service]
Type=oneshot
RemainAfterExit=yes
# The Aurora x86_64/i686 Mesa layer over the stock guest rootfs. The stock guest
# Mesa has no Apple G17P support; this layer is built from the same Mesa commit
# as the host driver (mesa-aurora) and moves with it.
ExecStart=/usr/bin/mount -t overlay overlay -o ro,lowerdir=/usr/share/guestos/aurora-fex-mesa-layer:/usr/share/guestos/fex-mesa /usr/share/guestos/aurora-fex-mesa
ExecStop=/usr/bin/umount /usr/share/guestos/aurora-fex-mesa

[Install]
WantedBy=multi-user.target
