pkgname=mesa-aurora-fex-guest
epoch=1
pkgver=26.3.0_devel.20261017.af3d9c6fc84
pkgrel=2
pkgdesc='Aurora Mesa (x86_64 and i686) as the FEX guest graphics provider'
arch=('any')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/aurora-silicon/mesa'
license=('MIT')
# Keep _commit, epoch, pkgver and pkgrel identical to mesa-aurora: the guest
# driver must match the host driver and the kernel UAPI it speaks.
_commit=af3d9c6fc84f6e5bc6ee23f1eb0b47a5ee466826
#
# x86 games run by Valve's FEX compat tool draw through a guest graphics
# provider: an x86 rootfs that pressure-vessel maps at /run/gfx. The tool's
# default provider is /usr/share/guestos/fex-mesa, whose stock Mesa has no
# Apple G17P support, so the GPU rejects every job and games show a black
# window. This package lays x86_64 and i686 builds of the Aurora Mesa over
# that rootfs as a read-only overlay at /usr/share/guestos/aurora-fex-mesa;
# omarchy-launch-steam passes its graphics_provider.json to Steam.
#
# The layer uses the Arch Linux FEX rootfs layout (x86_64 in /usr/lib, i686 in
# /usr/lib32), matching the graphics_provider.json FEX's Arch rootfs carries.
# aurora-fex-mesa.service refuses a guest rootfs without /usr/lib32.
#
# The payload is x86 code for an aarch64 host, so this is arch=any and must be
# built on x86_64 Arch Linux with [multilib] enabled for the lib32-* packages.
#
# The drivers link neither LLVM nor SPIRV-Tools, as in mesa-aurora. They load
# inside the guest rootfs, whose LLVM is whatever its distribution ships: a
# driver linked to this builder's libLLVM.so.N fails to load there, leaving
# the game without a GPU driver. lm_sensors is off for the same reason (its
# soname differs between distributions). LLVM is needed only to
# precompile the CL shaders, so a first native build makes those compilers and
# both driver builds use them; no 32-bit clang, LLVM or SPIR-V translator.
makedepends=('git' 'meson' 'ninja' 'python-mako' 'python-yaml' 'python-packaging'
             'python-pycparser' 'python-ply' 'bison' 'flex' 'glslang'
             'clang' 'llvm' 'libclc' 'spirv-llvm-translator' 'spirv-tools' 'spirv-headers'
             'lib32-glibc' 'lib32-gcc-libs'
             'libdrm' 'expat' 'libglvnd' 'libx11' 'libxcb' 'libxext' 'libxfixes' 'libxrandr'
             'libxshmfence' 'libxxf86vm' 'wayland' 'wayland-protocols' 'vulkan-headers'
             'vulkan-icd-loader' 'libdisplay-info' 'lm_sensors' 'zlib' 'zstd' 'libelf'
             'lib32-libdrm' 'lib32-expat' 'lib32-libglvnd' 'lib32-libx11'
             'lib32-libxcb' 'lib32-libxext' 'lib32-libxfixes' 'lib32-libxrandr'
             'lib32-libxshmfence' 'lib32-libxxf86vm' 'lib32-wayland' 'lib32-vulkan-icd-loader'
             'lib32-libdisplay-info' 'lib32-lm_sensors' 'lib32-zlib' 'lib32-zstd'
             'lib32-libelf')
source=("mesa::git+$url.git#commit=$_commit"
        aurora-fex-mesa.service)
sha256sums=('SKIP'
            'abc60386ff49ef4ffaf9a773591ce601936691e9b413bcac9b2c0a96cb0df325')
install=mesa-aurora-fex-guest.install
# x86 objects: the aarch64 toolchain must not strip them, and the guest
# rootfs, not the host, satisfies their library dependencies.
options=('!strip' '!debug' '!lto')

_layer=usr/share/guestos/aurora-fex-mesa-layer
_options=(--prefix=/usr --buildtype=release -Db_ndebug=true --wrap-mode=nodownload
  -Dplatforms=x11,wayland -Dgallium-drivers=asahi,zink,softpipe
  -Dvulkan-drivers=asahi -Dvulkan-layers= -Dglx=dri -Degl=enabled -Dgbm=enabled
  -Dgles1=disabled -Dgles2=enabled -Dopengl=true -Dgallium-rusticl=false
  -Dtools= -Dbuild-tests=false -Dvalgrind=disabled -Dvideo-codecs= -Dglvnd=enabled
  -Dmicrosoft-clc=disabled -Dlibunwind=disabled -Dlmsensors=disabled)
# The drivers' settings; the shader compilers come from the tools build.
_drivers=(-Dllvm=disabled -Dspirv-tools=disabled -Dmesa-clc=system -Dprecomp-compiler=system
  --native-file tools.ini)

build() {
  export MESA_GIT_SHA1_OVERRIDE=$_commit
  # The CL compilers run on the build machine and need LLVM.
  meson setup mesa tools "${_options[@]}" --libdir=lib -Dllvm=enabled
  ninja -C tools -j "${OMARCHY_BUILD_JOBS:-$(nproc)}" \
    src/compiler/clc/mesa_clc src/compiler/spirv/vtn_bindgen2 src/asahi/clc/asahi_clc
  printf '%s\n' '[binaries]' \
    "mesa_clc = '$srcdir/tools/src/compiler/clc/mesa_clc'" \
    "vtn_bindgen2 = '$srcdir/tools/src/compiler/spirv/vtn_bindgen2'" \
    "asahi_clc = '$srcdir/tools/src/asahi/clc/asahi_clc'" > tools.ini

  meson setup mesa b64 "${_options[@]}" "${_drivers[@]}" --libdir=lib
  meson compile -C b64 -j "${OMARCHY_BUILD_JOBS:-$(nproc)}"

  printf '%s\n' '[binaries]' \
    "c = ['gcc', '-m32']" "cpp = ['g++', '-m32']" "ar = 'ar'" "strip = 'strip'" \
    "pkg-config = 'pkg-config'" \
    '[properties]' "pkg_config_libdir = '/usr/lib32/pkgconfig:/usr/share/pkgconfig'" \
    '[host_machine]' "system = 'linux'" "cpu_family = 'x86'" "cpu = 'i686'" \
    "endian = 'little'" > i686.cross
  meson setup mesa b32 "${_options[@]}" "${_drivers[@]}" --libdir=lib32 --cross-file i686.cross
  meson compile -C b32 -j "${OMARCHY_BUILD_JOBS:-$(nproc)}"

  rm -rf stage
  DESTDIR="$srcdir/stage" meson install -C b64 --no-rebuild
  DESTDIR="$srcdir/stage" meson install -C b32 --no-rebuild
  rm -rf stage/usr/include stage/usr/lib/pkgconfig stage/usr/lib32/pkgconfig
}

check() {
  # Every library is x86, of the class its directory promises, and follows
  # neither LLVM nor SPIRV-Tools.
  local library machine count=0
  while IFS= read -r -d '' library; do
    machine=$(LC_ALL=C readelf -h "$library" | sed -n 's/^ *Machine: *//p')
    if LC_ALL=C readelf -d "$library" | grep -Eq 'NEEDED.*(libLLVM|libSPIRV-Tools|libsensors|libunwind)'; then
      echo "Unexpected guest runtime dependency: $library" >&2
      return 1
    fi
    case $library in
      */usr/lib32/*) [[ $machine == 'Intel 80386' ]] ;;
      */usr/lib/*) [[ $machine == 'Advanced Micro Devices X86-64' ]] ;;
      *) false ;;
    esac || { echo "Unexpected $machine library: $library" >&2; return 1; }
    count=$((count + 1))
  done < <(find stage -name '*.so*' -type f -print0)
  ((count > 0)) || return 1
  local arch
  for arch in lib lib32; do
    compgen -G "stage/usr/$arch/libgallium-*.so" >/dev/null || return 1
    [[ -f stage/usr/$arch/libvulkan_asahi.so ]] || return 1
  done
}

package() {
  # Runtime-only: the aarch64 host driver this guest driver is paired with.
  depends=("mesa-aurora=$epoch:$pkgver" "vulkan-aurora=$epoch:$pkgver")

  install -d "$pkgdir/$_layer" "$pkgdir/usr/share/guestos/aurora-fex-mesa"
  cp -a "$srcdir/stage/usr" "$pkgdir/$_layer/"
  echo "$_commit" > "$pkgdir/$_layer/.aurora-mesa-commit"
  install -Dm644 "$srcdir/mesa/docs/license.rst" "$pkgdir/usr/share/licenses/$pkgname/license.rst"
  install -Dm644 "$srcdir/aurora-fex-mesa.service" \
    "$pkgdir/usr/lib/systemd/system/aurora-fex-mesa.service"
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../aurora-fex-mesa.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/aurora-fex-mesa.service"
}
