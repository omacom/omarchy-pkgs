# The overlay must not stay mounted over a layer that pacman replaces or
# removes, so remount it around upgrades and unmount it before removal.
_running() {
  [[ -d /run/systemd/system ]]
}

post_install() {
  _running || return 0
  systemctl daemon-reload
  systemctl start aurora-fex-mesa.service || true
}

pre_upgrade() {
  _running || return 0
  systemctl stop aurora-fex-mesa.service || true
}

post_upgrade() {
  post_install
}

pre_remove() {
  pre_upgrade
}
