# Maintainer: Kristofer Lund <kristoferlund@users.noreply.github.com>
pkgname=ostt-bin
pkgver=0.0.34
pkgrel=1
pkgdesc="Open Speech-to-Text: terminal app for recording and transcribing audio (prebuilt CPU binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/kristoferlund/ostt"
license=('MIT')
depends=('glibc' 'gcc-libs' 'openssl' 'alsa-lib' 'ffmpeg')
optdepends=(
  'wl-clipboard: clipboard support on Wayland'
  'wtype: automatic paste on Wayland'
  'xclip: clipboard support on X11'
  'xdotool: automatic paste on X11'
  'mpv: audio playback for ostt replay'
)
provides=("ostt=${pkgver}")
conflicts=('ostt')
options=('!strip' '!debug')
source_x86_64=("ostt-${pkgver}-x86_64.tar.gz::${url}/releases/download/v${pkgver}/ostt-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("ostt-${pkgver}-aarch64.tar.gz::${url}/releases/download/v${pkgver}/ostt-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('1395495d94758c079e6b627ff072f9c5f877e193b5baa74febc04b0269842467')
sha256sums_aarch64=('666b62dbc7df09c5cdf3284e30f91aedcd79b55db5839cbfa8d719454c3b5d4c')

build() {
  # Generate completions from this release, rather than keeping stale copies.
  # ostt creates its config, data and state dirs on start; keep them in $srcdir.
  local ostt=(env -u XDG_CONFIG_HOME -u XDG_DATA_HOME -u XDG_STATE_HOME
    HOME="$srcdir" "$srcdir/ostt-${CARCH}-unknown-linux-gnu/ostt")
  "${ostt[@]}" completions bash > ostt.bash
  "${ostt[@]}" completions zsh > _ostt
  "${ostt[@]}" completions fish > ostt.fish
}

package() {
  cd "ostt-${CARCH}-unknown-linux-gnu"

  install -Dm755 ostt "$pkgdir/usr/bin/ostt"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
  install -Dm644 "$srcdir/ostt.bash" "$pkgdir/usr/share/bash-completion/completions/ostt"
  install -Dm644 "$srcdir/_ostt" "$pkgdir/usr/share/zsh/site-functions/_ostt"
  install -Dm644 "$srcdir/ostt.fish" "$pkgdir/usr/share/fish/vendor_completions.d/ostt.fish"
}
