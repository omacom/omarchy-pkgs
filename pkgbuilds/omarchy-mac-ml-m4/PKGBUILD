# Draft skeleton: the M4 opt-in ML set (G416), mirroring omarchy-mac-ml-m5/m6.
# Covers the M4 Pro (J616s, T6041/G16S), M4 Air (J713, T8132/G16G) and
# M4 mini (J773g, T8132).
#
# Open slots before this ships:
# - omarchy-mlx>=0.7.40-4 names the staged r5-era wheel + Vulkan driver
#   pairing (fork/pr/7: post-558 wheel, mesa-1 1650fc1a33). Move the floor
#   when the r5 release lands (SLOT G416-wheel-floor; G421 owns the staging).
# - The base omarchy-mlx-vulkan carries the Borealis-name detection
#   (borealis_icd.aarch64.json); a chip-scoped omarchy-mlx-vulkan-m4 with a
#   mesa-git-sha G16S/G16G pin replaces it once G410/G411's green rows name
#   the qualified M4 head (SLOT G416-m4-driver-pin).
# - ANE on M4 ships opt-in: omarchy-ane-h16-dkms builds ane_h16.ko, never
#   autoloaded, runtime opt-in with optin=t6041|t8132. Zero M4 ANE silicon
#   rows yet (G409 is first); the G406 audit confirms the DT nodes.
pkgname=omarchy-mac-ml-m4
pkgver=0
pkgrel=1
pkgdesc='MLX on the GPU and Core ML models on the Neural Engine for M4 Macs (draft package set)'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/omacom/omarchy-pkgs'
license=('MIT')
depends=('linux-aurora' 'omarchy-mlx>=0.7.40-4' 'omarchy-mlx-vulkan>=0.7.40-4'
         'omarchy-ane>=0.5.13' 'omarchy-ane-h16-dkms' 'mil-hwx-compiler')
