# Audio DSP, video, modem and sensor DSP firmware for the Lenovo Miix 630. The firmware only runs
# if it is signed for this board by Lenovo, so linux-firmware cannot carry it until the OEM
# submits it. The OEM ships it in the driver bundle it publishes for the machine on Windows
# Update, whose cabinets this recipe fetches with wudrivers and unpacks without running anything.
# Each file is checked against the SHA-256 it was matched to and installed under the name the
# device tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so
# once linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=lenovo-miix-630-firmware
pkgver=20261115
pkgrel=1
pkgdesc='Audio DSP, video, modem and sensor DSP firmware for the Lenovo Miix 630'
arch=('aarch64')
url='https://github.com/birkskyum/wudrivers'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-msm8998-lenovo-81f1')
makedepends=('7zip' 'wudrivers')
options=('!strip' '!debug')
# Windows Update's links are short-lived, so wudrivers fetches a fresh one by update ID, revision and SHA-1.
DLAGENTS+=('wu::/usr/bin/wudrivers fetch %u -o %o')
source=(
  'lenovo-81f1-wu-200.0.6.0-qcsubsys8998.cab::wu://b35ca847-d890-43ab-91c3-858924b39741/1/d755c12923fbf74d32dcddf6179e428b96d7f99e'
  'lenovo-81f1-wu-200.0.6.0-qcdx8998.cab::wu://b35ca847-d890-43ab-91c3-858924b39741/1/8961681f6435a99e58354a7c54d8017afab3ab71'
)
source+=('README.package.md')
noextract=('lenovo-81f1-wu-200.0.6.0-qcsubsys8998.cab' 'lenovo-81f1-wu-200.0.6.0-qcdx8998.cab')
sha256sums=('13c356d1e716ce6b3457d4e74eec8dd0c7e9916b534d273c27430df03317ecd5' '72689ef44a7eae8be5a6eb81a0ee3dc372cfbef988c3f3f39b4ab985b2d2bc4e')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'lenovo-81f1-wu-200.0.6.0-qcsubsys8998.cab' 'lenovo-81f1-wu-200.0.6.0-qcsubsys8998' 7z
  _unpack 'lenovo-81f1-wu-200.0.6.0-qcdx8998.cab' 'lenovo-81f1-wu-200.0.6.0-qcdx8998' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'lenovo-81f1-wu-200.0.6.0-qcsubsys8998/qcadsp8998.mbn' "$fw"/'qcom/msm8998/LENOVO/81F1/qcadsp8998.mbn'
  install -Dm644 'lenovo-81f1-wu-200.0.6.0-qcsubsys8998/qcdsp1v28998.mbn' "$fw"/'qcom/msm8998/LENOVO/81F1/qcdsp1v28998.mbn'
  install -Dm644 'lenovo-81f1-wu-200.0.6.0-qcsubsys8998/qcdsp28998.mbn' "$fw"/'qcom/msm8998/LENOVO/81F1/qcdsp28998.mbn'
  install -Dm644 'lenovo-81f1-wu-200.0.6.0-qcsubsys8998/qcslpi8998.mbn' "$fw"/'qcom/msm8998/LENOVO/81F1/qcslpi8998.mbn'
  install -Dm644 'lenovo-81f1-wu-200.0.6.0-qcdx8998/qcvss8998.mbn' "$fw"/'qcom/msm8998/LENOVO/81F1/qcvss8998.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
3d1abb4d4686e2877126d845c2e5b2b0d7ee034fe2faf8a01aa8db2e4d02fc13  qcom/msm8998/LENOVO/81F1/qcadsp8998.mbn
0c3b54feea9a6fa0afb76f19f54431ef775dbbef6a2bef5e5dff7537609bb3f7  qcom/msm8998/LENOVO/81F1/qcdsp1v28998.mbn
4abbf58e88c18885264d3d7552d5cc43bd25bcc6c6bd23ecfbe20a1d758ce8be  qcom/msm8998/LENOVO/81F1/qcdsp28998.mbn
42ce2584bb7809ebce958e3e5ebfa4acf8360412b8e9d48d7bda790e11d9ed54  qcom/msm8998/LENOVO/81F1/qcslpi8998.mbn
5536f18357f0c495eec416c5bbcae3b44970eaa9139e3e56c3feb6064312a334  qcom/msm8998/LENOVO/81F1/qcvss8998.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
