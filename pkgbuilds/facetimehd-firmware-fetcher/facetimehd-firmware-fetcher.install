# Installing never touches the network, so an offline install completes at full speed; the service fetches at boot.
post_install() {
	rm -f /run/facetimehd-firmware-fetcher.removing 2>/dev/null || true
	if command -v systemctl >/dev/null 2>&1 &&
		systemctl -q is-enabled facetimehd-firmware-fetcher.service 2>/dev/null; then
		echo "==> facetimehd-firmware-fetcher.service fetches the FaceTime HD firmware from Apple once the Mac is online."
	else
		echo "==> facetimehd-firmware-fetcher.service fetches the FaceTime HD firmware from Apple once enabled: systemctl enable --now facetimehd-firmware-fetcher.service"
	fi
	return 0
}

# A release that pins different files fetches them now, replacing a fetch still running the old pins; a chroot ignores it.
post_upgrade() {
	if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1 &&
		systemctl -q is-enabled facetimehd-firmware-fetcher.service 2>/dev/null; then
		systemctl restart --no-block facetimehd-firmware-fetcher.service 2>/dev/null || true
	fi
	return 0
}

_cleanup_facetimehd_files() {
	local state=$1 f failed=0
	if [ -f "$state/installed-files" ]; then
		if {
			while IFS= read -r f || [ -n "$f" ]; do
				[ -n "$f" ] || continue
				# A package that installed the file since, such as the AUR facetimehd-data, keeps it.
				pacman -Qqo "/usr/lib/firmware/facetimehd/$f" >/dev/null 2>&1 && continue
				rm -f "/usr/lib/firmware/facetimehd/$f" "/usr/lib/firmware/facetimehd/.$f.new" || failed=1
			done
		} <"$state/installed-files"; then
			:
		else
			failed=1
		fi
	fi
	if [ "$failed" -eq 0 ]; then
		rm -rf "$state" 2>/dev/null || true
	else
		echo "==> Could not remove all FaceTime HD firmware files; keeping $state for retry."
	fi
	return 0
}

pre_remove() {
	local state=/var/lib/facetimehd-firmware-fetcher
	local lock_dir=/run/lock
	local lock_file=$lock_dir/facetimehd-firmware-fetcher.lock
	if command -v systemctl >/dev/null 2>&1; then
		if [ -d /run/systemd/system ]; then
			systemctl disable --now facetimehd-firmware-fetcher.service 2>/dev/null ||
				systemctl --root=/ disable facetimehd-firmware-fetcher.service 2>/dev/null || true
		else
			systemctl disable facetimehd-firmware-fetcher.service 2>/dev/null || true
		fi
	fi
	mkdir -p "$lock_dir" 2>/dev/null || true
	# A fetch started by hand that is waiting on the lock gives up once it sees this, rather than writing after removal.
	if touch /run/facetimehd-firmware-fetcher.removing 2>/dev/null &&
		[ -d "$lock_dir" ] && [ ! -L "$lock_file" ] && { [ ! -e "$lock_file" ] || [ -f "$lock_file" ]; } && (
		if ! flock -w 120 9; then
			echo "==> A FaceTime HD firmware fetch is still running; the files it fetched are left in /usr/lib/firmware/facetimehd."
			exit 0
		fi
		_cleanup_facetimehd_files "$state"
	) 2>/dev/null 9>>"$lock_file"; then
		:
	elif [ -e "$state" ]; then
		echo "==> Could not synchronize with a FaceTime HD firmware fetch; fetched files are left in /usr/lib/firmware/facetimehd."
	fi
	return 0
}
