# Fetching is best-effort so the transaction never fails offline; the service retries at boot until it has the files.
post_install() {
	/usr/bin/facetimehd-firmware-fetcher ||
		echo "==> Could not fetch the FaceTime HD firmware now; facetimehd-firmware-fetcher.service retries at boot."
	return 0
}

# A release that pins different files fetches them now rather than at the next boot.
post_upgrade() {
	post_install
}

pre_remove() {
	local list=/var/lib/facetimehd-firmware-fetcher/installed-files
	if [ -f "$list" ]; then
		while read -r f; do
			rm -f "/usr/lib/firmware/facetimehd/$f"
		done <"$list"
	fi
	rm -rf /var/lib/facetimehd-firmware-fetcher
	return 0
}
