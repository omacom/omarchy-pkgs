# Installing never touches the network, so an offline install completes at full speed; the service fetches at boot.
post_install() {
	rm -f /run/facetimehd-firmware-fetcher.removing
	if systemctl -q is-enabled facetimehd-firmware-fetcher.service 2>/dev/null; then
		echo "==> facetimehd-firmware-fetcher.service fetches the FaceTime HD firmware from Apple once the Mac is online."
	else
		echo "==> facetimehd-firmware-fetcher.service fetches the FaceTime HD firmware from Apple once enabled: systemctl enable --now facetimehd-firmware-fetcher.service"
	fi
	return 0
}

# A release that pins different files fetches them now, replacing a fetch still running the old pins; a chroot ignores it.
post_upgrade() {
	if systemctl -q is-enabled facetimehd-firmware-fetcher.service 2>/dev/null; then
		systemctl restart --no-block facetimehd-firmware-fetcher.service 2>/dev/null
	fi
	return 0
}

pre_remove() {
	local state=/var/lib/facetimehd-firmware-fetcher
	systemctl disable --now facetimehd-firmware-fetcher.service 2>/dev/null
	# A fetch started by hand that is waiting on the lock gives up once it sees this, rather than writing after removal.
	touch /run/facetimehd-firmware-fetcher.removing 2>/dev/null
	exec 9>>/run/lock/facetimehd-firmware-fetcher.lock
	if ! flock -w 120 9; then
		echo "==> A FaceTime HD firmware fetch is still running; the files it fetched are left in /usr/lib/firmware/facetimehd."
		return 0
	fi
	if [ -f "$state/installed-files" ]; then
		while read -r f; do
			# A package that installed the file since, such as the AUR facetimehd-data, keeps it.
			pacman -Qqo "/usr/lib/firmware/facetimehd/$f" >/dev/null 2>&1 && continue
			rm -f "/usr/lib/firmware/facetimehd/$f" "/usr/lib/firmware/facetimehd/.$f.new"
		done <"$state/installed-files"
	fi
	rm -rf "$state"
	exec 9>&-
	return 0
}
