# Maintainer: The Omarchy Authors
# Apple's license forbids redistributing the camera's firmware, so this ships only the fetcher. Its ranges, offsets and
# hashes are those patjak/facetimehd-firmware extracts firmware 5.60.0 and the eleven calibration files with.
pkgname=facetimehd-firmware-fetcher
pkgver=1
pkgrel=1
pkgdesc='Fetches the FaceTime HD (Broadcom 1570) camera firmware and calibration from Apple on the Mac that needs them'
url='https://github.com/patjak/facetimehd/wiki/Get-Started'
arch=('x86_64')
license=('MIT')
depends=('bash' 'coreutils' 'curl' 'xz' 'gzip' 'grep' 'util-linux' 'kmod' 'pacman')
provides=('facetimehd-firmware' 'facetimehd-data')
# The AUR firmware packages install the same firmware.bin, which pacman would otherwise let this one delete on removal.
conflicts=('facetimehd-firmware' 'bcwc-pcie-firmware')
install="$pkgname.install"
source=("$pkgname.sh"
        "$pkgname.service"
        'LICENSE')
sha256sums=('ebd23c02865ccbc19ada8dce6db79e6e9f94455a9db975379d2e23178a92d79d'
            '2b7d997f92a7babab6c2037d1d0c8fa73bcfaf59f57b5dd1d380121b9ee3e587'
            '717ba1949502290f8e47688ae2e323acd06c8ca47aec9f7596b15f678c1af4a2')

package() {
  install -Dm755 "$srcdir/$pkgname.sh" "$pkgdir/usr/bin/$pkgname"
  # Owned here so the service sandbox can name it before the first fetch creates anything inside.
  install -d "$pkgdir/usr/lib/firmware/facetimehd"
  install -Dm644 "$srcdir/$pkgname.service" "$pkgdir/usr/lib/systemd/system/$pkgname.service"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
