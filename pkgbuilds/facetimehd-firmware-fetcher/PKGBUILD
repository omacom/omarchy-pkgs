# Maintainer: The Omarchy Authors
# Apple's license forbids redistributing the camera's firmware, so this ships only the fetcher; the extraction follows
# the facetimehd-firmware and facetimehd-data AUR recipes, and each file it installs is pinned to their output.
pkgname=facetimehd-firmware-fetcher
pkgver=1
pkgrel=1
pkgdesc='Fetches the FaceTime HD (Broadcom 1570) camera firmware and calibration from Apple on the Mac that needs them'
url='https://github.com/patjak/facetimehd/wiki/Get-Started'
arch=('x86_64')
license=('MIT')
depends=('bash' 'coreutils' 'curl' 'cpio' 'xz' 'gzip' 'grep' 'util-linux' 'python' '7zip' 'kmod')
provides=('facetimehd-firmware' 'facetimehd-data')
# The AUR packages install the same files, which pacman would otherwise let this one delete on removal.
conflicts=('facetimehd-firmware' 'facetimehd-data' 'bcwc-pcie-firmware')
install="$pkgname.install"
source=("$pkgname.sh"
        "$pkgname.service")
sha256sums=('c454ce47746aa3398ac5f9061b9eede4718abf82bde15177fe437bef2dce63e7'
            '2b7d997f92a7babab6c2037d1d0c8fa73bcfaf59f57b5dd1d380121b9ee3e587')

package() {
  install -Dm755 "$srcdir/$pkgname.sh" "$pkgdir/usr/bin/$pkgname"
  # Owned here so the service sandbox can name it before the first fetch creates anything inside.
  install -d "$pkgdir/usr/lib/firmware/facetimehd"
  install -Dm644 "$srcdir/$pkgname.service" "$pkgdir/usr/lib/systemd/system/$pkgname.service"
}
