[Unit]
Description=Fetch the FaceTime HD camera firmware from Apple
Wants=network-online.target
After=network-online.target
# An offline Mac keeps retrying while it is up; one that has the files exits at once without the network.
StartLimitIntervalSec=0

[Service]
# exec rather than oneshot, so boot never waits on a download.
Type=exec
ExecStart=/usr/bin/facetimehd-firmware-fetcher --reload
Environment=FACETIMEHD_FETCH_RETRIES=10
Restart=on-failure
RestartPreventExitStatus=3
RestartSec=15min
RuntimeMaxSec=20min
ProtectSystem=strict
ReadWritePaths=/usr/lib/firmware/facetimehd /run/lock
StateDirectory=facetimehd-firmware-fetcher
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
