# Maintainer: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>

pkgname=omarchy-ane-dkms
_srcname=omarchy-ane
pkgver=0.5.7
pkgrel=1
pkgdesc='Apple Neural Engine kernel modules for Apple Silicon Macs (DKMS, for kernels without the in-tree driver)'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/joshuaswarren/omarchy-ane'
license=('GPL-2.0-only OR MIT')
# omarchy-ane carries the tools, the libalpm hooks and the device-tree overlays; this
# package carries only the module source that dkms builds.
depends=('dkms' 'omarchy-ane>=0.5.6')
checkdepends=('fakeroot' 'linux-aurora-headers')
optdepends=('linux-aurora-headers: build the modules for linux-aurora'
            'linux-asahi-headers: build the modules for linux-asahi')
# ANE_ABI_MAJOR of ane.ko (ane/src/uapi/drm/ane_accel.h). omarchy-mlx depends on
# the ABI, not on a package version.
provides=('omarchy-ane-abi=1')
source=("$_srcname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('304d5768697d0b707da5e24478bd80003eddbe476f5e411be4fcf65f020f18c6')

prepare() {
  # The DKMS source tree: dkms.conf, ane/Makefile, ane/ane_stats_show.c,
  # ane/include/, ane/src/ and ane/t6021/.
  # PACKAGE_VERSION becomes /sys/module/ane/version.
  local src="$_srcname-$pkgver" dst="dkms/$_srcname-$pkgver"
  rm -rf dkms
  install -d "$dst/ane"
  cp -r "$src/dkms.conf" "$dst/"
  cp -r "$src/ane/Makefile" "$src/ane/ane_stats_show.c" "$src/ane/include" \
    "$src/ane/src" "$src/ane/t6021" "$dst/ane/"
  sed -i "s/@PKGVER@/$pkgver/" "$dst/dkms.conf"
}

check() {
  local build=(/usr/lib/modules/*/build)
  local kver=${build[0]%/build}
  kver=${kver##*/}
  rm -rf "$srcdir/check"
  mkdir -p "$srcdir/check/dkms" "$srcdir/check/src"
  local dkms_options=(--dkmstree "$srcdir/check/dkms" --sourcetree "$srcdir/check/src" -k "$kver")
  fakeroot dkms "${dkms_options[@]}" add "$srcdir/dkms/$_srcname-$pkgver"
  local rc=0
  fakeroot dkms "${dkms_options[@]}" build "$_srcname/$pkgver" || rc=$?
  case $rc in
    0) ls "$srcdir/check/dkms/$_srcname/$pkgver/$kver"/*/module/{ane,ane_t6021}.ko* ;;
    77)
      # dkms.conf BUILD_EXCLUSIVE_CONFIG="!CONFIG_DRM_ACCEL_ANE": a kernel that
      # ships the in-tree ANE driver keeps its own modules.
      grep -qs '^CONFIG_DRM_ACCEL_ANE=[ym]' "${build[0]}"/{include/config/auto.conf,.config} ||
        { echo "check: dkms skipped $kver, which has no CONFIG_DRM_ACCEL_ANE" >&2; return 1; }
      echo "check: no DKMS build: $kver ships the in-tree ANE driver (CONFIG_DRM_ACCEL_ANE)" ;;
    *) return "$rc" ;;
  esac
}

package() {
  cd "$_srcname-$pkgver"
  install -d "$pkgdir/usr/src"
  cp -r --no-preserve=ownership "$srcdir/dkms/$_srcname-$pkgver" "$pkgdir/usr/src/"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
