# Maintainer: David Heinemeier Hansson <david@hey.com>

pkgname=omaview
pkgver=0.1.1
pkgrel=1
pkgdesc="Omarchy's picture viewer and media player"
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/omaview'
license=('MIT')
install='omaview.install'
options=('!debug')
depends=(
  'ffmpeg'
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-imageformats'
  'qt6-multimedia'
  'qt6-multimedia-ffmpeg'
  'qt6-svg'
  'qt6-wayland'
  'wayland'
  'wl-clipboard'
  'xdg-desktop-portal'
)
optdepends=(
  'kimageformats: HEIC, AVIF and JPEG XL pictures'
  'cups: printing pictures'
  'wireplumber: volume above 100%'
)
makedepends=('cmake' 'gcc' 'make' 'wayland-protocols')
checkdepends=('python')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('46b18666ac099191daa3c905978a892046d744e563de8f771c8cad26caf39bcf')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/omaview "$pkgdir/usr/bin/omaview"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 share/omaview.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaview.svg"
  install -Dm644 share/omaview.desktop "$pkgdir/usr/share/applications/omaview.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
