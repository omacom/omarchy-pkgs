# Maintainer: Shawn Yeager <shawn@shawnyeager.com>
#
# The Linux download is an AppImage. It bundles WebKitGTK and GStreamer 1.20
# with no audio plugins, and that WebKit aborts in WebKitWebProcess as soon
# as the page asks for autoaudiosink. Omarchy already ships WebKit and
# gst-plugins-good, so this keeps the two program binaries and drops the
# bundled libraries.
#
# Linux is published for x86_64 only. .omarchy/package.json watches
# https://cdn.getmoshi.app/desktop/latest.json and rewrites pkgver below.
#
# The window looks for moshi-hook on PATH and starts `moshi-hook serve`.
# That program updates itself with `moshi-hook update` and is not in this package.

pkgname=moshi-desktop
pkgver=0.4.19
pkgrel=1
pkgdesc="Desktop window for coding agents running in tmux or Herdr"
arch=('x86_64')
url="https://getmoshi.app/desktop"
license=('LicenseRef-proprietary')
depends=(
  'cairo'
  'dbus'
  'gcc-libs'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gst-plugins-good'
  'gtk3'
  'hicolor-icon-theme'
  'libsoup3'
  'webkit2gtk-4.1'
)
makedepends=('7zip')
optdepends=(
  'herdr: local agent workspaces'
  'tmux: local agent workspaces'
)
options=('!debug' '!strip')

_appimage="Moshi_${pkgver}_amd64.AppImage"
source=(
  "https://cdn.getmoshi.app/desktop/v${pkgver}/${_appimage}"
  "moshi-desktop.desktop"
)
noextract=("${_appimage}")
sha256sums=(
  'fa53a72e219e312428fb4dfa6dde9dcc457aeb29a31c39c94279dc0eeaf41f09'
  'd62880ff1a1d110297956dc30fd72ab59712975a8a4344e0edbc8b9dd63521f5'
)

prepare() {
  rm -rf squashfs-root
  7z x "${_appimage}" -osquashfs-root >/dev/null
}

check() {
  local tmp webkit gst missing
  tmp=$(mktemp -d)
  install -Dm755 squashfs-root/usr/bin/moshi-desktop-tauri "${tmp}/bin/moshi-desktop-tauri"

  # The binary's runpath is $ORIGIN/../lib, which is the AppImage's private
  # library directory. Installed under /usr/bin that is /usr/lib. Resolve it
  # away from the extracted tree so a bundled library cannot satisfy the check.
  missing=$(ldd "${tmp}/bin/moshi-desktop-tauri" | awk '/not found/ { print }')
  webkit=$(ldd "${tmp}/bin/moshi-desktop-tauri" | awk '/libwebkit2gtk-4.1.so.0/ { print $3 }')
  gst=$(ldd "${tmp}/bin/moshi-desktop-tauri" | awk '/libgstreamer-1.0.so.0/ { print $3 }')
  rm -rf "$tmp"

  if [[ -n "$missing" || "$webkit" != /usr/lib/libwebkit2gtk-4.1.so.0 || "$gst" != /usr/lib/libgstreamer-1.0.so.0 ]]; then
    echo "moshi-desktop-tauri did not link the system WebKit and GStreamer" >&2
    echo "webkit=${webkit:-missing} gstreamer=${gst:-missing}" >&2
    [[ -n "$missing" ]] && echo "$missing" >&2
    return 1
  fi
}

package() {
  install -Dm755 squashfs-root/usr/bin/moshi-desktop-tauri \
    "${pkgdir}/usr/bin/moshi-desktop-tauri"
  install -Dm755 squashfs-root/usr/bin/moshi-desktop-bridge \
    "${pkgdir}/usr/bin/moshi-desktop-bridge"

  install -Dm644 moshi-desktop.desktop \
    "${pkgdir}/usr/share/applications/moshi-desktop.desktop"

  local icon
  for icon in squashfs-root/usr/share/icons/hicolor/*/apps/moshi-desktop-tauri.png; do
    install -Dm644 "$icon" "${pkgdir}/usr/${icon#squashfs-root/usr/}"
  done
  install -Dm644 squashfs-root/Moshi.png \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/moshi-desktop-tauri.png"

  install -Dm644 /dev/stdin "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" <<EOF
Moshi Desktop is proprietary software.
This package installs the official Linux binaries and does not ship a
license text. Terms: https://getmoshi.app
EOF
}
