# Audio DSP, compute DSP and GPU firmware for the Huawei MateBook E Go. The firmware only runs if
# it is signed for this board by Huawei, so linux-firmware cannot carry it until the OEM submits
# it. The OEM ships it in its Windows driver download, which this recipe unpacks without running.
# Each file is checked against the SHA-256 it was matched to and installed under the name the
# device tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so
# once linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=huawei-matebook-e-go-firmware
pkgver=20261108
pkgrel=1
pkgdesc='Audio DSP, compute DSP and GPU firmware for the Huawei MateBook E Go'
arch=('aarch64')
url='https://www.catalog.update.microsoft.com/ScopedViewInline.aspx?updateid=2e7a8aa3-e328-43de-8667-fc5719d36233'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-sc8280xp-huawei-gaokun3')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'huawei-system-hardware-update-200.0.10.0.zip::https://github.com/matebook-e-go/uup-drivers-sc8280xp/releases/download/200.0.10.0/200.0.10.0.zip'
  'huawei-msupdate-adsp-9.9.9999.1.cab::https://catalog.s.download.windowsupdate.com/c/msdownload/update/driver/drvs/2023/02/4a6acaaa-21bf-4b8c-bb8f-cab21fdc738c_87406e6f2a5d4c945c0ad691cd0ab50f149ea2fe.cab'
)
noextract=('huawei-system-hardware-update-200.0.10.0.zip' 'huawei-msupdate-adsp-9.9.9999.1.cab')
sha256sums=('a1240497f44145c1445110522820c7ad8d4d4995403b399ee6323743f30e67b9' '7670f5dd82474ebf28b7f0d0e064188894e2836208903e304d45c54d3d244308')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'huawei-system-hardware-update-200.0.10.0.zip' 'huawei-system-hardware-update-200.0.10.0' 7z
  _unpack 'huawei-msupdate-adsp-9.9.9999.1.cab' 'huawei-msupdate-adsp-9.9.9999.1' 7z
  _unpack 'huawei-system-hardware-update-200.0.10.0/qcdx8280.cab' 'huawei-system-hardware-update-200.0.10.0/qcdx8280.cab__x' 7z
  _unpack 'huawei-system-hardware-update-200.0.10.0/qcsubsys_ext_cdsp8280.cab' 'huawei-system-hardware-update-200.0.10.0/qcsubsys_ext_cdsp8280.cab__x' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'huawei-msupdate-adsp-9.9.9999.1/qcadsp8280.mbn' "$fw"/'qcom/sc8280xp/HUAWEI/gaokun3/qcadsp8280.mbn'
  install -Dm644 'huawei-system-hardware-update-200.0.10.0/qcsubsys_ext_cdsp8280.cab__x/qccdsp8280.mbn' "$fw"/'qcom/sc8280xp/HUAWEI/gaokun3/qccdsp8280.mbn'
  install -Dm644 'huawei-system-hardware-update-200.0.10.0/qcdx8280.cab__x/qcdxkmsuc8280.mbn' "$fw"/'qcom/sc8280xp/HUAWEI/gaokun3/qcdxkmsuc8280.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
3fd79f085816015d9431b45dd2be983065022866f23cc4c141d321c4b1cf6ec2  qcom/sc8280xp/HUAWEI/gaokun3/qcadsp8280.mbn
5934adcf21028401756f373fb2fc4b74bc56973f3f700c8a68952ef95897cac8  qcom/sc8280xp/HUAWEI/gaokun3/qccdsp8280.mbn
87ffe7e65f4ebeb39bf8372962cc6283e649cc2fcddc10b962a32c661ed3cff5  qcom/sc8280xp/HUAWEI/gaokun3/qcdxkmsuc8280.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +
}
