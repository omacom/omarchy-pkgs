# Maintainer: OmarGonD
pkgname=omarchy-clipboard-keeper
pkgver=0.1.0
pkgrel=1
pkgdesc='Keep the last Wayland clipboard copy in memory after its source closes'
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/omarchy-pkgs'
license=('MIT')
depends=('glibc' 'wayland')
makedepends=('pkgconf' 'wayland-protocols')
source=(
  'keeper.c'
  'test-keeper.c'
  'Makefile'
  'omarchy-clipboard-persist.service'
  'README.md'
  'LICENSE'
)
sha256sums=('22b7d53105b00371c9a0e2b65b9fa844d6469878df2b4fb137772f8d1f1d35bb'
            'f857f3ce96ac71ed5b342c033d2bcb6d0a6f4b4f4f25795a43fdc72d6dd0bb6c'
            'af3c01029957a54fd79e5af1fe109dc9a2d520f9f5145750f3a525f3a9c94033'
            'fdfec8edd88bd64858e91368ef6a7b2b7356ee6326221b11a7bc7dbf62174aa4'
            '70f03a228d0329e152a2e328e2bff4b83f969c9505242f0c2a685573da2d63a8'
            'cc82c91870f305c33389a9e55718dbe740aba6ffb61563bd7a159a573ec8401f')

build() {
  make -C "$srcdir"
}

check() {
  make -C "$srcdir" check
}

package() {
  install -Dm755 "$srcdir/build/omarchy-clipboard-keeper" "$pkgdir/usr/bin/omarchy-clipboard-keeper"
  install -Dm644 "$srcdir/omarchy-clipboard-persist.service" "$pkgdir/usr/lib/systemd/user/omarchy-clipboard-persist.service"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
