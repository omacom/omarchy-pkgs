[Unit]
Description=Keep the last clipboard copy after its source application closes
Documentation=file:/usr/share/doc/omarchy-clipboard-keeper/README.md
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/omarchy-clipboard-keeper
Restart=on-failure
RestartSec=2
TimeoutStopSec=3
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
LimitCORE=0
MemoryMax=192M
TasksMax=8
UMask=0077

[Install]
WantedBy=graphical-session.target
