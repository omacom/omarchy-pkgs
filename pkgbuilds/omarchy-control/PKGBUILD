# Maintainer: Jason Alexander

pkgname=omarchy-control
pkgver=0.3.1
pkgrel=1
pkgdesc='One searchable place to understand this computer, change its settings, and reach the right tool'
arch=('x86_64' 'aarch64')
url='https://github.com/last-refuge/omarchy-control'
license=('MIT' 'OFL-1.1')
options=('!debug')
# curl is run by the updater and qt6-wayland is loaded at start, so namcap cannot see either.
depends=(
  'curl'
  'glibc'
  'hicolor-icon-theme'
  'libarchive'
  'libgcc'
  'libstdc++'
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'qt6-wayland'
)
optdepends=(
  'bluez-utils: Bluetooth settings'
  'networkmanager: network settings'
  'pipewire-pulse: sound settings'
)
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f3bbd628eae4da318d60b7039bb269975eea22a3ad2a5583736c4e719953e0a1')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/omarchy-control "$pkgdir/usr/bin/omarchy-control"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 src/fonts/Inter-LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/Inter-LICENSE.txt"
  install -Dm644 pkgbuild/omarchy-control.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omarchy-control.svg"
  install -Dm644 pkgbuild/omarchy-control-symbolic.svg "$pkgdir/usr/share/icons/hicolor/symbolic/apps/omarchy-control-symbolic.svg"
  install -Dm644 pkgbuild/omarchy-control.desktop "$pkgdir/usr/share/applications/omarchy-control.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
