# Contributor: Helmut Stult <hst[at]e-mail[dot]de>
# Contributor: Felipe Martin <me@fmartingr.com>

pkgname=synology-drive
pkgver=4.2.1_20062
pkgrel=1
_version=${pkgver%_*}
_build=${pkgver#*_}
pkgdesc="Desktop client for Synology Drive Server: sync and back up files with a Synology NAS"
# Synology publishes Linux builds for x86_64 only.
arch=('x86_64')
url="https://www.synology.com/en-global/releaseNote/SynologyDriveClient"
license=('LicenseRef-Synology')
# Qt 5.12, OpenSSL, curl, libarchive, ICU, protobuf and SQLite ship inside the
# client; these are the libraries its binaries load from the system.
depends=(
  'dbus'
  'fontconfig'
  'freetype2'
  'glib2'
  'glibc'
  'hicolor-icon-theme'
  'imagemagick'  # synology-drive-theme-tray
  'libgcc'
  'libice'
  'libsm'
  'libstdc++'
  'libx11'
  'libxcb'
  'libxkbcommon'
  'libxrender'
)
optdepends=('nautilus: sync status overlays and context menu in Files')
conflicts=('synology-drive-client' 'cloudstation-beta' 'cloudstation-3.0' 'cloudstation-drive')
options=('!debug')
source=("synology-drive-theme-tray"
        "synology-drive-theme-tray.path"
        "synology-drive-theme-tray.service")
source_x86_64=("https://global.synologydownload.com/download/Utility/SynologyDriveClient/${_version}-${_build}/Ubuntu/Installer/synology-drive-client-${_build}.x86_64.deb")
sha256sums=('47f0d813cf83af49f77d127cd824f84c7c72b8f47f70b08e196164ed260706ed'
            '8df4a1cef4d88e4e9ca8063103a35d505a489651323001d428e07225ca7920d7'
            'ff24f342dddc258511d87158adf7cebb3824c5f8157a241f5ec0db5204f4bec5')
sha256sums_x86_64=('e0b53bd8e2e666fbf080739ba2f6b93586ac7087f5de4b91bc013e8a2dfc40f5')

package() {
  # The deb's maintainer scripts only migrate Ubuntu-era Cloud Station installs
  # and stop running clients, so they are not carried over.
  bsdtar -xf "$srcdir"/data.tar.xz -C "$pkgdir" \
    --exclude 'usr/lib/x86_64-linux-gnu' \
    --exclude 'usr/lib/nautilus/extensions-3.0' \
    --exclude 'usr/share/doc'

  # Debian's multiarch path duplicates extensions-4; extensions-3.0 is for
  # Nautilus 3. Fail if Synology moves the extension Arch's Nautilus loads.
  test -f "$pkgdir"/usr/lib/nautilus/extensions-4/libnautilus-drive-extension-4.so

  # Tray icon in the theme's bar colour. The helper repaints Synology's
  # dark-panel icon set (win-linux-black) into the copy the client runs from,
  # at login, on theme change and after an upgrade. Fail if Synology drops or
  # renames the icons it reads.
  local _tray="$pkgdir"/opt/Synology/SynologyDrive/package/cloudstation/images/tray
  local _icon
  for _icon in "$_tray"/normal/*.png; do
    test -f "$_tray/win-linux-black/${_icon##*/}"
  done
  install -Dm755 synology-drive-theme-tray -t "$pkgdir"/usr/lib/synology-drive
  install -Dm644 synology-drive-theme-tray.{path,service} -t "$pkgdir"/usr/lib/systemd/user
  # Enabled for every user, like `systemctl --global enable`.
  install -d "$pkgdir"/usr/lib/systemd/user/graphical-session.target.wants
  ln -s ../synology-drive-theme-tray.path "$pkgdir"/usr/lib/systemd/user/graphical-session.target.wants/
  ln -s ../synology-drive-theme-tray.service "$pkgdir"/usr/lib/systemd/user/graphical-session.target.wants/

  install -d "$pkgdir"/usr/share/licenses/$pkgname
  ln -s /opt/Synology/SynologyDrive/LICENSE.txt "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
