[Unit]
Description=Recolour the Synology Drive tray icon when the Omarchy theme changes
PartOf=graphical-session.target

[Path]
# omarchy-theme-set writes this after the new theme is in place.
PathChanged=%h/.local/state/omarchy/current/theme.generation
# The client rewrites its copy of itself, icons included, after an upgrade.
PathChanged=%h/.SynologyDrive/SynologyDrive.app/INFO

[Install]
WantedBy=graphical-session.target
