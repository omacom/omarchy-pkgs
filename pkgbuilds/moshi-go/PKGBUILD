# Maintainer: Shawn Yeager <shawn@shawnyeager.com>
#
# Linux is published for x86_64 only. The update feed is
# https://cdn.getmoshi.app/desktop-go/update-linux-amd64.json and the
# archive is the directory the app runs from: moshi-go, libghostty-vt.so,
# and libmygo-sqlite3.so. GTK and WebKitGTK are loaded at runtime from
# the system.
#
# The desktop entry runs `moshi-go`. /usr/bin/moshi-go points at the real
# binary under /opt/moshi-go, and the two libraries stay beside that path.
# moshi-hook is a separate program. This package does not install it.

pkgname=moshi-go
pkgver=0.5.24
pkgrel=1
pkgdesc="Desktop window for coding agents running in tmux or Herdr"
arch=('x86_64')
url="https://getmoshi.app/desktop"
license=('LicenseRef-proprietary')
depends=(
  'cairo'
  'glibc'
  'gtk3'
  'libepoxy'
  'webkit2gtk-4.1'
)
makedepends=('imagemagick')
optdepends=(
  'herdr: local agent workspaces'
  'tmux: local agent workspaces'
)
replaces=('moshi-desktop')
conflicts=('moshi-desktop')
options=('!debug' '!strip')

source=("https://cdn.getmoshi.app/desktop-go/moshi-go-${pkgver}-linux-amd64.tar.gz")
sha256sums=('186e8ab45f27ee639e10fd82426a56dfd331a9bb7079c5dc44c7f90ebfd052de')

prepare() {
  # hicolor indexes 256 and 512. The published icon is 1024.
  magick moshi-go.png -resize 512x512 moshi-go-512.png
  magick moshi-go.png -resize 256x256 moshi-go-256.png
}

check() {
  local missing exec_line
  missing=$(ldd moshi-go | awk '/not found/ { print }')
  if [[ -n $missing ]]; then
    echo "$missing" >&2
    return 1
  fi
  [[ -f libghostty-vt.so && -f libmygo-sqlite3.so && -f moshi-go.png ]]
  exec_line=$(awk -F= '$1 == "Exec" { print $2; exit }' moshi-go.desktop)
  [[ $exec_line == "moshi-go" || $exec_line == "/opt/moshi-go/moshi-go" ]]
}

package() {
  install -Dm755 moshi-go "${pkgdir}/opt/moshi-go/moshi-go"
  install -Dm755 libghostty-vt.so "${pkgdir}/opt/moshi-go/libghostty-vt.so"
  install -Dm755 libmygo-sqlite3.so "${pkgdir}/opt/moshi-go/libmygo-sqlite3.so"
  install -d "${pkgdir}/usr/bin"
  ln -s /opt/moshi-go/moshi-go "${pkgdir}/usr/bin/moshi-go"

  install -Dm644 moshi-go.desktop \
    "${pkgdir}/usr/share/applications/moshi-go.desktop"
  install -Dm644 moshi-go-512.png \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/moshi-go.png"
  install -Dm644 moshi-go-256.png \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/moshi-go.png"

  install -Dm644 /dev/stdin "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" <<EOF
Moshi Go is proprietary software.
This package installs the official Linux binaries and does not ship a
license text. Terms: https://getmoshi.app
EOF
}
