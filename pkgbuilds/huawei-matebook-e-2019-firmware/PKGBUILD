# Audio DSP, compute DSP, GPU, video, modem and sensor DSP firmware for the Huawei MateBook E
# 2019. The firmware only runs if it is signed for this board by Huawei, so linux-firmware cannot
# carry it until the OEM submits it. The OEM ships it in the driver bundle it publishes for the
# machine on Windows Update, whose cabinets this recipe fetches with wudrivers and unpacks without
# running anything. Each file is checked against the SHA-256 it was matched to and installed under
# the name the device tree requests, compressed with xz. The kernel tries a plain name, then .zst,
# then .xz, so once linux-firmware ships the same file, its copy is the one loaded, and the two
# packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=huawei-matebook-e-2019-firmware
pkgver=20261116
pkgrel=1
pkgdesc='Audio DSP, compute DSP, GPU, video, modem and sensor DSP firmware for the Huawei MateBook E 2019'
arch=('aarch64')
url='https://github.com/birkskyum/wudrivers'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-sdm850-huawei-al09')
makedepends=('7zip' 'wudrivers')
options=('!strip' '!debug')
# Windows Update's links are short-lived, so wudrivers fetches a fresh one by update ID, revision and SHA-1.
DLAGENTS+=('wu::/usr/bin/wudrivers fetch %u -o %o')
source=(
  'huawei-matebook-e-2019-wu-200.0.4.0-qcsubsys850.cab::wu://3bbce7bf-87ca-4480-965b-b0205cec89a9/1/3b032f6f147338e917c615703361e36f4d91c419'
  'huawei-matebook-e-2019-wu-200.0.4.0-qcdx850.cab::wu://3bbce7bf-87ca-4480-965b-b0205cec89a9/1/edc61f1e44bcc04e20fff33d6ebc37d196b3a42b'
  'huawei-matebook-e-2019-wu-200.0.4.0-qcipa850.cab::wu://3bbce7bf-87ca-4480-965b-b0205cec89a9/1/43ea42ded714b480ca1b578df885f8342dd128a9'
)
source+=('README.package.md')
noextract=('huawei-matebook-e-2019-wu-200.0.4.0-qcsubsys850.cab' 'huawei-matebook-e-2019-wu-200.0.4.0-qcdx850.cab' 'huawei-matebook-e-2019-wu-200.0.4.0-qcipa850.cab')
sha256sums=('6de57d307518df6505532b7ea845ea3b5d20f8049110230fff2921e280141676' '9ba61abb3a42865debe4f802ad78513b24bb5803d7dbb1cad02dbc31585136d9' 'e700987849b7212f0c6bbc0e0ea928f2fc118d1a213dba2841e0ca2bc62a61db')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'huawei-matebook-e-2019-wu-200.0.4.0-qcsubsys850.cab' 'huawei-matebook-e-2019-wu-200.0.4.0-qcsubsys850' 7z
  _unpack 'huawei-matebook-e-2019-wu-200.0.4.0-qcdx850.cab' 'huawei-matebook-e-2019-wu-200.0.4.0-qcdx850' 7z
  _unpack 'huawei-matebook-e-2019-wu-200.0.4.0-qcipa850.cab' 'huawei-matebook-e-2019-wu-200.0.4.0-qcipa850' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'huawei-matebook-e-2019-wu-200.0.4.0-qcipa850/ipa_fws.elf' "$fw"/'qcom/sdm850/HUAWEI/AL09/ipa_fws.elf'
  install -Dm644 'huawei-matebook-e-2019-wu-200.0.4.0-qcsubsys850/qcadsp850.mbn' "$fw"/'qcom/sdm850/HUAWEI/AL09/qcadsp850.mbn'
  install -Dm644 'huawei-matebook-e-2019-wu-200.0.4.0-qcsubsys850/qccdsp850.mbn' "$fw"/'qcom/sdm850/HUAWEI/AL09/qccdsp850.mbn'
  install -Dm644 'huawei-matebook-e-2019-wu-200.0.4.0-qcsubsys850/qcdsp1v2850.mbn' "$fw"/'qcom/sdm850/HUAWEI/AL09/qcdsp1v2850.mbn'
  install -Dm644 'huawei-matebook-e-2019-wu-200.0.4.0-qcsubsys850/qcdsp2850.mbn' "$fw"/'qcom/sdm850/HUAWEI/AL09/qcdsp2850.mbn'
  install -Dm644 'huawei-matebook-e-2019-wu-200.0.4.0-qcdx850/qcdxkmsuc850.mbn' "$fw"/'qcom/sdm850/HUAWEI/AL09/qcdxkmsuc850.mbn'
  install -Dm644 'huawei-matebook-e-2019-wu-200.0.4.0-qcsubsys850/qcslpi850.mbn' "$fw"/'qcom/sdm850/HUAWEI/AL09/qcslpi850.mbn'
  install -Dm644 'huawei-matebook-e-2019-wu-200.0.4.0-qcdx850/qcvss850.mbn' "$fw"/'qcom/sdm850/HUAWEI/AL09/qcvss850.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
ae61edebe69cea9a64d9b7080a481fc305f69da265197df180c3cc90aab9d68d  qcom/sdm850/HUAWEI/AL09/ipa_fws.elf
8c7655f9a8c3ae81852894de4cf0a2051bddb4efdc194359366eb5f1a82a2c1f  qcom/sdm850/HUAWEI/AL09/qcadsp850.mbn
989de066b3d7ea1b893c83a8eaf559e90af518f4f95d816ca6b8b92ad36ba18c  qcom/sdm850/HUAWEI/AL09/qccdsp850.mbn
08647b92d864831889cd9f55762c967ddc3d3533bc2e8b32cd04920b8a13bcfa  qcom/sdm850/HUAWEI/AL09/qcdsp1v2850.mbn
08c3d83addcf0a4b05b14e95a17f0ed7c948c2a5633ff742136502ec99c9383b  qcom/sdm850/HUAWEI/AL09/qcdsp2850.mbn
ca1276cf1a66d5207623eeb16c8a17e311cd9f39b24b9db6b43977a0902c3936  qcom/sdm850/HUAWEI/AL09/qcdxkmsuc850.mbn
2a9044178a59dbd71fd88c3f319b119efae72b091bda930d31de8c9c55aa6956  qcom/sdm850/HUAWEI/AL09/qcslpi850.mbn
67e9173754ac4fbfb00df28111706791256c166cd1fab9885bbefa727c506588  qcom/sdm850/HUAWEI/AL09/qcvss850.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
