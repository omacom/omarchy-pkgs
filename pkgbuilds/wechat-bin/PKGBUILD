# Maintainer: The Omarchy Authors

pkgname=wechat-bin
pkgver=4.1.13.26
pkgrel=1
pkgdesc='WeChat (微信) for Linux, the official client from Tencent'
arch=('x86_64' 'aarch64')
url='https://linux.weixin.qq.com/'
license=('LicenseRef-WeChat')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'fontconfig'
  'gcc-libs'
  'glib2'
  'glibc'
  'hicolor-icon-theme'
  'libcups'
  'libglvnd'
  'libice'
  'libpulse'
  'libsm'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'noto-fonts-cjk'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'xcb-util-keysyms'
  'zlib'
)
optdepends=(
  'jack: JACK audio output for voice and video'
  'xdg-desktop-portal-impl: file chooser and screen sharing'
)
options=('!debug' '!strip')
source=('wechat.desktop' 'LICENSE')
# Tencent publishes only the newest build, at a URL that never names a version,
# so the checksum is the pin: once Tencent moves, an old recipe stops building.
source_x86_64=("wechat-${pkgver}-x86_64.deb::https://dldir1v6.qq.com/weixin/Universal/Linux/WeChatLinux_x86_64.deb")
source_aarch64=("wechat-${pkgver}-aarch64.deb::https://dldir1v6.qq.com/weixin/Universal/Linux/WeChatLinux_arm64.deb")
noextract=("wechat-${pkgver}-x86_64.deb" "wechat-${pkgver}-aarch64.deb")
sha256sums=('70a2dfd0fc6322cd9b4e9acd209322c92fca6d9045fe28f6e76cb1ac674fceda'
            '58b8e9f8f879c04ae252e106499a3e7515ddb1d29cf19de31a2ca3e9d90d82e8')
sha256sums_x86_64=('a0db8caeee8d1e6cfe0aa5ce58710270f8d74a90ff4920f53a3fc22aa0956fe9')
sha256sums_aarch64=('374732eda88a6f3a7e4eb315e64e5fac73ef17923d504d242964f19ed1b80c75')

prepare() {
  local deb="wechat-${pkgver}-${CARCH}.deb" version
  rm -rf wechat
  mkdir wechat

  # The upstream watch reads the version from the x86_64 build alone, so make
  # sure the archive for this architecture is the release the recipe names.
  version=$(bsdtar -xOf "$deb" 'control.tar.*' | bsdtar -xOf - ./control |
    sed -n 's/^Version: //p')
  if [[ $version != "$pkgver" ]]; then
    error "$deb is WeChat $version, but pkgver is $pkgver."
    return 1
  fi

  bsdtar -xOf "$deb" 'data.tar.*' | bsdtar -C wechat -xf -
}

package() {
  install -d "$pkgdir/opt"
  cp -a --no-preserve=ownership wechat/opt/wechat "$pkgdir/opt/wechat"
  # Nothing in WeChat needs privilege; a future build that asks for it gets none.
  chmod -R go-w,ug-s "$pkgdir/opt/wechat"

  install -d "$pkgdir/usr/bin"
  ln -s /opt/wechat/wechat "$pkgdir/usr/bin/wechat"
  install -Dm644 wechat.desktop "$pkgdir/usr/share/applications/wechat.desktop"

  # The vendor's hidden entry names the mini-program runtime's window; keep it.
  install -m644 wechat/usr/share/applications/com.tencent.wechatappex.desktop \
    "$pkgdir/usr/share/applications/"
  cp -a --no-preserve=ownership wechat/usr/share/icons "$pkgdir/usr/share/"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
