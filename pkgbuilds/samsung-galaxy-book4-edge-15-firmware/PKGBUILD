# Audio DSP, compute DSP, GPU and video firmware for the Samsung Galaxy Book4 Edge 15. The
# firmware only runs if it is signed for this board by Samsung, so linux-firmware cannot carry it
# until the OEM submits it. The OEM ships it in its Windows driver download, which this recipe
# unpacks without running. Each file is checked against the SHA-256 it was matched to and
# installed under the name the device tree requests, compressed with xz. The kernel tries a plain
# name, then .zst, then .xz, so once linux-firmware ships the same file, its copy is the one
# loaded, and the two packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=samsung-galaxy-book4-edge-15-firmware
pkgver=20261108
pkgrel=2
pkgdesc='Audio DSP, compute DSP, GPU and video firmware for the Samsung Galaxy Book4 Edge 15'
arch=('aarch64')
url='https://downloadcenter.samsung.com/content/DR/202507/20250721081640119/BASW-A4325A01_1063.zip'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1p42100-samsung-galaxy-book4-edge')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'samsung-basw-a4325a01-1063.zip::https://downloadcenter.samsung.com/content/DR/202507/20250721081640119/BASW-A4325A01_1063.zip'
)
noextract=('samsung-basw-a4325a01-1063.zip')
sha256sums=('04b1d92deacf4ff7848224c7f3d5061618678d19c585ccb47786e672a719a843')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'samsung-basw-a4325a01-1063.zip' 'samsung-basw-a4325a01-1063' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'samsung-basw-a4325a01-1063/Chipset/qcsubsys_ext_adsp_ss8380_NX15SE/adsp_dtbs.elf' "$fw"/'qcom/x1p42100/SAMSUNG/galaxy-book4-edge/adsp_dtbs.elf'
  install -Dm644 'samsung-basw-a4325a01-1063/Chipset/qcsubsys_ext_adsp_ss8380_NX15SE/adspr.jsn' "$fw"/'qcom/x1p42100/SAMSUNG/galaxy-book4-edge/adspr.jsn'
  install -Dm644 'samsung-basw-a4325a01-1063/Chipset/qcsubsys_ext_adsp_ss8380_NX15SE/adsps.jsn' "$fw"/'qcom/x1p42100/SAMSUNG/galaxy-book4-edge/adsps.jsn'
  install -Dm644 'samsung-basw-a4325a01-1063/Chipset/qcsubsys_ext_adsp_ss8380_NX15SE/adspua.jsn' "$fw"/'qcom/x1p42100/SAMSUNG/galaxy-book4-edge/adspua.jsn'
  install -Dm644 'samsung-basw-a4325a01-1063/Chipset/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1p42100/SAMSUNG/galaxy-book4-edge/cdsp_dtbs.elf'
  install -Dm644 'samsung-basw-a4325a01-1063/Chipset/qcnspmcdm_ext_cdsp8380/cdspr.jsn' "$fw"/'qcom/x1p42100/SAMSUNG/galaxy-book4-edge/cdspr.jsn'
  install -Dm644 'samsung-basw-a4325a01-1063/Chipset/qcsubsys_ext_adsp_ss8380_NX15SE/qcadsp8380.mbn' "$fw"/'qcom/x1p42100/SAMSUNG/galaxy-book4-edge/qcadsp8380.mbn'
  install -Dm644 'samsung-basw-a4325a01-1063/Chipset/qcnspmcdm_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1p42100/SAMSUNG/galaxy-book4-edge/qccdsp8380.mbn'
  install -Dm644 'samsung-basw-a4325a01-1063/Graphics/qcdx8380_ss_se/qcdxkmsucpurwa.mbn' "$fw"/'qcom/x1p42100/SAMSUNG/galaxy-book4-edge/qcdxkmsucpurwa.mbn'
  install -Dm644 'samsung-basw-a4325a01-1063/Graphics/qcdx8380_ss_se/qcvss8380.mbn' "$fw"/'qcom/x1p42100/SAMSUNG/galaxy-book4-edge/qcvss8380.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
4384c2debe4fa3c4075df433642405cfc76123dc1d1d2b32274a6ebec45765bb  qcom/x1p42100/SAMSUNG/galaxy-book4-edge/adsp_dtbs.elf
e9ba7199626b0c03f2ec02822d744f678ad567fe0625a28fe5f5908b7281e9db  qcom/x1p42100/SAMSUNG/galaxy-book4-edge/adspr.jsn
19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e  qcom/x1p42100/SAMSUNG/galaxy-book4-edge/adsps.jsn
d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d  qcom/x1p42100/SAMSUNG/galaxy-book4-edge/adspua.jsn
2a5584ca2fc7d476407d045f38335730c54297fe1d37097356d6c7e5270063f2  qcom/x1p42100/SAMSUNG/galaxy-book4-edge/cdsp_dtbs.elf
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x1p42100/SAMSUNG/galaxy-book4-edge/cdspr.jsn
d9477c06da25b770d88ebd04a2d46416a5ecd7bd56576e9df65e544f99715ff0  qcom/x1p42100/SAMSUNG/galaxy-book4-edge/qcadsp8380.mbn
3095d8864934238f4d31d5a6a097c97fbf9fe61638a7ad374c97654318381bbd  qcom/x1p42100/SAMSUNG/galaxy-book4-edge/qccdsp8380.mbn
b2823a89d077bcd78150d06e97cc5ab61cfbbbb3c9577111ad589509acc8bca6  qcom/x1p42100/SAMSUNG/galaxy-book4-edge/qcdxkmsucpurwa.mbn
7cab108350d6cb7212e8aa59c7306b734bf3ba06b25db02e4cfa65b0fc92078e  qcom/x1p42100/SAMSUNG/galaxy-book4-edge/qcvss8380.mbn
