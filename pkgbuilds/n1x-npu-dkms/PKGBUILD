pkgname=n1x-npu-dkms
pkgver=0.1.0.r92e9434
pkgrel=1
pkgdesc='Opt-in NVIDIA N1X DLA and SROOT kernel provider'
arch=('aarch64')
url='https://github.com/johannhartmann/n1x-npu-linux'
license=('GPL-2.0-only' 'MIT')
depends=('dkms' 'kmod' 'python' 'systemd')
makedepends=('git')
optdepends=('n1x-npu-firmware-local: prepare local OEM SROOT images' 'n1x-npu-runtime: native ONNX inference tools')
_commit=92e9434a65d2b9d3bb0517efb9efc371e9c6b42c
source=("n1x-npu::git+https://github.com/johannhartmann/n1x-npu-linux.git#commit=${_commit}"
        '0001-explicit-opt-in-and-early-dma-gate.patch'
        '0002-dma-mmap-image-offset.patch'
        'dkms.conf'
        'n1x-npu-control'
        'n1x-npu.service'
        'n1x-npu.conf'
        '99-n1x-npu.rules'
)
sha256sums=('SKIP'
            'c17eb6bbf573de94c4fcfc0a9f23e158771bd0668f83f23ab9603913c86f68fe'
            'a750e542bdff7df5c609fa4cf16f81675db9abd036b0d1b454e827649843ad1c'
            '50a43a1dd870d33d067c0c205f5af2ec35b4e6d17b5c11bfd9d4aafb422df913'
            'fbd26e5665e0e9159b80107acbc039b4431599ca0d1afe96a34a7db7f8dbbd35'
            '30515b34be72c087bd306a1a6571417a870e22c85d46e9d18cd6a3b139fb8c54'
            'd27dfbc243b7f5ef7de33ec8d339557a7e5f3543c383b59ab2ec910683a06b0a'
            '73cff784d2f590eaddbb0ad58fa684a99086719c5e8c6e4da00f8fc0aad87d1c')
prepare() {
  cd "$srcdir/n1x-npu"
  patch -Np1 -i "$srcdir/0001-explicit-opt-in-and-early-dma-gate.patch"
  patch -Np1 -i "$srcdir/0002-dma-mmap-image-offset.patch"
}
check() {
  cd "$srcdir/n1x-npu"
  for test in test_linux_bootstrap_guards test_linux_boot_delay test_linux_bootstrap_ping \
      test_linux_hfrp_state test_linux_config_snapshot test_linux_config_apply \
      test_linux_bypass_task test_linux_fence_order test_linux_shutdown \
      test_linux_binding test_shutdown_transport test_sroot_dsp_broker; do
    python "scripts/$test.py"
  done
}
package() {
  local target="$pkgdir/usr/src/n1x-npu-$pkgver"
  install -dm755 "$target"
  cp -a "$srcdir/n1x-npu/driver" "$srcdir/n1x-npu/include" "$target/"
  install -m644 "$srcdir/dkms.conf" "$target/dkms.conf"
  install -Dm755 "$srcdir/n1x-npu-control" "$pkgdir/usr/lib/n1x-npu/control"
  install -Dm644 "$srcdir/n1x-npu.service" "$pkgdir/usr/lib/systemd/system/n1x-npu.service"
  install -Dm644 "$srcdir/n1x-npu.conf" "$pkgdir/usr/lib/modprobe.d/n1x-npu.conf"
  install -Dm644 "$srcdir/99-n1x-npu.rules" "$pkgdir/usr/lib/udev/rules.d/99-n1x-npu.rules"
  install -Dm644 "$srcdir/n1x-npu/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 "$srcdir/n1x-npu/LICENSING.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSING.md"
  install -Dm644 "$startdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
