pkgname=n1x-npu-dkms
pkgver=0.1.0.r92e9434
pkgrel=3
pkgdesc='Opt-in NVIDIA N1X DLA and SROOT kernel provider'
arch=('aarch64')
url='https://github.com/johannhartmann/n1x-npu-linux'
license=('GPL-2.0-only' 'MIT')
depends=('dkms' 'kmod' 'python' 'systemd')
makedepends=('git')
optdepends=('n1x-npu-firmware-local: prepare local OEM SROOT images' 'n1x-npu-runtime: native ONNX inference tools')
_commit=92e9434a65d2b9d3bb0517efb9efc371e9c6b42c
source=("n1x-npu::git+https://github.com/johannhartmann/n1x-npu-linux.git#commit=${_commit}"
        '0001-explicit-opt-in-and-early-dma-gate.patch'
        '0002-dma-mmap-image-offset.patch'
        'dkms.conf'
        'n1x-npu-control'
        'n1x-npu.service'
        'n1x-npu.conf'
        '99-n1x-npu.rules'
        'README.md'
        'test_opt_in.py'
        'test_packaged_accel.py'
        'test_dma_mmap.py'
        'kernel-mmap-fixture.json'
)
