prepare() {
  cd "$srcdir/n1x-npu"
  patch -Np1 -i "$srcdir/0001-explicit-opt-in-and-early-dma-gate.patch"
  patch -Np1 -i "$srcdir/0002-dma-mmap-image-offset.patch"
}
check() {
  export N1X_SOURCE_ROOT="$srcdir/n1x-npu"
  python "$srcdir/test_opt_in.py"
  python "$srcdir/test_packaged_accel.py"
  python "$srcdir/test_dma_mmap.py" --fixture "$srcdir/kernel-mmap-fixture.json"
  cd "$srcdir/n1x-npu"
  for test in test_linux_bootstrap_guards test_linux_boot_delay test_linux_bootstrap_ping \
      test_linux_hfrp_state test_linux_config_snapshot test_linux_config_apply \
      test_linux_bypass_task test_linux_fence_order test_linux_shutdown \
      test_linux_binding test_shutdown_transport test_sroot_dsp_broker; do
    python "scripts/$test.py"
  done
}
package() {
  local target="$pkgdir/usr/src/n1x-npu-$pkgver"
  install -dm755 "$target"
  # Copy source inputs only, even after a local module validation build.
  local file
  while IFS= read -r -d '' file; do
    install -Dm644 "$srcdir/n1x-npu/$file" "$target/$file"
  done < <(cd "$srcdir/n1x-npu" && find driver include -type f \( -name '*.c' -o -name '*.h' -o -name Kbuild \) -print0)
  install -m644 "$srcdir/dkms.conf" "$target/dkms.conf"
  install -Dm755 "$srcdir/n1x-npu-control" "$pkgdir/usr/lib/n1x-npu/control"
  install -Dm644 "$srcdir/n1x-npu.service" "$pkgdir/usr/lib/systemd/system/n1x-npu.service"
  install -Dm644 "$srcdir/n1x-npu.conf" "$pkgdir/usr/lib/modprobe.d/n1x-npu.conf"
  install -Dm644 "$srcdir/99-n1x-npu.rules" "$pkgdir/usr/lib/udev/rules.d/99-n1x-npu.rules"
  install -Dm644 "$srcdir/n1x-npu/LICENSES/MIT.txt" "$pkgdir/usr/share/licenses/$pkgname/MIT.txt"
  install -Dm644 "$srcdir/n1x-npu/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 "$srcdir/n1x-npu/LICENSING.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSING.md"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
