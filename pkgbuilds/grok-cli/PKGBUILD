# Maintainer: The Omarchy Authors
pkgname=grok-cli
pkgver=1.0.92
pkgrel=1
pkgdesc="Grok Build, xAI's terminal coding agent"
arch=('x86_64' 'aarch64')
url="https://x.ai/build"
license=('Apache-2.0')
# The AUR packages of the same CLI also install /usr/bin/grok.
conflicts=('grok-build' 'grok-build-bin' 'grok-build-git')
options=('!strip' '!debug')
# xAI's own installer downloads these statically linked builds from the same bucket.
_dl="https://storage.googleapis.com/grok-build-public-artifacts/cli/grok-${pkgver}-linux"
source=('LICENSE')
source_x86_64=("grok-${pkgver}-x86_64::${_dl}-x86_64")
source_aarch64=("grok-${pkgver}-aarch64::${_dl}-aarch64")
sha256sums=('116f7778b9802e569b7fa3a532b17bd80eb13c67837def01eed093d4ea472f28')
sha256sums_x86_64=('add4d201dbf2c0bd6077a36feb55a76939de30bae48dbb06f16b2307d38ceacb')
sha256sums_aarch64=('8c74f1dc6cdc1befff6b9faada06bec4cf6759d04f2a60cdc28ece5ff696b44f')

package() {
  install -Dm755 "${srcdir}/grok-${pkgver}-${CARCH}" "${pkgdir}/usr/lib/grok-cli/grok"
  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # pacman updates this install, so Grok's own updater must not replace it.
  install -dm755 "${pkgdir}/usr/bin"
  cat >"${pkgdir}/usr/bin/grok" <<'WRAPPER'
#!/bin/sh
export GROK_DISABLE_AUTOUPDATER=1
exec /usr/lib/grok-cli/grok "$@"
WRAPPER
  chmod 755 "${pkgdir}/usr/bin/grok"
}
