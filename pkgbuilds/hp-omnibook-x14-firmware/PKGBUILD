  install -Dm644 'hp-sp171529/src/Driver/1qcnspmcdm_ext_cdsp8380_8700/cdsp_dtbs.elf' "$fw"/'qcom/x1p42100/hp/omnibook-x14/cdsp_dtbs.elf'
