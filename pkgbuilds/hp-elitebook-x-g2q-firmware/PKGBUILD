# Maintainer: Birk Skyum <birk.skyum@pm.me>
#
# Audio DSP and compute DSP firmware for the HP EliteBook X G2q. The firmware only runs if it is
# signed for this board by HP, so linux-firmware cannot carry it until the OEM submits it. The OEM
# ships it in its Windows driver download, which this recipe unpacks without running. The files
# are installed unmodified, under the names the device tree requests, and checked against the
# SHA-256 each was matched to.
#
# The board's own firmware starts the SoC control processor before Linux, so its images are not
# installed, and provided.d tells qcom-firmware-extract not to look for them.
#
# Generated from https://arewearmyet.com/firmware-sources.json by bin/snapdragon-firmware-recipes;
# change the table, not this file.

pkgname=hp-elitebook-x-g2q-firmware
pkgver=20261102
pkgrel=1
pkgdesc='Audio DSP and compute DSP firmware for the HP EliteBook X G2q'
arch=('aarch64')
url='https://ftp.hp.com/pub/softpaq/sp174501-175000/sp174694.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-glymur-hp-elitebook-x-g2q')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'hp-sp174694.exe::https://ftp.hp.com/pub/softpaq/sp174501-175000/sp174694.exe'
)
source+=('hp,elitebook-x-g2q.list')
noextract=('hp-sp174694.exe')
sha256sums=('bfbfd3321339f663ee56977917646265262ef9c5468d5f292ee679b1e2d28b2d')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'hp-sp174694.exe' 'hp-sp174694' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'hp-sp174694/src/driver/regrouped_driver/qcsubsys_ext_adsp8480/adsp_dtbs.elf' "$fw"/'qcom/glymur/hp/elitebook-x-g2q/adsp_dtbs.elf'
  install -Dm644 'hp-sp174694/src/driver/regrouped_driver/qcsubsys_ext_adsp8480/adspr.jsn' "$fw"/'qcom/glymur/hp/elitebook-x-g2q/adspr.jsn'
  install -Dm644 'hp-sp174694/src/driver/regrouped_driver/qcsubsys_ext_adsp8480/adsps.jsn' "$fw"/'qcom/glymur/hp/elitebook-x-g2q/adsps.jsn'
  install -Dm644 'hp-sp174694/src/driver/regrouped_driver/qcsubsys_ext_adsp8480/adspua.jsn' "$fw"/'qcom/glymur/hp/elitebook-x-g2q/adspua.jsn'
  install -Dm644 'hp-sp174694/src/driver/regrouped_driver/qcnspmcdm8480/cdsp_dtbs.elf' "$fw"/'qcom/glymur/hp/elitebook-x-g2q/cdsp_dtbs.elf'
  install -Dm644 'hp-sp174694/src/driver/regrouped_driver/qcsubsys_ext_adsp8480/qcadsp8480.mbn' "$fw"/'qcom/glymur/hp/elitebook-x-g2q/qcadsp8480.mbn'
  install -Dm644 'hp-sp174694/src/driver/regrouped_driver/qcnspmcdm8480/qccdsp8480.mbn' "$fw"/'qcom/glymur/hp/elitebook-x-g2q/qccdsp8480.mbn'
  install -Dm644 'hp-sp174694/src/driver/regrouped_driver/qcsubsys_ext_soccp8480/soccpr.jsn' "$fw"/'qcom/glymur/hp/elitebook-x-g2q/soccpr.jsn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
