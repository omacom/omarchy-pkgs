66ce8531efb7979d234e0f0eabbe18d038ac97da771a8a194f613df8f0724e81  qcom/glymur/hp/elitebook-x-g2q/adspr.jsn
12ac2f3ae8ced12aa4b06b3ab3a01bc4d8efe1c92ebea503c002f209a6ec176f  qcom/glymur/hp/elitebook-x-g2q/adsps.jsn
982a99853495e34726b8e44697fdfad303334de0a67cbf6cde306c8f1731000b  qcom/glymur/hp/elitebook-x-g2q/adspua.jsn
0de06fca0ce8778beaae9122bc40ebf8c4e3a6b241be47e8e89725dac87cdc64  qcom/glymur/hp/elitebook-x-g2q/cdsp_dtbs.elf
b32480d27477005210226aac08300d528115807a8c4bc62f9f94e017d57d3ee1  qcom/glymur/hp/elitebook-x-g2q/qcadsp8480.mbn
0685ab4a9d319ca2d306e4be6c95208b76d180d98a412b866a46b925dd72ec86  qcom/glymur/hp/elitebook-x-g2q/qccdsp8480.mbn
e6b053e996f2d6b933f41bd6dffe4a5ba3c09ec594675febee04c944b3780d6a  qcom/glymur/hp/elitebook-x-g2q/soccpr.jsn
