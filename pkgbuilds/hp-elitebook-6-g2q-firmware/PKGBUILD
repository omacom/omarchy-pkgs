# Audio DSP and compute DSP firmware for the HP EliteBook 6 G2q. The firmware only runs if it is
# signed for this board by HP, so linux-firmware cannot carry it until the OEM submits it. The OEM
# ships it in its Windows driver download, which this recipe unpacks without running. Each file is
# checked against the SHA-256 it was matched to and installed under the name the device tree
# requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so once
# linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=hp-elitebook-6-g2q-firmware
pkgver=20261114
pkgrel=1
pkgdesc='Audio DSP and compute DSP firmware for the HP EliteBook 6 G2q'
arch=('aarch64')
url='https://ftp.hp.com/pub/softpaq/sp174501-175000/sp174817.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-glymur-hp-elitebook-6-g2q')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'hp-sp174817.exe::https://ftp.hp.com/pub/softpaq/sp174501-175000/sp174817.exe'
)
source+=('README.package.md')
noextract=('hp-sp174817.exe')
sha256sums=('618091167b61fb9773a81c91dc4ea93ba0837b3cd2ad0ad81263abb529a60bea')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'hp-sp174817.exe' 'hp-sp174817' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'hp-sp174817/src/driver/regrouped_driver/qcsubsys_ext_adsp8480/adsp_dtbs.elf' "$fw"/'qcom/glymur/hp/elitebook-6-g2q/adsp_dtbs.elf'
  install -Dm644 'hp-sp174817/src/driver/regrouped_driver/qcsubsys_ext_adsp8480/adspr.jsn' "$fw"/'qcom/glymur/hp/elitebook-6-g2q/adspr.jsn'
  install -Dm644 'hp-sp174817/src/driver/regrouped_driver/qcsubsys_ext_adsp8480/adsps.jsn' "$fw"/'qcom/glymur/hp/elitebook-6-g2q/adsps.jsn'
  install -Dm644 'hp-sp174817/src/driver/regrouped_driver/qcsubsys_ext_adsp8480/adspua.jsn' "$fw"/'qcom/glymur/hp/elitebook-6-g2q/adspua.jsn'
  install -Dm644 'hp-sp174817/src/driver/regrouped_driver/qcnspmcdm8480/cdsp_dtbs.elf' "$fw"/'qcom/glymur/hp/elitebook-6-g2q/cdsp_dtbs.elf'
  install -Dm644 'hp-sp174817/src/driver/regrouped_driver/qcsubsys_ext_adsp8480/qcadsp8480.mbn' "$fw"/'qcom/glymur/hp/elitebook-6-g2q/qcadsp8480.mbn'
  install -Dm644 'hp-sp174817/src/driver/regrouped_driver/qcnspmcdm8480/qccdsp8480.mbn' "$fw"/'qcom/glymur/hp/elitebook-6-g2q/qccdsp8480.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
00bf5b3216feeb47b2a9be06b86190ff1da16b28f80be710968c379341a7fbac  qcom/glymur/hp/elitebook-6-g2q/adsp_dtbs.elf
66ce8531efb7979d234e0f0eabbe18d038ac97da771a8a194f613df8f0724e81  qcom/glymur/hp/elitebook-6-g2q/adspr.jsn
12ac2f3ae8ced12aa4b06b3ab3a01bc4d8efe1c92ebea503c002f209a6ec176f  qcom/glymur/hp/elitebook-6-g2q/adsps.jsn
982a99853495e34726b8e44697fdfad303334de0a67cbf6cde306c8f1731000b  qcom/glymur/hp/elitebook-6-g2q/adspua.jsn
a10da41b26547dd88f9287f66cf92cd8ba17cc1dce5eeff4d46621c3ae2258c2  qcom/glymur/hp/elitebook-6-g2q/cdsp_dtbs.elf
75ecf1c174a62d116a9e510083cecca817d93a5cb24dc229110dc2ace74d5501  qcom/glymur/hp/elitebook-6-g2q/qcadsp8480.mbn
fae8fb92104ce23839ec384eea83c01be7fe92d0b7d5329b9a200b9b3ab83986  qcom/glymur/hp/elitebook-6-g2q/qccdsp8480.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
