# Maintainer: Marcelo Alcantara <marcelo@omarchy.org>
# Touch ID re-arm for the aurora kernel's Secure Enclave driver. From 7.3,
# five failed matches lock Touch ID, the lock survives a restart, and only
# SEP_BIO_REARM after a verified password ends it. After sudo or polkit
# accepts a password, pam_aurora_touchid hands it to a root helper, which
# checks it again through its own PAM service and re-arms Touch ID.
# omarchy-mac adds the module to those stacks once the owner turns Touch ID on.
#
# From aurora-silicon/aurora-sep-userspace touchid-rearm/, with two changes:
# the socket and the helper take root callers only (root-callers-only.patch,
# aurora-touchid-rearm.socket), and the boot unit and its touchid.conf aren't
# shipped, so Touch ID works from the first login after boot, as on 7.2.
pkgname=aurora-touchid-rearm
# The pinned commit's UTC date.
pkgver=20261120
pkgrel=1
pkgdesc='Re-arms Touch ID on Apple Silicon after a password authentication'
arch=('aarch64')
url='https://github.com/aurora-silicon/aurora-sep-userspace'
license=('GPL-2.0-only')
depends=('pam' 'systemd')
makedepends=('git')
checkdepends=('python')
install=aurora-touchid-rearm.install
_commit=c889b449c2b79b4722b30f34f0fa90d5118b2900
source=("aurora-sep-userspace::git+$url.git#commit=$_commit"
        root-callers-only.patch
        aurora-touchid-rearm.socket)
sha256sums=('SKIP'
            '8cd28f2c1b87066686f1d5610a8db55cda0e59ce8eaa9edc4b82d534296c183d'
            '6fe1a426a602edcb2c8b884262186a9f2c8feb39e1ac198f69be662be8e462b1')

prepare() {
  [[ $(git -C aurora-sep-userspace rev-parse HEAD) == "$_commit" ]]
  cd aurora-sep-userspace
  patch -p1 < "$srcdir/root-callers-only.patch"
  cp "$srcdir/aurora-touchid-rearm.socket" touchid-rearm/aurora-touchid-rearm.socket
  # Arch keeps private helpers under /usr/lib, not /usr/libexec.
  sed -i 's|^ExecStart=/usr/libexec/aurora-touchid-rearm$|ExecStart=/usr/lib/aurora-touchid-rearm/aurora-touchid-rearm|' \
    touchid-rearm/aurora-touchid-rearm@.service
  grep -qx 'ExecStart=/usr/lib/aurora-touchid-rearm/aurora-touchid-rearm' touchid-rearm/aurora-touchid-rearm@.service
}

build() {
  # CFLAGS and LDFLAGS come from makepkg's environment, so the Makefile's
  # own += still applies; WARN drops -Werror for distribution builds.
  make -C aurora-sep-userspace/touchid-rearm WARN='-Wall -Wextra'
}

check() {
  make -C aurora-sep-userspace/touchid-rearm WARN='-Wall -Wextra' check
}

package() {
  make -C aurora-sep-userspace/touchid-rearm install DESTDIR="$pkgdir" \
    LIBEXECDIR=/usr/lib/aurora-touchid-rearm PAMDIR=/usr/lib/security PAMCONFDIR=/usr/lib/pam.d
  rm "$pkgdir/usr/lib/systemd/system/aurora-touchid-boot.service" "$pkgdir/etc/aurora/touchid.conf"
  rmdir "$pkgdir/etc/aurora" "$pkgdir/etc"
  install -d "$pkgdir/usr/lib/systemd/system/sockets.target.wants"
  ln -s ../aurora-touchid-rearm.socket "$pkgdir/usr/lib/systemd/system/sockets.target.wants/aurora-touchid-rearm.socket"
  install -Dm644 aurora-sep-userspace/LICENSES/GPL-2.0-only.txt "$pkgdir/usr/share/licenses/$pkgname/GPL-2.0-only.txt"
}
