_aurora_touchid_rearm_start_socket() {
  # sockets.target pulls the socket in from the next boot; start it now so a
  # Touch ID lockout can be re-armed in this session.
  [[ -d /run/systemd/system ]] || return 0
  systemctl daemon-reload 2>/dev/null || true
  systemctl start aurora-touchid-rearm.socket 2>/dev/null || true
}

post_install() {
  _aurora_touchid_rearm_start_socket
}

post_upgrade() {
  _aurora_touchid_rearm_start_socket
}
