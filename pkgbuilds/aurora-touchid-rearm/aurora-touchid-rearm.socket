# SPDX-License-Identifier: GPL-2.0-only
# aurora-sep-userspace's socket, root-only: pam_aurora_touchid connects from
# sudo and polkit, which run PAM as root. A lock screen running PAM as the
# user can't reach it, so a user's programs can't test passwords here.
[Unit]
Description=Touch ID re-arm after a password authentication
Documentation=file:///usr/share/doc/aurora-touchid-rearm/README.md

[Socket]
ListenStream=/run/aurora-touchid-rearm.sock
SocketUser=root
SocketGroup=root
SocketMode=0600
Accept=yes
MaxConnections=8

[Install]
WantedBy=sockets.target
