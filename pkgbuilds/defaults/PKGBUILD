# Maintainer: auzz <https://github.com/Auzzpiciouzz>

pkgname=defaults
pkgver=0.1.0
pkgrel=1
pkgdesc='Choose which app opens each kind of file on Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/Auzzpiciouzz/defaults'
license=('MIT')
install='defaults.install'
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'qt6-base>=6.9'
  'qt6-declarative>=6.9'
  'qt6-svg'
  'qt6-wayland'
  'shared-mime-info'
)
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b6e9da39e9c677083a52bf711efdf52f10c0ad27fb38f3c672091af1197f297c')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/defaults "$pkgdir/usr/bin/defaults"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/defaults.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/defaults.svg"
  install -Dm644 pkgbuild/defaults.desktop "$pkgdir/usr/share/applications/defaults.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
