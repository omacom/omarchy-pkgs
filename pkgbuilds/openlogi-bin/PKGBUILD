pkgname=openlogi-bin
pkgver=0.9.0
pkgrel=1
pkgdesc='Native Logitech Options+ alternative for mice, keyboards, and webcams'
arch=('x86_64' 'aarch64')
url='https://github.com/AprilNEA/OpenLogi'
license=('Apache-2.0 OR MIT')
depends=('dbus' 'fontconfig' 'gcc-libs' 'glibc' 'libglvnd' 'libxcb'
         'libxkbcommon' 'libxkbcommon-x11' 'vulkan-icd-loader' 'wayland')
provides=("openlogi=$pkgver")
conflicts=('openlogi')
options=('!strip' '!debug')
source_x86_64=("$pkgname-$pkgver-x86_64.pkg.tar.zst::$url/releases/download/v$pkgver/openlogi-v$pkgver-linux-amd64.pkg.tar.zst")
source_aarch64=("$pkgname-$pkgver-aarch64.pkg.tar.zst::$url/releases/download/v$pkgver/openlogi-v$pkgver-linux-arm64.pkg.tar.zst")
noextract=("$pkgname-$pkgver-x86_64.pkg.tar.zst" "$pkgname-$pkgver-aarch64.pkg.tar.zst")
sha256sums_x86_64=('ba428a1d8043e7ef82c9576e9fa1d37c31be781cca304e59d655af4a0ab045d4')
sha256sums_aarch64=('972a3dd218e268c093784ad365881f87faac61eb28d76303944a21b7f2a70d80')

package() {
  local archive="$srcdir/$pkgname-$pkgver-$CARCH.pkg.tar.zst"
  bsdtar --no-same-owner -xf "$archive" -C "$pkgdir" usr
  install -d "$pkgdir/usr/lib/udev/rules.d"
  bsdtar -xOf "$archive" etc/udev/rules.d/70-openlogi.rules > "$pkgdir/usr/lib/udev/rules.d/70-openlogi.rules"
}
