pkgname=metrolist
pkgver=14.0.1
pkgrel=1
pkgdesc='YouTube Music desktop client with Omarchy support'
arch=('x86_64' 'aarch64')
url='https://github.com/MetrolistGroup/Metrolist'
license=('GPL-3.0-only')
validpgpkeys=('3B04D753C9050D9A5D343F39843C48A565F8F04B')
depends=('alsa-lib' 'dbus' 'fontconfig' 'gtk3' 'hicolor-icon-theme' 'libglvnd'
         'libsecret' 'libxi' 'libxrender' 'libxtst' 'webkit2gtk-4.1')
makedepends=('git')
conflicts=('metrolist-desktop-bin' 'metrolist-git')
options=('!strip' '!debug')
_jdkver=25.0.5
_jdkbuild=8
_jdkurl="https://github.com/adoptium/temurin25-binaries/releases/download/jdk-${_jdkver}%2B${_jdkbuild}"
source=("$pkgname::git+$url.git#tag=v$pkgver"
        'remove-omarchy-startup-check.patch')
source_x86_64=("$_jdkurl/OpenJDK25U-jdk_x64_linux_hotspot_${_jdkver}_${_jdkbuild}.tar.gz"
                "$_jdkurl/OpenJDK25U-jdk_x64_linux_hotspot_${_jdkver}_${_jdkbuild}.tar.gz.sig")
source_aarch64=("$_jdkurl/OpenJDK25U-jdk_aarch64_linux_hotspot_${_jdkver}_${_jdkbuild}.tar.gz"
                "$_jdkurl/OpenJDK25U-jdk_aarch64_linux_hotspot_${_jdkver}_${_jdkbuild}.tar.gz.sig")
sha256sums=('15f12da7bbb11d76dc4391a909781fd1df3575bd0a518ac6865b6c48c3e94273'
            '876779c835354e46192707714dc7186a925bb3e2fd191c662fb97a08427c75b7')
sha256sums_x86_64=('68982529869257d0ee6b824ec5aa270ff8b118bb438670da0b97ebdab178d7fb'
                   '858b1b75763bf99fa11011553482b6e46819dd9020d9aefd076c1079f2f1eb69')
sha256sums_aarch64=('bb5b2ded252f21c6090cf780b0a408ad0d83bbb557e702955643557f13231880'
                   '80f10e068014b5bcf1012400a57fc975d504b2e9d8d847c242346b44d7ad0b4c')

prepare() {
  cd "$srcdir/$pkgname"
  # The release tag records the exact submodule commits.
  git submodule update --init --recursive --depth 1

  # Upstream deliberately rejects Omarchy before desktop initialization.
  patch --fuzz=0 -Np1 < "$srcdir/remove-omarchy-startup-check.patch"
}

build() {
  cd "$srcdir/$pkgname"
  local jdk="$srcdir/jdk-$_jdkver+$_jdkbuild"
  env -u CI JAVA_HOME="$jdk" PATH="$jdk/bin:$PATH" ./gradlew --no-daemon \
    -Dorg.gradle.java.installations.auto-download=false \
    :desktopApp:createReleaseDistributable
}

package() {
  cd "$srcdir/$pkgname"
  local appdir=desktopApp/build/compose/binaries/main-release/app/Metrolist
  install -d "$pkgdir/opt/metrolist" "$pkgdir/usr/bin"
  cp -a --no-preserve=ownership "$appdir/." "$pkgdir/opt/metrolist/"
  ln -s /opt/metrolist/bin/Metrolist "$pkgdir/usr/bin/metrolist"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 desktopApp/src/desktopMain/resources/logo.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/metrolist.png"
  install -Dm644 aur/metrolist.desktop "$pkgdir/usr/share/applications/Metrolist.desktop"
}
