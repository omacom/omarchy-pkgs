pkgname=omarchy-plugin-workbench
pkgver=0.3.1
pkgrel=1
pkgdesc='Native Omarchy plugin discovery, management, and development helper'
arch=('x86_64')
url='https://github.com/tcballard/omarchy-plugin-workbench'
license=('MIT')
depends=('gcc-libs' 'glibc' 'git' 'curl')
_commit='141cf061a140936158040c82ca75365d172c5cb1'
_srcdir="omarchy-plugin-workbench-$_commit"
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('e407240c9c8e0fb69dcdee9414736b42493185a95db733afdbcf45b362c610c6')
source_x86_64=("$pkgname-v$pkgver-linux-x86_64::$url/releases/download/v$pkgver/$pkgname-v$pkgver-linux-x86_64")
sha256sums_x86_64=('48d62d2e30aeca377f416fafd3a1e5810f69412f595bb1dfa2c4030edd867f31')

check() {
  chmod 0755 "$srcdir/$pkgname-v$pkgver-linux-x86_64"
  [[ $("$srcdir/$pkgname-v$pkgver-linux-x86_64" --version) == "omarchy-plugin-workbench $pkgver" ]]
  grep -Fq '48d62d2e30aeca377f416fafd3a1e5810f69412f595bb1dfa2c4030edd867f31' \
    "$srcdir/$_srcdir/bin/omarchy-plugin-workbench"
}

package() {
  cd "$srcdir/$_srcdir"
  install -Dm755 "$srcdir/$pkgname-v$pkgver-linux-x86_64" \
    "$pkgdir/usr/bin/omarchy-plugin-workbench"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
