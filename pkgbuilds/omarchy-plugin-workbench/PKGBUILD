pkgname=omarchy-plugin-workbench
pkgver=0.3.0
pkgrel=1
pkgdesc='Native Omarchy plugin discovery, management, and development helper'
arch=('x86_64' 'aarch64')
url='https://github.com/tcballard/omarchy-plugin-workbench'
license=('MIT')
depends=('gcc-libs' 'glibc' 'git' 'curl')
makedepends=('cargo')
_commit='6ab0b83e8519473ef71c2b005528806e5f180dad'
_srcdir="omarchy-plugin-workbench-$_commit"
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('2c53dcec4e56df7b352958c51db705f1284ae91e9981b280580713e0340136f4')

prepare() {
  cd "$_srcdir"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_srcdir"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_srcdir"
  export CARGO_TARGET_DIR=target
  cargo test --frozen --all-targets --all-features
}

package() {
  cd "$_srcdir"
  install -Dm755 target/release/omarchy-plugin-workbench \
    "$pkgdir/usr/bin/omarchy-plugin-workbench"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
