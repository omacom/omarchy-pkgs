pkgname=omarchy-plugin-workbench
pkgver=0.3.0
pkgrel=2
pkgdesc='Native Omarchy plugin discovery, management, and development helper'
arch=('x86_64' 'aarch64')
url='https://github.com/tcballard/omarchy-plugin-workbench'
license=('MIT')
depends=('gcc-libs' 'glibc' 'git' 'curl')
makedepends=('cargo')
_commit='9dce628d7e597a25f7abffa8498575f924761d97'
_srcdir="omarchy-plugin-workbench-$_commit"
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('4a0d18d0995330ba3a2f55dd44992856730b03d2fa862f9ba2a4700eba07e800')

prepare() {
  cd "$_srcdir"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_srcdir"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_srcdir"
  export CARGO_TARGET_DIR=target
  cargo test --frozen --all-targets --all-features
  [[ $(target/release/omarchy-plugin-workbench protocol) == workbench-protocol-1 ]]
}

package() {
  cd "$_srcdir"
  install -Dm755 target/release/omarchy-plugin-workbench \
    "$pkgdir/usr/bin/omarchy-plugin-workbench"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
