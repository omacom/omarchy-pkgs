{
  "source": "local",
  "auto_merge": true,
  "release_ring": "fast",
  "upstream": {
    "watch": {
      "debian": "https://dl.google.com/linux/chrome/deb/dists/stable/main/binary-amd64/Packages",
      "package": "google-chrome-stable",
      "pattern": "(?P<version>[0-9]+(?:\\.[0-9]+)*)-[0-9]+"
    }
  }
}
