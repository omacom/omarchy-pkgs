# Arch's recipe with nothing unbundled and the Qt shim off, so the build does
# not move with the libraries of the snapshot it was built on. That is what
# lets it sit on the fast ring; see .omarchy/package.json.

pkgname=chromium
pkgver=158.0.8127.88
# Above Arch's 158.0.8127.88-1, so a machine that took Arch's build moves to this one
pkgrel=2
_launcher_ver=8
_manual_clone=0
_system_clang=1
# Check the CRUBIT_REVISION found in tools/rust/update_rust.py
_crubit_rev=d757594f6f7ac27c0cf9c8ea63d9136f8e1f77ae
pkgdesc="A web browser built for speed, simplicity, and security"
arch=('x86_64')
url="https://www.chromium.org/Home"
license=('BSD-3-Clause')
