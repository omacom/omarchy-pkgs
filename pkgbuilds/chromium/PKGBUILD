# Built the way Google builds Chrome: Chromium's own pinned clang and Rust,
# every library bundled, and system libraries linked through the Debian sysroot.
# aarch64 is cross-compiled on an x86_64 builder, as Google builds Chrome for
# Linux arm64: DEPS pins its toolchain for x64 hosts only.

pkgname=chromium
pkgver=158.0.8127.88
# Above Arch's 158.0.8127.88-1, so a machine that took Arch's build moves to this one
pkgrel=3
pkgdesc="A web browser built for speed, simplicity, and security"
arch=('x86_64' 'aarch64')
url="https://www.chromium.org/Home"
license=('BSD-3-Clause')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libgcc'
  'libpulse'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'ttf-liberation'
  'xdg-utils'
)
conflicts=('omarchy-chromium' 'omarchy-chromium-bin')
replaces=('omarchy-chromium' 'omarchy-chromium-bin')
makedepends=(
  'curl'
  'esbuild'
  'gn'
  'go'
  'java-runtime-headless'
  'ninja'
  'python'
)
optdepends=('pipewire: WebRTC desktop sharing under Wayland'
            'kdialog: support for native dialogs in Plasma'
            'gtk4: for --gtk-version=4 (GTK4 IME might work better on Wayland)'
            'libva: hardware video decoding'
            'org.freedesktop.secrets: password storage backend on GNOME, KDE and Xfce'
            'upower: Battery Status API support')
# Chromium's toolchain sets its own flags and symbol level, and strips with
# its own llvm-strip in package(): the builder's GNU strip cannot read the
# aarch64 binaries a cross build makes
options=('!lto' '!buildflags' '!debug' '!strip')
source=(https://commondatastorage.googleapis.com/chromium-browser-official/chromium-$pkgver-lite.tar.xz
        fetch-deps.py
        chromium.sh
        chromium-153-hermetic-python.patch
        chromium-155-use-system-esbuild.patch
        chromium-158-revert-gn-check-includes.patch
        chromium-158-blink-bindings-workers.patch
        disable-google-api-warning.patch
        use-oauth2-client-switches-as-default.patch)
noextract=(chromium-$pkgver-lite.tar.xz)
sha256sums=('76f5aa94996e31a59b9aa01944c5bdc181043ff58553aff572f9d5750acd326d'
            '5c6181997f446dceab89fbacd297440e7ea7d25e09d18f1b5bdfcfc25145d8a3'
            '1b3ce6c3680ee141a0c976a928deb0bdae899666dbc2e49ac16d7fe5bc4128f4'
            'ebf74154266d0b6d6cc957c413f845052c5fcfce7745befb8821595cdf3f7d49'
            'ded2abcb912ac4b6ad139e56384eea8f3b470cf57ecb0baa2c2d042df7575a23'
            'a41079e62008c016c179643f085107a55b095c8e2d64867b701ff0047951b0b6'
            '6be2b53c17f9bd7408f89d0a0913fa77c8986b541301ce74eaca6ec8c36f3434'
            '5bb33c07e68b165072dc3c60a51e3a2e670f127278a9977fe142ab0414ae6dfb'
            '9343afa1a4308a7cfb3317229f5aff7778688debcc03c4a74a85908aa1d0cc3a')

prepare() {
  # makepkg extracts with bsdtar, whose xz reader runs on one thread. GNU tar
  # hands the tarball to xz, which decompresses its 40 blocks on every core.
  tar -xf chromium-$pkgver-lite.tar.xz
  cd chromium-$pkgver

  # The tarball leaves out the prebuilt tools its DEPS file pins. The amd64
  # sysroot serves the host tools a cross build also compiles.
  local _deps=(
    third_party/llvm-build/Release+Asserts
    third_party/rust-toolchain
    third_party/llvm-libclang
    third_party/node/linux
    third_party/typescript/linux-amd64/src
    build/linux/debian_bullseye_amd64-sysroot
  )
  if [[ $CARCH == aarch64 ]]; then
    python3 ../fetch-deps.py --target-cpu arm64 . "${_deps[@]}" \
      build/linux/debian_bullseye_arm64-sysroot
  else
    python3 ../fetch-deps.py . "${_deps[@]}"
  fi

  # The profile Chrome is optimized with; the tarball names it but records no hash
  local _profile=$(<chrome/build/linux.pgo.txt)
  [[ $_profile =~ ^chrome-linux-[A-Za-z0-9._-]+\.profdata$ ]]
  mkdir -p chrome/build/pgo_profiles
  curl -fsSL --retry 3 -o "chrome/build/pgo_profiles/$_profile" \
    "https://storage.googleapis.com/chromium-optimization-profiles/pgo_profiles/$_profile"

  # Use the --oauth2-client-id= and --oauth2-client-secret= switches for
  # setting GOOGLE_DEFAULT_CLIENT_ID and GOOGLE_DEFAULT_CLIENT_SECRET at
  # runtime -- this allows signing into Chromium without baked-in values
  patch -Np1 -i ../use-oauth2-client-switches-as-default.patch

  # Python, esbuild, Java and Go reach a checkout through CIPD and are not
  # fetched above, so those four come from the build machine
  patch -Np1 -i ../chromium-153-hermetic-python.patch
  patch -Np1 -i ../chromium-155-use-system-esbuild.patch
  patch -Np1 -i ../chromium-158-revert-gn-check-includes.patch

  # Blink's bindings generators each fork a worker per core, and ninja runs
  # several at once: a 64-core builder ran out of memory there
  patch -Np1 -i ../chromium-158-blink-bindings-workers.patch

  # The build carries no Google API key, by choice, so skip the startup bar
  # that says so. Debian ships this patch for the same reason.
  patch -Np1 -i ../disable-google-api-warning.patch

  mkdir -p third_party/jdk/current/bin third_party/dawn/tools/golang/linux-amd64/bin
  ln -sf /usr/bin/java third_party/jdk/current/bin/
  ln -sf /usr/bin/go third_party/dawn/tools/golang/linux-amd64/bin/

  rm -rf third_party/devtools-frontend/src/node_modules/esbuild
  ln -s /usr/lib/node_modules/esbuild third_party/devtools-frontend/src/node_modules/esbuild
}

_gn_gen() {
  local _flags=(
    'is_official_build=true' # ThinLTO, CFI and the PGO profile, as Chrome ships
    'symbol_level=0'
    'blink_symbol_level=0'
    'v8_symbol_level=0'
    'treat_warnings_as_errors=false'
    'disable_fieldtrial_testing_config=true'
    'blink_enable_generated_code_formatting=false'
    'ffmpeg_branding="Chrome"'
    'proprietary_codecs=true'
    'rtc_use_pipewire=true'
    'enable_hangout_services_extension=true'
    'enable_widevine=true'
    'use_qt5=false'
    'use_qt6=false'
    'use_siso=false' # the build below runs ninja
  )
  # Linux has one PGO profile for every CPU (build/config/compiler/pgo)
  [[ $CARCH == aarch64 ]] && _flags+=('target_cpu="arm64"')

  gn gen out/Release --args="${_flags[*]}"
}

build() {
  cd chromium-$pkgver

  _gn_gen
  ninja -C out/Release chrome chrome_sandbox chromedriver.unstripped
}

package() {
  install -Dm755 chromium.sh "$pkgdir/usr/bin/chromium"

  cd chromium-$pkgver

  install -D out/Release/chrome "$pkgdir/usr/lib/chromium/chromium"
  install -D out/Release/chromedriver.unstripped "$pkgdir/usr/bin/chromedriver"
  install -Dm4755 out/Release/chrome_sandbox "$pkgdir/usr/lib/chromium/chrome-sandbox"

  install -Dm644 chrome/installer/linux/common/desktop.template \
    "$pkgdir/usr/share/applications/chromium.desktop"
  install -Dm644 chrome/app/resources/manpage.1.in \
    "$pkgdir/usr/share/man/man1/chromium.1"
  sed -i \
    -e 's/@@MENUNAME/Chromium/g' \
    -e 's/@@PACKAGE/chromium/g' \
    -e 's/@@desktop_exec/chromium/g' \
    -e 's/@@desktop_icon/chromium/g' \
    -e 's/@@startup_wm_class/chromium/g' \
    -e 's|@@uri_scheme|x-scheme-handler/chromium;|g' \
    -e 's/@@extra_desktop_entries//g' \
    "$pkgdir/usr/share/applications/chromium.desktop" \
    "$pkgdir/usr/share/man/man1/chromium.1"

  # Fill in common Chrome/Chromium AppData template with Chromium info
  (
    tmpl_file=chrome/installer/linux/common/appdata.xml.template
    info_file=chrome/installer/linux/common/chromium-browser.info
    . $info_file; PACKAGE=chromium
    export $(grep -o '^[A-Z_]*' $info_file)
    sed -E -e 's/@@([A-Z_]*)/\${\1}/g' -e '/<update_contact>/d' $tmpl_file | envsubst
  ) \
  | install -Dm644 /dev/stdin "$pkgdir/usr/share/metainfo/chromium.appdata.xml"

  local toplevel_files=(
    chrome_100_percent.pak
    chrome_200_percent.pak
    chrome_crashpad_handler
    icudtl.dat
    resources.pak
    v8_context_snapshot.bin

    # ANGLE
    libEGL.so
    libGLESv2.so

    # SwiftShader ICD
    libvk_swiftshader.so
    libvulkan.so.1
    vk_swiftshader_icd.json
  )

  cp "${toplevel_files[@]/#/out/Release/}" "$pkgdir/usr/lib/chromium/"
  install -Dm644 -t "$pkgdir/usr/lib/chromium/locales" out/Release/locales/*.pak

  # makepkg's flags: executables lose every symbol, libraries keep the ones
  # they export
  local _strip=third_party/llvm-build/Release+Asserts/bin/llvm-strip
  "$_strip" --strip-all \
    "$pkgdir/usr/lib/chromium/"{chromium,chrome-sandbox,chrome_crashpad_handler} \
    "$pkgdir/usr/bin/chromedriver"
  "$_strip" --strip-unneeded \
    "$pkgdir/usr/lib/chromium/"{libEGL.so,libGLESv2.so,libvk_swiftshader.so,libvulkan.so.1}

  for size in 24 48 64 128 256; do
    install -Dm644 "chrome/app/theme/chromium/product_logo_$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/chromium.png"
  done

  for size in 16 32; do
    install -Dm644 "chrome/app/theme/default_100_percent/chromium/product_logo_$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/chromium.png"
  done

  # chromium uses the icon name "chromium-browser" internally
  for size in 16 24 32 48 64 128 256; do
    ln -s chromium.png \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/chromium-browser.png"
  done

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/chromium/LICENSE"
}
