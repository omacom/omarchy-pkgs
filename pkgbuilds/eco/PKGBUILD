# Maintainer: This_Is_NPC <gabrielfollone27@gmail.com>

pkgname=eco
pkgver=0.1.1
pkgrel=1
pkgdesc='Voice sessions with an AI beside them: transcribe, ask and keep meetings as text'
arch=('x86_64')
url='https://github.com/This-Is-NPC/eco'
license=('MIT')
options=('!debug' '!lto')
depends=(
  'libgcc'
  'glibc'
  'hicolor-icon-theme'
  'hyprland'         # window rules and global keys, loaded from ~/.config/hypr by `eco setup`
  'pipewire'         # pw-record captures, pw-dump lists the devices
  'qt6-declarative'  # the QML modules the window imports (Controls, Layouts, Dialogs)
  'quickshell'       # draws the window
  'socat'            # the global keys write to the daemon's socket
  'wl-clipboard'     # copy an answer or a transcript
)
optdepends=('ffmpeg: import audio or video recordings')
makedepends=('cargo')
checkdepends=('ffmpeg')  # the import tests decode audio through it
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('4c417422433350de38fce5e37439cdf614ecdb343e2b051c6fee575ea7f5c5c8')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  # The two parity tests need the VAD and speaker models `eco setup` downloads,
  # and the QML test needs qmltestrunner; the build has neither.
  cargo test --frozen --release -- \
    --skip matches_the_python_vad \
    --skip matches_the_wespeaker_pipeline \
    --skip overlay_modules_pass_their_qml_tests
}

package() {
  cd "$pkgname-$pkgver"
  source scripts/lib/stage.sh
  install -Dm755 target/release/eco "$pkgdir/usr/bin/eco"
  stage_files "$pkgdir" /usr
  install -d "$pkgdir/usr/lib/systemd/user"
  service_unit /usr/bin/eco > "$pkgdir/usr/lib/systemd/user/eco.service"
  chmod 644 "$pkgdir/usr/lib/systemd/user/eco.service"
}
