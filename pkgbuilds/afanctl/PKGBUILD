# Maintainer: Prakhar Yadav <pkrc267 at gmail dot com>
# Upstream: https://github.com/yadav-prakhar/afanctl (also packaged as
# `afanctl` on the AUR, from the same sources).
#
# The unit installs DISABLED and the daemon starts in observe mode regardless,
# so installing this package changes nothing until the user runs
# `systemctl enable --now afanctl`.
pkgname=afanctl
pkgver=0.1.0
pkgrel=1
pkgdesc='applesmc fan supervisor for pre-T2 Intel Macs (A1708)'
arch=('x86_64')
url='https://github.com/yadav-prakhar/afanctl'
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs')
makedepends=('cargo')
backup=('etc/afanctl/afanctl.toml')
source=("${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('3b1b55b62d968f443b397b20a37bbb49178e4eb1fc64ff8669479dc3e8e9572a')

build() {
    cd "${pkgname}-${pkgver}"
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --release --locked
}

package() {
    cd "${pkgname}-${pkgver}"

    install -Dm755 "$srcdir/target/release/afanctl" \
        "$pkgdir/usr/bin/afanctl"
    install -Dm644 packaging/afanctl.service \
        "$pkgdir/usr/lib/systemd/system/afanctl.service"
    install -Dm644 packaging/afanctl.toml.default \
        "$pkgdir/etc/afanctl/afanctl.toml"
    install -Dm644 packaging/afanctl.toml.default \
        "$pkgdir/usr/share/afanctl/afanctl.toml.default"
    install -Dm644 packaging/49-afanctl.rules \
        "$pkgdir/usr/share/polkit-1/rules.d/49-afanctl.rules"
    install -Dm644 LICENSE \
        "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
