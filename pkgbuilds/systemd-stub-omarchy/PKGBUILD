# systemd's aarch64 UKI stub, built with room for more PE sections in its header.
#
# ukify writes the header of every section it adds into the room the stub
# reserves before its first section. Arch Linux ARM's stub keeps the default of
# 120 (efi-stub-extra-sections), and each Snapdragon device tree in a UKI is a
# section of its own, so a UKI that carries every supported laptop's tree stops
# fitting at about 119 trees. This builds the same systemd release's stub with
# room for 1024 and installs it beside, not over, systemd's own; ukify uses it
# through --stub or Stub=. Keep pkgver at the systemd version Arch Linux ARM
# ships.

pkgname=systemd-stub-omarchy
pkgver=262.2
pkgrel=1
pkgdesc="systemd's aarch64 UKI stub with header room for 1024 sections, for UKIs that carry many device trees"
arch=('aarch64')
url='https://github.com/systemd/systemd'
license=('LGPL-2.1-or-later')
makedepends=('meson' 'ninja' 'gperf' 'python-jinja' 'python-pyelftools' 'libcap' 'util-linux-libs')
options=('!strip' '!debug')
source=("systemd-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('116432ee9dce9bfef4c7da7963c6de41899ab44197f2876ee99545707a5c7c1f')

build() {
  # Only the stub is built, so every optional feature stays off; the stub uses none.
  meson setup "systemd-$pkgver" build \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode=nodownload \
    -Dmode=release \
    -Dbootloader=enabled \
    -Defi-stub-extra-sections=1024 \
    -Dauto_features=disabled \
    -Dtests=false \
    -Dman=disabled \
    -Dversion-tag="$pkgver-$pkgrel-omarchy" \
    -Dvcs-tag=false \
    -Dsbat-distro=arch
  meson compile -C build src/boot/linuxaa64.efi.stub
}

package() {
  install -Dm644 build/src/boot/linuxaa64.efi.stub "$pkgdir/usr/lib/systemd-stub-omarchy/linuxaa64.efi.stub"
}
