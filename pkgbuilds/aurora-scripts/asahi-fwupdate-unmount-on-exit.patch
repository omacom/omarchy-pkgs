--- a/asahi-fwupdate
+++ b/asahi-fwupdate
@@ -20,11 +20,22 @@
 
 umount=false
 
+# Unmount the ESP on every way out, a mount_sys_esp that failed after mounting
+# included, and keep a failure's exit status.
+cleanup() {
+    status=$?
+    if $umount && mountpoint -q /run/.system-efi && ! umount /run/.system-efi; then
+        [ "$status" -ne 0 ] || status=1
+    fi
+    exit "$status"
+}
+trap cleanup EXIT
+
 if [ -z "$ASAHIFW" ] && [ -z "$VENDORFW" ]; then
+    umount=true
     mount_sys_esp /run/.system-efi
     ASAHIFW="/run/.system-efi/asahi/"
     VENDORFW="/run/.system-efi/vendorfw"
-    umount=true
 fi
 
 if [ ! -e "${ASAHIFW}/all_firmware.tar.gz" ]; then
@@ -64,6 +75,3 @@
 mv "$VENDORFW".new "$VENDORFW"
 rm -rf "$VENDORFWTMP"
 echo "Firmware upgraded"
-
-$umount && umount /run/.system-efi
-true
