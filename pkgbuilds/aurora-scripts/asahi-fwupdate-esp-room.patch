--- a/asahi-fwupdate
+++ b/asahi-fwupdate
@@ -42,8 +42,24 @@
 
 echo "Upgrading vendor firmware package"
 asahi-fwextract "$ASAHIFW" "$VENDORFWTMP"
+# A run that failed left its half-written copy; it is never the live firmware.
 rm -rf "$VENDORFW".new
-mv "${VENDORFWTMP}" "$VENDORFW".new
+# The new copy is written beside the live one, so it needs its own size free.
+need=$(du -sk "$VENDORFWTMP" | cut -f1)
+need=$((need + need / 10 + 1024))
+free=$(df -Pk "$(dirname "$VENDORFW")" | awk 'NR == 2 { print $4 }')
+if [ "$free" -lt "$need" ]; then
+    echo "Not enough room for the new firmware: $((need / 1024)) MiB needed, $((free / 1024)) MiB free on $(dirname "$VENDORFW"); the firmware was not changed" >&2
+    rm -rf "$VENDORFWTMP"
+    $umount && umount /run/.system-efi
+    exit 1
+fi
+if ! mv "${VENDORFWTMP}" "$VENDORFW".new; then
+    echo "Could not stage the new firmware in $VENDORFW.new; the firmware was not changed" >&2
+    rm -rf "$VENDORFW".new "$VENDORFWTMP"
+    $umount && umount /run/.system-efi
+    exit 1
+fi
 rm -rf "$VENDORFW"
 mv "$VENDORFW".new "$VENDORFW"
 rm -rf "$VENDORFWTMP"
