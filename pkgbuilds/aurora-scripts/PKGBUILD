# Recipe from asahi-alarm/PKGBUILDs asahi-scripts 20261023-1, renamed for the Aurora stack.
pkgname=aurora-scripts
pkgver=20261023
pkgrel=1
pkgdesc='Apple Silicon maintenance scripts: update-m1n1, firmware and initramfs hooks'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/asahi-alarm/asahi-scripts'
license=('MIT')
provides=("asahi-scripts=$pkgver")
conflicts=('asahi-scripts')
replaces=('asahi-scripts')
install=aurora-scripts.install
source=("asahi-scripts-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('64c7e8d50f7ad37d58a64d1f1bc7c8848d7507093f40172e6dbce75c72b26ce4')

build() {
  cd "asahi-scripts-$pkgver"
  make PREFIX=/usr all
}

package() {
  cd "asahi-scripts-$pkgver"
  make PREFIX=/usr DESTDIR="$pkgdir" install-arch
  # Arch's default DTBS, which upstream leaves to the distribution.
  sed -i -e '/${CONFIG/i : ${DTBS:=$(/bin/ls -d /lib/modules/*-ARCH | sort -rV | head -1)/dtbs/*.dtb}' "$pkgdir/usr/bin/update-m1n1"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
