pkgbase=mesa-aurora
pkgname=('mesa-aurora' 'vulkan-aurora')
epoch=1
pkgver=26.3.0_devel.20261017.af3d9c6fc84
pkgrel=2
pkgdesc='Aurora Asahi Gallium, Zink and Honeykrisp'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/aurora-silicon/mesa'
license=('MIT')
_commit=af3d9c6fc84f6e5bc6ee23f1eb0b47a5ee466826
# Matched to the DRM UAPI in omacom/linux-aurora integration/aurora.
# The drivers link neither LLVM nor SPIRV-Tools. Arch Linux ARM moves both
# (llvm-libs changes soname every major, SPIRV-Tools has no versioned soname),
# and a Mesa linked to the old ones leaves the Neo without a GPU until this
# package is rebuilt. Asahi needs LLVM only to precompile its CL shaders, so a
# first build makes those compilers and the packaged one uses them.
makedepends=('git' 'meson' 'ninja' 'python-mako' 'python-yaml' 'python-packaging' 'rust'
             'rust-bindgen' 'clang' 'llvm' 'libclc' 'spirv-llvm-translator' 'spirv-tools'
             'cbindgen' 'glslang' 'libdrm' 'expat' 'libglvnd'
             'libx11' 'libxcb' 'libxext' 'libxfixes' 'libxrandr' 'libxshmfence' 'libxxf86vm'
             'wayland' 'wayland-protocols' 'vulkan-headers' 'vulkan-icd-loader' 'libdisplay-info'
             'lm_sensors' 'zlib' 'zstd' 'xcb-util-keysyms')
source=("mesa::git+$url.git#commit=$_commit"
        0001-hk-preserve-library-assertion-mode-in-test.patch)
sha256sums=('SKIP' 'e8684509bed4c22c89064399842ce7646ad1572c176b1794953454f80edbb412')
options=('!debug')
_options=(-Dplatforms=x11,wayland
  -Dgallium-drivers=asahi,zink,softpipe -Dvulkan-drivers=asahi
  -Degl=enabled -Dgbm=enabled -Dglx=dri -Dgles1=enabled -Dgles2=enabled
  -Dglvnd=enabled -Dvideo-codecs=all -Dvulkan-layers=
  -Dexpat=enabled -Dzstd=enabled -Dlmsensors=enabled -Dlibunwind=disabled -Dvalgrind=disabled)
# arch-meson's flags without --auto-features enabled, which would require
# features this driver set cannot have, such as the VA front end.
_meson() {
  meson setup --prefix /usr --libexecdir lib --sbindir bin --buildtype plain \
    --wrap-mode nodownload -Db_pie=true -Db_ndebug=true -Dpython.bytecompile=1 "$@"
}
prepare() {
  patch -d mesa -Np1 -i "$srcdir/0001-hk-preserve-library-assertion-mode-in-test.patch"
}
build() {
  # The bootstrap builds only three shader tools; the driver build runs tests.
  _meson mesa tools "${_options[@]}" -Dllvm=enabled -Dbuild-tests=false
  ninja -C tools -j "${OMARCHY_BUILD_JOBS:-10}" \
    src/compiler/clc/mesa_clc src/compiler/spirv/vtn_bindgen2 src/asahi/clc/asahi_clc
  printf '%s\n' '[binaries]' \
    "mesa_clc = '$srcdir/tools/src/compiler/clc/mesa_clc'" \
    "vtn_bindgen2 = '$srcdir/tools/src/compiler/spirv/vtn_bindgen2'" \
    "asahi_clc = '$srcdir/tools/src/asahi/clc/asahi_clc'" > tools.ini

  _meson mesa build "${_options[@]}" --native-file tools.ini \
    -Dllvm=disabled -Dspirv-tools=disabled -Dmesa-clc=system -Dprecomp-compiler=system \
    -Dbuild-tests=true
  meson compile -C build -j "${OMARCHY_BUILD_JOBS:-10}"
  DESTDIR="$srcdir/mesa-stage" meson install -C build --no-rebuild
}
check() {
  meson test -C build --print-errorlogs \
    --num-processes "${OMARCHY_BUILD_JOBS:-10}" || return 1
  # Nothing packaged may follow the system's LLVM or SPIRV-Tools.
  [[ -d $srcdir/mesa-stage ]] || return 1
  local binary dependencies
  while IFS= read -r -d '' binary; do
    dependencies=$(LC_ALL=C readelf -d "$binary") || return 1
    if grep -Eq 'NEEDED.*(libLLVM|libSPIRV-Tools)' <<<"$dependencies"; then
      echo "Unexpected compiler runtime dependency: $binary" >&2
      return 1
    fi
  done < <(find "$srcdir/mesa-stage" -name '*.so*' -type f -print0)
}

package_mesa-aurora() {
  pkgdesc='Aurora native Asahi Gallium and Zink OpenGL drivers'
  depends=('expat' 'glibc' 'gcc-libs' 'libdrm' 'libglvnd' 'libx11' 'libxcb' 'libxext'
           'libxshmfence' 'libxxf86vm' 'lm_sensors' 'wayland' 'zlib' 'zstd'
           'vulkan-mesa-implicit-layers')
  provides=("mesa=$epoch:$pkgver" 'mesa-libgl' 'opengl-driver' 'libgbm.so')
  conflicts=('mesa')
  cp -a "$srcdir/mesa-stage/usr" "$pkgdir/"
  rm "$pkgdir/usr/lib/libvulkan_asahi.so"
  rm "$pkgdir"/usr/share/vulkan/icd.d/*asahi*.json
  rmdir "$pkgdir/usr/share/vulkan/icd.d" "$pkgdir/usr/share/vulkan" 2>/dev/null || true

}
package_vulkan-aurora() {
  pkgdesc='Aurora Honeykrisp Vulkan driver'
  depends=('expat' 'glibc' 'gcc-libs' 'libdrm' 'libdisplay-info' 'libx11' 'libxcb'
           'libxshmfence' 'systemd-libs' 'vulkan-icd-loader' 'wayland'
           'xcb-util-keysyms' 'zlib' 'zstd')
  provides=("vulkan-asahi=$epoch:$pkgver" "vulkan-asahi-aurora=$epoch:$pkgver" 'vulkan-driver')
  conflicts=('vulkan-asahi' 'vulkan-asahi-aurora')
  replaces=('vulkan-asahi-aurora')
  install -Dm755 "$srcdir/mesa-stage/usr/lib/libvulkan_asahi.so" "$pkgdir/usr/lib/libvulkan_asahi.so"
  install -d "$pkgdir/usr/share/vulkan/icd.d"
  cp -a "$srcdir"/mesa-stage/usr/share/vulkan/icd.d/*asahi*.json "$pkgdir/usr/share/vulkan/icd.d/"
}
