# Audio DSP and GPU firmware for the Dell Inspiron 14 3420. The firmware only runs if it is signed
# for this board by Dell, so linux-firmware cannot carry it until the OEM submits it. The OEM
# ships it in the driver bundle it publishes for the machine on Windows Update, whose cabinets
# this recipe fetches with wudrivers and unpacks without running anything. Each file is checked
# against the SHA-256 it was matched to and installed under the name the device tree requests,
# compressed with xz. The kernel tries a plain name, then .zst, then .xz, so once linux-firmware
# ships the same file, its copy is the one loaded, and the two packages never install the same
# path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=dell-inspiron-14-3420-firmware
pkgver=20261116
pkgrel=2
pkgdesc='Audio DSP and GPU firmware for the Dell Inspiron 14 3420'
arch=('aarch64')
url='https://github.com/birkskyum/wudrivers'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-sc8180xp-dell')
makedepends=('7zip' 'wudrivers')
options=('!strip' '!debug')
# dl.dell.com turns away clients that do not name a browser.
DLAGENTS=('https::/usr/bin/curl -qgb "" -A Mozilla/5.0 -fLC - --retry 3 --retry-delay 3 -o %o %u')
# Windows Update's links are short-lived, so wudrivers fetches a fresh one by update ID, revision and SHA-1.
DLAGENTS+=('wu::/usr/bin/wudrivers fetch %u -o %o')
source=(
  'dell-inspiron-14-3420-wu-200.0.14.0-qcsubsys-ext-adsp8180.cab::wu://c9d649d1-623a-4ba9-8f0d-34c2350ce7b8/1/fcd67a39e6739cb30e46e74e70855cc4ee41b724'
  'dell-inspiron-14-3420-wu-200.0.14.0-qcdx8180.cab::wu://c9d649d1-623a-4ba9-8f0d-34c2350ce7b8/1/21798db4aed1ee61f8552148a001173f362ebd2d'
)
source+=('README.package.md')
noextract=('dell-inspiron-14-3420-wu-200.0.14.0-qcsubsys-ext-adsp8180.cab' 'dell-inspiron-14-3420-wu-200.0.14.0-qcdx8180.cab')
sha256sums=('df4d3c133a5c0625841238c0441bc8dec283684014f80599f37daf679e8a107e' '83cccbc83fb8166f4448567e498b4e04d3fb57fd9f4a5a726422c4c586060198')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'dell-inspiron-14-3420-wu-200.0.14.0-qcsubsys-ext-adsp8180.cab' 'dell-inspiron-14-3420-wu-200.0.14.0-qcsubsys-ext-adsp8180' 7z
  _unpack 'dell-inspiron-14-3420-wu-200.0.14.0-qcdx8180.cab' 'dell-inspiron-14-3420-wu-200.0.14.0-qcdx8180' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'dell-inspiron-14-3420-wu-200.0.14.0-qcsubsys-ext-adsp8180/qcadsp8180.mbn' "$fw"/'qcom/sc8180xp/dell/qcadsp8180.mbn'
  install -Dm644 'dell-inspiron-14-3420-wu-200.0.14.0-qcdx8180/qcdxkmsuc8180.mbn' "$fw"/'qcom/sc8180xp/dell/qcdxkmsuc8180.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
2b9836033f37cc860fdbd9a26a2d5360bb4914fa75fdb1f784a0781d43075c64  qcom/sc8180xp/dell/qcadsp8180.mbn
0170fbea8a31fe7c691b95f9b9e8ad720fde5ea23e3c91c0f5fbe0ebaa0d8213  qcom/sc8180xp/dell/qcdxkmsuc8180.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
