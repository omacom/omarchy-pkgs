# Maintainer: Andras Munkacsi

pkgname=omagit
pkgver=0.9.0
pkgrel=1
pkgdesc='Omarchy-native git GUI designed for tiling window managers'
arch=('x86_64' 'aarch64')
url='https://github.com/liri2006/omagit'
license=('MIT')
options=('!debug')
depends=(
  'git'
  'glibc'
  'hicolor-icon-theme'
  'libgcc'
  'libstdc++'
  'qt6-base'
  'qt6-svg'
  'ttf-font-nerd'
)
optdepends=(
  'openssh: ssh remotes and SSH key sign-in'
  'libsecret: remember sign-ins in the keyring'
  'github-cli: pick one of your GitHub repositories to clone'
  'nautilus-python: the "Open in Omagit" entry in Nautilus'
  'claude-code: write commit messages with Claude Code'
  'openai-codex: write commit messages with Codex'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('393d98398c39e2acef38a7d9dab25c7d2e6da6b02ba9825a29ed195183f9c313')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  # no_screenshot_keys leaves out a test-only option that needs Qt's private API.
  qmake6 omagit.pro \
    CONFIG+=no_screenshot_keys \
    PREFIX=/usr \
    QMAKE_CFLAGS_RELEASE="$CFLAGS" \
    QMAKE_CXXFLAGS_RELEASE="$CXXFLAGS" \
    QMAKE_LFLAGS_RELEASE="$LDFLAGS"
  make
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  # The git wrapper and merge preview suites, with a throw-away config and
  # runtime directory. The widget suite checks pixel sizes against the
  # design, which depend on fonts and timing; it runs in development.
  tests/run.sh gitrepo mergedialog
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make INSTALL_ROOT="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
