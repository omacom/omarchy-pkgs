# Maintainer: ster-lang
#
# Obscura's upstream releases are not signed, so the archives are pinned by
# SHA-256 alone.
pkgname=obscura
pkgver=0.2.6
pkgrel=1
pkgdesc='Headless browser engine for AI agents and web scraping'
arch=('x86_64' 'aarch64')
url='https://github.com/h4ckf0r0day/obscura'
license=('Apache-2.0')
depends=('glibc' 'gcc-libs')
options=('!strip' '!debug')
source=(
  "LICENSE"
  "obscura.png"
  "obscura.desktop"
)
source_x86_64=("obscura-${pkgver}-x86_64-linux.tar.gz::https://github.com/h4ckf0r0day/obscura/releases/download/v${pkgver}/obscura-x86_64-linux.tar.gz")
source_aarch64=("obscura-${pkgver}-aarch64-linux.tar.gz::https://github.com/h4ckf0r0day/obscura/releases/download/v${pkgver}/obscura-aarch64-linux.tar.gz")
sha256sums=(
  '50e6751797c50dedd75ef1b8a0d9e42f5f8472e9fbce91f34718e9f97b0c780a'
  '2d6646c22668454986891e53a397023bfbf8854c55a74e1539bdf6cd8a2ba7bc'
  '0863db514a46749555f2e1267b35e2b3df4e8d78afe57537a5e9d98550311c2d'
)
sha256sums_x86_64=('eed986e478c5ec5439f531f2d7fb6b0e36a356f1df7a6c44a8e8fd4f2486bd76')
sha256sums_aarch64=('e12aff8bbe40326386a471060083e9cec5255b67048996b84f649efef10cac39')

package() {
  install -Dm755 obscura "${pkgdir}/usr/bin/obscura"
  install -Dm755 obscura-worker "${pkgdir}/usr/bin/obscura-worker"

  install -Dm644 obscura.desktop "${pkgdir}/usr/share/applications/obscura.desktop"
  install -Dm644 obscura.png "${pkgdir}/usr/share/pixmaps/obscura.png"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/obscura/LICENSE"
}
