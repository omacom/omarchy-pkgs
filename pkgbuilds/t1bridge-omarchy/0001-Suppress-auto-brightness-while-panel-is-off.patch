--- a/lib/auto-brightness
+++ b/lib/auto-brightness
@@ -66,7 +66,13 @@
 session_usable() {
   local status
   status=$(loginctl show-session auto -p Active -p LockedHint -p Type 2>/dev/null) || return 1
-  [[ $status == *'Active=yes'* && $status == *'LockedHint=no'* && $status == *'Type=wayland'* ]]
+  [[ $status == *'Active=yes'* && $status == *'LockedHint=no'* && $status == *'Type=wayland'* ]] || return 1
+  # An active unlocked session can still have its panel powered off.
+  # Unknown compositor state must also suppress brightness changes.
+  hyprctl monitors all -j 2>/dev/null | jq -e '
+    any(.[]; (.name | test("^(eDP|LVDS|DSI)-")) and
+      .disabled == false and .dpmsStatus == true and .width > 0 and .height > 0)
+  ' >/dev/null 2>&1
 }
 
 run_brightness() {
--- a/tests/auto-brightness.sh
+++ b/tests/auto-brightness.sh
@@ -43,13 +43,29 @@
 done
 printf 'ok - T1 ancestry required; ambiguous and foreign sensors rejected\n'
 loginctl() { printf '%s\n' "$SESSION_FIXTURE"; }
-SESSION_FIXTURE=$'Active=yes\nLockedHint=no\nType=wayland'
+hyprctl() { printf '%s\n' "$MONITOR_FIXTURE"; }
+MONITOR_FIXTURE='[{"name":"eDP-1","disabled":false,"dpmsStatus":true,"width":1920,"height":1080}]'
+SESSION_FIXTURE=$'Active=yes\nLockedHint=no\nType=wayland' 
 session_usable
 SESSION_FIXTURE=$'Active=yes\nLockedHint=yes\nType=wayland'
 ! session_usable
 SESSION_FIXTURE=$'Active=no\nLockedHint=no\nType=wayland'
 ! session_usable
 printf 'ok - lock and inactive session suppress brightness policy\n'
+SESSION_FIXTURE=$'Active=yes\nLockedHint=no\nType=wayland'
+for monitors in \
+  '[{"name":"eDP-1","disabled":false,"dpmsStatus":false,"width":1920,"height":1080}]' \
+  '[{"name":"eDP-1","disabled":true,"dpmsStatus":true,"width":1920,"height":1080}]' \
+  '[{"name":"HDMI-A-1","disabled":false,"dpmsStatus":true,"width":1920,"height":1080}]' \
+  '[{"name":"eDP-1","disabled":false,"width":1920,"height":1080}]' \
+  '[]' 'invalid-json'; do
+  MONITOR_FIXTURE=$monitors
+  if session_usable; then echo 'not ok - unusable or unknown panel is rejected' >&2; exit 1; fi
+done
+MONITOR_FIXTURE='[{"name":"eDP-1","disabled":false,"dpmsStatus":true,"width":1920,"height":1080}]'
+session_usable
+printf 'ok - production session gate rejects DPMS-off, disabled, external-only and unknown panels\n'
+
 
