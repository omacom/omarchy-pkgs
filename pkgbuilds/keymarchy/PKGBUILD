# Maintainer: Razu <3963717+Razumasu@users.noreply.github.com>

pkgname=keymarchy
pkgver=0.3.1
pkgrel=1
pkgdesc='Manage named FIDO2 security keys for sudo on Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/Razumasu/keymarchy'
license=('MIT')
options=('!debug')
depends=('gcc-libs' 'glibc' 'hicolor-icon-theme' 'libglvnd' 'openssl'
         'qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland'
         'pam-u2f' 'libfido2' 'polkit')
makedepends=('gcc' 'make' 'pkgconf')
checkdepends=('ttf-dejavu')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b0261d82fec680647e52eb4724a5fac8fa25c6dc77e7e038b0c2a1c4166b1519')
build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}
check() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/test
}
package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 build/keymarchy "$pkgdir/usr/bin/keymarchy"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/keymarchy/LICENSE"
  install -Dm644 pkgbuild/keymarchy.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/keymarchy.svg"
  install -Dm644 pkgbuild/keymarchy.desktop "$pkgdir/usr/share/applications/keymarchy.desktop"
  install -Dm644 docs/screenshot.png "$pkgdir/usr/share/doc/keymarchy/docs/screenshot.png"
  install -Dm644 README.md "$pkgdir/usr/share/doc/keymarchy/README.md"
}
