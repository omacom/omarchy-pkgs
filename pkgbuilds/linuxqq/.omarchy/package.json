{
  "source": "local",
  "sync": false,
  "release_ring": "fast",
  "upstream": {
    "watch": {
      "regex": "https://docs.qq.com/doc/DVXNoRlpKaWhEY015",
      "pattern": "https://qqdl\\.gtimg\\.cn/qqfile/QQNT/(?P<ntver>[0-9]+(?:\\.[0-9]+)+)/beta/(?P<dir>[0-9a-f]{8})/linuxqq_(?P<version>[0-9]+(?:\\.[0-9]+)+)-(?P<build>[0-9]+)_amd64\\.deb",
      "version": "{version}_{build}",
      "variables": {
        "_ntver": "{ntver}",
        "_dir": "{dir}"
      }
    }
  }
}
