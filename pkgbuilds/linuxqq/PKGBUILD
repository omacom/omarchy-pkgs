# Maintainer: The Omarchy Authors

pkgname=linuxqq
pkgver=3.2.34_53644
pkgrel=1
# Tencent files each Linux build under the Windows release it ships with and
# a per-release directory; both come from the same download listing as pkgver.
_ntver=9.9.36
_dir=9ee04bef
pkgdesc='QQ, the instant messenger from Tencent (official Electron client)'
arch=('x86_64' 'aarch64')
url='https://im.qq.com/linuxqq/'
license=('LicenseRef-QQ')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'gtk3'
  'libnotify'
  'libsecret'
  'libxss'
  'libxtst'
  'nss'
  'util-linux-libs'
  'xdg-utils'
)
optdepends=(
  'libappindicator-gtk3: tray icon'
  'nettle3: live streaming, through the bundled librtmp'
)
options=('!debug' '!strip')
_deb="https://qqdl.gtimg.cn/qqfile/QQNT/${_ntver}/beta/${_dir}/linuxqq_${pkgver/_/-}"
source=(
  'linuxqq.sh'
  'qq.desktop'
  'LICENSE'
)
source_x86_64=("${_deb}_amd64.deb")
source_aarch64=("${_deb}_arm64.deb")
noextract=(
  "linuxqq_${pkgver/_/-}_amd64.deb"
  "linuxqq_${pkgver/_/-}_arm64.deb"
)
sha256sums=('aab57a2ad069a4da85df74b93afed01276807ecd0b2fbfc2e94152a1f97c66f7'
            'f16ac1d15ca507203d4cbbacd68c1738ff0f8a5dc577f72419d7a9a4f209b3f6'
            'cb587afa094b76a5b1c4c6ef6ceada1c07c0db703dff972a17960db3665c4eb1')
sha256sums_x86_64=('436c65e1dd28422e128a21cbddb5fe4e2e6c079d7f27fec2541e014d38cc336e')
sha256sums_aarch64=('181b895cb573548e396e54bb0548cca92ffdc1b1a4b018fa4551bb062385fdca')

prepare() {
  local deb
  case "$CARCH" in
    x86_64) deb="linuxqq_${pkgver/_/-}_amd64.deb" ;;
    aarch64) deb="linuxqq_${pkgver/_/-}_arm64.deb" ;;
  esac
  rm -rf qq
  mkdir qq
  bsdtar -O -xf "$deb" 'data.tar.*' | bsdtar -C qq -xf -
}

package() {
  local lib="$pkgdir/opt/QQ"
  local expected_machine

  case "$CARCH" in
    x86_64) expected_machine='Advanced Micro Devices X86-64' ;;
    aarch64) expected_machine=AArch64 ;;
  esac

  install -d "$lib"
  cp -a --no-preserve=ownership qq/opt/QQ/. "$lib/"

  # A binary for another architecture fails the build so a new native module
  # gets reviewed rather than shipped dead.
  local file machine
  while IFS= read -r -d '' file; do
    machine=$(readelf -h "$file" 2>/dev/null |
      sed -n 's/^[[:space:]]*Machine:[[:space:]]*//p')
    if [[ -n $machine && $machine != "$expected_machine" ]]; then
      error "Unexpected ${machine} binary: ${file#"$pkgdir"}"
      return 1
    fi
  done < <(find "$lib" -type f -print0)

  # Chromium sandboxes through unprivileged user namespaces, which Arch-family
  # kernels allow; the deb's postinst makes chrome-sandbox setuid root, this does not.
  chmod -R u=rwX,go=rX "$lib"

  install -Dm755 linuxqq.sh "$pkgdir/usr/bin/linuxqq"
  ln -s linuxqq "$pkgdir/usr/bin/qq"
  install -Dm644 qq.desktop "$pkgdir/usr/share/applications/qq.desktop"
  install -Dm644 qq/usr/share/icons/hicolor/512x512/apps/qq.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/qq.png"

  local licenses="$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 LICENSE "$licenses/LICENSE"
  mv "$lib/LICENSE.electron.txt" "$lib/LICENSES.chromium.html" "$licenses/"
}
