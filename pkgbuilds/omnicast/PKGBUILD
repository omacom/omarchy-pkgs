# Maintainer: Koustav Ganguly <koustavganguly24@gmail.com>
pkgname=omnicast
pkgver=0.2.1
pkgrel=2
pkgdesc='Alt+Space productivity umbrella for Omarchy (Hyprland / Quickshell)'
arch=('any')
url='https://omnicast.best'
license=('MIT')
_commit='8ae8e275f623da31d10f87a0574cbc72c5eed336'
depends=(
  'omarchy'
  'python'
  'quickshell'
  'wl-clipboard'
  'xdg-utils'
)
makedepends=('git')
optdepends=(
  'fd: fast file name search'
  'ripgrep: content: file search'
  'plocate: locate-backed file search'
  'ghostty: default terminal'
  'imv: image preview'
  'onlyoffice-desktopeditors: office document viewer'
)
options=('!debug')
source=("omnicast::git+https://github.com/KOUSTAV2409/omnicast.git#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
  [[ $(git -C omnicast rev-parse HEAD) == "$_commit" ]]
}

package() {
  cd omnicast

  install -d "$pkgdir/usr/share/omnicast"
  cp -a src bin BarWidget.qml manifest.json LICENSE README.md \
    "$pkgdir/usr/share/omnicast/"

  # Keep the package lean: no marketing video, site, or draft trees
  find "$pkgdir/usr/share/omnicast" -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true
  find "$pkgdir/usr/share/omnicast" -type f -name '*.pyc' -delete 2>/dev/null || true

  install -d "$pkgdir/usr/bin"
  ln -sf /usr/share/omnicast/bin/omnicast "$pkgdir/usr/bin/omnicast"

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/omnicast.desktop" <<'DESKTOP'
[Desktop Entry]
Name=Omnicast
Comment=Alt+Space Productivity Umbrella for Omarchy
Exec=omnicast %u
Icon=preferences-system-search
Terminal=false
Type=Application
Categories=Utility;System;
MimeType=x-scheme-handler/omnicast;
StartupNotify=false
DESKTOP

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
