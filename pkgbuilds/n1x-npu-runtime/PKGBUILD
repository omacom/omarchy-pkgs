pkgname=n1x-npu-runtime
pkgver=0.1.0.r92e9434
pkgrel=1
pkgdesc='Native N1X ONNX runtime (local vendor compiler inputs prepared separately)'
arch=('aarch64')
url='https://github.com/johannhartmann/n1x-npu-linux'
license=('MIT' 'GPL-2.0-only')
depends=('glibc' 'gcc-libs' 'openssl' 'python' 'python-numpy' 'python-onnx')
makedepends=('git')
options=('!strip')
optdepends=('n1x-npu-dkms: opt-in N1X hardware provider' 'n1x-npu-firmware-local: local firmware preparation tools')
_commit=92e9434a65d2b9d3bb0517efb9efc371e9c6b42c
source=("n1x-npu::git+https://github.com/johannhartmann/n1x-npu-linux.git#commit=${_commit}"
        '0001-local-compiler-inputs.patch'
        'infer.py'
        'n1x-npu-infer'
        'prepare-compiler.py'
        'test_local_inputs.py'
        'README.md'
)
sha256sums=('SKIP'
            '03f9df15ffc4973ef0f48cc8dc43b6e5b499f498664f5d70adbedb9c7dce50e2'
            '42cfff58d5d6f8b737ae9bae582f520e06cd018af02e2fa233bab55cb2924cf9'
            '2c1ccb0787308402a4910d78174c4869b259bb8ba57de58ec83fef6de542af30'
            '3d9dd7684663a0274576503ec3841e3860ed8f23e07c8e4f9e6442b725b7a688'
            'dd843fc2b2f507939fec105a973689a64938a21336fcb8fc3ede2f0750d4762d'
            '01e62442bd228b316ae189c328a075cadf5ff5360f322e87691074cd30bd36da'
)
prepare() {
  cd "$srcdir/n1x-npu"
  patch -Np1 -i "$srcdir/0001-local-compiler-inputs.patch"
}
build() {
  cd "$srcdir/n1x-npu"
  # ORT's source header has a public fallback descriptor: no vendor SDK needed.
  make runtime/libn1x_dla.so compiler
  c++ -std=c++17 -O2 -Wall -Wextra -Werror -fPIC -shared -Iinclude -Iruntime \
    runtime/n1x_ort.cpp runtime/cudla_model.cpp -Lruntime -ln1x_dla \
    -Wl,-rpath,'$ORIGIN' -o runtime/libn1x_ort.so
  c++ -std=c++17 -O2 -Wall -Wextra -Werror -DN1X_ORT_CLI_MAIN -Iinclude -Iruntime \
    runtime/n1x_ort.cpp -Lruntime -ln1x_ort -Wl,-rpath,'$ORIGIN' -o runtime/n1x-ort-run
}
check() {
  python "$srcdir/test_local_inputs.py"
  cd "$srcdir/n1x-npu"
  python scripts/test_dla_runtime.py
  python scripts/test_linux_accel_backend.py
}
package() {
  local base="$pkgdir/usr/lib/n1x-npu"
  install -dm755 "$base/runtime"
  install -m755 "$srcdir/n1x-npu/runtime/"{libn1x_dla.so,libn1x_compiler.so,libn1x_ort.so,n1x-compile,n1x-ort-run} "$base/runtime/"
  install -m644 "$srcdir/n1x-npu/runtime/"{n1x_dla.py,n1x_compiler.py,n1x_ort.py,loadable.py} "$base/runtime/"
  install -Dm755 "$srcdir/n1x-npu-infer" "$pkgdir/usr/bin/n1x-npu-infer"
  install -m644 "$srcdir/infer.py" "$base/infer.py"
  install -Dm755 "$srcdir/prepare-compiler.py" "$pkgdir/usr/bin/n1x-npu-prepare-compiler"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/n1x-npu/LICENSES/MIT.txt" "$pkgdir/usr/share/licenses/$pkgname/MIT.txt"
  install -Dm644 "$srcdir/n1x-npu/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 "$srcdir/n1x-npu/LICENSING.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSING.md"
}
