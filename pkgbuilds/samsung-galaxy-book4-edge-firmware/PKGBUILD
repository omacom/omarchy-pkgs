# Audio DSP, compute DSP and GPU firmware for the Samsung Galaxy Book4 Edge. The firmware only
# runs if it is signed for this board by Samsung, so linux-firmware cannot carry it until the OEM
# submits it. The OEM ships it in its Windows driver download, which this recipe unpacks without
# running. The files are installed unmodified, under the names the device tree requests, and
# checked against the SHA-256 each was matched to.
#
# Generated from https://arewearmyet.com/firmware-sources.json by bin/snapdragon-firmware-recipes;
# change the table, not this file.

pkgname=samsung-galaxy-book4-edge-firmware
pkgver=20261102
pkgrel=1
pkgdesc='Audio DSP, compute DSP and GPU firmware for the Samsung Galaxy Book4 Edge'
arch=('aarch64')
url='https://downloadcenter.samsung.com/content/DR/202411/20241106081449539/BASW-A4231A01_1063.zip'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1e80100-samsung-galaxy-book4-edge')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'samsung-basw-a4231a01-1063.zip::https://downloadcenter.samsung.com/content/DR/202411/20241106081449539/BASW-A4231A01_1063.zip'
)
noextract=('samsung-basw-a4231a01-1063.zip')
sha256sums=('f8694548a45d46b1c07eb0dc3dbfea0d58c532f300c84dc4906815a63875c6b9')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'samsung-basw-a4231a01-1063.zip' 'samsung-basw-a4231a01-1063' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'samsung-basw-a4231a01-1063/Chipset/qcsubsys_ext_adsp_ss8380/adsp_dtbs.elf' "$fw"/'qcom/x1e80100/SAMSUNG/galaxy-book4-edge/adsp_dtbs.elf'
  install -Dm644 'samsung-basw-a4231a01-1063/Chipset/qcsubsys_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1e80100/SAMSUNG/galaxy-book4-edge/cdsp_dtbs.elf'
  install -Dm644 'samsung-basw-a4231a01-1063/Chipset/qcsubsys_ext_adsp_ss8380/qcadsp8380.mbn' "$fw"/'qcom/x1e80100/SAMSUNG/galaxy-book4-edge/qcadsp8380.mbn'
  install -Dm644 'samsung-basw-a4231a01-1063/Chipset/qcsubsys_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1e80100/SAMSUNG/galaxy-book4-edge/qccdsp8380.mbn'
  install -Dm644 'samsung-basw-a4231a01-1063/Graphics/qcdx8380_ss/qcdxkmsuc8380.mbn' "$fw"/'qcom/x1e80100/SAMSUNG/galaxy-book4-edge/qcdxkmsuc8380.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
d1e1c65ef72248c9bc5beab16594340340dde34331406d19cf96c6690e0c3582  qcom/x1e80100/SAMSUNG/galaxy-book4-edge/adsp_dtbs.elf
b8d18cbc6d955721bb73efa732c66f4d7978554f6a5e699f131c6bd35fa1fcbd  qcom/x1e80100/SAMSUNG/galaxy-book4-edge/cdsp_dtbs.elf
99155b4cb309dc3d873a4fd617c0da12161f6c6d25a07b35ff47f95342ec5b64  qcom/x1e80100/SAMSUNG/galaxy-book4-edge/qcadsp8380.mbn
4c1a9028ff3c8eb942a2cf5a7c8ed13182098ea022f1bd9f31f728c0b1d453de  qcom/x1e80100/SAMSUNG/galaxy-book4-edge/qccdsp8380.mbn
a3a75134e11f2d4eed88288c38f533cc66a3a5f8e13d2317238d79acb9417cd3  qcom/x1e80100/SAMSUNG/galaxy-book4-edge/qcdxkmsuc8380.mbn
SUMS
  )
}
