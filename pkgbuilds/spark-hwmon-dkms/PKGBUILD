prepare() {
  cd "$_srcname"
  # The firmware lets PL1 rise to 250 W, above the GB10's 140 W rating, so
  # the power limits stay read-only unless allow_power_cap=1 is set.
  patch -Np1 -i "$srcdir/0001-read-only-power-limits-and-bounded-offsets.patch"
  # Linux 7.3 has no acpi_driver; NVDA8800 binds as a platform device there.
  patch -Np1 -i "$srcdir/0002-bind-as-a-platform-driver-on-linux-7.3.patch"
  patch -Np1 -i "$srcdir/0003-p16-bios-independent-read-only-fallback.patch"
  install -m644 "$srcdir/"{n1x-p16-readonly.h,n1x-acpi.h,n1x-mmio.h} "$srcdir/$_srcname/"
}

check() {
  local kernel_build=${SPBM_KERNEL_BUILD:-}
  if [[ -z $kernel_build ]]; then
    local builds=(/usr/lib/modules/*/build/Makefile)
    [[ -e ${builds[0]:-} ]] || { error 'installed kernel headers are required'; return 1; }
    kernel_build=${builds[0]%/Makefile}
  fi
  [[ -f $kernel_build/Makefile ]] || { error "kernel headers missing: $kernel_build"; return 1; }
  local kver
  kver=$(<"$kernel_build/include/config/kernel.release")
  if [[ -n ${SPBM_EXPECT_KERNEL_RELEASE:-} && $kver != "$SPBM_EXPECT_KERNEL_RELEASE" ]]; then
    error "expected kernel $SPBM_EXPECT_KERNEL_RELEASE but selected $kver"
    return 1
  fi
  "${CC:-cc}" -std=c11 -Wall -Wextra -Werror -I"$srcdir/$_srcname" \
    "$srcdir/test_n1x_readonly.c" -o "$srcdir/test_n1x_readonly"
  "$srcdir/test_n1x_readonly"
  rm -rf "$srcdir/check" "$srcdir/check-src"
  mkdir -p "$srcdir/check/dkms" "$srcdir/check/src"
  _install_source "$srcdir/check-src/spbm-$pkgver"
  local dkms_options=(--dkmstree "$srcdir/check/dkms" --sourcetree "$srcdir/check/src" -k "$kver")
  fakeroot dkms "${dkms_options[@]}" add "$srcdir/check-src/spbm-$pkgver"
  fakeroot dkms "${dkms_options[@]}" build "spbm/$pkgver"
}

package() {
  _install_source "$pkgdir/usr/src/spbm-$pkgver"
}

_install_source() {
  install -Dm644 -t "$1" "$srcdir/$_srcname"/{spbm.c,Makefile,n1x-p16-readonly.h,n1x-acpi.h,n1x-mmio.h}
  sed "s/@PKGVER@/$pkgver/" "$srcdir/dkms.conf" >"$1/dkms.conf"
}
