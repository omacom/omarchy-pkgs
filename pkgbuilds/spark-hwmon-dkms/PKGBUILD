# Maintainer: Jim Martin <jimmartin@gmail.com>

_srcname=spark_hwmon
pkgname=spark-hwmon-dkms
pkgver=0+git.27
pkgrel=2
_commit=352c76e538cadece0e4887a153fef95f8f5ea1d4
pkgdesc='Power, energy and limit telemetry for NVIDIA GB10 systems (DGX Spark) as hwmon sensors (DKMS)'
arch=('aarch64')
url='https://github.com/antheas/spark_hwmon'
license=('GPL-2.0-only')
depends=('dkms')
makedepends=('git')
checkdepends=('fakeroot' 'linux-omarchy-headers')
source=("git+$url.git#commit=$_commit"
        'dkms.conf'
        '0001-read-only-power-limits-and-bounded-offsets.patch'
        '0002-bind-as-a-platform-driver-on-linux-7.3.patch')
sha256sums=('SKIP'
            'a715677c8bb6d69a7eb7a1d13be8632592c2de883fc71a2ad6e94e3e7c10ee9e'
            '82dbc7f91767ddf0636b086526a2914a0327353eb1a51a35f6c97f1b398ec8a6'
            '7fdc1657fdd3615017de820ae9a09621a694662ab904887aaf3d6859150020ea')

prepare() {
  cd "$_srcname"
  # The firmware lets PL1 rise to 250 W, above the GB10's 140 W rating, so
  # the power limits stay read-only unless allow_power_cap=1 is set.
  patch -Np1 -i "$srcdir/0001-read-only-power-limits-and-bounded-offsets.patch"
  # Linux 7.3 has no acpi_driver; NVDA8800 binds as a platform device there.
  patch -Np1 -i "$srcdir/0002-bind-as-a-platform-driver-on-linux-7.3.patch"
}

check() {
  local build=(/usr/lib/modules/*/build)
  local kver=${build[0]%/build}
  kver=${kver##*/}
  rm -rf "$srcdir/check" "$srcdir/check-src"
  mkdir -p "$srcdir/check/dkms" "$srcdir/check/src"
  _install_source "$srcdir/check-src/spbm-$pkgver"
  local dkms_options=(--dkmstree "$srcdir/check/dkms" --sourcetree "$srcdir/check/src" -k "$kver")
  fakeroot dkms "${dkms_options[@]}" add "$srcdir/check-src/spbm-$pkgver"
  fakeroot dkms "${dkms_options[@]}" build "spbm/$pkgver"
}

package() {
  _install_source "$pkgdir/usr/src/spbm-$pkgver"
}

_install_source() {
  install -Dm644 -t "$1" "$srcdir/$_srcname"/{spbm.c,Makefile}
  sed "s/@PKGVER@/$pkgver/" "$srcdir/dkms.conf" >"$1/dkms.conf"
}
