pkgname=agent-desktops
pkgver=0.3.2
pkgrel=1
pkgdesc='Watch and control agents working in background Hyprland desktops'
arch=('x86_64' 'aarch64')
url='https://github.com/not-compromised/agent-desktops'
license=('MIT' 'Apache-2.0' 'BSD-3-Clause' 'ISC' 'MPL-2.0' 'OFL-1.1')
depends=(
  'bash' 'nodejs>=20' 'python>=3.11' 'python-gobject' 'gtk3' 'webkit2gtk-4.1'
  'wayland' 'libxkbcommon' 'hyprland>=0.55' 'jq' 'grim' 'at-spi2-core' 'xorg-xwayland' 'wayvnc' 'systemd'
)
makedepends=('npm' 'gcc' 'make' 'pkgconf')
optdepends=(
  'omarchy: desktop lifecycle notifications and theme integration'
  't3code-nightly-bin: optional T3 V2 conversation support'
)
source=("${url}/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('6101e74e9167af77ac7cb063d0f3bc9143252973933f09a9678a93dd2af9ca86')
options=('!strip' '!debug')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  bash scripts/build-native.sh
  npm ci --omit=dev --ignore-scripts --no-audit --no-fund --cache "${srcdir}/npm-cache"
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  node --input-type=module -e "await import('./mcp/lib/server.js'); await import('./app/server.mjs')"
  PYTHONPYCACHEPREFIX="${srcdir}/pycache" python -m py_compile install.py app/agent-desktops app/watch.py app/theme.py
  bash -n bin/agent-desktop bin/agent-desktops
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  local runtime="${pkgdir}/usr/lib/${pkgname}"
  install -dm755 "$runtime" "${pkgdir}/usr/bin"
  cp -a app bin config docs mcp shared skill native node_modules package.json package-lock.json install.py README.md LICENSE "$runtime/"
  rm -rf "$runtime/app/test" "$runtime/mcp/test" "$runtime/native/test"
  find "$runtime" -type d -name __pycache__ -prune -exec rm -rf {} +
  touch "$runtime/.packaged"
  ln -s "/usr/lib/${pkgname}/bin/agent-desktop" "${pkgdir}/usr/bin/agent-desktop"
  ln -s "/usr/lib/${pkgname}/bin/agent-desktops" "${pkgdir}/usr/bin/agent-desktops"
  install -Dm644 app/agent-desktops.desktop "${pkgdir}/usr/share/applications/org.omarchy.AgentDesktops.desktop"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  cp -a docs "${pkgdir}/usr/share/doc/${pkgname}/docs"
  install -Dm644 native/LICENSE.omabox "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.omabox"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 mcp/viewer/font-license.txt "${pkgdir}/usr/share/licenses/${pkgname}/font-license.txt"
}
