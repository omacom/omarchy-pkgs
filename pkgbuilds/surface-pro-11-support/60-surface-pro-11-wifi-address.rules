# ath12k reports a placeholder as the Surface Pro 11's Wi-Fi address; set the
# real one on each WCN7850 interface while udev adds it, before NetworkManager
# takes the interface. The script does nothing on other machines.
ACTION=="add", SUBSYSTEM=="net", ENV{DEVTYPE}=="wlan", DRIVERS=="ath12k_pci|ath12k_wifi7_pci", \
  RUN+="/usr/lib/surface-pro-11-support/surface-pro-11-wifi-address %k"
