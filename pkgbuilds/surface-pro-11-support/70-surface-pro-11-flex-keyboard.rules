# Surface Flex Keyboard on the Surface Pro 11. The keyboard's wired endpoint
# (045E:0C8B) appears when it is attached and goes away when it is detached.

# Attached: make sure it is paired over Bluetooth, pairing over the wire if
# it is not or if its bond stopped working (another host re-keyed it).
ACTION=="add", SUBSYSTEM=="hid", ENV{HID_NAME}=="*045E:0C8B*", \
  RUN+="/usr/bin/systemctl --no-block start surface-pro-11-flex-autopair.service"

# Detached: connect it over Bluetooth.
ACTION=="remove", SUBSYSTEM=="hid", ENV{HID_NAME}=="*045E:0C8B*", \
  RUN+="/usr/bin/systemctl --no-block start surface-pro-11-flex-reconnect.service"
