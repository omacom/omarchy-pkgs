#!/bin/bash

# Arm the Surface Pro 11's lid wake only when it suspends with the lid closed.
#
# With the lid open, the lid line (gpio2) shows a false edge about 0.3 s after
# the SoC collapses CX in suspend, and since lid wake is on by default that
# wakes the machine at once. With the lid closed it does not, so closing the
# cover to sleep and opening it to wake keeps working. The power button wakes
# the machine either way.

[[ ${1:-} == pre ]] || exit 0

compatible=${SP11_LID_WAKE_COMPATIBLE:-/proc/device-tree/compatible}
wakeup=${SP11_LID_WAKE_SYSFS:-/sys/devices/platform/gpio-keys/power/wakeup}

[[ -r $compatible ]] && tr '\0' '\n' <"$compatible" | grep -qx 'microsoft,denali-oled' || exit 0
[[ -w $wakeup ]] || exit 0

# Unknown lid state counts as open: a missed wake is better than a wake loop.
closed=$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
  org.freedesktop.login1.Manager LidClosed 2>/dev/null)

if [[ $closed == "b true" ]]; then
  echo enabled >"$wakeup" && echo "surface-pro-11-lid-wake: lid closed, lid wake armed"
else
  echo disabled >"$wakeup" && echo "surface-pro-11-lid-wake: lid open, lid wake off"
fi
