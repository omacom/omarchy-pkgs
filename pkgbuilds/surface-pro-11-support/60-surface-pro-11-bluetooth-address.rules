# The Surface Pro 11's WCN7850 registers as an unconfigured controller until
# it is given a public address; configure each one as it appears.
SUBSYSTEM=="bluetooth", ENV{DEVTYPE}=="host", SUBSYSTEMS=="serial", DRIVERS=="hci_uart_qca", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}+="surface-pro-11-bluetooth-address@%k.service"
