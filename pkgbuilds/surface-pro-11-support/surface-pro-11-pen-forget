#!/bin/bash
# Forget the paired Surface Slim Pen(s). Run surface-pro-11-pen-pair to pair again.
set -u
found=0
while read -r _ addr name; do
  [[ $name == *"Slim Pen"* ]] || continue
  found=1
  if bluetoothctl remove "$addr" >/dev/null 2>&1; then
    printf 'Forgot %s (%s).\n' "$name" "$addr"
  else
    printf 'Could not forget %s (%s).\n' "$name" "$addr" >&2
  fi
done < <(bluetoothctl devices 2>/dev/null)
(( found )) || echo "No Surface Slim Pen is paired."
