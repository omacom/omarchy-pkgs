# Maintainer: Brandon Williams <turbine.bmw@gmail.com>

# Hardware support for the Microsoft Surface Pro 11 (Snapdragon X Elite, OLED)
# that no upstream package carries yet.

pkgname=surface-pro-11-support
pkgver=1
pkgrel=1
pkgdesc="Hardware support for the Microsoft Surface Pro 11 (Snapdragon X Elite) not yet carried upstream"
arch=('aarch64')
# Qualcomm-only: the pacman platform guard keeps it off other hardware.
groups=('omarchy-platform-qualcomm')
url="https://github.com/omacom/omarchy-pkgs"
license=('MIT' 'BSD-3-Clause' 'LicenseRef-QualcommAtheros-ath10k')
depends=('alsa-ucm-conf' 'bluez-utils' 'power-profiles-daemon' 'python' 'python-dbus' 'python-gobject')
optdepends=('iptsd: pen and touch, restarted across suspend by this package')
makedepends=('alsa-ucm-conf' 'alsa-utils' 'git' 'linux-firmware-atheros' 'm4' 'python' 'zstd')
# The board data is an ELF image; stripping it corrupts the record.
options=('!debug' '!strip')
_audioreach_commit=d7a5e9d80ad18a7a6844eeb32cacbdeea0e7e677
source=(
  "audioreach-topology::git+https://github.com/linux-msm/audioreach-topology.git#commit=${_audioreach_commit}"
  'X1E80100-Microsoft-Surface-Pro-11.m4'
  'MICROSOFT-Surface-Pro-11.conf'
  'Surface11-HiFi.conf'
  'extract-ath12k-board.py'
  '50-surface-pro-11-cameras.conf'
  'surface-pro-11-charge-limit-sleep'
  'surface-pro-11-iptsd-sleep'
  'surface-pro-11-bluetooth-address'
  'surface-pro-11-bluetooth-address@.service'
  '60-surface-pro-11-bluetooth-address.rules'
  'surface-pro-11-power-profile-cpufreq'
  'surface-pro-11-power-profile-cpufreq.service'
  'README.package.md'
  'LICENSE'
)
sha256sums=('f571d0667e48da9967db20770beff426a5e0372836a8a2bb66cd806d43b0f580'
            '2da29b6e48e116a6247b5d449f69c96daa9fc7f78eea2f0679f65e10a05dea26'
            '507fdb64d31aa98f2ae0448cc0c165544143a86ccbf7feac9f56fc13f08b5642'
            '8b96bb34c0120ac122cef4ed959a19f7c2345e4721991b99db961a8c0d545d54'
            'feb8880bdca4c3061093d2b8aa2464efad9f2ff9a03cdb09a799da620a0791b4'
            'd2d12a13625950787a05d45674dca3f7f4e7bff7c01d0d3848486f70eb189767'
            '0cdfdfe344695536df0c197ce322567eeea197f4304b34f94b672ccc1163e842'
            '946d0a417a436b44b1218558b4af57d6978160882e389ba5d60c39e8daf22dea'
            '87a78d304c771ffbfdcde9e9431a2e0ab96191250a65f42a1348be7e72c6cef6'
            '962f8f3dafa7900c45c4efc02e7ffd7735da3d26a2ebe3cc37e139ee3e39134c'
            'ebd47b050c02d241c2722111d7c2161366ca48e922520d59bdc2e0baf1223f1c'
            '0681bfcbf25744dc4231be7806901e2dc8a2871b0d5136e74829ec541748cd1e'
            '2d26c129750ba4729734efb0d1be87a3c89e3a2c7e133a19380611e467a0fe55'
            '02779fbaa822e4b6d5462d38c6ec7b3abf9215c2614eefdb1ae03e5b6a1de175'
            'f74f925ccd6fc2f4b9bdf7682f6927a64809c8668e8232997c541cc6f992787b')

# The Surface reports generic WCN7850 identifiers (subsystem 17cb:1107,
# board-id 255) that match no board-2.bin entry. This is Qualcomm's own
# reference-design record from linux-firmware, not Surface calibration; it
# brings Wi-Fi up until linux-firmware carries a Surface Pro 11 entry.
_board_record='bus=pci,vendor=17cb,device=1107,subsystem-vendor=17cb,subsystem-device=3378,qmi-chip-id=2,qmi-board-id=255'
_board_bytes=88872
_board_sha256=0ef5f6f3cb124f33c6de52371819ccd7c13763ceb86d476a178fd56e4cdc26a3
# Deliberate tripwire: the topology must stay byte-identical to the one
# validated on the device. An alsa-utils change to alsatplg's output fails the
# build here and needs a fresh check on hardware before this value moves.
_topology_sha256=89b731f3f98fc2b84699bca39a56e390925a44a26d5aea80382cf617e00c08d8

build() {
  m4 -I "$srcdir/audioreach-topology" X1E80100-Microsoft-Surface-Pro-11.m4 >topology.conf
  alsatplg -c topology.conf -o X1E80100-Microsoft-Surface-Pro-11-tplg.bin
  echo "$_topology_sha256  X1E80100-Microsoft-Surface-Pro-11-tplg.bin" | sha256sum -c

  local container=/usr/lib/firmware/ath12k/WCN7850/hw2.0/board-2.bin
  if [[ ! -f $container && -f $container.zst ]]; then
    zstd -dq "$container.zst" -o board-2.bin
    container=board-2.bin
  fi
  rm -f board.bin
  python extract-ath12k-board.py --expected-bytes "$_board_bytes" \
    --expected-sha256 "$_board_sha256" "$container" "$_board_record" board.bin
}

package() {
  install -Dm644 board.bin "$pkgdir/usr/lib/firmware/ath12k/WCN7850/hw2.0/board.bin"
  install -Dm644 X1E80100-Microsoft-Surface-Pro-11-tplg.bin \
    "$pkgdir/usr/lib/firmware/qcom/x1e80100/X1E80100-Microsoft-Surface-Pro-11-tplg.bin"

  local ucm=/usr/share/alsa/ucm2
  install -Dm644 MICROSOFT-Surface-Pro-11.conf "$pkgdir$ucm/Qualcomm/x1e80100/MICROSOFT-Surface-Pro-11.conf"
  install -Dm644 Surface11-HiFi.conf "$pkgdir$ucm/Qualcomm/x1e80100/Surface11-HiFi.conf"
  install -d "$pkgdir$ucm/conf.d/x1e80100"
  local name
  for name in X1E80100-Microsoft-Surface-Pro-11.conf \
    MicrosoftCorporation-MicrosoftSurfacePro11thEdition-124I00117T000M0000000F0.conf; do
    ln -s ../../Qualcomm/x1e80100/MICROSOFT-Surface-Pro-11.conf "$pkgdir$ucm/conf.d/x1e80100/$name"
  done

  install -Dm644 50-surface-pro-11-cameras.conf \
    "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/50-surface-pro-11-cameras.conf"

  local lib=/usr/lib/$pkgname
  install -Dm755 surface-pro-11-bluetooth-address "$pkgdir$lib/surface-pro-11-bluetooth-address"
  install -Dm644 surface-pro-11-bluetooth-address@.service \
    "$pkgdir/usr/lib/systemd/system/surface-pro-11-bluetooth-address@.service"
  install -Dm644 60-surface-pro-11-bluetooth-address.rules \
    "$pkgdir/usr/lib/udev/rules.d/60-surface-pro-11-bluetooth-address.rules"
  install -Dm755 surface-pro-11-power-profile-cpufreq "$pkgdir$lib/surface-pro-11-power-profile-cpufreq"
  install -Dm644 surface-pro-11-power-profile-cpufreq.service \
    "$pkgdir/usr/lib/systemd/system/surface-pro-11-power-profile-cpufreq.service"
  install -Dm755 surface-pro-11-charge-limit-sleep "$pkgdir/usr/lib/systemd/system-sleep/surface-pro-11-charge-limit"
  install -Dm755 surface-pro-11-iptsd-sleep "$pkgdir/usr/lib/systemd/system-sleep/surface-pro-11-iptsd"

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/audioreach-topology/LICENSE.BSD-3-Clause" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.audioreach-topology"
  install -Dm644 /usr/share/licenses/alsa-ucm-conf/LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.alsa-ucm-conf"
  install -Dm644 /usr/share/licenses/linux-firmware-atheros/LICENSE.QualcommAtheros_ath10k \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.QualcommAtheros_ath10k"
}
