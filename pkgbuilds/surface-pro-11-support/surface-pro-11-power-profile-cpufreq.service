[Unit]
Description=Surface Pro 11 power-profile CPU frequency limits
ConditionFirmware=device-tree-compatible(microsoft,denali-oled)
After=power-profiles-daemon.service
Wants=power-profiles-daemon.service

[Service]
Type=simple
Environment=SP11_POWER_SAVER_MAX_KHZ=1920000
Environment=SP11_BALANCED_MAX_KHZ=2515200
ExecStart=/usr/lib/surface-pro-11-support/surface-pro-11-power-profile-cpufreq --watch
ExecStopPost=-/usr/lib/surface-pro-11-support/surface-pro-11-power-profile-cpufreq --restore-after-stop
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
# power-profiles-daemon is ordered after multi-user.target and wanted by
# graphical.target; following it from multi-user.target would be a cycle.
WantedBy=graphical.target
