pkgname=recur-bin
pkgver=0.5.0
pkgrel=1
pkgdesc='Run autonomous AI coding loops locally'
arch=('x86_64' 'aarch64')
url='https://recur.build'
license=('Elastic-2.0')
depends=('ca-certificates' 'gtk4' 'webkitgtk-6.0' 'gstreamer'
         'gst-plugins-base' 'gst-plugins-good' 'gst-plugins-bad' 'gst-libav'
         'libxkbcommon' 'libxkbcommon-x11' 'libxcb' 'wayland' 'vulkan-icd-loader'
         'xdg-utils')
provides=('recur')
conflicts=('recur')
options=('!strip' '!debug')
source=('LICENSE')
source_x86_64=("https://github.com/celestiaorg/recur-releases/releases/download/v${pkgver}/Recur-${pkgver}-linux-amd64.deb")
source_aarch64=("https://github.com/celestiaorg/recur-releases/releases/download/v${pkgver}/Recur-${pkgver}-linux-arm64.deb")
noextract=("Recur-${pkgver}-linux-amd64.deb" "Recur-${pkgver}-linux-arm64.deb")
sha256sums=('c6f14fb4db24cf53266dffe432f120836187591f7d36ac30f579ce51976548e3')
sha256sums_x86_64=('8f21bc643588a403b8e100cd212a504daaf55d8a468f32ef2693b449cb9f6259')
sha256sums_aarch64=('edc56100b110c70cbb932a24391699ad7e25b46ad6476ac9e6365d342f3b71d5')

package() {
  local debarch=amd64
  [[ $CARCH == aarch64 ]] && debarch=arm64
  bsdtar -xOf "Recur-${pkgver}-linux-${debarch}.deb" 'data.tar.*' |
    bsdtar --no-same-owner -xf - -C "$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
