{
  "source": "local",
  "auto_merge": true,
  "release_ring": "fast",
  "upstream": {
    "watch": {
      "npm": "cf",
      "pattern": "(?P<version>[0-9]+(?:\\.[0-9]+)*)(?P<sep>-?)(?P<pre>(?:[a-z]+\\.[0-9]+)?)",
      "version": "{version}{pre}",
      "variables": {
        "_npmver": "{version}{sep}{pre}"
      }
    }
  }
}
