{
  "source": "local",
  "auto_merge": true,
  "release_ring": "fast",
  "upstream": {
    "watch": {
      "regex": "https://registry.npmjs.org/-/package/cf/dist-tags",
      "pattern": "\"latest\":\"(?P<version>[0-9]+(?:\\.[0-9]+)*)(?P<sep>-?)(?P<pre>(?:[a-z]+\\.[0-9]+)?)\"",
      "version": "{version}{pre}",
      "variables": {
        "_npmver": "{version}{sep}{pre}"
      }
    }
  }
}
