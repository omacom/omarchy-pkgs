# Maintainer: The Omarchy Authors
# Cloudflare publishes cf only to npm, with no standalone build. Its native
# parts, the workerd executable and sharp's N-API addon, are prebuilt and do
# not depend on the Node version, so it can follow npm on the fast ring.
# npm's `latest` tag is a release candidate today; pkgver drops the hyphen so
# 1.0.0rc.4 sorts below 1.0.0.
pkgname=cloudflare-cli
pkgver=1.0.0rc.6
_npmver=1.0.0-rc.6
pkgrel=1
pkgdesc="The Cloudflare CLI (cf)"
arch=('x86_64' 'aarch64')
url="https://github.com/cloudflare/cf"
license=('MIT OR Apache-2.0')
depends=('nodejs' 'glibc' 'gcc-libs')
makedepends=('npm')
optdepends=('cloudflared: use the system binary for tunnels instead of a downloaded copy')
# Cloud Foundry's CLI packages and the AUR's cloudflare-cf also install /usr/bin/cf.
conflicts=('cloudfoundry-cli' 'cloudfoundry6-cli' 'cloudflare-cf')
options=('!strip' '!debug')
source=("cf-${_npmver}.tgz::https://registry.npmjs.org/cf/-/cf-${_npmver}.tgz")
sha256sums=('2077439f5b68a9eb348911c268eec6ce49ae529d114c98e3fabf1c684b4b4e50')
noextract=("cf-${_npmver}.tgz")

package() {
  # npm fetches only this system's workerd and sharp binaries. It links both
  # the cf and cloudflare commands into /usr/bin.
  npm install --global --ignore-scripts --omit=dev --no-audit --no-fund \
    --cache "${srcdir}/npm-cache" --prefix "${pkgdir}/usr" "${srcdir}/cf-${_npmver}.tgz"

  local _mod="${pkgdir}/usr/lib/node_modules/cf"

  # pacman updates this install, so cf's daily check of npm would only point at
  # a `cf update` that cannot replace it. cf has no switch for the check, so
  # stub out the module that starts it and reads its result.
  local _checks=($(grep -l maybeStartBackgroundUpdateCheck "${_mod}"/dist/update-check-*.mjs))
  if (( ${#_checks[@]} != 1 )); then
    echo "Expected one update-check module, found ${#_checks[@]}" >&2
    return 1
  fi
  printf '%s\n' 'export function getUpdateNotice() {}' 'export function maybeStartBackgroundUpdateCheck() {}' >"${_checks[0]}"

  chown -R root:root "${pkgdir}/usr"
  install -Dm644 "${_mod}/LICENSE-MIT" "${_mod}/LICENSE-APACHE" -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
