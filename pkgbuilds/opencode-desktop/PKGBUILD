pkgname=opencode-desktop
pkgver=2.2.0
pkgrel=1
pkgdesc='Open source AI coding agent desktop app'
arch=('x86_64' 'aarch64')
url='https://opencode.ai'
license=('MIT')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'bash'
  'cairo'
  'dbus'
  'expat'
  'gcc-libs'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libnotify'
  'libsecret'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'libxss'
  'libxtst'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'util-linux-libs'
  'xdg-utils'
)
optdepends=('libappindicator-gtk3: tray icon support')
conflicts=('opencode-desktop-bin' 'opencode-desktop-git')
makedepends=('asar' 'libarchive')
options=('!strip' '!debug')

_deb_x86_64="${pkgname}-${pkgver}-amd64.deb"
_deb_aarch64="${pkgname}-${pkgver}-arm64.deb"
source=('opencode-desktop.sh' 'disable-updater.cjs' 'LICENSE')
source_x86_64=("${_deb_x86_64}::https://github.com/anomalyco/opencode/releases/download/v${pkgver}/opencode-desktop-linux-amd64.deb")
source_aarch64=("${_deb_aarch64}::https://github.com/anomalyco/opencode/releases/download/v${pkgver}/opencode-desktop-linux-arm64.deb")
noextract=("${_deb_x86_64}" "${_deb_aarch64}")
sha256sums=('e458054bd0c00cbcd2f2686ca676b93d42685cf337bca134a91a0c3b3bc1762a'
            'd3f398326afa4a875196a20c871593e09ba0e684eb785d0d6776ee950a982a0e'
            '625f0f619133f89bbbb2abe37369613dfa1885eba1e50d02170deb62bb42cb6b')
sha256sums_x86_64=('0825bae71f87a5ab6e2c1fe362c17441fe3381e3c65c8ccd3e6fd35386d74b62')
sha256sums_aarch64=('74819859fd0e98f42b78e9b68420f1628e334b6d626bb0222ce1516be9d08bf4')

prepare() {
  local deb_var="_deb_${CARCH}"
  rm -rf "${srcdir}/extracted" "${srcdir}/app"
  mkdir "${srcdir}/extracted"
  bsdtar -xOf "${srcdir}/${!deb_var}" data.tar.xz |
    bsdtar --no-same-owner -xf - -C "${srcdir}/extracted"

  local resources="${srcdir}/extracted/opt/OpenCode/resources"
  asar extract "${resources}/app.asar" "${srcdir}/app"
  node "${srcdir}/disable-updater.cjs" "${srcdir}/app"
  rm -rf "${resources}/app.asar" "${resources}/app.asar.unpacked"
  asar pack "${srcdir}/app" "${resources}/app.asar" --unpack-dir 'node_modules/@lydell'
}

package() {
  cp -a --no-preserve=ownership "${srcdir}/extracted/." "${pkgdir}/"

  # Keep the upstream app ID, icons, metainfo and opencode:// handler. Both
  # the canonical and hidden compatibility entry must use the Wayland launcher.
  install -Dm755 "${srcdir}/opencode-desktop.sh" "${pkgdir}/usr/bin/opencode-desktop"
  sed -i 's|^Exec=.*|Exec=opencode-desktop %U|' \
    "${pkgdir}/usr/share/applications/ai.opencode.desktop.desktop" \
    "${pkgdir}/usr/share/applications/opencode-desktop.desktop"

  # Leave /usr/bin/opencode to the independently installed terminal agent.
  # The upstream deb's update-alternatives hook is not run by pacman.
  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${pkgdir}/opt/OpenCode/LICENSE.electron.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.electron.txt"
  install -Dm644 "${pkgdir}/opt/OpenCode/LICENSES.chromium.html" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSES.chromium.html"

  # Omarchy supports unprivileged user namespaces: use Chromium's namespace
  # sandbox rather than a build-host probe or disabling the sandbox.
  chmod 0755 "${pkgdir}/opt/OpenCode/chrome-sandbox"
  rm -rf "${pkgdir}/usr/share/doc"
}
