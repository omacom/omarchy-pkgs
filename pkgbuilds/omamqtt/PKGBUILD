# Maintainer: Michael Frost Billing <michael dot frost dot billing at gmail dot com>

pkgname=omamqtt
pkgver=0.13.0
pkgrel=1
pkgdesc='Keyboard-driven MQTT v5 explorer for the terminal, in Omarchy colours (fss-mqtt)'
arch=('x86_64' 'aarch64')
url='https://github.com/mbilling/fss-mqtt'
license=('MIT OR Apache-2.0')
depends=('glibc' 'hicolor-icon-theme' 'libgcc' 'xdg-terminal-exec')
makedepends=('cargo')
# makepkg's LTO flags turn ring's C into GCC LTO objects, which Rust's linker
# can't link (the release profile has its own LTO).
options=('!debug' '!lto')
source=("fss-mqtt-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('1482b0f660a86244c8f29b0059b2254555baf781fecee14a53632ab6d4cd1d0d')

prepare() {
  cd "fss-mqtt-$pkgver"

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "fss-mqtt-$pkgver"

  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "fss-mqtt-$pkgver"

  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "fss-mqtt-$pkgver"

  # Started as omamqtt, fss-mqtt goes by OmaMQTT in the Omarchy theme's colours.
  install -Dm755 target/release/fss-mqtt "$pkgdir/usr/bin/omamqtt"
  install -Dm644 packaging/omarchy/omamqtt.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/omarchy/omamqtt.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname"
}
