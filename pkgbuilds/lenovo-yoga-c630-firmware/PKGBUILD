# Audio DSP, compute DSP, GPU, video, modem and sensor DSP firmware for the Lenovo Yoga C630. The
# firmware only runs if it is signed for this board by Lenovo, so linux-firmware cannot carry it
# until the OEM submits it. The OEM ships it in the driver bundle it publishes for the machine on
# Windows Update, whose cabinets this recipe fetches with wudrivers and unpacks without running
# anything. Each file is checked against the SHA-256 it was matched to and installed under the
# name the device tree requests, compressed with xz. The kernel tries a plain name, then .zst,
# then .xz, so once linux-firmware ships the same file, its copy is the one loaded, and the two
# packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=lenovo-yoga-c630-firmware
pkgver=20261115
pkgrel=1
pkgdesc='Audio DSP, compute DSP, GPU, video, modem and sensor DSP firmware for the Lenovo Yoga C630'
arch=('aarch64')
url='https://github.com/birkskyum/wudrivers'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-sdm850-lenovo-81jl')
makedepends=('7zip' 'wudrivers')
options=('!strip' '!debug')
# Windows Update's links are short-lived, so wudrivers fetches a fresh one by update ID, revision and SHA-1.
DLAGENTS+=('wu::/usr/bin/wudrivers fetch %u -o %o')
source=(
  'lenovo-81jl-wu-200.0.16.0-qcsubsys850.cab::wu://9fdf0fab-06de-463a-948a-b08a3fea73ac/1/d4b09fb5172dc20174961b7689c1c52c9e31af34'
  'lenovo-81jl-wu-200.0.16.0-qcdx850.cab::wu://9fdf0fab-06de-463a-948a-b08a3fea73ac/1/ec8ddf9a902ecec56bc1f5e2de8f9f18d6c70585'
  'lenovo-81jl-wu-200.0.16.0-qcipa850.cab::wu://9fdf0fab-06de-463a-948a-b08a3fea73ac/1/ba6078acaba6fa9e6a3ae480cf0ef942bb32df26'
)
source+=('README.package.md')
noextract=('lenovo-81jl-wu-200.0.16.0-qcsubsys850.cab' 'lenovo-81jl-wu-200.0.16.0-qcdx850.cab' 'lenovo-81jl-wu-200.0.16.0-qcipa850.cab')
sha256sums=('2cea11f9aa914534603d1fade853ceface9c770ae1cc132f3f6f89e764bd764a' '8eeba54f315a905f71acb230f4597540cd8b68ec0cdf04b0e0fc0cad19ab08af' 'cf523bc799ecb5d834f7a1eec76133e3969e85e7ad6ecd61d1fd42447da28827')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'lenovo-81jl-wu-200.0.16.0-qcsubsys850.cab' 'lenovo-81jl-wu-200.0.16.0-qcsubsys850' 7z
  _unpack 'lenovo-81jl-wu-200.0.16.0-qcdx850.cab' 'lenovo-81jl-wu-200.0.16.0-qcdx850' 7z
  _unpack 'lenovo-81jl-wu-200.0.16.0-qcipa850.cab' 'lenovo-81jl-wu-200.0.16.0-qcipa850' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'lenovo-81jl-wu-200.0.16.0-qcipa850/ipa_fws.elf' "$fw"/'qcom/sdm850/LENOVO/81JL/ipa_fws.elf'
  install -Dm644 'lenovo-81jl-wu-200.0.16.0-qcsubsys850/qcadsp850.mbn' "$fw"/'qcom/sdm850/LENOVO/81JL/qcadsp850.mbn'
  install -Dm644 'lenovo-81jl-wu-200.0.16.0-qcsubsys850/qccdsp850.mbn' "$fw"/'qcom/sdm850/LENOVO/81JL/qccdsp850.mbn'
  install -Dm644 'lenovo-81jl-wu-200.0.16.0-qcsubsys850/qcdsp1v2850.mbn' "$fw"/'qcom/sdm850/LENOVO/81JL/qcdsp1v2850.mbn'
  install -Dm644 'lenovo-81jl-wu-200.0.16.0-qcsubsys850/qcdsp2850.mbn' "$fw"/'qcom/sdm850/LENOVO/81JL/qcdsp2850.mbn'
  install -Dm644 'lenovo-81jl-wu-200.0.16.0-qcdx850/qcdxkmsuc850.mbn' "$fw"/'qcom/sdm850/LENOVO/81JL/qcdxkmsuc850.mbn'
  install -Dm644 'lenovo-81jl-wu-200.0.16.0-qcsubsys850/qcslpi850.mbn' "$fw"/'qcom/sdm850/LENOVO/81JL/qcslpi850.mbn'
  install -Dm644 'lenovo-81jl-wu-200.0.16.0-qcdx850/qcvss850.mbn' "$fw"/'qcom/sdm850/LENOVO/81JL/qcvss850.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
74c8c6774b255fc328dc1b2a2826249e137348bee093f2817632f5a563e06838  qcom/sdm850/LENOVO/81JL/ipa_fws.elf
f733b9ba8288c58e9ed18c5ef4a2a85668007d32944002290b311f1e2105bb82  qcom/sdm850/LENOVO/81JL/qcadsp850.mbn
4f45c8d6e14e655c6913aab556ed5cbf6ee216837aeda24eb03540f8103c664a  qcom/sdm850/LENOVO/81JL/qccdsp850.mbn
934004f04eecc6c1d801a65dea58eb960ddef55836832d83b5490b33aae2ebb2  qcom/sdm850/LENOVO/81JL/qcdsp1v2850.mbn
d4ecfa7bf247acb50998076925776919f15f33924346f3a96ec6f1ab86926ff0  qcom/sdm850/LENOVO/81JL/qcdsp2850.mbn
42cc524529adea502442c7c0541af1ac1d0b1365cebae830fcc523f062a13ace  qcom/sdm850/LENOVO/81JL/qcdxkmsuc850.mbn
edb1632cb8a30d85875826a3cfae24605443955551a2f5fe7c5f4ae80e85be8b  qcom/sdm850/LENOVO/81JL/qcslpi850.mbn
caf0cfac983c90ea1097ab4a2d184754151288c81a85a5daa053dd2fcc007ca3  qcom/sdm850/LENOVO/81JL/qcvss850.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
