# Maintainer: HANCORE

pkgname=rumb
pkgver=0.1.5
pkgrel=1
pkgdesc='Read-only dashboard of pending updates and current problems on Arch and Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/HANCORE-linux/rumb'
license=('MIT')
depends=('bash' 'curl' 'fakeroot' 'gcc-libs' 'glibc' 'jq' 'pacman-contrib' 'systemd')
makedepends=('cargo')
optdepends=(
  'hyprland: Hyprland version and config errors'
  'libxml2: Arch news'
  'paru: AUR update check'
  'yay: AUR update check'
)
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('4065f071a3530fb034b8dd13422e91230c06b34aa7c600dbe0a7bb4f860bcab7')

prepare() {
  cd "$pkgname-$pkgver/tui"

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver/tui"

  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver/tui"

  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"

  make install DESTDIR="$pkgdir" PREFIX=/usr
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
