# Maintainer: Greg O'Byrne <greg.obyrne@gmail.com>

pkgname=markdowngonzo
pkgver=1.0.0
pkgrel=1
pkgdesc="A focused, local-first Markdown editor"
arch=('x86_64')
url="https://github.com/gregoftheweb/MarkDownGonzo"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3')
optdepends=('libreoffice-fresh: export documents to PDF'
            'libreoffice-still: export documents to PDF')
makedepends=('cargo' 'nodejs' 'npm')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('8d210cc878c347169175c54d20abb9323aed4cc25bad6ea9c305877ad26d355d')

_dir="MarkDownGonzo-$pkgver/markdowngonzo"

prepare() {
  cd "$_dir"
  npm ci
}

build() {
  cd "$_dir"
  npm run build
  cargo build --manifest-path src-tauri/Cargo.toml --release --frozen
}

check() {
  cd "$_dir"
  npm test
  cargo test --manifest-path src-tauri/Cargo.toml --frozen
}

package() {
  cd "$_dir"

  install -Dm755 src-tauri/target/release/markdowngonzo "$pkgdir/usr/bin/markdowngonzo"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -Dm644 packaging/linux/markdowngonzo.desktop \
    "$pkgdir/usr/share/applications/markdowngonzo.desktop"
  install -Dm644 packaging/linux/com.columbiafoundry.markdowngonzo.metainfo.xml \
    "$pkgdir/usr/share/metainfo/com.columbiafoundry.markdowngonzo.metainfo.xml"
  install -Dm644 packaging/linux/markdowngonzo.xml \
    "$pkgdir/usr/share/mime/packages/markdowngonzo.xml"

  for size in 32 64 128; do
    install -Dm644 "src-tauri/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/markdowngonzo.png"
  done
  install -Dm644 src-tauri/icons/128x128@2x.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/markdowngonzo.png"
}
