# Maintainer: The SculptForge contributors <https://github.com/islandmed/SculptForge>

pkgname=sculptforge
pkgver=0.10.5
pkgrel=1
pkgdesc='Free, open-source digital sculpting app with ZBrush-style tools'
arch=('x86_64' 'aarch64')
url='https://sculptforge.app/'
license=('GPL-3.0-or-later')
depends=('sdl3' 'curl' 'gcc-libs' 'glibc' 'libglvnd')
makedepends=('cmake')
optdepends=('ollama: local AI for the Brush Lab'
            'ffmpeg: recording demo videos (sculptforge --record)')
_imgui=1.91.9
_glm=1.0.1
source=("$pkgname-$pkgver.tar.gz::https://github.com/islandmed/SculptForge/archive/refs/tags/v$pkgver.tar.gz"
        "imgui-$_imgui.tar.gz::https://github.com/ocornut/imgui/archive/refs/tags/v$_imgui.tar.gz"
        "glm-$_glm.tar.gz::https://github.com/g-truc/glm/archive/refs/tags/$_glm.tar.gz")
sha256sums=('d17e821c4e7ae10c228da26999175214e5fd287dec4e385a8eb274754b9a482d'
            '3872a5f90df78fced023c1945f4466b654fd74573370b77b17742149763a7a7c'
            '9f3174561fd26904b23f0db5e560971cbf9b3cbda0b280f04d5c379d03bf234c')

build() {
  # The face-shape fast path is tested to match a full evaluation exactly; keep both rounding the same way.
  CXXFLAGS+=' -ffp-contract=off'
  # Dear ImGui and GLM come from the sources above, so the build needs no network. The update check is off
  # (pacman updates the package), and so is the live face feed over WebRTC, which would fetch five more
  # libraries; phone capture and AR still work.
  cmake -S "SculptForge-$pkgver" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DSCULPTFORGE_USE_SYSTEM_SDL=ON \
    -DSCULPTFORGE_UPDATE_CHECK=OFF \
    -DSCULPTFORGE_WEBRTC=OFF \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
    -DFETCHCONTENT_SOURCE_DIR_IMGUI="$srcdir/imgui-$_imgui" \
    -DFETCHCONTENT_SOURCE_DIR_GLM="$srcdir/glm-$_glm"
  cmake --build build
}

check() {
  # The UI tests open a window; the unit tests don't need a display.
  ctest --test-dir build --output-on-failure -LE ui
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
