pkgrel=1
pkgdesc="Owner-local AI persona with a character, tools, and an Omarchy-native desktop shell"
arch=('any')
url="https://github.com/ferdousbhai/ghost"
license=('Apache-2.0')
depends=(
  'at-spi2-core>=2.58'
  'bun>=1.3.14'
  'fd'
  'grim>=1.5'
  'hyprland>=0.56'
  'libnotify>=0.8'
  'python>=3.11'
  'python-dbus>=1.4'
  'python-gobject>=3.50'
  'python-pillow>=10'
  'qrencode'
  'ripgrep'
  'systemd'
  'qt6-5compat>=6.8'
  'quickshell>=0.3'
  'wtype>=0.4'
  'xdg-utils>=1.2'
