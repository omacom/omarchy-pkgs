# Maintainer: Ferdous Bhai <https://github.com/ferdousbhai>

pkgname=ghost
pkgver=0.14.2
pkgrel=1
pkgdesc="Your own ghost, answered by a model on your machine"
# Native code, built per architecture.
arch=('x86_64' 'aarch64')
url="https://github.com/ferdousbhai/ghost"
license=('Apache-2.0')
depends=(
  'curl'
  'glib2'
  'gtk4>=4.14'
  'gtk4-layer-shell'
  'jq'
  'systemd'
)
makedepends=(
  'cargo'
  'desktop-file-utils'
)
optdepends=(
  'chromium: optional signed-in browser automation with agent-browser'
  'tailscale: reaching the ghost from a phone, over Tailscale Serve'
)
# 0.11.9 and earlier split the daemon out as ghost-runtime.
conflicts=(ghost-runtime)
replaces=(ghost-runtime)
install=ghost.install
options=('!debug' '!lto' '!strip')

# Omarchy's sync-upstream follows the GitHub release named in
# .omarchy/package.json and rewrites pkgver and the checksum.
source=("ghost-${pkgver}.tar.gz::https://github.com/ferdousbhai/ghost/releases/download/v${pkgver}/ghost-${pkgver}.tar.gz")
sha256sums=('9809d36c96eb722a9b8c75c714f3467b25e2a7ede9573032de9bb91ad9b50313')

# cargo for build() and check() alike, with no build or home folder in a
# panic message. The same flags in both: with others, check() would compile
# everything again and leave its own ghostd and ghost for package().
_cargo() {
  RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo" \
    cargo "$@"
}

prepare() {
  cd -- "$srcdir/ghost-${pkgver}"
  # Everything the build downloads, it downloads here, from the lockfile.
  cargo fetch --locked
}

build() {
  cd -- "$srcdir/ghost-${pkgver}"
  _cargo build --frozen --release
}

check() {
  cd -- "$srcdir/ghost-${pkgver}"
  # By the path 0.13.0's archive has too (packaging/check.sh from the next on).
  bash packaging/arch/test-check-dependencies.sh
  _cargo test --frozen --release
}

package() {
  cd -- "$srcdir/ghost-${pkgver}"
  bash packaging/release/install-payload.sh . target/release "$pkgdir" "$pkgname"
}
