# Recipe from asahi-alarm/PKGBUILDs FEX-Emu 2604-1. Package names are lower case
# here; the old name is provided, so omarchy-steam-fex and steam still resolve.
pkgname=fex-emu
pkgver=2604
pkgrel=2
pkgdesc='Fast x86 emulation frontend'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/FEX-Emu/FEX'
license=('MIT')
provides=("FEX-Emu=$pkgver")
conflicts=('FEX-Emu')
replaces=('FEX-Emu')
# FEXInterpreter, FEXServer and the other tools link libxxhash.
depends=('passt' 'squashfuse' 'squashfs-tools' 'erofs-utils' 'xxhash')
optdepends=('qt6-declarative: FEXConfig, the configuration GUI')
makedepends=('pkgconf' 'cmake' 'nasm' 'catch2' 'ninja' 'git' 'lld' 'llvm' 'clang'
             'libepoxy' 'python' 'qt6-declarative' 'python-packaging' 'python-setuptools'
             'xxhash' 'sdl2-compat' 'libx11' 'libxrandr' 'wayland')
install=fex-emu.install
source=("git+$url.git#tag=FEX-$pkgver"
        cmake.patch)
sha256sums=('e025f760e492abed386bf606e260ebb7a4ff87849404a568fc9f1ae9d24fa681'
            '3f66fc27d99b463ac2116d321ea626a9f0be5c3ddad544911b6db66545f8ddcc')

prepare() {
  cd FEX
  # Submodules at the commits the tag records.
  git submodule update --init --recursive
  patch -p1 < "$srcdir/cmake.patch"
}

build() {
  # FEX-2604 does not build against Arch's fmt 12; use the fmt the tag pins (External/fmt).
  cmake -S FEX -B build -G Ninja \
    -DCMAKE_C_COMPILER=clang \
    -DCMAKE_CXX_COMPILER=clang++ \
    -DENABLE_OFFLINE_TELEMETRY=OFF \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_DISABLE_FIND_PACKAGE_fmt=ON \
    -DUSE_LINKER=lld \
    -DENABLE_LTO=ON \
    -DBUILD_TESTING=FALSE \
    -DENABLE_ASSERTIONS=ON \
    -DTUNE_CPU=apple-m1 \
    -DTUNE_ARCH=armv8-a
  ninja -C build
  # cnth traps on Apple Silicon.
  if objdump -d build/Bin/FEXInterpreter | grep -q cnth; then
    echo "FEXInterpreter contains the illegal instruction cnth" >&2
    return 1
  fi
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
  install -d "$pkgdir/usr/share/fex-emu/RootFS" "$pkgdir/usr/share/fex-emu/overlays"
  install -Dm644 FEX/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
