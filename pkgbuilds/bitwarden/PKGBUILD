pkgname=bitwarden
pkgver=2026.10.4
pkgrel=1
pkgdesc='A secure and free password manager for all of your devices'
# Repackages Bitwarden's own Linux release. Arch Linux ARM doesn't build
# bitwarden, and Arch's x86_64 package in extra lags upstream by months.
arch=('x86_64' 'aarch64')
url='https://bitwarden.com'
license=('GPL-3.0-only')
depends=('alsa-lib' 'gtk3' 'libnotify' 'libnss_nis' 'libxss' 'libxtst' 'nss' 'org.freedesktop.secrets')
options=('!strip' '!debug')
source_x86_64=("https://github.com/bitwarden/clients/releases/download/desktop-v${pkgver}/bitwarden_${pkgver}_x64.tar.gz")
source_aarch64=("https://github.com/bitwarden/clients/releases/download/desktop-v${pkgver}/bitwarden_${pkgver}_arm64.tar.gz")
noextract=("bitwarden_${pkgver}_x64.tar.gz" "bitwarden_${pkgver}_arm64.tar.gz")
sha256sums_x86_64=('0de53003bef44c68e573820874af38f8acb855c729e3bdf441037e61fe6088a9')
sha256sums_aarch64=('5677e2da667e27ad322b2fe2045fc0965c38a1cc41d7e43db98d313e340f6286')

package() {
  install -d "$pkgdir/opt/Bitwarden"
  # The release tarball records its files as the CI runner, uid 1001.
  local _arch=x64
  [[ $CARCH == aarch64 ]] && _arch=arm64
  bsdtar --no-same-owner -xf "bitwarden_${pkgver}_${_arch}.tar.gz" -C "$pkgdir/opt/Bitwarden"

  # Same command and desktop entry names as Arch's x86_64 package.
  install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/applications"
  ln -s /opt/Bitwarden/bitwarden "$pkgdir/usr/bin/bitwarden-desktop"
  # The vendor entry expects window class com.bitwarden.desktop; under X11,
  # which its launcher picks, the window's class is bitwarden.
  sed -e 's|^Exec=.*|Exec=bitwarden-desktop %u|' -e 's|^Icon=.*|Icon=bitwarden|' \
    -e 's|^StartupWMClass=.*|StartupWMClass=bitwarden|' \
    "$pkgdir/opt/Bitwarden/resources/com.bitwarden.desktop.desktop" \
    >"$pkgdir/usr/share/applications/bitwarden.desktop"

  local size
  for size in 16 32 64 128 256 512 1024; do
    install -Dm644 "$pkgdir/opt/Bitwarden/resources/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/bitwarden.png"
  done

  install -d "$pkgdir/usr/share/licenses/$pkgname"
  ln -s /opt/Bitwarden/LICENSE.electron.txt /opt/Bitwarden/LICENSES.chromium.html \
    "$pkgdir/usr/share/licenses/$pkgname/"
}
