[Unit]
Description=Read the Surface Laptop 7 battery pack's cycle count and identity from the Surface controller
Documentation=file:///usr/share/doc/microsoft-surface-laptop-7-support/README.md
ConditionFirmware=|device-tree-compatible(microsoft,romulus13)
ConditionFirmware=|device-tree-compatible(microsoft,romulus15)
ConditionPathExists=/sys/bus/surface_aggregator

[Service]
Type=oneshot
ExecStart=/usr/lib/microsoft-surface-laptop-7-support/surface-laptop-7-battery-info
