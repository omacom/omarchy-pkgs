# Restarts the front camera relay when libcamera 0.7.2 leaks its buffers or
# deadlocks, so the camera keeps working through a call. See the script.
[Unit]
Description=Keep the Surface Laptop 7 front camera relay working
ConditionFirmware=|device-tree-compatible(microsoft,romulus13)
ConditionFirmware=|device-tree-compatible(microsoft,romulus15)
After=v4l2-relayd@surface-laptop-7.service
Wants=v4l2-relayd@surface-laptop-7.service
StartLimitIntervalSec=0

[Service]
# Stands down once libcamera 0.8.0, which fixes both faults, is installed: the
# unit is then skipped, neither failed nor restarted.
ExecCondition=/usr/lib/microsoft-surface-laptop-7-support/surface-laptop-7-camera-guard --needed
ExecStart=/usr/lib/microsoft-surface-laptop-7-support/surface-laptop-7-camera-guard
Restart=always
RestartSec=2
