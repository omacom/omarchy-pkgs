#!/bin/sh
# Give the Surface Laptop 7 front camera's sensor (OV02C10) a fixed digital
# gain. Indoors, auto-exposure on libcamera's software ISP runs out of exposure
# (33 ms at 30 fps) and analogue gain (15.5x), and it never uses the sensor's
# digital gain, so the picture stays dark. In bright light auto-exposure lowers
# the analogue gain to match. Run by v4l2-relayd@surface-laptop-7 before it
# starts; the sensor keeps the value until it is unloaded.
gain=${1:-2048}
for name in "${SL7_CAMERA_SYSFS:-/sys/class/video4linux}"/v4l-subdev*/name; do
	if grep -qs '^ov02c10 ' "$name"; then
		dev=$(basename "$(dirname "$name")")
		${SL7_CAMERA_V4L2_CTL:-/usr/bin/v4l2-ctl} -d "/dev/$dev" -c "digital_gain=$gain"
	fi
done
exit 0
