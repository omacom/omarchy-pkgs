#!/bin/bash

# Battery health on the Surface Laptop 7: the cycle count and the pack's
# identity from the Surface controller (read by
# surface-laptop-7-battery-info.service), with the charge, capacity and charge
# limit Linux already has. Needs no root.

info=${SL7_BATTERY_OUT:-/run/microsoft-surface-laptop-7-support/battery}
battery=${SL7_BATTERY_SYSFS:-/sys/class/power_supply/qcom-battmgr-bat}

[[ -r $battery/energy_full ]] || { echo "No battery at $battery" >&2; exit 1; }

declare -A pack
if [[ -r $info ]]; then
  while IFS='=' read -r key value; do pack[$key]=$value; done <"$info"
fi

full=$(<"$battery/energy_full")
design=$(<"$battery/energy_full_design")
now=$(<"$battery/energy_now")

printf 'Charge          %d%% (%s)\n' $(( (now * 100 + full / 2) / full )) "$(<"$battery/status")"
printf 'Health          %d%% of design (%.2f of %.2f Wh)\n' \
  $(( (full * 100 + design / 2) / design )) "$(( full / 10000 ))e-2" "$(( design / 10000 ))e-2"
if [[ -n ${pack[cycle_count]:-} ]]; then
  printf 'Cycles          %s\n' "${pack[cycle_count]}"
  printf 'Pack            %s %s, model %s\n' "${pack[maker]:-?}" "${pack[type]:-?}" "${pack[model]:-?}"
  printf '                (read from the Surface controller %s)\n' "$(date -d "@${pack[read_at]}" '+%Y-%m-%d %H:%M')"
else
  echo 'Cycles          not read yet: surface-laptop-7-battery-info.service runs a minute after boot'
fi
if [[ -r $battery/charge_control_end_threshold ]]; then
  printf 'Charge limit    start below %s%%, stop at %s%%\n' \
    "$(<"$battery/charge_control_start_threshold")" "$(<"$battery/charge_control_end_threshold")"
fi
