# Maintainer: Felipe Infante de Castro <18445184+fidecastro@users.noreply.github.com>

# Hardware support for the Microsoft Surface Laptop 7 (Snapdragon X Elite)
# that no upstream package carries yet.

pkgname=microsoft-surface-laptop-7-support
pkgver=1
pkgrel=2
pkgdesc="Hardware support for the Microsoft Surface Laptop 7 (Snapdragon X Elite) not yet carried upstream"
arch=('aarch64')
# Qualcomm-only: the pacman platform guard keeps it off other hardware.
groups=('omarchy-platform-qualcomm')
url="https://github.com/omacom/omarchy-pkgs"
license=('MIT')
depends=('bash' 'python' 'systemd' 'wireplumber'
         'libcamera' 'gst-plugin-libcamera' 'gst-plugins-base' 'gst-plugins-good'
         'v4l2loopback-dkms' 'v4l2-relayd' 'v4l-utils')
backup=('etc/v4l2-relayd.d/surface-laptop-7.conf')
_libdir=/usr/lib/$pkgname
source=(
  'surface-laptop-7-battery'
  'surface-laptop-7-battery-info'
  'surface-laptop-7-battery-info.service'
  'surface-laptop-7-battery-info.timer'
  '50-surface-laptop-7-cameras.conf'
  'surface-laptop-7-camera-gain'
  'surface-laptop-7-camera-modprobe.conf'
  'v4l2-relayd-surface-laptop-7.conf'
  'v4l2-relayd-surface-laptop-7.service.conf'
  'ov02c10.yaml'
  'README.package.md'
  'LICENSE'
)
sha256sums=('03e6ac45d003691e0807900e51339a0baddce03c3cb796accf8ddc0944d58af9'
            '9bc74d6acf671bfafae48c45b1d46aa1f8b803aa30b12283817647b1a14bd5ee'
            'aeb17f4a13b824e9d96d0cd552fdfe428542fc0fc4418815ca97a41e6ed80ba9'
            '55751cd49c7306ff470bcb0e908ba4fe3e177b114a7f26c66323b69f6ef6598b'
            'c742b440ac7b2e586a8beca4348c3ea17b6f07e685e5ca068dcd10f27c3b7901'
            '5d69908a38205aa90901a7a98a157bf1905857d20878e6f1401cac6d77fbdba1'
            'f6cb453eb5d7e5cd59ba7a8a758b6fc1bdcc171b4e8f57ccd66c6c08cf5bae86'
            '5a67b2f6e55d0d99d7bc873d825c8790d7de74879a79f55abc2ab4289517ac2b'
            'ef2fedf741d39ad9e16f60a10638be4c4a57503c2beaabd414b5b771b2d2281a'
            '5b726aa4dd23e3e95152d0866331a1adab43a27cc1661ea1404ddda252dced6e'
            '6f87df5e7f2e8bdf60a19966d357350b9e3167f9ddf72aebaff99980b0db6fc1'
            'c05ddb9629d77776afcea9c4203ea8d4acfa599ab6a475898fe129a4f7ce5321')

package() {
  install -Dm755 surface-laptop-7-battery "$pkgdir/usr/bin/surface-laptop-7-battery"
  install -Dm755 surface-laptop-7-battery-info "$pkgdir$_libdir/surface-laptop-7-battery-info"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" \
    surface-laptop-7-battery-info.service surface-laptop-7-battery-info.timer
  # Enabled by the package: the units check for this laptop's device tree
  # themselves, so the hardware setup only has to install the package.
  install -d "$pkgdir/usr/lib/systemd/system/timers.target.wants"
  ln -s ../surface-laptop-7-battery-info.timer \
    "$pkgdir/usr/lib/systemd/system/timers.target.wants/surface-laptop-7-battery-info.timer"

  install -Dm644 50-surface-laptop-7-cameras.conf \
    "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/50-surface-laptop-7-cameras.conf"

  # Front camera as a V4L2 webcam: v4l2loopback's "Front Camera", filled from
  # libcamera by v4l2-relayd while an app has it open. Enabled by the package;
  # the relay's drop-in checks for this laptop's device tree.
  install -Dm755 surface-laptop-7-camera-gain "$pkgdir$_libdir/surface-laptop-7-camera-gain"
  install -Dm644 surface-laptop-7-camera-modprobe.conf \
    "$pkgdir/usr/lib/modprobe.d/surface-laptop-7-camera.conf"
  install -Dm644 v4l2-relayd-surface-laptop-7.conf \
    "$pkgdir/etc/v4l2-relayd.d/surface-laptop-7.conf"
  install -Dm644 v4l2-relayd-surface-laptop-7.service.conf \
    "$pkgdir/usr/lib/systemd/system/v4l2-relayd@surface-laptop-7.service.d/surface-laptop-7.conf"
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../v4l2-relayd@.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/v4l2-relayd@surface-laptop-7.service"
  install -Dm644 ov02c10.yaml "$pkgdir/usr/share/libcamera/ipa/simple/ov02c10.yaml"

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
