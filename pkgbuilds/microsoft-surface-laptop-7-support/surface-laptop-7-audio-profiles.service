[Unit]
Description=Check that the Surface Laptop 7's built-in sound card got its profiles at login
Documentation=file:///usr/share/doc/microsoft-surface-laptop-7-support/README.md
ConditionFirmware=device-tree-compatible(microsoft,romulus15)
After=wireplumber.service

[Service]
Type=oneshot
# Once per login: the check restarts WirePlumber, which must not start it again.
RemainAfterExit=yes
ExecStart=/usr/lib/microsoft-surface-laptop-7-support/surface-laptop-7-audio-profiles

[Install]
WantedBy=wireplumber.service
