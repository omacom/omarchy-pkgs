+make_packet (guint8 packet[T1FP_HEADER + 3])
+{
+  memset (packet, 0, T1FP_HEADER + 3);
+  memcpy (packet, "T1FP", 4);
+  packet[4] = 1;
+  packet[5] = 0x81;
+  packet[9] = 3;
+  packet[12] = 1;
+  packet[13] = 2;
+  packet[14] = 3;
+}
+
+static void
+test_packet (void)
+{
+  guint8 packet[T1FP_HEADER + 3];
+  guint8 oversized[T1FP_MAX_PACKET + 1] = { 0 };
+  T1bridgePacket parsed;
+
+  make_packet (packet);
+  g_assert_true (t1bridge_packet_parse (packet, sizeof (packet), &parsed));
+  g_assert_cmpuint (parsed.type, ==, 0x81);
+  g_assert_cmpuint (parsed.payload_size, ==, 3);
+  g_assert_true (parsed.payload == packet + T1FP_HEADER);
+
+  g_assert_false (t1bridge_packet_parse (NULL, sizeof (packet), &parsed));
+  g_assert_false (t1bridge_packet_parse (packet, sizeof (packet), NULL));
+  g_assert_false (t1bridge_packet_parse (packet, T1FP_HEADER - 1, &parsed));
+  g_assert_false (t1bridge_packet_parse (oversized, sizeof (oversized), &parsed));
+  packet[0] = 'X';
+  g_assert_false (t1bridge_packet_parse (packet, sizeof (packet), &parsed));
+  make_packet (packet);
+  packet[4] = 2;
+  g_assert_false (t1bridge_packet_parse (packet, sizeof (packet), &parsed));
+  for (guint i = 6; i <= 11; i++) {
+    if (i == 8 || i == 9)
+      continue;
+    make_packet (packet);
+    packet[i] = 1;
+    g_assert_false (t1bridge_packet_parse (packet, sizeof (packet), &parsed));
+  }
+  make_packet (packet);
+  packet[9] = 2;
+  g_assert_false (t1bridge_packet_parse (packet, sizeof (packet), &parsed));
+}
+
+static gsize
+make_identities (guint8 *payload)
+{
+  gsize cursor = 0;
+
+  payload[cursor++] = 2;
+  payload[cursor++] = 4;
+  memcpy (payload + cursor, "user", 4);
+  cursor += 4;
+  memset (payload + cursor, 1, T1FP_ID_SIZE);
+  cursor += T1FP_ID_SIZE;
+  payload[cursor++] = 2;
+  memset (payload + cursor, 2, T1FP_ID_SIZE);
+  cursor += T1FP_ID_SIZE;
+  payload[cursor++] = 7;
+  return cursor;
+}
+
+static void
+test_identities (void)
+{
+  guint8 payload[64];
+  T1bridgeIdentityList parsed;
+  gsize size = make_identities (payload);
+
+  g_assert_true (t1bridge_identities_parse (payload, size, 5, &parsed));
+  g_assert_cmpuint (parsed.count, ==, 2);
+  g_assert_cmpstr (parsed.username, ==, "user");
+  g_assert_cmpuint (parsed.identities[0].finger, ==, 2);
+  g_assert_cmpuint (parsed.identities[1].finger, ==, 7);
+  g_assert_cmpuint (parsed.identities[0].id[0], ==, 1);
+  g_assert_cmpuint (parsed.identities[1].id[0], ==, 2);
+
+  g_assert_false (t1bridge_identities_parse (NULL, size, 5, &parsed));
+  g_assert_false (t1bridge_identities_parse (payload, size, 5, NULL));
+  g_assert_false (t1bridge_identities_parse (payload, size, 0, &parsed));
+  g_assert_false (t1bridge_identities_parse (payload, size, 6, &parsed));
+  g_assert_false (t1bridge_identities_parse (payload, size, 1, &parsed));
+  g_assert_false (t1bridge_identities_parse (payload, size - 1, 5, &parsed));
+  payload[size] = 0;
+  g_assert_false (t1bridge_identities_parse (payload, size + 1, 5, &parsed));
+}
+
+static void
+test_invalid_identity_fields (void)
+{
+  guint8 payload[64];
+  T1bridgeIdentityList parsed;
+  gsize size;
+
+  size = make_identities (payload);
+  payload[1] = 0;
+  g_assert_false (t1bridge_identities_parse (payload, size, 5, &parsed));
+  size = make_identities (payload);
+  payload[2] = 0;
+  g_assert_false (t1bridge_identities_parse (payload, size, 5, &parsed));
+  size = make_identities (payload);
+  payload[2] = 0xff;
+  g_assert_false (t1bridge_identities_parse (payload, size, 5, &parsed));
+  size = make_identities (payload);
+  memset (payload + 6, 0, T1FP_ID_SIZE);
+  g_assert_false (t1bridge_identities_parse (payload, size, 5, &parsed));
+  size = make_identities (payload);
+  payload[6 + T1FP_ID_SIZE] = 0;
+  g_assert_false (t1bridge_identities_parse (payload, size, 5, &parsed));
+  size = make_identities (payload);
+  payload[6 + T1FP_ID_SIZE] = 11;
+  g_assert_false (t1bridge_identities_parse (payload, size, 5, &parsed));
+  size = make_identities (payload);
+  memcpy (payload + 6 + T1FP_ID_SIZE + 1, payload + 6, T1FP_ID_SIZE);
+  g_assert_false (t1bridge_identities_parse (payload, size, 5, &parsed));
+}
+
+static void
+test_empty_identities (void)
+{
+  guint8 payload[2] = { 0, 0 };
+  T1bridgeIdentityList parsed;
+
+  g_assert_true (t1bridge_identities_parse (payload, 1, 5, &parsed));
+  g_assert_cmpuint (parsed.count, ==, 0);
+  g_assert_false (t1bridge_identities_parse (payload, 0, 5, &parsed));
+  g_assert_false (t1bridge_identities_parse (payload, 2, 5, &parsed));
+}
+
+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/t1bridge/packet", test_packet);
+  g_test_add_func ("/t1bridge/identities", test_identities);
+  g_test_add_func ("/t1bridge/invalid-identity-fields", test_invalid_identity_fields);
+  g_test_add_func ("/t1bridge/empty-identities", test_empty_identities);
+  return g_test_run ();
+}
