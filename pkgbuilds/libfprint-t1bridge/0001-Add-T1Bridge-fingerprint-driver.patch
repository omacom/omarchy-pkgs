+  g_object_get (device, "removed", &removed, NULL);
+  g_assert_false (removed);
+  fpi_device_configure_wakeup (device, TRUE);
+  fpi_device_configure_wakeup (device, FALSE);
+  g_assert_true (fp_device_close_sync (device, NULL, &error));
+  g_assert_no_error (error);
+
+  g_assert_true (fpi_device_remove_if_matches_usb_device (device, usb_device));
