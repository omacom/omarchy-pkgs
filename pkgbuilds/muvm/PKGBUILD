# Omarchy downstream build. session-bus.patch is maintained here, not upstream.
pkgname=muvm
pkgver=0.7.0
pkgrel=2
pkgdesc='Run programs in a microVM, with optional host session D-Bus forwarding'
arch=('aarch64')
url='https://github.com/AsahiLinux/muvm'
license=('MIT')
depends=('glibc' 'gcc-libs' 'systemd-libs' 'libkrun>=1.19' 'socat' 'passt')
makedepends=('rust' 'cargo' 'clang' 'pkgconf')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgname-$pkgver.tar.gz"
        'session-bus.patch')
sha256sums=('3cf9ffe550a01ed6438d1f0a4ab31a5b98af4855655f603f71a84d57e7913c3f'
            '6b613b8aea59d012bd6c98b7a6171af09a7b4d3bb2f12d3a2c92521eea467104')

prepare() {
  cd "$pkgname-$pkgname-$pkgver"
  patch -Np1 -i "$srcdir/session-bus.patch"
  cargo fetch --locked --target "${CARGO_TARGET:-aarch64-unknown-linux-gnu}"
}

build() {
  cd "$pkgname-$pkgname-$pkgver"
  cargo build --release --frozen --workspace ${CARGO_TARGET:+--target "$CARGO_TARGET"}
}

check() {
  cd "$pkgname-$pkgname-$pkgver"
  cargo test --release --frozen --workspace ${CARGO_TARGET:+--target "$CARGO_TARGET"}
}

package() {
  cd "$pkgname-$pkgname-$pkgver"
  local target_dir=target/release
  if [[ -n ${CARGO_TARGET:-} ]]; then
    target_dir=target/$CARGO_TARGET/release
  fi
  install -Dm755 "$target_dir/muvm" "$pkgdir/usr/bin/muvm"
  install -Dm755 "$target_dir/muvm-guest" "$pkgdir/usr/bin/muvm-guest"
  install -Dm644 crates/muvm/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 share/wireplumber/wireplumber.conf.d/50-muvm-access.conf \
    "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/50-muvm-access.conf"
  install -Dm644 share/wireplumber/scripts/client/access-muvm.lua \
    "$pkgdir/usr/share/wireplumber/scripts/client/access-muvm.lua"
}
