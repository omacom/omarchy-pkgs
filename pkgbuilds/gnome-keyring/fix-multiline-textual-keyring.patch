From eb832ca42ab9ab07319268849debc85abf708940 Mon Sep 17 00:00:00 2001
From: Nameless <jorgerandrade@protonmail.com>
Date: Tue, 25 Aug 2026 01:24:42 +0100
Subject: [PATCH] secret-store: Escape multiline textual secrets

---
 pkcs11/secret-store/gkm-secret-textual.c  |  2 +-
 pkcs11/secret-store/test-secret-textual.c | 38 +++++++++++++++++++++++
 2 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/pkcs11/secret-store/gkm-secret-textual.c b/pkcs11/secret-store/gkm-secret-textual.c
index 9cda53a0..a5a3fe32 100644
--- a/pkcs11/secret-store/gkm-secret-textual.c
+++ b/pkcs11/secret-store/gkm-secret-textual.c
@@ -300,7 +300,7 @@ generate_item (GKeyFile *file, GkmSecretItem *item, GkmSecretData *sdata)
 	if (secret != NULL) {
 		/* A textual secret. Note that secrets are always null-terminated. */
 		if (g_utf8_validate ((gchar*)secret, n_secret, NULL)) {
-			g_key_file_set_value (file, identifier, "secret", (gchar*)secret);
+			g_key_file_set_string (file, identifier, "secret", (gchar*)secret);
 
 		/* A non-textual secret */
 		} else {
diff --git a/pkcs11/secret-store/test-secret-textual.c b/pkcs11/secret-store/test-secret-textual.c
index 39a7f351..227c3478 100644
--- a/pkcs11/secret-store/test-secret-textual.c
+++ b/pkcs11/secret-store/test-secret-textual.c
@@ -151,6 +151,43 @@ test_write (Test *test, gconstpointer unused)
 	g_free (data);
 }
 
+static void
+test_write_multiline_secret (Test *test, gconstpointer unused)
+{
+	const gchar *password = "{\n\"certificate\": \"first\\nsecond\"\n}";
+	GkmSecretCollection *collection;
+	GkmSecretData *sdata;
+	GkmSecretItem *item;
+	GkmSecret *secret;
+	GkmDataResult res;
+	gpointer data;
+	gsize n_data;
+
+	item = gkm_secret_collection_new_item (test->collection, "multiline");
+	g_assert (GKM_IS_SECRET_ITEM (item));
+	secret = gkm_secret_new_from_password (password);
+	gkm_secret_data_set_secret (test->sdata, "multiline", secret);
+	g_object_unref (secret);
+
+	res = gkm_secret_textual_write (test->collection, test->sdata, &data, &n_data);
+	g_assert (res == GKM_DATA_SUCCESS);
+
+	collection = g_object_new (GKM_TYPE_SECRET_COLLECTION,
+	                           "module", test->module,
+	                           "identifier", "parsed",
+	                           NULL);
+	sdata = g_object_new (GKM_TYPE_SECRET_DATA, NULL);
+	res = gkm_secret_textual_read (collection, sdata, data, n_data);
+	g_assert (res == GKM_DATA_SUCCESS);
+	secret = gkm_secret_data_get_secret (sdata, "multiline");
+	g_assert (GKM_IS_SECRET (secret));
+	g_assert (gkm_secret_equals (secret, (const guchar *)password, -1));
+
+	g_object_unref (sdata);
+	g_object_unref (collection);
+	g_free (data);
+}
+
 static void
 test_remove_unavailable (Test *test, gconstpointer unused)
 {
@@ -223,6 +260,7 @@ main (int argc, char **argv)
 	g_test_add ("/secret-store/search/read_wrong_format", Test, NULL, setup, test_read_wrong_format, teardown);
 	g_test_add ("/secret-store/search/read_bad_number", Test, NULL, setup, test_read_bad_number, teardown);
 	g_test_add ("/secret-store/search/write", Test, NULL, setup, test_write, teardown);
+	g_test_add ("/secret-store/search/write_multiline_secret", Test, NULL, setup, test_write_multiline_secret, teardown);
 	g_test_add ("/secret-store/search/remove_unavailable", Test, NULL, setup, test_remove_unavailable, teardown);
 	g_test_add ("/secret-store/search/read-with-schema", Test, NULL, setup, test_read_with_schema, teardown);
 
