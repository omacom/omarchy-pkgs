# Maintainer: Irfrit
pkgname=gnome-keyring
pkgver=50.0
pkgrel=1.1
pkgdesc="Stores passwords and encryption keys (patched for multiline textual secrets)"
arch=('x86_64')
url="https://gitlab.gnome.org/GNOME/gnome-keyring"
license=('GPL-2.0-or-later' 'LGPL-2.1-or-later')
depends=(
  'dconf'
  'gcr'
  'gcr-4'
  'glib2'
  'glibc'
  'libcap-ng'
  'libgcrypt'
  'pam'
  'systemd-libs'
)
makedepends=(
  'docbook-xsl'
  'git'
  'meson'
  'python'
  'valgrind'
  'xsltproc'
)
provides=('org.freedesktop.secrets')
source=(
  "git+https://gitlab.gnome.org/GNOME/gnome-keyring.git#tag=${pkgver}"
  "fix-multiline-textual-keyring.patch"
)
sha256sums=('cee113eca1255f353187ea2052e303efc655f1663db0581f5d060fd26fc8331b'
            'ae7f3452b4196e5aca3bd777721037fec9e65de0d25ae393f0d09746b8c50f3f')

prepare() {
  cd gnome-keyring
  patch -Np1 -i "${srcdir}/fix-multiline-textual-keyring.patch"
}

build() {
  arch-meson gnome-keyring build \
    -D ssh-agent=false \
    -D selinux=disabled \
    -D manpage=false
  meson compile -C build
}

check() {
  meson test -C build --suite 'gnome-keyring:gkm::secret-store' --print-errorlogs
}

package() {
  meson install -C build --destdir "${pkgdir}"
}
