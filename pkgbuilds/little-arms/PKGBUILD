# Maintainer: Ryan Hughes
pkgname=little-arms
pkgver=0.1.0
pkgrel=1
pkgdesc='Native Linux desktop client for Rex'
arch=('x86_64' 'aarch64')
url='https://github.com/ryanrhughes/little-arms'
license=('MIT')
options=('!debug' '!lto')
depends=('qt6-base>=6.9' 'qt6-declarative>=6.9' 'qt6-wayland' 'qt6-svg' 'fontconfig' 'libnotify'
         'libxkbcommon' 'wayland' 'openssl' 'hicolor-icon-theme')
optdepends=('rex: run a local Rex server'
            'openssh: connect to remote hosts over SSH')
makedepends=('cargo' 'pkgconf' 'qt6-shadertools')
# libghostty-vt is built from Ghostty's own release and linked in statically,
# so the package doesn't need Ghostty installed. Keep the version and hashes
# in step with scripts/build-libghostty-vt.sh, which applies the fixes in
# scripts/patches on top.
_vt=1.0.2
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "https://release.files.ghostty.org/libghostty-vt/$_vt/libghostty-vt-$_vt.tar.gz"
        "https://release.files.ghostty.org/libghostty-vt/$_vt/libghostty-vt-$_vt-deps.tar.gz")
noextract=("libghostty-vt-$_vt.tar.gz" "libghostty-vt-$_vt-deps.tar.gz")
sha256sums=('1bba09cae4097d89ece7d31ce902b967acf65c0e781e3b09de97af96c1e358b1'
            '1dcafa8a3357f3a6bbf4f2696e61de611400c5469518716793dfffd35f008b3e'
            'c56156dbea82fdf71f13bf0d704cdf4393b6a04208d7f9691e0d7f60c7f9ca4d')
# libghostty-vt needs Zig 0.17, newer than Arch's zig package, so the build
# uses Zig's own release for the architecture.
_zig=0.17.1
source_x86_64=("https://ziglang.org/download/$_zig/zig-x86_64-linux-$_zig.tar.xz")
source_aarch64=("https://ziglang.org/download/$_zig/zig-aarch64-linux-$_zig.tar.xz")
sha256sums_x86_64=('3581863e3cbcfd0fce0efc682ce7e9e93da96668a977791d356a26d2a7e9b17a')
sha256sums_aarch64=('a1546d5646eb184437918d6635ca6b762a0e889eac09cef720ee7a1ed3fe7795')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  PATH="$srcdir/zig-$CARCH-linux-$_zig:$PATH" \
    ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-cache" \
    LIBGHOSTTY_VT_SOURCES="$srcdir" \
    scripts/build-libghostty-vt.sh
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release -p little-arms
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/little-arms "$pkgdir/usr/bin/little-arms"
  install -Dm644 packaging/little-arms.desktop "$pkgdir/usr/share/applications/little-arms.desktop"
  install -Dm644 packaging/icons/little-arms.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/little-arms.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # Licenses for libghostty-vt and the code it links, which are in the binary.
  cp -r third_party/libghostty-vt/share/licenses/libghostty-vt "$pkgdir/usr/share/licenses/$pkgname/"
  # The interface icons come from Lucide, some of them from Feather before it.
  install -Dm644 LICENSES/lucide-ISC.txt "$pkgdir/usr/share/licenses/$pkgname/lucide-ISC.txt"
  # Lucide's license credits Feather (MIT) for the icons it grew from.
  install -Dm644 LICENSES/feather-MIT.txt "$pkgdir/usr/share/licenses/$pkgname/feather-MIT.txt"
}
