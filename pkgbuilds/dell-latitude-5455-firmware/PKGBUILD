# Audio DSP, compute DSP, GPU and video firmware for the Dell Latitude 5455. The firmware only
# runs if it is signed for this board by Dell, so linux-firmware cannot carry it until the OEM
# submits it. The OEM ships it in its Windows driver download, which this recipe unpacks without
# running. Each file is checked against the SHA-256 it was matched to and installed under the name
# the device tree requests, compressed with xz. The kernel tries a plain name, then .zst, then
# .xz, so once linux-firmware ships the same file, its copy is the one loaded, and the two
# packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=dell-latitude-5455-firmware
pkgver=20261102
pkgrel=2
pkgdesc='Audio DSP, compute DSP, GPU and video firmware for the Dell Latitude 5455'
arch=('aarch64')
url='https://dl.dell.com/FOLDER14261861M/1/Qualcomm-Chipset-Driver_DRC2V_WINARM64_2.1.0.24_A12.EXE'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1e80100-dell-latitude-5455')
makedepends=('7zip')
options=('!strip' '!debug')
# dl.dell.com turns away clients that do not name a browser.
DLAGENTS=('https::/usr/bin/curl -qgb "" -A Mozilla/5.0 -fLC - --retry 3 --retry-delay 3 -o %o %u')
source=(
  'dell-drc2v.exe::https://dl.dell.com/FOLDER14261861M/1/Qualcomm-Chipset-Driver_DRC2V_WINARM64_2.1.0.24_A12.EXE'
  'dell-5njdy.exe::https://dl.dell.com/FOLDER14321292M/1/Qualcomm-Adreno-X1-85-X1-45-Graphics-Driver_5NJDY_WINARM64_31.0.148.0_A09.EXE'
)
noextract=('dell-drc2v.exe' 'dell-5njdy.exe')
sha256sums=('b241c88078d887516920b3fadbde8f53e871cb8721c37c69544a00b28d99df55' '6dffdacc16b8cce59eb40ca8d72b49b53ba49966b6b64afef09b02315416776b')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'dell-drc2v.exe' 'dell-drc2v' 7z
  _unpack 'dell-5njdy.exe' 'dell-5njdy' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'dell-drc2v/16299/Drivers/arm64/qcsubsys_ext_adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1e80100/dell/latitude-5455/adsp_dtbs.elf'
  install -Dm644 'dell-drc2v/16299/Drivers/arm64/qcsubsys_ext_adsp8380/adspr.jsn' "$fw"/'qcom/x1e80100/dell/latitude-5455/adspr.jsn'
  install -Dm644 'dell-drc2v/16299/Drivers/arm64/qcsubsys_ext_adsp8380/adsps.jsn' "$fw"/'qcom/x1e80100/dell/latitude-5455/adsps.jsn'
  install -Dm644 'dell-drc2v/16299/Drivers/arm64/qcsubsys_ext_adsp8380/adspua.jsn' "$fw"/'qcom/x1e80100/dell/latitude-5455/adspua.jsn'
  install -Dm644 'dell-drc2v/16299/Drivers/arm64/qcsubsys_ext_adsp8380/battmgr.jsn' "$fw"/'qcom/x1e80100/dell/latitude-5455/battmgr.jsn'
  install -Dm644 'dell-drc2v/16299/Drivers/arm64/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1e80100/dell/latitude-5455/cdsp_dtbs.elf'
  install -Dm644 'dell-drc2v/16299/Drivers/arm64/qcnspmcdm_ext_cdsp8380/cdspr.jsn' "$fw"/'qcom/x1e80100/dell/latitude-5455/cdspr.jsn'
  install -Dm644 'dell-drc2v/16299/Drivers/arm64/qcsubsys_ext_adsp8380/qcadsp8380.mbn' "$fw"/'qcom/x1e80100/dell/latitude-5455/qcadsp8380.mbn'
  install -Dm644 'dell-drc2v/16299/Drivers/arm64/qcnspmcdm_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1e80100/dell/latitude-5455/qccdsp8380.mbn'
  install -Dm644 'dell-5njdy/16299/Drivers/MUP/qcdx8380/qcdxkmsuc8380.mbn' "$fw"/'qcom/x1e80100/dell/latitude-5455/qcdxkmsuc8380.mbn'
  install -Dm644 'dell-5njdy/16299/Drivers/MUP/qcdx8380/qcvss8380.mbn' "$fw"/'qcom/x1e80100/dell/latitude-5455/qcvss8380.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
d94dabc6cdb9282d0bca40c9eab09b6477d4dac2d68dc37d294fff2b41e08d89  qcom/x1e80100/dell/latitude-5455/adsp_dtbs.elf
549bb9c8e32dc6253d0d0ddde2ce5c26f75f8333d3e55861f297e169a9f3e5c0  qcom/x1e80100/dell/latitude-5455/adspr.jsn
12ac2f3ae8ced12aa4b06b3ab3a01bc4d8efe1c92ebea503c002f209a6ec176f  qcom/x1e80100/dell/latitude-5455/adsps.jsn
982a99853495e34726b8e44697fdfad303334de0a67cbf6cde306c8f1731000b  qcom/x1e80100/dell/latitude-5455/adspua.jsn
be8c6fba330908e4683fb6282761cb08485a302d6a66e09721e102e342f27236  qcom/x1e80100/dell/latitude-5455/battmgr.jsn
93941f040da14b8305d39579686d886706d22954a538b03da676c1aaa191797f  qcom/x1e80100/dell/latitude-5455/cdsp_dtbs.elf
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x1e80100/dell/latitude-5455/cdspr.jsn
9864843193c371cd9ef537ff521687c58795a73fcaf8c53e9b3961903273875d  qcom/x1e80100/dell/latitude-5455/qcadsp8380.mbn
4a67a03367f2eff2f8a0e867ca25d2bf2fcd5aee3e41e2c9f436c804e257c789  qcom/x1e80100/dell/latitude-5455/qccdsp8380.mbn
950f17eb439326548cba20603b30cda653d612d1564feb397ddbd92987f0e8ac  qcom/x1e80100/dell/latitude-5455/qcdxkmsuc8380.mbn
d52c28872ebbaf8087a30bf196d15ee24839fd62a2d91b605edfa73c09bbd8d4  qcom/x1e80100/dell/latitude-5455/qcvss8380.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +
}
