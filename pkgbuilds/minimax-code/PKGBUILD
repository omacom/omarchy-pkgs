# Maintainer: The Omarchy Authors
# MiniMax publishes MCode only to npm. Its SQLite store is better-sqlite3,
# compiled here against Arch's nodejs, so the package is rebuilt when nodejs
# moves (rebuild_on) and stays off the fast ring.
pkgname=minimax-code
pkgver=0.8.0
pkgrel=1
pkgdesc="MiniMax Code (MCode), MiniMax's terminal coding agent"
arch=('x86_64' 'aarch64')
url="https://www.npmjs.com/package/@minimax-ai/code"
license=('MIT')
depends=('nodejs' 'glibc' 'gcc-libs')
makedepends=('npm' 'python')
options=('!strip' '!debug')
source=("code-${pkgver}.tgz::https://registry.npmjs.org/@minimax-ai/code/-/code-${pkgver}.tgz"
        'LICENSE')
sha256sums=('fbc48d5e138ce8f43f11627b7378a209772a522c1125da7b9dbf2157ae8e9365' '86c24acaf016e17e3babec34753585faa26a155e55f7be4ea06abc2066cbfc8e')
noextract=("code-${pkgver}.tgz")

package() {
  # Outside node_modules on purpose: MCode reads an install under
  # .../lib/node_modules/@minimax-ai/code as its own npm-global install and
  # offers to update it with npm. Anywhere else it reports no install source,
  # so it neither checks for updates nor shows its update notice.
  local _lib="${pkgdir}/usr/lib/minimax-code"
  install -dm755 "$_lib" "${pkgdir}/usr/bin"
  bsdtar --no-same-owner --strip-components 1 -xf "code-${pkgver}.tgz" -C "$_lib"

  # Only better-sqlite3 needs its install script, and it builds from source
  # against Arch's Node headers instead of downloading a prebuilt binary.
  # MCode's own postinstall then loads it and runs a query, failing the build
  # if it doesn't work.
  (
    cd "$_lib"
    echo 'allow-scripts=better-sqlite3' >.npmrc
    npm_config_build_from_source=true npm_config_nodedir=/usr \
      npm install --omit=dev --no-package-lock --no-audit --no-fund \
      --foreground-scripts --cache "${srcdir}/npm-cache"
    rm .npmrc
  )

  # Build leftovers and the bundled SQLite sources.
  local _sqlite="${_lib}/node_modules/better-sqlite3"
  find "${_sqlite}/build" -mindepth 1 -maxdepth 1 ! -name Release -exec rm -r {} +
  find "${_sqlite}/build/Release" -mindepth 1 -maxdepth 1 ! -name better_sqlite3.node -exec rm -r {} +
  rm -r "${_sqlite}/deps" "${_sqlite}/src"

  # Computer use and console helpers for macOS and Windows only.
  rm -r "${_lib}"/embedded/computer-use/*/{darwin,win32}-* "${_lib}"/native/{darwin,win32}

  chown -R root:root "${pkgdir}/usr"
  ln -s /usr/lib/minimax-code/cli.js "${pkgdir}/usr/bin/mcode"
  ln -s /usr/lib/minimax-code/mcode-tools.js "${pkgdir}/usr/bin/mcode-tools"
  install -Dm644 LICENSE "${_lib}/THIRD_PARTY_NOTICES.md" -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
