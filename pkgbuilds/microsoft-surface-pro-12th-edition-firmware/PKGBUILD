# Audio DSP and compute DSP firmware for the Microsoft Surface Pro 12th Edition. The firmware only
# runs if it is signed for this board by Microsoft, so linux-firmware cannot carry it until the
# OEM submits it. The OEM ships it in its Windows driver download, which this recipe unpacks
# without running. Each file is checked against the SHA-256 it was matched to and installed under
# the name the device tree requests, compressed with xz. The kernel tries a plain name, then .zst,
# then .xz, so once linux-firmware ships the same file, its copy is the one loaded, and the two
# packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=microsoft-surface-pro-12th-edition-firmware
pkgver=20261114
pkgrel=1
pkgdesc='Audio DSP and compute DSP firmware for the Microsoft Surface Pro 12th Edition'
arch=('aarch64')
url='https://www.microsoft.com/en-us/download/details.aspx?id=108706'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-glymur-microsoft-surface-pro-12th-edition')
makedepends=('7zip' 'msitools')
options=('!strip' '!debug')
source=(
  'microsoft-surfacepro12withsnapdragon.msi::https://download.microsoft.com/download/85364b00-7e11-4a77-8115-bfcece673d91/SurfacePro12withSnapdragon_Win11_28000_26.091.14453.0.msi'
)
source+=('README.package.md')
noextract=('microsoft-surfacepro12withsnapdragon.msi')
sha256sums=('a35da2faa0af7c05b701ac9b451b70c335d8795b025427da082739b665d2a51a')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'microsoft-surfacepro12withsnapdragon.msi' 'microsoft-surfacepro12withsnapdragon' msi
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'microsoft-surfacepro12withsnapdragon/SurfaceUpdate/proextadsp8480/adsp_dtbs.elf' "$fw"/'qcom/glymur/microsoft/surface-pro-12th-edition/adsp_dtbs.elf'
  install -Dm644 'microsoft-surfacepro12withsnapdragon/SurfaceUpdate/proextadsp8480/adspr.jsn' "$fw"/'qcom/glymur/microsoft/surface-pro-12th-edition/adspr.jsn'
  install -Dm644 'microsoft-surfacepro12withsnapdragon/SurfaceUpdate/proextadsp8480/adsps.jsn' "$fw"/'qcom/glymur/microsoft/surface-pro-12th-edition/adsps.jsn'
  install -Dm644 'microsoft-surfacepro12withsnapdragon/SurfaceUpdate/proextadsp8480/adspua.jsn' "$fw"/'qcom/glymur/microsoft/surface-pro-12th-edition/adspua.jsn'
  install -Dm644 'microsoft-surfacepro12withsnapdragon/SurfaceUpdate/qcnspmcdm8480/cdsp_dtbs.elf' "$fw"/'qcom/glymur/microsoft/surface-pro-12th-edition/cdsp_dtbs.elf'
  install -Dm644 'microsoft-surfacepro12withsnapdragon/SurfaceUpdate/proextadsp8480/qcadsp8480.mbn' "$fw"/'qcom/glymur/microsoft/surface-pro-12th-edition/qcadsp8480.mbn'
  install -Dm644 'microsoft-surfacepro12withsnapdragon/SurfaceUpdate/qcnspmcdm8480/qccdsp8480.mbn' "$fw"/'qcom/glymur/microsoft/surface-pro-12th-edition/qccdsp8480.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
03a76a8d9ed13cd904530880d7122f16cb81b63829c455e4af09d86ed69b3fe9  qcom/glymur/microsoft/surface-pro-12th-edition/adsp_dtbs.elf
e9ba7199626b0c03f2ec02822d744f678ad567fe0625a28fe5f5908b7281e9db  qcom/glymur/microsoft/surface-pro-12th-edition/adspr.jsn
19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e  qcom/glymur/microsoft/surface-pro-12th-edition/adsps.jsn
d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d  qcom/glymur/microsoft/surface-pro-12th-edition/adspua.jsn
dfd345ab5ee9dba7fc7d717a35a3b9bb96f195a1d2cde18af41be1945d8599db  qcom/glymur/microsoft/surface-pro-12th-edition/cdsp_dtbs.elf
f2d6dcb59218dbc1bf599af157f1de59ae04c8f1b0ac090f1f775c5f5631d351  qcom/glymur/microsoft/surface-pro-12th-edition/qcadsp8480.mbn
2798125b8458d47b4e1adbd3ae2451fdb20ee6add9ea4dc6211c96d96210a2b9  qcom/glymur/microsoft/surface-pro-12th-edition/qccdsp8480.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
