#!/usr/bin/env bash
# ~/.config/omarchy/hooks/theme-set.d/50-blackbird
# Synchronizes Omarchy stock themes 1:1 to Blackbird's 8 Hero Flight Deck themes.
set -euo pipefail

OMARCHY_THEME="${1:-}"
OMARCHY_THEME_LOWER="$(printf '%s' "$OMARCHY_THEME" | tr '[:upper:]' '[:lower:]')"

case "$OMARCHY_THEME_LOWER" in
  tokyo-night*|tokyonight*) BB_THEME="tokyonight" ;;
  kanagawa*)                BB_THEME="kanagawa" ;;
  nord*)                    BB_THEME="nord" ;;
  hackerman*)               BB_THEME="hackerman" ;;
  matte-black*|gotham*)     BB_THEME="gotham" ;;
  osaka-jade*|everforest*|dying-earth*|dyingearth*) BB_THEME="dyingearth" ;;
  gruvbox*|ristretto*|retro82*|retro-82*)           BB_THEME="retro82" ;;
  rose-pine*|catppuccin*|blackbird*|synthwave*)     BB_THEME="synthwave" ;;
  *)                        BB_THEME="synthwave" ;;
esac

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/blackbird"
mkdir -p "$CONFIG_DIR"
TMP_FILE="$(mktemp "${CONFIG_DIR}/.theme.XXXXXX")"
trap 'rm -f "$TMP_FILE"' EXIT
printf '%s\n' "$BB_THEME" > "$TMP_FILE"
mv -f "$TMP_FILE" "${CONFIG_DIR}/theme"
trap - EXIT
