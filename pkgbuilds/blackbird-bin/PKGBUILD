# Maintainer: Antimeme AI LLC <ops@antimeme.ai>
pkgname=blackbird-bin
pkgver=0.4.0
pkgrel=1
pkgdesc="Native C++23 + Lua 5.5.1 coding harness and sovereign multi-agent Command Post"
arch=('x86_64')
url="https://github.com/antimemeai/blackbird"
license=('MIT')
depends=('glibc' 'gcc-libs' 'bash' 'hicolor-icon-theme')
optdepends=(
  'mp-outpost-bin: E2EE P2P multiplayer.tech sidecar for non-Blackbird peers'
  'git: git worktree leases and platoon coordination'
)
provides=('blackbird')
conflicts=('blackbird')
options=('!strip' '!debug')
_dl="https://github.com/antimemeai/blackbird/releases/download/v${pkgver}"
source=(
  'LICENSE'
  'blackbird.desktop'
  'blackbird-flightdeck.desktop'
  '50-blackbird'
)
source_x86_64=("${pkgname}-${pkgver}-x86_64.tar.gz::${_dl}/blackbird-v${pkgver}-linux-x86_64.tar.gz")
noextract=("${pkgname}-${pkgver}-x86_64.tar.gz")
sha256sums=(
  '3aec3c396fe34d3d564d698b1606a08c23f3f82e0d4a606968a8d11e6f6dd932'
  '935e123b87a96a4de1c2d2b4df9c5054761f4e8fbeec31f05b51a0b85aa5dc31'
  'bceb6d870a0d92396ee9fe012ed84e71d629ad45336ed4e7012852dcebd00362'
  'ad0971e93559e5a924cd352b2bdb661d68ce8e93a1f9f28d6b3b79b2a42d3bb5'
)
sha256sums_x86_64=('d4b7a9189195510ac676f00b535f7e2aad93f988cee972aced6793ce7b9e5f8b')

package() {
  # Extract the full relocatable bundle directly with --no-same-owner so every
  # file is root-owned while preserving $ORIGIN/../lib RPATH and share/blackbird/.
  install -dm755 "${pkgdir}/usr/lib/blackbird" "${pkgdir}/usr/bin"
  bsdtar --no-same-owner --strip-components=1 \
    -xf "${srcdir}/${pkgname}-${pkgver}-x86_64.tar.gz" \
    -C "${pkgdir}/usr/lib/blackbird"

  cat > "${pkgdir}/usr/bin/blackbird" <<'EOF'
#!/bin/sh
set -eu
export BLACKBIRD_SPRITE_ASSET="${BLACKBIRD_SPRITE_ASSET:-/usr/lib/blackbird/share/blackbird/assets/sr71.png}"
exec /usr/lib/blackbird/scripts/blackbird "$@"
EOF
  chmod 755 "${pkgdir}/usr/bin/blackbird"

  install -Dm644 "${pkgdir}/usr/lib/blackbird/share/blackbird/assets/sr71.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/blackbird.png"
  install -Dm644 "${srcdir}/blackbird.desktop" \
    "${pkgdir}/usr/share/applications/blackbird.desktop"
  install -Dm644 "${srcdir}/blackbird-flightdeck.desktop" \
    "${pkgdir}/usr/share/applications/blackbird-flightdeck.desktop"
  install -Dm755 "${srcdir}/50-blackbird" \
    "${pkgdir}/usr/share/blackbird/omarchy/50-blackbird"
  install -Dm644 "${srcdir}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
