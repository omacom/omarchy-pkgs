# Maintainer: yamz8 <https://github.com/yamz8>

pkgname=omaread
pkgver=0.1.1
pkgrel=1
pkgdesc='Read books and documents: PDF, EPUB, comics, Markdown and text'
arch=('x86_64' 'aarch64')
url='https://github.com/yamz8/omaread'
license=('MIT')
options=('!debug')
depends=('hicolor-icon-theme' 'libarchive' 'poppler-qt6' 'qt6-base' 'qt6-declarative' 'qt6-imageformats' 'qt6-svg' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('cmake' 'gcc' 'make')
checkdepends=('noto-fonts' 'qpdf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('7e6a15ed1478dbe1c5aa746f0d2b0f784c26b0dd9eeef9afaaefc15ebe34a97c')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ctest --test-dir build --output-on-failure
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build --prefix /usr
}
