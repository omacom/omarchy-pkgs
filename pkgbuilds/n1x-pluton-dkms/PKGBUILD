check() {
  cd "$srcdir"
  cc -std=c11 -Wall -Wextra -Werror -fsanitize=address,undefined -g -o protocol-test protocol_test.c
  ./protocol-test
  python test_wait.py
  python test_query.py
  python test_package.py
}

package() {
  install -Dm644 "$srcdir/n1x_pluton.c" "$pkgdir/usr/src/n1x-pluton-$pkgver/n1x_pluton.c"
  install -Dm644 "$srcdir/Kbuild" "$pkgdir/usr/src/n1x-pluton-$pkgver/Kbuild"
  install -Dm644 "$srcdir/dkms.conf" "$pkgdir/usr/src/n1x-pluton-$pkgver/dkms.conf"
  install -Dm644 "$srcdir/n1x_pluton_protocol.h" "$pkgdir/usr/src/n1x-pluton-$pkgver/n1x_pluton_protocol.h"
  install -Dm644 "$srcdir/n1x_pluton_uapi.h" "$pkgdir/usr/src/n1x-pluton-$pkgver/n1x_pluton_uapi.h"
  install -Dm644 "$srcdir/n1x_pcbi_protocol.h" "$pkgdir/usr/src/n1x-pluton-$pkgver/n1x_pcbi_protocol.h"
  install -Dm755 "$srcdir/pluton-info.py" "$pkgdir/usr/bin/n1x-pluton-info"
  install -Dm644 "$srcdir/README.package.md" "$pkgdir/usr/share/doc/$pkgname/README.package.md"
  install -Dm644 "$srcdir/pluton-info.py" "$pkgdir/usr/share/doc/$pkgname/pluton-info.py"
  install -Dm644 "$srcdir/protocol.md" "$pkgdir/usr/share/doc/$pkgname/protocol.md"
  install -Dm644 "$srcdir/protocol_test.c" "$pkgdir/usr/share/doc/$pkgname/protocol_test.c"
  install -Dm644 "$srcdir/provenance.json" "$pkgdir/usr/share/doc/$pkgname/provenance.json"
  install -Dm644 "$srcdir/references.json" "$pkgdir/usr/share/doc/$pkgname/references.json"
  install -Dm644 "$srcdir/source-provenance.json" "$pkgdir/usr/share/doc/$pkgname/source-provenance.json"
  install -Dm644 "$srcdir/test_package.py" "$pkgdir/usr/share/doc/$pkgname/test_package.py"
  install -Dm644 "$srcdir/test_wait.py" "$pkgdir/usr/share/doc/$pkgname/test_wait.py"
  install -Dm644 "$srcdir/test_query.py" "$pkgdir/usr/share/doc/$pkgname/test_query.py"
}
