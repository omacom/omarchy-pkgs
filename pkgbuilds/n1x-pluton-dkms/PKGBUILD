pkgdesc='NVIDIA N1X PLUTON bounded firmware diagnostics (manual loading)'
arch=('aarch64')
url='https://github.com/johannhartmann/asus-proart-p16-rtx-spark-linux'
license=('GPL-2.0-only')
depends=('dkms' 'python')
makedepends=('gcc' 'python')
source=('Kbuild' 'README.package.md' 'dkms.conf' 'n1x_pcbi_protocol.h' 'n1x_pluton.c' 'n1x_pluton_protocol.h' 'n1x_pluton_uapi.h' 'pluton-info.py' 'protocol.md' 'protocol_test.c' 'provenance.json' 'references.json' 'source-provenance.json' 'test_package.py' 'test_query.py' 'test_wait.py')
