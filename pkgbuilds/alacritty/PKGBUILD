# Alacritty, rebuilt so a link opened from a hint carries an xdg-activation
# token for the click.
#
# Alacritty launched hint commands (xdg-open for URLs) without one, and winit
# 0.30 requested tokens without the input serial compositors check, so the
# browser opening the link couldn't raise its window for the user's click.
# Both patches go once upstream has them: winit-activation-serial.patch with a
# winit 0.30 release carrying rust-windowing/winit#4783 that Alacritty locks,
# hint-activation-token.patch with an Alacritty release that passes the token.
#
# Recipe follows Arch's extra/alacritty. pkgrel stays ahead of Arch's so pacman
# replaces an installed extra/alacritty of the same version.

pkgname=alacritty
pkgver=0.17.0
pkgrel=2
pkgdesc='A cross-platform, GPU-accelerated terminal emulator'
arch=(x86_64 aarch64)
url='https://github.com/alacritty/alacritty'
license=(Apache-2.0 MIT)
depends=(
  fontconfig
  freetype2
  libxcursor
  libxi
  libxkbcommon
  libxkbcommon-x11
  libxrandr
)
makedepends=(
  cargo
  cmake
  desktop-file-utils
  libxcb
  ncurses
  rust
  scdoc
)
checkdepends=(ttf-dejavu)
optdepends=('ncurses: for alacritty terminfo database')
_winitver=0.30.13
source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
  "winit-$_winitver.tar.gz::https://static.crates.io/crates/winit/winit-$_winitver.crate"
  'hint-activation-token.patch'
  'winit-activation-serial.patch'
)
sha256sums=(
  '38d6527d346cda5c6049332a1f3338a89ea66cd7981b54d4c3ce801b392496f8'
  'a6755fa58a9f8350bd1e472d4c3fcc25f824ec358933bba33306d0b63df5978d'
  '5383bc5866d8f34cf1e9f539ee83c38591c59bfa0199e1283a71badff5ebb5d0'
  '66765800139abf7ae8029b346f1f621a499be69e7f0421666931c14819ccf54c'
)

prepare() {
  patch -d "winit-$_winitver" -Np1 --fuzz=0 -i "$srcdir/winit-activation-serial.patch"

  cd "$pkgname-$pkgver"
  patch -Np1 --fuzz=0 -i "$srcdir/hint-activation-token.patch"

  # Build against the patched winit. The lock entry for winit is the only one
  # that changes, so fetch without --locked once, then build frozen.
  printf '\n[patch.crates-io]\nwinit = { path = "%s" }\n' "$srcdir/winit-$_winitver" >>Cargo.toml
  cargo fetch --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  CARGO_INCREMENTAL=0 cargo build --release --frozen
}

check() {
  cd "$pkgname-$pkgver"
  CARGO_INCREMENTAL=0 cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  desktop-file-install -m 644 --dir "$pkgdir/usr/share/applications/" "extra/linux/Alacritty.desktop"
  install -D -m755 "target/release/alacritty" "$pkgdir/usr/bin/alacritty"
  scdoc <"extra/man/alacritty.1.scd" | install -D -m644 /dev/stdin "$pkgdir/usr/share/man/man1/alacritty.1"
  scdoc <"extra/man/alacritty.5.scd" | install -D -m644 /dev/stdin "$pkgdir/usr/share/man/man5/alacritty.5"
  scdoc <"extra/man/alacritty-msg.1.scd" | install -D -m644 /dev/stdin "$pkgdir/usr/share/man/man1/alacritty-msg.1"
  scdoc <"extra/man/alacritty-bindings.5.scd" | install -D -m644 /dev/stdin "$pkgdir/usr/share/man/man5/alacritty-bindings.5"
  scdoc <"extra/man/alacritty-escapes.7.scd" | install -D -m644 /dev/stdin "$pkgdir/usr/share/man/man7/alacritty-escapes.7"
  install -D -m644 "extra/linux/org.alacritty.Alacritty.appdata.xml" "$pkgdir/usr/share/metainfo/org.alacritty.Alacritty.appdata.xml"
  install -D -m644 "extra/completions/alacritty.bash" "$pkgdir/usr/share/bash-completion/completions/alacritty"
  install -D -m644 "extra/completions/_alacritty" "$pkgdir/usr/share/zsh/site-functions/_alacritty"
  install -D -m644 "extra/completions/alacritty.fish" "$pkgdir/usr/share/fish/vendor_completions.d/alacritty.fish"
  install -D -m644 "extra/logo/compat/alacritty-term.svg" "$pkgdir/usr/share/pixmaps/Alacritty.svg"
}
