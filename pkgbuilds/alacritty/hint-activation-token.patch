+    #[cfg(not(any(target_os = "macos", windows)))]
+    pub fn request_launch_token(&mut self, program: &str, args: Vec<String>) -> bool {
+        match self.window.request_activation_token() {
+            Ok(serial) => {
+                self.pending_launches.push((serial, program.to_owned(), args));
+                true
+            },
+            Err(_) => false,
