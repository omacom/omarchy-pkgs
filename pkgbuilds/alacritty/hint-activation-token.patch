+    /// Take the program waiting for the activation token with this serial.
+    #[cfg(not(any(target_os = "macos", windows)))]
+    pub fn take_pending_launch(
+        &mut self,
+        serial: AsyncRequestSerial,
+    ) -> Option<(String, Vec<String>)> {
+        let index = self.pending_launches.iter().position(|(pending, ..)| *pending == serial)?;
+        let (_, program, args) = self.pending_launches.remove(index);
+        Some((program, args))
+    }
