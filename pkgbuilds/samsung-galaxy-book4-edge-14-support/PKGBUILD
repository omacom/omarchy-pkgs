# Maintainer: Birk Skyum <birk.skyum@pm.me>
# Contributor: Jonny Heggheim
# Contributor: Nicola Nicodemo
#
# Hardware support for the Samsung Galaxy Book4 Edge 14 (X1E-80-100) that no
# upstream package carries yet. The battery, charger, USB-C ports, keyboard
# backlight and fan come from linux-omarchy's EC and S2MM006 drivers; this
# package has what stays in userspace:
# - the keyboard's udev tags, so libinput opens it as a keyboard and not as a
#   tablet pad (Jonny Heggheim's, github.com/hegjon/omarchy-galaxy-book4-edge);
# - a Bluetooth address, which the WCN7850's NVM doesn't have (his too);
# - the name its tree gives the sound topology, for the CRD's, whose DAI links
#   the card matches (Nicola Nicodemo's, github.com/n1c0la84/book4-edge-linux).
pkgname=samsung-galaxy-book4-edge-14-support
pkgver=1
pkgrel=1
pkgdesc="Hardware support for the Samsung Galaxy Book4 Edge 14 not yet carried upstream"
arch=('aarch64')
# Qualcomm-only: the pacman platform guard keeps it off other hardware.
groups=('omarchy-platform-qualcomm')
url="https://github.com/omacom/omarchy-pkgs"
license=('MIT')
depends=('bash' 'bluez-utils' 'linux-firmware-qcom' 'systemd')
source=(
  '61-samsung-galaxy-book4-edge-14-keyboard.rules'
  '63-samsung-galaxy-book4-edge-14-bluetooth.rules'
  'bdaddr'
  'samsung-galaxy-book4-edge-14-bdaddr@.service'
  'README.package.md'
)
sha256sums=('3a4e8a4677593854a03643cb5e51909f9ce129455f6738240c78b8aa5a495111'
            'f2e9ad5e16213add690c098073f7376f90956f1ef737de05668571cdb020c351'
            '2b0cf1175fbd358bf4a97fc343d94d8d8a059f1b98cc8f889fdec10074575b1b'
            '22b9a04070e74ef9711e94926d5da020dbe6f03810fd15ef2539435f845adc57'
            '832d3c5232854e44af69bdf4adcdb8bb0acf31528b3b78d7ef3e585940098fb3')

package() {
  install -Dm755 bdaddr -t "$pkgdir/usr/lib/samsung-galaxy-book4-edge-14"

  install -Dm644 -t "$pkgdir/usr/lib/udev/rules.d" \
    61-samsung-galaxy-book4-edge-14-keyboard.rules \
    63-samsung-galaxy-book4-edge-14-bluetooth.rules
  # The Bluetooth address unit starts from its udev rule.
  install -Dm644 samsung-galaxy-book4-edge-14-bdaddr@.service -t "$pkgdir/usr/lib/systemd/system"

  # The tree's sound card asks for X1E80100-GalaxyBook4Edge-tplg.bin. Its DAI
  # links (WCD playback and capture, WSA playback, VA capture, the same
  # back-end IDs) are the CRD's, so it takes the CRD's topology.
  install -d "$pkgdir/usr/lib/firmware/qcom/x1e80100"
  ln -s X1E80100-CRD-tplg.bin \
    "$pkgdir/usr/lib/firmware/qcom/x1e80100/X1E80100-GalaxyBook4Edge-tplg.bin"

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
