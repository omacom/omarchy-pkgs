# Maintainer: David Heinemeier Hansson <david@hey.com>
pkgname='omarchy-themes-intros'
pkgver=2026.10.25
pkgrel=1
# The theme intro videos are most of omarchy-dev's size and change far less
# often than the code, so they ship here and omarchy-dev rebuilds each quattro
# tip without them. Pinned by hand to the last commit that touched an intro and
# versioned by that commit's date: bump both when an intro is added or changed.
# Until then a new intro is simply not played, since a background without one
# switches straight to the still image.
_commit=a1ea6096d0bd88bd61ed871fc35628cd56e8bb72
pkgdesc='Background intro videos for the Omarchy themes'
arch=('any')
url='https://github.com/omacom/omarchy'
license=('MIT')
makedepends=('git')
source=("omarchy::git+https://github.com/omacom/omarchy.git#commit=${_commit}")
sha256sums=('90aa5ee90f012ddc36a91a129c48c3f7145c5bd9424d8f69d1ceab259df12114')

package() {
  cd "$srcdir/omarchy"

  local intros
  for intros in themes/*/backgrounds/intros; do
    install -d "$pkgdir/usr/share/omarchy/$intros"
    cp -a "$intros/." "$pkgdir/usr/share/omarchy/$intros/"
  done
}
