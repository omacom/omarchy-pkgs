# Maintainer: David Heinemeier Hansson <david@hey.com>
pkgname='omarchy-themes-intros'
pkgver=2026.11.18
pkgrel=1
# The theme intro videos live in their own repository, so omarchy and each
# omarchy-dev rebuild of a quattro tip stay small. Pinned by hand to a commit
# there and versioned by its date: bump both when an intro is added or
# changed. Until then a new intro is simply not played, since a background
# without one switches straight to the still image.
_commit=3c8d7f0d0d292898069ae264bdb89e6bdfc355c3
pkgdesc='Background intro videos for the Omarchy themes'
arch=('any')
url='https://github.com/omacom/omarchy-themes-intros'
license=('MIT')
makedepends=('git')
source=("intros::git+https://github.com/omacom/omarchy-themes-intros.git#commit=${_commit}")
sha256sums=('5764fce81a8a200798159a21f065091f6a429e6d707df1e99e76bdde7a7ab11c')

package() {
  cd "$srcdir/intros"

  local intro theme
  for intro in */*.mp4; do
    theme=${intro%%/*}
    install -Dm644 "$intro" "$pkgdir/usr/share/omarchy/themes/$theme/backgrounds/intros/${intro#*/}"
  done
}
