# Maintainer: David Heinemeier Hansson <david@hey.com>
pkgname='omarchy-themes-intros'
pkgver=2026.11.24.1
pkgrel=1
pkgdesc='Background intro videos for the Omarchy themes'
arch=('any')
url='https://github.com/omacom/omarchy-themes-intros'
license=('MIT')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('661223695d7c5a2c1e18f6fa487368d202ac10eee216463451299bd92be31f98')

package() {
  cd "$srcdir/$pkgname-$pkgver"

  local intro theme
  for intro in */*.mp4; do
    theme=${intro%%/*}
    install -Dm644 "$intro" "$pkgdir/usr/share/omarchy/themes/$theme/backgrounds/intros/${intro#*/}"
  done
}
