#!/bin/bash

# Omarchy loads shortcuts.lua from its selected backend, so the vendor's
# generated Hyprland block must live in a file Hyprland does not load.
export SUPERWHISPER_HYPR_BINDINGS="${XDG_CONFIG_HOME:-$HOME/.config}/superwhisper/hypr-block.lua"
mkdir -p "${SUPERWHISPER_HYPR_BINDINGS%/*}"
if [[ ! -e $SUPERWHISPER_HYPR_BINDINGS ]]; then
  install -m600 /dev/null "$SUPERWHISPER_HYPR_BINDINGS"
fi

if [[ ${1:-} == "update" ]]; then
  echo "Superwhisper is updated through Omarchy's package repository." >&2
  exit 1
fi
exec /opt/superwhisper/run.sh "$@"
