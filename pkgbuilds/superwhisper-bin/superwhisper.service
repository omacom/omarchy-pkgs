[Unit]
Description=Superwhisper dictation
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/superwhisper daemon
ExecStopPost=/usr/bin/superwhisper playback-restore
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=graphical-session.target
