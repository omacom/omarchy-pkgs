{
  "source": "local",
  "auto_merge": true,
  "release_ring": "fast",
  "min_release_age": "24h",
  "upstream": {
    "watch": {
      "github": "superultrainc/superwhisper-linux-releases",
      "pattern": "v(?P<version>[0-9]+(?:\\.[0-9]+)*)",
      "variables": {
        "_version": "{version}"
      }
    }
  }
}
