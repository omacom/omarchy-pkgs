pkgname=voxtype-cohere-vulkan
pkgver=0.1.0
pkgrel=1
pkgdesc="Local Cohere Transcribe Vulkan helper for Voxtype"
arch=('x86_64')
url="https://github.com/omacom/omarchy-pkgs"
license=('MIT')
depends=('gcc-libs' 'glibc' 'cblas' 'blas' 'vulkan-icd-loader')
makedepends=('cargo' 'cmake' 'shaderc')
# GCC LTO archives cannot be linked by Rust's LLVM linker.
options=('!debug' '!lto')

_vulkan=e3b1eec08173d6b825cd3ac88c885a63b621504a
_spirv=f1fa5178eced755a189619b8e4546bcc2ce69fdd
source=(
  'Cargo.toml' 'Cargo.lock' 'build.rs' 'main.rs' 'segment.rs' 'test.wav' 'LICENSE' 'README.md'
  "vulkan-headers-$_vulkan.tar.gz::https://github.com/KhronosGroup/Vulkan-Headers/archive/$_vulkan.tar.gz"
  "spirv-headers-$_spirv.tar.gz::https://github.com/KhronosGroup/SPIRV-Headers/archive/$_spirv.tar.gz"
)

sha256sums=(
  'cb26f6f84ed280a05ed34e7b5d411fa8fa14a1d4d0b4df749468918caa7be8f1'
  'b87e0fe73482328ab9204916dc60d1bb8307e4efef39f8fcd73a2775e3cb0e83'
  'fe8774aa15148c737b8df0b6ebee434ed5a46be8d06a52233b65689431d57fdc'
  '803b9a8f83000f14f58123abe0248906c265387ad395e711503a5064325d6584'
  'eb182b9cdc3a21b9f97a80ea4ae7cde006af022b7811eb3e464289079c1500c4'
  '36247f59969e0916c860e01cf28d53e7e41eeb17b11f474b3f1f01e6b49acf05'
  '223aef11b984f09fdff5481ab6159957c55e5368d409b31e5cbc78401823eaf3'
  'ac7571d310fe0eb4eed8dc651e5e91d9b911750782dfd9d8801e988cdf241893'
  'f492279345cbc10708b64fcd432b3ff6c8246a5837c4db2b649abba00cf82208'
  'b3131b3ad9dc5220d4129d83088e22b90373ce1ed663f591fac18a5a07e1b0e3'
)

prepare() {
  mkdir -p src samples
  cp main.rs segment.rs src/
  cp test.wav samples/
  cargo fetch --locked
  cmake -S "SPIRV-Headers-$_spirv" -B spirv-build -DCMAKE_INSTALL_PREFIX="$srcdir/headers"
  cmake --install spirv-build
}

_build_env() {
  export CXXFLAGS="$CXXFLAGS -I$srcdir/headers/include"
  export TRANSCRIBE_CMAKE_ARGS="-DVulkan_INCLUDE_DIR=$srcdir/Vulkan-Headers-$_vulkan/include -DCMAKE_PREFIX_PATH=$srcdir/headers -DGGML_NATIVE=OFF -DTRANSCRIBE_X86_CONSERVATIVE=ON"
  export CMAKE_BUILD_PARALLEL_LEVEL=4
}

build() {
  _build_env
  cargo build --frozen --release -j 4
}

check() {
  _build_env
  # No GPU/model download needed for the deterministic segmentation tests.
  cargo test --frozen --release -j 4
}

package() {
  install -Dm755 target/release/voxtype-cohere-vulkan "$pkgdir/usr/bin/voxtype-cohere-vulkan"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
