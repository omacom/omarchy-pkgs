{
  "source": "local",
  "auto_merge": true,
  "release_ring": "fast",
  "upstream": {
    "watch": {
      "json": "https://slack.com/api/desktop.latestRelease?arch=x64&variant=deb",
      "path": "version",
      "source_variables": {
        "_electronver": {
          "source": "source:0",
          "member": "usr/lib/slack/version",
          "pattern": "(?P<value>[0-9]+\\.[0-9]+\\.[0-9]+)"
        }
      }
    }
  }
}
