# Maintainer: Tim Apple <179739321+ninepointlabs@users.noreply.github.com>

pkgname=fm-cli
pkgver=0.3.0
pkgrel=1
pkgdesc="Fastmail from the terminal: mail TUI, scriptable JSON commands, and live watch"
arch=('x86_64' 'aarch64')
url="https://github.com/ninepointlabs/fm-cli"
license=('MIT')
depends=('glibc')
makedepends=('go>=2:1.26.0')
optdepends=('gnome-keyring: store sign-in tokens via the Secret Service'
            'kwallet: store sign-in tokens in KDE Wallet'
            'xdg-utils: open the Fastmail consent page during sign-in')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/ninepointlabs/fm-cli/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b6a7410c200f0db15c7a0ae342e82184c3eec6c631c567bffe62c427c1f0c797')

prepare() {
  cd "$pkgname-$pkgver"

  export GOFLAGS="-mod=readonly -modcacherw"
  go mod download
}

build() {
  cd "$pkgname-$pkgver"

  export CGO_ENABLED=0
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  go build -ldflags "-s -w -X main.version=$pkgver" -o $pkgname ./cmd/fm-cli
}

check() {
  cd "$pkgname-$pkgver"

  export CGO_ENABLED=0
  export GOFLAGS="-trimpath -mod=readonly -modcacherw"
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 $pkgname "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
