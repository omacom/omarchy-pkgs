# Maintainer: owe contributors
pkgname=owe
pkgver=0.2.8
pkgrel=1
pkgdesc="High-performance wallpaper engine for Omarchy (mp4, gif, stills)"
arch=('x86_64' 'aarch64')
url="https://github.com/omacom/owe"
license=('MIT')
depends=('mpv' 'ffmpeg' 'wayland' 'libglvnd' 'libepoxy' 'systemd-libs' 'socat')
makedepends=('meson' 'ninja' 'gcc' 'pkgconf' 'wayland-protocols')
checkdepends=('python')
optdepends=('intel-media-driver: VAAPI hardware decode on Intel GPUs'
            'libva-mesa-driver: VAAPI hardware decode on AMD GPUs')
# VERIFICATION ONLY. Builds the merged main commit instead of a release tag,
# to prove owe:transition passes on aarch64 before v0.2.8 is tagged and
# pushed to the AUR. Do not merge. See omacom/owe#7.
_commit=6e85a92e51dcf1af7017695a3d97e2f69556548a
source=("$pkgname-$pkgver.tar.gz::https://github.com/omacom/owe/archive/$_commit.tar.gz")
sha256sums=('8341282b728222e1095fe770032edb530e1c7ebb22b56d9f9ea3e38bb492aee7')

build() {
  meson setup build "$srcdir/owe-$_commit" -Dbuildtype=release -Dprefix=/usr
  ninja -C build
}

check() {
  meson test -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
  install -d "$pkgdir/usr/lib/systemd/user"
  sed 's|%h/.local/bin/owed|/usr/bin/owed|' "$srcdir/owe-$_commit/systemd/owed.service" \
    >"$pkgdir/usr/lib/systemd/user/owed.service"
  install -Dm755 "$srcdir/owe-$_commit/hooks/owe-idle" "$pkgdir/usr/bin/owe-idle"
  install -Dm644 "$srcdir/owe-$_commit/hooks/theme-set.d/10-owe-sync" "$pkgdir/usr/share/owe/10-owe-sync"
  install -Dm644 "$srcdir/owe-$_commit/config/config.toml" "$pkgdir/usr/share/doc/$pkgname/config.toml.example"
}
