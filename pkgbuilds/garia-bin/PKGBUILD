pkgname=garia-bin
pkgver=0.3.2
pkgrel=1
pkgdesc="Download manager with built-in aria2, ffmpeg, and yt-dlp"
arch=('x86_64')
url="https://github.com/fabimc/garia"
license=('MIT')
depends=(
  'desktop-file-utils'
  'glibc'
  'gtk3'
  'libayatana-appindicator'
  'mesa'
  'openssl'
  'python'
  'webkit2gtk-4.1'
)
provides=('garia')
conflicts=('garia')
install=garia-bin.install
options=('!strip' '!debug')

source=(
  "garia-${pkgver}-linux-x86_64.tar.gz::https://github.com/fabimc/garia/releases/download/v${pkgver}/garia-${pkgver}-linux-x86_64.tar.gz"
  "garia-${pkgver}-README.md::https://raw.githubusercontent.com/fabimc/garia/v${pkgver}/README.md"
  "garia-${pkgver}-LICENSE::https://raw.githubusercontent.com/fabimc/garia/v${pkgver}/LICENSE"
)
sha256sums=('dc1bfd533e09e7c51a12f7e220e9dd3cfb56cbef9b9dd6f10fc82ba6adaa0355'
            'ae67d3ee7331115b01688c3ca08916dc659366d473edab634dde97e571667e26'
            '2a0ccc0227c59fb2fe74710b201ff1b4ea6d244cc2ee95019567887c7a5911a3')

package() {
  install -d "$pkgdir/opt"
  cp -a "$srcdir/garia" "$pkgdir/opt/garia"

  # The bundled OpenSSL library lacks its legacy provider; use Arch's system OpenSSL.
  rm "$pkgdir/opt/garia/usr/lib/libcrypto.so.3" "$pkgdir/opt/garia/usr/lib/libssl.so.3"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/garia" <<'EOF'
#!/bin/sh
exec /opt/garia/AppRun "$@"
EOF

  install -Dm644 "$srcdir/garia/usr/share/applications/Garia.desktop" \
    "$pkgdir/usr/share/applications/garia.desktop"
  sed -i 's/^Exec=garia$/Exec=garia %U/' "$pkgdir/usr/share/applications/garia.desktop"

  while IFS= read -r -d '' icon; do
    relative="${icon#"$srcdir/garia/usr/share/icons/hicolor/"}"
    install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/$relative"
  done < <(find "$srcdir/garia/usr/share/icons/hicolor" -type f -name 'garia.png' -print0)

  install -Dm644 "$srcdir/garia-${pkgver}-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/garia-${pkgver}-README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
