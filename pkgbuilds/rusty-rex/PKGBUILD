pkgname=rusty-rex
pkgver=1.8.0
pkgrel=1
pkgdesc='The Chrome offline dinosaur game, rebuilt in Rust'
arch=('x86_64' 'aarch64')
url='https://github.com/yamz8/rusty-rex'
license=('MIT')
# The window and GL libraries are loaded at runtime rather than linked.
depends=('alsa-lib' 'gcc-libs' 'glibc' 'libglvnd' 'libx11' 'libxi')
makedepends=('cargo' 'git')
source=("rusty-rex::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd rusty-rex
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd rusty-rex
  export CARGO_TARGET_DIR=target
  # Let makepkg strip the binary and split the symbols into the -debug package.
  export CARGO_PROFILE_RELEASE_STRIP=false
  cargo build --frozen --release
}

check() {
  cd rusty-rex
  cargo test --frozen
}

package() {
  cd rusty-rex
  install -Dm755 target/release/rusty-rex -t "$pkgdir/usr/bin"
  install -Dm644 pkgbuild/rusty-rex.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 pkgbuild/rusty-rex.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE NOTICE -t "$pkgdir/usr/share/licenses/$pkgname"
}
