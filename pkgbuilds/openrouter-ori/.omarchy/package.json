{
  "source": "local",
  "auto_merge": true,
  "release_ring": "fast",
  "upstream": {
    "watch": {
      "regex": "https://openrouter.ai/labs/ori/version",
      "pattern": "^(?P<version>[0-9]+(?:\\.[0-9]+)*)\\+(?P<build>[0-9a-f]+)\\s*$",
      "variables": {
        "_build": "{build}"
      }
    }
  }
}
