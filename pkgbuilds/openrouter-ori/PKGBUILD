# Maintainer: The Omarchy Authors
pkgname=openrouter-ori
pkgver=0.17.3
pkgrel=1
# Upstream tags each release cli-<version>-<build>, the build being its commit.
_build=81bcf49
pkgdesc="Ori, OpenRouter's local agent CLI"
arch=('x86_64' 'aarch64')
url="https://openrouter.ai/labs/ori"
license=('Apache-2.0')
depends=('glibc')
# The binary is a Bun executable with its JavaScript appended; stripping breaks it.
options=('!strip' '!debug')
_release="https://github.com/OpenRouterLabs/ori-releases/releases/download/cli-${pkgver}-${_build}"
source=("LICENSE-${pkgver}::${_release}/LICENSE"
        "NOTICE-${pkgver}::${_release}/NOTICE")
source_x86_64=("ori-${pkgver}-x86_64.gz::${_release}/ori-linux-x64.gz")
source_aarch64=("ori-${pkgver}-aarch64.gz::${_release}/ori-linux-arm64.gz")
sha256sums=('ee6f303260558acde280e51efed82d48c189ca64a8b4807568409f0ed23058cf'
            '8cfae42bd1d691f592e7ff9707d5539d76fc002f509b18ca49c4c0be6022917b')
sha256sums_x86_64=('26fbb3a660db5b86af2359919dadcbb6f651100247eb272dd11849b24825160a')
sha256sums_aarch64=('24a6f0bbd1c032a371095202c75e23bc25946c4cefe2e99bcba528a15d32cef2')

package() {
  install -Dm755 "${srcdir}/ori-${pkgver}-${CARCH}" "${pkgdir}/usr/lib/${pkgname}/ori"
  install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${srcdir}/NOTICE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE"

  # pacman updates this install. ORI_DISABLE_UPDATES stops the background
  # updater, its notices and `ori update`, which would overwrite a file pacman
  # owns. ORI_NO_UPDATE_CHECK also hides the published-minimum notice.
  install -dm755 "${pkgdir}/usr/bin"
  cat >"${pkgdir}/usr/bin/ori" <<'WRAPPER'
#!/bin/bash
export ORI_DISABLE_UPDATES=1
export ORI_NO_UPDATE_CHECK=1
exec /usr/lib/openrouter-ori/ori "$@"
WRAPPER
  chmod 755 "${pkgdir}/usr/bin/ori"
}
