pkgname=omarchy-ttfx-layer
pkgver=0.3.1
pkgrel=1
pkgdesc="The ttfx text effects drawn by the GPU on a Wayland layer, as an Omarchy background or screensaver"
arch=('x86_64' 'aarch64')
url="https://github.com/avillagran/omarchy-ttfx-layer"
license=('MIT')
depends=('gcc-libs' 'glibc' 'gtk4' 'gtk4-layer-shell' 'pango' 'cairo' 'glib2' 'libglvnd' 'wayland')
makedepends=('cargo' 'pkgconf')
makedepends_x86_64=('nasm')
optdepends=(
  'hyprland: output size and scale without --width/--height/--scale'
  'omarchy-ambient: runs it as the Omarchy Effects background and screensaver'
)
options=('!debug')

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('d9900a52f5ee735aec9a595d79c9d4198c4aa5f749213ee5c3b0fec5b2a8c15e')

prepare() {
  cd "$pkgname-$pkgver/bin/ttfx-bg-rs"

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver/bin/ttfx-bg-rs"

  # Without the vte feature the binary does not link libvte: only the GPU layer.
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --no-default-features
}

package() {
  cd "$pkgname-$pkgver"

  # The program selects its standalone mode from this name.
  install -Dm755 bin/ttfx-bg-rs/target/release/ttfx-bg-rs "$pkgdir/usr/bin/omarchy-ttfx-layer"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 ttfx-src/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.ttfx"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
