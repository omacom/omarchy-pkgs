# Maintainer: Demian Neidetcher <demian0311@gmail.com>
pkgname=cliamp-deck
pkgver=0.2.1
pkgrel=1
pkgdesc='A btop x Winamp terminal face for cliamp, with themed demoscene visualizers'
arch=(x86_64 aarch64)
url='https://github.com/demian0311/cliamp-deck'
license=(MIT)
# Talks to a running cliamp over its IPC socket and starts `cliamp --daemon`
# when none answers. The binary itself is static (CGO_ENABLED=0).
depends=(cliamp)
# Upstream's release workflow builds it static with -trimpath; stripping only
# rewrites a Go binary and yields an empty -debug package.
options=(!strip !debug)
# Release assets carry no version, so the local names add one: otherwise a new
# release would reuse a cached file of the same name.
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/demian0311/cliamp-deck/v$pkgver/LICENSE"
        "cliamp-deck-$pkgver.desktop::https://raw.githubusercontent.com/demian0311/cliamp-deck/v$pkgver/packaging/arch/cliamp-deck.desktop")
source_x86_64=("cliamp-deck-$pkgver-x86_64::$url/releases/download/v$pkgver/cliamp-deck-linux-x86_64")
source_aarch64=("cliamp-deck-$pkgver-aarch64::$url/releases/download/v$pkgver/cliamp-deck-linux-aarch64")
sha256sums=('fb68eb025670e4455168cd161909afa7fd86d91a1f33160d6f3030ffdda6c20d'
            '3628aeeea4ef05755bf57b5a2a69fa2b9970bc5c27e40c899425aec6b95f2a36')
sha256sums_x86_64=('7708779df6da582267c05f790d4ab50fa3e442794182f83d3bac8e4d27350045')
sha256sums_aarch64=('23335f5f386ebc251fbb6fffedc4dc86fefe612015c7cb2357f6bf27664c558e')

package() {
  install -Dm755 "cliamp-deck-$pkgver-$CARCH" "$pkgdir/usr/bin/cliamp-deck"
  install -Dm644 "cliamp-deck-$pkgver.desktop" "$pkgdir/usr/share/applications/cliamp-deck.desktop"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
