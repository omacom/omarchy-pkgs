post_install() {
    echo 'Run super-desktop-setup as your normal user to configure the shortcut, autostart and themes.'
    echo 'Moving from install.sh? Run /usr/bin/super-desktop-setup --migrate instead.'
}

post_upgrade() {
    echo 'Restart SUPER DESKTOP, or log out and back in, to use the updated version.'
    echo 'From your desktop terminal: /usr/bin/super-desktop kill && /usr/bin/super-desktop toggle'
}
