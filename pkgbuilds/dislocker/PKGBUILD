pkgname=dislocker
pkgver=0.7.3
pkgrel=7
pkgdesc='Access BitLocker-encrypted volumes'
arch=('x86_64' 'aarch64')
url='https://github.com/Aorimn/dislocker'
license=('GPL-2.0-or-later')
depends=('glibc' 'fuse2' 'mbedtls3' 'ruby')
makedepends=('cmake')
optdepends=('ntfs-3g: read the decrypted NTFS filesystem')
options=('!debug')
source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz"
  "upstream.patch::$url/compare/v$pkgver...3e7aea196eaa176c38296a9bc75c0201df0a3679.patch"
)
sha256sums=(
  '8d5275577c44f2bd87f6e05dd61971a71c0e56a9cbedf000bd38deadd8b6c1e6'
  '486d26ff94038b93b542a1a37143fd5247f02c206e06d9b3163cf4c5a5f41cfb'
)

prepare() {
  cd "$srcdir/$pkgname-$pkgver"
  patch -p1 < ../upstream.patch
}

build() {
  # Dislocker's upstream backend supports Mbed TLS 3, not the current TLS 4 API.
  cmake -S "$pkgname-$pkgver" -B build \
    -DCMAKE_INSTALL_PREFIX=/usr -Dlibdir=/usr/lib \
    -DPOLARSSL_INCLUDE_DIRS=/usr/include/mbedtls3 \
    -DPOLARSSL_LIBRARIES=/usr/lib/mbedtls3/libmbedcrypto.so \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DWARN_FLAGS='-Wall -Wno-error -Wextra'
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname-$pkgver/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$pkgname-$pkgver/LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
