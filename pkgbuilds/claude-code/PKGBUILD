# Maintainer: The Omarchy Authors
pkgname=claude-code
pkgver=2.1.331
pkgrel=1
pkgdesc="Claude Code, Anthropic's agentic coding tool for the terminal"
arch=('x86_64' 'aarch64')
url="https://code.claude.com"
license=('LicenseRef-claude-code')
depends=('glibc')
makedepends=('jq')
optdepends=(
  'git: allow Claude to use git'
  'github-cli: interact with GitHub'
  'glab: interact with GitLab'
  'ripgrep: enhanced file search'
  'tmux: agent team split panes'
  'bubblewrap: sandboxing'
  'socat: sandboxing'
)
# The binary is a Bun executable with its JavaScript appended; stripping breaks it.
options=('!strip' '!debug')
source=("claude-${pkgver}-manifest.json::https://downloads.claude.ai/claude-code-releases/${pkgver}/manifest.json"
        "claude-${pkgver}-manifest.json.sig::https://downloads.claude.ai/claude-code-releases/${pkgver}/manifest.json.sig"
        'LICENSE.md')
source_x86_64=("claude-${pkgver}-x86_64::https://downloads.claude.ai/claude-code-releases/${pkgver}/linux-x64/claude")
source_aarch64=("claude-${pkgver}-aarch64::https://downloads.claude.ai/claude-code-releases/${pkgver}/linux-arm64/claude")
sha256sums=('5ac2b2e6a69266050c58f56d1a47058fa899ad30f1ebd8748ffd89abd91a33c0' 'SKIP' '728158fd1037143fad6907e8fa34804177e598b7326519503fe83cafdef849e6')
sha256sums_x86_64=('4c00839cf46beb2b38ec310105f2d538f7f9321fe46c636299b74bcab94626b1')
sha256sums_aarch64=('3e5afea76cf6ed53f42076d8b175c4ee3d9ab34cd9b90452da115d21ad0d5d31')
# Anthropic Claude Code Release Signing <security@anthropic.com>
validpgpkeys=('31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE')

prepare() {
  # Anthropic signs each release's manifest rather than its binaries, so check
  # the binary against the checksum the signed manifest lists for it.
  local platform=linux-x64
  [[ $CARCH == "aarch64" ]] && platform=linux-arm64
  local expected
  expected=$(jq -er --arg platform "$platform" '.platforms[$platform].checksum' "claude-${pkgver}-manifest.json")
  echo "${expected}  claude-${pkgver}-${CARCH}" | sha256sum -c -
}

package() {
  install -Dm755 "claude-${pkgver}-${CARCH}" "${pkgdir}/usr/lib/claude-code/claude"
  install -Dm644 LICENSE.md "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.md"

  # pacman updates this install, so turn off every update path Claude Code has
  # (DISABLE_UPDATES also refuses `claude update` and `claude install`), and skip
  # the health check that looks for the native installer's ~/.local/bin/claude.
  install -dm755 "${pkgdir}/usr/bin"
  cat >"${pkgdir}/usr/bin/claude" <<'WRAPPER'
#!/bin/bash
export DISABLE_UPDATES=1
export DISABLE_INSTALLATION_CHECKS=1
exec /usr/lib/claude-code/claude "$@"
WRAPPER
  chmod 755 "${pkgdir}/usr/bin/claude"
}
