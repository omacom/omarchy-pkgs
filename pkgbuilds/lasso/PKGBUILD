# Lasso-select image regions and let your AI agent edit them.
# Maintainer: syndicalt <https://github.com/syndicalt>

pkgname=lasso
pkgver=0.1.0
pkgrel=1
pkgdesc='Lasso-select image regions and let your AI agent edit them'
arch=('x86_64')
url='https://github.com/syndicalt/lasso'
license=('MIT')
# glibc/libgcc are the only DT_NEEDED entries; the GUI stack below is
# dlopened by winit/glutin at runtime (Wayland path + X11 fallback).
depends=(
  'gcc-libs'
  'glibc'
  'libglvnd'
  'libx11'
  'libxcb'
  'libxcursor'
  'libxi'
  'libxkbcommon'
  'libxrandr'
  'wayland'
)
makedepends=('cargo')
options=('!debug') # release profile strips and uses fat LTO
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('2c42fa3eb22226021e27d145da510a694072b41b97852905b5ade52e2d9e893c')

prepare() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/lasso "$pkgdir/usr/bin/lasso"
  install -Dm644 assets/lasso.desktop "$pkgdir/usr/share/applications/lasso.desktop"
  install -Dm644 assets/icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/lasso.png"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # The agent integration is opt-in per user, never a root action:
  #   lasso register   (writes ~/.omp/agent/mcp.json)
}
