# Maintainer: Lucas Goossen <lucas.goossen@hey.com>
# J313 panel brightness. The unit is installed and not enabled.

pkgname=ct720-display-light
pkgver=1.0.0
pkgrel=1
pkgdesc='Panel brightness driven by the J313 CT720 ambient light sensor'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/omacom/omarchy-pkgs'
license=('MIT')
depends=('glibc')
makedepends=('gcc' 'make')
options=('!debug')
source=(
  'ct720-display-light.c'
  'Makefile'
  'ct720-display-light.service'
)
sha256sums=('6341a5ec9adda35b087780b657c98bf777d662237d46ffd9b8ea488688ab6aac'
            '773c60a8924c4581ea5a69424ea53dd8dc0bfce6e32b7a7e34ad07a94ee604da'
            '672c98f4165b637eecd55d6a4690bcc6b4ca501aa15f5d2589e60326dc693323')

build() {
  make CFLAGS="${CFLAGS} -std=c11 -D_GNU_SOURCE -Wall -Wextra -Werror" \
       LDFLAGS="${LDFLAGS} -lm"
}

check() {
  # Must not open the sensor, the panel, or input devices.
  ./ct720-display-light --self-test
}

package() {
  install -Dm755 ct720-display-light "$pkgdir/usr/bin/ct720-display-light"
  install -Dm644 ct720-display-light.service \
    "$pkgdir/usr/lib/systemd/system/ct720-display-light.service"
}
