[Unit]
Description=Panel brightness from the J313 CT720 ambient light sensor
After=systemd-backlight@backlight:apple-panel-bl.service
# Not enabled by the package. Absent backlight skips the unit.
ConditionPathExists=/sys/class/backlight/apple-panel-bl/brightness

[Service]
# systemd only honors ExecCondition in [Service].
ExecCondition=/usr/bin/ct720-display-light --check-sensor
StateDirectory=ct720-display-light
Type=simple
ExecStart=/usr/bin/ct720-display-light
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
