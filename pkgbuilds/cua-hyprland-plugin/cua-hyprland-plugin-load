#!/bin/bash

# Loads the Cua Hyprland plugin into this Hyprland session, and only where the session and the installed packages are the builds the module was made for.

kit=/usr/share/cua-hyprland-plugin
module=/usr/lib/cua/hyprland/cua-hyprland-plugin.so
# The compositor and the interpreter this package's dependencies install, whatever PATH offers ahead of them.
hyprland=/usr/bin/Hyprland
python=/usr/bin/python3

refuse() {
  echo "$1" >&2
  exit 1
}

loaded() {
  hyprctl plugin list 2>/dev/null | grep -q '^Plugin cua-hyprland-plugin '
}

no_session="No Hyprland session here. Run this in a terminal inside the session."
lock="${XDG_RUNTIME_DIR-}/hypr/${HYPRLAND_INSTANCE_SIGNATURE-}/hyprland.lock"
[[ -r $lock ]] && read -r pid <"$lock" && [[ $pid =~ ^[0-9]+$ ]] || refuse "$no_session"

if loaded; then
  echo "The Cua Hyprland plugin is already loaded."
  exit 0
fi

# Cua's check of the installed files: Hyprland and the ABI packages at exactly the versions the module was built against.
# What differs comes out on stderr; a pass is not the whole answer yet, so it is not printed.
"$python" -I "$kit/profile_verify.py" --kit "$kit" --kit-sha256 "$(sha256sum "$kit/KIT-PROVENANCE.json" | cut -d' ' -f1)" --consumer "$module" >/dev/null ||
  refuse "The plugin does not match the Hyprland and libraries installed. An update will bring the one that does."

# That check cannot see this session, which keeps running what it started with when an update replaces it.
maps=$(cat "/proc/$pid/maps" 2>/dev/null)
[[ -n $maps ]] || refuse "$no_session"
# Code from a file is mapped private. Shared anonymous memory and an anonymous memfd read as deleted from the moment they are made.
replaced=$(awk '$2 ~ /^r.xp$/ && $NF == "(deleted)" && $6 !~ /^\/memfd:/ { sub(/^([^ ]+ +){5}/, ""); sub(/ \(deleted\)$/, ""); print; found = 1; exit } END { if (!found) print "none" }' <<<"$maps")
[[ -n $replaced ]] || refuse "Could not scan this session for replaced files."
[[ $replaced == "none" ]] ||
  refuse "An update replaced $replaced under this session. Log out and back in, then run this again."
# A compositor started from another path is not the one that check measured, and has no replaced file to show for it.
[[ /proc/$pid/exe -ef $hyprland ]] || refuse "This session is not running the installed $hyprland."

# hyprctl exits 0 whatever Hyprland answers, so the plugin list says whether it loaded.
response=$(hyprctl plugin load "$module" 2>&1)
loaded || refuse "Hyprland did not load the plugin: $response"

echo "Loaded the Cua Hyprland plugin. hyprctl -j cua:status shows whether input is on."
