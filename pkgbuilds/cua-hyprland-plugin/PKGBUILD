# Cua's published profile kit, scoped to its ABI packages at Omarchy's measured versions.
# Normal reruns need a fresh build directory; makepkg -e reuses verified extracted trees.
# Profile kit: original source bytes and separately committed packaging tooling.
# shellcheck shell=bash disable=SC2034,SC2154
pkgname=cua-hyprland-plugin
pkgver=0.47.8
pkgrel=3
pkgdesc='Cua input candidate for reviewed profile omarchy-edge-20261111-abi'
arch=('x86_64')
url='https://github.com/trycua/cua'
license=('MIT')
# hyprland stays first and unversioned: the builder resolves Omarchy's own build, and package() pins it.
depends=('hyprland' 'aquamarine=0.16.0-1' 'glibc=2.44+r50+g1848099f063e-1' 'hyprcursor=0.1.14-1' 'hyprgraphics=0.6.0-1' 'hyprlang=0.6.8-5' 'hyprutils=0.14.3-1' 'libgcc=16.2.1+r23+gd564253eb6c8-1' 'libstdc++=16.2.1+r23+gd564253eb6c8-1' 'libxkbcommon=1.13.2-1' 'wayland=1.26.0-1' 'python>=3.11' 'binutils')
makedepends=('cmake>=3.30' 'ninja' 'pkgconf' 'gcc')
options=('!strip' '!debug' '!lto')
_stem='cua-hyprland-plugin-0.47.8-87558bfd064787c7839351c55d667dc8244044a4'
_archive_sha256='491a2a123f4a0dd342305da63e21c614e6c50d88efbb44a11d8a0a6f68ed30d3'
_verifier_sha256='34c152ff4e4fe18a92ddb009469b779a330ee9e72cbd7de9b2c2fb1578a1d499'
_cxx="${CUA_RELEASE_CXX:-/usr/bin/g++}"
_download_name='cua-hyprland-plugin-0.47.8-87558bfd064787c7839351c55d667dc8244044a4-profile-omarchy-edge-20261111-kit-1.4.0-efed8196b217542a70d0cc7dec2bdc4562cb79ad3d9fd8456d1dd4df74ff7284-9e7256bfbb5ded8dc800484e43846b2df938af6d.tar.gz'
_download_sha256='b80efa436c8132af0db14b017fbb6d2fc1d64ce22a9488608e9f9fe01acb6835'
source=("https://github.com/trycua/cua/releases/download/cua-hyprland-kit-v1.4.0-omarchy-edge-20261111/${_download_name}")
noextract=("$_download_name")
sha256sums=("$_download_sha256")

# Local inputs are also checked explicitly when makepkg integrity is skipped.
declare -gA _local_sha256=(
  ['PROFILE.json']='16af74f1c73c50e83118e21a8feec5a43c1f8ef8239db13cdbeb0f979294806e'
  ['kit.py']='ab5b0cb9d55b7e9d1a266f107e3b086e33c092279daa9a2379d57a2614e18754'
  ['kit_test.py']='a7f9485a9b3b7d1cfe21719e6aaf27f4731d362b03879ac459522688c73d2d3f'
)
source+=('PROFILE.json' 'kit.py' 'kit_test.py')
sha256sums+=('16af74f1c73c50e83118e21a8feec5a43c1f8ef8239db13cdbeb0f979294806e' 'ab5b0cb9d55b7e9d1a266f107e3b086e33c092279daa9a2379d57a2614e18754' 'a7f9485a9b3b7d1cfe21719e6aaf27f4731d362b03879ac459522688c73d2d3f')

_inputs() {
  local name
  printf '%s  %s\n' "$_download_sha256" "$SRCDEST/$_download_name" | sha256sum -c - || return 1
  for name in "${!_local_sha256[@]}"; do
    printf '%s  %s\n' "${_local_sha256[$name]}" "$SRCDEST/$name" | sha256sum -c - || return 1
  done
}

_kit() {
  _inputs || return 1
  python3 -I -B "$SRCDEST/kit.py" "$1" --archive "$SRCDEST/$_download_name" --archive-sha256 "$_download_sha256" \
    --profile "$SRCDEST/PROFILE.json" --srcdir "$srcdir" --package-release "$pkgrel"
}

_verify() {
  # Derives the kit again for the Hyprland installed now and requires the extracted one to match it byte for byte.
  _kit check || return 1
  # Explicit checks still apply to --skipinteg, --noextract and --repackage.
  printf '%s  %s\n' "$_archive_sha256" "$srcdir/cua-profile-kit/${_stem}.tar.gz" | sha256sum -c - || return 1
  printf '%s  %s\n' "$_verifier_sha256" "$srcdir/cua-profile-kit/profile_verify.py" | sha256sum -c - || return 1
  local kit_sha256
  kit_sha256=$(sha256sum "$srcdir/cua-profile-kit/KIT-PROVENANCE.json") || return 1
  python3 "$srcdir/cua-profile-kit/profile_verify.py" --kit "$srcdir/cua-profile-kit" --kit-sha256 "${kit_sha256%% *}" \
    --archive "$srcdir/cua-profile-kit/${_stem}.tar.gz" --source "$srcdir/$_stem" --cxx "$_cxx" "$@"
}

prepare() {
  _kit extract || return 1
  _verify || return 1
}

build() {
  _verify || return 1
  cmake -S "$srcdir/$_stem" -B "$srcdir/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER="$_cxx" \
    -DPKG_CONFIG_EXECUTABLE=/usr/bin/pkgconf -DPKG_CONFIG_ARGN= \
    -DPKG_CONFIG_USE_CMAKE_PREFIX_PATH=OFF -DCMAKE_PREFIX_PATH= \
    -DBUILD_TESTING=ON -DCUA_HYPRLAND_BUILD_PLUGIN=ON \
    -DCUA_HYPRLAND_EXPECTED_VERSION=0.57.2 \
    -DCUA_HYPRLAND_INPUT=ON -DCUA_HYPRLAND_TEST_INPUT=OFF \
    -DCUA_HYPRLAND_INPUT_TRACE=OFF -DCUA_HYPRLAND_TEST_OPERATOR_KEY= || return 1
  cmake --build "$srcdir/build"
}

check() {
  _verify || return 1
  python3 -B "$SRCDEST/kit_test.py" "$SRCDEST/$_download_name" "$_download_sha256" \
    "$SRCDEST/PROFILE.json" || return 1
  (
    unset LD_PRELOAD FAKEROOTKEY FAKED_MODE
    ctest --test-dir "$srcdir/build" --output-on-failure --no-tests=error
  )
}

package() {
  check || return 1
  _verify --build "$srcdir/build" --output "$srcdir/BUILD-PROVENANCE.json" || return 1
  # The module is compiled against one Hyprland build's headers, so it installs beside that build only.
  # A newer Hyprland waits for this package's rebuild, which sync-rebuilds opens.
  local built_against
  built_against=$(pacman -Q hyprland) || return 1
  depends=("hyprland=${built_against#* }" "${depends[@]:1}")
  install -Dm755 "$srcdir/build/cua-hyprland-plugin.so" \
    "$pkgdir/usr/lib/cua/hyprland/cua-hyprland-plugin.so" || return 1
  install -Dm644 "$srcdir/$_stem/LICENSE.md" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE" || return 1
  install -Dm644 "$srcdir/$_stem/SOURCE-PROVENANCE.json" \
    "$pkgdir/usr/share/$pkgname/SOURCE-PROVENANCE.json" || return 1
  local name
  install -Dm644 "$srcdir/BUILD-PROVENANCE.json" "$pkgdir/usr/share/$pkgname/BUILD-PROVENANCE.json" || return 1
  for name in KIT-PROVENANCE.json PROFILE.json profile_verify.py; do
    install -Dm644 "$srcdir/cua-profile-kit/$name" "$pkgdir/usr/share/$pkgname/$name" || return 1
  done
}
