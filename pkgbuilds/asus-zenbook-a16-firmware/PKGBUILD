# Maintainer: David Heinemeier Hansson <david@hey.com>
#
# Audio and compute DSP firmware and Wi-Fi board data for the ASUS Zenbook A16
# UX3607OA (Snapdragon X2 Elite). The DSPs only run images signed for this
# board, so linux-firmware cannot carry them, and without the audio DSP there
# is no battery reporting, charging status or sound. linux-firmware's QCC2072
# board-2.bin has no entry for this laptop's Wi-Fi, so ath12k finds no board
# data and the radio never comes up. ASUS ships all of them in the Qualcomm
# board support package for the UX3607OA, which this recipe unpacks without
# running; they are installed unmodified, under the names the device tree and
# ath12k request.
#
# Not in omarchy-platform-qualcomm: board.bin is ath12k's fallback for any
# QCC2072 without a board-2.bin entry, so Omarchy installs this package only on
# the UX3607OA.

pkgname=asus-zenbook-a16-firmware
pkgver=1.312.4500.0
pkgrel=1
pkgdesc='DSP firmware and Wi-Fi board data for the ASUS Zenbook A16 (UX3607OA)'
arch=('aarch64')
url='https://www.asus.com/laptops/for-home/zenbook/asus-zenbook-a16-ux3607/helpdesk_download?model2Name=UX3607OA'
license=('LicenseRef-proprietary')
makedepends=('7zip')
options=('!strip' '!debug')
_exe=SOCPackage_forWebSite_Qualcomm_Z_V${pkgver}_50616.exe
source=("$_exe::https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/50616/$_exe?model=UX3607OA"
        'asus,zenbook-a16-ux3607oa.list')
sha256sums=('e8f2389ac5d4dfd30a1a8481ec3c1e282f24baea2898414351d0b6eb1fa8a0b3'
            'ca2d0abccee256952a6a57831f03e4462ca28c2efe8e5d293adcbcd1619f40f5')

prepare() {
  # A self-extracting executable with the package appended as a 7z archive.
  # Cut the archive out and unpack only what the recipe installs.
  local offset
  offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$_exe" | head -1 | cut -d: -f1)
  [[ -n $offset ]] || { echo "no 7z archive in $_exe" >&2; return 1; }
  tail -c +$((offset + 1)) "$_exe" > bsp.7z
  rm -rf bsp
  7z x -y -obsp bsp.7z >/dev/null \
    QualcommBSP/Subsystem/qcsubsys_ext_adsp8480/qcadsp8480.mbn \
    QualcommBSP/Subsystem/qcsubsys_ext_adsp8480/adsp_dtbs.elf \
    QualcommBSP/NPU/qcnspmcdm8480/qccdsp8480.mbn \
    QualcommBSP/NPU/qcnspmcdm8480/cdsp_dtbs.elf \
    QualcommBSP/WIFI_BT/qcwlancol8480/bdwlan_qcc2072_1p0_ncm820A.elf
}

package() {
  local bsp=bsp/QualcommBSP
  local dsp="$pkgdir/usr/lib/firmware/qcom/glymur/ASUSTeK/UX3607OA"

  install -Dm644 -t "$dsp" \
    "$bsp/Subsystem/qcsubsys_ext_adsp8480/qcadsp8480.mbn" \
    "$bsp/Subsystem/qcsubsys_ext_adsp8480/adsp_dtbs.elf" \
    "$bsp/NPU/qcnspmcdm8480/qccdsp8480.mbn" \
    "$bsp/NPU/qcnspmcdm8480/cdsp_dtbs.elf"

  # Windows maps this laptop's radio (17cb:1112, subsystem 105b:e14f) to this
  # file; ath12k loads board.bin once board-2.bin has no entry for it.
  install -Dm644 "$bsp/WIFI_BT/qcwlancol8480/bdwlan_qcc2072_1p0_ncm820A.elf" \
    "$pkgdir/usr/lib/firmware/ath12k/QCC2072/hw1.0/board.bin"

  # The DSP images come from this package, and the board's own firmware starts
  # SoCCP before Linux, so qcom-firmware-extract has nothing to fetch from Windows.
  install -Dm644 -t "$pkgdir/usr/share/qcom-firmware-extract/provided.d" \
    asus,zenbook-a16-ux3607oa.list
}
