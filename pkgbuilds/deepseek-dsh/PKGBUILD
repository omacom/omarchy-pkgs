# Maintainer: The Omarchy Authors
# DeepSeek publishes dsh only to npm, as a launcher package plus ~600
# dependencies. Every native addon among them (node-pty, koffi, sharp,
# sherpa-onnx and DeepSeek's own) uses N-API with prebuilt binaries, so the
# install does not depend on the Node version and can follow npm on the fast
# ring. npm's `latest` tag is a release candidate today; pkgver drops the
# hyphen so 0.2.2rc.5 sorts below 0.2.2 and above 0.2.2alpha.3.
pkgname=deepseek-dsh
pkgver=0.2.2rc.5
_npmver=0.2.2-rc.5
pkgrel=1
pkgdesc="DeepSeek Harness (dsh), DeepSeek's terminal coding agent"
arch=('x86_64' 'aarch64')
url="https://github.com/deepseek-ai/deepseek-harness"
license=('MIT')
depends=('nodejs' 'glibc' 'gcc-libs')
makedepends=('npm')
options=('!strip' '!debug')
source=("dsh-${_npmver}.tgz::https://registry.npmjs.org/@deepseek-ai/dsh/-/dsh-${_npmver}.tgz")
sha256sums=('67da5a3c458f46cd278e0eec6ad0e3a44e99fd13087c6f11a1b362268900a52c')
noextract=("dsh-${_npmver}.tgz")

package() {
  local _arch=x64
  if [[ $CARCH == "aarch64" ]]; then
    _arch=arm64
  fi

  # The dependencies' install scripts only check for prebuilt binaries that
  # are already there. --prefer-dedupe keeps npm from nesting a copy of zod
  # in each of DeepSeek's 60-odd packages that pins an older patch release.
  npm install --global --ignore-scripts --omit=dev --prefer-dedupe --no-audit --no-fund \
    --cache "${srcdir}/npm-cache" --prefix "${pkgdir}/usr" "${srcdir}/dsh-${_npmver}.tgz"

  local _mod="${pkgdir}/usr/lib/node_modules/@deepseek-ai/dsh"

  # Prebuilt addons for other systems.
  find "$_mod" -type d -regex '.*/prebuilds/[^/]+' ! -name "linux-${_arch}" -prune -exec rm -r {} +
  find "$_mod" -type d -name musl -path '*/node-addon-system-linux-*' -prune -exec rm -r {} +
  find "$_mod" -type d -name "musl_${_arch}" -path '*/koffi-linux-*' -prune -exec rm -r {} +

  chown -R root:root "${pkgdir}/usr"
  install -Dm644 "${_mod}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
