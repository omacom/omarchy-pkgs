# Maintainer: Dennis Rye <dryerr@gmail.com>

pkgname=omadev
pkgver=0.2.0
pkgrel=1
pkgdesc='Run Omarchy sessions as windows inside the current one, for plugin development and agents (slots 1-9)'
arch=('any')
url='https://github.com/llstrk/omadev'
license=('MIT')
install='omadev.install'
depends=(
  'omarchy'
  'hyprland'
  'quickshell'
  'python'
  'dbus'
  'grim'
)
optdepends=('wtype: type into a session from the command line')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('34067759e5bb6da34cfe30bb2c83c2709c5a2e995680131960f27899524c3c5a')

package() {
  cd "$pkgname-$pkgver"
  # The launcher finds libexec, plugin and skill next to its own real path.
  install -Dm755 bin/omadev "$pkgdir/usr/lib/omadev/bin/omadev"
  cp -r libexec plugin skill "$pkgdir/usr/lib/omadev/"
  install -d "$pkgdir/usr/bin"
  ln -s ../lib/omadev/bin/omadev "$pkgdir/usr/bin/omadev"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
