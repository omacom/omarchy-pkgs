# Maintainer: Dennis Rye <dryerr@gmail.com>

pkgname=omadev
pkgver=0.3.0
pkgrel=1
pkgdesc='Run Omarchy sessions as windows inside the current one, for plugin development and agents (slots 1-9)'
arch=('x86_64' 'aarch64')
url='https://github.com/llstrk/omadev'
license=('MIT')
install='omadev.install'
depends=(
  'omarchy'
  'hyprland'
  'quickshell'
  'python'
  'dbus'
  'grim'
  'wayland>=1.26'
)
makedepends=('gcc' 'pkgconf')
optdepends=('wtype: type into a session from the command line')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('3303f0baf004dd1d0f6e549318acbfeb6156327129fb3cba55de65532dd3a8e8')

build() {
  cd "$pkgname-$pkgver"
  ./bin/build-input-gate
}

package() {
  cd "$pkgname-$pkgver"
  # Backend only. The widget is owned by omarchy plugin add/update.
  install -Dm755 bin/omadev "$pkgdir/usr/lib/omadev/bin/omadev"
  install -Dm755 bin/build-input-gate "$pkgdir/usr/lib/omadev/bin/build-input-gate"
  cp -r libexec skill "$pkgdir/usr/lib/omadev/"
  install -d "$pkgdir/usr/bin"
  ln -s ../lib/omadev/bin/omadev "$pkgdir/usr/bin/omadev"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  cp -r docs "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
