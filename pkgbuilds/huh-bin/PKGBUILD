# Maintainer: Radu Boarescu <https://github.com/rboarescu/huh>

pkgname=huh-bin
pkgver=0.2.1
pkgrel=1
pkgdesc="Offline deterministic terminal companion, command explainer, error doctor & lab"
arch=('x86_64' 'aarch64')
url="https://github.com/rboarescu/huh"
license=('MIT')
provides=('huh')
conflicts=('huh')
options=('!debug')
optdepends=(
  'tmux: side-by-side companion pane outside tiling desktops'
  'fzf: interactive huh find catalog and command browser'
)
source_x86_64=("${pkgname}-${pkgver}-x86_64.tar.gz::${url}/releases/download/v${pkgver}/huh-v${pkgver}-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64.tar.gz::${url}/releases/download/v${pkgver}/huh-v${pkgver}-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('b4374b6547ab984732e58aa120aeeb17e2a851c04f8bdda3b76ca40d729b99bc')
sha256sums_aarch64=('35020b09ab1d208dfdce728e3321dbefad41a74e4ad6eeafc0101d6bd927e775')

package() {
  local _dist="${srcdir}/huh-v${pkgver}-${CARCH}-unknown-linux-musl"
  install -Dm755 "${_dist}/huh" "${pkgdir}/usr/bin/huh"
  install -Dm644 "${_dist}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${_dist}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
