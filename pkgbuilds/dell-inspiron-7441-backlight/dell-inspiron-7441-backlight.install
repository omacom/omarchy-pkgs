_apply_command="/usr/bin/dell-inspiron-7441-backlight-apply"

post_install() {
  "$_apply_command" || return
  printf ':: Reboot to enable brightness control on the Dell Inspiron 14 Plus 7441.\n'
}

post_upgrade() {
  "$_apply_command" || return
  printf ':: Reboot to apply the Dell Inspiron 14 Plus 7441 backlight update.\n'
}

# The helper and overlay are gone by post_remove, so restore while they exist.
pre_remove() {
  "$_apply_command" --restore || return
  printf ':: Reboot to finish removing the Dell Inspiron 14 Plus 7441 backlight overlay.\n'
}
