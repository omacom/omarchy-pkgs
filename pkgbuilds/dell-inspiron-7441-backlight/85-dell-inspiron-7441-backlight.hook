# Runs before 90-mkinitcpio-install so the rebuilt UKI embeds the patched DTB.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = boot/dtbs/qcom/x1e80100-dell-inspiron-14-plus-7441.dtb

[Action]
Description = Enabling the Dell Inspiron 14 Plus 7441 PWM backlight...
When = PostTransaction
Exec = /usr/bin/dell-inspiron-7441-backlight-apply --no-rebuild
