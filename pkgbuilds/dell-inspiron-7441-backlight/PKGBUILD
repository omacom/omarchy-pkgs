# Maintainer: Rafael Guariento <rafael.guariento@ufms.br>

pkgname=dell-inspiron-7441-backlight
pkgver=1.0.0
pkgrel=1
pkgdesc="Temporary PWM backlight enablement for the Snapdragon Dell Inspiron 14 Plus 7441"
arch=('aarch64')
url="https://github.com/omacom/omarchy-pkgs"
license=('MIT')
depends=('dtc' 'mkinitcpio')
optdepends=('limine-mkinitcpio-hook: rebuild Limine Unified Kernel Images')
install=dell-inspiron-7441-backlight.install
options=('!debug')
source=(
  '85-dell-inspiron-7441-backlight.hook'
  'dell-inspiron-7441-backlight-apply'
  'dell-inspiron-7441-backlight.dtso'
  'dell-inspiron-7441-backlight.install'
  'LICENSE'
  'README.md'
)
sha256sums=('5ebd6148eb1d006f984e3e9e9efbda33c8d94236201dee05a55ac927c13a033f'
            '6d870276c7bdd98dfcc67a8d9218eff882d1c8648e0e875e43d9d02983cf6830'
            'ffb83e0070d60385eb4e80dacfa9dbadb96733e8d84777d3fe363faa8f2f81f9'
            '3d59f81b8c81e5ed555a27fdfba60ae853f34a59142cc83aa41cea188be061c6'
            '8266a83dd2abc306acb810c4f93cf3ef5b4a47f78dcbd29e3ebb9fc1690ab506'
            '6b1a15ad8d193d4ccb3a78ec8b56bb15609429c6d00c66aed8b1527aafd3a533')

build() {
  dtc -@ -I dts -O dtb \
    -o dell-inspiron-7441-backlight.dtbo \
    dell-inspiron-7441-backlight.dtso
}

package() {
  install -Dm755 dell-inspiron-7441-backlight-apply \
    "${pkgdir}/usr/bin/dell-inspiron-7441-backlight-apply"
  install -Dm644 dell-inspiron-7441-backlight.dtbo \
    "${pkgdir}/usr/lib/dell-inspiron-7441-backlight/dell-inspiron-7441-backlight.dtbo"
  install -Dm644 85-dell-inspiron-7441-backlight.hook \
    "${pkgdir}/usr/share/libalpm/hooks/85-dell-inspiron-7441-backlight.hook"
  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md \
    "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
