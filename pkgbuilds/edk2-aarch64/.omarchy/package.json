{
  "source": "local",
  "upstream": {
    "watch": {
      "regex": "https://archive.archlinux.org/packages/e/edk2-aarch64/",
      "pattern": "edk2-aarch64-(?P<version>[0-9]+)-(?P<revision>[0-9]+)-any\\.pkg\\.tar\\.zst\"",
      "variables": {
        "_archrel": "{revision}"
      },
      "revision": "{revision}",
      "revision_variable": "_archrel"
    }
  }
}
