# Arch's edk2-aarch64, unchanged, for Arch Linux ARM, which ships QEMU but
# no aarch64 UEFI firmware to boot a virtual machine with. The package holds
# no machine code for the host, so Arch's own signed build is repackaged
# here rather than rebuilt. x86_64 takes it straight from Arch's extra.

pkgname=edk2-aarch64
pkgver=202608
pkgrel=1
_archrel=1
pkgdesc="Firmware for Virtual Machines (aarch64)"
arch=('aarch64')
url="https://github.com/tianocore/tianocore.github.io/wiki/ArmVirtPkg"
license=('Apache-2.0' 'BSD-2-Clause-Patent' 'MIT')
_archpkg="$pkgname-$pkgver-$_archrel-any.pkg.tar.zst"
source=("https://archive.archlinux.org/packages/e/$pkgname/$_archpkg"{,.sig})
noextract=("$_archpkg")
sha256sums=('07651fafa99d4569ce59a1c1653eb83a4bb02112abeb1656e1354c0fd5b6aa69'
            'SKIP')
validpgpkeys=('991F6E3F0765CF6295888586139B09DA5BF0D338')  # David Runge <dvzrv@archlinux.org>

package() {
  bsdtar --no-same-owner -xf "$srcdir/$_archpkg" -C "$pkgdir" usr
}
