# Maintainer: Ryan Hughes <ryan@omarchy.org>
#
# The boot stack of an x86 Omarchy install that boots systemd-boot, installed
# by omarchy-boot-switch at the end of a switch. It replaces omarchy-boot and
# the Limine packages, and owns the pacman hooks that override mkinitcpio's,
# so every initramfs becomes an Omarchy boot image (omarchy-boot-rebuild,
# omarchy-boot-sync), plus the snapper plugin that gives each snapshot its
# boot entry. The commands themselves ship with omarchy.
pkgname='omarchy-boot-systemd'
_tag='v4.5.0'
_commit='a948d8a6871f446b335258c827648ac5f4e9428b'
pkgver=4.5.0
pkgrel=2
pkgdesc='Omarchy boot stack: systemd-boot with signed boot images and snapshot entries'
arch=('x86_64' 'aarch64')
url='https://omarchy.org'
license=('MIT')
depends=(
  'omarchy'
  'systemd'
  'systemd-ukify'
  'efibootmgr'
  'snapper'
)
provides=('omarchy-boot')
conflicts=('omarchy-boot' 'limine-mkinitcpio-hook' 'limine-snapper-sync')
makedepends=('git')

# Source: the omarchy release commit, released in lockstep with omarchy and
# omarchy-settings (bin/omarchy-pkgs: same _tag, _commit, pkgver, pkgrel and
# sha256sums); OMARCHY_SRC=/path/to/checkout builds from a local tree.
if [[ -n "${OMARCHY_SRC:-}" ]]; then
  source=()
  sha256sums=()
else
  source=("omarchy::git+https://github.com/omacom/omarchy.git#commit=${_commit}")
  sha256sums=('bf3220fcc7b9d883a86f1c59efd79ce675fe137cdbb1324e9785c3cc45d01de7')
fi

prepare() {
  if [[ -n "${OMARCHY_SRC:-}" ]]; then
    rm -rf "$srcdir/omarchy"
    mkdir -p "$srcdir/omarchy"
    cp -a "${OMARCHY_SRC}/." "$srcdir/omarchy/"
  fi
}

package() {
  cd "$srcdir/omarchy"
  install -Dm644 default/boot/pacman/90-mkinitcpio-install.hook "$pkgdir/etc/pacman.d/hooks/90-mkinitcpio-install.hook"
  install -Dm644 default/boot/pacman/60-mkinitcpio-remove.hook "$pkgdir/etc/pacman.d/hooks/60-mkinitcpio-remove.hook"
  install -Dm755 default/boot/snapper/20-omarchy-boot "$pkgdir/usr/lib/snapper/plugins/20-omarchy-boot"
}
