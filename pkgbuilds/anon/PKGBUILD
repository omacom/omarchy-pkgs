# Maintainer: yamz8 <https://github.com/yamz8>

pkgname=anon
pkgver=0.1.0
pkgrel=1
pkgdesc='Remove protected health information from DICOM files before they are shared'
arch=('x86_64' 'aarch64')
url='https://github.com/yamz8/anon'
license=('MIT')
install='anon.install'
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
  'xdg-desktop-portal'
)
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('3232de3a5a4714d53aea7d7e568dceb63e00ce8641f58286e99d4f8a49de0d13')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/test
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/anon "$pkgdir/usr/bin/anon"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/anon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/anon.svg"
  install -Dm644 pkgbuild/anon.desktop "$pkgdir/usr/share/applications/anon.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
