pkgname=maplemono-nf
pkgver=7.9
pkgrel=1
pkgdesc="Maple Mono monospace font with Nerd Font icons (hinted)"
arch=('any')
url="https://github.com/subframe7536/maple-font"
license=('OFL-1.1')
provides=('ttf-font' 'ttf-font-nerd')
source=("MapleMono-NF-${pkgver}.zip::${url}/releases/download/v${pkgver}/MapleMono-NF.zip")
sha256sums=('59098b87c895d871635d37680e88000ae2b2b25b55428195b228ec589e35fb89')

package() {
  install -Dm644 -t "$pkgdir/usr/share/fonts/TTF" MapleMono-NF-*.ttf
  install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
}
