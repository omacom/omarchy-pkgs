pkgname=p16-critical-battery-policy
pkgver=1.0.0
pkgrel=2
pkgdesc='Power off at critical battery level instead of suspending'
arch=('any')
url='https://github.com/johannhartmann/asus-proart-p16-rtx-spark-linux'
license=('MIT')
depends=('python' 'systemd' 'upower')
backup=('etc/UPower/UPower.conf.d/50-p16-critical.conf')
source=(
    '50-p16-critical.conf'
    'verify-critical-action.py'
    'test_verify_critical_action.py'
    'README.package.md'
    'LICENSE'
)
sha256sums=('dfc02d0f211cdf595fa6762f2636447e2fb52d0aea448c62383ac84f8fe10cbc'
            '5ba8e232dc83f33f4366721c7008ed6a13f41c7ca969743bdad89243562a3352'
            '38f34ea09b9c0e02b3bae9df8c87c2b544af44da700ae7328e6abe3b32bd3866'
            '6a3c8f1e55798a6cee9a230f5e40c51513a454784293acf9af10a17682d34d6a'
            '213e4f92de2bfb95c95fc90aa94a5378e92a7c3bdf1d2b22768da3fa9068b3b3')

check() {
    python -m unittest -v test_verify_critical_action
}

package() {
    install -Dm644 "$srcdir/50-p16-critical.conf" \
        "$pkgdir/etc/UPower/UPower.conf.d/50-p16-critical.conf"
    install -Dm755 "$srcdir/verify-critical-action.py" \
        "$pkgdir/usr/lib/p16-critical-battery-policy/verify-critical-action.py"
    install -Dm644 "$srcdir/README.package.md" \
        "$pkgdir/usr/share/doc/p16-critical-battery-policy/README.md"
    install -Dm644 "$srcdir/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
