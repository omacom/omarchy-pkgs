pkgname=omarchy-steam-fex
pkgver=1.0.0
pkgrel=7
pkgdesc='Steam launcher with login workarounds for Apple Silicon using muvm and FEX'
arch=('aarch64')
url='https://github.com/omacom/omarchy-pkgs/tree/master/pkgbuilds/omarchy-steam-fex'
license=('MIT')
checkdepends=('python')
source=('omarchy-launch-steam' 'LICENSE' 'test-launcher.py' '90-omarchy-steam-j314-dsp.conf')
sha256sums=('ef24d67be3a8a80a6b2629669d15a503efa8b238330e88d6c512c3beafea95d3'
            '717ba1949502290f8e47688ae2e323acd06c8ca47aec9f7596b15f678c1af4a2'
            '017081e6afcca1c4f87e46e8fa17f73bc989cbe98b5014c256f59e3e0f08ec9d'
            'fe6b8148922bab88e58fdb455052fed4d06a73ae5251c836d3fcbf9aa95d0933')

check() {
  python test-launcher.py
}

package() {
  # These are runtime-only dependencies; the Asahi stack is not needed to
  # assemble or test the scripts in a standard Arch Linux ARM builder.
  depends=('bash' 'coreutils' 'python' 'steam' 'muvm' 'FEX-Emu'
           'fex-emu-rootfs-arch' 'mesa-fex-emu-overlay-i386' 'mesa-fex-emu-overlay-x86_64')

  install -Dm755 omarchy-launch-steam "$pkgdir/usr/bin/omarchy-launch-steam"
  install -Dm644 90-omarchy-steam-j314-dsp.conf \
    "$pkgdir/usr/share/pipewire/pipewire.conf.d/90-omarchy-steam-j314-dsp.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
