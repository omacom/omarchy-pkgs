# Maintainer: David Heinemeier Hansson <david@hey.com>

pkgname=fantasi
pkgver=0.1.5
pkgrel=1
pkgdesc='Make and change images with Omarchy local image models'
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/fantasi'
license=('MIT')
install='fantasi.install'
options=('!debug')
depends=(
  'ffmpeg'
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-multimedia'
  'qt6-multimedia-ffmpeg'
  'qt6-svg'
  'qt6-wayland'
  'xdg-desktop-portal'
)
optdepends=(
  'omarchy-local-ai: runs the image models Fantasi uses'
)
makedepends=(
  'cmake'
  'gcc'
  'make'
  'qt6-shadertools'
)
checkdepends=(
  'noto-fonts'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b0207ada05fd7b7d0c971ce41a04b82b8d36a178d86200f86ec519bbdd0b7d7c')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build --prefix /usr
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
