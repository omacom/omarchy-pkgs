# Maintainer: Meir Dick <mdick85@gmail.com>
#
# Intel's IPU7 CamHAL userspace for the HP EliteBook X G2i (Panther Lake,
# OV05C10), pinned at the release set that intel/ipu7-camera-hal issue #48
# reports as working with this sensor, in a private prefix under
# /usr/lib/hp-elitebook-x-g2i-camhal. It is the "camhal" engine of
# hp-elitebook-x-g2i-camera 2.0.0; nothing else looks at it.
#
# Why a pin, and why these commits
# --------------------------------
# Newer CamHAL release sets are the broken ones on this machine. The
# regression window is issue #48's: bins tag 20260327_1 works, 20260406_1900_297
# does not, and the CJFPE50 config blobs are byte-identical across that window,
# so the fault sits in the closed ia_* libraries and/or HAL code. Separately,
# the graph settings that entered at 20260629_2 demand a 2944x1632 sensor
# readout the ov05c10 driver cannot produce (the Gen-1 black-frame/SOF-timeout
# diagnosis), while this set's graph declares the 2888x1808 mode the driver
# actually has. So:
#
#   ipu7-camera-bins  tag 20260327_1  (403c67db) - the same commit
#     intel-ipu7-camera already pins; both tags 20260327 and 20260327_1
#     point here.
#   ipu7-camera-hal   tag 20260327_1  (58e6f01f) - the HAL tagged for that
#     bins release, carrying the "2888x1808" CJFPE50 configs.
#   icamerasrc        icamerasrc_slim_api @ 94e99776 - the newest slim-api
#     commit contemporaneous with the release set, built CHROME_SLIM_CAMHAL=ON.
#
# This exact combination was built and hardware-verified on this machine
# (2026-08-28 workspace build; 720p/1080p captures, then soak). Do not bump any
# of the three without re-running that verification.
#
# Why a private prefix and not intel-ipu7-camera
# ----------------------------------------------
# intel-ipu7-camera ships a newer CamHAL into /usr for the OV08X40 machines and
# is gated to them; this machine needs a different, older pairing. A private
# prefix owns no file any other package owns: no conflicts=() is needed because
# there is no overlap - intel-ipu7-camera installs /usr/lib/libcamhal*,
# /etc/camera/ipu75xa/ and IPU firmware, none of which appear here. The
# firmware in ipu7-camera-bins is deliberately NOT packaged: the kernel side
# (intel-ipu7-drivers + linux-ptl) already runs its own IPU7 firmware and
# works, and shadowing it is root-gated churn for no measured gain.
#
# The daemon reaches this prefix with LD_LIBRARY_PATH/GST_PLUGIN_PATH/
# CAMERA_CFG_PATH; the hal_adaptor's plugin path and the icamerasrc rpath are
# baked to it at build time, so nothing here can be picked up by accident.
#
# The NR patch
# ------------
# 0001-hal-nr-strength-env-override.patch is a local experiment hook, not
# upstream material: it lets HPCAM_NR_STRENGTH override the ISP
# noise-reduction strength (the HAL's own presets sit at LEVEL3=-60,
# LEVEL4=-120, default LEVEL2=0). Hardware-verified 2026-08-30: -60 cuts
# within-frame dark-scene noise ~28%, -120 ~45%, no visible detail smearing at
# -120. The daemon exports HPCAM_NR_STRENGTH=-60 by default; with the variable
# unset the patched HAL behaves exactly as unpatched.

pkgname=hp-elitebook-x-g2i-camhal-runtime
pkgver=20260327_1
pkgrel=1
pkgdesc="Pinned Intel IPU7 CamHAL runtime for HP EliteBook X G2i (OV05C10), private prefix"
arch=('x86_64')
url="https://github.com/intel/ipu7-camera-hal"
license=(
  'Apache-2.0'          # ipu7-camera-hal
  'LGPL-2.1-only'       # icamerasrc
  'LicenseRef-Intel-ipu7-camera-bins'  # binary-only ia_* libraries
)
# From the direct DT_NEEDED of the built artifacts (ldd/objdump on the proven
# workspace build):
#   libcamhal.so.0            -> glibc, gcc-libs
#   libcamhal/plugins/ipu75xa.so -> libdrm, expat, jsoncpp (+ bundled ia_*)
#   libgsticamerasrc.so       -> gstreamer, gst-plugins-base-libs
#                                (gstvideo, gstallocators), glib2,
#                                libdrm (also libdrm_intel)
depends=(
  'gcc-libs'
  'glibc'
  'glib2'
  'gstreamer'
  'gst-plugins-base-libs'
  'expat'
  'jsoncpp'
  'libdrm'
)
makedepends=(
  'git'
  'base-devel'
  'cmake'
  'autoconf'
  'automake'
  'libtool'
  'pkgconf'
)
# The ia_* libraries are binary-only and the icamerasrc plugin carries a
# libtool rpath; stripping proprietary blobs is asking for trouble for zero
# payoff on a machine-local package.
options=('!strip' '!debug')

_prefix=/usr/lib/hp-elitebook-x-g2i-camhal

_ipu7_camera_bins_commit="403c67db6b279dd02752f11db6a34552f31a3ac5"  # tag 20260327_1
_ipu7_camera_hal_commit="58e6f01f2eae4811f28703e48b7d1ecb0e41c0f0"   # tag 20260327_1
_icamerasrc_commit="94e99776c08dfc06a021d77dcfc52ec11216a8c0"        # icamerasrc_slim_api

source=(
  "ipu7-camera-bins::git+https://github.com/intel/ipu7-camera-bins.git#commit=${_ipu7_camera_bins_commit}"
  "ipu7-camera-hal::git+https://github.com/intel/ipu7-camera-hal.git#commit=${_ipu7_camera_hal_commit}"
  "icamerasrc::git+https://github.com/intel/icamerasrc.git#commit=${_icamerasrc_commit}"
  '0001-hal-nr-strength-env-override.patch'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

prepare() {
  cd "${srcdir}/ipu7-camera-hal"
  patch -Np1 -i "${srcdir}/0001-hal-nr-strength-env-override.patch"

  # Stage the binary-only ia_* libs and headers where the HAL and icamerasrc
  # builds can see them, same as intel-ipu7-camera does.
  local staging="${srcdir}/staging"
  rm -rf "${staging}"
  mkdir -p "${staging}/usr/lib" "${staging}/usr/include" "${staging}/usr/lib/pkgconfig"

  cd "${srcdir}/ipu7-camera-bins"
  cp -P lib/lib* "${staging}/usr/lib/"
  cp -r include/* "${staging}/usr/include/"
  cp -r lib/pkgconfig/* "${staging}/usr/lib/pkgconfig/"

  for pc in "${staging}"/usr/lib/pkgconfig/*.pc; do
    sed -i "s|^prefix=.*|prefix=${staging}/usr|" "$pc"
  done

  # The HAL includes <jsoncpp/json/json.h> (Ubuntu layout); Arch installs
  # /usr/include/json. Shim it inside the staging tree; CPATH makes it visible.
  if [[ -d /usr/include/json ]] && [[ ! -e /usr/include/jsoncpp/json ]]; then
    mkdir -p "${staging}/usr/include/jsoncpp"
    ln -sf /usr/include/json "${staging}/usr/include/jsoncpp/json"
  fi
}

build() {
  local staging="${srcdir}/staging"

  export PKG_CONFIG_PATH="${staging}/usr/lib/pkgconfig:${staging}${_prefix}/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
  export LIBRARY_PATH="${staging}/usr/lib:${staging}${_prefix}/lib:${LIBRARY_PATH:-}"
  export LD_LIBRARY_PATH="${staging}/usr/lib:${staging}${_prefix}/lib:${LD_LIBRARY_PATH:-}"
  export CPATH="${staging}/usr/include:${CPATH:-}"

  # CamHAL. CMAKE_POLICY_VERSION_MINIMUM: CMake 4 refuses the tree's
  # cmake_minimum_required(2.8). Prefix baking matters: CAMHAL_PLUGIN_DIR (the
  # hal_adaptor dlopen path) and the default CAMERA_CFG_PATH both derive from
  # CMAKE_INSTALL_PREFIX, so they point into the private prefix.
  cd "${srcdir}/ipu7-camera-hal"
  rm -rf build && mkdir -p build && cd build
  cmake -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="${_prefix}" \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DBUILD_CAMHAL_ADAPTOR=ON \
    -DBUILD_CAMHAL_PLUGIN=ON \
    -DIPU_VERSIONS="ipu75xa" \
    -DUSE_STATIC_GRAPH=ON \
    -DUSE_STATIC_GRAPH_AUTOGEN=ON \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DCMAKE_INSTALL_RPATH="${_prefix}/lib" \
    -DCMAKE_PREFIX_PATH="${staging}/usr" \
    -DCMAKE_LIBRARY_PATH="${staging}/usr/lib" \
    -DCMAKE_INCLUDE_PATH="${staging}/usr/include" \
    ..
  make -j"$(nproc)"

  # Stage the HAL install so icamerasrc can find libcamhal.pc and link it.
  make DESTDIR="${staging}" install
  install -Dm644 "${srcdir}/ipu7-camera-hal/libcamhal.pc" \
    "${staging}${_prefix}/lib/pkgconfig/libcamhal.pc"
  sed -i "s|^prefix=.*|prefix=${staging}${_prefix}|" \
    "${staging}${_prefix}/lib/pkgconfig/libcamhal.pc"

  # icamerasrc. Its autogen.sh configures without arguments and ignores
  # --prefix, so configure is re-run with the real prefix and the tree cleaned
  # before the actual build; skipping the clean leaves libtool with a stale
  # rpath and `make install` then refuses to install the plugin.
  cd "${srcdir}/icamerasrc"
  export CHROME_SLIM_CAMHAL=ON
  ./autogen.sh
  ./configure --prefix="${_prefix}"
  make clean
  make -j"$(nproc)"
}

package() {
  local staging="${srcdir}/staging"
  export PKG_CONFIG_PATH="${staging}/usr/lib/pkgconfig:${staging}${_prefix}/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
  export LIBRARY_PATH="${staging}/usr/lib:${staging}${_prefix}/lib:${LIBRARY_PATH:-}"
  export LD_LIBRARY_PATH="${staging}/usr/lib:${staging}${_prefix}/lib:${LD_LIBRARY_PATH:-}"

  # HAL: adaptor, plugin, and the full config tree (gcss graph settings,
  # sensors/*.json, the stock OV05C10_CJFPE50_PTL.aiqb) into
  # ${_prefix}/etc/camera/ipu75xa/ - the layout CAMERA_CFG_PATH points at.
  cd "${srcdir}/ipu7-camera-hal/build"
  make DESTDIR="${pkgdir}" install

  # Binary-only AIQ libraries, ipu75xa only: this is a Panther Lake machine
  # and the plugin links the -ipu75xa sonames. Firmware deliberately excluded
  # (see the header).
  cd "${srcdir}/ipu7-camera-bins"
  cp -P lib/libia_*-ipu75xa.so* "${pkgdir}${_prefix}/lib/"

  # icamerasrc GStreamer plugin (+ its interface library).
  cd "${srcdir}/icamerasrc"
  make DESTDIR="${pkgdir}" install

  # Runtime package: drop the build-time debris. Headers and pkgconfig would
  # invite linking against a deliberately private prefix, the static plugin
  # copy duplicates 3.7 MB, and .la files are banned on Arch anyway.
  rm -rf "${pkgdir}${_prefix}/include" "${pkgdir}${_prefix}/lib/pkgconfig"
  find "${pkgdir}${_prefix}" -name '*.la' -delete -o -name '*.a' -delete

  install -Dm644 "${srcdir}/ipu7-camera-hal/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.ipu7-camera-hal"
  install -Dm644 "${srcdir}/ipu7-camera-bins/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.ipu7-camera-bins"
  install -Dm644 "${srcdir}/icamerasrc/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.icamerasrc"
}
