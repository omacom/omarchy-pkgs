# Maintainer: acrogenesis <adrian.rangel@gmail.com>
pkgname=pg-orbit-bin
pkgver=2.8.0
pkgrel=1
pkgdesc='PostgreSQL client for browsing, querying, and managing databases'
arch=('x86_64')
url='https://pgorbit.com'
license=('LicenseRef-PG-Orbit')
depends=('gtk3' 'libsecret' 'glib2' 'pango' 'cairo' 'harfbuzz' 'gdk-pixbuf2' 'at-spi2-core'
         'libepoxy' 'fontconfig' 'zlib' 'libstdc++' 'libgcc' 'glibc' 'hicolor-icon-theme')
optdepends=('gnome-keyring: Secret Service keyring for saved passwords (or KeePassXC)'
            'xdg-utils: open links and exported files')
provides=('pg-orbit')
conflicts=('pg-orbit')
options=('!strip' '!debug')
source=("https://github.com/acrogenesis/pg-orbit-releases/releases/download/v${pkgver}/pg-orbit-${pkgver}-linux-x64.tar.gz")
sha256sums=('2903056c6841a430d180ab8138a1c22f14abd7b1c7b68a36e3e3107b3411de43')

package() {
  cd "pg-orbit-${pkgver}"

  install -d "${pkgdir}/opt/pg-orbit" "${pkgdir}/usr/bin"
  cp -a pg_orbit lib data "${pkgdir}/opt/pg-orbit/"
  ln -s /opt/pg-orbit/pg_orbit "${pkgdir}/usr/bin/pg-orbit"

  cp -a share "${pkgdir}/usr/"
  # The tarball's entry runs the bundle's pg_orbit; the package puts pg-orbit on PATH.
  sed -i 's/^Exec=pg_orbit$/Exec=pg-orbit/' "${pkgdir}/usr/share/applications/com.acrogenesis.pgOrbit.desktop"
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
