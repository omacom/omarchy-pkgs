pkgname=n1x-npu-firmware-local
pkgver=0.1.0
pkgrel=1
pkgdesc='Source-only local N1X SROOT firmware extractor (no firmware payload)'
arch=('any')
url='https://github.com/johannhartmann/n1x-npu-linux'
license=('MIT')
depends=('python')
source=('prepare-firmware.py' 'test_prepare.py' 'README.md' 'LICENSE')
sha256sums=('1d234c13de4ca005094c8e4971068934f6b23cea96c415973e8c767eabb86896' '4892a14b2512255c2d19b9fe3d2ccfbee8ebdb1e533e06e1f67bd91ee836bcf3' '9c18caad13f836b1b6612d8ef9fbd884804dd8e5052a13013844b653f9878c30' '56e7236fe6a5f52ffb3346830166e80ec89df2b52d06d5f6337ce9c0fcc3327f')
check() {
  python "$srcdir/test_prepare.py"
}
package() {
  install -Dm755 "$srcdir/prepare-firmware.py" "$pkgdir/usr/bin/n1x-npu-prepare-firmware"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
