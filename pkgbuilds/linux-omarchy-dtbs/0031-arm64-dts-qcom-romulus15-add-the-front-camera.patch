From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Felipe Infante de Castro <18445184+fidecastro@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:12:34 -0500
Subject: [PATCH] arm64: dts: qcom: romulus15: add the front camera

The Surface Laptop 7 15" has an OmniVision OV02C10 behind CCI1 and
CSIPHY4, but its tree describes no camera and leaves CAMSS and the CCI
buses disabled. The ov02c10, CCI and CAMSS drivers are already here.

Add the PM8010 rails the sensor uses, enable CCI1 and CAMSS, and connect
an OV02C10 at 0x36 on CCI1 bus 1 to CAMSS port 3 (CSIPHY4) on two data
lanes, with MCLK4 at 19.2 MHz and GPIO 237 as an active-low reset. The
camera indicator LED becomes the sensor's privacy LED.

The board shape follows the 15" support in
github.com/ItsLucas/surface-laptop-7-ubuntu-kernel, which builds on
Oliver White's "arm64: dts: qcom: x1e80100-microsoft-romulus: enable
OV02C10 MIPI CSI-2 camera" (linux-arm-msm, 2026-04-09), rewritten for
the CAMSS binding here: the PHY supplies and the ports sit on the camss
node. By that project's notes the supplies, the reset GPIO, the I2C
address and the chip ID are from this model's ACPI (CAMF, OVTI02C1 /
MSHW0470), and the MCLK pin and rate, the CCI bus and the CSIPHY lanes
are from the reference design.

Tested on the Surface Laptop 7 15": the three rails come up, the sensor
binds at 12-0036, the media graph links it to msm_csiphy4, libcamera's
simple pipeline adds it and a video call in Chrome shows its picture.

The IR camera (CAMI, MSHW0472) is not described.

Assisted-by: Claude Fable 5.2
Signed-off-by: Felipe Infante de Castro <18445184+fidecastro@users.noreply.github.com>
---
 .../dts/qcom/x1e80100-microsoft-romulus15.dts | 104 ++++++++++++++++++
 1 file changed, 104 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus15.dts b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus15.dts
--- a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus15.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus15.dts
@@ -5,6 +5,7 @@
 
 /dts-v1/;
 
+#include <dt-bindings/clock/qcom,x1e80100-camcc.h>
 #include <dt-bindings/dma/qcom-gpi.h>
 #include <dt-bindings/interrupt-controller/irq.h>
 
@@ -41,6 +42,93 @@
 	};
 };
 
+&apps_rsc {
+	/* PM8010 "m": camera PMIC. Only the front camera's rails are declared. */
+	regulators-8 {
+		compatible = "qcom,pm8010-rpmh-regulators";
+		qcom,pmic-id = "m";
+
+		vdd-l1-l2-supply = <&vreg_s5j>;
+		vdd-l3-l4-supply = <&vreg_s4c>;
+
+		vreg_l1m_1p2: ldo1 {
+			regulator-name = "vreg_l1m_1p2";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l3m_1p8: ldo3 {
+			regulator-name = "vreg_l3m_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l5m_2p8: ldo5 {
+			regulator-name = "vreg_l5m_2p8";
+			regulator-min-microvolt = <2800000>;
+			regulator-max-microvolt = <2800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+};
+
+&camss {
+	vdd-csiphy-0p8-supply = <&vreg_l2c>;
+	vdd-csiphy-1p2-supply = <&vreg_l1c>;
+
+	status = "okay";
+
+	ports {
+		/* port@3 is CSIPHY4: the front camera, on two data lanes. */
+		port@3 {
+			csiphy4_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1>;
+				remote-endpoint = <&ov02c10_ep>;
+			};
+		};
+	};
+};
+
+&cci1 {
+	status = "okay";
+};
+
+&cci1_i2c1 {
+	/* Front camera: OmniVision OV02C10 (ACPI OVTI02C1, MSHW0470). */
+	camera@36 {
+		compatible = "ovti,ov02c10";
+		reg = <0x36>;
+
+		reset-gpios = <&tlmm 237 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_rgb_default>;
+		pinctrl-names = "default";
+
+		leds = <&{/leds/led-camera-indicator}>;
+		led-names = "privacy";
+
+		clocks = <&camcc CAM_CC_MCLK4_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK4_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		orientation = <0>; /* Front-facing */
+
+		avdd-supply = <&vreg_l5m_2p8>;
+		dvdd-supply = <&vreg_l1m_1p2>;
+		dovdd-supply = <&vreg_l3m_1p8>;
+
+		port {
+			ov02c10_ep: endpoint {
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <400000000>;
+				remote-endpoint = <&csiphy4_ep>;
+			};
+		};
+	};
+};
+
 &gpi_dma1 {
 	status = "okay";
 };
@@ -112,6 +200,22 @@
 };
 
 &tlmm {
+	cam_rgb_default: cam-rgb-default-state {
+		mclk-pins {
+			pins = "gpio100";
+			function = "cam_aon";
+			drive-strength = <16>;
+			bias-disable;
+		};
+
+		reset-n-pins {
+			pins = "gpio237";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+
 	qup_spi10_data2: qup-spi10-data2-state {
 		/* IO2, IO3 */
 		pins = "gpio49", "gpio50";
-- 
2.47.0
