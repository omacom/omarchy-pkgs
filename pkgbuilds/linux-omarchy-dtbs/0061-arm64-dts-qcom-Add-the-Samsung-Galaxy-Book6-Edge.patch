+&ufs_mem_phy {
+	vdda-phy-supply = <&vreg_l1c1>;
+	vdda-pll-supply = <&vreg_l4f1>;
+
+	/*
+	 * The ACPI power table of UFS0 switches this domain on with the
+	 * drive and names no other. glymur.dtsi gives the PHY no domain, and
+	 * the PCIe 6 PHY that holds this one on the reference board is off
+	 * here.
+	 */
+	power-domains = <&gcc GCC_PCIE_6_PHY_GDSC>;
+
+	status = "okay";
+};
