From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Sun, 15 Nov 2026 01:39:51 +0000
Subject: [PATCH] arm64: dts: qcom: x1p42100-acer-aspire-16-ai: Enable the
 video decoder

Turn on Iris, the video encoder and decoder, so the Aspire 16 AI gets
hardware H.264 and HEVC through V4L2. Its firmware is
qcvss8380_pa.mbn, which Acer's driver download leaves out but its
Windows install carries: an owner's copy is byte for byte the image
Dell ships in its Adreno X1-85/X1-45 graphics driver 2CHK7, so the
tree loads it from the laptop's own folder, where
acer-aspire-16-ai-firmware installs it.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 arch/arm64/boot/dts/qcom/x1p42100-acer-aspire-16-ai.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1p42100-acer-aspire-16-ai.dts b/arch/arm64/boot/dts/qcom/x1p42100-acer-aspire-16-ai.dts
index 2a91c41..9885b55 100644
--- a/arch/arm64/boot/dts/qcom/x1p42100-acer-aspire-16-ai.dts
+++ b/arch/arm64/boot/dts/qcom/x1p42100-acer-aspire-16-ai.dts
@@ -169,6 +169,12 @@
 	firmware-name = "qcom/x1p42100/ACER/A16-11M/qcdxkmsucpurwa.mbn";
 };
 
+&iris {
+	firmware-name = "qcom/x1p42100/ACER/A16-11M/qcvss8380_pa.mbn";
+
+	status = "okay";
+};
+
 &lpass_tlmm {
 	spkr_01_sd_n_active: spkr-01-sd-n-active-state {
 		pins = "gpio12";
