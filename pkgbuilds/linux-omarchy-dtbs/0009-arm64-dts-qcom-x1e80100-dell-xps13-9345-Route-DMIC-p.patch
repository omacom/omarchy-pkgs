From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Aleksandrs Vinarskis <alex.vinarskis@gmail.com>
Date: Thu, 12 Nov 2026 18:25:16 +0100
Subject: [PATCH] arm64: dts: qcom: x1e80100-dell-xps13-9345: Route DMIC
 power

This device has no headset codec. Route the two digital microphones
to the LPASS microphone supply backed by vreg_l1b.

Link: https://github.com/alexVinarskis/linux-x1e80100-dell-tributo/blob/master/0010-arm64-dts-qcom-x1e80100-dell-xps13-9345-enable-MICs-.patch
Signed-off-by: Aleksandrs Vinarskis <alex.vinarskis@gmail.com>
Signed-off-by: Oliver Gassner <42lizard@42lizard.dev>
---
 arch/arm64/boot/dts/qcom/x1e80100-dell-xps13-9345.dts | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-dell-xps13-9345.dts b/arch/arm64/boot/dts/qcom/x1e80100-dell-xps13-9345.dts
index 314e67a..7a0e342 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-dell-xps13-9345.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-dell-xps13-9345.dts
@@ -157,7 +157,9 @@
 		audio-routing = "WooferLeft IN", "WSA WSA_SPK1 OUT",
 				"TweeterLeft IN", "WSA WSA_SPK2 OUT",
 				"WooferRight IN", "WSA2 WSA_SPK2 OUT",
-				"TweeterRight IN", "WSA2 WSA_SPK2 OUT";
+				"TweeterRight IN", "WSA2 WSA_SPK2 OUT",
+				"VA DMIC0", "vdd-micb",
+				"VA DMIC1", "vdd-micb";
 
 		wsa-dai-link {
 			link-name = "WSA Playback";
-- 
2.56.0


