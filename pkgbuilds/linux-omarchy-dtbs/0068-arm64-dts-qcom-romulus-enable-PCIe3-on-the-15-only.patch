From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Caleb E." <158400752+FoxesRCool1@users.noreply.github.com>
Date: Sun, 22 Nov 2026 19:11:42 +0800
Subject: [PATCH] arm64: dts: qcom: romulus: enable PCIe3 on the 15" only

PCIe3 leads to the Surface Laptop 7 15"'s microSD reader, an RTS5261.
The 13.8" has no card reader, but the controller and its PHY are
enabled in the shared x1e80100-microsoft-romulus.dtsi, so on the 13.8"
the host probes, trains for a link that never comes ("Device not
found"), and then keeps its PHY, clocks and power domain on with an
empty root port for as long as the laptop runs.

Move the controller, PHY, port and pin state from the shared dtsi to
x1e80100-microsoft-romulus15.dts. The 15"'s tree compiles to the same
nodes and properties as before; on the 13.8" pcie3 and pcie3_phy stay
disabled.
---
 .../dts/qcom/x1e80100-microsoft-romulus.dtsi  | 44 -------------------
 .../dts/qcom/x1e80100-microsoft-romulus15.dts | 44 +++++++++++++++++++
 2 files changed, 44 insertions(+), 44 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus.dtsi b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus.dtsi
index 2537a10..323f69f 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus.dtsi
+++ b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus.dtsi
@@ -1124,27 +1124,6 @@
 	status = "okay";
 };
 
-&pcie3 {
-	pinctrl-0 = <&pcie3_default>;
-	pinctrl-names = "default";
-
-	/* The RTS5261 chip on the other side only does Gen1x1 anyway */
-	max-link-speed = <1>;
-	status = "okay";
-};
-
-&pcie3_phy {
-	vdda-phy-supply = <&vreg_l3c>;
-	vdda-pll-supply = <&vreg_l3e>;
-
-	status = "okay";
-};
-
-&pcie3_port0 {
-	reset-gpios = <&tlmm 143 GPIO_ACTIVE_LOW>;
-	wake-gpios = <&tlmm 145 GPIO_ACTIVE_LOW>;
-};
-
 &pcie4 {
 	status = "okay";
 };
@@ -1394,29 +1373,6 @@
 		bias-disable;
 	};
 
-	pcie3_default: pcie3-default-state {
-		perst-n-pins {
-			pins = "gpio143";
-			function = "gpio";
-			drive-strength = <2>;
-			bias-disable;
-		};
-
-		clkreq-n-pins {
-			pins = "gpio144";
-			function = "pcie3_clk";
-			drive-strength = <2>;
-			bias-pull-up;
-		};
-
-		wake-n-pins {
-			pins = "gpio145";
-			function = "gpio";
-			drive-strength = <2>;
-			bias-pull-up;
-		};
-	};
-
 	pcie6a_default: pcie6a-default-state {
 		perst-n-pins {
 			pins = "gpio152";
diff --git a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus15.dts b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus15.dts
index 6a4c464..1c1c065 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus15.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus15.dts
@@ -137,6 +137,27 @@
 	status = "okay";
 };
 
+&pcie3 {
+	pinctrl-0 = <&pcie3_default>;
+	pinctrl-names = "default";
+
+	/* The RTS5261 chip on the other side only does Gen1x1 anyway */
+	max-link-speed = <1>;
+	status = "okay";
+};
+
+&pcie3_phy {
+	vdda-phy-supply = <&vreg_l3c>;
+	vdda-pll-supply = <&vreg_l3e>;
+
+	status = "okay";
+};
+
+&pcie3_port0 {
+	reset-gpios = <&tlmm 143 GPIO_ACTIVE_LOW>;
+	wake-gpios = <&tlmm 145 GPIO_ACTIVE_LOW>;
+};
+
 &spi10 {
 	compatible = "qcom,geni-qspi";
 	dmas = <&gpi_dma1 0 2 QCOM_GPI_QSPI>,
@@ -216,6 +237,29 @@
 		};
 	};
 
+	pcie3_default: pcie3-default-state {
+		perst-n-pins {
+			pins = "gpio143";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		clkreq-n-pins {
+			pins = "gpio144";
+			function = "pcie3_clk";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+
+		wake-n-pins {
+			pins = "gpio145";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
 	qup_spi10_data2: qup-spi10-data2-state {
 		/* IO2, IO3 */
 		pins = "gpio49", "gpio50";
-- 
2.56.1

