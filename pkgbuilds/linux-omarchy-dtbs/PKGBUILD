# The Snapdragon laptops' device trees and the hardware IDs systemd-stub picks
# them by. The trees build from the sources linux-omarchy-headers ships, with
# its dtc, so a new laptop's tree ships without a kernel build.
pkgname=linux-omarchy-dtbs
_kernel=linux-omarchy
pkgver=7.3
pkgrel=1
pkgdesc="Device trees and hardware IDs for the Snapdragon laptops on $_kernel"
url='https://omarchy.org'
arch=(aarch64)
license=(GPL-2.0-only)
makedepends=("$_kernel-headers")
