# A copy of the headers' tree sources, with this recipe's patches applied:
# a new laptop's tree, or a fix to one the kernel ships. A patch the kernel's
# sources already hold is skipped, so the rebuild that follows a kernel that
# took it still passes. One that neither applies nor is there stops the build.
prepare() {
  local build=/usr/src/$_kernel
  [[ -d $build/arch/arm64/boot/dts/qcom ]] || {
    echo "$_kernel-headers ships no device tree sources" >&2
    return 1
  }
  rm -rf tree
  mkdir -p tree/arch/arm64/boot tree/include tree/scripts/dtc
  # The sources with their links resolved (dt-bindings/input links into
  # include/uapi), and include-prefixes' links, which point into the copy.
  cp -rL "$build/arch/arm64/boot/dts" tree/arch/arm64/boot/
  cp -rL "$build/include/dt-bindings" tree/include/
  cp -a "$build/scripts/dtc/include-prefixes" tree/scripts/dtc/

  local src
  for src in "${source[@]}"; do
    [[ $src == *.patch ]] || continue
    if patch -d tree -Rp1 --fuzz=0 --dry-run -sf < "$src" >/dev/null 2>&1; then
      echo "Skipping $src: the kernel's sources have it. Remove it from this recipe."
      continue
    fi
    echo "Applying $src..."
    patch -d tree -Np1 --fuzz=0 < "$src"
  done
}

# As Kbuild builds a tree, with the headers' dtc. Every tree gets the symbols
# an overlay needs (-@), which Kbuild gives only those with an EL2 variant.
build() {
  cd tree
  local prefixes=scripts/dtc/include-prefixes dts out
  rm -rf ../dtbs
  mkdir -p ../dtbs
  for dts in arch/arm64/boot/dts/qcom/*.dts; do
    out=../dtbs/$(basename "${dts%.dts}")
    gcc -E -nostdinc -undef -D__DTS__ -x assembler-with-cpp \
      -I "$prefixes" -o "$out.pre.dts" "$dts"
    "/usr/src/$_kernel/scripts/dtc/dtc" -q -@ -O dtb -b 0 \
      -i "${dts%/*}" -i "$prefixes" -o "$out.dtb" "$out.pre.dts"
    rm "$out.pre.dts"
  done
}

package() {
  # The kernel whose sources the trees were built from, where pacman -Qi and
  # the repository show it, to tell trees that trail their kernel.
  local built_from
  built_from=$(pacman -Q "$_kernel-headers") || return
  pkgdesc+=" (built from ${built_from/ / })"

  # Under the kernel's name, so no file is shared with another kernel's trees.
  install -Dm644 -t "$pkgdir/boot/dtbs/$_kernel/qcom" dtbs/*.dtb

  # Hardware IDs for the laptops systemd's list lacks, so ukify embeds them and
  # systemd-stub picks the tree on those laptops too.
  local src
  for src in "${source[@]}"; do
    [[ $src == *.json ]] || continue
    install -Dm644 -t "$pkgdir/usr/lib/systemd/boot/hwids/aa64/$_kernel" "$src"
  done
}

