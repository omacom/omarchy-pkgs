+
+&tlmm {
+	gpio-reserved-ranges = <2 2>, <47 3>, <126 4>;
+
+	hall_int_active_state: hall-int-active-state {
+		pins = "gpio50";
+		function = "gpio";
+		bias-disable;
+	};
+
+	i2c0_active: i2c0-active-state {
+		pins = "gpio0", "gpio1";
+		function = "qup0";
+		bias-pull-up;
+		drive-strength = <2>;
+	};
+
+	i2c8_active: i2c8-active-state {
+		pins = "gpio88", "gpio89";
+		function = "qup8";
+		bias-pull-up;
+		drive-strength = <2>;
+	};
+
+	kb_int_default: kb-int-default-state {
+		pins = "gpio125";
+		function = "gpio";
+		bias-pull-up;
+		drive-strength = <2>;
+	};
+
+	pcie0_default_state: pcie0-default-state {
+		clkreq-n-pins {
+			pins = "gpio36";
+			function = "pci_e0";
+			bias-pull-up;
+		};
+
