From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Sun, 15 Nov 2026 20:30:00 +0000
Subject: [PATCH] arm64: dts: qcom: Add the HP OmniBook 3 14 with the LCD panel

Add the HP OmniBook 3 14 (14-hz0xxx, board 8EF1) with its LCD panel
(AUO 0xe3ba) instead of the Samsung OLED. Its DSDT gives every panel
but the OLED a PMIC PWM backlight, 12 bits at 2400 Hz, as on the
OmniBook 3 16, so the tree is the OLED model's with the 16's panel and
backlight nodes. Its DSP images and GPU zap shader in Windows are the
OLED model's byte for byte, so the firmware paths are the same.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 .../dts/qcom/x1p42100-hp-omnibook-3-lcd.dts   | 100 ++++++++++++++++++
 1 file changed, 100 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-3-lcd.dts

diff --git a/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-3-lcd.dts b/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-3-lcd.dts
new file mode 100644
index 0000000..d5778f6
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-3-lcd.dts
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * HP OmniBook 3 Laptop 14-hz0xxx (board 8EF1) with the LCD panel, on the
+ * OLED model's x1-hp-omnibook-3.dtsi. The panel's EDID is AUO 0xe3ba.
+ * The board's DSDT (BIOS F.02) gives every panel but the Samsung OLED
+ * (SDC 0x4213) a PMIC PWM backlight, 12 bits at 2400 Hz, the backlight
+ * of the OmniBook 3 16's LCD, so the panel and backlight nodes are the
+ * 16's.
+ */
+
+/dts-v1/;
+
+#include "purwa.dtsi"
+#include "hamoa-pmics.dtsi"
+#include "x1-hp-omnibook-3.dtsi"
+
+/delete-node/ &pmc8380_6;
+/delete-node/ &pmc8380_6_thermal;
+
+/ {
+	model = "HP OmniBook 3 Laptop 14-hz0xxx";
+	compatible = "hp,omnibook-3-lcd", "qcom,x126100", "qcom,x1p42100";
+	chassis-type = "laptop";
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pmk8550_pwm 0 416667>;
+		enable-gpios = <&pmc8380_3_gpios 4 GPIO_ACTIVE_HIGH>;
+		power-supply = <&vreg_edp_bl>;
+
+		pinctrl-0 = <&edp_bl_en>, <&edp_bl_pwm>;
+		pinctrl-names = "default";
+	};
+
+	vreg_edp_bl: regulator-edp-bl {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VBL9";
+		regulator-min-microvolt = <3600000>;
+		regulator-max-microvolt = <3600000>;
+
+		gpio = <&pmc8380_3_gpios 10 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		pinctrl-0 = <&edp_bl_reg_en>;
+		pinctrl-names = "default";
+
+		regulator-boot-on;
+	};
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/x1p42100/hp/omnibook-3/qcdxkmsucpurwa.mbn";
+};
+
+&mdss_dp3 {
+	aux-bus {
+		panel {
+			compatible = "edp-panel";
+
+			/delete-property/ enable-gpios;
+			/delete-property/ pinctrl-0;
+			/delete-property/ pinctrl-names;
+
+			backlight = <&backlight>;
+		};
+	};
+};
+
+&pmc8380_3_gpios {
+	edp_bl_reg_en: edp-bl-reg-en-state {
+		pins = "gpio10";
+		function = "normal";
+	};
+};
+
+&pmk8550_gpios {
+	edp_bl_pwm: edp-bl-pwm-state {
+		pins = "gpio5";
+		function = "func3";
+	};
+};
+
+&pmk8550_pwm {
+	status = "okay";
+};
+
+&remoteproc_adsp {
+	firmware-name = "qcom/x1p42100/hp/omnibook-3/qcadsp8380.mbn",
+			"qcom/x1p42100/hp/omnibook-3/adsp_dtbs.elf";
+
+	status = "okay";
+};
+
+&remoteproc_cdsp {
+	firmware-name = "qcom/x1p42100/hp/omnibook-3/qccdsp8380.mbn",
+			"qcom/x1p42100/hp/omnibook-3/cdsp_dtbs.elf";
+
+	status = "okay";
+};
-- 
2.56.0

