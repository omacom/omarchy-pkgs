From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: David Heinemeier Hansson <david@loudthinking.com>
Date: Thu, 26 Nov 2026 13:35:00 +0100
Subject: [PATCH] arm64: dts: qcom: glymur-anduril-bluechip: Add front camera

The Anduril BlueChip is built on the Glymur CRD design and carries a
front-facing OmniVision OV08X40 RGB camera on CSIPHY4 in 4-lane mode
behind CCI1 bus 1, powered by a PM8010 camera PMIC on i2c5.

Its Windows camera configuration (CAMF_RES_QRD.bin, CAMP_RES_QRD.bin,
SCFG_FRONT_QRD.bin and qsh_camera_ov08x_2.json) places the OV08X40 at
7-bit I2C address 0x10 (8-bit 0x20), enables PM8010 via GPIO 106 and
sensor reset via GPIO 239, powers AVDD on PM8010 LDO7 (2.8 V), DOVDD on
LDO4 (1.8 V) and DVDD on LDO2 (1.1 V; 1.104 V on the PM8010 NLDO 8 mV
step grid), and drives MCLK4 (GPIO 100) at 19.2 MHz with 4 mA drive
strength.

Add the PM8010 camera PMIC on i2c5, enable CAMSS, CSIPHY4 and CCI1, and
wire up the OV08X40 sensor at 0x10 on cci1_i2c1.
---
--- a/arch/arm64/boot/dts/qcom/glymur-anduril-bluechip.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-anduril-bluechip.dts
@@ -11,6 +11,9 @@
 
 /dts-v1/;
 
+#include <dt-bindings/media/video-interface-devices.h>
+#include <dt-bindings/media/video-interfaces.h>
+
 #include "glymur.dtsi"
 #include "glymur-crd.dtsi"
 
@@ -43,6 +46,114 @@
 	};
 };
 
+&cam_mclk4_default {
+	drive-strength = <4>;
+};
+
+&camss {
+	status = "okay";
+};
+
+&camss_csiphy4_inep {
+	data-lanes = <1 2 3 4>;
+};
+
+&cci1 {
+	pinctrl-0 = <&cci1_1_default>;
+	pinctrl-1 = <&cci1_1_sleep>;
+
+	status = "okay";
+};
+
+&cci1_i2c1 {
+	camera@10 {
+		compatible = "ovti,ov08x40";
+		reg = <0x10>;
+
+		reset-gpios = <&tlmm 239 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_mclk4_default>, <&cam_reset4_default>;
+		pinctrl-names = "default";
+
+		clocks = <&camcc CAM_CC_MCLK4_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK4_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		orientation = <MEDIA_ORIENTATION_FRONT>;
+
+		avdd-supply = <&vreg_l7p>;
+		dovdd-supply = <&vreg_l4p>;
+		dvdd-supply = <&vreg_l2p>;
+
+		port {
+			ov08x40_out_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <400000000>;
+				remote-endpoint = <&csiphy4_in_ep>;
+			};
+		};
+	};
+};
+
+&csiphy4 {
+	vdda-0p9-supply = <&vreg_l1f_e1_0p82>;
+	vdda-1p2-supply = <&vreg_l4f_e1_1p08>;
+
+	status = "okay";
+};
+
+&csiphy4_in_ep {
+	bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+	clock-lanes = <0>;
+	data-lanes = <1 2 3 4>;
+	remote-endpoint = <&ov08x40_out_ep>;
+};
+
+&i2c5 {
+	pm8010: pmic@8 {
+		compatible = "qcom,pm8010-i2c";
+		reg = <0x8>;
+
+		reset-gpios = <&tlmm 106 GPIO_ACTIVE_LOW>;
+
+		vdd-l1-l2-supply = <&vreg_s7f_e0_1p32>;
+		vdd-l3-l4-supply = <&vreg_bob1_e0>;
+		vdd-l5-supply = <&vreg_bob1_e0>;
+		vdd-l6-supply = <&vreg_bob1_e0>;
+		vdd-l7-supply = <&vreg_bob1_e0>;
+
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-ranges = <&pm8010 0 0 2>;
+
+		#thermal-sensor-cells = <0>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&pm8010_default>;
+
+		regulators {
+			/* L1, L3, L5, L6 are unused */
+
+			vreg_l2p: ldo2 {
+				regulator-name = "vreg_l2p";
+				regulator-min-microvolt = <1104000>;
+				regulator-max-microvolt = <1104000>;
+			};
+
+			vreg_l4p: ldo4 {
+				regulator-name = "vreg_l4p";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+
+			vreg_l7p: ldo7 {
+				regulator-name = "vreg_l7p";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+		};
+	};
+};
+
 &i2c8 {
 	/delete-node/ touchscreen@38;
 
@@ -129,6 +240,22 @@
 };
 
 &tlmm {
+	cam_reset4_default: cam-reset4-default-state {
+		pins = "gpio239";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	pm8010_default: pm8010-default-state {
+		reset-n-pins {
+			pins = "gpio106";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+
 	ts0_int_default: ts0-int-default-state {
 		pins = "gpio51";
 		function = "gpio";
