From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Sun, 15 Nov 2026 00:00:17 +0000
Subject: [PATCH] arm64: dts: qcom: mahua-microsoft-surface-pro-12th-edition:
 Load its own DSP firmware

The tree loaded its audio and compute DSP images from the Surface Laptop
8's folder, qcom/glymur/microsoft/mahua. Microsoft's driver package for
the Surface Pro 12th Edition has an audio DSP image of its own, which
differs from the Surface Laptop 8's, so the tablet would start its ADSP
with another machine's image. Load both DSPs from
qcom/glymur/microsoft/surface-pro-12th-edition, the folder the tree
already loads its SoCCP and USB4 router firmware from.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 .../dts/qcom/mahua-microsoft-surface-pro-12th-edition.dts | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/mahua-microsoft-surface-pro-12th-edition.dts b/arch/arm64/boot/dts/qcom/mahua-microsoft-surface-pro-12th-edition.dts
index 386c8bc..2a36c2c 100644
--- a/arch/arm64/boot/dts/qcom/mahua-microsoft-surface-pro-12th-edition.dts
+++ b/arch/arm64/boot/dts/qcom/mahua-microsoft-surface-pro-12th-edition.dts
@@ -774,15 +774,15 @@
 };
 
 &remoteproc_adsp {
-	firmware-name = "qcom/glymur/microsoft/mahua/qcadsp8480.mbn",
-			"qcom/glymur/microsoft/mahua/adsp_dtbs.elf";
+	firmware-name = "qcom/glymur/microsoft/surface-pro-12th-edition/qcadsp8480.mbn",
+			"qcom/glymur/microsoft/surface-pro-12th-edition/adsp_dtbs.elf";
 
 	status = "okay";
 };
 
 &remoteproc_cdsp {
-	firmware-name = "qcom/glymur/microsoft/mahua/qccdsp8480.mbn",
-			"qcom/glymur/microsoft/mahua/cdsp_dtbs.elf";
+	firmware-name = "qcom/glymur/microsoft/surface-pro-12th-edition/qccdsp8480.mbn",
+			"qcom/glymur/microsoft/surface-pro-12th-edition/cdsp_dtbs.elf";
 
 	status = "okay";
 };
