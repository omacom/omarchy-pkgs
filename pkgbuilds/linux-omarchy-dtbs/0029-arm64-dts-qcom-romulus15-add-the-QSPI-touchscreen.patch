From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Felipe Infante de Castro <18445184+fidecastro@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:11:00 -0500
Subject: [PATCH] arm64: dts: qcom: romulus15: add the QSPI touchscreen

The Surface Laptop 7 15" touchscreen is a HID-over-SPI digitizer on
spi10, on four data lanes. Its tree has no node for it and leaves spi10
and gpi_dma1 disabled, so the laptop has no touchscreen under Linux. The
drivers are already here: spi-hid and the QSPI mode of spi-geni-qcom
came in with the Surface Pro 11 patches.

Describe the bus and the touchscreen as the Surface Pro 11's tree does.
The wiring is the same: interrupt on GPIO 51, reset on GPIO 48, supply
enabled by GPIO 64, IO2 and IO3 on GPIO 49 and 50. The 15" support in
github.com/ItsLucas/surface-laptop-7-ubuntu-kernel has the same pins,
from this model's Windows ACPI (MSHW0461, GTCH), along with the 20 MHz
bus speed and the pull-up on the interrupt line used here.

Tested on the Surface Laptop 7 15": the node boots, enumerates as
045E:0C6F with no SPI bus errors, iptsd runs it in touchscreen mode, and
touch works across reboots. After a suspend the digitizer resets and
iptsd, restarted by iptsd-romulus15-resume.service, connects to it
again.

The 13.8" has a different, I2C touchscreen and is not covered.

Assisted-by: Claude Fable 5.2
Signed-off-by: Felipe Infante de Castro <18445184+fidecastro@users.noreply.github.com>
---
 .../dts/qcom/x1e80100-microsoft-romulus15.dts | 69 +++++++++++++++++++
 1 file changed, 69 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus15.dts b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus15.dts
index 023cc02..f7e5b82 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus15.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus15.dts
@@ -27,12 +27,59 @@
 		regulator-boot-on;
 		startup-delay-us = <500000>;
 	};
+
+	vreg_touch: regulator-touch {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VREG_TOUCH";
+
+		gpio = <&tlmm 64 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		pinctrl-0 = <&touchscreen_power_en>;
+		pinctrl-names = "default";
+	};
+};
+
+&gpi_dma1 {
+	status = "okay";
 };
 
 &gpi_dma2 {
 	status = "okay";
 };
 
+&spi10 {
+	compatible = "qcom,geni-qspi";
+	dmas = <&gpi_dma1 0 2 QCOM_GPI_QSPI>,
+	       <&gpi_dma1 1 2 QCOM_GPI_QSPI>;
+	dma-names = "tx", "rx";
+	pinctrl-0 = <&qup_spi10_data_clk>, <&qup_spi10_data2>,
+		    <&qup_spi10_cs>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	touchscreen@0 {
+		compatible = "microsoft,g6-touch-digitizer", "hid-over-spi";
+		reg = <0>;
+		spi-max-frequency = <20000000>;
+
+		interrupts-extended = <&tlmm 51 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&tlmm 48 GPIO_ACTIVE_LOW>;
+		vdd-supply = <&vreg_touch>;
+
+		pinctrl-0 = <&touchscreen_int>;
+		pinctrl-names = "default";
+
+		input-report-header-address = <0x1000>;
+		input-report-body-address = <0x1004>;
+		output-report-address = <0x2000>;
+		read-opcode = /bits/ 8 <0xeb>;
+		write-opcode = /bits/ 8 <0xe2>;
+		hid-over-spi-flags = <0xa000>;
+	};
+};
+
 &spi19 {
 	compatible = "qcom,geni-qspi";
 	dmas = <&gpi_dma2 0 3 QCOM_GPI_QSPI>,
@@ -65,6 +112,14 @@
 };
 
 &tlmm {
+	qup_spi10_data2: qup-spi10-data2-state {
+		/* IO2, IO3 */
+		pins = "gpio49", "gpio50";
+		function = "qup1_se2";
+		drive-strength = <6>;
+		bias-disable;
+	};
+
 	qup_qspi19_cs: qup-qspi19-cs-state {
 		pins = "gpio79";
 		function = "qup2_se3";
@@ -101,4 +156,18 @@
 		drive-strength = <16>;
 		bias-disable;
 	};
+
+	touchscreen_int: touchscreen-int-state {
+		pins = "gpio51";
+		function = "gpio";
+		input-enable;
+		bias-pull-up;
+	};
+
+	touchscreen_power_en: touchscreen-power-en-state {
+		pins = "gpio64";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
 };
