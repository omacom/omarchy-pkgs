From: "Caleb E." <158400752+FoxesRCool1@users.noreply.github.com>
Date: Sun, 22 Nov 2026 16:45:15 +0800
Subject: [PATCH 66/66] arm64: dts: qcom: romulus13: add the front camera

Add the Surface Laptop 7 13.8"'s front camera, an OmniVision OV02C10 on
CCI1 bus 1 and CSIPHY4 (CAMSS port 3), with the three PM8010 rails it
uses and the camera indicator LED as its privacy LED. Both sizes share
one set of ACPI tables for the camera (MSHW0470, OVTI02C1), so this is
0031's node for the 15" unchanged.

Tested on the Surface Laptop 7 13.8" (X1E80100) from a hw-test boot
entry on linux-omarchy 7.3.0-75: ov02c10 binds at 12-0036, cam -l lists
it, and libcamera's simple pipeline streams 1080p at about 19 fps. As
on the 15", the picture is correct but dark, since the sensor has no
tuning yet. The IR camera isn't described.
---
 .../dts/qcom/x1e80100-microsoft-romulus13.dts | 104 ++++++++++++++++++
 1 file changed, 104 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus13.dts b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus13.dts
index 92e7b84..54e1954 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus13.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus13.dts
@@ -5,6 +5,7 @@
 
 /dts-v1/;
 
+#include <dt-bindings/clock/qcom,x1e80100-camcc.h>
 #include <dt-bindings/dma/qcom-gpi.h>
 #include <dt-bindings/interrupt-controller/irq.h>
 
@@ -42,6 +43,93 @@
 	};
 };
 
+&apps_rsc {
+	/* PM8010 "m": camera PMIC. Only the front camera's rails are declared. */
+	regulators-8 {
+		compatible = "qcom,pm8010-rpmh-regulators";
+		qcom,pmic-id = "m";
+
+		vdd-l1-l2-supply = <&vreg_s5j>;
+		vdd-l3-l4-supply = <&vreg_s4c>;
+
+		vreg_l1m_1p2: ldo1 {
+			regulator-name = "vreg_l1m_1p2";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l3m_1p8: ldo3 {
+			regulator-name = "vreg_l3m_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		vreg_l5m_2p8: ldo5 {
+			regulator-name = "vreg_l5m_2p8";
+			regulator-min-microvolt = <2800000>;
+			regulator-max-microvolt = <2800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+};
+
+&camss {
+	vdd-csiphy-0p8-supply = <&vreg_l2c>;
+	vdd-csiphy-1p2-supply = <&vreg_l1c>;
+
+	status = "okay";
+
+	ports {
+		/* port@3 is CSIPHY4: the front camera, on two data lanes. */
+		port@3 {
+			csiphy4_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1>;
+				remote-endpoint = <&ov02c10_ep>;
+			};
+		};
+	};
+};
+
+&cci1 {
+	status = "okay";
+};
+
+&cci1_i2c1 {
+	/* Front camera: OmniVision OV02C10 (ACPI OVTI02C1, MSHW0470). */
+	camera@36 {
+		compatible = "ovti,ov02c10";
+		reg = <0x36>;
+
+		reset-gpios = <&tlmm 237 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_rgb_default>;
+		pinctrl-names = "default";
+
+		leds = <&{/leds/led-camera-indicator}>;
+		led-names = "privacy";
+
+		clocks = <&camcc CAM_CC_MCLK4_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK4_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		orientation = <0>; /* Front-facing */
+
+		avdd-supply = <&vreg_l5m_2p8>;
+		dvdd-supply = <&vreg_l1m_1p2>;
+		dovdd-supply = <&vreg_l3m_1p8>;
+
+		port {
+			ov02c10_ep: endpoint {
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <400000000>;
+				remote-endpoint = <&csiphy4_ep>;
+			};
+		};
+	};
+};
+
 &gpi_dma1 {
 	status = "okay";
 };
@@ -124,6 +212,22 @@
 };
 
 &tlmm {
+	cam_rgb_default: cam-rgb-default-state {
+		mclk-pins {
+			pins = "gpio100";
+			function = "cam_aon";
+			drive-strength = <16>;
+			bias-disable;
+		};
+
+		reset-n-pins {
+			pins = "gpio237";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+
 	qup_qspi19_cs: qup-qspi19-cs-state {
 		pins = "gpio79";
 		function = "qup2_se3";
