+
+/* ACPI UARD @ 0x894000, the SPCR and DBG2 console at 115200 baud */
+&uart21 {
+	status = "okay";
+};
+
+/*
+ * ACPI UR23 @ 0x898000: Surface Serial Hub, MSHW0084, at 4 Mbaud (SUBR
+ * 0x3d0900). Its wake interrupt, GIO0 virtual pin 0x300, is TLMM 71: the
+ * ninth interrupt after the four summary interrupts of GIO0._CRS, GSIV
+ * 0x2f2, is SPI 722, which kalambo.dtsi's PDC ranges make PDC pin 135, and
+ * the Mahua PDC map makes that TLMM 71.
+ */
+&uart22 {
+	status = "okay";
+
+	embedded-controller {
+		compatible = "microsoft,surface-sam";
+
+		interrupts-extended = <&tlmm 71 IRQ_TYPE_EDGE_RISING>;
+
+		current-speed = <4000000>;
+
+		pinctrl-0 = <&ssam_state>;
+		pinctrl-names = "default";
+	};
+};
+
+/* ACPI URS0 and URS1: the two USB-C ports; URS2 is disabled. */
+&usb_0 {
+	status = "okay";
+};
+
+&usb_0_dwc3_hs {
+	remote-endpoint = <&pmic_glink_hs_in>;
+};
+
+&usb_0_hsphy {
+	vdd-supply = <&vreg_l3f_e0>;
+	vdda12-supply = <&vreg_l4h_e0>;
+
+	phys = <&smb2370_j_e2_eusb2_repeater>;
+
+	status = "okay";
+};
+
+&usb_0_qmpphy {
+	vdda-phy-supply = <&vreg_l3f_e0>;
+	vdda-pll-supply = <&vreg_l4h_e0>;
+	refgen-supply = <&vreg_l2f_e0>;
+
+	status = "okay";
+};
+
+&usb_0_qmpphy_out {
+	remote-endpoint = <&pmic_glink_ss_in>;
+};
+
+&usb_1 {
+	status = "okay";
+};
+
+&usb_1_dwc3_hs {
+	remote-endpoint = <&pmic_glink_hs_in1>;
+};
+
+&usb_1_hsphy {
+	vdd-supply = <&vreg_l3f_e0>;
+	vdda12-supply = <&vreg_l4h_e0>;
+
+	phys = <&smb2370_k_e2_eusb2_repeater>;
+
+	status = "okay";
+};
+
+&usb_1_qmpphy {
+	vdda-phy-supply = <&vreg_l1h_e0>;
+	vdda-pll-supply = <&vreg_l4h_e0>;
+	refgen-supply = <&vreg_l2f_e0>;
+
+	status = "okay";
+};
+
+&usb_1_qmpphy_out {
+	remote-endpoint = <&pmic_glink_ss_in1>;
+};
