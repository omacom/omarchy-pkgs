+
+&pcie4 {
+	pinctrl-0 = <&pcie4_default>;
+	pinctrl-names = "default";
+
+	status = "okay";
+};
+
+&pcie4_phy {
+	vdda-phy-supply = <&vreg_l1c_e1>;
+	vdda-pll-supply = <&vreg_l4f_e1>;
+
+	status = "okay";
+};
+
+/* ACPI PCI4: reset TLMM 146, wake TLMM 148 (virtual pin 0x180) */
+&pcie4_port0 {
+	reset-gpios = <&tlmm 146 GPIO_ACTIVE_LOW>;
+	wake-gpios = <&tlmm 148 GPIO_ACTIVE_LOW>;
+
+	/*
+	 * The Surface Laptop 8's WCN7850 reads its rfkill input as "radio off".
+	 * ACPI BTH0 is the Surface Laptop 8's here, but the chip is not named,
+	 * so the node has no compatible.
+	 */
+	wifi@0 {
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+
+		disable-rfkill;
+	};
+};
+
+&pcie4_port0_ep {
+	remote-endpoint = <&m2_e_pcie_ep>;
+};
+
+&pmk8850_gpios {
