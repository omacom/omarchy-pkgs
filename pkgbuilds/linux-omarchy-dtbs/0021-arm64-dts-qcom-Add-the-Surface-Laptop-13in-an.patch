From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Sat, 14 Nov 2026 21:13:55 +0000
Subject: [PATCH] arm64: dts: qcom: Add the Surface Laptop 13in and
 Surface Pro 12in 2nd Edition

Add the Surface Laptop 13in 2nd Edition and Surface Pro 12in 2nd Edition
with the 6-core Snapdragon X2 Plus X2P-42-100 (Kalambo). Written from
the DSDTs in Microsoft's firmware updates, whose power tables match the
Surface Laptop 8's, with a shared board file: Surface Aggregator Module
on uart22, lid or cover on TLMM 2, Wi-Fi on pcie4, Bluetooth on uart14,
and each one's touchscreen.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 ...rosoft-surface-laptop-13in-2nd-edition.dts | 315 +++++++
 ...microsoft-surface-pro-12in-2nd-edition.dts | 183 ++++
 .../dts/qcom/kalambo-microsoft-surface.dtsi   | 838 ++++++++++++++++++
 3 files changed, 1336 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/kalambo-microsoft-surface-laptop-13in-2nd-edition.dts
 create mode 100644 arch/arm64/boot/dts/qcom/kalambo-microsoft-surface-pro-12in-2nd-edition.dts
 create mode 100644 arch/arm64/boot/dts/qcom/kalambo-microsoft-surface.dtsi

diff --git a/arch/arm64/boot/dts/qcom/kalambo-microsoft-surface-laptop-13in-2nd-edition.dts b/arch/arm64/boot/dts/qcom/kalambo-microsoft-surface-laptop-13in-2nd-edition.dts
new file mode 100644
index 0000000..804e20a
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/kalambo-microsoft-surface-laptop-13in-2nd-edition.dts
@@ -0,0 +1,315 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Microsoft Surface Laptop 13-inch (2nd Edition), model 2145, with the
+ * 6-core Snapdragon X2 Plus X2P-42-100 (Kalambo).
+ *
+ * Written from the ACPI tables in Microsoft's firmware download
+ * (Surface_UEFI_8.5175.155). Next to the parts kalambo-microsoft-surface.dtsi
+ * shares with the Surface Pro 12-inch (2nd Edition), the laptop has a
+ * touchscreen (MSHW0816) at 0x34 behind the switch the panel also depends
+ * on, as on the Surface Laptop 8 15-inch. It has the USB 2.0 controller
+ * (ACPI USB4 @ 0xa200000) with one internal port, and the multiport
+ * controller (ACPI USB3) with the USB-A port; the ACPI tables have no I2C
+ * keyboard or touchpad. Its drive is NVMe: the INA4230 power monitor
+ * channel is STORAGE_SSD_3P3V.
+ *
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+/dts-v1/;
+
+#include "kalambo.dtsi"
+#include "kalambo-microsoft-surface.dtsi"
+
+/ {
+	model = "Microsoft Surface Laptop 13in 2nd Edition";
+	compatible = "microsoft,surface-laptop-13in-2nd-edition", "qcom,kalambo";
+	chassis-type = "laptop";
+
+	/*
+	 * ACPI power resource TDPR: TLMM 49, then 150 ms. Both the touchscreen
+	 * (ITCH) and the panel (GPU0.MON0) depend on it, so it stays on.
+	 */
+	vreg_touch_display: regulator-touch-display {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VREG_TOUCH_DISPLAY";
+
+		gpio = <&tlmm 49 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <150000>;
+
+		pinctrl-0 = <&touch_display_pwr_en>;
+		pinctrl-names = "default";
+
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/* ACPI ITCH _PS0 drives TLMM 31 high and _PS3 drives it low. */
+	vreg_ts: regulator-touchscreen {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VREG_TS";
+
+		gpio = <&tlmm 31 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		vin-supply = <&vreg_touch_display>;
+
+		pinctrl-0 = <&ts_pwr_en>;
+		pinctrl-names = "default";
+
+		regulator-boot-on;
+	};
+
+	vreg_nvme: regulator-nvme {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VREG_NVME_3P3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+
+		gpio = <&pmh0101_gpios 14 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		pinctrl-0 = <&nvme_reg_en>;
+		pinctrl-names = "default";
+
+		regulator-boot-on;
+	};
+};
+
+&i2c8 {
+	/*
+	 * ACPI \_SB.I2C9.ITCH, MSHW0816: 0x34 at 400 kHz, HID descriptor
+	 * register 0 (its _DSM function 1 returns 0), interrupt TLMM 43 level
+	 * low with a pull-up.
+	 */
+	touchscreen@34 {
+		compatible = "hid-over-i2c";
+		reg = <0x34>;
+		hid-descr-addr = <0x0>;
+		interrupts-extended = <&tlmm 43 IRQ_TYPE_LEVEL_LOW>;
+		vdd-supply = <&vreg_ts>;
+
+		pinctrl-0 = <&ts_int_n>;
+		pinctrl-names = "default";
+	};
+};
+
+/*
+ * ACPI PCI5 and PCI7 both declare an NVMe drive (NVME), and which port the
+ * firmware enables (PRP5, PRP7) is filled in at boot. PCI5 is the Surface
+ * Laptop 8's drive port; PCI7 (pcie3b, @ 0x74000000) is a port the Surface
+ * Laptop 8 uses for an external card slot and this laptop's tables turn
+ * into a plain NVMe port. Both are described; the one without a drive
+ * fails link training.
+ */
+&pcie3b {
+	pinctrl-0 = <&pcie3b_default>;
+	pinctrl-names = "default";
+
+	status = "okay";
+};
+
+/* ACPI PCI7 power table: L3C_E1 at 0.936 V and L2C_E1 at 1.2 V */
+&pcie3b_phy {
+	vdda-phy-supply = <&vreg_l3c_e1>;
+	vdda-pll-supply = <&vreg_l2c_e1>;
+
+	status = "okay";
+};
+
+/* ACPI PCI7: reset TLMM 155, wake TLMM 157 (virtual pin 0x240) */
+&pcie3b_port0 {
+	reset-gpios = <&tlmm 155 GPIO_ACTIVE_LOW>;
+	wake-gpios = <&tlmm 157 GPIO_ACTIVE_LOW>;
+};
+
+&pcie5 {
+	vddpe-3v3-supply = <&vreg_nvme>;
+
+	pinctrl-0 = <&pcie5_default>;
+	pinctrl-names = "default";
+
+	status = "okay";
+};
+
+&pcie5_phy {
+	vdda-phy-supply = <&vreg_l2f_e0>;
+	vdda-pll-supply = <&vreg_l4h_e0>;
+
+	status = "okay";
+};
+
+/* ACPI PCI5: reset TLMM 152, wake TLMM 154 (virtual pin 0x1c0) */
+&pcie5_port0 {
+	reset-gpios = <&tlmm 152 GPIO_ACTIVE_LOW>;
+	wake-gpios = <&tlmm 154 GPIO_ACTIVE_LOW>;
+};
+
+&pmh0101_gpios {
+	nvme_reg_en: nvme-reg-en-state {
+		pins = "gpio14";
+		function = "normal";
+		bias-disable;
+	};
+};
+
+&remoteproc_adsp {
+	firmware-name = "qcom/kalambo/Microsoft/SurfaceLaptop13/qcadsp8480.mbn",
+			"qcom/kalambo/Microsoft/SurfaceLaptop13/adsp_dtbs.elf";
+
+	status = "okay";
+};
+
+&remoteproc_cdsp {
+	firmware-name = "qcom/kalambo/Microsoft/SurfaceLaptop13/qccdsp8480.mbn",
+			"qcom/kalambo/Microsoft/SurfaceLaptop13/cdsp_dtbs.elf";
+
+	status = "okay";
+};
+
+&tlmm {
+	/*
+	 * ACPI USB4 (the USB 2.0 controller) drives TLMM 9 high in _PS0 and
+	 * nothing low again: the enable of its eUSB2 repeater, which has no
+	 * I2C address in the tables.
+	 */
+	usb-hs-repeater-en-hog {
+		gpio-hog;
+		gpios = <9 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "usb-hs-repeater-en";
+	};
+
+	pcie3b_default: pcie3b-default-state {
+		clkreq-n-pins {
+			pins = "gpio156";
+			function = "pcie3b_clk";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+
+		perst-n-pins {
+			pins = "gpio155";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		wake-n-pins {
+			pins = "gpio157";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
+	pcie5_default: pcie5-default-state {
+		clkreq-n-pins {
+			pins = "gpio153";
+			function = "pcie5_clk_req_n";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+
+		perst-n-pins {
+			pins = "gpio152";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		wake-n-pins {
+			pins = "gpio154";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
+	touch_display_pwr_en: touch-display-pwr-en-state {
+		pins = "gpio49";
+		function = "gpio";
+		drive-strength = <4>;
+		bias-disable;
+	};
+
+	ts_int_n: ts-int-n-state {
+		pins = "gpio43";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	ts_pwr_en: ts-pwr-en-state {
+		pins = "gpio31";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+	};
+};
+
+/*
+ * ACPI USB4 @ 0xa200000, the USB 2.0 controller, with one internal port
+ * (_UPC not connectable by the user). Its PHY rails are those of its PEP
+ * table: L2H_E0 and L4H_E0.
+ */
+&usb_hs {
+	dr_mode = "host";
+
+	status = "okay";
+};
+
+&usb_hs_phy {
+	vdd-supply = <&vreg_l2h_e0>;
+	vdda12-supply = <&vreg_l4h_e0>;
+
+	status = "okay";
+};
+
+/*
+ * Multiport controller (ACPI USB3): the USB-A port and an internal port.
+ * _PS0 drives the enables of the two eUSB2 repeaters, TLMM 8 and 184, high,
+ * and the tables give the repeaters no I2C address, so they are left as
+ * the firmware set them, as on the Surface Laptop 8.
+ */
+&usb_mp {
+	status = "okay";
+};
+
+&usb_mp_hsphy0 {
+	vdd-supply = <&vreg_l2h_e0>;
+	vdda12-supply = <&vreg_l4h_e0>;
+
+	status = "okay";
+};
+
+&usb_mp_hsphy1 {
+	vdd-supply = <&vreg_l2h_e0>;
+	vdda12-supply = <&vreg_l4h_e0>;
+
+	status = "okay";
+};
+
+&usb_mp_qmpphy0 {
+	vdda-phy-supply = <&vreg_l2h_e0>;
+	vdda-pll-supply = <&vreg_l4h_e0>;
+	refgen-supply = <&vreg_l4f_e1>;
+
+	status = "okay";
+};
+
+&usb_mp_qmpphy1 {
+	vdda-phy-supply = <&vreg_l2h_e0>;
+	vdda-pll-supply = <&vreg_l4h_e0>;
+	refgen-supply = <&vreg_l4f_e1>;
+
+	status = "okay";
+};
+
+/* The USB 2.0 and multiport power tables vote for L8B_E0 at 3.072 V. */
+&vreg_l8b_e0 {
+	regulator-always-on;
+};
diff --git a/arch/arm64/boot/dts/qcom/kalambo-microsoft-surface-pro-12in-2nd-edition.dts b/arch/arm64/boot/dts/qcom/kalambo-microsoft-surface-pro-12in-2nd-edition.dts
new file mode 100644
index 0000000..50f682b
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/kalambo-microsoft-surface-pro-12in-2nd-edition.dts
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Microsoft Surface Pro 12-inch (2nd Edition), models 2148 and 2149, with
+ * the 6-core Snapdragon X2 Plus X2P-42-100 (Kalambo).
+ *
+ * Written from the ACPI tables in Microsoft's firmware download
+ * (Surface_UEFI_8.5175.155). Next to the parts kalambo-microsoft-surface.dtsi
+ * shares with the Surface Laptop 13-inch (2nd Edition), the tablet has a
+ * touchscreen whose address depends on the board ID (MSHW0824 at 0x16 or
+ * MSHW0826 at 0x41) and volume buttons. It has neither the multiport nor
+ * the USB 2.0 controller (ACPI USB3 and USB4 _STA 0); the type cover is
+ * reached through the Surface Serial Hub.
+ *
+ * Its storage is UFS (INA4230 channels STORAGE_UFS_1P2V and
+ * STORAGE_UFS_2P5V), which glymur.dtsi does not describe yet.
+ *
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+/dts-v1/;
+
+#include "kalambo.dtsi"
+#include "kalambo-microsoft-surface.dtsi"
+
+/ {
+	model = "Microsoft Surface Pro 12in 2nd Edition";
+	compatible = "microsoft,surface-pro-12in-2nd-edition", "qcom,kalambo";
+	chassis-type = "tablet";
+
+	/*
+	 * ACPI MSBT (MSHW0040) lists PM01 pins 0x72 and 0x208 for the volume
+	 * buttons. The ACPI tables of the reference design list the same two
+	 * pins, and glymur-crd.dtsi has volume up on PMH0101 GPIO 6 and volume
+	 * down on RESIN.
+	 */
+	gpio-keys {
+		pinctrl-0 = <&hall_int_n_default>, <&key_vol_up_default>;
+
+		key-volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pmh0101_gpios 6 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+
+	/*
+	 * The touchscreen's power table (\_SB.PEP0.LIXC, device \_SB.ITCH):
+	 * D0 drives TLMM 49 and then TLMM 38 high, waits 5 ms, drives TLMM 48
+	 * high and waits 150 ms. D3 drives 49 and 38 low, waits 50 ms and
+	 * drives 48 low.
+	 */
+	vreg_ts_49: regulator-touchscreen-49 {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VREG_TS_49";
+
+		gpio = <&tlmm 49 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		pinctrl-0 = <&ts_pwr_en_49>;
+		pinctrl-names = "default";
+
+		regulator-boot-on;
+	};
+
+	vreg_ts: regulator-touchscreen {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VREG_TS";
+
+		gpio = <&tlmm 38 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <5000>;
+		off-on-delay-us = <50000>;
+
+		vin-supply = <&vreg_ts_49>;
+
+		pinctrl-0 = <&ts_pwr_en>;
+		pinctrl-names = "default";
+
+		regulator-boot-on;
+	};
+};
+
+/*
+ * ACPI \_SB.ITCH on I2C9 at 400 kHz, HID descriptor register 1 (its _DSM
+ * function 1 returns 1), interrupt GIO0 virtual pin 0x400 level low: the
+ * thirteenth interrupt after the four summary interrupts of GIO0._CRS,
+ * GSIV 0x103d, is SPI 4125, PDC pin 192, TLMM 43. _INI sets the address
+ * from the board ID (TBID): 0x16 (MSHW0824) for 0x0c and 0x0e, 0x41
+ * (MSHW0826) for 0x09, 0x0a and 0x0d. Both are described; i2c-hid gives up
+ * on the absent one before it asks for the interrupt. Neither node owns
+ * the reset line, TLMM 48, which the hog below holds high.
+ */
+&i2c8 {
+	touchscreen@16 {
+		compatible = "hid-over-i2c";
+		reg = <0x16>;
+		hid-descr-addr = <0x1>;
+		interrupts-extended = <&tlmm 43 IRQ_TYPE_LEVEL_LOW>;
+
+		vdd-supply = <&vreg_ts>;
+		post-power-on-delay-ms = <150>;
+
+		wakeup-source;
+	};
+
+	touchscreen@41 {
+		compatible = "hid-over-i2c";
+		reg = <0x41>;
+		hid-descr-addr = <0x1>;
+		interrupts-extended = <&tlmm 43 IRQ_TYPE_LEVEL_LOW>;
+
+		vdd-supply = <&vreg_ts>;
+		post-power-on-delay-ms = <150>;
+
+		wakeup-source;
+	};
+};
+
+&pmh0101_gpios {
+	key_vol_up_default: key-vol-up-default-state {
+		pins = "gpio6";
+		function = "normal";
+		output-disable;
+		bias-pull-up;
+	};
+};
+
+&pon_resin {
+	linux,code = <KEY_VOLUMEDOWN>;
+
+	status = "okay";
+};
+
+&remoteproc_adsp {
+	firmware-name = "qcom/kalambo/Microsoft/Surface12/qcadsp8480.mbn",
+			"qcom/kalambo/Microsoft/Surface12/adsp_dtbs.elf";
+
+	status = "okay";
+};
+
+&remoteproc_cdsp {
+	firmware-name = "qcom/kalambo/Microsoft/Surface12/qccdsp8480.mbn",
+			"qcom/kalambo/Microsoft/Surface12/cdsp_dtbs.elf";
+
+	status = "okay";
+};
+
+&tlmm {
+	pinctrl-0 = <&ts_int_n>;
+	pinctrl-names = "default";
+
+	ts-reset-n-hog {
+		gpio-hog;
+		gpios = <48 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "touchscreen-reset-n";
+	};
+
+	ts_int_n: ts-int-n-state {
+		pins = "gpio43";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	ts_pwr_en: ts-pwr-en-state {
+		pins = "gpio38";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	ts_pwr_en_49: ts-pwr-en-49-state {
+		pins = "gpio49";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/kalambo-microsoft-surface.dtsi b/arch/arm64/boot/dts/qcom/kalambo-microsoft-surface.dtsi
new file mode 100644
index 0000000..21b0b5c
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/kalambo-microsoft-surface.dtsi
@@ -0,0 +1,838 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Parts shared by the Microsoft Surface devices with the 6-core Snapdragon
+ * X2 Plus X2P-42-100 (Kalambo): Surface Laptop 13-inch (2nd Edition) and
+ * Surface Pro 12-inch (2nd Edition).
+ *
+ * The PEP power tables of both devices' ACPI tables are the Surface Laptop
+ * 8's (Mahua) rail for rail, and their SoC side devices (Surface Serial Hub
+ * on UR23, Bluetooth on UR15, Wi-Fi on PCI4, the eDP pins, the speaker
+ * amplifier pins) sit where the Surface Laptop 8's do. The SoC wiring is
+ * therefore the one glymur-microsoft-surface-laptop8.dts describes, without
+ * its USB4 routers: both devices' ACPI tables disable the USB4 router
+ * device (UBF0).
+ *
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+#include "pmcx0102.dtsi"
+#include "pmh0101.dtsi"
+#include "pmh0110-glymur.dtsi"
+#include "pmk8850.dtsi"
+#include "smb2370.dtsi"
+
+#include <dt-bindings/input/gpio-keys.h>
+#include <dt-bindings/input/input.h>
+
+/* As mahua-crd.dts: one pmcx0102 die on SPMI0. */
+/delete-node/ &pmcx0102_d_e0;
+/delete-node/ &pmcx0102_d0_thermal;
+
+/ {
+	aliases {
+		i2c8 = &i2c8;
+
+		serial0 = &uart21;
+		serial1 = &uart14;
+	};
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pmk8850_pwm 0 5118750>;
+
+		pinctrl-0 = <&edp_bl_pwm>;
+		pinctrl-names = "default";
+	};
+
+	clocks {
+		sleep_clk: sleep-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <32000>;
+			#clock-cells = <0>;
+		};
+
+		xo_board: xo-board {
+			compatible = "fixed-clock";
+			clock-frequency = <38400000>;
+			#clock-cells = <0>;
+		};
+	};
+
+	/*
+	 * ACPI \_SB.GIO0.LIDR reads TLMM 2 and \_SB.LIGE takes its wake
+	 * interrupt from it on both edges. On the tablet it is the type
+	 * cover's Hall sensor.
+	 */
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&hall_int_n_default>;
+		pinctrl-names = "default";
+
+		switch-lid {
+			label = "lid";
+			gpios = <&tlmm 2 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;
+			wakeup-source;
+		};
+	};
+
+	pmic-glink {
+		compatible = "qcom,glymur-pmic-glink",
+			     "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		connector@0 {
+			compatible = "usb-c-connector";
+			reg = <0>;
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					pmic_glink_hs_in: endpoint {
+						remote-endpoint = <&usb_0_dwc3_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+
+					pmic_glink_ss_in: endpoint {
+						remote-endpoint = <&usb_0_qmpphy_out>;
+					};
+				};
+			};
+		};
+
+		connector@1 {
+			compatible = "usb-c-connector";
+			reg = <1>;
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					pmic_glink_hs_in1: endpoint {
+						remote-endpoint = <&usb_1_dwc3_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+
+					pmic_glink_ss_in1: endpoint {
+						remote-endpoint = <&usb_1_qmpphy_out>;
+					};
+				};
+			};
+		};
+	};
+
+	reserved-memory {
+		linux,cma {
+			compatible = "shared-dma-pool";
+			size = <0x0 0x10000000>;
+			reusable;
+			linux,cma-default;
+		};
+	};
+
+	/* ACPI GPU0 power table: TLMM 70 on for the panel */
+	vreg_edp: regulator-edp {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VREG_EDP_3P3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+
+		gpio = <&tlmm 70 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		vin-supply = <&vreg_l8b_e0>;
+
+		pinctrl-0 = <&edp_pwr_en>;
+		pinctrl-names = "default";
+
+		regulator-boot-on;
+	};
+
+	/*
+	 * The two WSA8845 amplifiers and two DMICs of the Surface Laptop 8,
+	 * whose topology this names: the ACPI audio pins (AUCD, TLMM 204 and
+	 * 205) are the Surface Laptop 8's.
+	 */
+	sound {
+		compatible = "qcom,glymur-sndcard";
+		model = "GLYMUR-Microsoft-Surface-Laptop-8";
+		audio-routing = "SpkrLeft IN", "WSA WSA_SPK1 OUT",
+				"SpkrRight IN", "WSA WSA_SPK2 OUT",
+				"VA DMIC0", "vdd-micb",
+				"VA DMIC1", "vdd-micb";
+
+		wsa-dai-link {
+			link-name = "WSA Playback";
+
+			cpu {
+				sound-dai = <&q6apmbedai WSA_CODEC_DMA_RX_0>;
+			};
+
+			codec {
+				sound-dai = <&surface_spkr0>, <&surface_spkr1>,
+					    <&swr0 0>, <&lpass_wsamacro 0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
+		va-dai-link {
+			link-name = "VA Capture";
+
+			cpu {
+				sound-dai = <&q6apmbedai VA_CODEC_DMA_TX_0>;
+			};
+
+			codec {
+				sound-dai = <&lpass_vamacro 0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+	};
+
+	/*
+	 * ACPI QPPX drives TLMM 117 (Wi-Fi enable) and BTH0 TLMM 116
+	 * (Bluetooth enable), the Surface Laptop 8's pins.
+	 */
+	/*
+	 * The Wi-Fi module's main supply. The tables name its INA4230 channel
+	 * (WIFI_3P8V) but switch it with no GPIO, so it is always on.
+	 */
+	vreg_wcn_3p8: regulator-wcn-3p8 {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VREG_WCN_3P8";
+		regulator-min-microvolt = <3800000>;
+		regulator-max-microvolt = <3800000>;
+
+		regulator-always-on;
+	};
+
+	wlan-connector {
+		compatible = "pcie-m2-e-connector";
+		vpcie3v3-supply = <&vreg_wcn_3p8>;
+		vpcie1v8-supply = <&vreg_l15b_e0>;
+
+		w-disable1-gpios = <&tlmm 117 GPIO_ACTIVE_LOW>;
+		w-disable2-gpios = <&tlmm 116 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&wcn_wlan_bt_en>;
+		pinctrl-names = "default";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				m2_e_pcie_ep: endpoint@0 {
+					reg = <0>;
+					remote-endpoint = <&pcie4_port0_ep>;
+				};
+			};
+
+			port@3 {
+				reg = <3>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				m2_e_uart_ep: endpoint@0 {
+					reg = <0>;
+					remote-endpoint = <&uart14_ep>;
+				};
+			};
+		};
+	};
+};
+
+/* The PEP rails are the Surface Laptop 8's, and so are these regulators. */
+&apps_rsc {
