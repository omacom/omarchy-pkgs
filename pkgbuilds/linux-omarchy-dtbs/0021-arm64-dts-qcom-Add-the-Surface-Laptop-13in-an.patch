+
+/* ACPI UR15 @ 0xa98000: Bluetooth (BTH0) */
+&uart14 {
+	status = "okay";
+
+	port {
+		uart14_ep: endpoint {
+			remote-endpoint = <&m2_e_uart_ep>;
+		};
+	};
