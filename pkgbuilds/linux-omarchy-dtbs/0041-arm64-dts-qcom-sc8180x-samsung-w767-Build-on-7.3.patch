From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Mon, 16 Nov 2026 02:09:37 +0100
Subject: [PATCH 2/2] arm64: dts: qcom: sc8180x-samsung-w767: Build on 7.3

The tree was written against an older sc8180x.dtsi. In 7.3 the
multiport USB PHYs are labelled usb_mp_hsphy0, usb_mp_hsphy1,
usb_mp_qmpphy0 and usb_mp_qmpphy1, so use those names.

7.3's sc8180x.dtsi also reserves gpu_mem at 0x98715000, inside this
board's adsp_mem, and the board defines a gpu_mem of its own. Delete
the SoC's region first, as the Primus and Surface Pro X trees do.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 arch/arm64/boot/dts/qcom/sc8180x-samsung-w767.dts | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sc8180x-samsung-w767.dts b/arch/arm64/boot/dts/qcom/sc8180x-samsung-w767.dts
index 18affad..d5376e2 100644
--- a/arch/arm64/boot/dts/qcom/sc8180x-samsung-w767.dts
+++ b/arch/arm64/boot/dts/qcom/sc8180x-samsung-w767.dts
@@ -10,6 +10,8 @@
 #include "sc8180x.dtsi"
 #include "sc8180x-pmics.dtsi"
 
+/delete-node/ &gpu_mem;
+
 / {
 	model = "Samsung Galaxy Book S";
 	compatible = "samsung,w767", "qcom,sc8180x";
@@ -1008,27 +1010,27 @@
 	vdda-pll-supply = <&vreg_l3c_1p2>;
 };
 
-&usb_mp0_hsphy {
+&usb_mp_hsphy0 {
 	status = "okay";
 	vdda-pll-supply = <&vreg_l5e_0p88>;
 	vdda18-supply = <&vreg_l12a_1p8>;
 	vdda33-supply = <&vreg_l16e_3p0>;
 };
 
-&usb_mp1_hsphy {
+&usb_mp_hsphy1 {
 	status = "okay";
 	vdda-pll-supply = <&vreg_l5e_0p88>;
 	vdda18-supply = <&vreg_l12a_1p8>;
 	vdda33-supply = <&vreg_l16e_3p0>;
 };
 
-&usb_mp0_qmpphy {
+&usb_mp_qmpphy0 {
 	status = "okay";
 	vdda-phy-supply = <&vreg_l3c_1p2>;
 	vdda-pll-supply = <&vreg_l5e_0p88>;
 };
 
-&usb_mp1_qmpphy {
+&usb_mp_qmpphy1 {
 	status = "okay";
 	vdda-phy-supply = <&vreg_l3c_1p2>;
 	vdda-pll-supply = <&vreg_l5e_0p88>;
-- 
