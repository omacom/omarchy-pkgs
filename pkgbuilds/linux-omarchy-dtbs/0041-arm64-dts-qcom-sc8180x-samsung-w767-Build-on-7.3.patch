From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Mon, 16 Nov 2026 02:09:37 +0100
Subject: [PATCH 2/2] arm64: dts: qcom: sc8180x-samsung-w767: Build on 7.3

The tree was written against an older sc8180x.dtsi. In 7.3 the
multiport USB PHYs are labelled usb_mp_hsphy0, usb_mp_hsphy1,
usb_mp_qmpphy0 and usb_mp_qmpphy1, so use those names.

7.3's sc8180x.dtsi also reserves gpu_mem at 0x98715000, inside this
board's adsp_mem, and the board defines a gpu_mem of its own. Delete
the SoC's region first, as the Primus and Surface Pro X trees do.

The PMC8180 A and C regulator nodes name two parent supplies without
the -supply suffix, vdd-l3-l4-l5-l18 and vdd-l9-l10, so the regulator
core never links them to their parents. Add the suffix, as the PMC8180
E node and the Primus and Flex 5G trees have it.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 arch/arm64/boot/dts/qcom/sc8180x-samsung-w767.dts | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sc8180x-samsung-w767.dts b/arch/arm64/boot/dts/qcom/sc8180x-samsung-w767.dts
index 18affad..1e719be 100644
--- a/arch/arm64/boot/dts/qcom/sc8180x-samsung-w767.dts
+++ b/arch/arm64/boot/dts/qcom/sc8180x-samsung-w767.dts
@@ -10,6 +10,8 @@
 #include "sc8180x.dtsi"
 #include "sc8180x-pmics.dtsi"
 
+/delete-node/ &gpu_mem;
+
 / {
 	model = "Samsung Galaxy Book S";
 	compatible = "samsung,w767", "qcom,sc8180x";
@@ -121,7 +123,7 @@
 		vdd-s5-supply = <&vph_pwr>;
 		vdd-l1-l8-l11-supply = <&vreg_s6c_1p35>;
 		vdd-l2-l10-supply = <&vreg_bob>;
-		vdd-l3-l4-l5-l18 = <&vreg_s7c_0p93>;
+		vdd-l3-l4-l5-l18-supply = <&vreg_s7c_0p93>;
 		vdd-l6-l9-supply = <&vreg_s6c_1p35>;
 		vdd-l7-l12-l14-l15-supply = <&vreg_s5a_2p0>;
 		vdd-l13-l16-l17-supply = <&vreg_bob>;
@@ -237,7 +239,7 @@
 		vdd-l2-l3-supply = <&vreg_s6c_1p35>;
 		vdd-l4-l5-l6-supply = <&vreg_bob>;
 		vdd-l7-l11-supply = <&vreg_bob>;
-		vdd-l9-l10 = <&vreg_bob>;
+		vdd-l9-l10-supply = <&vreg_bob>;
 		vdd-bob-supply = <&vph_pwr>;
 
 		vreg_s6c_1p35: smps6 {
@@ -1008,27 +1010,27 @@
 	vdda-pll-supply = <&vreg_l3c_1p2>;
 };
 
-&usb_mp0_hsphy {
+&usb_mp_hsphy0 {
 	status = "okay";
 	vdda-pll-supply = <&vreg_l5e_0p88>;
 	vdda18-supply = <&vreg_l12a_1p8>;
 	vdda33-supply = <&vreg_l16e_3p0>;
 };
 
-&usb_mp1_hsphy {
+&usb_mp_hsphy1 {
 	status = "okay";
 	vdda-pll-supply = <&vreg_l5e_0p88>;
 	vdda18-supply = <&vreg_l12a_1p8>;
 	vdda33-supply = <&vreg_l16e_3p0>;
 };
 
-&usb_mp0_qmpphy {
+&usb_mp_qmpphy0 {
 	status = "okay";
 	vdda-phy-supply = <&vreg_l3c_1p2>;
 	vdda-pll-supply = <&vreg_l5e_0p88>;
 };
 
-&usb_mp1_qmpphy {
+&usb_mp_qmpphy1 {
 	status = "okay";
 	vdda-phy-supply = <&vreg_l3c_1p2>;
 	vdda-pll-supply = <&vreg_l5e_0p88>;
-- 
