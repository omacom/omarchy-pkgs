From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Caleb E." <158400752+FoxesRCool1@users.noreply.github.com>
Date: Sun, 22 Nov 2026 16:09:47 +0800
Subject: [PATCH] arm64: dts: qcom: romulus13: add the QSPI touchpad

The Surface Laptop 7 13.8" touchpad is the same HID-over-SPI device as
the 15" one (045E:0C77) on the same bus: spi19 in QSPI mode, interrupt
on GPIO 3, supply enabled by GPIO 65, reset on GPIO 120. Patch 0001
describes it only in the 15" tree, so the 13.8" has no touchpad under
Linux. The ELLX kernel, on which a 13.8" owner reports a working
touchpad, carries the identical node in the shared romulus dtsi.

Add the same bus and touchpad node to the 13.8" tree.

Tested on the Surface Laptop 7 13.8" (X1E80100) from a hw-test boot
entry on linux-omarchy 7.3.0-75: the node probes, enumerates as
045E:0C77 with hid-multitouch and no SPI bus errors, and Hyprland lists
the touchpad. The pointer moves and clicks once the EC has its posture
events enabled (TC 0x01, CID 0x0b, payload 26 01 26 00 00, as Windows'
SurfaceHotPlug sends at boot). Without that the EC keeps the pad
silent after setup. That part is a separate change, outside the
device tree.
---
 .../dts/qcom/x1e80100-microsoft-romulus13.dts | 91 +++++++++++++++++++
 1 file changed, 91 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus13.dts b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus13.dts
index eb7580d..f8fb436 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus13.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus13.dts
@@ -5,9 +5,100 @@
 
 /dts-v1/;
 
+#include <dt-bindings/dma/qcom-gpi.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
 #include "x1e80100-microsoft-romulus.dtsi"
 
 / {
 	model = "Microsoft Surface Laptop 7 (13.8 inch)";
 	compatible = "microsoft,romulus13", "qcom,x1e80100";
+
+	vreg_ts_5p0: regulator-ts-5p0 {
+		compatible = "regulator-fixed";
+
+		regulator-name = "vreg_ts_5p0";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+
+		gpio = <&tlmm 65 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		regulator-boot-on;
+		startup-delay-us = <500000>;
+	};
+};
+
+&gpi_dma2 {
+	status = "okay";
+};
+
+&spi19 {
+	compatible = "qcom,geni-qspi";
+	dmas = <&gpi_dma2 0 3 QCOM_GPI_QSPI>,
+	       <&gpi_dma2 1 3 QCOM_GPI_QSPI>;
+	dma-names = "tx", "rx";
+	pinctrl-0 = <&qup_qspi19_data_clk>, <&qup_qspi19_cs>,
+		    <&qup_qspi19_data23>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	touchpad@0 {
+		compatible = "hid-over-spi";
+		reg = <0>;
+		spi-max-frequency = <20000000>;
+
+		interrupts-extended = <&tlmm 3 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&tlmm 120 GPIO_ACTIVE_LOW>;
+		vdd-supply = <&vreg_ts_5p0>;
+
+		pinctrl-0 = <&touchpad_int>, <&touchpad_reset>;
+		pinctrl-names = "default";
+
+		input-report-header-address = <0x1000>;
+		input-report-body-address = <0x1004>;
+		output-report-address = <0x2000>;
+		read-opcode = /bits/ 8 <0xeb>;
+		write-opcode = /bits/ 8 <0xe2>;
+		hid-over-spi-flags = <0xa000>;
+	};
+};
+
+&tlmm {
+	qup_qspi19_cs: qup-qspi19-cs-state {
+		pins = "gpio79";
+		function = "qup2_se3";
+		drive-strength = <6>;
+		bias-pull-down;
+	};
+
+	qup_qspi19_data_clk: qup-qspi19-data-clk-state {
+		/* IO0, IO1, CLK */
+		pins = "gpio76", "gpio77", "gpio78";
+		function = "qup2_se3";
+		drive-strength = <6>;
+		bias-pull-down;
+	};
+
+	qup_qspi19_data23: qup-qspi19-data23-state {
+		/* IO2, IO3 */
+		pins = "gpio66", "gpio67";
+		function = "qup2_se3";
+		drive-strength = <6>;
+		bias-pull-down;
+	};
+
+	touchpad_int: touchpad-int-state {
+		pins = "gpio3";
+		function = "gpio";
+		output-disable;
+		bias-pull-up;
+	};
+
+	touchpad_reset: touchpad-reset-state {
+		pins = "gpio120";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+	};
 };
-- 
2.56.1

