From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Gassner <42lizard@42lizard.dev>
Date: Thu, 12 Nov 2026 18:47:19 +0100
Subject: [PATCH] arm64: dts: qcom: x1e80100-dell-xps13-9345: Select Dell
 channel map

Select the Dell-specific machine-driver configuration for the
right-first speaker wiring. Keep the original amplifier prefixes
and DAPM routes; changing those names alone did not correct PCM
channel assignment in a clean-boot hardware test.

Based on Abel Vesa's Dell sound-card RFC.
Link: https://lkml.iu.edu/2510.2/09944.html
Signed-off-by: Oliver Gassner <42lizard@42lizard.dev>
---
 arch/arm64/boot/dts/qcom/x1e80100-dell-xps13-9345.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-dell-xps13-9345.dts b/arch/arm64/boot/dts/qcom/x1e80100-dell-xps13-9345.dts
index db3132f..29ebfb5 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-dell-xps13-9345.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-dell-xps13-9345.dts
@@ -152,7 +152,7 @@
 	};
 
 	sound {
-		compatible = "qcom,x1e80100-sndcard";
+		compatible = "dell,xps13-9345-sndcard";
 		model = "X1E80100-Dell-XPS-13-9345";
 		audio-routing = "WooferLeft IN", "WSA WSA_SPK1 OUT",
 				"TweeterLeft IN", "WSA WSA_SPK2 OUT",
-- 
2.56.0


