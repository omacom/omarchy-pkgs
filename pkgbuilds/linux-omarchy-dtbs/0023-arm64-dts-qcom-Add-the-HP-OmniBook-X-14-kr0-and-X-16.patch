From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Sun, 15 Nov 2026 12:00:00 +0000
Subject: [PATCH] arm64: dts: qcom: Add the HP OmniBook X 14-kr0 and X 16-cp0

Add the HP OmniBook X 14 (14-kr0) and OmniBook X 16 (16-cp0) with the
Snapdragon X Plus X1P-42-100, which share board 8F45. The DSDT in HP's
BIOS update matches the OmniBook 5 14-he0's in every device resource,
power vote and wake pin, and HP's audio DSP driver binds on both boards,
so one board file on the OmniBook 5's tree serves both sizes: keyboard,
touchpad, touchscreen on touch models, lid, Wi-Fi, NVMe, USB and sound,
with the firmware from the board's own driver pack.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 .../dts/qcom/x1p42100-hp-omnibook-x-8f45.dtsi | 48 +++++++++++++++++++
 .../dts/qcom/x1p42100-hp-omnibook-x14-kr0.dts | 14 ++++++
 .../dts/qcom/x1p42100-hp-omnibook-x16-cp0.dts | 14 ++++++
 3 files changed, 76 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-x-8f45.dtsi
 create mode 100644 arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-x14-kr0.dts
 create mode 100644 arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-x16-cp0.dts

diff --git a/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-x-8f45.dtsi b/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-x-8f45.dtsi
new file mode 100644
index 0000000..bb193f4
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-x-8f45.dtsi
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * HP OmniBook X 14 (14-kr0xxx) and OmniBook X 16 (16-cp0xxx), the 2025
+ * models with the Snapdragon X Plus X1P-42-100 (Purwa) on board 8F45.
+ *
+ * Both sizes share board 8F45, HP's driver pack sp172628 and one BIOS
+ * (Insyde F.03). The DSDT in that BIOS matches the OmniBook 5 14-he0's
+ * (board 8E33) in every device resource, every PEP power vote and every
+ * wake interrupt: the keyboard on I2C1 at 0x3a (TLMM 67), the touchpad on
+ * I2C3 at 0x15 (TLMM 3), the touchscreen on I2C9 at 0x10 or 0x5d (TLMM
+ * 51), the lid on TLMM 92, Wi-Fi on PCIe 4, NVMe on PCIe 6a, the USB
+ * controllers and their repeater resets, the sound pins and the eDP power
+ * sequence. Its panel list holds the same four Samsung OLED panels, and
+ * HP's ADSP driver binds on both boards (SUBSYS_8F45103C and
+ * SUBSYS_8E33103C). So the boards start from the OmniBook 5's tree.
+ *
+ * GpioInt pins of 0x100 and up are virtual: pin 0x100 + 0x40 * k is the
+ * k-th interrupt after the four summary interrupts in GIO0._CRS, which
+ * qcom,pdc-ranges and the X1 PDC map turn into TLMM pins. This gives
+ * 0x180 TLMM 67 (keyboard), 0x3C0 TLMM 3 (touchpad), 0x340 TLMM 92 (lid)
+ * and 0x240 TLMM 148, 0x2C0 TLMM 154 (PCIe 4 and 6a wake), the pins the
+ * OmniBook 5 tree uses.
+ *
+ * The DSDT tells the two sizes apart only through values the firmware
+ * fills in at boot (SPID for the touchpad model and the thermal limits,
+ * SKID for the touchscreen, PLID for the panel), none of which changes a
+ * node here.
+ */
+
+#include "x1p42100-hp-omnibook-5.dts"
+
+/*
+ * HP-signed images from sp172628 (qcdx8380, qcsubsys_ext_adsp8380,
+ * qcnspmcdm_ext_cdsp8380).
+ */
+&gpu_zap_shader {
+	firmware-name = "qcom/x1p42100/hp/omnibook-x16-cp0/qcdxkmsucpurwa.mbn";
+};
+
+&remoteproc_adsp {
+	firmware-name = "qcom/x1p42100/hp/omnibook-x16-cp0/qcadsp8380.mbn",
+			"qcom/x1p42100/hp/omnibook-x16-cp0/adsp_dtbs.elf";
+};
+
+&remoteproc_cdsp {
+	firmware-name = "qcom/x1p42100/hp/omnibook-x16-cp0/qccdsp8380.mbn",
+			"qcom/x1p42100/hp/omnibook-x16-cp0/cdsp_dtbs.elf";
+};
diff --git a/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-x14-kr0.dts b/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-x14-kr0.dts
new file mode 100644
index 0000000..09efdb3
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-x14-kr0.dts
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * HP OmniBook X 14 (14-kr0xxx), Snapdragon X Plus X1P-42-100.
+ *
+ * Board 8F45, BIOS F.03. The board is described in
+ * x1p42100-hp-omnibook-x-8f45.dtsi.
+ */
+
+#include "x1p42100-hp-omnibook-x-8f45.dtsi"
+
+/ {
+	model = "HP OmniBook X Laptop 14-kr0xxx";
+	compatible = "hp,omnibook-x14-kr0", "qcom,x1p42100";
+};
diff --git a/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-x16-cp0.dts b/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-x16-cp0.dts
new file mode 100644
index 0000000..c0eab80
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-x16-cp0.dts
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * HP OmniBook X 16 (16-cp0xxx), Snapdragon X Plus X1P-42-100.
+ *
+ * Board 8F45, BIOS F.03. The board is described in
+ * x1p42100-hp-omnibook-x-8f45.dtsi.
+ */
+
+#include "x1p42100-hp-omnibook-x-8f45.dtsi"
+
+/ {
+	model = "HP OmniBook X Laptop 16-cp0xxx";
+	compatible = "hp,omnibook-x16-cp0", "qcom,x1p42100";
+};
