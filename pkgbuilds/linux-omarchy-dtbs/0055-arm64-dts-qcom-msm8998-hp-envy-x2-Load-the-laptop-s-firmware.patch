From 6061e44b10680083fd75241de0dabb0641ad637d Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Mon, 16 Nov 2026 19:56:34 +0100
Subject: [PATCH] arm64: dts: qcom: msm8998-hp-envy-x2: Load the laptop's DSP
 and video firmware

The Envy x2's tree enables none of its DSPs and names no firmware, so its
audio, sensors and modem stay off and video decoding has no firmware. Its
DSDT has the audio DSP (ADSP), the sensor DSP (SCSS) and the modem (AMSS),
as the Miix 630's has, so enable the ADSP and SLPI and give them, the
modem and Venus the images HP ships for this laptop, as the Miix 630's tree
does for Lenovo's.

HP's Windows Update bundle for the laptop (200.0.5.0) signs these with its
own SecImage root. Its plain qcslpi8998.mbn and the modem's _CLS_P2 images
are signed with Qualcomm's test root, so the sensor DSP loads
qcslpi8998_CLS.mbn. The images go under qcom/msm8998/hp/envy-x2, where
hp-envy-x2-firmware installs them.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 .../boot/dts/qcom/msm8998-hp-envy-x2.dts      | 23 +++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8998-hp-envy-x2.dts b/arch/arm64/boot/dts/qcom/msm8998-hp-envy-x2.dts
index 38389c6..8e01297 100644
--- a/arch/arm64/boot/dts/qcom/msm8998-hp-envy-x2.dts
+++ b/arch/arm64/boot/dts/qcom/msm8998-hp-envy-x2.dts
@@ -30,3 +30,26 @@
 &sdhc2 {
 	cd-gpios = <&tlmm 95 GPIO_ACTIVE_LOW>;
 };
+
+&remoteproc_adsp {
+	firmware-name = "qcom/msm8998/hp/envy-x2/qcadsp8998.mbn";
+
+	status = "okay";
+};
+
+&remoteproc_mss {
+	firmware-name = "qcom/msm8998/hp/envy-x2/qcdsp1v28998.mbn",
+			"qcom/msm8998/hp/envy-x2/qcdsp28998.mbn";
+};
+
+&remoteproc_slpi {
+	firmware-name = "qcom/msm8998/hp/envy-x2/qcslpi8998_CLS.mbn";
+
+	status = "okay";
+};
+
+&venus {
+	firmware-name = "qcom/msm8998/hp/envy-x2/qcvss8998.mbn";
+
+	status = "okay";
+};
-- 
2.56.0

