From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Gassner <42lizard@42lizard.dev>
Date: Thu, 12 Nov 2026 18:25:16 +0100
Subject: [PATCH] arm64: dts: qcom: x1e80100-dell-xps13-9345: Correct right
 woofer route

Route the right woofer through SPK1, matching its SoundWire port map.
The tweeter retains SPK2. This reproduces the audio fragment used in
local playback testing.

This does not claim to fix the observed left/right channel reversal.
The tested desktop correction currently lives in WirePlumber.

Link: https://github.com/omacom/omarchy-pkgs/issues/2293
Signed-off-by: Oliver Gassner <42lizard@42lizard.dev>
---
 arch/arm64/boot/dts/qcom/x1e80100-dell-xps13-9345.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-dell-xps13-9345.dts b/arch/arm64/boot/dts/qcom/x1e80100-dell-xps13-9345.dts
index 7a0e342..db3132f 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-dell-xps13-9345.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-dell-xps13-9345.dts
@@ -156,7 +156,7 @@
 		model = "X1E80100-Dell-XPS-13-9345";
 		audio-routing = "WooferLeft IN", "WSA WSA_SPK1 OUT",
 				"TweeterLeft IN", "WSA WSA_SPK2 OUT",
-				"WooferRight IN", "WSA2 WSA_SPK2 OUT",
+				"WooferRight IN", "WSA2 WSA_SPK1 OUT",
 				"TweeterRight IN", "WSA2 WSA_SPK2 OUT",
 				"VA DMIC0", "vdd-micb",
 				"VA DMIC1", "vdd-micb";
-- 
2.56.0


