From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Caleb E." <158400752+FoxesRCool1@users.noreply.github.com>
Date: Sun, 22 Nov 2026 16:45:15 +0800
Subject: [PATCH 64/66] arm64: dts: qcom: romulus13: add the QSPI touchscreen

The Surface Laptop 7 13.8" touchscreen is a HID-over-SPI digitizer on
spi10, the same bus and wiring as the 15" one: interrupt on GPIO 51,
reset on GPIO 48, supply enabled by GPIO 64, IO2 and IO3 on GPIO 49 and
50. The 13.8" tree has no node for it and leaves spi10 and gpi_dma1
disabled, so the laptop has no touchscreen under Linux.

The shared romulus13/15 ACPI tables (aarch64-laptops' dump) describe
this digitizer as \_SB.GTCH on QUP1 SE2 for both sizes. Only boards
that report TBID 2 or 3 take the alternative \_SB.ITCH branch, an I2C
device at 0x34 on i2c8. This 13.8" takes the SPI branch, as does the
13.8" in linux-surface/linux-surface#1590, so the earlier note that the
13.8" has an I2C touchscreen doesn't hold for these units.

Add the bus and the node 0029 gives the 15".

Tested on the Surface Laptop 7 13.8" (X1E80100) from a hw-test boot
entry on linux-omarchy 7.3.0-75: spi1.0 (a88000.spi) probes and
enumerates as 045E:0C6E with no SPI bus errors, iptsd runs it in
touchscreen mode, and touch works.
---
 .../dts/qcom/x1e80100-microsoft-romulus13.dts | 70 +++++++++++++++++++
 1 file changed, 70 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus13.dts b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus13.dts
index f8fb436..2e35b4d 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus13.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus13.dts
@@ -27,12 +27,60 @@
 		regulator-boot-on;
 		startup-delay-us = <500000>;
 	};
+
+	vreg_touch: regulator-touch {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VREG_TOUCH";
+
+		gpio = <&tlmm 64 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <500000>;
+
+		pinctrl-0 = <&touchscreen_power_en>;
+		pinctrl-names = "default";
+	};
+};
+
+&gpi_dma1 {
+	status = "okay";
 };
 
 &gpi_dma2 {
 	status = "okay";
 };
 
+&spi10 {
+	compatible = "qcom,geni-qspi";
+	dmas = <&gpi_dma1 0 2 QCOM_GPI_QSPI>,
+	       <&gpi_dma1 1 2 QCOM_GPI_QSPI>;
+	dma-names = "tx", "rx";
+	pinctrl-0 = <&qup_spi10_data_clk>, <&qup_spi10_data2>,
+		    <&qup_spi10_cs>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	touchscreen@0 {
+		compatible = "microsoft,g6-touch-digitizer", "hid-over-spi";
+		reg = <0>;
+		spi-max-frequency = <20000000>;
+
+		interrupts-extended = <&tlmm 51 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&tlmm 48 GPIO_ACTIVE_LOW>;
+		vdd-supply = <&vreg_touch>;
+
+		pinctrl-0 = <&touchscreen_int>;
+		pinctrl-names = "default";
+
+		input-report-header-address = <0x1000>;
+		input-report-body-address = <0x1004>;
+		output-report-address = <0x2000>;
+		read-opcode = /bits/ 8 <0xeb>;
+		write-opcode = /bits/ 8 <0xe2>;
+		hid-over-spi-flags = <0xa000>;
+	};
+};
+
 &spi19 {
 	compatible = "qcom,geni-qspi";
 	dmas = <&gpi_dma2 0 3 QCOM_GPI_QSPI>,
@@ -88,6 +136,14 @@
 		bias-pull-down;
 	};
 
+	qup_spi10_data2: qup-spi10-data2-state {
+		/* IO2, IO3 */
+		pins = "gpio49", "gpio50";
+		function = "qup1_se2";
+		drive-strength = <6>;
+		bias-disable;
+	};
+
 	touchpad_int: touchpad-int-state {
 		pins = "gpio3";
 		function = "gpio";
@@ -101,4 +157,18 @@
 		drive-strength = <16>;
 		bias-disable;
 	};
+
+	touchscreen_int: touchscreen-int-state {
+		pins = "gpio51";
+		function = "gpio";
+		input-enable;
+		bias-pull-up;
+	};
+
+	touchscreen_power_en: touchscreen-power-en-state {
+		pins = "gpio64";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
 };
