# Maintainer: Vitor Bellini <bellinivitor@gmail.com>

pkgname=loft
pkgver=0.1.0
pkgrel=1
pkgdesc='Local PHP and Node sites at name.test with HTTPS, served by nginx'
arch=('x86_64' 'aarch64')
url='https://github.com/bellinivitor/loft'
license=('MIT')
install='loft.install'
options=('!debug')
depends=(
  'ca-certificates-utils'
  'hicolor-icon-theme'
  'libnotify'
  'networkmanager'
  'nginx'
  'nss'
  'openssl'
  'polkit'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
  'systemd'
  'tar'
  'xz'
)
makedepends=(
  'gcc'
  'make'
  'qt6-base'
  'qt6-declarative'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('5d8ecc4b5c8985cdf81f339d90d1de9b4b3c37d8a1913c88d61a849331b2fbc5')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/test
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/loft "$pkgdir/usr/bin/loft"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/loft.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/loft.svg"
  install -Dm644 pkgbuild/loft.desktop "$pkgdir/usr/share/applications/loft.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  # The Omarchy bar widget; `loft setup` links it into ~/.config/omarchy/plugins.
  install -Dm644 omarchy-plugin/manifest.json "$pkgdir/usr/share/loft/omarchy-plugin/manifest.json"
  install -Dm644 omarchy-plugin/Panel.qml "$pkgdir/usr/share/loft/omarchy-plugin/Panel.qml"
  install -Dm644 -t "$pkgdir/usr/share/loft/omarchy-plugin/i18n" omarchy-plugin/i18n/*.json
}
