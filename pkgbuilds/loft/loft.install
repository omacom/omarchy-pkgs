refresh_caches() {
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q
  command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
}

post_install() {
  refresh_caches
  echo "Run 'loft setup' as your user to finish: it sets up .test DNS, HTTPS and the services."
}

post_upgrade() {
  refresh_caches
}

post_remove() {
  refresh_caches
}
