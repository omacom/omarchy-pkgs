post_install() {
  # Apply the vendor policy for all users without starting or restarting anything.
  systemctl --global preset aurora-camera-denoise.service
  echo 'Camera filtering starts with the next PipeWire session.'
  echo 'For this session: systemctl --user start aurora-camera-denoise.service'
}

pre_remove() {
  systemctl --global disable aurora-camera-denoise.service
}
