pkgname=aurora-camera-denoise
pkgver=0.1.0
pkgrel=1
pkgdesc='PipeWire noise filter for built-in Apple Silicon cameras'
arch=('aarch64')
url='https://github.com/aurora-silicon/camera-denoise'
license=('MIT')
install=aurora-camera-denoise.install
depends=('glibc' 'libpipewire>=1.0' 'pipewire' 'systemd-libs')
makedepends=('meson' 'ninja' 'pkgconf' 'systemd')
_commit=a929985764bc03d1d3517c2a7e9b8dde918381b8
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
        '80-aurora-camera-denoise.preset')
sha256sums=('a64325767aff4555b6c6ca1caaded55ac814c0da474c1a47bbaf99dc81175fa0'
            '1fd38564d2dab72e06b8bd051fa22b74ce5da92c602d7b4656564845fb956038')

build() {
  arch-meson "camera-denoise-$_commit" build \
    --libdir=lib -Ddaemon=enabled \
    -Dsystemduserunitdir=/usr/lib/systemd/user
  meson compile -C build -j "${OMARCHY_BUILD_JOBS:-2}"
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir" --no-rebuild
  install -d "$pkgdir/usr/lib/aurora-camera-denoise"
  install -Dm644 "$srcdir/80-aurora-camera-denoise.preset" \
    "$pkgdir/usr/lib/systemd/user-preset/80-aurora-camera-denoise.preset"
  install -Dm644 "camera-denoise-$_commit/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "camera-denoise-$_commit/README.md" \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
}
