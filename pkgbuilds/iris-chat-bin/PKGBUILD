pkgname=iris-chat-bin
pkgver=2026.10.26.1
pkgrel=1
pkgdesc='Private messaging without a phone number (official binary)'
arch=('x86_64')
url='https://github.com/irislib/iris-chat-rs'
license=('MIT')
depends=(
  'alsa-lib'
  'cairo'
  'dbus'
  'gdk-pixbuf2'
  'glib2'
  'glibc>=2.43'
  'graphene'
  'gst-libav'
  'gst-plugin-pipewire'
  'gst-plugins-base'
  'gst-plugins-base-libs'
  'gst-plugins-good'
  'gstreamer'
  'gtk4>=4.12'
  'hicolor-icon-theme'
  'libadwaita>=1.5'
  'libgcc'
  'libstdc++'
  'libx11'
  'pango'
)
provides=("iris-chat=$pkgver")
conflicts=('iris-chat')
# Use the same tagged release bytes as the other distribution channels.
options=('!strip' '!debug')
source=(
  "$url/releases/download/v$pkgver/iris-chat-v$pkgver-linux-x64.deb"
  "iris-chat-$pkgver-LICENSE::https://raw.githubusercontent.com/irislib/iris-chat-rs/v$pkgver/LICENSE"
)
sha256sums=(
  '6c3e94a5ce21e04104ed9b316cbac25e19f4a4d86268088307e2da30c306a7f3'
  '70954af2325a592d3113724f82007b61d87f176edf2285fe44e3580115781523'
)

package() {
  # Retain the desktop entry, D-Bus activation service, icons and media notices.
  bsdtar -xf "$srcdir/data.tar.xz" -C "$pkgdir"
  # cargo-deb generated an UNLICENSED placeholder; use the tagged MIT license.
  rm "$pkgdir/usr/share/doc/iris-chat/copyright"
  install -Dm644 "$srcdir/iris-chat-$pkgver-LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
