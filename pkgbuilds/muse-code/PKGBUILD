# Maintainer: The Omarchy Authors
pkgname=muse-code
pkgver=1.4.25.r9361.1
pkgrel=1
pkgdesc="Muse Code, Meta's terminal coding agent"
arch=('x86_64' 'aarch64')
url="https://dev.meta.ai"
license=('LicenseRef-Meta-Model-API')
# The binary is statically linked; it reads the system's CA bundle for TLS.
depends=('ca-certificates')
optdepends=('git: work with repositories')
# Arch's unrelated MusE sequencer also installs /usr/bin/muse.
conflicts=('muse')
options=('!strip' '!debug')

# Upstream versions look like 1.4.25-R9361.1; the build number stays in
# pkgver so a rebuild of the same release still upgrades.
_upstream_ver="${pkgver/.r/-R}"
_download="https://lookaside.facebook.com/lookaside/muse/download/?channel=muse&version=${_upstream_ver}"
# Copied from https://dev.meta.ai/legal/terms-of-service, the terms the binary links to.
source=('Meta-Model-API-Terms')
source_x86_64=("muse-${pkgver}-x86_64::${_download}&file=muse-x86-linux")
source_aarch64=("muse-${pkgver}-aarch64::${_download}&file=muse-aarch64-linux")
sha256sums=('80a40dd28069cbf4a8527e820a1282e4e3af04d5ed6be50584093684a2e2ea97')
sha256sums_x86_64=('c1b728fb9732503c5e1869e3ad2f2c9bdb5b2638fb4cf398d6e2c46aa6d8f94a')
sha256sums_aarch64=('8fe089115ef137879fca46986d55edf18d5d3ab9cfdb6441c67e9d1807b4108a')

package() {
  # Muse Code updates itself only through the muse-launcher.sh wrapper its
  # installer sets up; the binary has no updater or update notice of its own,
  # so installed here pacman brings new releases.
  install -Dm755 "${srcdir}/muse-${pkgver}-${CARCH}" "${pkgdir}/usr/bin/muse"
  install -Dm644 Meta-Model-API-Terms "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
