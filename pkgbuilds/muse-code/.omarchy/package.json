{
  "source": "local",
  "auto_merge": true,
  "release_ring": "fast",
  "upstream": {
    "watch": {
      "regex": "https://api.meta.ai/muse-code/channels/muse-stable",
      "pattern": "\"version\"\\s*:\\s*\"(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)-R(?P<build>[0-9]+(?:\\.[0-9]+)?)\"",
      "version": "{version}.r{build}"
    }
  }
}
