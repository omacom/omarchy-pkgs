pkgname=allodia-mail-calendar
pkgver=0.17.0
pkgrel=1
pkgdesc='Mail and calendar client supporting Microsoft, Google, IMAP, JMAP, CalDAV and CardDAV'
arch=('x86_64' 'aarch64')
url='https://github.com/allodia-eu/mail-calendar'
license=('GPL-3.0-only' 'LicenseRef-Allodia-1.0')
depends=(
  'glibc' 'gcc-libs' 'gtk4>=4.22' 'libadwaita>=1.9'
  'webkitgtk-6.0>=2.52' 'hicolor-icon-theme'
)
optdepends=(
  'gnome-keyring: Secret Service for storing account credentials'
  'xdg-desktop-portal: desktop integration'
)
# Keep the vendor archive intact until package(), including its licence files.
options=('!strip' '!debug')
source_x86_64=("https://dl.allodia.eu/mailcal/linux/native/${pkgver}/${pkgname}-${pkgver}-x86_64.tar.xz")
source_aarch64=("https://dl.allodia.eu/mailcal/linux/native/${pkgver}/${pkgname}-${pkgver}-aarch64.tar.xz")
noextract=("${pkgname}-${pkgver}-${CARCH}.tar.xz")
# Checksums of the published native archives, verified against their checksum sidecars.
sha256sums_x86_64=('c0b8a0b0ea47448ab1016e169d3b20f45ccf383a7d7bba2f8edda53187e2d16b')
sha256sums_aarch64=('1b6e643b39199fb7a4d5610259b4b0c75353345b27890bb6c8d62df2a38ab3f6')

package() {
  bsdtar --no-same-owner -xpf "${srcdir}/${pkgname}-${pkgver}-${CARCH}.tar.xz" -C "$pkgdir"
}
