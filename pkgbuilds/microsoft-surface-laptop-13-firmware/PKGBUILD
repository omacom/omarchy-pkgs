# Audio DSP, compute DSP and GPU firmware for the Microsoft Surface Laptop 13-inch. The firmware
# only runs if it is signed for this board by Microsoft, so linux-firmware cannot carry it until
# the OEM submits it. The OEM ships it in its Windows driver download, which this recipe unpacks
# without running. Each file is checked against the SHA-256 it was matched to and installed under
# the name the device tree requests, compressed with xz. The kernel tries a plain name, then .zst,
# then .xz, so once linux-firmware ships the same file, its copy is the one loaded, and the two
# packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=microsoft-surface-laptop-13-firmware
pkgver=20261107
pkgrel=1
pkgdesc='Audio DSP, compute DSP and GPU firmware for the Microsoft Surface Laptop 13-inch'
arch=('aarch64')
url='https://www.microsoft.com/en-us/download/details.aspx?id=108198'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1p42100-microsoft-surfacelaptop13')
makedepends=('7zip' 'msitools')
options=('!strip' '!debug')
source=(
  'microsoft-surfacelaptop-13in-1st-edition.msi::https://download.microsoft.com/download/924f1449-b531-4e66-9fc5-870b6eb30b5e/SurfaceLaptop_13in_1st_Edition_Win11_26100_26.091.9197.0.msi'
)
noextract=('microsoft-surfacelaptop-13in-1st-edition.msi')
sha256sums=('7ca4d76e425bd7bf05403900e2505eac47bd595c9838d78ce044934ae8d2f3ae')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'microsoft-surfacelaptop-13in-1st-edition.msi' 'microsoft-surfacelaptop-13in-1st-edition' msi
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'microsoft-surfacelaptop-13in-1st-edition/SurfaceUpdate/surfaceproextadsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1p42100/Microsoft/SurfaceLaptop13/adsp_dtbs.elf'
  install -Dm644 'microsoft-surfacelaptop-13in-1st-edition/SurfaceUpdate/surfaceproextadsp8380/adspr.jsn' "$fw"/'qcom/x1p42100/Microsoft/SurfaceLaptop13/adspr.jsn'
  install -Dm644 'microsoft-surfacelaptop-13in-1st-edition/SurfaceUpdate/surfaceproextadsp8380/adsps.jsn' "$fw"/'qcom/x1p42100/Microsoft/SurfaceLaptop13/adsps.jsn'
  install -Dm644 'microsoft-surfacelaptop-13in-1st-edition/SurfaceUpdate/surfaceproextadsp8380/adspua.jsn' "$fw"/'qcom/x1p42100/Microsoft/SurfaceLaptop13/adspua.jsn'
  install -Dm644 'microsoft-surfacelaptop-13in-1st-edition/SurfaceUpdate/surfaceproextadsp8380/battmgr.jsn' "$fw"/'qcom/x1p42100/Microsoft/SurfaceLaptop13/battmgr.jsn'
  install -Dm644 'microsoft-surfacelaptop-13in-1st-edition/SurfaceUpdate/qcnspmcdmextcdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1p42100/Microsoft/SurfaceLaptop13/cdsp_dtbs.elf'
  install -Dm644 'microsoft-surfacelaptop-13in-1st-edition/SurfaceUpdate/qcnspmcdmextcdsp8380/cdspr.jsn' "$fw"/'qcom/x1p42100/Microsoft/SurfaceLaptop13/cdspr.jsn'
  install -Dm644 'microsoft-surfacelaptop-13in-1st-edition/SurfaceUpdate/surfaceproextadsp8380/qcadsp8380.mbn' "$fw"/'qcom/x1p42100/Microsoft/SurfaceLaptop13/qcadsp8380.mbn'
  install -Dm644 'microsoft-surfacelaptop-13in-1st-edition/SurfaceUpdate/qcnspmcdmextcdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1p42100/Microsoft/SurfaceLaptop13/qccdsp8380.mbn'
  install -Dm644 'microsoft-surfacelaptop-13in-1st-edition/SurfaceUpdate/qcdx8380/qcdxkmsucpurwa.mbn' "$fw"/'qcom/x1p42100/Microsoft/SurfaceLaptop13/qcdxkmsucpurwa.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
c4c01f79cdd5311dda9b624e61ee78367381b158f210f0e586ed746e1753694d  qcom/x1p42100/Microsoft/SurfaceLaptop13/adsp_dtbs.elf
e9ba7199626b0c03f2ec02822d744f678ad567fe0625a28fe5f5908b7281e9db  qcom/x1p42100/Microsoft/SurfaceLaptop13/adspr.jsn
19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e  qcom/x1p42100/Microsoft/SurfaceLaptop13/adsps.jsn
d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d  qcom/x1p42100/Microsoft/SurfaceLaptop13/adspua.jsn
b8aad1d149128f414eb1fd6fcbb6e0a5b7dabcd2cba001599e1ce9a0e2e291a4  qcom/x1p42100/Microsoft/SurfaceLaptop13/battmgr.jsn
c1e3cdeee17e61ee5f9426fef78e5e35eaf9fdd49d3d39b9bd82dcad04c71647  qcom/x1p42100/Microsoft/SurfaceLaptop13/cdsp_dtbs.elf
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x1p42100/Microsoft/SurfaceLaptop13/cdspr.jsn
0d58cc85d9afa24a0693afb1174ab011df00d9a45fadab8dddd3b624a69318a1  qcom/x1p42100/Microsoft/SurfaceLaptop13/qcadsp8380.mbn
4d2aa10aa60245177ca253d4a8f7ee15c0a0390e877efec29fa25c7d4b725568  qcom/x1p42100/Microsoft/SurfaceLaptop13/qccdsp8380.mbn
de957e0a25c2a42f417f8e95ccf1cbdfeed5a4a6d77a84e215389b8b78fc8bf4  qcom/x1p42100/Microsoft/SurfaceLaptop13/qcdxkmsucpurwa.mbn
