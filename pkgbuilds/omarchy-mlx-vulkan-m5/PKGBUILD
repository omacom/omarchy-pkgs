# Maintainer: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>

# The Vulkan driver for omarchy-mlx on M5 (G17C) only. It replaces
# omarchy-mlx-vulkan, which stays on the M1-M4 driver; omarchy-mac-ml-m5 pulls
# it in. Its mesa-git-sha names G17C, so omarchy-mlx refuses it on other GPUs
# (omarchy-mlx #637).
pkgname=omarchy-mlx-vulkan-m5
# TODO-v0.7.50: set the real pkgver when the M5 set is released; 0 keeps the
# draft unbuildable into the repo until then.
pkgver=0
pkgrel=1
pkgdesc='Honeykrisp Vulkan driver for omarchy-mlx on M5 Macs only (private ICD, draft)'
arch=('aarch64')
url='https://github.com/joshuaswarren/mesa-1'
license=('MIT AND BSD-3-Clause AND SGI-B-2.0')
groups=('omarchy-platform-apple-silicon')
# joshuaswarren/mesa-1 d4ad4a4dce6d (G509, aurora-wip lineage): its
# agx_is_native_drm_driver accepts both the "aurora" and legacy "asahi" DRM
# driver names, so it works whichever the M5 kernel reports.
# TODO-v0.7.50: re-pin to the hardware-qualified M5 Mesa build (G510) and
# refresh sha256sums before release.
_mesa_commit=d4ad4a4dce6d1d23ecd897d6d73fadf9ab618614
_mesa_sha=${_mesa_commit:0:10}
_chip=G17C
# omarchy-mlx v0.7.50 (tagged 2026-11-22) is the first release with the
# chip-binding check (#637). The pkgrel assumes the omarchy-pkgs bump lands
# at -1 as version bumps do; verify against the shipped package at publish.
_mlx_release=0.7.50-1
depends=('expat' 'gcc-libs' 'glibc' 'libdrm' 'libelf' 'llvm-libs' 'spirv-tools' 'zstd')
makedepends=('clang' 'elfutils' 'expat' 'glslang' 'libclc' 'libdrm' 'llvm' 'meson'
             'python' 'python-mako' 'python-packaging' 'python-yaml'
             'spirv-llvm-translator' 'spirv-tools' 'zstd')
provides=("omarchy-mlx-vulkan=$_mlx_release")
conflicts=('omarchy-mlx-vulkan' 'mesa-honeykrisp-omarchy')
options=('!debug' '!lto')
source=("mesa-$_mesa_commit.tar.gz::https://github.com/joshuaswarren/mesa-1/archive/$_mesa_commit.tar.gz"
        'vulkan-driver-names.sh')
sha256sums=('2669cfd6dc4b623eb361a9d8c34aea53a76c2db2518723e24979e61c580ea17b'
            'e9b50d18a6e5dfd91f3b09ed768f143594316c5934b37a08d09d5b8a1bcd8102')

build() {
  export MESA_GIT_SHA1_OVERRIDE=$_mesa_sha
  meson setup "mesa-1-$_mesa_commit" build-mesa \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=release \
    -Db_ndebug=true \
    -Dvulkan-drivers=asahi \
    -Dgallium-drivers= \
    -Dplatforms= \
    -Dvulkan-layers= \
    -Dopengl=false \
    -Dgles1=disabled \
    -Dgles2=disabled \
    -Degl=disabled \
    -Dgbm=disabled \
    -Dglx=disabled \
    -Dllvm=enabled \
    -Dshared-llvm=enabled \
    -Dvalgrind=disabled \
    -Dbuild-tests=false
  meson compile -C build-mesa
  DESTDIR="$srcdir/mesa-stage" meson install -C build-mesa
}

check() {
  source "$srcdir/vulkan-driver-names.sh"
  grep -aq "(git-$_mesa_sha)" \
    "$srcdir/mesa-stage/usr/lib/$(driver_library "$srcdir/mesa-stage/usr/lib")"
}

package() {
  source "$srcdir/vulkan-driver-names.sh"
  local dir=/usr/lib/omarchy-mlx/vulkan
  # Aurora renamed the driver to Borealis (Ryan 2026-11-20): the library and
  # the ICD manifest carry the new names. Take whichever the tree has, and
  # ship the ICD under both names so the runtime finds it either way.
  local drv_lib drv_icd
  drv_lib=$(driver_library "$srcdir/mesa-stage/usr/lib")
  drv_icd=$(driver_icd "$srcdir/mesa-stage/usr/share/vulkan/icd.d")
  install -Dm755 "$srcdir/mesa-stage/usr/lib/$drv_lib" "$pkgdir$dir/$drv_lib"
  # The ICD manifest stays out of the loader's search path; only omarchy-mlx
  # names it. library_path is absolute.
  python - "$srcdir/mesa-stage/usr/share/vulkan/icd.d/$drv_icd" \
    "$pkgdir$dir/honeykrisp_icd.aarch64.json" "$pkgdir$dir/borealis_icd.aarch64.json" \
    "$dir/$drv_lib" <<'PY'
import json, sys
src, dst_honeykrisp, dst_borealis, lib = sys.argv[1:]
manifest = json.load(open(src))
manifest["ICD"]["library_path"] = lib
for dst in (dst_honeykrisp, dst_borealis):
    with open(dst, "w") as f:
        json.dump(manifest, f, indent=4)
        f.write("\n")
PY
  chmod 644 "$pkgdir$dir/honeykrisp_icd.aarch64.json" \
    "$pkgdir$dir/borealis_icd.aarch64.json"
  printf '%s %s\n' "$_mesa_sha" "$_chip" | install -Dm644 /dev/stdin "$pkgdir$dir/mesa-git-sha"
  install -Dm644 "$srcdir/mesa-1-$_mesa_commit/docs/license.rst" \
    "$pkgdir/usr/share/licenses/$pkgname/license.rst"
}
