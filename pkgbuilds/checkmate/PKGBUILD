# Maintainer: David Heinemeier Hansson <david@hey.com>
pkgname=checkmate
pkgver=0.1.3
pkgrel=2
pkgdesc='Native 3D chess with original piece sets, local multiplayer, and a computer opponent'
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/checkmate'
license=('MIT')
options=('!debug')
depends=('hicolor-icon-theme' 'qt6-base' 'qt6-declarative' 'qt6-quick3d' 'qt6-svg' 'qt6-wayland')
makedepends=('cmake' 'gcc' 'make' 'xorg-server-xvfb')
checkdepends=('xorg-xauth' 'mesa' 'ttf-dejavu')
source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
  'qt6.12.1-qlist-append.patch'
)
sha256sums=(
  '8f204e6836f06b8b595dd7f4545c415a67ba7e9c589b0c9145d17faba0198f6b'
  '2690f302f9f8800c3863eecc99fa7ea0def854c200e99f330d7b98940a38dd0d'
)

prepare() {
  cd "$srcdir/$pkgname-$pkgver"
  # Qt 6.12.1 makes QList::append({...}) ambiguous between value and rvalue overloads.
  patch -p1 -i "$srcdir/qt6.12.1-qlist-append.patch"
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ctest --test-dir build --output-on-failure
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build --prefix /usr
}
