# Maintainer: David Heinemeier Hansson <david@hey.com>
pkgname=checkmate
pkgver=0.1.0
pkgrel=1
pkgdesc='Native 3D chess with original piece sets, local multiplayer, and a computer opponent'
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/checkmate'
license=('MIT')
options=('!debug')
depends=('hicolor-icon-theme' 'qt6-base' 'qt6-declarative' 'qt6-quick3d' 'qt6-svg' 'qt6-wayland')
makedepends=('cmake' 'gcc' 'make' 'xorg-server-xvfb')
checkdepends=('xorg-xauth' 'mesa' 'ttf-dejavu')
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('84975299504d63145e9676e1e994b11474f2f318c71b8968997405fd4200ef99')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ctest --test-dir build --output-on-failure
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build --prefix /usr
}
