[Unit]
Description=Keyboard backlight from the J313 CT720 ambient light sensor
After=systemd-backlight@leds:kbd_backlight.service
# Not enabled by the package. Other machines never start it. Device nodes
# are waited for below: a ConditionPathExists skip is not retried, and the
# CT720 can appear after this unit is first considered.
ConditionFirmware=device-tree-compatible(apple,j313)

[Service]
# About 30 s. Succeeds as soon as some iio device is named aop-sensors-als
# and kbd_backlight exists. Exits 1 (skipped, not a boot failure) otherwise.
ExecCondition=/bin/sh -c 'i=0; while [ "$i" -lt 150 ]; do als=0; for n in /sys/bus/iio/devices/iio:device*/name; do [ -r "$n" ] || continue; if /usr/bin/grep -qx aop-sensors-als "$n"; then als=1; break; fi; done; if [ "$als" = 1 ] && [ -e /sys/class/leds/kbd_backlight/brightness ]; then exit 0; fi; i=$((i + 1)); sleep 0.2; done; exit 1'
StateDirectory=ct720-kbd-light
Type=simple
ExecStart=/usr/bin/ct720-kbd-light
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
