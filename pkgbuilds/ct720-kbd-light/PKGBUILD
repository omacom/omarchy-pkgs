# Maintainer: Lucas Goossen <lucas.goossen@hey.com>
# J313 keyboard backlight. The unit is installed and not enabled.

pkgname=ct720-kbd-light
pkgver=1.0.0
pkgrel=5
pkgdesc='Keyboard backlight driven by the J313 CT720 ambient light sensor'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/omacom/omarchy-pkgs'
license=('MIT')
depends=('glibc')
makedepends=('gcc' 'make')
options=('!debug')
source=(
  'ct720-kbd-light.c'
  'Makefile'
  'ct720-kbd-light.service'
  'LICENSE'
)
sha256sums=('634dc0250d43861127e0a8681dba1b5fb1d9abce716aff7be745a027eff09bb6'
            '583548e004bab3d564a6dd9b07bb93856aae7387145fad7520157c11a694bed3'
            '5213ab4209d81dae54f7319e07df8ec20001740382f3348db4c66e07ccef4d2d'
            'f3f6f0f34f9154a439bef11a3c885df8d9e4328c7450ad7e18c6f76984c30348')

build() {
  # makepkg's LDFLAGS do not include -lm, which log() needs.
  make CFLAGS="${CFLAGS} -std=c11 -D_GNU_SOURCE -Wall -Wextra -Werror" \
       LDFLAGS="${LDFLAGS} -lm"
}

check() {
  # Must not open the sensor, the LED, or input devices.
  ./ct720-kbd-light --self-test
}

package() {
  install -Dm755 ct720-kbd-light "$pkgdir/usr/bin/ct720-kbd-light"
  install -Dm644 ct720-kbd-light.service \
    "$pkgdir/usr/lib/systemd/system/ct720-kbd-light.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/ct720-kbd-light/LICENSE"
}
