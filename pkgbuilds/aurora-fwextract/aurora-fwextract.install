#!/bin/sh

post_install() {
  printf '==> Upgrading vendor firmware package...\n'
  if ! asahi-fwupdate; then
    # omarchy-mac-boot's update-verify finishes it once the EFI system partition has room.
    mkdir -p /var/lib/omarchy/mac-boot && : >/var/lib/omarchy/mac-boot/firmware-pending
    printf '==> The vendor firmware was not upgraded; omarchy update finishes it once the EFI system partition has room\n'
    return 1
  fi
}

post_upgrade() {
  post_install
}
