# Recipe from asahi-alarm/PKGBUILDs asahi-fwextract 0.9.2-1, renamed for the Aurora stack.
pkgname=aurora-fwextract
pkgver=0.9.2
pkgrel=2
pkgdesc='Apple Silicon firmware extractor'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/asahi-alarm/asahi-alarm-installer'
license=('MIT')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
provides=("asahi-fwextract=$pkgver")
conflicts=('asahi-fwextract')
replaces=('asahi-fwextract')
install=aurora-fwextract.install
source=("asahi-alarm-installer-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "0001-wifi-collect-the-BCM4388-rev-C2-firmware.patch")
sha256sums=('2d4f049d618aa7592db0f6b0bfca1f4485bb2244c74c4d5038681b4b36e305e4'
            '638f675359fca17a0eb0c5169d00a10ac16c25bfdf05cd04c7f8eed24040d1f6')

prepare() {
  cd "asahi-alarm-installer-$pkgver"
  # M4-family Wi-Fi: keep C-4388__s-C2 (aurora-installer 34f90a5, Ryan Murray)
  patch -Np1 -i "$srcdir/0001-wifi-collect-the-BCM4388-rev-C2-firmware.patch"
}

build() {
  cd "asahi-alarm-installer-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  # Runtime only: the build environment does not have aurora-scripts or lzfse.
  depends=('python' 'aurora-scripts' 'lzfse')
  cd "asahi-alarm-installer-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
