# Maintainer: Pavel Guzhikov <apps@guzh.uk>
# Always Today's window app for Linux (packaging/linux/desktop), from the public release on guzh.uk
# (the source repository is private): the app's jars and a launcher on Arch's Java 21 or later.
# Update pkgver and the checksum from the release tarball (./gradlew :app:linuxDesktopRelease).
pkgname=always-today-desktop
_name=always-today-desktop
pkgver=1.1.1
pkgrel=1
pkgdesc="A calm to-do app: what am I doing today? The window app; syncs with the terminal, phone and Mac apps"
arch=('x86_64')
url="https://alwaystoday.uk/"
license=('LicenseRef-Always-Today' 'OFL-1.1')
# Java with AWT (not the headless one); gdbus (glib2) follows the desktop's light or dark.
depends=('java-runtime>=21' 'glib2' 'hicolor-icon-theme')
optdepends=('libnotify: reminders as desktop notifications'
            'libsecret: keep the sign-in in the system keyring instead of a private file'
            'always-today: the terminal app, which shares the same lists')
provides=("always-today-desktop-bin")
conflicts=("always-today-desktop-bin")
# A released binary, packaged as it is: no stripping, no separate debug package.
options=('!strip' '!debug')
source=("https://github.com/xternal/guzh.uk/releases/download/$_name-linux-$pkgver/$_name-$pkgver-linux-x86_64.tar.gz"
        'LICENSE' 'AtkinsonHyperlegibleNext-OFL.txt' 'Unbounded-OFL.txt')
sha256sums=('7e96dec4e075869597b4f40669febda9a38d1c696616b4c0ed90b46e4b966a8a'
            '1f4dd779d2a1f129355afbf1a0722f6b044275a8eaa009628b948a4f3a3bb7e8'
            'aca6a428580965d2297d1b718042dd427c2a9443ece3b0d02d758e161e0c4030'
            '31e5d4e83955e7103c34570dd49b0570ef490800bd65b42923c0dd02445263b3')

package() {
  cd "$_name-$pkgver"
  install -d "$pkgdir/usr/lib/$_name" "$pkgdir/usr/bin"
  cp -r --no-preserve=ownership bin lib share "$pkgdir/usr/lib/$_name/"
  # The launcher finds its jars beside itself, through the link.
  ln -s "/usr/lib/$_name/bin/$_name" "$pkgdir/usr/bin/$_name"
  sed -e "s|@EXEC@|/usr/bin/$_name|" -e "s|@ICON@|always-today|" share/always-today.desktop > always-today.desktop
  install -Dm644 always-today.desktop "$pkgdir/usr/share/applications/always-today.desktop"
  install -Dm644 share/always-today.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/always-today.svg"
  install -Dm644 share/always-today.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/always-today.png"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$srcdir/LICENSE" "$srcdir/AtkinsonHyperlegibleNext-OFL.txt" "$srcdir/Unbounded-OFL.txt"
}
