# Audio DSP, compute DSP and GPU firmware for the Microsoft Surface Pro 12-inch. The firmware only
# runs if it is signed for this board by Microsoft, so linux-firmware cannot carry it until the
# OEM submits it. The OEM ships it in its Windows driver download, which this recipe unpacks
# without running. The files are installed unmodified, under the names the device tree requests,
# and checked against the SHA-256 each was matched to.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=microsoft-surface-pro-12in-firmware
pkgver=20261102
pkgrel=1
pkgdesc='Audio DSP, compute DSP and GPU firmware for the Microsoft Surface Pro 12-inch'
arch=('aarch64')
url='https://www.microsoft.com/en-us/download/details.aspx?id=108199'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1p42100-microsoft-surface12')
makedepends=('7zip' 'msitools')
options=('!strip' '!debug')
source=(
  'microsoft-surfacepro-12in-1st-edition.msi::https://download.microsoft.com/download/3f42130f-64d6-4a85-8a18-ec1b70f5ef82/SurfacePro_12in_1st_Edition_Win11_26100_26.080.5703.0.msi'
)
noextract=('microsoft-surfacepro-12in-1st-edition.msi')
sha256sums=('99481ae6b407672b4422066abca92b3b521869b34af1fa5124b702bfa6824f0c')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'microsoft-surfacepro-12in-1st-edition.msi' 'microsoft-surfacepro-12in-1st-edition' msi
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'microsoft-surfacepro-12in-1st-edition/SurfaceUpdate/proextadsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1p42100/Microsoft/Surface12/adsp_dtbs.elf'
  install -Dm644 'microsoft-surfacepro-12in-1st-edition/SurfaceUpdate/proextadsp8380/adspr.jsn' "$fw"/'qcom/x1p42100/Microsoft/Surface12/adspr.jsn'
  install -Dm644 'microsoft-surfacepro-12in-1st-edition/SurfaceUpdate/proextadsp8380/adsps.jsn' "$fw"/'qcom/x1p42100/Microsoft/Surface12/adsps.jsn'
  install -Dm644 'microsoft-surfacepro-12in-1st-edition/SurfaceUpdate/proextadsp8380/adspua.jsn' "$fw"/'qcom/x1p42100/Microsoft/Surface12/adspua.jsn'
  install -Dm644 'microsoft-surfacepro-12in-1st-edition/SurfaceUpdate/proextadsp8380/battmgr.jsn' "$fw"/'qcom/x1p42100/Microsoft/Surface12/battmgr.jsn'
  install -Dm644 'microsoft-surfacepro-12in-1st-edition/SurfaceUpdate/qcnspmcdmextcdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1p42100/Microsoft/Surface12/cdsp_dtbs.elf'
  install -Dm644 'microsoft-surfacepro-12in-1st-edition/SurfaceUpdate/qcnspmcdmextcdsp8380/cdspr.jsn' "$fw"/'qcom/x1p42100/Microsoft/Surface12/cdspr.jsn'
  install -Dm644 'microsoft-surfacepro-12in-1st-edition/SurfaceUpdate/proextadsp8380/qcadsp8380.mbn' "$fw"/'qcom/x1p42100/Microsoft/Surface12/qcadsp8380.mbn'
  install -Dm644 'microsoft-surfacepro-12in-1st-edition/SurfaceUpdate/qcnspmcdmextcdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1p42100/Microsoft/Surface12/qccdsp8380.mbn'
  install -Dm644 'microsoft-surfacepro-12in-1st-edition/SurfaceUpdate/qcdx8380/qcdxkmsucpurwa.mbn' "$fw"/'qcom/x1p42100/Microsoft/Surface12/qcdxkmsucpurwa.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
