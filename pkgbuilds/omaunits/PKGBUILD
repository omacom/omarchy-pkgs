# Maintainer: Di Wu <wd1991610@gmail.com>

pkgname=omaunits
pkgver=1.1.0
pkgrel=1
pkgdesc='Dead-simple unit converter built with Qt Quick'
arch=('x86_64' 'aarch64')
url='https://github.com/CaptainAwesomeDi/omaunits'
license=('MIT' 'OFL-1.1')
install='omaunits.install'
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'xdg-desktop-portal'
)
makedepends=(
  'gcc'
  'make'
  'qt6-base'
  'qt6-declarative'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/CaptainAwesomeDi/omaunits/archive/refs/tags/v$pkgver.tar.gz"
        'omaunits.desktop'
        'omaunits.svg')
sha256sums=('d7db97dd8f803d938b8122a81ef59d37f375df48c77a24e37b3219672d8dc002'
            'f39bd2eb94af5d902bca4237ac8c4c839715c0eac1763661bb7e473eab1ab904'
            'b66d0a1651930acfa490a9cd81fd5ed3c2109a34034e6103230bd2d20c92e891')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/omaunits "$pkgdir/usr/bin/omaunits"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  install -Dm644 "$srcdir/omaunits.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaunits.svg"
  install -Dm644 "$srcdir/omaunits.desktop" "$pkgdir/usr/share/applications/omaunits.desktop"
}
