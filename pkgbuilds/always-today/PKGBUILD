# Maintainer: Pavel Guzhikov <apps@guzh.uk>
# Always Today for the terminal: TUI and CLI in one native binary, from the public release on guzh.uk
# (the source repository is private). Update pkgver and the checksums from that release's SHA256SUMS.
pkgname=always-today
pkgver=1.1.1
pkgrel=1
pkgdesc="A calm to-do app for the terminal: what am I doing today? (TUI and CLI, syncs with the apps)"
arch=('x86_64' 'aarch64')
url="https://alwaystoday.uk/"
license=('LicenseRef-Always-Today')
depends=('glibc' 'zlib')
optdepends=('libnotify: reminders as desktop notifications (always-today reminders --watch)'
            'libsecret: keep the sign-in in the system keyring (GNOME Keyring, KWallet, KeePassXC) instead of a private file')
provides=('always-today-bin')
conflicts=('always-today-bin')
# A released binary, packaged as it is: no stripping, no separate debug package.
options=('!strip' '!debug')
_release="https://github.com/xternal/guzh.uk/releases/download/always-today-linux-$pkgver"
source=('LICENSE')
sha256sums=('1f4dd779d2a1f129355afbf1a0722f6b044275a8eaa009628b948a4f3a3bb7e8')
source_x86_64=("$_release/always-today-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("$_release/always-today-$pkgver-linux-aarch64.tar.gz")
sha256sums_x86_64=('a6ab0e4020b7534743b019743968abafa03d4d2be1159bec4c6f388dff8ff20d')
sha256sums_aarch64=('b4e290ceba70fbdcc2d28365853cc4e8bed7cefda98bdb34f68d91590a31644f')

package() {
  cd "$srcdir/always-today-$pkgver-linux-$CARCH"
  install -Dm755 always-today "$pkgdir/usr/bin/always-today"
  # Reminders as a user service: systemctl --user enable --now always-today-reminders.service
  install -Dm644 always-today-reminders.service "$pkgdir/usr/lib/systemd/user/always-today-reminders.service"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
