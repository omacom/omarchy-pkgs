pkgname=haps-bin
pkgver=0.1.21
pkgrel=1
pkgdesc='Signed packages, content-addressed distribution and social discovery'
arch=('x86_64' 'aarch64')
url='https://haps.hashtree.cc'
license=('MIT')
depends=('bash' 'fzf' 'libgcc' 'glibc>=2.35' 'git' 'hashtree>=0.2.114' 'python')
optdepends=('bubblewrap: isolated local source builds')
provides=("haps=$pkgver")
conflicts=('haps')
options=('!strip' '!debug')
source=(
  "haps-$pkgver-LICENSE::https://raw.githubusercontent.com/mmalmi/haps/v$pkgver/LICENSE"
  'haps.desktop'
)
sha256sums=('864fb909c99adb35c3ee11a7a5de82f781e5d78f9e1c9fa83782b48ff8cfd52b' 'e1eb0266bb9cdb160c09ec34ba4719883ff96416d128115ffaa4c4d5c46f97b0')
source_x86_64=("haps-$pkgver-x86_64.tar.gz::https://github.com/mmalmi/haps/releases/download/v$pkgver/haps-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('4c783bed0974413c44c0723c30df81e544c3a53c73f1e7c4aaf18d60a873b520')
source_aarch64=("haps-$pkgver-aarch64.tar.gz::https://github.com/mmalmi/haps/releases/download/v$pkgver/haps-v$pkgver-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_aarch64=('10fc0ce18451a11e81ea80ece7d0372d1527cb3c5b8e334d902d14390f74a1bc')

package() {
  # Use the native Hashtree dependency instead of duplicating bundled helpers.
  install -Dm755 "$srcdir/haps" "$pkgdir/usr/bin/haps"
  install -Dm644 "$srcdir/haps-$pkgver-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/haps.desktop" "$pkgdir/usr/share/applications/haps.desktop"
}
