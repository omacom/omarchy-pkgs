{
  "source": "local",
  "auto_merge": true,
  "release_ring": "fast",
  "upstream": {
    "watch": {
      "regex": "https://antigravity.google/download/",
      "pattern": "https://storage\\.googleapis\\.com/antigravity-public/antigravity-hub/(?P<version>[0-9]+(?:\\.[0-9]+)+)-(?P<build>[0-9]+)/linux-x64/Antigravity\\.tar\\.gz",
      "variables": {
        "_build": "{build}"
      }
    }
  }
}
