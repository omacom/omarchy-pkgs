# Maintainer: Ryan Hughes <ryan@omarchy.org>

# Antigravity 2.0, Google's standalone agent app. The Antigravity IDE is a
# separate product. .omarchy/package.json watches Google's download page and
# rewrites pkgver, _build and the checksums below.

pkgname=antigravity
pkgver=2.33.0
pkgrel=1
_build=4731201358004224
pkgdesc='Google Antigravity 2.0 agent-first desktop app'
arch=('x86_64' 'aarch64')
url='https://antigravity.google/product/antigravity-2'
license=('LicenseRef-Google-Antigravity')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gcc-libs'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libxss'
  'libxtst'
  'libnotify'
  'libsecret'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'util-linux-libs'
  'xdg-utils'
)
makedepends=('libarchive')
options=('!strip' '!debug')
install=antigravity.install

_dl="https://storage.googleapis.com/antigravity-public/antigravity-hub/${pkgver}-${_build}"
source_x86_64=("antigravity-${pkgver}-x86_64.deb::${_dl}/linux-x64/Antigravity.deb")
source_aarch64=("antigravity-${pkgver}-aarch64.deb::${_dl}/linux-arm/Antigravity.deb")
noextract=("antigravity-${pkgver}-x86_64.deb" "antigravity-${pkgver}-aarch64.deb")
sha256sums_x86_64=('47b3a63d7f118fba595890dab3369f8df2ba139888b61a937502268336fadd25')
sha256sums_aarch64=('a338bb7b521e8d49b7a86348674725c07195db50be3fc31698c82f3812c74299')

package() {
  bsdtar -xOf "${srcdir}/antigravity-${pkgver}-${CARCH}.deb" data.tar.xz |
    bsdtar --no-same-owner -xf - -C "${pkgdir}"

  cd "${pkgdir}"

  # Turn off the built-in updater; pacman installs updates. package-type
  # tells electron-updater to fetch Google's .deb and run dpkg. Without it,
  # it falls back to its AppImage updater, which does nothing outside an
  # AppImage.
  rm opt/Antigravity/resources/{package-type,app-update.yml}

  # Ubuntu's AppArmor profile. Arch doesn't use it, and the deb's postinst
  # that copies it into /etc never runs here.
  rm opt/Antigravity/resources/apparmor-profile

  # The deb's icon is a hicolor 512px app icon. The desktop file names it
  # "antigravity", so the theme package has to be installed for the cache hook.
  if [[ ! -f usr/share/icons/hicolor/512x512/apps/antigravity.png ]]; then
    echo "antigravity: hicolor icon missing from the deb" >&2
    return 1
  fi

  install -d usr/bin
  ln -s /opt/Antigravity/antigravity usr/bin/antigravity
  sed -i 's|^Exec=/opt/Antigravity/antigravity|Exec=/usr/bin/antigravity|' \
    usr/share/applications/antigravity.desktop

  # Packaged mode is 0755. antigravity.install repeats the deb postinst on
  # the installed machine, including 4755 where user namespaces do not work.
  chmod 0755 opt/Antigravity/chrome-sandbox

  install -d "usr/share/licenses/${pkgname}"
  ln -s /opt/Antigravity/LICENSE.electron.txt /opt/Antigravity/LICENSES.chromium.html \
    -t "usr/share/licenses/${pkgname}"

  # Debian package-policy files are not used on Arch Linux.
  rm -r usr/share/doc
}
