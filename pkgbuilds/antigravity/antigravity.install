# The deb postinst decides chrome-sandbox's mode on the machine being
# installed, not in the package build. Pacman skips postinst, so this hook
# does that step. /opt/Antigravity has no space in the path, so the setuid
# helper Electron falls back to actually runs (unlike a path with a space).
#
# The probe drops to nobody first: pacman runs hooks as root, and root can
# unshare a user namespace even where unprivileged users cannot.

_userns_available() {
  [[ -L ${ANTIGRAVITY_USERNS_LINK:-/proc/self/ns/user} ]] || return 1
  # setpriv and unshare are util-linux, not util-linux-libs. Without them
  # this probe runs as root, and root can unshare even when a user cannot,
  # so the hook would leave 0755 on a machine that needs the setuid helper.
  if (( EUID == 0 )) && command -v setpriv >/dev/null; then
    setpriv --reuid=65534 --regid=65534 --clear-groups -- unshare --user true 2>/dev/null
  else
    unshare --user true 2>/dev/null
  fi
}

_apply_sandbox_mode() {
  local sandbox=${ANTIGRAVITY_SANDBOX:-/opt/Antigravity/chrome-sandbox}
  [[ -e "$sandbox" ]] || return 0
  if _userns_available; then
    chmod 0755 "$sandbox"
  else
    chmod 4755 "$sandbox"
  fi
}

post_install() {
  _apply_sandbox_mode
}

post_upgrade() {
  _apply_sandbox_mode
}
