# Maintainer: Carmine Paolino <carmine@paolino.me>

pkgname=spinel
pkgver=2026.10.25
pkgrel=1
pkgdesc='Ahead-of-time compiler for Ruby'
arch=('x86_64' 'aarch64')
url='https://github.com/matz/spinel'
license=('MIT')
# spinel compiles Ruby to C and links it with the system compiler.
depends=('gcc' 'glibc' 'libxcrypt')
makedepends=('ruby')
checkdepends=('ruby')
# Both install /usr/bin/spin.
conflicts=('spin')
options=('!debug' '!lto')
# The release archive carries the Prism and RBS parsers that `make deps`
# would otherwise download, so the build is offline.
source=("https://github.com/matz/spinel/releases/download/$pkgver/$pkgname-$pkgver.tar.xz")
sha256sums=('e13c7360e4f845b4a6b9f34a80fb6b827f950a480d1aa339e6cb25e5cb61a3b0')

build() {
  cd "$pkgname-$pkgver"
  make
}

check() {
  cd "$pkgname-$pkgver"
  # Arch's OpenSSL words the GCM tag error differently and refuses the TLS
  # handshakes these openssl package tests expect to succeed. The other
  # 8,900-odd tests run.
  local skip=(
    packages/openssl/test/openssl_cipher_gcm.rb
    packages/openssl/test/openssl_cipher_gcm_threads.rb
    packages/openssl/test/openssl_server_rsa.rb
    packages/openssl/test/openssl_ssl_server.rb
    packages/openssl/test/openssl_store_add_cert.rb
  )
  make test TEST_SKIP="${skip[*]}"
}

package() {
  cd "$pkgname-$pkgver"
  make install PREFIX="$pkgdir/usr"

  # The Makefile has no DESTDIR, so its links name the staging directory.
  local link
  for link in "$pkgdir"/usr/bin/*; do
    [[ -L $link ]] || continue
    ln -sfn "../lib/spinel/$(basename "$(readlink "$link")")" "$link"
  done

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
