# Maintainer: The Omarchy Authors
pkgname=ghui
pkgver=0.9.1
pkgrel=1
pkgdesc="Terminal UI for keeping up with your open GitHub pull requests"
arch=('x86_64' 'aarch64')
url="https://github.com/kitlangton/ghui"
license=('MIT')
# ghui reads and changes pull requests through the gh CLI.
depends=('glibc' 'github-cli')
# The binary is a Bun executable with its JavaScript appended; stripping breaks it.
options=('!strip' '!debug')
source=("LICENSE-${pkgver}::https://raw.githubusercontent.com/kitlangton/ghui/v${pkgver}/LICENSE")
source_x86_64=("ghui-${pkgver}-x86_64.tar.gz::https://github.com/kitlangton/ghui/releases/download/v${pkgver}/ghui-linux-x64.tar.gz")
source_aarch64=("ghui-${pkgver}-aarch64.tar.gz::https://github.com/kitlangton/ghui/releases/download/v${pkgver}/ghui-linux-arm64.tar.gz")
sha256sums=('4994c24b5bbb85529407e8cd0211efcf819236899d2c911cbdb18c00f231273a')
sha256sums_x86_64=('dd46f080000a3ab9a03a3fc8b14ac0449728b002875365530de5f47375f37921')
sha256sums_aarch64=('9a90264d830d1dc3388086f0e55a294364beb53c48f33e6e2e7c58a52f044c0d')

package() {
  install -Dm755 "${srcdir}/ghui" "${pkgdir}/usr/bin/ghui"
  install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
