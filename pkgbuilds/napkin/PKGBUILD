# Maintainer: Nerkyator

pkgname=napkin
pkgver=0.1.0
pkgrel=1
pkgdesc='A natural-language calculator for Linux, at home on Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/nerkyator/napkin'
license=('MIT' 'CC-BY-4.0')
options=('!debug' '!lto')
# fontconfig provides fc-match, which napkin runs to find the monospace font.
# hyprctl is used when present (window rounding, scratchpad toggle) and is
# deliberately not a dependency: napkin runs on any Wayland desktop.
# gtk4 and libadwaita carry epoch 1, so the minimums name it to mean anything;
# AdwShortcutsDialog needs libadwaita 1.8.
depends=(
  'fontconfig'
  'glib2'
  'glibc'
  'graphene'
  'gtk4>=1:4.16'
  'hicolor-icon-theme'
  'libadwaita>=1:1.8'
  'libgcc'
  'pango'
)
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('8917593da513a8d21d234c1001d40582209fe9536d88bf9d91486ae12c59b1e8')

prepare() {
  cd "$pkgname-$pkgver"

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"

  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p napkin
}

check() {
  cd "$pkgname-$pkgver"

  export CARGO_TARGET_DIR=target
  cargo test --frozen --release -p napkin-engine
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/napkin "$pkgdir/usr/bin/napkin"
  install -Dm644 packaging/napkin.desktop "$pkgdir/usr/share/applications/napkin.desktop"
  install -Dm644 packaging/napkin.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/napkin.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
