# Audio DSP, compute DSP and GPU firmware for the Acer Swift 14 AI. The firmware only runs if it
# is signed for this board by Acer, so linux-firmware cannot carry it until the OEM submits it.
# The OEM ships it in its Windows driver download, which this recipe unpacks without running. Each
# file is checked against the SHA-256 it was matched to and installed under the name the device
# tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so once
# linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=acer-swift-14-ai-firmware
pkgver=20261102
pkgrel=2
pkgdesc='Audio DSP, compute DSP and GPU firmware for the Acer Swift 14 AI'
arch=('aarch64')
url='https://www.acer.com/us-en/support/product-support/SF14-11'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1e80100-acer-sf14-11')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'acer-sf14-11-adsp-2.0.7800.0002.zip::https://global-download.acer.com/GDFiles/Driver/ADSP/ADSP_Qualcomm_2.0.7800.0002_W11ARM64_A.zip?acerid=639013789253881299&Step1=&Step2=&Step3=SWIFT%20SF14-11&OS=ALL&LC=en&BC=ACER&SC=PA_6'
  'acer-sf14-11-qualcomm-base-driver-0.7800.1.zip::https://global-download.acer.com/GDFiles/Driver/Base%20Driver/Base%20Driver_Qualcomm_0.7800.1_W11ARM64_A.zip?acerid=639013788484721142&Step1=&Step2=&Step3=SWIFT%20SF14-11&OS=ALL&LC=en&BC=ACER&SC=PA_6'
  'acer-sf14-11-multimedia-driver-31.0.96.0.zip::https://global-download.acer.com/GDFiles/Driver/Base%20Driver/Base%20Driver_Qualcomm_31.0.96.0_W11ARM64_A.zip?acerid=638838209133643191&Step1=&Step2=&Step3=SWIFT%20SF14-11&OS=ALL&LC=en&BC=ACER&SC=PA_6'
)
noextract=('acer-sf14-11-adsp-2.0.7800.0002.zip' 'acer-sf14-11-qualcomm-base-driver-0.7800.1.zip' 'acer-sf14-11-multimedia-driver-31.0.96.0.zip')
sha256sums=('a3f987de1d2c427ecf0d7e42986b6047ace7b96a642930bdd40c465aeac8c1ea' 'a47e77e77e4d5b3dcd38260afd04ba3f93febfe6358fd5c70b49d2a92eff840d' '3d55e8f45d3cb36df820514b8ec27eafa5629c92b02e6dc17d09594037a9f355')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'acer-sf14-11-adsp-2.0.7800.0002.zip' 'acer-sf14-11-adsp-2.0.7800.0002' 7z
  _unpack 'acer-sf14-11-qualcomm-base-driver-0.7800.1.zip' 'acer-sf14-11-qualcomm-base-driver-0.7800.1' 7z
  _unpack 'acer-sf14-11-multimedia-driver-31.0.96.0.zip' 'acer-sf14-11-multimedia-driver-31.0.96.0' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'acer-sf14-11-adsp-2.0.7800.0002/ADSP_Qualcomm_2.0.7800.0002_W11ARM64/Formal_SA/qcsubsys_ext_adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1e80100/ACER/SF14-11/adsp_dtbs.elf'
  install -Dm644 'acer-sf14-11-adsp-2.0.7800.0002/ADSP_Qualcomm_2.0.7800.0002_W11ARM64/Formal_SA/qcsubsys_ext_adsp8380/adspr.jsn' "$fw"/'qcom/x1e80100/ACER/SF14-11/adspr.jsn'
  install -Dm644 'acer-sf14-11-adsp-2.0.7800.0002/ADSP_Qualcomm_2.0.7800.0002_W11ARM64/Formal_SA/qcsubsys_ext_adsp8380/adsps.jsn' "$fw"/'qcom/x1e80100/ACER/SF14-11/adsps.jsn'
  install -Dm644 'acer-sf14-11-adsp-2.0.7800.0002/ADSP_Qualcomm_2.0.7800.0002_W11ARM64/Formal_SA/qcsubsys_ext_adsp8380/adspua.jsn' "$fw"/'qcom/x1e80100/ACER/SF14-11/adspua.jsn'
  install -Dm644 'acer-sf14-11-adsp-2.0.7800.0002/ADSP_Qualcomm_2.0.7800.0002_W11ARM64/Formal_SA/qcsubsys_ext_adsp8380/battmgr.jsn' "$fw"/'qcom/x1e80100/ACER/SF14-11/battmgr.jsn'
  install -Dm644 'acer-sf14-11-qualcomm-base-driver-0.7800.1/Base Driver_Qualcomm_0.7800.1_W11ARM64_(Qualcomm Base Driver)/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1e80100/ACER/SF14-11/cdsp_dtbs.elf'
  install -Dm644 'acer-sf14-11-qualcomm-base-driver-0.7800.1/Base Driver_Qualcomm_0.7800.1_W11ARM64_(Qualcomm Base Driver)/qcnspmcdm_ext_cdsp8380/cdspr.jsn' "$fw"/'qcom/x1e80100/ACER/SF14-11/cdspr.jsn'
  install -Dm644 'acer-sf14-11-adsp-2.0.7800.0002/ADSP_Qualcomm_2.0.7800.0002_W11ARM64/Formal_SA/qcsubsys_ext_adsp8380/qcadsp8380.mbn' "$fw"/'qcom/x1e80100/ACER/SF14-11/qcadsp8380.mbn'
  install -Dm644 'acer-sf14-11-qualcomm-base-driver-0.7800.1/Base Driver_Qualcomm_0.7800.1_W11ARM64_(Qualcomm Base Driver)/qcnspmcdm_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1e80100/ACER/SF14-11/qccdsp8380.mbn'
  install -Dm644 'acer-sf14-11-multimedia-driver-31.0.96.0/Base Driver_Qualcomm_31.0.96.0_W11ARM64_(MultiMedia Driver)/qcdx8380/qcdxkmsuc8380.mbn' "$fw"/'qcom/x1e80100/ACER/SF14-11/qcdxkmsuc8380.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
dcc9be90cf51ed4a529aa02ce57f44e67af5db8a290582210a504296216dbb60  qcom/x1e80100/ACER/SF14-11/adsp_dtbs.elf
549bb9c8e32dc6253d0d0ddde2ce5c26f75f8333d3e55861f297e169a9f3e5c0  qcom/x1e80100/ACER/SF14-11/adspr.jsn
12ac2f3ae8ced12aa4b06b3ab3a01bc4d8efe1c92ebea503c002f209a6ec176f  qcom/x1e80100/ACER/SF14-11/adsps.jsn
982a99853495e34726b8e44697fdfad303334de0a67cbf6cde306c8f1731000b  qcom/x1e80100/ACER/SF14-11/adspua.jsn
be8c6fba330908e4683fb6282761cb08485a302d6a66e09721e102e342f27236  qcom/x1e80100/ACER/SF14-11/battmgr.jsn
1e0535bd2a8adcd14d6079ffa99f6fce5c6561d4759a60f6076dcfbaa4437f8a  qcom/x1e80100/ACER/SF14-11/cdsp_dtbs.elf
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x1e80100/ACER/SF14-11/cdspr.jsn
11d1fe76eb818b4e6417bdc452fbac58377aede252e4f2df66c85eaf8759fbc5  qcom/x1e80100/ACER/SF14-11/qcadsp8380.mbn
4387fa1a234aacbff50f8a215b96536d17c4b25b6b798392e15a162e4adcd7a0  qcom/x1e80100/ACER/SF14-11/qccdsp8380.mbn
10ac12861f2b12154f055928033a407f37fb9d87967e6d0cc0636a277f007932  qcom/x1e80100/ACER/SF14-11/qcdxkmsuc8380.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +
}
