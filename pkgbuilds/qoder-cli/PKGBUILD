# Maintainer: The Omarchy Authors
pkgname=qoder-cli
pkgver=1.1.100
pkgrel=1
pkgdesc="Qoder CLI, Qoder's agentic coding tool for the terminal"
arch=('x86_64' 'aarch64')
url="https://qoder.com/cli"
license=('Apache-2.0')
depends=('glibc')
# The binary is a Bun executable with its JavaScript appended; stripping breaks it.
options=('!strip' '!debug')
# The archives are the ones Qoder's install script reads from this manifest:
# https://qoder-ide.oss-accelerate.aliyuncs.com/qodercli/channels/manifest.json
# Qoder publishes no baseline x86_64 build, so this one needs AVX2.
_release="https://qoder-ide.oss-accelerate.aliyuncs.com/qodercli/releases/${pkgver}"
source_x86_64=("qodercli-${pkgver}-x86_64.tar.gz::${_release}/qodercli-linux-x64.tar.gz")
source_aarch64=("qodercli-${pkgver}-aarch64.tar.gz::${_release}/qodercli-linux-arm64.tar.gz")
sha256sums_x86_64=('05969837c7940ff5a71936b2181d102ee690523ef9c71635ad4e8d0c62678f16')
sha256sums_aarch64=('544cf0fd211826fb4ae93fcb0ea1c5669af3595f37c4954c578c70ee71e0fee6')

package() {
  # Qoder only updates itself from the per-user layout its install script
  # marks as its own. Installed here, that updater stays off and pacman
  # brings new releases.
  install -Dm755 qodercli "${pkgdir}/usr/bin/qodercli"
  install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" \
    LICENSE NOTICE THIRD-PARTY-LICENSES PDF-THIRD-PARTY-NOTICES.txt
}
