# Maintainer: Kurt Lieber <kurt@lieber.org>

pkgname=omalogi
pkgver=0.8.9.1
pkgrel=1
pkgdesc='Logitech HID++ mouse and keyboard control for Omarchy'
arch=('x86_64')
url='https://github.com/kurtlieber/omalogi'
license=('Apache-2.0 OR MIT')
# Linked by the binaries (readelf NEEDED) or dlopened by GPUI at runtime:
# vulkan-icd-loader is its primary renderer, libglvnd the OpenGL fallback.
depends=(
  'fontconfig'
  'freetype2'
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
  'libglvnd'
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'vulkan-icd-loader'
  'wayland'
)
# clang: a GPUI dependency runs bindgen, which needs libclang.
makedepends=('cargo' 'clang' 'pkgconf')
# Only one HID++ manager can own a receiver at a time.
conflicts=('openlogi' 'openlogi-bin' 'openlogi-git' 'solaar')
options=('!debug' '!lto')

# Upstream-style tags (vX.Y.Z) belong to OpenLogi; Omalogi releases add a
# fourth component for its own revision on that upstream base.
_tag="v$pkgver"
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$_tag.tar.gz")
sha256sums=('11f15ed91dcb98a2bcb8b61d4a431d1128dbb26c80bc5bb6ef1423115285ed17')

# Local validation: OMALOGI_SRC=/path/to/checkout makepkg builds that tree
# instead of the release tarball.
if [[ -n ${OMALOGI_SRC:-} ]]; then
  source=()
  sha256sums=()
fi

_srcdir() {
  if [[ -n ${OMALOGI_SRC:-} ]]; then
    printf '%s' "$OMALOGI_SRC"
  else
    printf '%s' "$srcdir/$pkgname-$pkgver"
  fi
}

prepare() {
  cd "$(_srcdir)"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$(_srcdir)"
  export CARGO_TARGET_DIR="$srcdir/target"
  # Name each production binary: building the agent crate whole would also
  # build its development-only mock.
  cargo build --frozen --release \
    --package openlogi --bin omalogi \
    --package openlogi-agent --bin omalogi-agent \
    --package openlogi-desktop --bin omalogi-desktop \
    --package openlogi-overlay --bin omalogi-overlay
}

check() {
  cd "$(_srcdir)"
  "$srcdir/target/release/omalogi" --version
}

package() {
  cd "$(_srcdir)"
  local bin
  for bin in omalogi omalogi-agent omalogi-desktop omalogi-overlay; do
    install -Dm755 "$srcdir/target/release/$bin" "$pkgdir/usr/bin/$bin"
  done

  install -Dm644 packaging/linux/udev/70-omalogi.rules \
    "$pkgdir/usr/lib/udev/rules.d/70-omalogi.rules"
  install -Dm644 packaging/linux/systemd/omalogi-agent.service \
    "$pkgdir/usr/lib/systemd/user/omalogi-agent.service"
  install -Dm644 packaging/linux/desktop/omalogi.desktop \
    "$pkgdir/usr/share/applications/omalogi.desktop"

  install -Dm644 assets/icon/omalogi.png \
    "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/omalogi.png"
  local size
  for size in 512 256 128 64 48 32 16; do
    install -Dm644 "assets/icon/omalogi-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/omalogi.png"
  done

  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
}
