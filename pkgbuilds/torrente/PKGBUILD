# Maintainer: nadalbatle <51460879+nadalbatle@users.noreply.github.com>

pkgname=torrente
pkgver=0.3.0
pkgrel=1
pkgdesc='Download, find and sort torrents, the Omarchy way'
arch=('x86_64' 'aarch64')
url='https://github.com/nadalbatle/torrente'
license=('MIT')
install='torrente.install'
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'qbittorrent-nox'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
  'xdg-desktop-portal'
)
optdepends=('python: searching through qBittorrent search plugins')
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('889c2273acbf3dc80034bc805cffe74470537580db52547746e941dcb178d7ee')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/torrente "$pkgdir/usr/bin/torrente"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 pkgbuild/torrente.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/torrente.svg"
  install -Dm644 pkgbuild/torrente.desktop "$pkgdir/usr/share/applications/torrente.desktop"
  install -Dm644 pkgbuild/torrente-engine.service "$pkgdir/usr/lib/systemd/user/torrente-engine.service"
  install -Dm644 pkgbuild/torrente-daemon.service "$pkgdir/usr/lib/systemd/user/torrente-daemon.service"

  # The Omarchy bar plugin. The shell loads plugins from the user's config,
  # so it ships here and `torrente plugin install` copies it in.
  local plugin="$pkgdir/usr/share/torrente/omarchy-plugin"
  install -Dm644 plugin/manifest.json "$plugin/manifest.json"
  install -Dm644 plugin/Panel.qml "$plugin/Panel.qml"
  install -Dm644 plugin/Model.js "$plugin/Model.js"
  install -Dm644 -t "$plugin/i18n" plugin/i18n/*.json
}
