# omarchy-ane-firmware-fetch writes the ANE firmware (90-omarchy-ane-firmware.hook
# on T6021, by hand on T6020, T6022 and T8112). pacman does not own it.
post_remove() {
  rm -f /usr/lib/firmware/apple/ane/t602x_ane0_fw_selene_rc4x.macho \
    /usr/lib/firmware/apple/ane/h14_ane_fw_bia_j4xx.macho
  rmdir /usr/lib/firmware/apple/ane 2>/dev/null || :
}
