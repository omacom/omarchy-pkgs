# Maintainer: Wesley Grimes <wesgrimes@hey.com>

pkgname=wayshare
pkgver=0.3.0
pkgrel=1
pkgdesc='Screen sharing server for Hyprland with macOS and RDP support'
arch=('x86_64' 'aarch64')
url='https://github.com/wesleygrimes/wayshare'
license=('Apache-2.0')
install=wayshare.install
options=('!debug' '!lto')
depends=(
  'gcc-libs'
  'glibc'
  'hyprland>=0.56'
  'libglvnd'
  'mesa'
  'zlib'
)
makedepends=('cargo' 'pkgconf')
# Loaded with dlopen at runtime; High Performance mode needs one encoder.
optdepends=('libva: RDP H.264 and High Performance HEVC encoding through VA-API'
            'x265: software HEVC encoding when VA-API is unavailable'
            'libfdk-aac: High Performance audio'
            'libpulse: High Performance audio capture')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b3837876cf40e45fcc129c185dd224d80b0b43af1db3ed3078b424cbbb5416e3')

prepare() {
  cd "$pkgname-$pkgver"

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"

  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"

  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/wayshare "$pkgdir/usr/bin/wayshare"
  sed 's|@bindir@|/usr/bin|' contrib/wayshare.service.in > wayshare.service
  install -Dm644 wayshare.service "$pkgdir/usr/lib/systemd/user/wayshare.service"
  install -Dm644 contrib/config.example.toml "$pkgdir/usr/share/doc/$pkgname/config.example.toml"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD-PARTY-LICENSES "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-LICENSES"
}
