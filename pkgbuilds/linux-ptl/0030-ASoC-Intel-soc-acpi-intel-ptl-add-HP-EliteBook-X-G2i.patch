From 323b5f9dff2002030c6ef980638f4c30ff5f0beb Mon Sep 17 00:00:00 2001
From: Meir Dick <mdick85@gmail.com>
Date: Sun, 9 Aug 2026 14:48:00 -0400
Subject: [PATCH] ASoC: Intel: soc-acpi-intel-ptl: add HP EliteBook X G2i

The HP EliteBook X G2i (board 8E86) pairs a plain RT712 SDCA codec on
link 3 with four TAS2783A smart amplifiers on link 2. No entry in the
Panther Lake match table describes that combination, so sof_sdw never
instantiates the amplifiers: the card comes up with no Speaker device
at all and PulseAudio/PipeWire leave it on profile "off".

Add the machine. The amplifier addresses are the live enumeration on
this board, sdw:0:2:0102:0000:01:{9,a,c,d}, giving unique_id 0x9, 0xA,
0xC and 0xD with TI's vendor_id 0x0102 and part_id 0x0000 (TAS2783A).

Two details are load-bearing and are commented in place:

  - The amplifier name_prefix values must be exactly "tas2783-1"
    through "tas2783-4". asoc_sdw_ti_spk_rtd_init() compares those
    literal strings and returns -EINVAL for anything else, which
    aborts card registration.

  - The RT712 endpoints use AIF1 for the jack (num 0) and AIF3 for the
    microphone (num 2). AIF2 is the codec's own integrated amplifier,
    which this board does not use because the amplification is
    external. RT712 shares its AIF layout with RT721, so this follows
    the AMD PX13 rt721+tas2783x2 machine.

There is no baked topology for this combination. The "dummy" topology
name makes sof_test_topology_file() skip its existence check, so
probing falls through to get_function_tplg_files() and the per-function
topologies are loaded instead. The boot log confirms the intent:
"Using function topologies instead".
---
 .../intel/common/soc-acpi-intel-ptl-match.c   | 114 ++++++++++++++++++
 1 file changed, 114 insertions(+)

diff --git a/sound/soc/intel/common/soc-acpi-intel-ptl-match.c b/sound/soc/intel/common/soc-acpi-intel-ptl-match.c
index f7694b2..9ced983 100644
--- a/sound/soc/intel/common/soc-acpi-intel-ptl-match.c
+++ b/sound/soc/intel/common/soc-acpi-intel-ptl-match.c
@@ -92,6 +92,45 @@ static const struct snd_soc_acpi_endpoint spk_r_endpoint = {
 	.group_id = 1,
 };
 
+/* HP EliteBook X G2i (board 8E86): 4x TAS2783A amps on one link, no fb capture DAI */
+static const struct snd_soc_acpi_endpoint spk_2_endpoint = {
+	.num = 0,
+	.aggregated = 1,
+	.group_position = 2,
+	.group_id = 1,
+};
+
+static const struct snd_soc_acpi_endpoint spk_3_endpoint = {
+	.num = 0,
+	.aggregated = 1,
+	.group_position = 3,
+	.group_id = 1,
+};
+
+/*
+ * plain (non-VB) RT712: jack + mic, no integrated amp function.
+ * AIF numbering per real precedent (AMD PX13 rt721+tas2783x2 patch,
+ * hasunpark@, "ASoC: amd: acp: add PX13 SoundWire machine link for
+ * rt721+tas2783x2"): AIF1=jack(num0), AIF2=internal amp(num1, unused
+ * on boards with external amps), AIF3=mic(num2). RT712 shares this
+ * AIF layout with its sibling RT721, so mic must be num=2, not num=1
+ * (num=1 is the internal-amp slot this board doesn't use).
+ */
+static const struct snd_soc_acpi_endpoint rt712_endpoints[] = {
+	{
+		.num = 0,
+		.aggregated = 0,
+		.group_position = 0,
+		.group_id = 0,
+	},
+	{
+		.num = 2,
+		.aggregated = 0,
+		.group_position = 0,
+		.group_id = 0,
+	},
+};
+
 static const struct snd_soc_acpi_endpoint jack_dmic_endpoints[] = {
 	/* Jack Endpoint */
 	{
@@ -211,6 +250,53 @@ static const struct snd_soc_acpi_adr_device rt712_vb_3_group1_adr[] = {
 	}
 };
 
+static const struct snd_soc_acpi_adr_device rt712_3_single_adr[] = {
+	{
+		.adr = 0x000330025D071201ull,
+		.num_endpoints = ARRAY_SIZE(rt712_endpoints),
+		.endpoints = rt712_endpoints,
+		.name_prefix = "rt712"
+	}
+};
+
+/*
+ * 4x TAS2783A on link 2, unique_id 0x9/0xA/0xC/0xD (confirmed from live
+ * enumeration: sdw:0:2:0102:0000:01:{9,a,c,d}). vendor_id=0x0102 (TI),
+ * part_id=0x0000 (TAS2783A per mainline codec_info_list), class_id=0x01.
+ */
+/*
+ * name_prefix MUST be exactly "tas2783-1".."tas2783-4" (see
+ * asoc_sdw_ti_spk_rtd_init() in sound/soc/sdw_utils/soc_sdw_ti_amp.c,
+ * which strncmp()s these literal strings and returns -EINVAL /
+ * "unhandled prefix" for anything else, aborting card registration).
+ */
+static const struct snd_soc_acpi_adr_device tas2783_2_quad_adr[] = {
+	{
+		.adr = 0x0002390102000001ull,
+		.num_endpoints = 1,
+		.endpoints = &spk_l_endpoint,
+		.name_prefix = "tas2783-1"
+	},
+	{
+		.adr = 0x00023A0102000001ull,
+		.num_endpoints = 1,
+		.endpoints = &spk_r_endpoint,
+		.name_prefix = "tas2783-2"
+	},
+	{
+		.adr = 0x00023C0102000001ull,
+		.num_endpoints = 1,
+		.endpoints = &spk_2_endpoint,
+		.name_prefix = "tas2783-3"
+	},
+	{
+		.adr = 0x00023D0102000001ull,
+		.num_endpoints = 1,
+		.endpoints = &spk_3_endpoint,
+		.name_prefix = "tas2783-4"
+	},
+};
+
 static const struct snd_soc_acpi_adr_device rt713_vb_2_adr[] = {
 	{
 		.adr = 0x000230025d071301ull,
@@ -423,6 +509,21 @@ static const struct snd_soc_acpi_link_adr ptl_sdw_rt712_vb_l3_rt1320_l2[] = {
 	{}
 };
 
+/* HP EliteBook X G2i (board 8E86): plain RT712 (l3) + 4x TAS2783A (l2) */
+static const struct snd_soc_acpi_link_adr ptl_sdw_rt712_l3_tas2783_l2[] = {
+	{
+		.mask = BIT(3),
+		.num_adr = ARRAY_SIZE(rt712_3_single_adr),
+		.adr_d = rt712_3_single_adr,
+	},
+	{
+		.mask = BIT(2),
+		.num_adr = ARRAY_SIZE(tas2783_2_quad_adr),
+		.adr_d = tas2783_2_quad_adr,
+	},
+	{}
+};
+
 static const struct snd_soc_acpi_link_adr ptl_sdw_rt712_vb_l3_rt1320_l3[] = {
 	{
 		.mask = BIT(3),
@@ -510,6 +611,19 @@ struct snd_soc_acpi_mach snd_soc_acpi_intel_ptl_sdw_machines[] = {
 		.sof_tplg_filename = "sof-ptl-rt712-l3-rt1320-l2.tplg",
 		.get_function_tplg_files = sof_sdw_get_tplg_files,
 	},
+	{
+		.link_mask = BIT(2) | BIT(3),
+		.links = ptl_sdw_rt712_l3_tas2783_l2,
+		.drv_name = "sof_sdw",
+		/*
+		 * No baked topology exists for this combo (rt712 + tas2783A);
+		 * "dummy" in the name makes sof_test_topology_file() skip its
+		 * existence check (fw-file-profile.c) so probing falls through
+		 * to get_function_tplg_files() for dynamic per-function loading.
+		 */
+		.sof_tplg_filename = "sof-ptl-rt712-l3-tas2783-l2-dummy.tplg",
+		.get_function_tplg_files = sof_sdw_get_tplg_files,
+	},
 	{
 		.link_mask = BIT(2) | BIT(3),
 		.links = ptl_cs42l43_agg_l3_cs35l56_l2,
