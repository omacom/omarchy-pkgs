From 22c5e362185e58001f17a52ccb0b7fb93c1eb2ad Mon Sep 17 00:00:00 2001
From: Meir Dick <mdick85@gmail.com>
Date: Sun, 9 Aug 2026 14:48:16 -0400
Subject: [PATCH] ASoC: sdw_utils: set a component name for the TAS2783A
 amplifier

asoc_sdw_rtd_init() appends " spk:<name>" to card->components for every
amplifier DAI that declares a component_name. The TAS2783A entry does
not declare one, so a card using those amplifiers reports no spk: token
at all:

  Components: 'HDA:80862822,... cfg-amp:4 iec61937-pcm:7,6,5
               hs:rt712 mic:rt712'

UCM resolves the speaker configuration from that token. Without it
sof-soundwire.conf leaves SpeakerCodecFile empty, HiFi.conf includes no
speaker device file, and the card exposes no Speaker device even though
the amplifiers are present and working. Every other amplifier in
codec_info_list -- rt1308, rt1316, rt1318, rt1320, mx8373, mx8363,
cs35l56 -- already sets this field.

Declare it, so the card reports " spk:tas2783" like the rest.
---
 sound/soc/sdw_utils/soc_sdw_utils.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/sound/soc/sdw_utils/soc_sdw_utils.c b/sound/soc/sdw_utils/soc_sdw_utils.c
index e440c23..e433830 100644
--- a/sound/soc/sdw_utils/soc_sdw_utils.c
+++ b/sound/soc/sdw_utils/soc_sdw_utils.c
@@ -82,6 +82,7 @@ struct asoc_sdw_codec_info codec_info_list[] = {
 				.dai_name = "tas2783-codec",
 				.dai_type = SOC_SDW_DAI_TYPE_AMP,
 				.dailink = {SOC_SDW_AMP_OUT_DAI_ID, SOC_SDW_AMP_IN_DAI_ID},
+				.component_name = "tas2783",
 				.init = asoc_sdw_ti_amp_init,
 				.rtd_init = asoc_sdw_ti_spk_rtd_init,
 				.controls = lr_4spk_controls,
