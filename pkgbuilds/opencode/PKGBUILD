# Maintainer: The Omarchy Authors

# Arch builds opencode and opencode-desktop as one split package, and the
# desktop app depends on the exact CLI version, so shadowing the CLI means
# carrying the desktop app too. Both come from the same upstream release.

pkgbase=opencode
pkgname=('opencode' 'opencode-desktop')
pkgver=2.4.1
pkgrel=1
pkgdesc="The open source AI coding agent"
arch=('x86_64' 'aarch64')
url="https://opencode.ai"
license=('MIT')
# Both are vendor builds: a Bun executable with its JavaScript appended, and
# an Electron app. Stripping breaks the first.
options=('!strip' '!debug')
source=('LICENSE')
# The baseline CLI build runs on x86_64 CPUs without AVX2.
source_x86_64=("opencode-${pkgver}-x86_64.tar.gz::https://github.com/anomalyco/opencode/releases/download/v${pkgver}/opencode-linux-x64-baseline.tar.gz"
               "opencode-desktop-${pkgver}-x86_64.deb::https://github.com/anomalyco/opencode/releases/download/v${pkgver}/opencode-desktop-linux-amd64.deb")
source_aarch64=("opencode-${pkgver}-aarch64.tar.gz::https://github.com/anomalyco/opencode/releases/download/v${pkgver}/opencode-linux-arm64.tar.gz"
                "opencode-desktop-${pkgver}-aarch64.deb::https://github.com/anomalyco/opencode/releases/download/v${pkgver}/opencode-desktop-linux-arm64.deb")
noextract=("opencode-${pkgver}-${CARCH}.tar.gz" "opencode-desktop-${pkgver}-${CARCH}.deb")
sha256sums=('625f0f619133f89bbbb2abe37369613dfa1885eba1e50d02170deb62bb42cb6b')
sha256sums_x86_64=('9ddd18e3faf64eaeccf6a0fcbc96a5c7a14520ae5fd5b61e5be51d894f478b47'
                   '93cccc5b2685a697d8c8c70b095898ac031cd6fdeda8d83db06ceebb179ce332')
sha256sums_aarch64=('cb28cf94541aeb62a4b2ea5997a99b5dd6bae595a772f36fbe279299f2032a4f'
                    '6dafc478525be25e6b42e8391475fe61e4335059c70352ef8465a6e777ad274d')

package_opencode() {
  # opencode downloads its own ripgrep when none is on PATH.
  depends=('glibc' 'ripgrep')
  optdepends=('wl-clipboard: clipboard support on Wayland')

  local root="${pkgdir}/usr/lib/opencode"
  install -dm755 "${root}" "${pkgdir}/usr/bin"
  bsdtar --no-same-owner -xf "opencode-${pkgver}-${CARCH}.tar.gz" -C "${root}"

  # pacman updates this install, so opencode's own update check and
  # auto-upgrade would only nag or fail.
  cat >"${pkgdir}/usr/bin/opencode" <<'WRAPPER'
#!/bin/sh
export OPENCODE_DISABLE_AUTOUPDATE=1
exec /usr/lib/opencode/opencode "$@"
WRAPPER
  chmod 755 "${pkgdir}/usr/bin/opencode"

  install -d "${pkgdir}/usr/share/bash-completion/completions" \
    "${pkgdir}/usr/share/zsh/site-functions" \
    "${pkgdir}/usr/share/fish/vendor_completions.d"
  "${root}/opencode" --completions bash >"${pkgdir}/usr/share/bash-completion/completions/opencode"
  "${root}/opencode" --completions zsh >"${pkgdir}/usr/share/zsh/site-functions/_opencode"
  "${root}/opencode" --completions fish >"${pkgdir}/usr/share/fish/vendor_completions.d/opencode.fish"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

package_opencode-desktop() {
  pkgdesc+=" (desktop app)"
  depends=(
    "opencode=${pkgver}"
    'alsa-lib'
    'at-spi2-core'
    'cairo'
    'dbus'
    'expat'
    'gcc-libs'
    'glib2'
    'glibc'
    'gtk3'
    'hicolor-icon-theme'
    'libcups'
    'libnotify'
    'libsecret'
    'libx11'
    'libxcb'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxkbcommon'
    'libxrandr'
    'mesa'
    'nspr'
    'nss'
    'pango'
    'systemd-libs'
    'xdg-utils'
  )

  local deb="${srcdir}/desktop"
  mkdir -p "${deb}"
  bsdtar -xOf "opencode-desktop-${pkgver}-${CARCH}.deb" data.tar.xz | bsdtar --no-same-owner -xf - -C "${deb}"

  local root="${pkgdir}/usr/lib/opencode-desktop"
  install -d "${root}"
  cp -a "${deb}/opt/OpenCode/." "${root}/"

  # The app runs resources/opencode-cli as its server. Point it at this
  # release's CLI, whose wrapper keeps its auto-upgrade off, as Arch does. The
  # app takes the CLI's version from opencode-cli.version instead of asking it.
  [[ $(<"${root}/resources/opencode-cli.version") == "${pkgver}" ]]
  ln -sf /usr/bin/opencode "${root}/resources/opencode-cli"

  # The app turns its updater off when app-update.yml is missing ("auto updater
  # disabled, app-update.yml is missing"); pacman updates it instead. The
  # AppArmor profile is only for upstream's own .deb install.
  rm "${root}/resources/app-update.yml" "${root}/resources/package-type" "${root}/resources/apparmor-profile"

  # As Arch ships Chromium's and Electron's sandbox helper: setuid keeps the
  # sandbox up on kernels that deny unprivileged user namespaces.
  chmod 4755 "${root}/chrome-sandbox"

  install -d "${pkgdir}/usr/bin"
  ln -s /usr/lib/opencode-desktop/ai.opencode "${pkgdir}/usr/bin/opencode-desktop"

  # Upstream's entry, named after the app's Wayland app ID, with its scheme
  # handler. opencode-desktop.desktop beside it is a hidden legacy entry.
  sed 's|^Exec=/opt/OpenCode/ai.opencode |Exec=opencode-desktop |' \
    "${deb}/usr/share/applications/ai.opencode.desktop.desktop" >"${srcdir}/ai.opencode.desktop.desktop"
  grep -qx 'Exec=opencode-desktop %U' "${srcdir}/ai.opencode.desktop.desktop"
  install -Dm644 "${srcdir}/ai.opencode.desktop.desktop" "${pkgdir}/usr/share/applications/ai.opencode.desktop.desktop"
  install -Dm644 -t "${pkgdir}/usr/share/metainfo" "${deb}/usr/share/metainfo/ai.opencode.desktop.metainfo.xml"
  cp -a "${deb}/usr/share/icons" "${pkgdir}/usr/share/"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
