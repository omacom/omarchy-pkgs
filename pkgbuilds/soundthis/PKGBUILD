# Maintainer: Rodrigo Vieira <rodvieirasilva@gmail.com>

pkgname=soundthis
pkgver=0.3.2
pkgrel=1
pkgdesc="Real-time desktop audio streaming server for Omarchy Linux"
arch=('x86_64' 'aarch64')
url="https://github.com/rodvieirasilva/soundthis"
license=('MIT')
depends=('gcc-libs' 'glibc' 'libpulse')
optdepends=(
  'omarchy: native Omarchy desktop bar widget and popout panel'
)
options=('!debug')
install=soundthis.install
source=(
  "soundthis.desktop"
  "90-soundthis.preset"
  "soundthis.svg"
)
sha256sums=(
  '887d16e3f71e67809b5add1bf808ecfbf340f10ff83e14b498110d30f4f6650f'
  '1b897b6b93214ef17b6cbcbb86310945036fd794204bf5b70962c5dda991370d'
  '5b01f282b7824e5fc60a45f05087497699a4c17f7a82b90e122c5f31192a6b68'
)
source_x86_64=("$pkgname-$pkgver-x86_64-linux.tar.gz::$url/releases/download/v$pkgver/soundthis-v$pkgver-x86_64-linux.tar.gz")
sha256sums_x86_64=('78b2bcd78ab46298a85833b1bb01d5fa8e0d6b86960715b686a94139574730fc')
source_aarch64=("$pkgname-$pkgver-aarch64-linux.tar.gz::$url/releases/download/v$pkgver/soundthis-v$pkgver-aarch64-linux.tar.gz")
sha256sums_aarch64=('5bad7459260452693a59555a57f293a3548f64fce1a5d13523182dafb2b23c69')

package() {
  cd "$srcdir"

  # Server executable
  install -Dm755 soundthis "$pkgdir/usr/bin/soundthis"

  # Systemd user service & preset
  install -Dm644 systemd/soundthis.service.template "$pkgdir/usr/lib/systemd/user/soundthis.service"
  sed -i 's|%BIN_PATH%|/usr/bin/soundthis|g' "$pkgdir/usr/lib/systemd/user/soundthis.service"
  install -Dm644 90-soundthis.preset "$pkgdir/usr/lib/systemd/user-preset/90-soundthis.preset"

  # Default configuration template
  install -Dm644 config/config.toml.template "$pkgdir/usr/share/soundthis/config.toml.template"

  # Omarchy desktop shell plugin
  install -Dm644 plugin/manifest.json "$pkgdir/usr/share/omarchy/shell/plugins/soundthis/manifest.json"
  install -Dm644 plugin/Panel.qml "$pkgdir/usr/share/omarchy/shell/plugins/soundthis/Panel.qml"

  # Desktop launcher & icon
  install -Dm644 soundthis.desktop "$pkgdir/usr/share/applications/soundthis.desktop"
  install -Dm644 soundthis.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/soundthis.svg"

  # Documentation & License
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
