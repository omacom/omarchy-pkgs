# shellcheck shell=bash

_get_target_users() {
  declare -A seen_uids

  # Active user systemd managers
  if command -v systemctl >/dev/null 2>&1 && systemd-notify --booted 2>/dev/null; then
    while read -r unit _; do
      if [[ $unit =~ ^user@([0-9]+)\.service$ ]]; then
        seen_uids["${BASH_REMATCH[1]}"]=1
      fi
    done < <(systemctl list-units 'user@*.service' --state=running --no-legend --plain 2>/dev/null || true)
  fi

  # SUDO_USER if valid non-root UID
  if [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != "root" ]]; then
    local sudo_uid
    sudo_uid=$(id -u "$SUDO_USER" 2>/dev/null || true)
    if [[ -n "$sudo_uid" && "$sudo_uid" -ge 1000 ]]; then
      seen_uids["$sudo_uid"]=1
    fi
  fi

  for uid in "${!seen_uids[@]}"; do
    echo "$uid"
  done
}

post_install() {
  echo ":: Enabling and starting SoundThis daemon and Omarchy bar widget..."

  for uid in $(_get_target_users); do
    local user_name
    user_name=$(id -nu "$uid" 2>/dev/null || true)
    local home_dir
    home_dir=$(getent passwd "$uid" 2>/dev/null | cut -d: -f6)
    local runtime_dir="/run/user/${uid}"

    # 1. Enable and start systemd user service
    if command -v systemctl >/dev/null 2>&1; then
      systemctl --user --machine="${uid}@.host" daemon-reload 2>/dev/null || true
      systemctl --user --machine="${uid}@.host" enable --now soundthis.service 2>/dev/null || true
    fi

    # 2. Enable Omarchy shell plugin in active graphical session
    local enabled_via_shell=0
    if [[ -n "$user_name" && -d "$runtime_dir" ]]; then
      local wayland_socket
      wayland_socket=$(ls -t "$runtime_dir"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -n1 || true)
      if [[ -n "$wayland_socket" ]]; then
        local wayland_display="${wayland_socket##*/}"
        sudo -u "$user_name" env OMARCHY_PATH=/usr/share/omarchy XDG_RUNTIME_DIR="$runtime_dir" WAYLAND_DISPLAY="$wayland_display" omarchy-shell -q shell rescanPlugins 2>/dev/null || true
        if sudo -u "$user_name" env OMARCHY_PATH=/usr/share/omarchy XDG_RUNTIME_DIR="$runtime_dir" WAYLAND_DISPLAY="$wayland_display" omarchy-shell -q shell enablePlugin soundthis "{}" 2>/dev/null; then
          enabled_via_shell=1
        fi
      fi
    fi

    # 3. Fallback: ensure widget is registered in shell.json if shell was offline
    if (( ! enabled_via_shell )) && [[ -n "$home_dir" && -f "$home_dir/.config/omarchy/shell.json" ]]; then
      if command -v jq >/dev/null 2>&1; then
        if ! jq -e '.bar.layout.right[]? | select(. == "soundthis" or .id == "soundthis")' "$home_dir/.config/omarchy/shell.json" >/dev/null 2>&1; then
          local tmp_json
          tmp_json=$(mktemp)
          if jq '.bar.layout.right = (if (.bar.layout.right | type) == "array" then [{"id": "soundthis"}] + .bar.layout.right else [{"id": "soundthis"}] end)' "$home_dir/.config/omarchy/shell.json" > "$tmp_json" 2>/dev/null; then
            chown "$uid:$uid" "$tmp_json" 2>/dev/null || true
            chmod 644 "$tmp_json" 2>/dev/null || true
            mv -f "$tmp_json" "$home_dir/.config/omarchy/shell.json"
          else
            rm -f "$tmp_json"
          fi
        fi
      fi
    fi
  done

  echo ":: SoundThis is ready! Audio streaming daemon is running and widget is active on the bar."
}

post_upgrade() {
  for uid in $(_get_target_users); do
    local user_name
    user_name=$(id -nu "$uid" 2>/dev/null || true)
    local runtime_dir="/run/user/${uid}"

    if command -v systemctl >/dev/null 2>&1; then
      systemctl --user --machine="${uid}@.host" daemon-reload 2>/dev/null || true
      systemctl --user --machine="${uid}@.host" try-restart soundthis.service 2>/dev/null || true
    fi

    if [[ -n "$user_name" && -d "$runtime_dir" ]]; then
      local wayland_socket
      wayland_socket=$(ls -t "$runtime_dir"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -n1 || true)
      if [[ -n "$wayland_socket" ]]; then
        local wayland_display="${wayland_socket##*/}"
        sudo -u "$user_name" env OMARCHY_PATH=/usr/share/omarchy XDG_RUNTIME_DIR="$runtime_dir" WAYLAND_DISPLAY="$wayland_display" omarchy-shell -q shell rescanPlugins 2>/dev/null || true
      fi
    fi
  done
}

pre_remove() {
  echo ":: Stopping SoundThis daemon and removing Omarchy bar widget..."

  for uid in $(_get_target_users); do
    local user_name
    user_name=$(id -nu "$uid" 2>/dev/null || true)
    local home_dir
    home_dir=$(getent passwd "$uid" 2>/dev/null | cut -d: -f6)
    local runtime_dir="/run/user/${uid}"

    # 1. Stop and disable systemd service
    if command -v systemctl >/dev/null 2>&1; then
      systemctl --user --machine="${uid}@.host" stop soundthis.service 2>/dev/null || true
      systemctl --user --machine="${uid}@.host" disable soundthis.service 2>/dev/null || true
    fi

    # 2. Tell running omarchy-shell to disable the plugin
    if [[ -n "$user_name" && -d "$runtime_dir" ]]; then
      local wayland_socket
      wayland_socket=$(ls -t "$runtime_dir"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -n1 || true)
      if [[ -n "$wayland_socket" ]]; then
        local wayland_display="${wayland_socket##*/}"
        sudo -u "$user_name" env OMARCHY_PATH=/usr/share/omarchy XDG_RUNTIME_DIR="$runtime_dir" WAYLAND_DISPLAY="$wayland_display" omarchy-shell -q shell setPluginEnabled soundthis false 2>/dev/null || true
      fi
    fi

    # 3. Clean up shell.json if soundthis is still present in layout
    if [[ -n "$home_dir" && -f "$home_dir/.config/omarchy/shell.json" ]]; then
      if command -v jq >/dev/null 2>&1; then
        if jq -e '.bar.layout.right[]? | select(. == "soundthis" or .id == "soundthis")' "$home_dir/.config/omarchy/shell.json" >/dev/null 2>&1; then
          local tmp_json
          tmp_json=$(mktemp)
          if jq '.bar.layout.right = [.bar.layout.right[] | select(. != "soundthis" and .id != "soundthis")]' "$home_dir/.config/omarchy/shell.json" > "$tmp_json" 2>/dev/null; then
            chown "$uid:$uid" "$tmp_json" 2>/dev/null || true
            chmod 644 "$tmp_json" 2>/dev/null || true
            mv -f "$tmp_json" "$home_dir/.config/omarchy/shell.json"
          else
            rm -f "$tmp_json"
          fi
        fi
      fi
    fi

    # 4. Clean up any leftover local config overrides
    if [[ -n "$home_dir" ]]; then
      rm -f "$home_dir/.config/systemd/user/soundthis.service" 2>/dev/null || true
      rm -rf "$home_dir/.config/omarchy/plugins/soundthis" 2>/dev/null || true
    fi
  done
}

post_remove() {
  for uid in $(_get_target_users); do
    local user_name
    user_name=$(id -nu "$uid" 2>/dev/null || true)
    local runtime_dir="/run/user/${uid}"

    if command -v systemctl >/dev/null 2>&1; then
      systemctl --user --machine="${uid}@.host" daemon-reload 2>/dev/null || true
    fi

    if [[ -n "$user_name" && -d "$runtime_dir" ]]; then
      local wayland_socket
      wayland_socket=$(ls -t "$runtime_dir"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -n1 || true)
      if [[ -n "$wayland_socket" ]]; then
        local wayland_display="${wayland_socket##*/}"
        sudo -u "$user_name" env OMARCHY_PATH=/usr/share/omarchy XDG_RUNTIME_DIR="$runtime_dir" WAYLAND_DISPLAY="$wayland_display" omarchy-shell -q shell rescanPlugins 2>/dev/null || true
      fi
    fi
  done

  echo ":: SoundThis has been cleanly uninstalled and removed."
}
