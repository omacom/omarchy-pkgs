# Maintainer: The Omarchy Authors
pkgname=crush-bin
pkgver=0.102.0
pkgrel=2
pkgdesc="Crush, Charm's terminal coding agent"
arch=('x86_64' 'aarch64')
url="https://charm.land/crush"
license=('FSL-1.1-MIT')
provides=('crush')
conflicts=('crush')
# A static Go binary, the same file Charm publishes.
options=('!strip' '!debug')
source_x86_64=("crush-${pkgver}-x86_64.tar.gz::https://github.com/charmbracelet/crush/releases/download/v${pkgver}/crush_${pkgver}_Linux_x86_64.tar.gz")
source_aarch64=("crush-${pkgver}-aarch64.tar.gz::https://github.com/charmbracelet/crush/releases/download/v${pkgver}/crush_${pkgver}_Linux_arm64.tar.gz")
sha256sums_x86_64=('7930cc14a2dec3a857ddd2070c863c1c5d7edb335d20cdfb65a5b44e62a0ca1e')
sha256sums_aarch64=('311e0a5b67e595ad2b6f2276181bcea78c396ac220541544fdd1b419c4ba62d1')

package() {
  # Crush never replaces itself. It only asks GitHub for the latest release on
  # start and shows a notice when there is one; nothing turns that off.
  cd crush_${pkgver}_Linux_*
  install -Dm755 crush "${pkgdir}/usr/bin/crush"
  install -Dm644 LICENSE.md "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.md"
  install -Dm644 completions/crush.bash "${pkgdir}/usr/share/bash-completion/completions/crush"
  install -Dm644 completions/crush.zsh "${pkgdir}/usr/share/zsh/site-functions/_crush"
  install -Dm644 completions/crush.fish "${pkgdir}/usr/share/fish/vendor_completions.d/crush.fish"
  install -Dm644 manpages/crush.1.gz "${pkgdir}/usr/share/man/man1/crush.1.gz"
}
