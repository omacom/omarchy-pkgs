# Maintainer: Duff OMelia <https://github.com/duff>
pkgname=bibliora
pkgver=1.0.0
pkgrel=1
pkgdesc='Keyboard-first Bible reader for Omarchy, with pages like a book'
arch=('x86_64' 'aarch64')
url='https://github.com/duff/bibliora-omarchy'
license=('MIT' 'OFL-1.1' 'LicenseRef-Bible-translations')
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'sqlite'
)
makedepends=('cmake' 'ninja')
# The translations aren't in the git repository. Every release carries them,
# compressed, beside the source, and makepkg unpacks the .zst.
source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
  "bibles-$pkgver.sqlite3.zst::$url/releases/download/v$pkgver/bibles.sqlite3.zst"
)
sha256sums=('4e08471982123a9108fee6e5e548396fdea3a00792d8c72c126b42a2ded7b429'
            '98a33cc66b7821d65c244357c7dc5924017f1c8f03532be2d7f6be7fba417cb2')

build() {
  cmake -S "bibliora-omarchy-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  # Against the Bible this package installs: every chapter of two
  # translations set into pages, and the command line agents use.
  BIBLIORA_DB="$srcdir/bibles-$pkgver.sqlite3" ctest --test-dir build --output-on-failure
}

package() {
  # The app, its desktop entry and icon, the agent skill, and the licenses:
  # Bibliora's, the reading fonts', and the translations' copyright notices.
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "bibles-$pkgver.sqlite3" "$pkgdir/usr/share/bibliora/bibles.sqlite3"
}
