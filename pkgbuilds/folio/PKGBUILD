# Maintainer: David Heinemeier Hansson <david@hey.com>

pkgname=folio
pkgver=0.3.0
pkgrel=1
pkgdesc="Files: Omarchy's file manager, quiet, keyboard-first and following the theme"
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/folio'
license=('MIT')
options=('!debug')
depends=(
  'glib2'
  'hicolor-icon-theme'
  'libarchive'
  'qt6-base'
  'qt6-declarative'
  'qt6-imageformats'
  'qt6-multimedia'
  'qt6-svg'
  'qt6-wayland'
  'xdg-utils'
  'zlib'
)
optdepends=(
  'qt6-webengine: PDF previews (Qt PDF)'
  'ffmpegthumbnailer: video thumbnails'
  'papers: PDF thumbnails'
  'glycin: HEIC, JPEG XL and other image thumbnails'
  'gvfs: browsing tailnet machines over SFTP'
  'tailscale: listing tailnet machines and Taildrop'
  'jq: the Tailscale plugin, which reads tailscale status with it'
  'dropbox-cli: Dropbox sync status and share links'
  'localsend: sharing with nearby devices'
  'xdg-terminal-exec: Open Terminal Here'
)
makedepends=('cmake' 'gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('5e117698e020f70a60223ba140f9fdc062ec08e92994515d9c795ef4e8849149')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/folio "$pkgdir/usr/bin/folio"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 share/folio.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/folio.svg"
  install -Dm644 share/folio.desktop "$pkgdir/usr/share/applications/folio.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/plugins.md "$pkgdir/usr/share/doc/$pkgname/plugins.md"

  # The bundled plugins (Tailscale, Dropbox, LocalSend), their commands
  # still executable.
  find plugins -type f | while read -r file; do
    mode=644
    [ -x "$file" ] && mode=755
    install -Dm$mode "$file" "$pkgdir/usr/share/folio/$file"
  done
}
