# Maintainer: David Heinemeier Hansson <david@hey.com>

pkgname=folio
pkgver=0.2.0
pkgrel=2
pkgdesc="Files: Omarchy's file manager, quiet, keyboard-first and following the theme"
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/folio'
license=('MIT')
options=('!debug')
depends=(
  'glib2'
  'hicolor-icon-theme'
  'libarchive'
  'qt6-base'
  'qt6-declarative'
  'qt6-imageformats'
  'qt6-multimedia'
  'qt6-wayland'
  'xdg-utils'
  'zlib'
)
optdepends=(
  'qt6-webengine: PDF previews (Qt PDF)'
  'ffmpegthumbnailer: video thumbnails'
  'papers: PDF thumbnails'
  'glycin: HEIC, JPEG XL and other image thumbnails'
  'gvfs: browsing tailnet machines over SFTP'
  'tailscale: listing tailnet machines and Taildrop'
  'dropbox-cli: Dropbox sync status and share links'
  'localsend: sharing with nearby devices'
  'xdg-terminal-exec: Open Terminal Here'
)
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('92b95cc6e4f29a9cda5e6998b7757fc7332e27e4d403dd8d0e9837dba38f7e92')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/folio "$pkgdir/usr/bin/folio"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/folio.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/folio.svg"
  install -Dm644 pkgbuild/folio.desktop "$pkgdir/usr/share/applications/folio.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
