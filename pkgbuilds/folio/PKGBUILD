# Maintainer: David Heinemeier Hansson <david@hey.com>

pkgname=folio
pkgver=0.7.4
pkgrel=1
pkgdesc="Files: Omarchy's file manager, quiet, keyboard-first and following the theme"
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/folio'
license=('MIT')
options=('!debug')
depends=(
  'glib2'
  'hicolor-icon-theme'
  'libarchive'
  'qt6-base'
  'qt6-declarative'
  'qt6-imageformats'
  'qt6-multimedia'
  'qt6-svg'
  'qt6-wayland'
  'xdg-utils'
  'zlib'
)
optdepends=(
  'qt6-webengine: PDF previews (Qt PDF)'
  'ffmpegthumbnailer: video thumbnails'
  'papers: PDF thumbnails'
  'poppler: PDF thumbnails without Papers'
  'glycin: HEIC, JPEG XL and other image thumbnails'
  'gvfs: browsing tailnet machines over SFTP'
  'tailscale: listing tailnet machines and Taildrop'
  'jq: the Tailscale plugin, which reads tailscale status with it'
  'dropbox-cli: Dropbox sync status and share links'
  'localsend: sharing with nearby devices'
  'xdg-terminal-exec: Open Terminal Here'
)
makedepends=('cmake' 'gcc' 'make')
checkdepends=('jq' 'poppler')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('bae379a00c0d1f5eb7bd4f72233b6c29c5c8f40b44b8612d36e53899d00006ed')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  # Folio's own install rules: the binary, desktop files, portal, icon,
  # licence, docs and plugins, their commands still executable.
  DESTDIR="$pkgdir" cmake --install build
}
