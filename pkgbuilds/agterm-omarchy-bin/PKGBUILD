# Maintainer: Alexandru Savinov <https://github.com/alexandru-savinov>
# agterm is umputun's (https://github.com/umputun/agterm, MIT); the GTK4 Linux
# port is melonamin's (https://github.com/melonamin/agterm-linux). This
# repackages the Omarchy fork's CI archives for both architectures.
pkgname=agterm-omarchy-bin
pkgver=0.43.0.14
pkgrel=1
pkgdesc="Native terminal with a workspace and session sidebar, built on libghostty (Omarchy build)"
arch=(x86_64 aarch64)
url="https://github.com/alexandru-savinov/agterm-omarchy"
license=(MIT)
# The archive's ELF NEEDED entries outside its own lib/, by owning package.
depends=(bash cairo curl gdk-pixbuf2 glib2 glibc graphene gtk4 harfbuzz
         libadwaita libepoxy libgcc libsoup3 libstdc++ pango python
         vulkan-icd-loader webkitgtk-6.0)
optdepends=('zsh: Live session restore with zsh'
            'fish: Live session restore with fish')
provides=(agterm-linux)
conflicts=(agterm-linux agterm-linux-bin)
# The Swift runtime, libghostty and zmx ship as built and tested by CI.
options=(!strip !debug)
install=$pkgname.install
source_x86_64=("$url/releases/download/omarchy-v$pkgver/agterm-omarchy-$pkgver-x86_64.tar.gz")
source_aarch64=("$url/releases/download/omarchy-v$pkgver/agterm-omarchy-$pkgver-aarch64.tar.gz")
noextract=("agterm-omarchy-$pkgver-$CARCH.tar.gz")
sha256sums_x86_64=('e486986e031b657c741d2bc5abf4661b3f44374efc5fade68e0648b1850198a0')
sha256sums_aarch64=('93ab4da677a960f1a74f24d11826d28bf66bfd8b729bdeee38a60af21baad781')

package() {
  local lib="$pkgdir/usr/lib/agterm" share="$pkgdir/usr/lib/agterm/share"

  # Root-owned whatever the archive records.
  install -d "$lib"
  bsdtar --no-same-owner --strip-components=1 -xf "agterm-omarchy-$pkgver-$CARCH.tar.gz" -C "$lib"

  # The launchers resolve their own symlink to find lib/ and share/. zmx,
  # terminfo and the Ghostty resources stay private: ghostty-terminfo ships
  # xterm-ghostty and the AUR zmx ships /usr/bin/zmx.
  install -d "$pkgdir/usr/bin"
  ln -s /usr/lib/agterm/bin/agterm-linux "$pkgdir/usr/bin/agterm-linux"
  ln -s /usr/lib/agterm/bin/agtermctl "$pkgdir/usr/bin/agtermctl"

  install -Dm644 -t "$pkgdir/usr/share/applications" "$share/applications/io.github.melonamin.agterm.desktop"
  install -Dm644 -t "$pkgdir/usr/share/pixmaps" "$share/pixmaps/io.github.melonamin.agterm.png"
  install -d "$pkgdir/usr/share/icons"
  cp -r --no-preserve=ownership "$share/icons/hicolor" "$pkgdir/usr/share/icons/"

  install -d "$pkgdir/usr/share/licenses"
  ln -s /usr/lib/agterm/share/licenses/agterm "$pkgdir/usr/share/licenses/$pkgname"
}
