# shellcheck shell=bash
post_install() {
  cat <<'TEXT'
agterm is installed. To make it Omarchy's default terminal and give it Super+C/V, run as your desktop user:

  agtermctl integration omarchy enable

Undo with `agtermctl integration omarchy disable`.
Follow Omarchy is on by default: agterm follows Omarchy's theme, fonts and keys.
TEXT
  path_note
}

post_upgrade() {
  path_note
}

path_note() {
  cat <<'TEXT'
If an older agterm in ~/.local comes first on your PATH, run the packaged CLI as /usr/bin/agtermctl.
TEXT
}
