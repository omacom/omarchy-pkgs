# Audio DSP, compute DSP, GPU and modem firmware for the Acer Spin 7 SP714-61NA. The firmware only
# runs if it is signed for this board by Acer, so linux-firmware cannot carry it until the OEM
# submits it. The OEM ships it in the driver bundle it publishes for the machine on Windows
# Update, whose cabinets this recipe fetches with wudrivers and unpacks without running anything.
# Each file is checked against the SHA-256 it was matched to and installed under the name the
# device tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so
# once linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=acer-spin-7-firmware
pkgver=20261116
pkgrel=1
pkgdesc='Audio DSP, compute DSP, GPU and modem firmware for the Acer Spin 7 SP714-61NA'
arch=('aarch64')
url='https://github.com/birkskyum/wudrivers'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-sc8180xp-acer-sp714-61na')
makedepends=('7zip' 'wudrivers')
options=('!strip' '!debug')
# Windows Update's links are short-lived, so wudrivers fetches a fresh one by update ID, revision and SHA-1.
DLAGENTS+=('wu::/usr/bin/wudrivers fetch %u -o %o')
source=(
  'acer-spin-7-sp714-61na-wu-200.0.10.0-qcwlan8180.cab::wu://76598104-93f0-4b68-b903-dc959c4b1073/1/919376ee2da212dd43459262aae946897e08392c'
  'acer-spin-7-sp714-61na-wu-200.0.10.0-qcsubsys-ext-cdsp8180.cab::wu://76598104-93f0-4b68-b903-dc959c4b1073/1/b6f1388e8151a54c49ac43e0a0e87d577fa27621'
  'acer-spin-7-sp714-61na-wu-200.0.10.0-qcsubsys-ext-adsp8180.cab::wu://76598104-93f0-4b68-b903-dc959c4b1073/1/81b40fa29e21b2c6ed6135e2fb1291a82cd7c7e6'
  'acer-spin-7-sp714-61na-wu-200.0.10.0-qcdx8180.cab::wu://76598104-93f0-4b68-b903-dc959c4b1073/1/0cc89ff2ec57ee1fe1f1a83897ad24e20769ca44'
  'acer-spin-7-sp714-61na-wu-200.0.10.0-qcsubsys-ext-mpss8180.cab::wu://76598104-93f0-4b68-b903-dc959c4b1073/1/94c43f41885ff179033aa255463945c7a4f2074a'
)
source+=('README.package.md')
noextract=('acer-spin-7-sp714-61na-wu-200.0.10.0-qcwlan8180.cab' 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcsubsys-ext-cdsp8180.cab' 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcsubsys-ext-adsp8180.cab' 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcdx8180.cab' 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcsubsys-ext-mpss8180.cab')
sha256sums=('3b2e60d1d2560bd419664f4449216deb01be149fc92982d0898a8089ae79a0c2' '38fae7299f1caeb0024af21c46ea62c529da5803243694d79c02aeb790fda54e' 'b5002d6f76268ad56d83288dd401c1e32759749d999a93c0b4daf07213fce06f' '3e269d0384979319518ea2d55f1c5f57726a90ec1a1e46caa9ea8fabccecb1c8' '0076174aa398e4c4eef3ec70936c594fb3e41a9c4e0fd67fd5a438534c516643')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcwlan8180.cab' 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcwlan8180' 7z
  _unpack 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcsubsys-ext-cdsp8180.cab' 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcsubsys-ext-cdsp8180' 7z
  _unpack 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcsubsys-ext-adsp8180.cab' 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcsubsys-ext-adsp8180' 7z
  _unpack 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcdx8180.cab' 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcdx8180' 7z
  _unpack 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcsubsys-ext-mpss8180.cab' 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcsubsys-ext-mpss8180' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcsubsys-ext-adsp8180/qcadsp8180.mbn' "$fw"/'qcom/sc8180xp/Acer/SP714-61NA/qcadsp8180.mbn'
  install -Dm644 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcsubsys-ext-cdsp8180/qccdsp8180.mbn' "$fw"/'qcom/sc8180xp/Acer/SP714-61NA/qccdsp8180.mbn'
  install -Dm644 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcdx8180/qcdxkmsuc8180.mbn' "$fw"/'qcom/sc8180xp/Acer/SP714-61NA/qcdxkmsuc8180.mbn'
  install -Dm644 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcsubsys-ext-mpss8180/qcmpss8180_nm.mbn' "$fw"/'qcom/sc8180xp/Acer/SP714-61NA/qcmpss8180_nm.mbn'
  install -Dm644 'acer-spin-7-sp714-61na-wu-200.0.10.0-qcwlan8180/WLANMDSP.MBN' "$fw"/'qcom/sc8180xp/Acer/SP714-61NA/wlanmdsp.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
8220e7e61e8b685c1ed2ce2e4a259bded36a2050de571671ef73d8889cfdd73f  qcom/sc8180xp/Acer/SP714-61NA/qcadsp8180.mbn
7c146e68f4b3a80ccbc03539e38440c69da4ce4c9e0a8feb74e6d21feb837a33  qcom/sc8180xp/Acer/SP714-61NA/qccdsp8180.mbn
416f200c6bbf9bf3685b332848e733e56f4944954271be9195e9636573002493  qcom/sc8180xp/Acer/SP714-61NA/qcdxkmsuc8180.mbn
fc819b43e639212d9f32a5c356db26aaef6ba0cf89aa7392575b735ac76b2c92  qcom/sc8180xp/Acer/SP714-61NA/qcmpss8180_nm.mbn
f3f9a8929a4911d7eef42058081db348d22cb96a9d00b0adba70587a7bd7dc50  qcom/sc8180xp/Acer/SP714-61NA/wlanmdsp.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
