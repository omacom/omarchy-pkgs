pkgname=omarchy-nvim
pkgver=2026.9.21
pkgrel=6
pkgdesc="Pre-built LazyVim configuration with cached plugins"
arch=('any')
url="https://github.com/LazyVim/LazyVim"
license=('MIT')
depends=('neovim>=0.9.0' 'git')
makedepends=('nodejs' 'npm' 'tree-sitter-cli')
conflicts=('omarchy-lazyvim')
options=('!debug')
_starter_commit=803bc181d7c0d6d5eeba9274d9be49b287294d99
source=(
  "lazyvim-starter-$_starter_commit.tar.gz::https://github.com/LazyVim/starter/archive/$_starter_commit.tar.gz"
  'lazyvim.json'
  'omarchy-nvim-setup'
  'options.lua'
