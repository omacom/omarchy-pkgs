pkgname=triforce-lv2
_name=triforce
pkgver=0.3.2
pkgrel=2
pkgdesc='A beamformer LV2 plugin for Apple Silicon laptop microphones'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/chadmed/triforce'
license=('GPL-2.0-or-later')
depends=('glibc' 'gcc-libs' 'lv2')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('1d081222d0bfe2c961ac44b368c9f1d2dd9ec0833a35bab87863bac07e9df019')

prepare() {
  cd $_name-$pkgver
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $_name-$pkgver
  cargo build --frozen --release
}

package() {
  cd $_name-$pkgver
  make LIBDIR=/usr/lib DESTDIR="$pkgdir" install
  install -Dm644 LICENCE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENCE.txt"
}
