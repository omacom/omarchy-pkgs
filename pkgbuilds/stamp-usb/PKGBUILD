# Maintainer: Alfredo Gore <alfredo dot gore at gmail dot com>
pkgname=stamp-usb
pkgver=0.2.0
pkgrel=1
pkgdesc="Quickshell application that writes disk images to USB sticks"
arch=('any')
url="https://github.com/varrtto/stamp"
license=('MIT')
depends=('quickshell' 'polkit' 'file' 'zenity' 'qt6-5compat')
optdepends=(
  'udisks2: power off the stick when eject fails'
  'libcanberra: play a sound when the write finishes'
)
source=("${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('a3f203b4ca7ee3c7ca7654aefe46865857e814b4fff0a000c7a0e413f5e9e492')

package() {
  cd "stamp-$pkgver"
  install -Dm644 shell.qml -t "$pkgdir/usr/share/stamp-usb"
  install -Dm644 StepIcon.qml -t "$pkgdir/usr/share/stamp-usb"
  install -Dm644 icons/*.svg -t "$pkgdir/usr/share/stamp-usb/icons"
  install -Dm755 flash.sh -t "$pkgdir/usr/share/stamp-usb"
  install -Dm755 stamp-usb "$pkgdir/usr/bin/stamp-usb"
  install -Dm644 stamp-usb.desktop "$pkgdir/usr/share/applications/stamp-usb.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
