# Maintainer: David Heinemeier Hansson <david@hey.com>

pkgname=plain
pkgver=0.3.3
pkgrel=1
pkgdesc="Omarchy's text editor for config files"
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/plain'
license=('MIT')
install='plain.install'
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
  'xdg-desktop-portal'
)
makedepends=('cmake' 'gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('7fe67d3cda3fccf625d7f1f518d50af92d51cafbf8d5ef56668d2d0ee8ad7a78')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/plain "$pkgdir/usr/bin/plain"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/plain.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/plain.svg"
  install -Dm644 pkgbuild/plain.desktop "$pkgdir/usr/share/applications/plain.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
