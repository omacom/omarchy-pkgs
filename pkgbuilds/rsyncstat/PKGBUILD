# Maintainer: Alex Okita <alex@okita.ninja>

pkgname=rsyncstat
pkgver=0.1.0
pkgrel=1
pkgdesc='Disk-usage treemap and safe folder sync'
arch=('x86_64' 'aarch64')
url='https://github.com/okita-io/rsyncstat'
license=('MIT')
install=rsyncstat.install
options=('!debug' '!lto')
depends=(
  'gcc-libs'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libxkbcommon'
  'wayland'
  'xdg-desktop-portal'
  'xdg-desktop-portal-gtk'
)
makedepends=('cargo' 'clang' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('22eb48fa0f175455d195c2df3875025039296096e25e3cf53d207664ef760a11')

prepare() {
  cd "$pkgname-$pkgver"

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"

  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p rsyncstat-app
}

check() {
  cd "$pkgname-$pkgver"

  export CARGO_TARGET_DIR=target
  cargo test --frozen --release -p rsyncstat-app
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/rsyncstat "$pkgdir/usr/bin/rsyncstat"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 crates/rsyncstat-app/assets/icon.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/rsyncstat.png"
  install -Dm644 pkgbuild/rsyncstat.desktop \
    "$pkgdir/usr/share/applications/rsyncstat.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
