pkgname=appmanager-bin
pkgver=3.8.0
pkgrel=1
pkgdesc="Manage AppImages with a drag-and-drop installer and update support"
arch=('x86_64' 'aarch64')
url="https://github.com/kem-a/AppManager"
license=('GPL-3.0-or-later')
depends=('ca-certificates' 'fuse3' 'hicolor-icon-theme')
checkdepends=('desktop-file-utils')
provides=("appmanager=${pkgver}")
conflicts=('appmanager')
options=('!strip' '!debug')

_app_id=com.github.AppManager
_appimage_x86_64="AppManager-${pkgver}-anylinux-x86_64.AppImage"
_appimage_aarch64="AppManager-${pkgver}-anylinux-aarch64.AppImage"
source=("AppManager-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
source_x86_64=("${url}/releases/download/v${pkgver}/${_appimage_x86_64}")
source_aarch64=("${url}/releases/download/v${pkgver}/${_appimage_aarch64}")
noextract=("${_appimage_x86_64}" "${_appimage_aarch64}")
sha256sums=('458bee9edbfa6e6abf1a3d5c2aadfedbee125e4fdf79721a6b45cf34d5c666c3')
sha256sums_x86_64=('599685be011e11971a3115c38f40b00ad84b123b0dd925a655d109e0ad93fac2')
sha256sums_aarch64=('a2a990162b45fef8f28ef7f6975d796d87ea01990e9c618e9ac27048f421474f')

prepare() {
  # Use the tagged desktop entry, including AppImage MIME types and appimg links.
  sed 's|@bindir@|/usr/bin|g' "AppManager-${pkgver}/data/app-manager.desktop.in" > "${_app_id}.desktop"
}

check() {
  desktop-file-validate "${_app_id}.desktop"
}

package() {
  local appimage="AppManager-${pkgver}-anylinux-${CARCH}.AppImage"
  local upstream="AppManager-${pkgver}"

  install -Dm755 "$appimage" "$pkgdir/opt/appmanager/AppManager.AppImage"
  install -d "$pkgdir/usr/bin"
  ln -s /opt/appmanager/AppManager.AppImage "$pkgdir/usr/bin/app-manager"

  install -Dm644 "${_app_id}.desktop" "$pkgdir/usr/share/applications/${_app_id}.desktop"
  install -Dm644 "$upstream/data/icons/hicolor/scalable/apps/${_app_id}.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/${_app_id}.svg"
  install -Dm644 "$upstream/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
