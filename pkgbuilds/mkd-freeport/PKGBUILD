# Maintainer: Nathan A Chadwick <nate@monkeyking.dev>
pkgname=mkd-freeport
pkgver=0.4.0
pkgrel=1
pkgdesc='Discover and reserve TCP/UDP ports over IPv4 and IPv6 for scripts and AI agents'
arch=('x86_64' 'aarch64')
url='https://github.com/monkeyking-hq/mkd-freeport'
license=('MIT')
options=('!debug')
depends=('gcc-libs')
makedepends=('cargo')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('fe57a66e9b75b8d3ae8f02aaedd06a91a137fe98fc983175df10422675126186')

prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --bin mkd-freeport
  cargo run --frozen --release -p xtask -- dist-assets --out-dir dist/assets
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release --workspace
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 target/release/mkd-freeport "${pkgdir}/usr/bin/mkd-freeport"
  install -Dm644 dist/assets/man/mkd-freeport.1 "${pkgdir}/usr/share/man/man1/mkd-freeport.1"
  install -Dm644 dist/assets/completions/mkd-freeport.bash "${pkgdir}/usr/share/bash-completion/completions/mkd-freeport"
  install -Dm644 dist/assets/completions/_mkd-freeport "${pkgdir}/usr/share/zsh/site-functions/_mkd-freeport"
  install -Dm644 dist/assets/completions/mkd-freeport.fish "${pkgdir}/usr/share/fish/vendor_completions.d/mkd-freeport.fish"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
