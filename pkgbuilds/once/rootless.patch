+package docker
+
+import (
+	"archive/tar"
+	"bytes"
+	"compress/gzip"
+	"context"
+	"github.com/moby/moby/client"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"testing"
+
+	"github.com/moby/moby/api/types/container"
+	"github.com/moby/moby/api/types/network"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPodmanBackupPathsSurviveRestore(t *testing.T) {
+	var source, backup, restored bytes.Buffer
+	writer := tar.NewWriter(&source)
+	require.NoError(t, writeTarEntry(writer, "/db/production.sqlite3", []byte("book content")))
+	require.NoError(t, writer.WriteHeader(&tar.Header{Name: "/db/hardlink", Typeflag: tar.TypeLink, Linkname: "/db/production.sqlite3"}))
+	require.NoError(t, writer.Close())
+	output := tar.NewWriter(&backup)
+	require.NoError(t, copyTarEntriesWithPrefix(&source, output, "storage", "data"))
+	require.NoError(t, output.Close())
+	reader := tar.NewReader(&backup)
+	header, err := reader.Next()
+	require.NoError(t, err)
+	require.Equal(t, "data/db/production.sqlite3", header.Name)
+	_, err = restored.ReadFrom(reader)
+	require.NoError(t, err)
+	require.Equal(t, "book content", restored.String())
+	header, err = reader.Next()
+	require.NoError(t, err)
+	require.Equal(t, "data/db/hardlink", header.Name)
+	require.Equal(t, "data/db/production.sqlite3", header.Linkname)
+}
+
+func TestRejectUnsafeVolumeArchivePaths(t *testing.T) {
+	for _, name := range []string{"storage/../outside", "/../outside", "storage/a/../../outside", "unexpected/file"} {
+		_, err := archiveVolumePath(name, "storage", "data")
+		require.Error(t, err)
+	}
+}
+
+func TestRootlessProxyRejectsPublicAndPrivilegedBindings(t *testing.T) {
+	host := &container.HostConfig{PortBindings: network.PortMap{}}
+	for _, port := range []string{"80/tcp", "443/tcp", "1318/tcp"} {
+		host.PortBindings[network.MustParsePort(port)] = []network.PortBinding{{HostIP: netip.MustParseAddr("127.0.0.1"), HostPort: "8080"}}
+	}
+	require.NoError(t, validateRootlessProxy(host))
+	host.PortBindings[network.MustParsePort("80/tcp")] = []network.PortBinding{{HostPort: "8080"}}
+	require.Error(t, validateRootlessProxy(host))
+	host.PortBindings[network.MustParsePort("80/tcp")] = []network.PortBinding{{HostIP: netip.MustParseAddr("127.0.0.1"), HostPort: "80"}}
+	require.Error(t, validateRootlessProxy(host))
+}
+
+func TestRestoreArchiveTargetsVolumeAndRejectsOldPodmanPaths(t *testing.T) {
+	for _, name := range []string{"data/db/production.sqlite3", "/db/production.sqlite3"} {
+		var backup, output bytes.Buffer
+		compressed := gzip.NewWriter(&backup)
+		writer := tar.NewWriter(compressed)
+		require.NoError(t, writeTarEntry(writer, name, []byte("book content")))
+		// A later valid file must not erase an earlier validation error.
+		require.NoError(t, writeTarEntry(writer, "data/later", []byte("later")))
+		require.NoError(t, writer.Close())
+		require.NoError(t, compressed.Close())
+		err := streamVolumeDataEntries(&backup, &output)
+		if name[0] == '/' {
+			require.ErrorIs(t, err, ErrInvalidBackup)
+		} else {
+			require.NoError(t, err)
+			header, err := tar.NewReader(&output).Next()
+			require.NoError(t, err)
+			require.Equal(t, "./db/production.sqlite3", header.Name)
+		}
+	}
+}
+
+func TestExecWaitsForFinalExitStatus(t *testing.T) {
+	calls := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		calls++
+		if calls == 1 {
+			w.Write([]byte(`{"Running":true,"ExitCode":0}`))
+		} else {
+			w.Write([]byte(`{"Running":false,"ExitCode":7}`))
+		}
+	}))
+	defer server.Close()
+	c, err := client.New(client.WithHost(server.URL), client.WithAPIVersion("1.44"))
+	require.NoError(t, err)
+	defer c.Close()
+	code, err := inspectExecExitCode(context.Background(), c, "exec-id")
+	require.NoError(t, err)
+	require.Equal(t, 7, code)
+	require.Equal(t, 2, calls)
+}
