+// Docker includes the requested directory in archive names; Podman uses paths
+// rooted at that directory. Normalize only engine output, never an untrusted
+// backup during restore, and reject traversal or an unexpected relative root.
+func archiveVolumePath(name, oldPrefix, newPrefix string) (string, error) {
+	for _, component := range strings.Split(name, "/") {
+		if component == ".." {
+			return "", fmt.Errorf("unsafe volume archive path %q", name)
+		}
+	}
+	name = strings.TrimSuffix(name, "/")
+	var relative string
+	if strings.HasPrefix(name, "/") || name == "" {
+		relative = strings.TrimLeft(name, "/")
+	} else if name == oldPrefix {
+		relative = ""
+	} else if strings.HasPrefix(name, oldPrefix+"/") {
+		relative = strings.TrimPrefix(name, oldPrefix+"/")
+	} else {
+		return "", fmt.Errorf("unexpected volume archive path %q", name)
+	}
+	if relative == "" {
+		return newPrefix, nil
+	}
+	return newPrefix + "/" + relative, nil
 }
 
