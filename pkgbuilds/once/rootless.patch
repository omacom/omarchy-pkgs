diff --git a/internal/docker/rootless.go b/internal/docker/rootless.go
new file mode 100644
--- /dev/null
+++ b/internal/docker/rootless.go
@@ -0,0 +1,28 @@
+package docker
+
+import (
+	"fmt"
+	"strconv"
+
+	"github.com/moby/moby/api/types/container"
+)
+
+func validateRootlessProxy(host *container.HostConfig) error {
+	if host == nil || host.Privileged || host.NetworkMode.IsHost() || len(host.PortBindings) != 3 {
+		return fmt.Errorf("existing proxy is not configured for rootless local access; migrate it explicitly")
+	}
+	for port, bindings := range host.PortBindings {
+		if port.String() != "80/tcp" && port.String() != "443/tcp" && port.String() != "1318/tcp" {
+			return fmt.Errorf("unexpected proxy port %s", port)
+		}
+		if len(bindings) != 1 {
+			return fmt.Errorf("unexpected proxy bindings")
+		}
+		binding := bindings[0]
+		number, err := strconv.Atoi(binding.HostPort)
+		if err != nil || number < 1024 || number > 65535 || !binding.HostIP.IsLoopback() {
+			return fmt.Errorf("existing proxy must bind only loopback and unprivileged ports")
+		}
+	}
+	return nil
+}
