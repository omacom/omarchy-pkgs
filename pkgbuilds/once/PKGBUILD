# ONCE with the rootless local proxy and Podman archive compatibility fixes.
pkgname=once
pkgver=0.3.2
pkgrel=1
pkgdesc='Manage self-hosted web applications with rootless Omarchy integration'
arch=('x86_64' 'aarch64')
url='https://github.com/basecamp/once'
license=('MIT')
makedepends=('go' 'patch')
optdepends=('docker: Docker Engine backend' 'podman: Podman backend')
provides=("once-bin=$pkgver")
conflicts=('once-bin')
options=('!lto' '!debug')
source=("once-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        'rootless.patch'
        'once-background.service')
sha256sums=('24c676395cba262c374bcecf1556d0eecfb0c3497554a572fe3ed4f527d20357'
            'ba449102a83d8d7ac315a873b61f2acaa366e8720cb7088366ec9c502324f959'
            'aa314fe79677eb5f120fcc3d4c42007a93ff7b1ef917382c0c1fdca5633ad46a')

prepare() {
  cd "once-$pkgver"
  patch -Np1 -i "$srcdir/rootless.patch"
}

build() {
  cd "once-$pkgver"
  CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/basecamp/once/internal/version.Version=v$pkgver-omarchy1" -o once ./cmd/once
}

check() {
  cd "once-$pkgver"
  go test ./internal/...
}

package() {
  cd "once-$pkgver"
  install -Dm755 once "$pkgdir/usr/bin/once"
  install -Dm644 MIT-LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # Preserve the legacy unit for users who explicitly retain rootful ONCE.
  install -Dm644 "$srcdir/once-background.service" "$pkgdir/usr/lib/systemd/system/once-background.service"
}
