+/**
+ * \brief Publish the lens shading table the statistics should correct with
+ * \param[in] table The table, or nullptr to disable the correction
+ * \param[in] inputSize Size of the frame the statistics walk
+ * \param[in] blackLevel Black level as a fraction of the full range
+ *
+ * Only a back end whose statistics read UNCORRECTED data may call this.
+ * DebayerEGL must, because it renders on the GPU and computes statistics from
+ * a separate CPU pass over the raw input. DebayerCpu must NOT, because it
+ * applies the correction while copying each input line and hands the
+ * statistics those same buffers; calling this there would correct twice.
+ *
+ * The correction is declined for CSI-2 packed input, so that the statistics
+ * and the rendered frame always agree about whether shading has been taken
+ * out: neither debayer back end corrects packed data either.
+ */
+void SwStatsCpu::setLsc(std::shared_ptr<const LensShadingTable> table,
+			const Size &inputSize, float blackLevel)
+{
+	lscBlack_ = blackLevel * ((1 << bitDepth_) - 1);
+
+	if (table == lscTable_ && inputSize == lscInputSize_)
+		return;
+
+	lscTable_ = table;
+	lscInputSize_ = inputSize;
+	lscRow_.y = ~0u;
+	lscValid_ = false;
+
+	if (!table || !table->isValid())
+		return;
+
+	if (packed_) {
+		LOG(SwStatsCpu, Warning)
+			<< "lens shading not applied to statistics: packed input";
+		return;
+	}
+
+	if (!inputSize.width || !inputSize.height) {
+		LOG(SwStatsCpu, Warning)
+			<< "lens shading not applied to statistics: no input size";
+		return;
+	}
+
+	lscMaxValue_ = (1 << bitDepth_) - 1;
+	lscValid_ = true;
+}
+
+/**
+ * \brief Build the lens shading gains for one statistics line
+ * \param[in] y Line number, relative to the statistics window
+ * \return The gains at each sampled column, or nullptr if disabled
+ *
+ * The vertical interpolation is done once per line and the horizontal one is
+ * evaluated only at the columns the stats loops actually visit, which is one
+ * column in four. That keeps this to roughly a third of the cost of the line
+ * it serves.
+ *
+ * Both source lines of a 2x2 block share the gains of the block's top line.
+ * Over one row the field moves by well under half a percent of the correction,
+ * which is far below the accuracy of the table.
+ */
+const SwStatsCpu::LscRow *SwStatsCpu::lscRowFor(unsigned int y)
+{
+	if (!lscValid_)
+		return nullptr;
+
+	if (lscRow_.y == y)
+		return &lscRow_;
+
+	const LensShadingTable &t = *lscTable_;
+	const unsigned int samples = window_.width / 4 + 1;
+
+	if (lscRow_.r.size() < samples) {
+		lscRow_.r.resize(samples);
+		lscRow_.g.resize(samples);
+		lscRow_.b.resize(samples);
+	}
+
+	/*
+	 * SwStatsCpu walks the buffer it is given from its own window origin,
+	 * so these are the absolute coordinates of the samples in the input
+	 * frame.
+	 */
+	const float fy = std::clamp(static_cast<float>(window_.y + y) *
+					    (t.height - 1) / (lscInputSize_.height - 1),
+				    0.0f, static_cast<float>(t.height - 1));
+	const unsigned int gy = std::min<unsigned int>(fy, t.height - 2);
+	const float wy = fy - gy;
+
+	const float xScale = static_cast<float>(t.width - 1) /
+			     (lscInputSize_.width - 1);
+
+	for (unsigned int i = 0; i < samples; i++) {
+		const float fx = std::clamp((window_.x + i * 4) * xScale, 0.0f,
+					    static_cast<float>(t.width - 1));
+		const unsigned int gx = std::min<unsigned int>(fx, t.width - 2);
+		const float wx = fx - gx;
+
+		auto sample = [&](const std::vector<float> &pl) {
+			const float a = pl[gy * t.width + gx];
+			const float b = pl[gy * t.width + gx + 1];
+			const float c = pl[(gy + 1) * t.width + gx];
+			const float d = pl[(gy + 1) * t.width + gx + 1];
+			return (a * (1.0f - wx) + b * wx) * (1.0f - wy) +
+			       (c * (1.0f - wx) + d * wx) * wy;
+		};
+
+		lscRow_.r[i] = sample(t.r);
+		lscRow_.g[i] = sample(t.g);
+		lscRow_.b[i] = sample(t.b);
+	}
+
+	lscRow_.y = y;
+	return &lscRow_;
+}
