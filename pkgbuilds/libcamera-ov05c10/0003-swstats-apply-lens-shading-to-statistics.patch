-void SwStatsCpu::statsBGGR8Line0(const uint8_t *src[], SwIspStats &stats)
+namespace {
+
+/* Apply one gain to one black level corrected sample, saturating. */
+template<typename T>
+T lscApply(T value, float gain, float black, unsigned int maxValue)
+{
+	const float v = black + (static_cast<float>(value) - black) * gain;
+	const float c = std::clamp(v, 0.0f, static_cast<float>(maxValue));
+	return static_cast<T>(c + 0.5f);
+}
+
+} /* namespace */
