-void DebayerCpuThread::setupInputMemcpy(const uint8_t *linePointers[])
+/**
+ * \brief Apply the lens shading gains to one copied input line
+ * \param[inout] line The copied line, including its left padding
+ * \param[in] inputY Row of this line within the debayer input frame
+ *
+ * The gains are bilinear over the table. The vertical interpolation is done
+ * once per line into a small scratch row, so the per pixel cost is one
+ * horizontal lerp plus the scale itself.
+ *
+ * The gains multiply the black level corrected signal, hence the subtract and
+ * add around the multiply. Working in Q12 fixed point keeps the whole line in
+ * integer arithmetic, which is what lets the compiler vectorise it.
+ *
+ * This runs on the same buffers the statistics engine reads, so correcting
+ * here corrects the statistics as well. That is deliberate: it is what stops
+ * the shading from biasing the grey world white balance estimate.
+ */
+void DebayerCpuThread::scaleLine(uint8_t *line, unsigned int inputY)
+{
+	if (!debayer_->lscValid_)
+		return;
+
+	const LensShadingTable &t = *debayer_->lscTable_;
+	const unsigned int shift = DebayerCpu::kLscFractionalBits;
+	const unsigned int one = 1U << shift;
+	const int black = debayer_->lscBlack_;
+	const unsigned int width = debayer_->window_.width;
+	const unsigned int xOffset = debayer_->window_.x;
+
+	/* Vertical position within the table. */
+	const unsigned int hIn = debayer_->lscInputHeight_;
+	float fy = hIn > 1
+			   ? static_cast<float>(inputY) * (t.height - 1) / (hIn - 1)
+			   : 0.0f;
+	fy = std::clamp(fy, 0.0f, static_cast<float>(t.height - 1));
+	unsigned int gy = std::min<unsigned int>(fy, t.height - 2);
+	const float wy = fy - gy;
+
+	/*
+	 * Blend the two bracketing table rows into a scratch row, once per
+	 * line, for each of the two Bayer channels present on this input row.
+	 */
+	const unsigned int rowParity = inputY & 1;
+	std::array<float, 2 * DebayerCpu::kMaxLscWidth> row;
+	const std::vector<float> *planes[2] = {
+		debayer_->lscPlane_[rowParity][0],
+		debayer_->lscPlane_[rowParity][1],
+	};
+
+	for (unsigned int q = 0; q < 2; q++) {
+		const std::vector<float> &pl = *planes[q];
+		for (unsigned int i = 0; i < t.width; i++) {
+			const float a = pl[gy * t.width + i];
+			const float b = pl[(gy + 1) * t.width + i];
+			row[q * DebayerCpu::kMaxLscWidth + i] = a + wy * (b - a);
+		}
+	}
+
+	uint8_t *p8 = line + lineBufferPadding_;
+	uint16_t *p16 = reinterpret_cast<uint16_t *>(p8);
+	const float xScale = (t.width - 1) / static_cast<float>(debayer_->lscInputWidth_ - 1);
+	const unsigned int maxValue = (1U << debayer_->inputConfig_.bpp) - 1;
+
+	for (unsigned int x = 0; x < width; x++) {
+		const float fx = std::clamp((xOffset + x) * xScale, 0.0f,
+					    static_cast<float>(t.width - 1));
+		const unsigned int gx = std::min<unsigned int>(fx, t.width - 2);
+		const float wx = fx - gx;
+		const float *r = &row[(x & 1) * DebayerCpu::kMaxLscWidth];
+		const float g = r[gx] + wx * (r[gx + 1] - r[gx]);
+		const int gain = static_cast<int>(g * one + 0.5f);
+		if (static_cast<unsigned int>(gain) == one)
+			continue;
+
+		int v = debayer_->inputConfig_.bpp == 8 ? p8[x] : p16[x];
+		v = black + (((v - black) * gain) >> shift);
+		v = std::clamp<int>(v, 0, maxValue);
+		if (debayer_->inputConfig_.bpp == 8)
+			p8[x] = static_cast<uint8_t>(v);
+		else
+			p16[x] = static_cast<uint16_t>(v);
+	}
+}
