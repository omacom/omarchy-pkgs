+/**
+ * \brief Prepare the lens shading state for the frame about to be rendered
+ * \param[in] params The debayer parameters published by the IPA
+ *
+ * Resolves which table plane each of the four Bayer sites reads from, and
+ * latches the black level in raw units. Everything else is done per line in
+ * DebayerCpuThread::scaleLine().
+ *
+ * The correction is skipped, with one warning, for CSI-2 packed inputs and for
+ * 4x4 Bayer patterns. Packed data cannot be scaled in place without unpacking
+ * it first, and a 4x4 pattern needs a sixteen way site mapping that no sensor
+ * this correction targets uses.
+ */
+void DebayerCpu::updateLsc(const DebayerParams &params)
+{
+	const int black = std::lround(params.blackLevel.g() *
+				      ((1 << inputConfig_.bpp) - 1));
+
+	if (params.lsc == lscTable_ && black == lscBlack_)
+		return;
+
+	lscTable_ = params.lsc;
+	lscBlack_ = black;
+	lscValid_ = false;
+
+	if (!lscTable_ || !lscTable_->isValid())
+		return;
+
+	/*
+	 * The correction is applied while each input line is copied into the
+	 * thread's line buffer, so that the statistics engine, which reads the
+	 * same buffers, sees corrected data too. With the copy turned off there
+	 * is nowhere to apply it that would not write to the caller's buffer.
+	 */
+	if (!inputMemcpyEnabled_) {
+		LOG(Debayer, Warning)
+			<< "lens shading not applied: software_isp.copy_input_buffer "
+			<< "is disabled";
+		return;
+	}
+
+	if (lscTable_->width > kMaxLscWidth) {
+		LOG(Debayer, Warning)
+			<< "lens shading table too wide (" << lscTable_->width
+			<< " > " << kMaxLscWidth << "), not applied";
+		return;
+	}
+
+	if (inputConfig_.patternSize.width != 2 ||
+	    inputConfig_.patternSize.height != 2 ||
+	    (inputConfig_.bpp != 8 && inputConfig_.bpp != 16)) {
+		LOG(Debayer, Warning)
+			<< "lens shading not applied: input format is packed or "
+			<< "does not use a 2x2 Bayer pattern";
+		return;
+	}
+
+	/*
+	 * Map each of the four Bayer sites of the 2x2 pattern onto the table
+	 * plane it must use. window_.x and window_.y are aligned to the
+	 * pattern size by configure(), so the parity of a window coordinate is
+	 * the parity of the matching input frame coordinate.
+	 */
+	const std::vector<float> *r = &lscTable_->r;
+	const std::vector<float> *g = &lscTable_->g;
+	const std::vector<float> *b = &lscTable_->b;
+
+	switch (bayerOrder_) {
+	case BayerFormat::BGGR:
+		lscPlane_[0][0] = b; lscPlane_[0][1] = g;
+		lscPlane_[1][0] = g; lscPlane_[1][1] = r;
+		break;
+	case BayerFormat::GBRG:
+		lscPlane_[0][0] = g; lscPlane_[0][1] = b;
+		lscPlane_[1][0] = r; lscPlane_[1][1] = g;
+		break;
+	case BayerFormat::GRBG:
+		lscPlane_[0][0] = g; lscPlane_[0][1] = r;
+		lscPlane_[1][0] = b; lscPlane_[1][1] = g;
+		break;
+	case BayerFormat::RGGB:
+		lscPlane_[0][0] = r; lscPlane_[0][1] = g;
+		lscPlane_[1][0] = g; lscPlane_[1][1] = b;
+		break;
+	default:
+		LOG(Debayer, Warning) << "lens shading not applied: unknown Bayer order";
+		return;
+	}
+
+	lscValid_ = true;
+}
