index 10c5e94..23502af 100644
--- c/src/libcamera/shaders/bayer_unpacked.frag
+++ i/src/libcamera/shaders/bayer_unpacked.frag
@@ -30,6 +30,28 @@ uniform vec3            blacklevel;
 uniform float           gamma;
 uniform float           contrastExp;
 
+/*
+ * Lens shading correction. The gains live in an 8 bit RGB texture, encoded
+ * per channel as a LOGARITHM of the gain relative to that channel's minimum:
+ *
+ *     texel = log2(gain / lsc_min) / lsc_log2ratio
+ *     gain  = lsc_min * exp2(texel * lsc_log2ratio)
+ *
+ * A linear encoding would spread the 256 steps evenly in absolute gain, which
+ * is wrong when the table spans 1.0 to 8.7: a step is then 0.03 of gain, worth
+ * 3% where the gain is near unity, and it shows as banding across the middle
+ * of the frame. In log space the step is a constant fraction of the gain, so
+ * the worst case relative error is half a step everywhere: 0.05% for a colour
+ * only table and 0.42% for a full strength one, both comfortably under the
+ * 2.6% the table's own resampling costs.
+ *
+ * lsc_min = 1 and lsc_log2ratio = 0 makes this a no-op.
+ */
+uniform sampler2D       tex_lsc;
+uniform vec3            lsc_min;
+uniform vec3            lsc_log2ratio;
+varying vec2            lscCoord;
+
 float apply_contrast(float value)
 {
     // Apply simple S-curve
@@ -135,6 +157,19 @@ void main(void) {
      */
     rgb = (rgb - blacklevel) / (1.0 - blacklevel);
 
+    /*
+     * Lens shading correction, on the black level corrected signal and before
+     * the white balance gains.
+     *
+     * Applying it to the demosaiced RGB rather than to each Bayer tap is
+     * exact, not an approximation: the demosaic is a fixed linear filter, so
+     * scaling every tap of a channel by one gain is identical to scaling that
+     * channel's output. The only error is that all taps share the gain
+     * sampled at the centre pixel rather than at their own position, which
+     * over the two pixel filter radius is far below the table's own accuracy.
+     */
+    rgb = rgb * (lsc_min * exp2(texture2D(tex_lsc, lscCoord).rgb * lsc_log2ratio));
+
     /* Apply AWB gains, and saturate each channel at sensor range */
     rgb = clamp(rgb * awb, vec3(0.0), vec3(1.0));
 
