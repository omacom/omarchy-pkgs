+/**
+ * \brief Upload the lens shading table as a texture, when it changes
+ * \param[in] params The debayer parameters published by the IPA
+ *
+ * Each channel is encoded as log2(gain / min) / log2(max / min) in an 8 bit
+ * RGB texture, with min and log2(max / min) carried in the lsc_min and
+ * lsc_log2ratio uniforms. See bayer_unpacked.frag for why the encoding is
+ * logarithmic rather than linear: a linear encoding of a table spanning 1.0
+ * to 8.7 quantises to 3% of the gain near the centre of the frame and bands
+ * visibly. Log encoding makes the error a constant fraction of the gain,
+ * 0.05% for a colour only table and 0.42% for a full strength one.
+ *
+ * The table is compared by shared_ptr identity, so a table that has not
+ * changed costs nothing. The IPA only rebuilds it when the estimated colour
+ * temperature moves, so in practice this uploads a handful of times per
+ * session.
+ *
+ * GL_LINEAR filtering does the bilinear interpolation between table nodes in
+ * hardware, which is why the correction is essentially free on this path.
+ */
+void DebayerEGL::updateLscTexture(const DebayerParams &params)
+{
+	if (params.lsc == lscUploaded_)
+		return;
+
+	lscUploaded_ = params.lsc;
+
+	/*
+	 * Only the unpacked Bayer shader carries the correction. The CSI-2
+	 * packed shader unpacks two pixels out of a texel and has no spare
+	 * varying to address the table with, and DebayerCpu skips packed input
+	 * for the matching reason, so both back ends decline the same formats.
+	 * Say so once rather than silently doing nothing.
+	 */
+	if (lscUploaded_ && lscUniformSampler_ < 0) {
+		static bool warned = false;
+		if (!warned) {
+			LOG(Debayer, Warning)
+				<< "lens shading table ignored: the packed Bayer "
+				<< "shader does not implement the correction";
+			warned = true;
+		}
+		return;
+	}
+
+	if (!lscUploaded_ || !lscUploaded_->isValid()) {
+		/* Identity: gain = 1 * exp2(texel * 0) = 1. */
+		for (unsigned int c = 0; c < 3; c++) {
+			lscMin_[c] = 1.0f;
+			lscLog2Ratio_[c] = 0.0f;
+		}
+		return;
+	}
+
+	const LensShadingTable &t = *lscUploaded_;
+	const std::vector<float> *planes[3] = { &t.r, &t.g, &t.b };
+	const size_t n = static_cast<size_t>(t.width) * t.height;
+
+	std::vector<uint8_t> texels(n * 3);
+	for (unsigned int c = 0; c < 3; c++) {
+		const auto [lo, hi] = std::minmax_element(planes[c]->begin(),
+							  planes[c]->end());
+		lscMin_[c] = *lo;
+		lscLog2Ratio_[c] = std::log2(*hi / *lo);
+		const float scale = lscLog2Ratio_[c] > 0.0f
+					    ? 255.0f / lscLog2Ratio_[c]
+					    : 0.0f;
+		for (size_t i = 0; i < n; i++) {
+			const float v =
+				std::log2((*planes[c])[i] / lscMin_[c]) * scale;
+			texels[i * 3 + c] =
+				static_cast<uint8_t>(std::clamp(v + 0.5f, 0.0f, 255.0f));
+		}
+	}
+
+	if (!lscTexture_)
+		glGenTextures(1, &lscTexture_);
+
+	glActiveTexture(GL_TEXTURE0 + kLscTextureUnitId);
+	glBindTexture(GL_TEXTURE_2D, lscTexture_);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, t.width, t.height, 0, GL_RGB,
+		     GL_UNSIGNED_BYTE, texels.data());
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+
+	LOG(Debayer, Debug)
+		<< "uploaded " << t.width << "x" << t.height
+		<< " lens shading table";
+}
