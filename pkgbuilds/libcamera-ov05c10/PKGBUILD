# Maintainer: Meir Dick <mdick85@gmail.com>
#
# libcamera built with a CameraSensorHelper for the OmniVision OV05C10, into a
# private prefix under /usr/lib/libcamera-ov05c10. It does not touch Arch's
# libcamera and does not provide or conflict with it.
#
# Why the helper is needed
# ------------------------
# libcamera 0.7.2's "simple" pipeline handler already lists intel-ipu7 and
# drives the OV05C10 on the HP EliteBook X G2i end to end, with GPU debayer via
# EGL. What it does not have is a sensor helper for this sensor, so
# IPASoftSimple::init() logs
#
#   IPASoft: Failed to create camera sensor helper for ov05c10
#
# and IPASoftSimple::configure() falls into the branch that treats the raw
# V4L2_CID_ANALOGUE_GAIN code as if it were the gain multiplier. AGC then runs
# over a nominal range of 16-248 with a step of 1.0 instead of 1-15.5 with a
# step of 0.145. AE still converges; it converges on the wrong curve.
#
# The gain is linear in 1/16 steps. Intel's ov05c10 driver states both ends:
#
#   #define MAX_ANA_GAIN  0xf8  // 15.5x
#   #define MIN_ANA_GAIN  0x10  // 1x
#
# 0x10/16 == 1 and 0xf8/16 == 15.5, so AnalogueGainLinear{ 1, 0, 0, 16 }.
# The black level of 0x40 at 10 bits (4096 at 16 bits) was measured on this
# sensor from dark frames at minimum exposure and minimum gain: the median is
# exactly 64 in each of the four Bayer channels. The patch carries both.
#
# Nothing here goes to the libcamera mailing list. Omarchy carries this patch
# indefinitely, the way linux-ptl carries its Panther Lake backports, so someone
# inherits it every time libcamera moves. What that costs:
#
#   - Bump pkgver to the new tag and rebuild. The patch is a format-patch
#     against v0.7.2 and will not apply to another tree unchanged, because its
#     trailing context is whichever OmniVision helper follows ov01a10, and that
#     is ov08x40 in 0.7.2 but ov08d10 in anything newer.
#   - To regenerate it: check out the new tag, paste the CameraSensorHelperOv05c10
#     block into src/ipa/libipa/camera_sensor_helper.cpp immediately after
#     REGISTER_CAMERA_SENSOR_HELPER("ov01a10", ...) -- ov05c10 sorts after
#     ov01a10, not before it -- commit, and git format-patch -1.
#   - Check that AnalogueGainLinear still means (m0*code + c0) / (m1*code + c1)
#     and that blackLevel_ is still 16-bit. Both are libipa internals with no
#     stability promise, and a silent change to either gives wrong exposure
#     rather than a build failure.
#   - Re-run the offline check afterwards. It has to keep printing
#     "gain 1-15.5 (0.145)"; anything else means the model broke.
#
# If libcamera ever grows its own ov05c10 helper the patch stops applying, and
# that is the signal to delete this package rather than rebase it -- but do not
# plan around that happening.
#
# Why a private prefix and not a replacement libcamera
# ----------------------------------------------------
# CameraSensorHelper is not in libcamera.so. It lives in libipa, a static
# library that is linked into each IPA module, so the only object that has to
# change is ipa_soft_simple.so. That looks like it should be shippable on its
# own, and it nearly is, but for signing: libcamera verifies IPA modules against
# a public key compiled into libcamera.so, and Arch generates that keypair
# inside libcamera's build tree and throws the private half away. Any IPA module
# built separately therefore fails IPAManager::isSignatureValid() and is loaded
# through T::Isolated instead of T::Threaded, in a separate process. An IPA-only
# package would also have to pin Arch's libcamera to an exact version, because
# the IPA interface is not ABI-stable across releases.
#
# Replacing Arch's libcamera instead would keep the signature valid, but it
# means shadowing a package that pipewire-libcamera links against on every
# machine that installs this, for the sake of one sensor on one laptop.
#
# What such a replacement would not do is put a broken camera in the portal
# picker, which was the worry. 71-ipu7-hide-isys.rules leaves the ISYS capture
# nodes root-only while logind's uaccess ACL still hands the seat user
# /dev/media0 and the subdevs, so a user-session consumer can walk the graph but
# not open the capture node. SimplePipelineHandler::matchDevice() opens every
# entity before it calls SimpleCameraData::init(), and a failed V4L2VideoDevice
# open makes it return false, so no camera is ever registered: one error line,
# no phantom device. Nor does it disturb a running capture on the way past --
# the one destructive call in that loop, resetRoutingTable(), is gated on
# V4L2_SUBDEV_CAP_STREAMS, and VIDIOC_SUBDEV_QUERYCAP reports 0x0 on all five
# subdevs here. The case against replacing libcamera is version shadowing and
# blast radius, not portal breakage.
#
# A private prefix has neither problem. It builds its own keypair, so the IPA is
# signed and runs in-process, which is the configuration the 0.8-core figure was
# measured in. It owns no file that any other package owns. Nothing that does
# not deliberately point at it can be affected by it.
#
# The cost is that it only helps consumers that opt in. That suits this machine:
# the camera is published on a v4l2loopback device, so pipewire and Chrome see
# V4L2 and never touch libcamera. Point a consumer at it with
#
#   LD_LIBRARY_PATH=/usr/lib/libcamera-ov05c10/lib
#
# or link against the .pc files in /usr/lib/libcamera-ov05c10/lib/pkgconfig.
# libcamera-ov05c10-cam is a wrapper that does this for the "cam" tool.
#
# Tuning data is deliberately not shipped here. sysconfdir is /etc, so this
# build reads /etc/libcamera/ipa/simple/<sensor>.yaml before its own datadir,
# which is where machine-local tuning belongs and where Arch's libcamera will
# also find it.

pkgname=libcamera-ov05c10
pkgver=0.7.2
pkgrel=3
pkgdesc="libcamera with the OV05C10 sensor helper, in a private prefix"
arch=('x86_64')
url="https://libcamera.org/"
license=(
  'Apache-2.0'
  'BSD-2-Clause'
  'CC0-1.0'
  'GPL-2.0-or-later'
  'LGPL-2.1-or-later'
)
depends=(
  'gcc-libs'
  'glibc'
  'gnutls'
  'libdrm'
  'libevent'
  'libglvnd'
  'libunwind'
  'libyaml'
  'libyuv'
  'sh'
  'systemd-libs'
)
makedepends=(
  'git'
  'meson'
  'openssl'
  'python-jinja'
  'python-ply'
  'python-pyyaml'
)
# The IPA modules are signed at the end of build(), and stripping a signed
# module invalidates the signature. Strip and re-sign by hand in package()
# instead, the same way Arch's libcamera-ipa does it.
options=('!strip' '!debug')

_prefix=/usr/lib/libcamera-ov05c10

# Same origin and tag Arch's libcamera 0.7.2 builds from.
source=(
  "libcamera::git+https://git.libcamera.org/libcamera/libcamera.git#tag=v${pkgver}"
  '0001-libipa-camera_sensor_helper-Add-ov05c10.patch'
  '0002-software-isp-lens-shading-correction.patch'
  '0003-swstats-apply-lens-shading-to-statistics.patch'
  '0004-ipa-simple-harden-lsc-crop-mapping.patch'
  '0005-ipa-simple-lsc-separate-colour-strength.patch'
)
sha256sums=('SKIP'
            '3289bfbe34c1c289042d40c031c4164068b279b4941a933701c7ef183f7155da'
            '917f4a5618f74323749c20288deb29c14dc600ad979955bd49eefa0f418212b2'
            '36932ea46a57ef4a0e8b4c1eee6aa2646c30bfe9db01ea4b134e29bd5cc15a89'
            '5ac91f3460ba1e8dc9d3ded81572c2dcacd472074aceca1bef5fdbc0544f9d88'
            '46ec2bd9832c54808e760b37f9ae6c01a6960c46b240bac9acb74792aeac27a1')

prepare() {
  cd libcamera
  patch -Np1 -i "../0001-libipa-camera_sensor_helper-Add-ov05c10.patch"
  # Lens shading. HP's tables ask for up to 8.65x at the corner with the four
  # Bayer channels differing by ~13%, and 0.7.2's simple IPA has no shading
  # algorithm at all, so the corners are colour-shifted and grey-world AWB
  # integrates that bias into a wrong white point.
  patch -Np1 -i "../0002-software-isp-lens-shading-correction.patch"
  # The EGL back end computes statistics in a separate CPU pass over the raw
  # input, so without this the shader's correction never reaches AWB and the
  # white point stays biased on the path this machine actually uses.
  patch -Np1 -i "../0003-swstats-apply-lens-shading-to-statistics.patch"
  # ov05c10 reports an empty analog crop with a success return, which defeats
  # libcamera's fallback and leaves PixelArrayActiveAreas as 0x0. The mapping is
  # correct here by luck of a guard; this makes it say so at Info instead.
  patch -Np1 -i "../0004-ipa-simple-harden-lsc-crop-mapping.patch"
  # Separate colourStrength from luminanceStrength. HP calibrated no LED source,
  # and under the LED light this machine actually sits under the colour half of
  # the tables over-corrects red about sixfold -- measured on a flat field as
  # 1.93x worse than leaving it alone. The two halves need independent knobs.
  patch -Np1 -i "../0005-ipa-simple-lsc-separate-colour-strength.patch"

  # utils/gen-version.sh reads this when there is no git describe to lean on.
  printf "%s\n" "$pkgver" > .tarball-version
}

build() {
  # Only the simple pipeline handler and the software IPA are built. Nothing
  # else here can drive an IPU7, and every extra module is another file to keep
  # in step with a libcamera this package deliberately does not own.
  local meson_options=(
    --prefix "$_prefix"
    --sysconfdir /etc
    --buildtype release
    -D pipelines=simple
    -D ipas=simple
    -D cam=enabled
    -D documentation=disabled
    -D gstreamer=disabled
    -D lc-compliance=disabled
    -D pycamera=disabled
    -D qcam=disabled
    -D test=false
    -D tracing=disabled
    -D v4l2=false
  )

  meson setup build libcamera "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  # Strip, then re-sign: meson's ipa-sign-install.sh has already signed the
  # installed module, and stripping invalidates that signature. The private key
  # exists only inside this build tree, which is the whole reason this package
  # ships its own libcamera.so as well.
  #
  # bin/ holds libcamera-bug-report, which is a script, so pick ELF files by
  # inspection rather than by glob.
  local _ipa_dir="$pkgdir$_prefix/lib/libcamera/ipa"
  local _f
  while IFS= read -r -d '' _f; do
    strip --strip-unneeded "$_f"
  done < <(find "$pkgdir$_prefix" -type f \
    -exec sh -c 'head -c4 "$1" | grep -q "^.ELF"' _ {} \; -print0)

  local _key
  _key=$(find build -type f -iname '*ipa-priv-key.pem' -print -quit)
  [[ -n $_key ]] || return 1
  local _lib
  for _lib in "$_ipa_dir"/*.so; do
    libcamera/src/ipa/ipa-sign.sh "$_key" "$_lib" "$_lib.sign"
  done

  # cam(1) from a private prefix cannot find its own libcamera.so, and meson
  # drops the build-tree rpath on install. A wrapper is clearer than an rpath
  # that only ever points at one directory.
  install -dm755 "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/libcamera-ov05c10-cam" <<EOF
#!/bin/sh
export LD_LIBRARY_PATH="$_prefix/lib\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
exec "$_prefix/bin/cam" "\$@"
EOF
  chmod 755 "$pkgdir/usr/bin/libcamera-ov05c10-cam"

  install -Dm644 libcamera/LICENSES/{BSD-2-Clause,LGPL-2.1-or-later}.txt \
    -t "$pkgdir/usr/share/licenses/$pkgname/"
}
