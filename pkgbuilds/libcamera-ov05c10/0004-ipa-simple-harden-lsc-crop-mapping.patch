 	/*
-	 * The tables cover the sensor active area. The frame covers the
+	 * The tables cover the sensor active area; the frame covers the
 	 * analogue crop of it, so map one onto the other.
 	 *
-	 * The debayer additionally trims a two pixel border off the frame
-	 * before it renders. That is not accounted for here: on this class of
-	 * sensor it shifts the sampling point of a table node by well under
-	 * a thousandth of the frame width, which is far below the accuracy of
-	 * the tables themselves.
+	 * A driver with no crop support is meant to fail the
+	 * V4L2_SEL_TGT_CROP ioctl, in which case CameraSensor defaults
+	 * analogCrop to the active area and everything downstream is fine. A
+	 * driver that answers the ioctl successfully but hands back an empty
+	 * rectangle defeats that fallback: libcamera only checks the return
+	 * code, so the empty rectangle arrives here verbatim. When the driver
+	 * answers V4L2_SEL_TGT_CROP_DEFAULT the same way, activeAreaSize is
+	 * empty too. The ov05c10 this was written for does exactly that: its
+	 * get_selection() returns the subdev state crop, which set_format()
+	 * never populates, so both come through as 0x0.
+	 *
+	 * Treat a degenerate rectangle as "the frame is the whole active
+	 * area", which is what a sensor reading out its full array produces.
+	 * The alternative is a division by zero and a correction mapped onto
+	 * the wrong part of the frame.
 	 */
-	if (info.activeAreaSize.width && info.activeAreaSize.height &&
-	    info.analogCrop.width && info.analogCrop.height) {
+	const bool haveCrop = info.activeAreaSize.width && info.activeAreaSize.height &&
+			      info.analogCrop.width && info.analogCrop.height;
+
+	if (haveCrop) {
 		cropX_ = static_cast<float>(info.analogCrop.x) / info.activeAreaSize.width;
 		cropY_ = static_cast<float>(info.analogCrop.y) / info.activeAreaSize.height;
 		cropW_ = static_cast<float>(info.analogCrop.width) / info.activeAreaSize.width;
 		cropH_ = static_cast<float>(info.analogCrop.height) / info.activeAreaSize.height;
+
+		/*
+		 * A crop reaching outside the active area cannot be right.
+		 * Sampling clamps anyway, but say so rather than quietly
+		 * flattening the edge of the table.
+		 */
+		if (cropX_ < 0.0f || cropY_ < 0.0f ||
+		    cropX_ + cropW_ > 1.0f + 1e-3f ||
+		    cropY_ + cropH_ > 1.0f + 1e-3f) {
+			LOG(IPASoftLsc, Warning)
+				<< "analogue crop " << info.analogCrop
+				<< " lies outside the active area "
+				<< info.activeAreaSize
+				<< "; the shading table will be clamped at the edges";
+		}
 	} else {
