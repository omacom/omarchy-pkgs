diff --git a/drivers/gpu/drm/i915/display/intel_dp.c b/drivers/gpu/drm/i915/display/intel_dp.c
--- a/drivers/gpu/drm/i915/display/intel_dp.c
+++ b/drivers/gpu/drm/i915/display/intel_dp.c
@@ -2936,7 +2936,11 @@
 		&pipe_config->hw.adjusted_mode;
 	struct intel_dp *intel_dp = enc_to_intel_dp(encoder);
 	struct link_config_limits limits;
-	bool dsc_needed, joiner_needs_dsc;
+	bool dsc_needed, joiner_needs_dsc, dsc_preferred = false;
+	int uncompressed_bpp = 0, uncompressed_clock = 0, uncompressed_lanes = 0;
+	typeof(pipe_config->dsc) uncompressed_dsc = {};
+	bool uncompressed_fec_enable = false;
+	int entry_bpp = pipe_config->pipe_bpp;
 	int ret = 0;
 
 	intel_dp_dsc_reset_config(pipe_config);
@@ -2971,6 +2975,18 @@
 					   0,
 					   num_joined_pipes))
 			dsc_needed = true;
+		else if (intel_dp_is_edp(intel_dp) &&
+			 pipe_config->pipe_bpp < 8 * 3 &&
+			 pipe_config->pipe_bpp < limits.pipe.max_bpp &&
+			 intel_dp_supports_dsc(intel_dp, connector, pipe_config)) {
+			/* Prefer DSC to reducing eDP color depth below 8 bpc. */
+			uncompressed_dsc = pipe_config->dsc;
+			uncompressed_fec_enable = pipe_config->fec_enable;
+			uncompressed_bpp = pipe_config->pipe_bpp;
+			uncompressed_clock = pipe_config->port_clock;
+			uncompressed_lanes = pipe_config->lane_count;
+			dsc_preferred = true;
+		}
 	}
 
 	if (dsc_needed && !intel_dp_supports_dsc(intel_dp, connector, pipe_config)) {
@@ -2978,33 +2994,64 @@
 		return -EINVAL;
 	}
 
-	if (dsc_needed) {
+	if (dsc_needed || dsc_preferred) {
 		int dsc_slice_count;
 
 		drm_dbg_kms(display->drm,
-			    "Try DSC (fallback=%s, joiner=%s, force=%s)\n",
+			    "Try DSC (fallback=%s, joiner=%s, force=%s, preferred=%s)\n",
 			    str_yes_no(ret), str_yes_no(joiner_needs_dsc),
-			    str_yes_no(intel_dp->force_dsc_en));
-
-		if (!intel_dp_compute_config_limits(intel_dp, conn_state, pipe_config,
-						    respect_downstream_limits,
-						    true,
-						    &limits))
-			return -EINVAL;
-
-		ret = intel_dp_dsc_compute_config(intel_dp, pipe_config,
-						  conn_state, &limits, 64);
-		if (ret < 0)
-			return ret;
-
-		dsc_slice_count = intel_dsc_line_slice_count(&pipe_config->dsc.slice_config);
-
-		if (!intel_dp_dotclk_valid(display,
-					   adjusted_mode->crtc_clock,
-					   adjusted_mode->crtc_htotal,
-					   dsc_slice_count,
-					   num_joined_pipes))
-			return -EINVAL;
+			    str_yes_no(intel_dp->force_dsc_en),
+			    str_yes_no(dsc_preferred));
+
+		ret = -EINVAL;
+
+		/*
+		 * Restore the requested depth before computing DSC limits. The
+		 * uncompressed search may have reduced pipe_bpp to fit the link.
+		 */
+		if (dsc_preferred)
+			pipe_config->pipe_bpp = entry_bpp;
+
+		if (intel_dp_compute_config_limits(intel_dp, conn_state, pipe_config,
+						   respect_downstream_limits,
+						   true,
+						   &limits)) {
+			ret = intel_dp_dsc_compute_config(intel_dp, pipe_config,
+							  conn_state, &limits, 64);
+
+			if (ret >= 0) {
+				dsc_slice_count =
+					intel_dsc_line_slice_count(&pipe_config->dsc.slice_config);
+
+				if (!intel_dp_dotclk_valid(display,
+							   adjusted_mode->crtc_clock,
+							   adjusted_mode->crtc_htotal,
+							   dsc_slice_count,
+							   num_joined_pipes))
+					ret = -EINVAL;
+			}
+		}
+
+		if (ret < 0) {
+			/* Required DSC has no uncompressed fallback. */
+			if (dsc_needed)
+				return ret;
+
+			/* Keep the valid uncompressed configuration if DSC fails. */
+			drm_dbg_kms(display->drm,
+				    "DSC preferred but not usable, keeping %d bpp uncompressed\n",
+				    uncompressed_bpp);
+
+			/*
+			 * Restore all DSC state, including compression_enabled_on_link
+			 * set before the final dotclock check.
+			 */
+			pipe_config->dsc = uncompressed_dsc;
+			pipe_config->fec_enable = uncompressed_fec_enable;
+			pipe_config->pipe_bpp = uncompressed_bpp;
+			pipe_config->port_clock = uncompressed_clock;
+			pipe_config->lane_count = uncompressed_lanes;
+		}
 	}
 
 	drm_dbg_kms(display->drm,
