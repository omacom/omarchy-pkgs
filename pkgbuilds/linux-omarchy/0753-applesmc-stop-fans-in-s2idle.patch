diff --git a/drivers/hwmon/applesmc.c b/drivers/hwmon/applesmc.c
--- a/drivers/hwmon/applesmc.c
+++ b/drivers/hwmon/applesmc.c
@@ -33,6 +33,7 @@
 #include <linux/workqueue.h>
 #include <linux/err.h>
 #include <linux/bits.h>
+#include <linux/suspend.h>
 #include <asm/barrier.h>
 
 /* data port used by Apple SMC */
@@ -685,9 +686,55 @@ static int applesmc_probe(struct platform_device *dev)
 	return 0;
 }
 
+/*
+ * In suspend-to-idle the SMC still treats the machine as running and
+ * keeps the fans at their minimum speed. Put every fan in manual mode
+ * with a zero target for the sleep, and give the SMC back its previous
+ * mode on resume. Fans already in manual mode are left alone.
+ */
+static u8 fans_manual_saved[2];
+static bool fans_stopped;
+
+static int applesmc_pm_suspend(struct device *dev)
+{
+	const u8 zero[2] = { 0, 0 };
+	u8 buffer[2];
+	char key[5];
+	u16 mask;
+	int i;
+
+	fans_stopped = false;
+	if (pm_suspend_target_state != PM_SUSPEND_TO_IDLE || !smcreg.fan_count)
+		return 0;
+
+	if (applesmc_read_key(FANS_MANUAL, fans_manual_saved, 2))
+		return 0;
+	if (fans_manual_saved[0] || fans_manual_saved[1])
+		return 0;
+
+	mask = GENMASK(smcreg.fan_count - 1, 0);
+	buffer[0] = mask >> 8;
+	buffer[1] = mask & 0xff;
+	if (applesmc_write_key(FANS_MANUAL, buffer, 2))
+		return 0;
+	fans_stopped = true;
+
+	for (i = 0; i < smcreg.fan_count; i++) {
+		scnprintf(key, sizeof(key), fan_speed_fmt[4], i);
+		applesmc_write_key(key, zero, 2);
+	}
+
+	dev_dbg(dev, "fans stopped for suspend-to-idle\n");
+	return 0;
+}
+
 /* Synchronize device with memorized backlight state */
 static int applesmc_pm_resume(struct device *dev)
 {
+	if (fans_stopped) {
+		applesmc_write_key(FANS_MANUAL, fans_manual_saved, 2);
+		fans_stopped = false;
+	}
 	if (smcreg.has_key_backlight)
 		applesmc_write_key(BACKLIGHT_KEY, backlight_state, 2);
 	return 0;
@@ -701,6 +748,7 @@ static int applesmc_pm_restore(struct device *dev)
 }
 
 static const struct dev_pm_ops applesmc_pm_ops = {
+	.suspend = applesmc_pm_suspend,
 	.resume = applesmc_pm_resume,
 	.restore = applesmc_pm_restore,
 };
