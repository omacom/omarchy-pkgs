From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Meir Dick <mdick85@gmail.com>
Date: Sun, 9 Aug 2026 14:48:00 -0400
Subject: [PATCH] ASoC: Intel: soc-acpi-intel-ptl-match: add HP EliteBook X G2i

The HP EliteBook X G2i (board 8E86) pairs a plain RT712 SDCA codec on
link 3 with four TAS2783A amplifiers on link 2. No entry in the Panther
Lake match table describes that combination, so sof_sdw never
instantiates the amplifiers and the card comes up with no Speaker
device.

Add the machine. The amplifier addresses are the live enumeration on
this board, sdw:0:2:0102:0000:01:{9,a,c,d}: unique_id 0x9, 0xA, 0xC and
0xD with TI vendor_id 0x0102 and part_id 0x0000 (TAS2783A).

Two details are commented in place. The amplifier name_prefix values
must be "tas2783-1" through "tas2783-4", because
asoc_sdw_ti_spk_rtd_init() compares those literal strings and returns
-EINVAL for anything else. The RT712 endpoints use AIF1 for the jack
(num 0) and AIF3 for the microphone (num 2); AIF2 is the codec's own
amplifier, unused on a board with external amplification. RT712 shares
that AIF layout with RT721, so the endpoints follow the AMD PX13
rt721+tas2783x2 machine.

The order of the amplifier array is load-bearing for stereo. The bus
packs stream slots in codec-list order and asoc_sdw_ti_spk_rtd_init()
derives each part's side from its name_prefix, so the array lists the
amplifiers left, right, left, right by physical side. On this board the
enumerated unique ids run 0x9 and 0xA on the right and 0xC and 0xD on
the left, so the order is 0xC, 0x9, 0xD, 0xA.

There is no monolithic topology for this combination. A "dummy"
topology name makes sof_test_topology_file() skip its existence check
and snd_sof_load_topology() require the function topologies, which
get_function_tplg_files() then loads. That is the same convention
hda_sdw_machine_select() uses for its generic SoundWire machine.

This is a stopgap and is not submitted upstream. Intel's position
(Bard Liao, linux-sound, 2026-06-29) is that new Panther Lake match
table entries are not taken because the SOF driver generates the
machine description from the SDCA function data the BIOS exposes.
That generator does not enumerate the four amplifiers on this board
with the shipped BIOS; Canonical's LP#2164504 reports that HP BIOS
Y90 99.15.23 adds the missing SDCA function-type DC value, after
which the generated machine may cover the board and this entry can
be dropped. Not verified here; the reference board runs Y90 01.01.18.

Signed-off-by: Meir Dick <mdick85@gmail.com>
---
 .../intel/common/soc-acpi-intel-ptl-match.c   | 103 ++++++++++++++++++
 1 file changed, 103 insertions(+)

diff --git a/sound/soc/intel/common/soc-acpi-intel-ptl-match.c b/sound/soc/intel/common/soc-acpi-intel-ptl-match.c
index 756bbf8..34ea7ad 100644
--- a/sound/soc/intel/common/soc-acpi-intel-ptl-match.c
+++ b/sound/soc/intel/common/soc-acpi-intel-ptl-match.c
@@ -92,6 +92,40 @@ static const struct snd_soc_acpi_endpoint spk_r_endpoint = {
 	.group_id = 1,
 };
 
+static const struct snd_soc_acpi_endpoint spk_2_endpoint = {
+	.num = 0,
+	.aggregated = 1,
+	.group_position = 2,
+	.group_id = 1,
+};
+
+static const struct snd_soc_acpi_endpoint spk_3_endpoint = {
+	.num = 0,
+	.aggregated = 1,
+	.group_position = 3,
+	.group_id = 1,
+};
+
+/*
+ * Plain (non-VB) RT712 with external amplification: AIF1 is the jack
+ * (num 0) and AIF3 the microphone (num 2). AIF2 (num 1) is the codec's
+ * own amplifier and is not used. Same AIF layout as RT721.
+ */
+static const struct snd_soc_acpi_endpoint rt712_endpoints[] = {
+	{
+		.num = 0,
+		.aggregated = 0,
+		.group_position = 0,
+		.group_id = 0,
+	},
+	{
+		.num = 2,
+		.aggregated = 0,
+		.group_position = 0,
+		.group_id = 0,
+	},
+};
+
 static const struct snd_soc_acpi_endpoint jack_dmic_endpoints[] = {
 	/* Jack Endpoint */
 	{
@@ -211,6 +245,52 @@ static const struct snd_soc_acpi_adr_device rt712_vb_3_group1_adr[] = {
 	}
 };
 
+static const struct snd_soc_acpi_adr_device rt712_3_single_adr[] = {
+	{
+		.adr = 0x000330025D071201ull,
+		.num_endpoints = ARRAY_SIZE(rt712_endpoints),
+		.endpoints = rt712_endpoints,
+		.name_prefix = "rt712"
+	}
+};
+
+/*
+ * Four TAS2783A on link 2, unique_id 0x9/0xA/0xC/0xD. The name_prefix
+ * must be "tas2783-1".."tas2783-4": asoc_sdw_ti_spk_rtd_init() matches
+ * those strings, derives the side from them ("-1" and "-3" left, "-2"
+ * and "-4" right) and rejects anything else.
+ *
+ * The bus packs stream slots in this order, so the array lists the
+ * amplifiers left, right, left, right by physical side. On this board
+ * 0x9 and 0xA are the right woofer and tweeter, 0xC and 0xD the left.
+ */
+static const struct snd_soc_acpi_adr_device tas2783_2_quad_adr[] = {
+	{
+		.adr = 0x00023C0102000001ull,	/* uid 0xC, left woofer */
+		.num_endpoints = 1,
+		.endpoints = &spk_l_endpoint,
+		.name_prefix = "tas2783-1"
+	},
+	{
+		.adr = 0x0002390102000001ull,	/* uid 0x9, right woofer */
+		.num_endpoints = 1,
+		.endpoints = &spk_r_endpoint,
+		.name_prefix = "tas2783-2"
+	},
+	{
+		.adr = 0x00023D0102000001ull,	/* uid 0xD, left tweeter */
+		.num_endpoints = 1,
+		.endpoints = &spk_2_endpoint,
+		.name_prefix = "tas2783-3"
+	},
+	{
+		.adr = 0x00023A0102000001ull,	/* uid 0xA, right tweeter */
+		.num_endpoints = 1,
+		.endpoints = &spk_3_endpoint,
+		.name_prefix = "tas2783-4"
+	},
+};
+
 static const struct snd_soc_acpi_adr_device rt713_vb_2_adr[] = {
 	{
 		.adr = 0x000230025d071301ull,
@@ -423,6 +503,21 @@ static const struct snd_soc_acpi_link_adr ptl_sdw_rt712_vb_l3_rt1320_l2[] = {
 	{}
 };
 
+/* HP EliteBook X G2i (board 8E86): plain RT712 (l3) + 4x TAS2783A (l2) */
+static const struct snd_soc_acpi_link_adr ptl_sdw_rt712_l3_tas2783_l2[] = {
+	{
+		.mask = BIT(3),
+		.num_adr = ARRAY_SIZE(rt712_3_single_adr),
+		.adr_d = rt712_3_single_adr,
+	},
+	{
+		.mask = BIT(2),
+		.num_adr = ARRAY_SIZE(tas2783_2_quad_adr),
+		.adr_d = tas2783_2_quad_adr,
+	},
+	{}
+};
+
 static const struct snd_soc_acpi_link_adr ptl_sdw_rt712_vb_l3_rt1320_l3[] = {
 	{
 		.mask = BIT(3),
@@ -510,6 +605,14 @@ struct snd_soc_acpi_mach snd_soc_acpi_intel_ptl_sdw_machines[] = {
 		.sof_tplg_filename = "sof-ptl-rt712-l3-rt1320-l2.tplg",
 		.get_function_tplg_files = sof_sdw_get_tplg_files,
 	},
+	{
+		.link_mask = BIT(2) | BIT(3),
+		.links = ptl_sdw_rt712_l3_tas2783_l2,
+		.drv_name = "sof_sdw",
+		/* No monolithic topology: function topologies are required */
+		.sof_tplg_filename = "sof-ptl-rt712-l3-tas2783-l2-dummy.tplg",
+		.get_function_tplg_files = sof_sdw_get_tplg_files,
+	},
 	{
 		.link_mask = BIT(2) | BIT(3),
 		.links = ptl_cs42l43_agg_l3_cs35l56_l2,
