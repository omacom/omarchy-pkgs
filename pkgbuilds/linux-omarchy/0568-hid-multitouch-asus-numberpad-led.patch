diff --git a/drivers/hid/hid-multitouch.c b/drivers/hid/hid-multitouch.c
--- a/drivers/hid/hid-multitouch.c
+++ b/drivers/hid/hid-multitouch.c
@@ -39,6 +39,7 @@
 #include <linux/slab.h>
 #include <linux/input/mt.h>
 #include <linux/jiffies.h>
+#include <linux/leds.h>
 #include <linux/string.h>
 #include <linux/timer.h>
 
@@ -185,6 +186,9 @@ struct mt_device {
 	bool is_haptic_touchpad;	/* is this device a haptic touchpad? */
 	bool serial_maybe;	/* need to check for serial protocol */
 
+	struct led_classdev numberpad_led;	/* ASUS NumberPad backlight */
+	bool has_numberpad_led;
+
 	struct list_head applications;
 	struct list_head reports;
 };
@@ -2098,6 +2102,87 @@ static void mt_expired_timeout(struct ti
 	clear_bit_unlock(MT_IO_FLAGS_RUNNING, &td->mt_io_flags);
 }
 
+/*
+ * ASUS NumberPad: some ASUS touchpads have an LED-lit numeric keypad printed
+ * under the glass. The firmware keeps reporting plain touches whatever the LED
+ * state (mapping touches to keys is left to userspace), so the only thing to
+ * drive is the backlight: vendor feature report 0x0d, payload 14 03 <val> ad,
+ * where <val> is 0x00 (off), 0x01 (on) or 0x41..0x48 (brightness).
+ */
+#define MT_ASUS_NUMBERPAD_REPORT_ID	0x0d
+#define MT_ASUS_NUMBERPAD_OFF		0x00
+#define MT_ASUS_NUMBERPAD_ON		0x01
+#define MT_ASUS_NUMBERPAD_LEVEL_BASE	0x40
+#define MT_ASUS_NUMBERPAD_LEVELS	8
+
+static const struct hid_device_id mt_asus_numberpad_ids[] = {
+	/* ASUP1415, ASUS Zenbook 14 UX3405 */
+	{ HID_DEVICE(BUS_I2C, HID_GROUP_ANY, USB_VENDOR_ID_PIXART, 0x300c) },
+	{ }
+};
+
+static int mt_asus_numberpad_send(struct hid_device *hdev, u8 value)
+{
+	const u8 cmd[] = { MT_ASUS_NUMBERPAD_REPORT_ID, 0x14, 0x03, value, 0xad };
+	u8 *buf;
+	int ret;
+
+	buf = kmemdup(cmd, sizeof(cmd), GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	ret = hid_hw_raw_request(hdev, MT_ASUS_NUMBERPAD_REPORT_ID, buf,
+				 sizeof(cmd), HID_FEATURE_REPORT,
+				 HID_REQ_SET_REPORT);
+	kfree(buf);
+
+	return ret < 0 ? ret : 0;
+}
+
+static int mt_asus_numberpad_set(struct led_classdev *led,
+				 enum led_brightness brightness)
+{
+	struct mt_device *td = container_of(led, struct mt_device,
+					    numberpad_led);
+	int ret;
+
+	if (!brightness)
+		return mt_asus_numberpad_send(td->hdev, MT_ASUS_NUMBERPAD_OFF);
+
+	ret = mt_asus_numberpad_send(td->hdev, MT_ASUS_NUMBERPAD_ON);
+	if (ret)
+		return ret;
+
+	return mt_asus_numberpad_send(td->hdev,
+				      MT_ASUS_NUMBERPAD_LEVEL_BASE + brightness);
+}
+
+static void mt_asus_numberpad_init(struct mt_device *td)
+{
+	struct hid_device *hdev = td->hdev;
+	struct hid_report *report;
+	int ret;
+
+	if (!IS_REACHABLE(CONFIG_LEDS_CLASS) ||
+	    !hid_match_id(hdev, mt_asus_numberpad_ids))
+		return;
+
+	report = hdev->report_enum[HID_FEATURE_REPORT].report_id_hash[MT_ASUS_NUMBERPAD_REPORT_ID];
+	if (!report || hid_report_len(report) != 5)
+		return;
+
+	td->numberpad_led.name = "asus::numberpad";
+	td->numberpad_led.max_brightness = MT_ASUS_NUMBERPAD_LEVELS;
+	td->numberpad_led.brightness_set_blocking = mt_asus_numberpad_set;
+	td->numberpad_led.flags = LED_CORE_SUSPENDRESUME;
+
+	ret = led_classdev_register(&hdev->dev, &td->numberpad_led);
+	if (ret)
+		hid_warn(hdev, "cannot register NumberPad LED: %d\n", ret);
+	else
+		td->has_numberpad_led = true;
+}
+
 static int mt_probe(struct hid_device *hdev, const struct hid_device_id *id)
 {
 	int ret, i;
@@ -2200,6 +2285,8 @@ static int mt_probe(struct hid_device *h
 		devm_kfree(&hdev->dev, td->haptic);
 	}
 
+	mt_asus_numberpad_init(td);
+
 	return 0;
 }
 
@@ -2243,6 +2330,10 @@ static void mt_remove(struct hid_device
 
 	timer_delete_sync(&td->release_timer);
 
+	/* turns the LEDs off, so the hardware must still be running */
+	if (td->has_numberpad_led)
+		led_classdev_unregister(&td->numberpad_led);
+
 	sysfs_remove_group(&hdev->dev.kobj, &mt_attribute_group);
 	hid_hw_stop(hdev);
 }
