From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Meir Dick <mdick85@gmail.com>
Date: Wed, 16 Sep 2026 17:46:05 -0400
Subject: [PATCH] ASoC: sdw_utils: let a firmware-described TAS2783 keep the
 whole port

asoc_sdw_ti_spk_rtd_init() narrows every TAS2783 to one channel of the
stereo stream, so that several parts on one link carry different
channels. That assumes the part plays whatever single channel it is
given, which holds when the driver initialises the part from its fixed
register sequence: that sequence sets the same DSP posture on every
part, and every part then reads the first channel it receives.

When platform firmware describes the part's SmartAmp function, the
driver initialises it from that description instead, and the posture
its firmware image programmed survives. On the HP EliteBook X G2i
(BIOS 01.02.02) the two right-hand parts keep posture 4, which reads
the second channel of the port. Narrowed to one channel, they read an
empty slot and the right side is silent. Fed the whole stereo port,
each part picks its own side and the link mirrors the stream to all of
them.

Skip the channel restriction for a part whose SoundWire peripheral
carries a SmartAmp SDCA function. Parts without one keep the current
behaviour.

Signed-off-by: Meir Dick <mdick85@gmail.com>
---
 sound/soc/sdw_utils/soc_sdw_ti_amp.c | 50 ++++++++++++++++++++++++----
 1 file changed, 44 insertions(+), 6 deletions(-)

diff --git a/sound/soc/sdw_utils/soc_sdw_ti_amp.c b/sound/soc/sdw_utils/soc_sdw_ti_amp.c
index a9a945d..134b03c 100644
--- a/sound/soc/sdw_utils/soc_sdw_ti_amp.c
+++ b/sound/soc/sdw_utils/soc_sdw_ti_amp.c
@@ -8,7 +8,11 @@
 #include <linux/device.h>
 #include <linux/errno.h>
 #include <linux/input.h>
+#include <linux/soundwire/sdw.h>
+#include <linux/soundwire/sdw_type.h>
 #include <sound/jack.h>
+#include <sound/sdca.h>
+#include <sound/sdca_function.h>
 #include <sound/soc-acpi.h>
 #include <sound/soc-dai.h>
 #include <sound/soc.h>
@@ -40,6 +44,29 @@ int asoc_sdw_ti_amp_initial_settings(struct snd_soc_card *card,
 }
 EXPORT_SYMBOL_NS(asoc_sdw_ti_amp_initial_settings, "SND_SOC_SDW_UTILS");
 
+/*
+ * True when platform firmware describes the part's SmartAmp function, in
+ * which case the part is initialised from that description rather than
+ * from the driver's fixed sequence.
+ */
+static bool asoc_sdw_ti_amp_self_routed(struct snd_soc_dai *codec_dai)
+{
+	struct device *dev = codec_dai->dev;
+	struct sdw_slave *slave;
+	int i;
+
+	if (!is_sdw_slave(dev))
+		return false;
+
+	slave = dev_to_sdw_dev(dev);
+	for (i = 0; i < slave->sdca_data.num_functions; i++)
+		if (slave->sdca_data.function[i].type ==
+		    SDCA_FUNCTION_TYPE_SMART_AMP)
+			return true;
+
+	return false;
+}
+
 int asoc_sdw_ti_spk_rtd_init(struct snd_soc_pcm_runtime *rtd,
 			     struct snd_soc_dai *dai)
 {
@@ -83,14 +110,25 @@ int asoc_sdw_ti_spk_rtd_init(struct snd_soc_pcm_runtime *rtd,
 		 * carries which prefix. Parts whose driver does not implement
 		 * .set_tdm_slot keep the broadcast mask and the previous
 		 * behaviour.
+		 *
+		 * A part whose SmartAmp function is described by platform
+		 * firmware is initialised from that description and keeps the
+		 * side its own firmware image programmed. It then expects the
+		 * whole stereo port and picks its channel itself, so it must
+		 * not be narrowed to one channel: that leaves the parts
+		 * programmed for the other channel with nothing to play.
 		 */
-		ret = snd_soc_dai_set_tdm_slot(codec_dai, ch_mask, 0, 2, 0);
-		if (ret && ret != -ENOTSUPP) {
-			dev_err(card->dev, "%s set_tdm_slot failed %d\n",
-				prefix, ret);
-			return ret;
+		if (!asoc_sdw_ti_amp_self_routed(codec_dai)) {
+			ret = snd_soc_dai_set_tdm_slot(codec_dai, ch_mask, 0,
+						       2, 0);
+			if (ret && ret != -ENOTSUPP) {
+				dev_err(card->dev,
+					"%s set_tdm_slot failed %d\n",
+					prefix, ret);
+				return ret;
+			}
+			ret = 0;
 		}
-		ret = 0;
 
 		snprintf(widget_name, sizeof(widget_name), "%s SPK", prefix);
 		ret = asoc_sdw_ti_amp_initial_settings(card, prefix);
