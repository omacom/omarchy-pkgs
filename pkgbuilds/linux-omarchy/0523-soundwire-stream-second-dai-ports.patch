From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Meir Dick <mdick85@gmail.com>
Date: Thu, 3 Sep 2026 22:45:00 -0400
Subject: [PATCH] soundwire: stream: append ports when a second DAI joins a
 stream

sdw_stream_add_master() allocates manager ports only when the manager
runtime has none. When a second DAI on the same bus joins an existing
stream - two PDIs on one link, which is how an aggregated four
amplifier speaker link has to be driven - the allocation is skipped,
and sdw_master_port_config() then walks the port list from its head and
reprograms the first DAI's port with the second DAI's port_config.

The first port loses its number and channel mask. In practice both
ports end up with ChannelEn cleared and the stream is silent, with no
error reported anywhere.

Count the ports that are already present, append this DAI's ports after
them, and configure only the newly appended tail. sdw_port_alloc() adds
to the tail, so the count of existing ports is exactly the number to
skip. Only the DAI that created the manager runtime counts towards
m_rt_count, as before.

Signed-off-by: Meir Dick <mdick85@gmail.com>
---
 drivers/soundwire/stream.c | 45 ++++++++++++++++++++++++++++++--------
 1 file changed, 36 insertions(+), 9 deletions(-)

diff --git a/drivers/soundwire/stream.c b/drivers/soundwire/stream.c
index 5d20e95..fefb0a8 100644
--- a/drivers/soundwire/stream.c
+++ b/drivers/soundwire/stream.c
@@ -1081,9 +1081,15 @@ static int sdw_slave_port_config(struct sdw_slave *slave,
 	return 0;
 }
 
-static bool sdw_master_port_allocated(struct sdw_master_runtime *m_rt)
+static unsigned int sdw_master_port_count(struct sdw_master_runtime *m_rt)
 {
-	return !list_empty(&m_rt->port_list);
+	struct sdw_port_runtime *p_rt;
+	unsigned int count = 0;
+
+	list_for_each_entry(p_rt, &m_rt->port_list, port_node)
+		count++;
+
+	return count;
 }
 
 static void sdw_master_port_free(struct sdw_master_runtime *m_rt)
@@ -1112,14 +1118,25 @@ static int sdw_master_port_alloc(struct sdw_master_runtime *m_rt,
 }
 
 static int sdw_master_port_config(struct sdw_master_runtime *m_rt,
-				  const struct sdw_port_config *port_config)
+				  const struct sdw_port_config *port_config,
+				  unsigned int skip)
 {
 	struct sdw_port_runtime *p_rt;
 	int ret;
 	int i;
 
+	/*
+	 * The first @skip ports belong to DAIs that joined this stream
+	 * earlier. They keep the configuration they were given; only the
+	 * tail the caller just allocated is set up here.
+	 */
 	i = 0;
 	list_for_each_entry(p_rt, &m_rt->port_list, port_node) {
+		if (skip) {
+			skip--;
+			continue;
+		}
+
 		ret = sdw_port_config(p_rt, port_config, i);
 		if (ret < 0)
 			return ret;
@@ -2008,6 +2025,7 @@ int sdw_stream_add_master(struct sdw_bus *bus,
 {
 	struct sdw_master_runtime *m_rt;
 	bool alloc_master_rt = false;
+	unsigned int skip;
 	int ret;
 
 	mutex_lock(&bus->bus_lock);
@@ -2047,13 +2065,22 @@ int sdw_stream_add_master(struct sdw_bus *bus,
 		alloc_master_rt = true;
 	}
 
-	if (!sdw_master_port_allocated(m_rt)) {
-		ret = sdw_master_port_alloc(m_rt, num_ports);
-		if (ret)
-			goto alloc_error;
+	/*
+	 * Ports already on the list belong to DAIs that joined this stream
+	 * earlier - two PDIs on one link, as an aggregated four-amplifier
+	 * speaker link needs. Remember how many there are so that their
+	 * configuration survives, and append this DAI's ports after them.
+	 * Only the DAI that created the master runtime counts towards
+	 * m_rt_count.
+	 */
+	skip = sdw_master_port_count(m_rt);
 
+	ret = sdw_master_port_alloc(m_rt, num_ports);
+	if (ret)
+		goto alloc_error;
+
+	if (!skip)
 		stream->m_rt_count++;
-	}
 
 	ret = sdw_master_rt_config(m_rt, stream_config);
 	if (ret < 0)
@@ -2063,7 +2090,7 @@ int sdw_stream_add_master(struct sdw_bus *bus,
 	if (ret)
 		goto unlock;
 
-	ret = sdw_master_port_config(m_rt, port_config);
+	ret = sdw_master_port_config(m_rt, port_config, skip);
 
 	goto unlock;
 
