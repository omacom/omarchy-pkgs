From 704d2514b7bf39bd87dda2bab0a59781a2872de9 Mon Sep 17 00:00:00 2001
From: Vitor Pacheco <vpacheco.costa@gmail.com>
Date: Wed, 16 Sep 2026 14:11:20 -0300
Subject: [PATCH] media: ov02c10: add Samsung Galaxy Book3 Ultra mounting quirk

On the Samsung Galaxy Book3 Ultra (960XFH) the camera module is mounted
flipped vertically, but the SSDB reports a rotation of 0, so
applications get an upside-down image. Reporting a rotation of 180
degrees alone is not enough: libcamera compensates it with both flips
and the image ends up mirrored.

Add a DMI quirk that reports a rotation of 180 degrees and inverts the
HFLIP control, so the transform applied by userspace results in an
upright, non-mirrored image while flip controls keep the Bayer order
handling of the driver.

Tested on a Samsung Galaxy Book3 Ultra (960XFH) with libcamera and
PipeWire.

Signed-off-by: Vitor Pacheco <vpacheco.costa@gmail.com>
---
 drivers/media/i2c/ov02c10.c | 39 ++++++++++++++++++++++++++++++++++---
 1 file changed, 36 insertions(+), 3 deletions(-)

diff --git a/drivers/media/i2c/ov02c10.c b/drivers/media/i2c/ov02c10.c
index ba3f4ad..9d71dec 100644
--- a/drivers/media/i2c/ov02c10.c
+++ b/drivers/media/i2c/ov02c10.c
@@ -4,6 +4,7 @@
 #include <linux/acpi.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
+#include <linux/dmi.h>
 #include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
@@ -60,6 +61,21 @@
 #define OV02C10_REG_TEST_PATTERN		CCI_REG8(0x4503)
 #define OV02C10_TEST_PATTERN_ENABLE		BIT(7)
 
+/*
+ * Laptops whose SSDB reports no rotation although the module is mounted upside
+ * down and mirrored horizontally, i.e. only flipped vertically.
+ */
+static const struct dmi_system_id ov02c10_vflipped_dmi_ids[] = {
+	{
+		/* Samsung Galaxy Book3 Ultra */
+		.matches = {
+			DMI_EXACT_MATCH(DMI_SYS_VENDOR, "SAMSUNG ELECTRONICS CO., LTD."),
+			DMI_EXACT_MATCH(DMI_PRODUCT_NAME, "960XFH"),
+		},
+	},
+	{ }
+};
+
 struct ov02c10_mode {
 	/* Frame width in pixels */
 	u32 width;
@@ -391,6 +407,9 @@ struct ov02c10 {
 	u32 link_freq_index;
 	u8 mipi_lanes;
 
+	/* Module mounted mirrored: the HFLIP control is inverted */
+	bool hflip_invert;
+
 	/* External clock rate */
 	unsigned long mclk;
 	/* Link frequency reported through V4L2_CID_LINK_FREQ */
@@ -482,12 +501,15 @@ static int ov02c10_set_ctrl(struct v4l2_ctrl *ctrl)
 		ret = ov02c10_test_pattern(ov02c10, ctrl->val);
 		break;
 
-	case V4L2_CID_HFLIP:
+	case V4L2_CID_HFLIP: {
+		bool hflip = ctrl->val ^ ov02c10->hflip_invert;
+
 		cci_write(ov02c10->regmap, OV02C10_ISP_X_WIN_CONTROL,
-			  ctrl->val ? 2 : 1, &ret);
+			  hflip ? 2 : 1, &ret);
 		cci_update_bits(ov02c10->regmap, OV02C10_ROTATE_CONTROL,
-				BIT(3), ctrl->val ? 0 : BIT(3), &ret);
+				BIT(3), hflip ? 0 : BIT(3), &ret);
 		break;
+	}
 
 	case V4L2_CID_VFLIP:
 		cci_write(ov02c10->regmap, OV02C10_ISP_Y_WIN_CONTROL,
@@ -588,6 +610,17 @@ static int ov02c10_init_controls(struct ov02c10 *ov02c10)
 	if (ret)
 		return ret;
 
+	/*
+	 * A vertically flipped module is reported as rotated by 180 degrees with
+	 * an inverted HFLIP control, so userspace compensating the rotation with
+	 * both flips gets an upright, non-mirrored image.
+	 */
+	if (dmi_check_system(ov02c10_vflipped_dmi_ids) &&
+	    (props.rotation == V4L2_FWNODE_PROPERTY_UNSET || props.rotation == 0)) {
+		props.rotation = 180;
+		ov02c10->hflip_invert = true;
+	}
+
 	v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &ov02c10_ctrl_ops, &props);
 
 	if (ctrl_hdlr->error)
-- 
2.55.0

