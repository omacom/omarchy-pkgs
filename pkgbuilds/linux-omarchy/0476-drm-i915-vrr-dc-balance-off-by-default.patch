drm/i915/vrr: add enable_dc_balance, default off

VRR DC balance (display version 30+) paces the timing generator with a
repeating stretch, so an OLED panel with a 30-120 Hz VRR range never presents
faster than roughly 68 Hz on Panther Lake even when the compositor commits at
120 Hz. Add the display parameter enable_dc_balance (default off, writable in
the xe_params debugfs directory, xe.enable_dc_balance=1 on the kernel command
line) and require it in intel_vrr_dc_balance_possible(), so the feature is
opt-in. Same idea as Intel's "drm/i915/display: Add command line param for DC
balance" (Mitul Golani), with the default and the description agreeing.

--- a/drivers/gpu/drm/i915/display/intel_vrr.c
+++ b/drivers/gpu/drm/i915/display/intel_vrr.c
@@ -376,7 +376,7 @@
 	 * and PIPE B. Account those limitation while computing DC
 	 * Balance parameters.
 	 */
-	return (HAS_VRR_DC_BALANCE(display) &&
+	return (HAS_VRR_DC_BALANCE(display) && display->params.enable_dc_balance &&
 		((pipe == PIPE_A) || (pipe == PIPE_B)));
 }
 
--- a/drivers/gpu/drm/i915/display/intel_display_params.h
+++ b/drivers/gpu/drm/i915/display/intel_display_params.h
@@ -31,6 +31,7 @@
 	param(int, enable_dc, -1, 0400) \
 	param(bool, enable_dpt, true, 0400) \
 	param(bool, enable_dsb, true, 0600) \
+	param(bool, enable_dc_balance, false, 0600) \
 	param(bool, enable_flipq, false, 0600) \
 	param(bool, enable_sagv, true, 0600) \
 	param(int, disable_power_well, -1, 0400) \
--- a/drivers/gpu/drm/i915/display/intel_display_params.c
+++ b/drivers/gpu/drm/i915/display/intel_display_params.c
@@ -62,6 +62,9 @@
 intel_display_param_named_unsafe(enable_dsb, bool, 0400,
 	"Enable display state buffer (DSB) (default: true)");
 
+intel_display_param_named_unsafe(enable_dc_balance, bool, 0400,
+	"Enable VRR DC balance (default: false)");
+
 intel_display_param_named_unsafe(enable_flipq, bool, 0400,
 	"Enable DMC flip queue (default: false)");
 
