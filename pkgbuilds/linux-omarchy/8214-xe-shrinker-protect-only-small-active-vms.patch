+++ b/drivers/gpu/drm/xe/xe_module.c
@@ -42,7 +42,7 @@ MODULE_PARM_DESC(svm_notifier_size, "Set the svm notifier size in MiB, must be p
 
 module_param_named(shrink_active_ms, xe_modparam.shrink_active_ms, uint, 0600);
 MODULE_PARM_DESC(shrink_active_ms,
-		 "Do not back up a buffer object bound to a VM that submitted work within this many ms, 0=disabled [default="
+		 "Do not back up a buffer object bound to a VM that submitted work within this many ms and whose bound buffer objects total at most 1/8 of RAM in size, 0=disabled [default="
 		 __stringify(XE_DEFAULT_SHRINK_ACTIVE_MS) "]");
 
 module_param_named(shrink_direct_backup, xe_modparam.shrink_direct_backup, bool, 0600);
diff --git a/drivers/gpu/drm/xe/xe_vm.c b/drivers/gpu/drm/xe/xe_vm.c
--- a/drivers/gpu/drm/xe/xe_vm.c
+++ b/drivers/gpu/drm/xe/xe_vm.c
@@ -1172,6 +1172,8 @@ static struct xe_vma *xe_vma_create(struct xe_vm *vm,
 		drm_gpuvm_bo_extobj_add(vm_bo);
 		drm_gem_object_get(&bo->ttm.base);
 		vma->gpuva.gem.offset = bo_offset_or_userptr;
+		if (list_empty(&vm_bo->list.gpuva))
+			atomic_long_add(xe_bo_size(bo) >> PAGE_SHIFT, &vm->bound_pages);
 		drm_gpuva_link(&vma->gpuva, vm_bo);
 		drm_gpuvm_bo_put(vm_bo);
 
@@ -1254,6 +1256,8 @@ static void xe_vma_destroy(struct xe_vma *vma, struct dma_fence *fence)
 	} else if (!xe_vma_is_null(vma) && !xe_vma_is_cpu_addr_mirror(vma)) {
 		xe_bo_assert_held(bo);
 
+		if (list_is_singular(&vma->gpuva.vm_bo->list.gpuva))
+			atomic_long_sub(xe_bo_size(bo) >> PAGE_SHIFT, &vm->bound_pages);
 		drm_gpuva_unlink(&vma->gpuva);
 
 		xe_bo_vma_count_dec_locked(bo);
