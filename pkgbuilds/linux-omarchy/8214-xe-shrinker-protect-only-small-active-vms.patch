diff --git a/drivers/gpu/drm/xe/xe_bo.c b/drivers/gpu/drm/xe/xe_bo.c
--- a/drivers/gpu/drm/xe/xe_bo.c
+++ b/drivers/gpu/drm/xe/xe_bo.c
@@ -1358,6 +1358,7 @@ xe_bo_eviction_valuable(struct ttm_buffer_object *bo, const struct ttm_place *pl
 static bool xe_bo_bound_to_active_vm(struct xe_bo *bo)
 {
 	u64 window = (u64)READ_ONCE(xe_modparam.shrink_active_ms) * NSEC_PER_MSEC;
+	long limit = totalram_pages() / 8;
 	struct drm_gpuvm_bo *vm_bo;
 
 	if (!window)
@@ -1368,7 +1369,8 @@ static bool xe_bo_bound_to_active_vm(struct xe_bo *bo)
 		u64 last = atomic64_read(&vm->last_exec_ns);
 		u64 now = ktime_get_ns();
 
-		if (!xe_vm_in_fault_mode(vm) && last && now - last < window)
+		if (!xe_vm_in_fault_mode(vm) && last && now - last < window &&
+		    atomic_long_read(&vm->bound_pages) <= limit)
 			return true;
 	}
 
