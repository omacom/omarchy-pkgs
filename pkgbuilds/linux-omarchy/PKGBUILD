# Maintainer: The Omarchy Authors

pkgbase=linux-omarchy
pkgname=(
  linux-omarchy
  linux-omarchy-headers
)
pkgver=7.2.8
pkgrel=5
pkgdesc='Omarchy Linux (BORE CPU scheduler, ADIOS I/O scheduler)'
url='https://omarchy.org'
arch=(
  x86_64
)
license=(GPL-2.0-only)

package_linux-omarchy() {
  pkgdesc="The $pkgdesc kernel and modules (meta package for linux-omarchy-bore)"
  depends=(
    linux-omarchy-bore
  )
}

package_linux-omarchy-headers() {
  pkgdesc="Headers and scripts for building modules for the $pkgdesc kernel (meta package for linux-omarchy-bore-headers)"
  depends=(
    linux-omarchy-bore-headers
  )
}
