diff --git a/drivers/gpu/drm/xe/xe_bo.c b/drivers/gpu/drm/xe/xe_bo.c
--- a/drivers/gpu/drm/xe/xe_bo.c
+++ b/drivers/gpu/drm/xe/xe_bo.c
@@ -1011,6 +1011,7 @@ void xe_bo_set_purgeable_state(struct xe_bo *bo,
 			new_state != XE_MADV_PURGEABLE_PURGED));
 
 	bo->purgeable.state = new_state;
+	xe_bo_update_bulk_unkept(bo);
 	xe_bo_set_purgeable_shrinker(bo, new_state);
 }
 
@@ -1395,6 +1396,26 @@ static struct xe_vm *xe_bo_active_vm(struct xe_bo *bo)
 	return NULL;
 }
 
+void xe_bo_update_bulk_unkept(struct xe_bo *bo)
+{
+	bool unkept;
+
+	if (!bo->vm)
+		return;
+
+	xe_bo_assert_held(bo);
+	unkept = bo->ttm.bulk_move &&
+		 (!bo->vm_mapped || bo->purgeable.state == XE_MADV_PURGEABLE_DONTNEED);
+	if (unkept == bo->bulk_unkept)
+		return;
+
+	bo->bulk_unkept = unkept;
+	if (unkept)
+		bo->vm->bulk_unkept++;
+	else
+		bo->vm->bulk_unkept--;
+}
+
 /**
  * xe_bo_shrink() - Try to shrink an xe bo.
  * @ctx: The struct ttm_operation_ctx used for shrinking.
@@ -2056,7 +2077,7 @@ static void xe_gem_object_close(struct drm_gem_object *obj,
 		xe_assert(xe_bo_device(bo), xe_bo_is_user(bo));
 
 		xe_bo_lock(bo, false);
-		ttm_bo_set_bulk_move(&bo->ttm, NULL);
+		__xe_bo_unset_bulk_move(bo);
 		xe_bo_unlock(bo);
 	}
 }
@@ -2704,6 +2725,7 @@ __xe_bo_create_locked(struct xe_device *xe,
 	if (vm && xe_bo_is_user(bo))
 		xe_vm_get(vm);
 	bo->vm = vm;
+	xe_bo_update_bulk_unkept(bo);
 
 	if (bo->flags & XE_BO_FLAG_GGTT) {
 		struct xe_tile *t;
