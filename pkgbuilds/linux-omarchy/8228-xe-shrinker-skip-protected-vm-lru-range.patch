 				u16 cpu_caching, enum ttm_bo_type type,
 				u32 flags, struct dma_buf *dma_buf,
 				struct drm_exec *exec);
+void xe_bo_update_bulk_unkept(struct xe_bo *bo);
 struct xe_bo *xe_bo_create_locked(struct xe_device *xe, struct xe_tile *tile,
 				  struct xe_vm *vm, size_t size,
 				  enum ttm_bo_type type, u32 flags,
@@ -201,8 +202,10 @@ static inline __must_check struct xe_bo *xe_bo_get_unless_zero(struct xe_bo *bo)
 
 static inline void __xe_bo_unset_bulk_move(struct xe_bo *bo)
 {
-	if (bo)
+	if (bo) {
 		ttm_bo_set_bulk_move(&bo->ttm, NULL);
+		xe_bo_update_bulk_unkept(bo);
+	}
 }
 
 static inline void xe_bo_assert_held(struct xe_bo *bo)
