From: Joseph <9035098+calledtoconstruct@users.noreply.github.com>
Date: Sun, 8 Nov 2026 07:40:00 -0500
Subject: [PATCH] Bluetooth: btrtl: identify the controller before RTL_CHIP_SUBVER

btrtl_initialize() sends vendor command 0xfc61 (RTL_CHIP_SUBVER) before
HCI Read Local Version. The RTL8761BU in the TP-Link UB500 (2357:0604)
never completes that register read. The command times out, btusb resets
the USB device, and the reset does not bring the controller back, so
setup loops and BlueZ never sees an adapter.

The vendor read exists to tell an 8822E from an 8822B, and its result
is otherwise discarded. Read the HCI version first. Send RTL_CHIP_SUBVER
only when that version is an 8822B, or when it matches no known
controller.

On linux-omarchy 7.2.15 a fresh enumeration's first command was 0xfc61
and it timed out. With this ordering, after the wedged dongle is
unplugged, the controller loads rtl8761bu firmware 0xdfc6d922.

Signed-off-by: Joseph <9035098+calledtoconstruct@users.noreply.github.com>
---
diff --git i/drivers/bluetooth/btrtl.c w/drivers/bluetooth/btrtl.c
index d298133..331fe0a 100644
--- i/drivers/bluetooth/btrtl.c
+++ w/drivers/bluetooth/btrtl.c
@@ -1086,28 +1086,16 @@ struct btrtl_device_info *btrtl_initialize(struct hci_dev *hdev,
 	INIT_LIST_HEAD(&btrtl_dev->patch_subsecs);
 
 check_version:
-	ret = btrtl_vendor_read_reg16(hdev, RTL_CHIP_SUBVER, reg_val);
-	if (ret < 0)
-		goto err_free;
-	lmp_subver = get_unaligned_le16(reg_val);
-
-	if (lmp_subver == RTL_ROM_LMP_8822B) {
-		ret = btrtl_vendor_read_reg16(hdev, RTL_CHIP_REV, reg_val);
-		if (ret < 0)
-			goto err_free;
-		hci_rev = get_unaligned_le16(reg_val);
-
-		/* 8822E */
-		if (hci_rev == 0x000e) {
-			hci_ver = 0x0c;
-			lmp_ver = 0x0c;
-			btrtl_dev->ic_info = btrtl_match_ic(lmp_subver, hci_rev,
-							    hci_ver, hdev->bus,
-							    chip_type);
-			goto next;
-		}
-	}
-
+	/* Identify the controller from HCI Read Local Version before any
+	 * vendor register read. RTL_CHIP_SUBVER is opcode 0xfc61, and the
+	 * RTL8761BU (TP-Link UB500, 2357:0604) never completes it. btusb
+	 * then resets the USB device, and that reset does not bring this
+	 * controller back, so setup loops with no adapter registered.
+	 *
+	 * The vendor read only distinguishes an 8822E from an 8822B, or
+	 * names a controller the HCI version did not match. Skip it once a
+	 * known non-8822B controller has already matched.
+	 */
 	skb = btrtl_read_local_version(hdev);
 	if (IS_ERR(skb)) {
 		ret = PTR_ERR(skb);
@@ -1132,6 +1120,41 @@ check_version:
 	btrtl_dev->ic_info = btrtl_match_ic(lmp_subver, hci_rev, hci_ver,
 					    hdev->bus, chip_type);
 
+	if (!btrtl_dev->ic_info || lmp_subver == RTL_ROM_LMP_8822B) {
+		u16 hci_lmp_subver = lmp_subver;
+		u16 hci_hci_rev = hci_rev;
+
+		ret = btrtl_vendor_read_reg16(hdev, RTL_CHIP_SUBVER, reg_val);
+		if (ret < 0)
+			goto err_free;
+		lmp_subver = get_unaligned_le16(reg_val);
+
+		if (lmp_subver == RTL_ROM_LMP_8822B) {
+			ret = btrtl_vendor_read_reg16(hdev, RTL_CHIP_REV, reg_val);
+			if (ret < 0)
+				goto err_free;
+			hci_rev = get_unaligned_le16(reg_val);
+
+			/* 8822E */
+			if (hci_rev == 0x000e) {
+				hci_ver = 0x0c;
+				lmp_ver = 0x0c;
+				btrtl_dev->ic_info = btrtl_match_ic(lmp_subver,
+								    hci_rev,
+								    hci_ver,
+								    hdev->bus,
+								    chip_type);
+				goto next;
+			}
+
+			hci_rev = hci_hci_rev;
+		}
+
+		lmp_subver = hci_lmp_subver;
+		btrtl_dev->ic_info = btrtl_match_ic(lmp_subver, hci_rev, hci_ver,
+						    hdev->bus, chip_type);
+	}
+
 next:
 	rtl_dev_info(hdev, "examining hci_ver=%02x hci_rev=%04x lmp_ver=%02x lmp_subver=%04x",
 		     hci_ver, hci_rev,
