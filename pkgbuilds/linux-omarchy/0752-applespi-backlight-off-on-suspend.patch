diff --git a/drivers/input/keyboard/applespi.c b/drivers/input/keyboard/applespi.c
--- a/drivers/input/keyboard/applespi.c
+++ b/drivers/input/keyboard/applespi.c
@@ -1846,6 +1846,7 @@ static int applespi_suspend(struct device *dev)
 {
 	struct spi_device *spi = to_spi_device(dev);
 	struct applespi_data *applespi = spi_get_drvdata(spi);
+	unsigned int bl_level;
 	acpi_status acpi_sts;
 	int sts;
 
@@ -1857,6 +1858,24 @@ static int applespi_suspend(struct device *dev)
 
 	applespi_drain_writes(applespi);
 
+	/*
+	 * Turn the keyboard backlight off for the sleep. No command is
+	 * built while draining, so reopen the queue for this one packet
+	 * and drain again. Keep the requested level: resume clears
+	 * have_bl_level, so the next command restores it.
+	 */
+	scoped_guard(spinlock_irqsave, &applespi->cmd_msg_lock) {
+		bl_level = applespi->want_bl_level;
+		applespi->drain = false;
+		applespi->want_bl_level = 0;
+		applespi_send_cmd_msg(applespi);
+	}
+
+	applespi_drain_writes(applespi);
+
+	scoped_guard(spinlock_irqsave, &applespi->cmd_msg_lock)
+		applespi->want_bl_level = bl_level;
+
 	/* disable the interrupt */
 	acpi_sts = acpi_disable_gpe(NULL, applespi->gpe);
 	if (ACPI_FAILURE(acpi_sts))
