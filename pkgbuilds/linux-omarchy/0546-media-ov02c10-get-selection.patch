From 10980bbd2c3229a5bdcac61ac3b8b19d61cd1032 Mon Sep 17 00:00:00 2001
From: Vitor Pacheco <vpacheco.costa@gmail.com>
Date: Wed, 16 Sep 2026 14:11:20 -0300
Subject: [PATCH] media: ov02c10: implement get_selection()

libcamera needs the pixel array geometry to fill the PixelArraySize,
PixelArrayActiveAreas and ScalerCrop properties. Without get_selection()
it defaults them and warns that the sensor kernel driver needs to be
fixed.

The only supported mode reads out the full 1928x1092 array, so report it
for the crop, crop default, crop bounds and native size targets.

Signed-off-by: Vitor Pacheco <vpacheco.costa@gmail.com>
---
 drivers/media/i2c/ov02c10.c | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/drivers/media/i2c/ov02c10.c b/drivers/media/i2c/ov02c10.c
index 9d71dec..b5cdf4a 100644
--- a/drivers/media/i2c/ov02c10.c
+++ b/drivers/media/i2c/ov02c10.c
@@ -61,6 +61,10 @@
 #define OV02C10_REG_TEST_PATTERN		CCI_REG8(0x4503)
 #define OV02C10_TEST_PATTERN_ENABLE		BIT(7)
 
+/* Pixel array */
+#define OV02C10_NATIVE_WIDTH		1928
+#define OV02C10_NATIVE_HEIGHT		1092
+
 /*
  * Laptops whose SSDB reports no rotation although the module is mounted upside
  * down and mirrored horizontally, i.e. only flipped vertically.
@@ -814,6 +818,29 @@ static int ov02c10_enum_frame_size(struct v4l2_subdev *sd,
 	return 0;
 }
 
+static int ov02c10_get_selection(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_selection *sel)
+{
+	if (sel->pad != 0)
+		return -EINVAL;
+
+	/* The only mode reads out the whole pixel array */
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = OV02C10_NATIVE_WIDTH;
+		sel->r.height = OV02C10_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
 static int ov02c10_init_state(struct v4l2_subdev *sd,
 			      struct v4l2_subdev_state *sd_state)
 {
@@ -830,6 +857,7 @@ static const struct v4l2_subdev_video_ops ov02c10_video_ops = {
 static const struct v4l2_subdev_pad_ops ov02c10_pad_ops = {
 	.set_fmt = ov02c10_set_format,
 	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = ov02c10_get_selection,
 	.enum_mbus_code = ov02c10_enum_mbus_code,
 	.enum_frame_size = ov02c10_enum_frame_size,
 	.enable_streams = ov02c10_enable_streams,
-- 
