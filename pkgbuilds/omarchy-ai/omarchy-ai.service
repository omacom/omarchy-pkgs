[Unit]
Description=Omarchy AI — voice assistant daemon
Documentation=https://github.com/omribenami/Omarchy-AI
After=pipewire.service
Wants=pipewire.service

[Service]
Type=simple
ExecStart=/opt/omarchy-ai/.venv/bin/python -m omarchy_ai
WorkingDirectory=/opt/omarchy-ai
Restart=on-failure
RestartSec=2
# API keys stay in the user's own config files. They are not loaded into
# this unit's environment.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=OMARCHY_PATH=/usr/share/omarchy

[Install]
WantedBy=default.target
