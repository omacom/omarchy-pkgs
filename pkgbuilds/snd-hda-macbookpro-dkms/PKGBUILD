# Maintainer: Patrick Hablützel <p@tzel.ch>
#
# Speakers on 2016–2017 Touch Bar Macs with a Cirrus CS8409 stay silent on the
# stock codec. This is davidjo's driver, which programs the amplifiers. DKMS
# installs it beside the in-tree module and sets that module aside only after
# the build succeeds.

_pkgbase=snd_hda_macbookpro
pkgname=${_pkgbase}-dkms
pkgver=0+git.84
pkgrel=1
_commit=89b22ff90b86468b186706861dd18663562defa7
pkgdesc="CS8409 speaker driver for 2016-2017 Touch Bar Macs"
arch=('x86_64')
url="https://github.com/davidjo/snd_hda_macbookpro"
license=('GPL-2.0-only')
depends=('dkms' 'wget')
makedepends=('git')
source=("git+https://github.com/davidjo/snd_hda_macbookpro.git#commit=${_commit}")
sha256sums=('SKIP')

package() {
  install -dm755 "${pkgdir}/usr/src/${_pkgbase}-${pkgver}"
  cp -a "${_pkgbase}/." "${pkgdir}/usr/src/${_pkgbase}-${pkgver}/"
  rm -rf "${pkgdir}/usr/src/${_pkgbase}-${pkgver}/.git"

  # The DKMS hook matches the directory name to PACKAGE_VERSION.
  sed -e "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"${pkgver}\"/" \
    -i "${pkgdir}/usr/src/${_pkgbase}-${pkgver}/dkms.conf"
}
