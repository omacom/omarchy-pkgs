# SPDX-License-Identifier: GPL-2.0-only
"""hm1092-relay: publish the Himax HM1092 IR sensor as an 8-bit grayscale
v4l2loopback device, lighting its flood LED only while someone is watching.

Derived from hm1092-relay in https://github.com/meros/hm1092-linux
(GPL-2.0-only), reworked for the IR module Dell fits behind the Intel IPU7:
the illuminator is the LED class device the in-tree INT3472 driver registers,
the media graph is found by entity name at start, and V4L2 is driven through
ctypes so numpy is the only dependency beyond the standard library.

Why a relay: the sensor delivers SGRBG10 (10-bit mono samples in a
Bayer-labelled container) on a root-only IPU ISYS capture node that needs the
media graph linked first. Howdy wants an ordinary V4L2 device with 8-bit frames.

Trust model: this process holds the loopback's OUTPUT side for its whole life so
no other producer can inject frames, and it lights the invisible IR flood LED
only while a consumer is attached, bounded by a per-burst cap and a duty budget.
Every wait is a select() with a deadline, so a stalled sensor cannot park the
process in the kernel with the LED lit.
"""

import ctypes
import fcntl
import math
import mmap
import os
import re
import select
import signal
import socket
import subprocess
import sys
import time

# ---------------------------------------------------------------------------
# V4L2 through ctypes. Layouts and ioctl numbers are x86_64 as compiled from
# linux/videodev2.h; test-hm1092-relay.py pins the struct sizes.

VIDIOC_G_FMT = 0xC0D05604
VIDIOC_S_FMT = 0xC0D05605
VIDIOC_REQBUFS = 0xC0145608
VIDIOC_QUERYBUF = 0xC0585609
VIDIOC_QBUF = 0xC058560F
VIDIOC_DQBUF = 0xC0585611
VIDIOC_STREAMON = 0x40045612
VIDIOC_STREAMOFF = 0x40045613
VIDIOC_SUBSCRIBE_EVENT = 0x4020565A
VIDIOC_UNSUBSCRIBE_EVENT = 0x4020565B
VIDIOC_DQEVENT = 0x80885659

BUF_TYPE_CAPTURE = 1
BUF_TYPE_OUTPUT = 2
MEMORY_MMAP = 1
FIELD_NONE = 1
PIX_FMT_SGRBG10 = 0x30314142  # 'BA10'
PIX_FMT_GREY = 0x59455247  # 'GREY'

# v4l2loopback posts this on the producer fd whenever the consumer count
# changes: V4L2_EVENT_PRIVATE_START (0x08000000) + 0x08E00001.
EVENT_CLIENT_USAGE = 0x10E00001

u8, u32, u64, i64 = ctypes.c_uint8, ctypes.c_uint32, ctypes.c_uint64, ctypes.c_int64


class PixFormat(ctypes.Structure):
    _fields_ = [
        ("width", u32), ("height", u32), ("pixelformat", u32), ("field", u32),
        ("bytesperline", u32), ("sizeimage", u32), ("colorspace", u32),
        ("priv", u32), ("flags", u32), ("ycbcr_enc", u32),
        ("quantization", u32), ("xfer_func", u32),
    ]


class FormatUnion(ctypes.Union):
    _fields_ = [("pix", PixFormat), ("raw", u8 * 200)]


class Format(ctypes.Structure):
    # The kernel union holds 8-byte members, so fmt sits at offset 8.
    _fields_ = [("type", u32), ("_pad", u32), ("fmt", FormatUnion)]


class RequestBuffers(ctypes.Structure):
    _fields_ = [
        ("count", u32), ("type", u32), ("memory", u32), ("capabilities", u32),
        ("flags", u8), ("reserved", u8 * 3),
    ]


class Buffer(ctypes.Structure):
    _fields_ = [
        ("index", u32), ("type", u32), ("bytesused", u32), ("flags", u32),
        ("field", u32), ("_pad0", u32), ("tv_sec", i64), ("tv_usec", i64),
        ("timecode", u8 * 16), ("sequence", u32), ("memory", u32),
        ("m", u64), ("length", u32), ("reserved2", u32), ("request_fd", u32),
        ("_pad1", u32),
    ]


class EventSubscription(ctypes.Structure):
    _fields_ = [("type", u32), ("id", u32), ("flags", u32), ("reserved", u32 * 5)]


class Event(ctypes.Structure):
    _fields_ = [
        ("type", u32), ("_pad0", u32), ("u", u8 * 64), ("pending", u32),
        ("sequence", u32), ("ts_sec", i64), ("ts_nsec", i64), ("id", u32),
        ("reserved", u32 * 8), ("_pad1", u32),
    ]


def ioctl(fd, request, arg):
    fcntl.ioctl(fd, request, arg)


def event_consumer_count(event):
    """v4l2loopback's client-usage payload: a u32 consumer count."""
    return int.from_bytes(bytes(event.u)[:4], "little")


