#!/bin/bash

# Drive the IR flood LED the in-tree INT3472 driver registers for the HM1092.
# Usage: hm1092-ir-led on|off
# IR_LED names the LED directory; unset, the first *ir_flood_led* is used.
# "off" with no LED present is a no-op, so unit teardown never fails on it.

set -u

sys_root="${HM1092_SYS_ROOT:-/sys}"
led="${IR_LED:-}"

if [[ -z $led ]]; then
  shopt -s nullglob
  leds=("$sys_root"/class/leds/*ir_flood_led*)
  shopt -u nullglob
  led="${leds[0]:-}"
fi

case "${1:-}" in
  on)
    [[ -n $led && -w $led/brightness ]] || {
      echo "hm1092-ir-led: no writable IR flood LED under $sys_root/class/leds" >&2
      exit 1
    }
    echo 1 >"$led/brightness"
    ;;
  off)
    if [[ -n $led && -w $led/brightness ]]; then
      echo 0 >"$led/brightness"
    fi
    ;;
  *)
    echo "Usage: hm1092-ir-led on|off" >&2
    exit 2
    ;;
esac
