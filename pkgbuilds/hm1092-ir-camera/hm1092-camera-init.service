[Unit]
Description=Load the Himax HM1092 IR camera sensor driver behind the IPU7 camera stack
# intel-ipu7-camera starts its stack from graphical.target with --no-block, so
# this waits for that umbrella unit and then for camera-init's own job; running
# the sensor probe before intel_cvs owns the bridge fails it for good. Default
# dependencies are off so graphical.target is not ordered after this unit.
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target
After=graphical.target intel-ipu7-camera.service camera-init.service
ConditionPathExistsGlob=/sys/bus/acpi/devices/HIMX1092:*

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/modprobe hm1092

[Install]
WantedBy=graphical.target
