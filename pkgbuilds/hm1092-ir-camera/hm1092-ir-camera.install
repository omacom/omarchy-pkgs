post_install() {
  systemctl daemon-reload
  systemctl enable hm1092-relay.service
  udevadm control --reload-rules 2>/dev/null || true
  udevadm trigger --action=change --subsystem-match=video4linux --attr-match=name="HM1092 IR Camera" 2>/dev/null || true
  cat <<'MSG'

  hm1092-ir-camera: DKMS builds the hm1092 sensor module when this transaction
  ends; check with `dkms status`. After a reboot the relay publishes the IR
  camera as /dev/video-hm1092-ir.

MSG
}

post_upgrade() {
  systemctl daemon-reload
  systemctl enable hm1092-relay.service
  udevadm control --reload-rules 2>/dev/null || true
  udevadm trigger --action=change --subsystem-match=video4linux --attr-match=name="HM1092 IR Camera" 2>/dev/null || true
  echo "  hm1092-ir-camera: reboot to load the rebuilt sensor module."
}

pre_remove() {
  systemctl disable --now hm1092-relay.service hm1092-camera-init.service 2>/dev/null || true
  /usr/lib/hm1092-ir-camera/hm1092-ir-led off 2>/dev/null || true
}

post_remove() {
  systemctl daemon-reload
  udevadm control --reload-rules 2>/dev/null || true
}
