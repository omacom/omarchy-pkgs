[Unit]
Description=Publish the HM1092 IR camera as a grayscale V4L2 device for face authentication
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target
Requires=hm1092-camera-init.service
After=hm1092-camera-init.service modprobe@v4l2loopback.service
Wants=modprobe@v4l2loopback.service
ConditionPathExistsGlob=/sys/bus/acpi/devices/HIMX1092:*

[Service]
Type=notify
EnvironmentFile=/etc/hm1092-ir-camera.conf
ExecStartPre=/usr/lib/hm1092-ir-camera/hm1092-ir-led off
ExecStart=/usr/lib/hm1092-ir-camera/hm1092-relay
ExecStopPost=/usr/lib/hm1092-ir-camera/hm1092-ir-led off
Restart=on-failure
RestartSec=2
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
DevicePolicy=closed
DeviceAllow=char-video4linux rw
DeviceAllow=char-media rw
DeviceAllow=char-misc rw
CapabilityBoundingSet=

[Install]
WantedBy=graphical.target
