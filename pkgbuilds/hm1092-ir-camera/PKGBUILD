# Maintainer: Omarchy <packages@omarchy.org>
# Contributor: Josua Schmid <josua.schmid@renuo.ch>
#
# The Himax HM1092 is the Windows Hello IR sensor Dell fits next to the IPU7 RGB
# camera, and Linux has no driver for it yet. The sensor module comes from
# jibsta210's svp7500-camera-fix-pack, which streams it on the Dell XPS 16. The
# sensor's ipu-bridge entry is the kernel's: Jake Steinman's, in mainline from
# 7.3 and in linux-omarchy from 7.2.8-2. The relay, derived from hm1092-relay in
# Alexander Schrab's https://github.com/meros/hm1092-linux, turns the raw stream
# into a grayscale V4L2 device for Howdy and owns the IR flood LED.
# intel-ipu7-camera stays in charge of the RGB camera and the bridge ownership
# handshake.

pkgname=hm1092-ir-camera
pkgver=0.1.0
pkgrel=1
pkgdesc="Himax HM1092 Windows Hello IR camera behind Intel IPU7: sensor driver and grayscale relay for face authentication"
arch=('x86_64')
url="https://github.com/jibsta210/svp7500-camera-fix-pack"
license=('GPL-2.0-only')
depends=('dkms' 'intel-ipu7-camera' 'v4l2loopback-dkms' 'v4l2loopback-utils' 'v4l-utils' 'python' 'python-numpy')
backup=('etc/hm1092-ir-camera.conf')
checkdepends=('linux-omarchy-headers')
install="$pkgname.install"

_fixpack=svp7500-camera-fix-pack
_fixpack_ver=1.0.5

source=(
  "$_fixpack-$_fixpack_ver.tar.gz::https://github.com/jibsta210/$_fixpack/archive/refs/tags/v$_fixpack_ver.tar.gz"
  hm1092.dkms.conf
  hm1092.Makefile
  hm1092-relay
  hm1092-ir-led
  hm1092-ir-led-sleep
  hm1092-ir-camera.conf
  hm1092-camera-init.service
  hm1092-relay.service
  hm1092-camera-deps.conf
  72-hm1092-ir-camera.rules
  hide-hm1092-ir-camera.conf
  test-hm1092-relay.py
  README.md
)
