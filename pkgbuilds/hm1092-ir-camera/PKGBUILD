check() {
  local sensor="$srcdir/$_fixpack-$_fixpack_ver"
  # linux-omarchy-headers is a meta package; the tree comes from the kernel it pulls in.
  local build=(/usr/lib/modules/*/build)
  local kernel_build=${build[0]}

  python -I -B test-hm1092-relay.py

  if [[ ! -f $kernel_build/Makefile ]]; then
    printf 'Unable to locate a kernel build tree; install linux-omarchy-headers\n' >&2
    return 1
  fi

  rm -rf check
  install -Dm644 "$sensor/dkms/hm1092-1.0/hm1092.c" check/hm1092/hm1092.c
  install -Dm644 hm1092.Makefile check/hm1092/Makefile
  make -C "$kernel_build" M="$srcdir/check/hm1092" modules
  [[ -s check/hm1092/hm1092.ko ]] || return 1
  rm -rf check
}

package() {
  local sensor="$srcdir/$_fixpack-$_fixpack_ver"

  # The DKMS tree's directory suffix must equal PACKAGE_VERSION in dkms.conf.
  install -Dm644 "$sensor/dkms/hm1092-1.0/hm1092.c" "$pkgdir/usr/src/hm1092-$pkgver/hm1092.c"
  install -Dm644 hm1092.Makefile "$pkgdir/usr/src/hm1092-$pkgver/Makefile"
  sed "s/@PKGVER@/$pkgver/" hm1092.dkms.conf >"$pkgdir/usr/src/hm1092-$pkgver/dkms.conf"

  install -Dm755 hm1092-relay hm1092-ir-led -t "$pkgdir/usr/lib/$pkgname/"
  install -Dm755 hm1092-ir-led-sleep "$pkgdir/usr/lib/systemd/system-sleep/hm1092-ir-led"
  install -Dm644 hm1092-camera-init.service hm1092-relay.service -t "$pkgdir/usr/lib/systemd/system/"
  install -Dm644 hm1092-camera-deps.conf -t "$pkgdir/usr/lib/modprobe.d/"
  # The SVP7500 bridge's firmware wedges on USB autosuspend; the fix pack's rule keeps it on.
  install -Dm644 72-hm1092-ir-camera.rules "$sensor/udev/99-svp7500-no-autosuspend.rules" \
    -t "$pkgdir/usr/lib/udev/rules.d/"
  install -Dm644 hide-hm1092-ir-camera.conf -t "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/"
  install -Dm644 hm1092-ir-camera.conf "$pkgdir/etc/hm1092-ir-camera.conf"
  install -Dm644 "$sensor/IR-FINDINGS.md" "$pkgdir/usr/share/doc/$pkgname/IR-FINDINGS.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
