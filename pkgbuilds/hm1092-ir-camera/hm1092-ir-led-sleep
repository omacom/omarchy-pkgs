#!/bin/bash

# systemd-sleep hook. Stop the relay around suspend like intel-ipu7-camera does
# for its relay, which also runs its LED-off ExecStopPost, and never carry a lit
# IR flood LED into suspend. The relay comes back on resume and lights the LED
# again only on demand.

case "${1:-}" in
  pre)
    systemctl stop hm1092-relay.service 2>/dev/null || true
    /usr/lib/hm1092-ir-camera/hm1092-ir-led off
    ;;
  post)
    systemctl reset-failed hm1092-relay.service 2>/dev/null || true
    systemctl start --no-block hm1092-relay.service 2>/dev/null || true
    ;;
esac

exit 0
