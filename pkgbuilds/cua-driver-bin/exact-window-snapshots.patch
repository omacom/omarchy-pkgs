+fn observed_read<T, E>(
+    result: Option<std::result::Result<T, E>>,
+    traversal: &mut super::TraversalStatus,
+) -> Option<T> {
+    match result {
+        Some(Ok(value)) => Some(value),
+        _ => {
+            traversal.reasons.push(
+                if snapshot_deadline_reached() {
+                    "deadline"
+                } else {
+                    "read_failure"
+                }
+                .into(),
+            );
+            None
+        }
+    }
+}
