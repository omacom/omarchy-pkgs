+
+#[cfg(test)]
+mod capture_status_tests {
+    use super::*;
+    use std::time::Duration;
+
+    fn tree(reasons: &[&str], visited_nodes: usize) -> native::WalkedTree {
+        native::WalkedTree {
+            markdown: String::new(),
+            nodes: Vec::new(),
+            bounds: Vec::new(),
+            elements: Vec::new(),
+            window_scoped: true,
+            traversal: TraversalStatus {
+                scope: "exact_window".into(),
+                visited_nodes,
+                pending_nodes: 0,
+                reasons: reasons.iter().map(|reason| (*reason).into()).collect(),
+                bounds_complete: true,
+            },
+        }
+    }
+
+    #[test]
+    fn deterministic_limits_and_partial_reads_are_not_retried() {
+        for reason in [
+            "node_limit",
+            "depth_limit",
+            "deadline",
+            "read_failure",
+            "window_identity_unproven",
+        ] {
+            let mut attempts = 0;
+            let result = capture_with_retry(Duration::from_secs(1), Duration::ZERO, |_| {
+                attempts += 1;
+                Ok(Some(tree(&[reason], 1)))
+            })
+            .unwrap()
+            .unwrap();
+            assert_eq!(attempts, 1, "{reason}");
+            assert_eq!(result.traversal.reasons, [reason]);
+        }
+    }
+
+    #[test]
+    fn registration_retry_accepts_ready_target_and_preserves_remaining_deadline() {
+        let mut remaining = Vec::new();
+        let result = capture_with_retry(Duration::from_secs(1), Duration::ZERO, |budget| {
+            remaining.push(budget);
+            match remaining.len() {
+                1 => Ok(None),
+                2 => Ok(Some(tree(&[], 1))),
+                _ => Ok(Some(tree(&[], 3))),
+            }
+        })
+        .unwrap()
+        .unwrap();
+        assert_eq!(remaining.len(), 3);
+        assert!(remaining.windows(2).all(|pair| pair[1] <= pair[0]));
+        assert_eq!(result.traversal.visited_nodes, 3);
+    }
+
+    #[test]
+    fn readiness_backoff_cannot_start_a_new_full_deadline() {
+        let mut attempts = 0;
+        let result =
+            capture_with_retry(Duration::from_millis(1), Duration::from_millis(150), |_| {
+                attempts += 1;
+                Ok(None)
+            });
+        assert_eq!(attempts, 1);
+        assert!(result.err().unwrap().to_string().contains("deadline"));
+    }
+
+    #[test]
+    fn native_errors_do_not_repeat_full_walks() {
+        let mut attempts = 0;
+        let result = capture_with_retry(Duration::from_secs(1), Duration::ZERO, |_| {
+            attempts += 1;
+            Err(anyhow::anyhow!("accessibility_window_identity_unproven"))
+        });
+        assert_eq!(attempts, 1);
+        assert!(result.is_err());
+    }
+}
