+/// A native object retained by one immutable snapshot. Display indexes are
+/// local to this snapshot and are never resolved through a fresh traversal.
+#[derive(Clone)]
+pub struct NativeElement {
+    snapshot: Arc<NativeSnapshot>,
+    index: usize,
+    visited_index: usize,
+    #[cfg(test)]
+    test_identity: String,
+}
+
+struct NativeSnapshot {
+    pid: u32,
+    process_start: String,
+    window_id: u64,
+    connection_name: String,
+    root: RawObjectRef,
+    owners: std::collections::HashMap<String, String>,
+    visited: Vec<Visited<'static>>,
+}
+
+impl std::fmt::Debug for NativeElement {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("NativeElement")
+            .field("pid", &self.snapshot.pid)
+            .field("window_id", &self.snapshot.window_id)
+            .field("index", &self.index)
+            .finish()
+    }
+}
+impl std::fmt::Display for NativeElement {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        self.index.fmt(f)
+    }
+}
+impl NativeElement {
+    pub fn index(&self) -> usize {
+        self.index
+    }
+    pub fn window_id(&self) -> u64 {
+        self.snapshot.window_id
+    }
+    #[cfg(test)]
+    pub(crate) fn for_test(identity: &str) -> Self {
+        Self {
+            snapshot: Arc::new(NativeSnapshot {
+                pid: 0,
+                process_start: String::new(),
+                window_id: 0,
+                connection_name: String::new(),
+                root: RawObjectRef {
+                    name: String::new(),
+                    path: String::new(),
+                },
+                owners: Default::default(),
+                visited: Vec::new(),
+            }),
+            index: 0,
+            visited_index: 0,
+            test_identity: identity.into(),
+        }
+    }
+    #[cfg(test)]
+    pub(crate) fn identity(&self) -> &str {
+        &self.test_identity
+    }
+}
+
+fn process_start(pid: u32) -> Result<String> {
+    let stat = std::fs::read_to_string(format!("/proc/{pid}/stat"))
+        .context("stale_native_element: target process vanished")?;
+    stat.rsplit_once(')')
+        .and_then(|(_, fields)| fields.split_whitespace().nth(19))
+        .map(str::to_owned)
+        .context("stale_native_element: process identity unavailable")
+}
+
+async fn bus_owner(conn: &AccessibilityConnection, name: &str) -> Result<String> {
+    let proxy = atspi::zbus::fdo::DBusProxy::new(conn.connection()).await?;
+    let name = atspi::zbus::names::BusName::try_from(name)?;
+    Ok(call(proxy.get_name_owner(name))
+        .await
+        .context("native bus owner timed out")??
+        .to_string())
+}
+
+/// Validate a resolved snapshot target before choosing any input route.
+pub fn validate_element(pid: u32, element: NativeElement) -> Result<()> {
+    bounded(
+        async { validated_target(pid, &element).await.map(|_| ()) },
+        || Err(anyhow!("stale_native_element: target validation timed out")),
+    )
+}
+
+fn same_native_object(
+    a: &RawObjectRef,
+    b: &RawObjectRef,
+    owners: &std::collections::HashMap<String, String>,
+) -> bool {
+    let owner = |object: &RawObjectRef| {
+        owners
+            .get(&object.name)
+            .cloned()
+            .unwrap_or_else(|| object.name.clone())
+    };
+    a.path == b.path && owner(a) == owner(b)
+}
+
+async fn validated_target<'a>(
+    pid: u32,
+    element: &'a NativeElement,
+) -> Result<&'a Visited<'static>> {
+    let snapshot = &element.snapshot;
+    if pid != snapshot.pid || process_start(pid)? != snapshot.process_start {
+        return Err(anyhow!("stale_native_element: process identity changed"));
+    }
+    let conn = shared_connection().await?;
+    if conn.connection().unique_name().map(|name| name.as_str())
+        != Some(snapshot.connection_name.as_str())
+    {
+        return Err(anyhow!(
+            "stale_native_element: accessibility connection changed"
+        ));
+    }
+    for (name, expected) in &snapshot.owners {
+        if bus_owner(conn, name).await? != *expected {
+            return Err(anyhow!("stale_native_element: accessibility peer changed"));
+        }
+    }
+    let app = app_for_pid(conn, pid)
+        .await?
+        .context("stale_native_element: application unavailable")?;
+    let seeds: Vec<_> = call(app.get_children())
+        .await
+        .context("native root lookup timed out")??
+        .iter()
+        .filter_map(RawObjectRef::from_atspi)
+        .collect();
+    let ordinal = resolve_window_frame(conn, pid, snapshot.window_id, &seeds)
+        .await
+        .context("accessibility_window_identity_unproven: native window binding lost")?;
+    if !seeds
+        .get(ordinal)
+        .is_some_and(|root| same_native_object(root, &snapshot.root, &snapshot.owners))
+    {
+        return Err(anyhow!("stale_native_element: exact window root changed"));
+    }
+    let target = snapshot
+        .visited
+        .get(element.visited_index)
+        .context("stale_native_element: missing object")?;
+    let mut object = target.object.clone();
+    let mut seen = std::collections::HashSet::new();
+    for _ in 0..512 {
+        if !seen.insert(object.clone()) {
+            break;
+        }
+        let acc = call(accessible_for(conn, &object))
+            .await
+            .context("native object lookup timed out")??;
+        let state = call(acc.get_state())
+            .await
+            .context("native object state timed out")??;
+        if state.contains(State::Defunct) {
+            return Err(anyhow!("stale_native_element: defunct object"));
+        }
+        if same_native_object(&object, &snapshot.root, &snapshot.owners) {
+            return Ok(target);
+        }
+        // Reuse the explicitly non-caching Accessible proxy. A default zbus
+        // proxy could issue Properties.GetAll and crash Qt5's AT-SPI bridge.
+        let (name, path): (String, atspi::zbus::zvariant::OwnedObjectPath) =
+            call(acc.inner().get_property("Parent"))
+                .await
+                .context("native ancestry lookup timed out")??;
+        object = RawObjectRef {
+            name,
+            path: path.to_string(),
+        };
+    }
+    Err(anyhow!(
+        "stale_native_element: object no longer belongs to the exact window"
+    ))
+}
+
+async fn retain_snapshot(
+    pid: u32,
+    xid: u64,
+    visited: Vec<Visited<'static>>,
+    scope: Option<usize>,
+) -> Result<Vec<(usize, NativeElement)>> {
+    if scope.is_none() || xid == 0 {
+        return Ok(Vec::new());
+    }
+    let root = visited
+        .first()
+        .filter(|node| node.depth == 0)
+        .context("native snapshot has no retained root")?
+        .object
+        .clone();
+    let conn = shared_connection().await?;
+    let mut owners = std::collections::HashMap::new();
+    for node in &visited {
+        if !owners.contains_key(&node.object.name) {
+            owners.insert(
+                node.object.name.clone(),
+                bus_owner(conn, &node.object.name).await?,
+            );
+        }
+    }
+    let indices: Vec<_> = visited
+        .iter()
+        .enumerate()
+        .filter(|(_, node)| is_indexable(node))
+        .map(|(index, _)| index)
+        .collect();
+    let snapshot = Arc::new(NativeSnapshot {
+        pid,
+        process_start: process_start(pid)?,
+        window_id: xid,
+        connection_name: conn
+            .connection()
+            .unique_name()
+            .context("native connection has no bus identity")?
+            .to_string(),
+        root,
+        owners,
+        visited,
+    });
+    Ok(indices
+        .into_iter()
+        .enumerate()
+        .map(|(index, visited_index)| {
+            (
+                index,
+                NativeElement {
+                    snapshot: snapshot.clone(),
+                    index,
+                    visited_index,
+                    #[cfg(test)]
+                    test_identity: String::new(),
+                },
+            )
+        })
+        .collect())
 }
 
