+    fn synthetic_walk(sibling_size: usize, limit: usize, scoped: bool) -> Vec<RawObjectRef> {
+        let sibling = object("/earlier");
+        let target = object("/target");
+        let search = object("/target/search");
+        let mut children = HashMap::from([(target.clone(), vec![search])]);
+        children.insert(
+            sibling.clone(),
+            (0..sibling_size)
+                .map(|i| object(&format!("/earlier/{i}")))
+                .collect(),
+        );
+        let mut stack = traversal_seeds(vec![sibling, target], scoped.then_some(1));
+        let mut visited = Vec::new();
+        while let Some((node, depth, _, frame)) = stack.pop() {
+            if visited.len() == limit {
+                break;
