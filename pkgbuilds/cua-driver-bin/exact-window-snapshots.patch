+fn traversal_seeds(
+    seeds: Vec<RawObjectRef>,
+    frame: Option<usize>,
+) -> Vec<(RawObjectRef, usize, bool, usize)> {
+    seeds
+        .into_iter()
+        .enumerate()
+        .filter(|(ordinal, _)| frame.is_none_or(|frame| *ordinal == frame))
+        .map(|(ordinal, object)| (object, 0, false, ordinal))
+        .rev()
+        .collect()
+}
