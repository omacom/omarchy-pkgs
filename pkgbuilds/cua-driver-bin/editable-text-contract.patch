+#[cfg(test)]
+mod native_value_result_tests {
+    use super::*;
+
+    #[test]
+    fn replacement_outcomes_distinguish_proof_refusal_and_uncertainty() {
+        let confirmed = native_set_value_result(Ok(crate::atspi::SetValueOutcome {
+            method: "atspi.EditableText.SetTextContents",
+            effect: "verified",
+        }));
+        assert_ne!(confirmed.is_error, Some(true));
+        assert_eq!(confirmed.structured_content.unwrap()["effect"], "confirmed");
+        let refused = native_set_value_result(Err(anyhow::anyhow!(
+            "unsupported: no replacement interface"
+        )));
+        assert_eq!(refused.is_error, Some(true));
+        let refused = refused.structured_content.unwrap();
+        assert_eq!(refused["effect"], "refused");
+        assert!(refused.get("delivery").is_none_or(Value::is_null));
+        let uncertain = native_set_value_result(Err(anyhow::anyhow!(
+            "outcome_uncertain: acknowledgement timed out"
+        )));
+        assert_eq!(uncertain.is_error, Some(true));
+        let uncertain = uncertain.structured_content.unwrap();
+        assert_eq!(uncertain["effect"], "unverifiable");
+        assert_eq!(uncertain["delivery"]["mode"], "unknown");
+    }
+
+    #[test]
+    fn dropped_native_value_invocation_cancels_the_worker() {
+        let flag = Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let guard = CancelNativeValueOnDrop(flag.clone());
+        assert!(!flag.load(std::sync::atomic::Ordering::Acquire));
+        drop(guard);
+        assert!(flag.load(std::sync::atomic::Ordering::Acquire));
+    }
+}
