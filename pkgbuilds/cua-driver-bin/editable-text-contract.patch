+// Bounds apply to each field value, independently of the traversal node budget.
+const MAX_FIELD_CHARACTERS: i32 = 65_536;
+
+type NativeAttributes = std::collections::HashMap<String, String>;
+
+fn is_text_field(role: &str, state: Option<&StateSet>, has_editable: bool) -> bool {
+    has_editable
+        || state.is_some_and(|s| s.contains(State::Editable))
+        || matches!(
+            role.to_ascii_lowercase().as_str(),
+            "entry" | "text" | "password text" | "password" | "combo box" | "combobox"
+        )
+}
+
+fn is_protected_field(role: &str, attrs: Option<&NativeAttributes>) -> bool {
+    role.to_ascii_lowercase().contains("password")
+        || attrs.is_some_and(|attrs| {
+            ["text-input-type", "input-type", "type"].iter().any(|key| {
+                attrs
+                    .get(*key)
+                    .is_some_and(|v| v.eq_ignore_ascii_case("password"))
+            }) || ["protected", "password", "secret"].iter().any(|key| {
+                attrs
+                    .get(*key)
+                    .is_some_and(|v| matches!(v.as_str(), "true" | "1"))
+            })
+        })
+}
+
+fn field_metadata(
+    role: &str,
+    state: Option<&StateSet>,
+    has_editable: bool,
+    attrs: Option<&NativeAttributes>,
+    name_complete: bool,
+) -> NativeTextObservation {
+    let mut text = NativeTextObservation {
+        editable: state.map(|s| s.contains(State::Editable) && !s.contains(State::ReadOnly)),
+        editable_source: state.map(|_| "atspi.State.Editable/ReadOnly".into()),
+        protected: is_protected_field(role, attrs),
+        value_status: "not_applicable".into(),
+        name_source: "atspi.Accessible.Name".into(),
+        name_complete,
+        attributes_complete: attrs.is_some(),
+        ..Default::default()
+    };
+    if text.editable.is_none() && has_editable {
+        text.editable = Some(true);
+        text.editable_source = Some("atspi.EditableText".into());
+    }
+    if let Some(attrs) = attrs {
+        if let Some(source) = attrs.get("name-from") {
+            text.name_source = format!("atspi.name-from:{source}");
+        }
+        for key in ["text-input-type", "input-type"] {
+            if let Some(value) = attrs.get(key).filter(|v| !v.is_empty()) {
+                text.input_type = Some(value.clone());
+                text.input_type_source = Some(format!("atspi.attribute:{key}"));
+                break;
+            }
+        }
+        for key in ["placeholder-text", "placeholder"] {
+            if let Some(value) = attrs.get(key) {
+                text.placeholder = Some(value.clone());
+                text.placeholder_source = Some(format!("atspi.attribute:{key}"));
+                break;
+            }
+        }
+    }
+    text
