+async fn observe_field(
+    acc: &AccessibleProxy<'_>,
+    role: &str,
+    state: Option<&StateSet>,
+    has_editable: bool,
+    has_text: bool,
+    field: bool,
+    name_complete: bool,
+) -> (NativeTextObservation, Option<String>, Option<String>) {
