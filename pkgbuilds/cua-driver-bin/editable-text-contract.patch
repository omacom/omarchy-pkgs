+/// Count uses Unicode scalar values, as AT-SPI character offsets do, not bytes.
+/// A second equal read detects same-length edits during capture. This is a
+/// consistent observation, not a promise that the application cannot edit later.
+fn classify_text_read(before: i32, after: i32, first: &str, second: &str) -> &'static str {
+    if before < 0 || after < 0 {
+        "read_failure"
+    } else if before != after || first != second {
+        "changed_during_read"
+    } else if before > MAX_FIELD_CHARACTERS {
+        "truncated"
+    } else if first.chars().count() != before as usize {
+        "incomplete"
+    } else {
+        "complete"
+    }
+}
+
+fn text_read_guard(
+    role: Option<&str>,
+    state: Option<&StateSet>,
+    attrs: Option<&NativeAttributes>,
+) -> Option<&'static str> {
+    let (Some(role), Some(state), Some(attrs)) = (role, state, attrs) else {
+        return Some("protection_unknown");
+    };
+    if role.is_empty() {
+        return Some("protection_unknown");
+    }
+    if is_protected_field(role, Some(attrs)) {
+        return Some("protected");
+    }
+    if state.contains(State::Defunct) || state.contains(State::Stale) {
+        return Some("stale");
+    }
+    if state.contains(State::Truncated) {
+        return Some("platform_truncated");
+    }
+    None
+}
