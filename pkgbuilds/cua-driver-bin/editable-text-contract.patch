+async fn read_field_value(acc: &AccessibleProxy<'_>) -> (Option<String>, &'static str) {
+    let result = async {
+        let proxies = call(acc.proxies()).await?.ok()?;
+        let tp = call(proxies.text()).await?.ok()?;
+        let before = call(tp.character_count()).await?.ok()?;
+        if before < 0 {
+            return None;
+        }
+        let first = call(tp.get_text(0, before.min(MAX_FIELD_CHARACTERS)))
+            .await?
+            .ok()?;
+        let after = call(tp.character_count()).await?.ok()?;
+        if after < 0 {
+            return None;
+        }
+        let second = call(tp.get_text(0, after.min(MAX_FIELD_CHARACTERS)))
+            .await?
+            .ok()?;
+        Some((first, second, before, after))
+    }
+    .await;
+    // Protection can change while the application services GetText. Do not
+    // publish even a consistent value unless fresh native metadata still
+    // establishes a readable object. This guard also covers action readback.
+    let (role, state, attrs) = tokio::join!(
+        call(acc.get_role_name()),
+        call(acc.get_state()),
+        call(acc.get_attributes()),
+    );
+    let role = role.and_then(Result::ok);
+    let state = state.and_then(Result::ok);
+    let attrs = attrs.and_then(Result::ok);
+    if let Some(status) = text_read_guard(role.as_deref(), state.as_ref(), attrs.as_ref()) {
+        return (None, status);
+    }
+    match result {
+        Some((first, second, before, after)) => {
+            let status = classify_text_read(before, after, &first, &second);
+            // Partial text is usable only when explicitly labelled partial;
+            // changing reads are omitted, since neither is a reliable value.
+            let value = if status == "changed_during_read" {
+                None
+            } else {
+                Some(first)
+            };
+            (value, status)
+        }
+        None => (
+            None,
+            if snapshot_deadline_reached() {
+                "deadline"
+            } else {
+                "read_failure"
+            },
+        ),
+    }
+}
