+/// A blocking native write must see cancellation when its async caller drops.
+struct CancelNativeValueOnDrop(Arc<std::sync::atomic::AtomicBool>);
+
+impl Drop for CancelNativeValueOnDrop {
+    fn drop(&mut self) {
+        self.0.store(true, std::sync::atomic::Ordering::Release);
+    }
+}
+
+fn retain_native_value_lifecycle(
+    args: &Value,
+) -> Result<Option<cua_driver_core::session::SessionDispatchGuard>, String> {
+    use cua_driver_core::session;
+    let Some(owner) = named_session_cursor_key(args) else {
+        return Ok(None);
+    };
+    let transport_owner = args
+        .get("_transport_session_id")
+        .and_then(Value::as_str)
+        .unwrap_or(&owner);
+    let snapshot = session::session_snapshot(&owner, transport_owner, std::time::Duration::ZERO)
+        .ok_or_else(|| "unsupported: admitted session is no longer available".to_owned())?;
+    session::begin_session_dispatch(
+        &owner,
+        snapshot.public_label.as_deref(),
+        transport_owner,
+        snapshot.implicit,
+        snapshot.transport,
+        snapshot.client_kind,
+    )
+    .map(Some)
+    .map_err(str::to_owned)
+}
+
+fn native_set_value_result(result: anyhow::Result<crate::atspi::SetValueOutcome>) -> ToolResult {
+    use cua_driver_core::action_record::{
+        ActionEffect, ActionEvidence, ActionExecutionRecord, ActionTransport, ActualDelivery,
+        EvidenceKind, RequestedDelivery,
+    };
+    let (effect, detail) = match result {
+        Ok(outcome) => (
+            ActionEffect::Confirmed,
+            format!("{}: the retained native target's complete value matched the replacement on fresh readback.", outcome.method),
+        ),
+        Err(error) => {
+            let detail = error.to_string();
+            let uncertain = detail.starts_with("outcome_uncertain:");
+            (if uncertain { ActionEffect::Unverifiable } else { ActionEffect::Refused }, detail)
+        }
+    };
+    let mut record = ActionExecutionRecord::builder(
+        effect,
+        ActionTransport::LinuxAtSpiValue,
+        RequestedDelivery::Background,
+    )
+    .detail(detail.clone());
+    if effect == ActionEffect::Confirmed {
+        record = record
+            .actual_delivery(ActualDelivery::Background)
+            .evidence(ActionEvidence {
+                kind: EvidenceKind::ValueReadback,
+                detail:
+                    "Complete native value readback matched; protected values are never returned."
+                        .into(),
+            });
+    } else if effect == ActionEffect::Unverifiable {
+        record = record.actual_delivery(ActualDelivery::Unknown);
+    }
+    let record = record.build().expect("native replacement action record");
+    let structured =
+        serde_json::to_value(record.public_result().expect("native action projection"))
+            .expect("native action JSON");
+    let result = if effect == ActionEffect::Confirmed {
+        ToolResult::text(detail)
+    } else {
+        ToolResult::error(detail)
+    };
+    result
+        .with_structured(structured)
+        .with_action_record(record)
+}
