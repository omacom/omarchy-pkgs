+    // caching. Never warm a GetAll cache (older Qt bridges crash on GetAll).
+    let (attrs, description) = if field {
+        let (attrs, description) =
+            tokio::join!(call(acc.get_attributes()), call(acc.description()));
+        (attrs.and_then(Result::ok), description.and_then(Result::ok))
+    } else {
+        (None, None)
+    };
+    let mut text = field_metadata(role, state, has_editable, attrs.as_ref(), name_complete);
+    text.description_complete = description.is_some();
+    text.description_source = description.as_ref().map(|_| {
+        attrs
+            .as_ref()
+            .and_then(|attrs| attrs.get("description-from"))
+            .map(|source| format!("atspi.description-from:{source}"))
+            .unwrap_or_else(|| "atspi.Accessible.Description".into())
+    });
+    let mut value = None;
+    if text.protected {
+        text.value_status = "protected".into();
+    } else if field {
+        text.value_source = has_text.then(|| "atspi.Text.GetText".into());
+        text.value_status = if attrs.is_none() || state.is_none() || role.is_empty() {
+            // A failed protection/classification read cannot authorize exposing
+            // potentially secret text, even if Text itself answers.
+            "protection_unknown".into()
+        } else if !has_text {
+            "unavailable".into()
+        } else {
+            let (observed, status) = read_field_value(acc).await;
+            text.protected |= status == "protected";
+            value = observed;
+            status.into()
+        };
+        text.value_complete = text.value_status == "complete";
+    }
+    (text, value, description)
