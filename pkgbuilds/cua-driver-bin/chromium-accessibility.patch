+/// Chromium adds profile and audio status text to BrowserRootView's accessible
+/// name. Treat these as candidates only for an attested Chromium process/root,
+/// with matching dimensions and a unique join in BOTH directions. In particular,
+/// "Page" must not steal the frame for a sibling titled "Page - Other".
+struct HyprlandFrame {
+    ordinal: usize,
+    title: String,
+    browser_root: bool,
+    size: Option<(i32, i32)>,
+}
+
+fn chromium_title_matches(accessible: &str, native: &str) -> bool {
+    if native.is_empty() {
+        return false;
+    }
+    let matches = |name: &str| {
+        name == native
+            || name
+                .strip_prefix(native)
+                .and_then(|suffix| suffix.strip_prefix(" - "))
+                .is_some_and(|profile| {
+                    !profile.trim().is_empty() && !profile.chars().any(char::is_control)
+                })
+    };
+    if matches(accessible) {
+        return true;
+    }
+    // Preserve BOTH interpretations: literal page titles containing the audio
+    // phrase must compete with the normalized title in the reverse join.
+    if let Some((page, tail)) = accessible.rsplit_once(" - Audio playing - ") {
+        if tail == "Chromium"
+            || tail.starts_with("Chromium - ")
+            || tail == "Google Chrome"
+            || tail.starts_with("Google Chrome - ")
+        {
+            return matches(&format!("{page} - {tail}"));
+        }
+    }
+    false
+}
+
+fn correlate_hyprland_frame(
+    frames: &[HyprlandFrame],
+    clients: &[(&str, u32, u32)],
+    target: usize,
+) -> Option<usize> {
+    let &(title, _, _) = clients.get(target)?;
+    // Retain the existing refusal for duplicate compositor titles, regardless
+    // of geometry. A missing AX sibling must not make that join look unique.
+    if title.is_empty() || clients.iter().filter(|c| c.0 == title).count() != 1 {
+        return None;
+    }
+    let matches = |frame: &HyprlandFrame, client: &(&str, u32, u32)| {
+        frame.title == client.0
+            || (frame.browser_root
+                && frame.size.is_some_and(|(w, h)| {
+                    w > 0
+                        && h > 0
+                        && i64::from(w) == i64::from(client.1)
+                        && i64::from(h) == i64::from(client.2)
+                })
+                && chromium_title_matches(&frame.title, client.0))
+    };
+    let mut candidates = frames.iter().filter(|f| matches(f, &clients[target]));
+    let frame = candidates.next()?;
+    if candidates.next().is_some() || clients.iter().filter(|c| matches(frame, c)).count() != 1 {
+        return None;
+    }
+    Some(frame.ordinal)
+}
+
+#[cfg(test)]
+mod hyprland_chromium_tests {
+    use super::*;
+    fn frame(title: &str) -> HyprlandFrame {
+        HyprlandFrame {
+            ordinal: 7,
+            title: title.into(),
+            browser_root: true,
+            size: Some((800, 600)),
+        }
+    }
+    #[test]
+    fn profile_and_audio_decorations_bind_only_the_requested_frame() {
+        for (native, ax) in [
+            ("Page - Chromium", "Page - Chromium - Spencer (Work)"),
+            (
+                "Page - Chromium",
+                "Page - Audio playing - Chromium - Spencer (Work)",
+            ),
+            ("Home / X", "Home / X - Spencer (Work)"),
+        ] {
+            assert_eq!(
+                correlate_hyprland_frame(
+                    &[frame(ax)],
+                    &[(native, 800, 600), ("Other", 800, 600)],
+                    0
+                ),
+                Some(7)
+            );
+        }
+    }
+    #[test]
+    fn generic_prefixes_unknown_apps_and_wrong_sizes_refuse() {
+        assert!(!chromium_title_matches("Pageant", "Page"));
+        assert!(!chromium_title_matches("Page - ", "Page"));
+        let mut f = frame("Page - Spencer (Work)");
+        f.browser_root = false;
+        assert_eq!(
+            correlate_hyprland_frame(&[f], &[("Page", 800, 600)], 0),
+            None
+        );
+        assert_eq!(
+            correlate_hyprland_frame(&[frame("Page - Spencer (Work)")], &[("Page", 801, 600)], 0),
+            None
+        );
+    }
+    #[test]
+    fn duplicate_and_prefix_related_native_siblings_refuse() {
+        for clients in [
+            vec![("Page", 800, 600), ("Page", 900, 700)],
+            vec![("Page", 800, 600), ("Page - Other", 800, 600)],
+        ] {
+            assert_eq!(
+                correlate_hyprland_frame(&[frame("Page - Other - Work")], &clients, 0),
+                None
+            );
+        }
+    }
+    #[test]
+    fn exact_and_decorated_ax_competitors_refuse() {
+        assert_eq!(
+            correlate_hyprland_frame(
+                &[frame("Page"), frame("Page - Work")],
+                &[("Page", 800, 600)],
+                0
+            ),
+            None
+        );
+        assert_eq!(
+            correlate_hyprland_frame(
+                &[frame("Page - Work"), frame("Page - Work")],
+                &[("Page", 800, 600)],
+                0
+            ),
+            None
+        );
+    }
+    #[test]
+    fn literal_audio_title_competes_with_normalized_title() {
+        let frames = [frame("Music - Audio playing - Chromium - Work")];
+        let clients = [
+            ("Music - Audio playing - Chromium", 800, 600),
+            ("Music - Chromium", 800, 600),
+        ];
+        assert_eq!(correlate_hyprland_frame(&frames, &clients, 0), None);
+        assert_eq!(correlate_hyprland_frame(&frames, &clients, 1), None);
+    }
+    #[test]
+    fn exact_non_chromium_and_empty_title_regressions() {
+        let mut f = frame("Editor");
+        f.browser_root = false;
+        f.size = None;
+        assert_eq!(
+            correlate_hyprland_frame(&[f], &[("Editor", 800, 600)], 0),
+            Some(7)
+        );
+        assert_eq!(
+            correlate_hyprland_frame(&[frame("")], &[("", 800, 600)], 0),
+            None
+        );
+    }
+}
