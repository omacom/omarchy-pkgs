# Maintainer: Spencer Bull <spencerbull2554@gmail.com>

# Rebuild the CLI and SDK with the patches described in PATCHES.md; retain
# companion assets from the matching vendor tarball. Upstream keeps the CLI, its cursor-theme
# compiler, and the SDK artifacts together in one directory and exposes the
# CLI through a symlink -- the binary resolves its helpers as siblings of
# /proc/self/exe -- so the whole tree lands under /usr/lib/cua-driver with a
# /usr/bin symlink. Automatic updates are held in .omarchy/package.json until
# the source checksum and patches are requalified for a new release.
#
# The binary carries its own updater: `cua-driver update --apply` pipes the
# vendor installer into bash, which would install a second copy under
# ~/.cua-driver and link it into ~/.local/bin, stepping around pacman and
# this repository's release gate. Driver 0.27.0 detects pacman ownership, but
# deliberately treats failed and timed-out ownership queries as unmanaged.
# A /usr/bin wrapper would not cover MCP configurations that record the
# resolved executable, so _contain_updater() rewrites the installer URL inside the
# binary to point at pm.sh, a stand-in that declines and names pacman instead.

pkgname=cua-driver-bin
pkgver=0.28.2
pkgrel=1.3
pkgdesc="Computer-use driver for native GUI apps: accessibility-tree snapshots and input injection"
arch=('x86_64') # Local proof only; ARM has not been built or tested.
url="https://github.com/trycua/cua"
license=('MIT')
# at-spi2-core carries the AT-SPI accessibility bus the driver reads GUI
# trees through; the X libraries are linked, not dlopen'd.
depends=(
  'at-spi2-core'
  'gcc-libs'
  'glibc'
  'libx11'
  'libxcb'
  'libxext'
  'libxi'
  'libxkbcommon'
)
makedepends=('rust' 'clang' 'pkgconf' 'cmake')
provides=("cua-driver=${pkgver}")
conflicts=('cua-driver')
# Preserve the local build IDs; CLI/SDK are rebuilt for this experiment.
# makepkg's GCC LTO objects in ring/zstd cannot be consumed by Rust's lld.
options=('!strip' '!debug' '!lto')
# Local experiment: compile the patched CLI and SDK from the exact release tag,
# retaining the release's companion assets. No plugin changes.
_source_tree="cua-cua-driver-rs-v${pkgver}"
source=('LICENSE' 'pm.sh'
        "cua-source-${pkgver}.tar.gz::https://codeload.github.com/trycua/cua/tar.gz/refs/tags/cua-driver-rs-v${pkgver}"
        'chromium-accessibility.patch'
        'exact-window-snapshots.patch'
        'hyprland-unusable-geometry.patch'
        'editable-text-contract.patch')
source_x86_64=("https://github.com/trycua/cua/releases/download/cua-driver-rs-v${pkgver}/cua-driver-rs-${pkgver}-linux-x86_64.tar.gz")
source_aarch64=("https://github.com/trycua/cua/releases/download/cua-driver-rs-v${pkgver}/cua-driver-rs-${pkgver}-linux-arm64.tar.gz")
sha256sums=('c0779290c1d4783169aa3dbfb55feb505e563ef8a004bbf55298ceffcfbda8d9'
            'c76e251c3ed424200eac52bec35ba534336307fabd83a175ab0b47e2084ab0d8'
            '405cfd66b7e5a04d8a663be7c724dfb5b5076fdfe871f6d44c53a938766aaf1c'
            'dfdf923fa28cac2b85b34e9141bc7094a08176ec77fdfe75251fcf6fc2767f1a'
            '0a3afc3879197d4921e64cf34740a17a21ccd8eda371ed89e5f36da513f2912f'
            '81d87d415ad6b5d9f736432afb430b6ef74c82511e3d56c0215274f1e50eb84c'
            'f7afa1497cc6452c6394b592144f87b9db5363409693bea08ce941181f970568')
sha256sums_x86_64=('8f3e5b669e2bcd98d0eecc64f40640aac77f358b6332a06abc6ee79991620f7d')
sha256sums_aarch64=('cadd7e6b757c3ce50f2b5f6e273c154ea48450fb5fcaff744209b382915eddf5')

case "${CARCH}" in
  x86_64) _platform="linux-x86_64" ;;
  aarch64) _platform="linux-arm64" ;;
esac
_vendor_tree="cua-driver-rs-${pkgver}-${_platform}"

# Rust strings carry their length out of band, so the replacement has to be
# exactly as long as the original, which is what fixes the
# stand-in's short name and location.
_vendor_installer='https://cua.ai/driver/install.sh'
_pacman_installer='file:///usr/lib/cua-driver/pm.sh'

prepare() {
  cd "${srcdir}/${_source_tree}"
  patch -Np1 -i "${srcdir}/chromium-accessibility.patch"
  patch -Np1 -i "${srcdir}/exact-window-snapshots.patch"
  patch -Np1 -i "${srcdir}/hyprland-unusable-geometry.patch"
  patch -Np1 -i "${srcdir}/editable-text-contract.patch"
}

build() {
  cd "${srcdir}/${_source_tree}/libs/cua-driver/rust"
  cargo build --locked --release -p cua-driver -p cua-driver-sdk --features cua-driver/portal-input
  # Replace both public entry points so CLI and SDK use the same patch.
  install -m755 target/release/cua-driver "${srcdir}/${_vendor_tree}/cua-driver"
  install -m755 target/release/libcua_driver_sdk.so "${srcdir}/${_vendor_tree}/libcua_driver_sdk.so"
  _contain_updater
}

check() {
  cd "${srcdir}/${_source_tree}/libs/cua-driver/rust"
  cargo test --locked -p platform-linux --lib atspi::
  cargo test --locked -p platform-linux --lib wayland::hyprland::tests
  cargo test --locked -p platform-linux --lib character_typing_never_ignores_an_element_target
  cargo test --locked -p platform-linux --lib get_window_state_actions_tests
  cargo test --locked -p platform-linux --lib native_value_result_tests
  cargo test --locked -p platform-linux --lib browser_setup_ui::
  cargo test --locked -p platform-linux --lib browser_consent_ui::
  cargo test --locked -p cua-driver-core --lib expectation::
  cargo test --locked -p cua-driver-core --test snapshot_invariants --test snapshot_dispatch_invariants --test session_lifecycle
}

_contain_updater() {
  cd "${srcdir}/${_vendor_tree}"

  if (( ${#_vendor_installer} != ${#_pacman_installer} )); then
    echo "installer URLs must be the same length to rewrite in place" >&2
    return 1
  fi

  # In 0.28.1 the URL appears in the updater, the printed reinstall command,
  # and two embedded copies of Skills/cua-driver/README.md. Rewrite all four
  # so the embedded instructions also defer to pacman. Any other count means
  # the release layout changed and needs review before packaging.
  local expected=4 found
  found=$(grep -obUaF "${_vendor_installer}" cua-driver | wc -l)
  if (( found != expected )); then
    echo "expected the vendor installer URL ${expected} times in cua-driver, found ${found}" >&2
    return 1
  fi

  local size_before size_after
  size_before=$(stat -c %s cua-driver)
  sed -i "s|${_vendor_installer//./\\.}|${_pacman_installer}|g" cua-driver
  size_after=$(stat -c %s cua-driver)

  if (( size_before != size_after )) \
      || grep -qUaF "${_vendor_installer}" cua-driver \
      || (( $(grep -obUaF "${_pacman_installer}" cua-driver | wc -l) != expected )); then
    echo "installer URL rewrite did not land cleanly in cua-driver" >&2
    return 1
  fi
}

package() {
  cd "${srcdir}/${_vendor_tree}"

  # The vendor tree stays together: cua-driver execs cua-cursor-theme as a
  # sibling of the resolved binary, and the SDK library, node runtime, ABI
  # header, and the GNOME wayland-helper extension are versioned with it.
  install -d "${pkgdir}/usr/lib/cua-driver"
  cp -a . "${pkgdir}/usr/lib/cua-driver/"
  chmod -R a+rX "${pkgdir}/usr/lib/cua-driver"

  # The path _contain_updater() wrote into the binary.
  install -Dm755 "${srcdir}/pm.sh" "${pkgdir}/usr/lib/cua-driver/pm.sh"

  install -d "${pkgdir}/usr/bin"
  ln -s ../lib/cua-driver/cua-driver "${pkgdir}/usr/bin/cua-driver"

  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
