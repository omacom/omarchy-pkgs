# Maintainer: Diogo Chaves <diogochaves@me.com>
#
# The tree goes read-only to /usr/lib/omabox, as omabox expects of a system install
# (its NOTES.md, finding 128); /usr/bin/omabox links to it. What each user needs
# (the agent skill, the bar widget, ~/.config/omabox, the agent guard) is
# `omabox setup`, run by that user: a package cannot link into anyone's HOME.

pkgname=omabox
pkgver=0.7.0
pkgrel=1
pkgdesc='Contained, invisible Hyprland + Omarchy desktop where agents run, drive and screenshot apps'
arch=('x86_64')
url='https://github.com/diogochaves/omabox'
license=('MIT')
depends=('bash' 'glibc' 'hyprland>=0.56' 'labwc' 'wlr-randr' 'bubblewrap' 'util-linux'
         'iproute2' 'jq' 'grim>=1.5' 'gnome-keyring' 'libsecret' 'quickshell' 'gtk3'
         'xdg-terminal-exec' 'dbus' 'passt' 'wl-clipboard' 'wayland' 'libxkbcommon'
         'pixman' 'libpng' 'at-spi2-core' 'glib2')
makedepends=('pkgconf')
optdepends=("python: omabox log journal (a box's journal sockets), the agent guard for Codex, a jailed agent's project in its box"
            "gdb: omabox gdb (backtraces of a box's Hyprland or shell)"
            'imagemagick: omabox shot --changed'
            "mesa-utils: up and ls say when a box's apps render in software"
            'wf-recorder: omabox record (videos of a box)'
            'ffmpeg: omabox record'
            'imagemagick: omabox calibrate (the test card)'
            'pipewire: omabox up --audio (a box with sound of its own)'
            'wireplumber: omabox up --audio'
            'git: omabox setup --aquamarine (headless NVIDIA boxes, confirm-close)'
            'cmake: omabox setup --aquamarine'
            'ninja: omabox setup --aquamarine'
            'hyprwayland-scanner: omabox setup --aquamarine'
            'base-devel: omabox setup --aquamarine'
            'github-cli: the opt-in omabox-feedback skill (setup --feedback-skill) files issues with gh')
install=omabox.install
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('7c77e89c64c39899f7496a457c6eb207372e6384caf9c4c39ae083851cae8cca')

_tools=(pointer keyboard wlfd peek still relay events burst tree)

build() {
  # Built in a copy, so the generated protocol sources stay out of the package.
  rm -rf tools
  cp -r "$pkgname-$pkgver/tools" tools
  local t
  for t in "${_tools[@]}"; do
    make -C "tools/$t"
  done
}

package() {
  install -dm755 "$pkgdir/usr/lib"
  cp -r --no-preserve=ownership "$pkgname-$pkgver" "$pkgdir/usr/lib/omabox"
  local t
  for t in "${_tools[@]}"; do
    install -Dm755 "tools/$t/omabox-$t" "$pkgdir/usr/lib/omabox/tools/$t/omabox-$t"
  done
  install -dm755 "$pkgdir/usr/bin"
  ln -s ../lib/omabox/bin/omabox "$pkgdir/usr/bin/omabox"
  install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
