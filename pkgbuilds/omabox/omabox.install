post_install() {
  echo ":: Each user runs 'omabox setup' once: the agent skill, the bar widget and the agent guard."
  echo ":: Before removing the package, each user runs 'omabox setup --remove'."
}

pre_remove() {
  echo ":: Users who ran 'omabox setup' should have run 'omabox setup --remove' first;"
  echo ":: their links into /usr/lib/omabox stop working once it is gone."
}

post_upgrade() {
  echo ":: omabox upgraded: restart the shell (omarchy restart shell) to load the new bar widget,"
  echo ":: and run 'omabox setup' again if this version's changelog asks for it."
}
