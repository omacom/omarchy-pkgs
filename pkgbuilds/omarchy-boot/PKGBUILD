# Maintainer: Ryan Hughes <ryan@omarchy.org>
#
# The boot stack an x86 Omarchy install boots through: Limine, its entry tool
# and its snapshot entries. omarchy depends on omarchy-boot rather than on
# these directly, so a machine that moved to systemd-boot (omarchy-boot-switch
# installs omarchy-boot-systemd, which provides omarchy-boot) can drop them,
# and a machine that didn't keeps them as dependencies instead of seeing them
# turn into orphans.
pkgname='omarchy-boot'
pkgver=1
pkgrel=1
pkgdesc='Omarchy boot stack: the Limine boot loader with snapshot entries'
arch=('x86_64')
url='https://omarchy.org'
license=('MIT')
depends=(
  'limine'
  'limine-mkinitcpio-hook'
  'limine-snapper-sync'
  'snapper'
)
