diff --git a/tests/integration_test.py b/tests/integration_test.py
index 0994cf2..5648c1e 100644
--- a/tests/integration_test.py
+++ b/tests/integration_test.py
@@ -1258,6 +1258,134 @@ class Tests(dbusmock.DBusTestCase):
         self.assert_file_eventually_contains(energy_prefs, "power")
         self.assert_file_eventually_contains(scaling_governor, "powersave")
 
+    def create_cppc_policy(
+        self,
+        name,
+        driver="cppc_cpufreq",
+        governors="conservative ondemand userspace powersave performance schedutil",
+    ):
+        """Create a cpufreq policy with CPPC autonomous selection knobs"""
+        policy = os.path.join(
+            self.testbed.get_root_dir(), f"sys/devices/system/cpu/cpufreq/{name}/"
+        )
+        os.makedirs(policy)
+        self.write_file_contents(os.path.join(policy, "scaling_driver"), f"{driver}\n")
+        self.write_file_contents(
+            os.path.join(policy, "scaling_available_governors"), f"{governors}\n"
+        )
+        self.write_file_contents(os.path.join(policy, "scaling_governor"), "schedutil\n")
+        self.write_file_contents(os.path.join(policy, "auto_select"), "0\n")
+        self.write_file_contents(
+            os.path.join(policy, "energy_performance_preference_val"), "127\n"
+        )
+        return policy
+
+    def assert_cppc_policies(self, policies, governor, auto_select, epp=None):
+        """Check the CPPC settings of every policy"""
+        for policy in policies:
+            self.assert_file_eventually_contains(
+                os.path.join(policy, "scaling_governor"), governor
+            )
+            self.assert_file_eventually_contains(
+                os.path.join(policy, "auto_select"), auto_select
+            )
+            if epp is not None:
+                self.assert_file_eventually_contains(
+                    os.path.join(policy, "energy_performance_preference_val"), epp
+                )
+
+    def test_cppc(self):
+        """CPPC cpufreq driver with autonomous selection (no UPower)"""
+
+        policies = [self.create_cppc_policy("policy0"), self.create_cppc_policy("policy1")]
+
+        self.start_daemon()
+
+        profiles = self.get_dbus_property("Profiles")
+        self.assertEqual(len(profiles), 3)
+        self.assertEqual(profiles[0]["Driver"], "multiple")
+        self.assertEqual(profiles[0]["CpuDriver"], "cppc_cpufreq")
+        self.assertEqual(profiles[0]["Profile"], "power-saver")
+
+        self.assert_cppc_policies(policies, "schedutil", "1", "64")
+
+        # Performance leaves autonomous selection and runs the performance governor
+        self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("performance"))
+        self.assertEqual(self.get_dbus_property("ActiveProfile"), "performance")
+        self.assert_cppc_policies(policies, "performance", "0")
+
+        # Power saver goes back to autonomous selection, biased to efficiency
+        self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("power-saver"))
+        self.assertEqual(self.get_dbus_property("ActiveProfile"), "power-saver")
+        self.assert_cppc_policies(policies, "schedutil", "1", "192")
+
+    def test_cppc_reapply_on_resume_from_sleep(self):
+        """CPPC settings are reapplied after resume"""
+
+        policy = self.create_cppc_policy("policy0")
+        auto_select = os.path.join(policy, "auto_select")
+
+        _, obj_logind, _ = self.start_dbus_template("logind", {})
+
+        self.start_daemon()
+        self.assert_dbus_property_eventually_is(
+            "ActiveProfile", "balanced", keep_checking=100
+        )
+        self.assert_file_eventually_contains(auto_select, "1")
+
+        # Simulate firmware resetting autonomous selection across suspend
+        obj_logind.EmitSignal(
+            "org.freedesktop.login1.Manager", "PrepareForSleep", "b", [True]
+        )
+        self.write_file_contents(auto_select, "0\n")
+        obj_logind.EmitSignal(
+            "org.freedesktop.login1.Manager", "PrepareForSleep", "b", [False]
+        )
+
+        self.assert_file_eventually_contains(
+            auto_select, "1", timeout=3000, keep_checking=100
+        )
+
+    def test_cppc_without_autonomous_selection(self):
+        """CPPC cpufreq driver without autonomous selection falls back to placeholder"""
+
+        policy = os.path.join(
+            self.testbed.get_root_dir(), "sys/devices/system/cpu/cpufreq/policy0/"
+        )
+        os.makedirs(policy)
+        self.write_file_contents(os.path.join(policy, "scaling_driver"), "cppc_cpufreq\n")
+        self.write_file_contents(
+            os.path.join(policy, "scaling_available_governors"), "performance schedutil\n"
+        )
+        self.write_file_contents(os.path.join(policy, "scaling_governor"), "schedutil\n")
+
+        self.start_daemon()
+
+        profiles = self.get_dbus_property("Profiles")
+        self.assertEqual(len(profiles), 2)
+        self.assertEqual(profiles[0]["Driver"], "placeholder")
+
+    def test_cppc_without_schedutil(self):
+        """CPPC cpufreq driver without the schedutil governor falls back to placeholder"""
+
+        self.create_cppc_policy("policy0", governors="performance powersave")
+
+        self.start_daemon()
+
+        profiles = self.get_dbus_property("Profiles")
+        self.assertEqual(len(profiles), 2)
+        self.assertEqual(profiles[0]["Driver"], "placeholder")
+
+    def test_cppc_other_cpufreq_driver(self):
+        """CPPC knobs on a non-CPPC cpufreq driver are ignored"""
+
+        self.create_cppc_policy("policy0", driver="acpi-cpufreq")
+
+        self.start_daemon()
+
+        profiles = self.get_dbus_property("Profiles")
+        self.assertEqual(len(profiles), 2)
+        self.assertEqual(profiles[0]["Driver"], "placeholder")
     # pylint: disable=too-many-statements
     def test_amd_pstate_min_freq(self):
         """AMD P-State driver min freq support"""
