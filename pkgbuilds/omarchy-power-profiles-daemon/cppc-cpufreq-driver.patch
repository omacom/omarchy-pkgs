new file mode 100644
index 0000000..c03df2a
--- /dev/null
+++ b/src/ppd-driver-cppc.c
@@ -0,0 +1,334 @@
+/*
+ * Copyright (c) 2020 Bastien Nocera <hadess@hadess.net>
+ * Copyright (c) 2026 David Heinemeier Hansson <david@hey.com>
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License version 3 as published by
+ * the Free Software Foundation.
+ *
+ */
+
+/*
+ * Profile driver for the generic ACPI CPPC cpufreq driver (cppc_cpufreq),
+ * as used by ARM64 laptops. Balanced and power-saver hand frequency
+ * selection to the platform ("autonomous selection") with an energy
+ * performance preference, while performance runs the performance governor.
+ */
+
+#define G_LOG_DOMAIN "CpuDriver"
+
+#include "ppd-utils.h"
+#include "ppd-driver-cppc.h"
+
+#define CPUFREQ_POLICY_DIR "/sys/devices/system/cpu/cpufreq/"
+
+/* energy_performance_preference_val: 0 is max performance, 255 max efficiency */
+#define EPP_BALANCED "64"
+#define EPP_POWER_SAVER "192"
+
+typedef struct
+{
+  char *path;
+  /* Settings found at probe time, restored if the first activation fails */
+  char *governor;
+  char *auto_select;
+  char *epp;
+} CppcPolicy;
+
+struct _PpdDriverCppc
+{
+  PpdDriverCpu  parent_instance;
+
+  PpdProfile activated_profile;
+  GPtrArray *policies; /* Array of CppcPolicy */
+};
+
+G_DEFINE_TYPE (PpdDriverCppc, ppd_driver_cppc, PPD_TYPE_DRIVER_CPU)
+
+static void
+cppc_policy_free (CppcPolicy *policy)
+{
+  g_free (policy->path);
+  g_free (policy->governor);
+  g_free (policy->auto_select);
+  g_free (policy->epp);
+  g_free (policy);
+}
+
+static GObject*
+ppd_driver_cppc_constructor (GType                  type,
+                             guint                  n_construct_params,
+                             GObjectConstructParam *construct_params)
+{
+  GObject *object;
+
+  object = G_OBJECT_CLASS (ppd_driver_cppc_parent_class)->constructor (type,
+                                                                       n_construct_params,
+                                                                       construct_params);
+  g_object_set (object,
+                "driver-name", "cppc_cpufreq",
+                "profiles", PPD_PROFILE_PERFORMANCE | PPD_PROFILE_BALANCED | PPD_PROFILE_POWER_SAVER,
+                NULL);
+
+  return object;
+}
+
+static char *
+read_policy_file (const char *base,
+                  const char *name)
+{
+  g_autofree char *path = NULL;
+  g_autofree char *contents = NULL;
+  g_autoptr(GError) error = NULL;
+
+  path = g_build_filename (base, name, NULL);
+  if (!g_file_get_contents (path, &contents, NULL, &error)) {
+    g_debug ("Failed to read %s: %s", path, error->message);
+    return NULL;
+  }
+
+  return g_strdup (g_strstrip (contents));
+}
+
+static gboolean
+write_policy_file (const char  *base,
+                   const char  *name,
+                   const char  *value,
+                   GError     **error)
+{
+  g_autofree char *path = NULL;
+
+  path = g_build_filename (base, name, NULL);
+  return ppd_utils_write (path, value, error);
+}
+
+static gboolean
+has_governors (const char *base)
+{
+  g_autofree char *available = NULL;
+  g_auto(GStrv) governors = NULL;
+
+  available = read_policy_file (base, "scaling_available_governors");
+  if (!available)
+    return FALSE;
+
+  governors = g_strsplit_set (available, " \t\n", -1);
+  return g_strv_contains ((const char * const *) governors, "schedutil") &&
+         g_strv_contains ((const char * const *) governors, "performance");
+}
+
+static CppcPolicy *
+probe_policy (const char *base)
+{
+  g_autofree char *driver = NULL;
+  g_autoptr(GError) error = NULL;
+  CppcPolicy *policy;
+
+  driver = read_policy_file (base, "scaling_driver");
+  if (g_strcmp0 (driver, "cppc_cpufreq") != 0)
+    return NULL;
+
+  /* Every profile switches to one of these */
+  if (!has_governors (base)) {
+    g_debug ("%s lacks the schedutil or performance governor", base);
+    return NULL;
+  }
+
+  policy = g_new0 (CppcPolicy, 1);
+  policy->path = g_strdup (base);
+  policy->governor = read_policy_file (base, "scaling_governor");
+  /* Autonomous selection is optional in CPPC, so its knobs may be missing */
+  policy->auto_select = read_policy_file (base, "auto_select");
+  policy->epp = read_policy_file (base, "energy_performance_preference_val");
+
+  if (!policy->governor || !policy->auto_select || !policy->epp) {
+    cppc_policy_free (policy);
+    return NULL;
+  }
+
+  /* Check that the knobs are writable by writing back what they hold */
+  if (!write_policy_file (base, "auto_select", policy->auto_select, &error) ||
+      !write_policy_file (base, "energy_performance_preference_val", policy->epp, &error)) {
+    g_debug ("Failed to write CPPC settings in %s: %s", base, error->message);
+    cppc_policy_free (policy);
+    return NULL;
+  }
+
+  return policy;
+}
+
+static PpdProbeResult
+ppd_driver_cppc_probe (PpdDriver *driver)
+{
+  PpdDriverCppc *cppc = PPD_DRIVER_CPPC (driver);
+  g_autoptr(GDir) dir = NULL;
+  g_autofree char *policy_dir = NULL;
+  const char *dirname;
+
+  policy_dir = ppd_utils_get_sysfs_path (CPUFREQ_POLICY_DIR);
+  dir = g_dir_open (policy_dir, 0, NULL);
+  if (!dir) {
+    g_debug ("Could not open %s", policy_dir);
+    return PPD_PROBE_RESULT_FAIL;
+  }
+
+  while ((dirname = g_dir_read_name (dir)) != NULL) {
+    g_autofree char *base = NULL;
+    CppcPolicy *policy;
+
+    base = g_build_filename (policy_dir, dirname, NULL);
+    policy = probe_policy (base);
+    if (!policy)
+      continue;
+
+    if (!cppc->policies)
+      cppc->policies = g_ptr_array_new_with_free_func ((GDestroyNotify) cppc_policy_free);
+
+    g_ptr_array_add (cppc->policies, policy);
+  }
+
+  g_debug ("%s CPPC autonomous selection settings",
+           cppc->policies && cppc->policies->len ? "Found" : "Didn't find");
+
+  if (cppc->policies && cppc->policies->len)
+    return PPD_PROBE_RESULT_SUCCESS;
+
+  return PPD_PROBE_RESULT_FAIL;
+}
+
+static gboolean
+apply_pref_to_policies (GPtrArray   *policies,
+                        PpdProfile   profile,
+                        GError     **error)
+{
+  if (profile == PPD_PROFILE_UNSET)
+    return TRUE;
+
+  for (guint i = 0; i < policies->len; ++i) {
+    const char *base = ((CppcPolicy *) g_ptr_array_index (policies, i))->path;
+
+    switch (profile) {
+    case PPD_PROFILE_PERFORMANCE:
+      /* Leave autonomous selection first so the governor owns the frequency */
+      if (!write_policy_file (base, "auto_select", "0", error) ||
+          !write_policy_file (base, "scaling_governor", "performance", error))
+        return FALSE;
+      break;
+    case PPD_PROFILE_BALANCED:
+    case PPD_PROFILE_POWER_SAVER:
+      if (!write_policy_file (base, "scaling_governor", "schedutil", error) ||
+          !write_policy_file (base, "energy_performance_preference_val",
+                              profile == PPD_PROFILE_BALANCED ? EPP_BALANCED : EPP_POWER_SAVER,
+                              error) ||
+          !write_policy_file (base, "auto_select", "1", error))
+        return FALSE;
+      break;
+    default:
+      g_assert_not_reached ();
+    }
+  }
+
+  return TRUE;
+}
+
+static void
+restore_probed_settings (GPtrArray *policies)
+{
+  for (guint i = 0; i < policies->len; ++i) {
+    CppcPolicy *policy = g_ptr_array_index (policies, i);
+    g_autoptr(GError) error = NULL;
+
+    if (!write_policy_file (policy->path, "auto_select", "0", &error) ||
+        !write_policy_file (policy->path, "scaling_governor", policy->governor, &error) ||
+        !write_policy_file (policy->path, "energy_performance_preference_val", policy->epp, &error) ||
+        !write_policy_file (policy->path, "auto_select", policy->auto_select, &error))
+      g_warning ("failed to restore CPPC settings in %s: %s", policy->path, error->message);
+  }
+}
+
+static gboolean
+ppd_driver_cppc_activate_profile (PpdDriver                   *driver,
+                                  PpdProfile                   profile,
+                                  PpdProfileActivationReason   reason,
+                                  GError                     **error)
+{
+  PpdDriverCppc *cppc = PPD_DRIVER_CPPC (driver);
+  gboolean ret = FALSE;
+
+  g_return_val_if_fail (cppc->policies != NULL, FALSE);
+  g_return_val_if_fail (cppc->policies->len != 0, FALSE);
+
+  ret = apply_pref_to_policies (cppc->policies, profile, error);
+  if (!ret) {
+    g_autoptr(GError) error_local = NULL;
+
+    /* Policies may be left half-switched, so put them all back */
+    if (cppc->activated_profile == PPD_PROFILE_UNSET)
+      restore_probed_settings (cppc->policies);
+    else if (!apply_pref_to_policies (cppc->policies,
+                                      cppc->activated_profile,
+                                      &error_local))
+      g_warning ("failed to restore previous profile: %s", error_local->message);
+    return ret;
+  }
+
+  cppc->activated_profile = profile;
+
+  return ret;
+}
+
+static gboolean
+ppd_driver_cppc_prepare_for_sleep (PpdDriver  *driver,
+                                   gboolean    start,
+                                   GError    **error)
+{
+  PpdDriverCppc *cppc = PPD_DRIVER_CPPC (driver);
+  g_autoptr(GError) local_error = NULL;
+
+  if (start)
+    return TRUE;
+
+  /* Firmware may reset CPPC registers across suspend */
+  g_debug ("Re-applying CPPC settings");
+  if (!ppd_driver_cppc_activate_profile (driver,
+                                         cppc->activated_profile,
+                                         PPD_PROFILE_ACTIVATION_REASON_RESUME,
+                                         &local_error)) {
+    g_propagate_prefixed_error (error, g_steal_pointer (&local_error),
+                                "Could not reapply CPPC settings on resume: ");
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+static void
+ppd_driver_cppc_finalize (GObject *object)
+{
+  PpdDriverCppc *driver;
+
+  driver = PPD_DRIVER_CPPC (object);
+  g_clear_pointer (&driver->policies, g_ptr_array_unref);
+  G_OBJECT_CLASS (ppd_driver_cppc_parent_class)->finalize (object);
+}
+
+static void
+ppd_driver_cppc_class_init (PpdDriverCppcClass *klass)
+{
+  GObjectClass *object_class;
+  PpdDriverClass *driver_class;
+
+  object_class = G_OBJECT_CLASS (klass);
+  object_class->constructor = ppd_driver_cppc_constructor;
+  object_class->finalize = ppd_driver_cppc_finalize;
+
+  driver_class = PPD_DRIVER_CLASS (klass);
+  driver_class->probe = ppd_driver_cppc_probe;
+  driver_class->activate_profile = ppd_driver_cppc_activate_profile;
+  driver_class->prepare_to_sleep = ppd_driver_cppc_prepare_for_sleep;
+}
+
+static void
+ppd_driver_cppc_init (PpdDriverCppc *self)
+{
+}
