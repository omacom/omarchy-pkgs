@@ -358,6 +359,53 @@ class Tests(dbusmock.DBusTestCase):
             os.path.join(proc_dir, "cpuinfo"), "vendor_id	: AuthenticAMD\n"
         )
 
+    def create_nvidia_rtx_spark(
+        self,
+        processor_version="NVIDIA RTX Spark N1X (6144-core GPU, 20-core CPU)",
+    ):
+        dmi_dir = os.path.join(
+            self.testbed.get_root_dir(), "sys/firmware/dmi/entries/4-0/"
+        )
+        os.makedirs(dmi_dir)
+        type4 = bytearray(0x11)
+        type4[0] = 4
+        type4[1] = len(type4)
+        type4[0x04] = 1
+        type4[0x07] = 2
+        type4[0x10] = 3
+        type4.extend(
+            b"CPU 0\0NVIDIA\0" + processor_version.encode("utf-8") + b"\0\0"
+        )
+        self.write_file_contents(os.path.join(dmi_dir, "raw"), bytes(type4))
+
+        policy_root = os.path.join(
+            self.testbed.get_root_dir(), "sys/devices/system/cpu/cpufreq/"
+        )
+        policies = {}
+        for policy, max_freq in (("policy0", "2000000"), ("policy4", "4004000")):
+            policy_dir = os.path.join(policy_root, policy)
