# Maintainer: David Heinemeier Hansson <david@hey.com>
# Contributor: Antonio Rojas <arojas@archlinux.org>
# Contributor: tinywrkb <tinywrkb@gmail.com>

pkgname=omarchy-power-profiles-daemon
_pkgname=power-profiles-daemon
pkgver=0.30
pkgrel=2
pkgdesc='Makes power profiles handling available over D-Bus (with NVIDIA RTX Spark CPU profiles)'
url='https://gitlab.freedesktop.org/upower/power-profiles-daemon'
license=(GPL-3.0-only)
arch=(x86_64 aarch64)
depends=(glib2
         glibc
         libgcc
         libgudev
         polkit
         upower)
optdepends=('python-gobject: for powerprofilesctl')
makedepends=(bash-completion
             git
             glib2-devel
             python-argparse-manpage
             python-shtab
             meson)
checkdepends=(python-dbusmock
              python-isort
              python-mccabe
              umockdev)
provides=(power-profiles-daemon)
conflicts=(power-profiles-daemon)
source=(git+https://gitlab.freedesktop.org/upower/$_pkgname#tag=$pkgver
        nvidia-rtx-spark-power-profiles.patch)
sha256sums=('e955e833b01cbff9b5b00349592239e58c559d717eb49f3371f42932676e7a40'
            '5c3e350afd1baf668aca5d64d9692ec816f72d90ed93aec1f655aeb0d75b2bf1')

prepare() {
  cd $_pkgname
  # NVIDIA's RTX Spark (N1X) cppc_cpufreq driver. It sets an energy
  # performance preference per core type, which only takes effect with CPPC
  # autonomous selection on (Omarchy's N1x setup turns it on with a udev rule,
  # as NVIDIA's power-knobs package does), and a governor per profile and power
  # source: schedutil, which lets the kernel's energy-aware scheduling run, in
  # power-saver and on battery in balanced, and performance otherwise.
  # Drop it once upstream merges it:
  # https://gitlab.freedesktop.org/upower/power-profiles-daemon/-/merge_requests/236
  patch -p1 -i "$srcdir/nvidia-rtx-spark-power-profiles.patch"
}

build() {
  meson $_pkgname build \
    --prefix /usr \
    --libexec lib \
    --sysconfdir /usr/share \
    -Dzshcomp=/usr/share/zsh/site-functions \
    -Dbashcomp=enabled \
    -Dmanpage=enabled
  meson compile -C build
}

check() {
  meson test -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  # Run powerprofilesctl with the system Python, not whichever python3 a mise
  # or venv puts first on PATH, which lacks PyGObject.
  sed -i '1c #!/usr/bin/python3' "$pkgdir/usr/bin/powerprofilesctl"
}
