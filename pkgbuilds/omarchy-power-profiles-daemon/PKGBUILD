prepare() {
  cd $_pkgname
  # NVIDIA's RTX Spark (N1X) cppc_cpufreq driver. It sets an energy
  # performance preference per core type, which only takes effect with CPPC
  # autonomous selection on (Omarchy's N1x setup turns it on with a udev rule,
  # as NVIDIA's power-knobs package does), and a governor per profile and power
  # source: schedutil, which lets the kernel's energy-aware scheduling run, in
  # power-saver and on battery in balanced, and performance otherwise.
  # Drop it once upstream merges it:
  # https://gitlab.freedesktop.org/upower/power-profiles-daemon/-/merge_requests/236
  patch -p1 -i "$srcdir/nvidia-rtx-spark-power-profiles.patch"
  # The GB10 desktops (DGX Spark, ASUS Ascent GX10) share the N1X's CPU
  # complex but report their processor version as plain "GB10", so the driver
  # above never probed there and schedutil stayed on: idle-to-busy ramps left
  # bursty work (browsers, the desktop) running at a third to a half of full
  # speed. Match
  # GB10 too, which puts it on the performance governor on AC. CPPC autonomous
  # selection stays off on GB10, so the EPP values the driver writes do not
  # apply there. Offer upstream alongside !236.
  patch -p1 -i "$srcdir/nvidia-gb10.patch"

  # Merged upstream after 0.30 (!238, !237): accept the kernel's
  # balanced-performance spelling, and add a generic cpufreq driver that
  # uses the boost switch on Apple Silicon.
  patch -p1 -i "$srcdir/balanced-performance-spelling.patch"
  patch -p1 -i "$srcdir/cpufreq-boost-driver.patch"
  # Snapdragon X (scmi, qcom-cpufreq-hw) has no energy preference, so this
  # caps each cluster's maximum frequency: 60% in power-saver, 75% in
  # balanced, none in performance. Proposed upstream as !239.
  patch -p1 -i "$srcdir/cpufreq-caps.patch"
  # Apple Silicon without boost frequencies (M3 Max) has a boost switch the
  # kernel refuses to turn on, so the boost method failed every profile but
  # power-saver and performance could not be selected. Cap power-saver there
  # instead, at 60%, and leave balanced and performance uncapped.
  patch -p1 -i "$srcdir/cpufreq-apple-no-boost.patch"
  # The boost switch and the caps above left Snapdragon X and Apple Silicon
  # on schedutil in every profile, which ramps too slowly for bursty work:
  # Speedometer 3.1 scored 23.1 under schedutil and 45.4 under performance on
  # an X2 Elite (48 on Windows), and 28.8 against 34.4 on a MacBook Neo.
  # Switch to the performance governor in performance, as GB10 does on AC,
  # and back to schedutil in balanced and power-saver.
  patch -p1 -i "$srcdir/cpufreq-caps-governor.patch"
  # Devicetree systems (Snapdragon X: the Surface Pro 11's
  # surface_platform_profile) have no /sys/firmware/acpi/platform_profile,
  # only the platform-profile class, so the driver never probed and the
  # placeholder took over. Use the class interface when there is a single
  # handler and no ACPI aggregate. To be offered upstream.
  patch -p1 -i "$srcdir/platform-profile-class.patch"
  # Sandy Bridge MacBookPro8,2 lacks EPP/EPB. Extend the existing cpufreq
  # backend rather than replace the daemon or its D-Bus/authorization code.
  patch -p1 -i "$srcdir/macbookpro-2011-passive-pstate.patch"
}

build() {
  meson $_pkgname build \
    --prefix /usr \
    --libexec lib \
    --sysconfdir /usr/share \
    -Dzshcomp=/usr/share/zsh/site-functions \
    -Dbashcomp=enabled \
    -Dmanpage=enabled
  meson compile -C build
}

check() {
  meson test -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  # Run powerprofilesctl with the system Python, not whichever python3 a mise
  # or venv puts first on PATH, which lacks PyGObject.
  sed -i '1c #!/usr/bin/python3' "$pkgdir/usr/bin/powerprofilesctl"
}
