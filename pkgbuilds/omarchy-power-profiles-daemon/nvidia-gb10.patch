diff --git a/tests/integration_test.py b/tests/integration_test.py
index e331acd..992e78e 100644
--- a/tests/integration_test.py
+++ b/tests/integration_test.py
@@ -807,6 +807,20 @@ class Tests(dbusmock.DBusTestCase):
         self.assert_file_eventually_contains(efficiency_governor, "schedutil")
         self.assert_file_eventually_contains(performance_governor, "schedutil")
 
+    def test_nvidia_gb10(self):
+        """NVIDIA GB10 desktops use the RTX Spark CPPC settings"""
+
+        policies = self.create_nvidia_rtx_spark(processor_version="GB10")
+        self.start_daemon()
+
+        profiles = self.get_dbus_property("Profiles")
+        self.assertEqual(len(profiles), 3)
+        self.assertEqual(profiles[0]["CpuDriver"], "nvidia_rtx_spark")
+        self.assertEqual(self.get_dbus_property("ActiveProfile"), "balanced")
+        self.assert_file_eventually_contains(
+            os.path.join(policies["policy4"], "scaling_governor"), "performance"
+        )
+
     def test_nvidia_rtx_spark_processor_gate(self):
         """The RTX Spark values are not applied to other CPPC systems"""
 
