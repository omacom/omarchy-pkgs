From 76059c3abc2dbc7ec15ec852707fe7c6854dad83 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 17:01:56 +0000
Subject: [PATCH] cpufreq: Keep Apple Silicon on schedutil in performance

With the performance governor in the performance profile, which
Omarchy selects on AC, a MacBook Pro M4 (J604) holds both clusters at
their top frequency while it idles: 4464 and 2892 MHz, 100 % of the
time, with no transitions. macOS on the same machine idles them at
912 and 1080 MHz on AC.

schedutil on that machine is not the slow ramp that made performance
worth it elsewhere: a one-thread burst on an efficiency core reaches
its top state in a median of 18 ms (macOS ramps its P cluster in 71
to 75 ms; the P cluster's ramp under schedutil is not measured). It
also keeps the scheduler's energy-aware placement, which needs
schedutil, so idle work stays on the efficiency cores as on macOS.

Keep apple-cpufreq on schedutil in every profile. The boost switch
and the power-saver caps are unchanged.

Test: meson test, 187 OK, 8 skipped, 0 failed.
---
 src/ppd-driver-cpufreq.c  |  8 +++++++-
 tests/integration_test.py | 18 ++++++++++--------
 2 files changed, 17 insertions(+), 9 deletions(-)

diff --git a/src/ppd-driver-cpufreq.c b/src/ppd-driver-cpufreq.c
index 1d4ceb1..45e66d7 100644
--- a/src/ppd-driver-cpufreq.c
+++ b/src/ppd-driver-cpufreq.c
@@ -443,7 +443,13 @@ ppd_driver_cpufreq_probe (PpdDriver *driver)
   case CPUFREQ_METHOD_NONE:
     return PPD_PROBE_RESULT_FAIL;
   case CPUFREQ_METHOD_BOOST:
-    cpufreq->performance_governor = TRUE;
+    /* Apple Silicon stays on schedutil in performance too. With the
+     * performance governor a MacBook Pro M4 (J604) on AC holds both clusters
+     * at their top frequency while idle (P 4464, E 2892 MHz, 100 %), where
+     * macOS idles them at 912 and 1080 MHz, and schedutil there reaches the
+     * top in 18 ms (macOS ramps its P cluster in 71 to 75 ms). It also keeps
+     * the scheduler's energy-aware placement, which needs schedutil. */
+    cpufreq->performance_governor = FALSE;
     if (boost_can_be_enabled (policy_dirs)) {
       ret = probe_boost (cpufreq);
       break;
diff --git a/tests/integration_test.py b/tests/integration_test.py
index ecc3eb2..eb00a26 100644
--- a/tests/integration_test.py
+++ b/tests/integration_test.py
@@ -1591,20 +1591,21 @@ class Tests(dbusmock.DBusTestCase):
 
         self.start_daemon()
         self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("performance"))
-        for gov in govs:
-            self.assert_file_eventually_contains(gov, "performance")
         self.assert_file_eventually_contains(boost, "1")
+        # Apple Silicon stays on schedutil in performance
+        for gov in govs:
+            self.assertEqual(self.read_file_contents(gov), b"schedutil\n")
 
         self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("power-saver"))
-        for gov in govs:
-            self.assert_file_eventually_contains(gov, "schedutil")
         self.assert_file_eventually_contains(boost, "0")
+        for gov in govs:
+            self.assertEqual(self.read_file_contents(gov), b"schedutil\n")
 
         self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("performance"))
-        self.assert_file_eventually_contains(govs[0], "performance")
+        self.assert_file_eventually_contains(boost, "1")
         self.stop_daemon()
         for gov in govs:
-            self.assertEqual(self.read_file_contents(gov), b"schedutil")
+            self.assertEqual(self.read_file_contents(gov), b"schedutil\n")
 
     def test_cpufreq_boost(self):
         """Generic cpufreq driver switches the global boost per profile"""
@@ -1823,10 +1824,11 @@ class Tests(dbusmock.DBusTestCase):
 
         self.start_daemon()
         self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("performance"))
-        self.assert_file_eventually_contains(gov0, "performance")
+        self.assert_file_eventually_contains(max0, "4056000")
+        self.assertEqual(self.read_file_contents(gov0), b"schedutil\n")
         self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("balanced"))
-        self.assert_file_eventually_contains(gov0, "schedutil")
         self.assert_file_eventually_contains(max0, "4056000")
+        self.assertEqual(self.read_file_contents(gov0), b"schedutil\n")
 
     def test_cpufreq_apple_without_boost_lifted_on_exit(self):
         """Stopping in power-saver lifts the cap on Apple Silicon too"""
