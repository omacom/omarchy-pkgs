- * keeps the boost method's split: balanced and performance run uncapped.
+ * keeps the boost method's split: balanced and performance run uncapped. Its
+ * governor follows the profile as with any caps: on a MacBook Neo (A18 Pro),
+ * Speedometer 3.1 scored 28.8 under schedutil and 34.4 under performance.
  *
  * It is only used when every cpufreq policy runs one of the scaling drivers
  * in the table below. Any other system keeps its current driver.
@@ -59,6 +67,9 @@
 #define BALANCED_PERCENT           75
 #define UNCAPPED_PERCENT           100
 
+#define PERFORMANCE_GOVERNOR       "performance"
+#define DEFAULT_GOVERNOR           "schedutil"
+
 typedef enum {
   CPUFREQ_METHOD_NONE,
   CPUFREQ_METHOD_BOOST,
@@ -505,6 +516,57 @@ write_cap (Policy   *policy,
   return FALSE;
 }
 
+static const char *
+profile_to_governor (PpdProfile profile)
+{
+  switch (profile) {
+  case PPD_PROFILE_POWER_SAVER:
+  case PPD_PROFILE_BALANCED:
+    return DEFAULT_GOVERNOR;
+  case PPD_PROFILE_PERFORMANCE:
+    return PERFORMANCE_GOVERNOR;
+  }
+
+  g_return_val_if_reached (DEFAULT_GOVERNOR);
+}
+
+/* Switches the policy's governor where it offers both governors the
+ * profiles use. A failure is reported but doesn't fail the profile change:
+ * the cap or the boost switch, which was written, is what tells the profiles
+ * apart. */
+static void
+write_governor (const char *dir,
+                const char *governor)
+{
+  g_autofree char *available = NULL;
+  g_autofree char *current = NULL;
+  g_autofree char *path = NULL;
+  g_auto(GStrv) governors = NULL;
+  g_autoptr(GError) error = NULL;
+
+  available = read_attr (dir, "scaling_available_governors");
+  if (!available) {
+    g_debug ("%s lists no governors", dir);
+    return;
+  }
+  governors = g_strsplit_set (available, " \n\t", -1);
+  if (!g_strv_contains ((const char * const *) governors, PERFORMANCE_GOVERNOR) ||
+      !g_strv_contains ((const char * const *) governors, DEFAULT_GOVERNOR)) {
+    g_debug ("%s does not offer the %s and %s governors", dir,
+             PERFORMANCE_GOVERNOR, DEFAULT_GOVERNOR);
+    return;
+  }
+
+  current = read_attr (dir, "scaling_governor");
+  if (g_strcmp0 (current, governor) == 0)
+    return;
+
+  path = g_build_filename (dir, "scaling_governor", NULL);
+  if (!ppd_utils_write (path, governor, &error))
+    g_warning ("Could not switch %s to the %s governor: %s", dir, governor,
+               error ? error->message : "unknown error");
+}
+
 static gboolean
 has_policy (PpdDriverCpufreq *cpufreq,
             const char       *dir)
@@ -592,6 +654,7 @@ apply_caps (PpdDriverCpufreq  *cpufreq,
       i++;
       continue;
     }
+    write_governor (policy->dir, profile_to_governor (profile));
     written++;
     i++;
   }
@@ -606,6 +669,29 @@ apply_caps (PpdDriverCpufreq  *cpufreq,
   return TRUE;
 }
 
+/* The boost method has no policy table, so every policy present is switched,
+ * including any that came online since the last change */
+static void
+write_governors (const char *governor)
+{
+  g_autoptr(GPtrArray) dirs = list_policy_dirs ();
+
+  for (guint i = 0; i < dirs->len; i++)
+    write_governor (g_ptr_array_index (dirs, i), governor);
+}
+
+static gboolean
+apply_boost (PpdDriverCpufreq  *cpufreq,
+             PpdProfile         profile,
+             GError           **error)
+{
+  if (!ppd_utils_write (cpufreq->boost_path, profile_to_boost (profile), error))
+    return FALSE;
+
+  write_governors (profile_to_governor (profile));
+  return TRUE;
+}
+
 static gboolean
 apply_profile (PpdDriverCpufreq  *cpufreq,
                PpdProfile         profile,
@@ -613,7 +699,7 @@ apply_profile (PpdDriverCpufreq  *cpufreq,
 {
   switch (cpufreq->method) {
   case CPUFREQ_METHOD_BOOST:
-    return ppd_utils_write (cpufreq->boost_path, profile_to_boost (profile), error);
+    return apply_boost (cpufreq, profile, error);
   case CPUFREQ_METHOD_CAPS:
     return apply_caps (cpufreq, profile, error);
   case CPUFREQ_METHOD_NONE:
@@ -676,7 +762,8 @@ ppd_driver_cpufreq_prepare_for_sleep (PpdDriver  *driver,
   return TRUE;
 }
 
-/* A cap left behind would slow the machine down until reboot */
+/* A cap left behind would slow the machine down until reboot, and the
+ * performance governor would keep the CPUs at full clock */
 static void
 ppd_driver_cpufreq_dispose (GObject *object)
 {
@@ -690,6 +777,7 @@ ppd_driver_cpufreq_dispose (GObject *object)
       Policy *policy = g_ptr_array_index (cpufreq->policies, i);
       g_autoptr(GError) error = NULL;
 
+      write_governor (policy->dir, DEFAULT_GOVERNOR);
       if (write_cap (policy, policy->top_freq, &error))
         continue;
       /* The kernel keeps an offline policy's limit until it is written again */
@@ -702,6 +790,13 @@ ppd_driver_cpufreq_dispose (GObject *object)
     cpufreq->activated_profile = PPD_PROFILE_UNSET;
   }
 
+  if (cpufreq->method == CPUFREQ_METHOD_BOOST &&
+      cpufreq->activated_profile != PPD_PROFILE_UNSET) {
+    g_debug ("Setting the %s governor back", DEFAULT_GOVERNOR);
+    write_governors (DEFAULT_GOVERNOR);
+    cpufreq->activated_profile = PPD_PROFILE_UNSET;
+  }
+
   G_OBJECT_CLASS (ppd_driver_cpufreq_parent_class)->dispose (object);
 }
 
diff --git a/tests/integration_test.py b/tests/integration_test.py
