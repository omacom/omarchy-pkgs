@@ -1576,6 +1576,36 @@ class Tests(dbusmock.DBusTestCase):
         self.write_file_contents(boost, "1\n")
         return boost
 
+    def test_cpufreq_boost_governor(self):
+        """The boost method switches the governor per profile too"""
+        boost = self.create_cpufreq_boost("apple-cpufreq", "apple-cpufreq")
+        govs = []
+        for index in range(2):
+            policy = os.path.join(os.path.dirname(boost), f"policy{index}")
+            self.write_file_contents(
+                os.path.join(policy, "scaling_available_governors"),
+                "performance schedutil\n",
+            )
+            govs.append(os.path.join(policy, "scaling_governor"))
+            self.write_file_contents(govs[-1], "schedutil\n")
+
+        self.start_daemon()
+        self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("performance"))
+        for gov in govs:
+            self.assert_file_eventually_contains(gov, "performance")
+        self.assert_file_eventually_contains(boost, "1")
+
+        self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("power-saver"))
+        for gov in govs:
+            self.assert_file_eventually_contains(gov, "schedutil")
+        self.assert_file_eventually_contains(boost, "0")
+
+        self.set_dbus_property("ActiveProfile", GLib.Variant.new_string("performance"))
+        self.assert_file_eventually_contains(govs[0], "performance")
+        self.stop_daemon()
+        for gov in govs:
+            self.assertEqual(self.read_file_contents(gov), b"schedutil")
+
     def test_cpufreq_boost(self):
         """Generic cpufreq driver switches the global boost per profile"""
 
@@ -1679,7 +1709,14 @@ class Tests(dbusmock.DBusTestCase):
     )
 
     def create_cpufreq_policy(
-        self, name, driver, freqs, epp=False, boost_freqs=None, cpuinfo_max=None
+        self,
+        name,
+        driver,
+        freqs,
+        epp=False,
+        boost_freqs=None,
+        cpuinfo_max=None,
+        governors=None,
     ):
         policy = os.path.join(
             self.testbed.get_root_dir(), "sys/devices/system/cpu/cpufreq", name
@@ -1702,8 +1739,18 @@ class Tests(dbusmock.DBusTestCase):
             self.write_file_contents(
                 os.path.join(policy, "energy_performance_preference"), "default\n"
             )
+        if governors:
+            self.write_file_contents(
+                os.path.join(policy, "scaling_available_governors"), governors + "\n"
+            )
+            self.write_file_contents(
+                os.path.join(policy, "scaling_governor"), "schedutil\n"
+            )
         return os.path.join(policy, "scaling_max_freq")
 
+    def cpufreq_governor_path(self, max_freq_path):
+        return os.path.join(os.path.dirname(max_freq_path), "scaling_governor")
+
     M3_MAX_P_FREQS = (
         "1092000 1356000 1596000 1884000 2172000 2424000 2616000 2808000 "
         "2988000 3144000 3288000 3420000 3516000 3576000 3624000 3708000 "
@@ -1764,6 +1811,23 @@ class Tests(dbusmock.DBusTestCase):
         self.assertEqual(self.read_file_contents(boost), b"0\n")
         self.assertFalse(self.have_text_in_log("Failed to activate"))
 
+    def test_cpufreq_apple_without_boost_governor(self):
+        """Apple Silicon on the caps method switches the governor too"""
+        max0, max1, _ = self.create_apple_without_boost()
+        gov0 = self.cpufreq_governor_path(max0)
+        self.write_file_contents(
+            os.path.join(os.path.dirname(max0), "scaling_available_governors"),
+            "performance schedutil\n",
+        )
+        self.write_file_contents(gov0, "schedutil\n")
