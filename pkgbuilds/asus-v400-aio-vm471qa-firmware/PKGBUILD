# Audio DSP, compute DSP, GPU and video firmware for the ASUS V400 AiO VM471QA. The firmware only
# runs if it is signed for this board by ASUS, so linux-firmware cannot carry it until the OEM
# submits it. The OEM ships it in its Windows driver download, which this recipe unpacks without
# running. Each file is checked against the SHA-256 it was matched to and installed under the name
# the device tree requests, compressed with xz. The kernel tries a plain name, then .zst, then
# .xz, so once linux-firmware ships the same file, its copy is the one loaded, and the two
# packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=asus-v400-aio-vm471qa-firmware
pkgver=20261114
pkgrel=1
pkgdesc='Audio DSP, compute DSP, GPU and video firmware for the ASUS V400 AiO VM471QA'
arch=('aarch64')
url='https://dlcdnets.asus.com/pub/ASUS/All-In-One/Image/Driver/DriverPackage/52327/SOCPackage_forWebSite_CC_Qualcomm_F_V1.301.8600.0_52327.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x126100-asustek-vm471qa')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'asus-socpackage-52327.exe::https://dlcdnets.asus.com/pub/ASUS/All-In-One/Image/Driver/DriverPackage/52327/SOCPackage_forWebSite_CC_Qualcomm_F_V1.301.8600.0_52327.exe'
)
source+=('README.package.md')
noextract=('asus-socpackage-52327.exe')
sha256sums=('eccefbecd75a2bf8d938cb8589f761192b143972baeeb46367bddd8018179fa3')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'asus-socpackage-52327.exe' 'asus-socpackage-52327' 7z-appended
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'asus-socpackage-52327/QualcommBSP/qcsubsys_ext_adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x126100/ASUSTeK/VM471QA/adsp_dtbs.elf'
  install -Dm644 'asus-socpackage-52327/QualcommBSP/qcsubsys_ext_adsp8380/adspr.jsn' "$fw"/'qcom/x126100/ASUSTeK/VM471QA/adspr.jsn'
  install -Dm644 'asus-socpackage-52327/QualcommBSP/qcsubsys_ext_adsp8380/adsps.jsn' "$fw"/'qcom/x126100/ASUSTeK/VM471QA/adsps.jsn'
  install -Dm644 'asus-socpackage-52327/QualcommBSP/qcsubsys_ext_adsp8380/adspua.jsn' "$fw"/'qcom/x126100/ASUSTeK/VM471QA/adspua.jsn'
  install -Dm644 'asus-socpackage-52327/QualcommBSP/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x126100/ASUSTeK/VM471QA/cdsp_dtbs.elf'
  install -Dm644 'asus-socpackage-52327/QualcommBSP/qcnspmcdm_ext_cdsp8380/cdspr.jsn' "$fw"/'qcom/x126100/ASUSTeK/VM471QA/cdspr.jsn'
  install -Dm644 'asus-socpackage-52327/QualcommBSP/qcsubsys_ext_adsp8380/qcadsp8380.mbn' "$fw"/'qcom/x126100/ASUSTeK/VM471QA/qcadsp8380.mbn'
  install -Dm644 'asus-socpackage-52327/QualcommBSP/qcnspmcdm_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x126100/ASUSTeK/VM471QA/qccdsp8380.mbn'
  install -Dm644 'asus-socpackage-52327/QualcommBSP/qcdx8380/qcdxkmsucpurwa.mbn' "$fw"/'qcom/x126100/ASUSTeK/VM471QA/qcdxkmsucpurwa.mbn'
  install -Dm644 'asus-socpackage-52327/QualcommBSP/qcdx8380/qcvss8380_pa.mbn' "$fw"/'qcom/x126100/ASUSTeK/VM471QA/qcvss8380_pa.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
8d88e7b2c524bad1eca5a5b9356b48e02d02d4934badeef387846d0d0fb0eb5a  qcom/x126100/ASUSTeK/VM471QA/adsp_dtbs.elf
4b9566fcfdc1656c38d8158d79db6964e9c4b57a6e42b46241e8d63aabc42d8d  qcom/x126100/ASUSTeK/VM471QA/adspr.jsn
19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e  qcom/x126100/ASUSTeK/VM471QA/adsps.jsn
d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d  qcom/x126100/ASUSTeK/VM471QA/adspua.jsn
9ea41f43725e0210de43714ea232e60f7610eb118f79df4f7877db88a8eda87d  qcom/x126100/ASUSTeK/VM471QA/cdsp_dtbs.elf
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x126100/ASUSTeK/VM471QA/cdspr.jsn
b2ef4fc7a033bd8f6f2c9f06a66d8d693e8b5bc31cc4144ca22b4279b8d8c02b  qcom/x126100/ASUSTeK/VM471QA/qcadsp8380.mbn
efcffa4cb458ee1f2b3ac7f81b14873662e7898426ff801695bfb6d6719cabbe  qcom/x126100/ASUSTeK/VM471QA/qccdsp8380.mbn
376de9d57d2b9249a92871a17d78200d8d5c750b3ceca49aa0f6799facf7c844  qcom/x126100/ASUSTeK/VM471QA/qcdxkmsucpurwa.mbn
5c4b6370b851c47f4884e6c6530b2ac4b83321770274a6e0e0642542fd3d2396  qcom/x126100/ASUSTeK/VM471QA/qcvss8380_pa.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
