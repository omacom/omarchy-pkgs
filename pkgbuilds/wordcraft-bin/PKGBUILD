pkgname=wordcraft-bin
_name=wordcraft
pkgver=0.14.0
pkgrel=1
pkgdesc="Clean-room word processor in pure Rust that opens and saves Word documents"
arch=('x86_64' 'aarch64')
url="https://github.com/storytold/wordcraft"
license=('Apache-2.0 OR MIT' 'OFL-1.1')
depends=('glibc' 'libgcc' 'dbus' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'vulkan-icd-loader' 'hicolor-icon-theme')
provides=("$_name")
conflicts=("$_name")
options=('!debug' '!strip')
source_x86_64=("$url/releases/download/v$pkgver/$_name-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/$_name-$pkgver-linux-aarch64.tar.gz")
sha256sums_x86_64=('3010da3d352d95256ec9a17a03966280a1d41ba09d0ebe569af23092d8b64987')
sha256sums_aarch64=('a02e3ef3eab365aca36c5a6a0b8b00a9252562c90ab7da884b83ef701dfae8f0')

package() {
  cd "$_name-$pkgver-linux-$CARCH"
  install -Dm755 bin/$_name bin/$_name-cli -t "$pkgdir/usr/bin"
  cp -r --no-preserve=ownership share "$pkgdir/usr/"
  install -dm755 "$pkgdir/usr/share/licenses/$pkgname"
  ln -s /usr/share/doc/$_name/{LICENSE-MIT,LICENSE-APACHE,NOTICE} "$pkgdir/usr/share/licenses/$pkgname/"
}
