# Maintainer: Antimeme AI LLC <ops@antimeme.ai>
pkgname=mp-outpost-bin
pkgver=0.4.0
pkgrel=1
pkgdesc="Standalone E2EE sidecar CLI, daemon, and MCP server for multiplayer.tech"
arch=('x86_64' 'aarch64')
url="https://github.com/antimemeai/multiplayer_outpost"
license=('MIT')
depends=('glibc' 'gcc-libs')
provides=('mp-outpost')
conflicts=('mp-outpost')
options=('!strip' '!debug')
_dl="https://github.com/antimemeai/multiplayer_outpost/releases/download/v${pkgver}"
source=('LICENSE')
source_x86_64=("${pkgname}-${pkgver}-x86_64.tar.gz::${_dl}/mp-outpost-v${pkgver}-linux-x86_64.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64.tar.gz::${_dl}/mp-outpost-v${pkgver}-linux-arm64.tar.gz")
noextract=(
  "${pkgname}-${pkgver}-x86_64.tar.gz"
  "${pkgname}-${pkgver}-aarch64.tar.gz"
)
sha256sums=('3aec3c396fe34d3d564d698b1606a08c23f3f82e0d4a606968a8d11e6f6dd932')
sha256sums_x86_64=('f04dac5d3ee500a077815b38378288d1c878b218ac3c3a1d301d86eaf3707dab')
sha256sums_aarch64=('e016872244f8dc93f952861fc6446ba77bbb847e0a4d8e44d21d70bb95c96cb8')

package() {
  local target
  case "$CARCH" in
    x86_64)  target="linux-x86_64" ;;
    aarch64) target="linux-arm64" ;;
    *)
      printf 'Unsupported architecture: %s\n' "$CARCH" >&2
      return 1
      ;;
  esac

  local stage="${srcdir}/stage-${CARCH}"
  rm -rf "$stage"
  install -d "$stage"
  bsdtar --no-same-owner -xf "${srcdir}/${pkgname}-${pkgver}-${CARCH}.tar.gz" -C "$stage"

  local srcdir_pkg="${stage}/mp-outpost-v${pkgver}-${target}"
  install -Dm755 "${srcdir_pkg}/mp-outpost" "${pkgdir}/usr/bin/mp-outpost"
  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  if [[ -f "${srcdir_pkg}/README.md" ]]; then
    install -Dm644 "${srcdir_pkg}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  fi
}
