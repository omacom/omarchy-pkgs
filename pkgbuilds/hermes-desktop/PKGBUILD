# Maintainer: David Heinemeier Hansson <david@hey.com>

# Build a prebuilt release; Omarchy seeds it into the user's Hermes checkout
# so the upstream updater can rebuild and relaunch it in place.

pkgname=hermes-desktop
# Upstream dropped its date tags after v2026.9.24 for the semver it had always
# printed, and pacman sorts 2026.9.7 above any 0.x.
epoch=1
pkgver=0.23.1
pkgrel=1
pkgdesc='Native desktop shell for Hermes Agent'
arch=('x86_64' 'aarch64')
url='https://github.com/NousResearch/hermes-agent'
license=('MIT')

depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'curl'
  'gcc'
  'gdk-pixbuf2'
  'git'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libdrm'
  'libglvnd'
  'libnotify'
  'libsecret'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'make'
  'mesa'
  'nodejs'
  'npm'
  'nspr'
  'nss'
  'pango'
  'python'
  'systemd-libs'
  'util-linux'
  'xdg-utils'
)

optdepends=('omarchy: sets up the user installation for in-app updates')

# The build runs the repo's own pnpm workspace install, which fetches Electron
# and rebuilds node-pty against it.
makedepends=('imagemagick')

# Electron bundles prebuilt binaries that stripping corrupts.
options=('!strip' '!debug')

# The tag's commit. apps/desktop/scripts/write-build-stamp.mjs pins the app's
# first-launch bootstrap to a Hermes commit, and resolves it from $GITHUB_SHA
# before falling back to `git rev-parse`. That fallback is wrong here: makepkg
# builds inside this repository, so git ascends out of srcdir and stamps the
# app with an omarchy-pkgs commit that means nothing upstream.
_commit=3b421578588243f920886e6fe79a6faa87ea026e

# Upstream's preinstall refuses npm, and any pnpm but the one its pm/lock.json
# pins, so the build brings that release instead of Arch's. pnpm 12 is a native
# executable. The pnpm package of the same version is the launcher that would
# download it, kept for the node-gyp in its dist/, which the executable looks
# for beside itself. Both carry the checksums upstream's lock records.
_pnpm=12.15.0

_srcdir="hermes-agent-${pkgver}"
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        'hermes-desktop.sh'
        'hermes-desktop.desktop'
        'hermes-desktop.png'
        'runtime.patch'
        'runtime-test.py'
        "pnpm-${_pnpm}.tgz::https://registry.npmjs.org/pnpm/-/pnpm-${_pnpm}.tgz")
source_x86_64=("pnpm-exe-x86_64-${_pnpm}.tgz::https://registry.npmjs.org/@pnpm/exe.linux-x64/-/exe.linux-x64-${_pnpm}.tgz")
source_aarch64=("pnpm-exe-aarch64-${_pnpm}.tgz::https://registry.npmjs.org/@pnpm/exe.linux-arm64/-/exe.linux-arm64-${_pnpm}.tgz")
noextract=("pnpm-${_pnpm}.tgz"
           "pnpm-exe-x86_64-${_pnpm}.tgz"
           "pnpm-exe-aarch64-${_pnpm}.tgz")
sha256sums=('52a8eb321f368576034f40595491abf9646b60c3861eee0cf45f610e5faa9bb6'
            '4578df4ea100d14ac64b67d28f64f237e3a73f315d9d3badc30d2367294f400b'
            '47e35c7c8725768034ba2fd1c2cd062817173d1354f0c1103d2eef95a73b450b'
            'd60d164e24fdcf6532133b8ea43c77a201e4b9e9dbc396187b58d51d8590ef52'
            '9d5015d1be762a901f8f64319981ae862e9852fa5cb9a22a2ba1e691f90430a2'
            '57eb4929a8ebf99f0589e24a6b6ebde76d496c03e877a8e19dac2b173bf7e564'
            'f5173f6127cc505cdb36ec17719fe54a8511c6fd8560c7ceb4bf7c73e3b4458b')
sha256sums_x86_64=('402f7045b1e0587acb1542f18d38afbccb6babf3c7451394e6fb3d9f0160c6ca')
sha256sums_aarch64=('8117d65f28e627e949d5fc65d63342266326826a56fa374317bf13fe1166a50e')

prepare() {
  mkdir -p "${srcdir}/pnpm"
  bsdtar -xf "${srcdir}/pnpm-exe-${CARCH}-${_pnpm}.tgz" -C "${srcdir}/pnpm" --strip-components=1 package/pnpm
  bsdtar -xf "${srcdir}/pnpm-${_pnpm}.tgz" -C "${srcdir}/pnpm" --strip-components=1 package/dist
}

build() {
  cd "${srcdir}/${_srcdir}"

  export PATH="${srcdir}/pnpm:${PATH}"

  export GITHUB_SHA="${_commit}"
  export GITHUB_REF_NAME="main"

  # The desktop workspace resolves against the repo root, so the install has to
  # happen there rather than in apps/desktop.
  pnpm install --frozen-lockfile

  # pnpm runs no dependency's install script, so Electron's binary comes from
  # the step upstream's own builds run for it.
  node scripts/build/electron-runtime.mjs --source "${PWD}"

  cd apps/desktop
  pnpm run pack
}

check() {
  python "${srcdir}/runtime-test.py" "${srcdir}/${_srcdir}" "${srcdir}/runtime.patch" "${srcdir}/hermes-desktop.sh"
}

package() {
  # electron-builder omits the arch suffix for its default target (x86_64:
  # linux-unpacked) but includes it for every other one, so the release
  # directory does not carry the same name on both architectures.
  local _unpacked
  case "${CARCH}" in
    x86_64)  _unpacked="linux-unpacked" ;;
    aarch64) _unpacked="linux-arm64-unpacked" ;;
    *)       error "Unsupported architecture: ${CARCH}"; exit 1 ;;
  esac

  cd "${srcdir}/${_srcdir}/apps/desktop/release/${_unpacked}"

  install -dm755 "${pkgdir}/opt/${pkgname}"
  cp -a . "${pkgdir}/opt/${pkgname}/"

  install -Dm755 "${srcdir}/hermes-desktop.sh" "${pkgdir}/usr/bin/${pkgname}"

  install -Dm644 "${srcdir}/${_srcdir}/scripts/install.sh" \
    "${pkgdir}/usr/share/${pkgname}/install.sh"
  # Omarchy's installer still requires this patch. The release includes the
  # fix, so the installer recognizes it through its reverse-apply check.
  install -Dm644 "${srcdir}/runtime.patch" "${pkgdir}/usr/share/${pkgname}/runtime.patch"

  install -Dm644 "${srcdir}/hermes-desktop.desktop" \
    "${pkgdir}/usr/share/applications/${pkgname}.desktop"

  install -Dm644 "${srcdir}/hermes-desktop.png" \
    "${pkgdir}/usr/share/icons/hicolor/1024x1024/apps/${pkgname}.png"
  local size
  for size in 512 256 128 64 48; do
    magick "${srcdir}/hermes-desktop.png" -resize "${size}x${size}" "${srcdir}/icon-${size}.png"
    install -Dm644 "${srcdir}/icon-${size}.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/${pkgname}.png"
  done

  install -Dm644 "${srcdir}/${_srcdir}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${pkgdir}/opt/${pkgname}/LICENSE.electron.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.electron.txt"

  # The launcher requires the namespace sandbox on the target host.
  chmod 0755 "${pkgdir}/opt/${pkgname}/chrome-sandbox"
}
