# Maintainer: Vitor Bellini <bellinivitor@gmail.com>

pkgname=depot
pkgver=0.4.1
pkgrel=1
pkgdesc='Create local databases in Docker and share them on your tailnet'
arch=('x86_64' 'aarch64')
url='https://github.com/bellinivitor/depot'
license=('MIT')
install='depot.install'
options=('!debug')
depends=(
  'docker'
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
)
optdepends=(
  'tailscale: share databases with your other devices'
)
makedepends=(
  'gcc'
  'make'
  'qt6-base'
  'qt6-declarative'
)
checkdepends=('python')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('7ff0a87d45b002fbc993e04e4a5ea6c0074b36ec9d8e60f83e8b7a0d6883b6ab')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/test
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/depot "$pkgdir/usr/bin/depot"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/depot.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/depot.svg"
  install -Dm644 pkgbuild/depot.desktop "$pkgdir/usr/share/applications/depot.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
