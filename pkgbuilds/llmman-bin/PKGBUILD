# Maintainer: Eric Curtin <ericcurtin17@gmail.com>

# Upstream publishes one bare, unpackaged binary per target triple and a
# sha256sum-format checksums.txt beside them; the declarative GitHub provider
# in .omarchy/package.json rewrites pkgver and the checksums below from that
# manifest. The download names carry pkgver so makepkg never serves a cached
# binary from a previous release under the same asset name.

pkgname=llmman-bin
pkgver=0.1.398
pkgrel=1
pkgdesc="Run any agent on any model: local llama.cpp/vLLM/SGLang inference behind one Ollama-, OpenAI- and Anthropic-compatible endpoint, with models as OCI artifacts"
arch=('x86_64' 'aarch64')
url="https://github.com/llmmanorg/llmman"
license=('Apache-2.0')
depends=('gcc-libs' 'glibc')
# llmman fetches the pinned llama.cpp release itself, as a container where an
# engine is running (which is the only way to a CUDA build on Linux) and as a
# prebuilt binary otherwise; neither is required to start.
optdepends=(
  'docker: run llama.cpp and vLLM in containers, with CUDA on NVIDIA GPUs'
  'podman: run llama.cpp and vLLM in containers, with CUDA on NVIDIA GPUs'
)
provides=('llmman')
conflicts=('llmman')
options=('!debug')

_release="$url/releases/download/v$pkgver"
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/llmmanorg/llmman/v$pkgver/LICENSE")
source_x86_64=("llmman-$pkgver-x86_64::$_release/llmman-x86_64-unknown-linux-gnu")
source_aarch64=("llmman-$pkgver-aarch64::$_release/llmman-aarch64-unknown-linux-gnu")
sha256sums=('c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4')
sha256sums_x86_64=('caa124b94cde1fe9991f1b1001c03a661eb1a041cae0afc2ba17cf17e7acee73')
sha256sums_aarch64=('807f8865cc69cd4926492f7598e2a340de0f411f55ddd0f1799699f596741c66')

package() {
  install -Dm755 "$srcdir/llmman-$pkgver-$CARCH" "$pkgdir/usr/bin/llmman"
  install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
