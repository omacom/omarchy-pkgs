# Maintainer: ingermanr <https://github.com/ingermanr>

pkgname=protas
pkgver=0.2.0
pkgrel=1
pkgdesc='Daily notes and tasks in the terminal: one workspace per day, pending work rolls forward'
arch=('any')
url='https://github.com/ingermanr/protas'
license=('MIT')
depends=('python')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=('omarchy: the optional bar panel, installed with protas omarchy install')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('7ed132d3a548c3232fe3ad0053cb33c517ee33d157ecf67068360a81664747b3')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  # The tests write only to their own temporary folders.
  python -m unittest discover -s tests
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/protas.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 assets/logo.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/protas.svg"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
