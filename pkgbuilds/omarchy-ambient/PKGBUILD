pkgname=omarchy-ambient
pkgver=0.5.1
pkgrel=1
pkgdesc="Live backgrounds and screensavers for Omarchy: programs drawing behind the windows or over everything"
arch=('x86_64' 'aarch64')
url="https://github.com/avillagran/omarchy-ambient"
license=('MIT')
depends=('glibc' 'gcc-libs' 'bash' 'jq' 'socat' 'inotify-tools' 'hyprland' 'wayland' 'libnotify' 'util-linux' 'python'
         'qt6-base' 'qt6-declarative' 'omarchy-ttfx-layer>=0.3.1')
makedepends=('wayland-protocols' 'pkgconf' 'qt6-shadertools')
optdepends=(
  'fs-uae: the Amiga Demos source'
  'curl: downloading the Amiga demos'
  'libarchive: unpacking the Amiga demos'
  'libpulse: scenes that react to what is playing'
  'kitty: the Terminal Effects source'
  'ghostty: the Terminal Effects source'
)
options=('!debug')

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('d9286024af0b9ee19ac1d22231dd2aa99667ba83894c80112b013b68988f4422')

build() {
  cd "$pkgname-$pkgver"

  make VERSION="$pkgver"
}

package() {
  cd "$pkgname-$pkgver"

  make VERSION="$pkgver" DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
