# Maintainer: Alexendros <operaciones@alexendros.dev>

# Backlight for the AERO X16 keyboard (USB HID LampArray). The CLI writes to
# the hidraw node directly and holds one flock so two writers never race; the
# GTK window only ever talks to that CLI, never to /dev/hidraw itself.
#
# The udev rule grants the session user access to the device, but the lock
# directory is what decides who may write: it belongs to group `ilutex`, and
# installing the package does not add anyone to it. That has to be explicit
# (`usermod -aG ilutex`), so a shared machine does not hand the keyboard to
# every account that installs the package.

pkgname=ilutex
pkgver=3.0.0
pkgrel=1
pkgdesc='Keyboard backlight for the AERO X16, from the terminal or a GTK window'
arch=('x86_64' 'aarch64')
url="https://github.com/Soluciones-Alexendros/keybackcon"
license=('MIT')
depends=('glibc')
makedepends=('cargo' 'gettext')
optdepends=('python-gobject: GTK window and tray indicator'
            'gtk4: GTK window'
            'libadwaita: GTK window (needs >= 1.5)'
            'libayatana-appindicator: tray indicator'
            'python-cairo: tray indicator')
conflicts=('keybackcon' 'kbd-rgb')
replaces=('keybackcon' 'kbd-rgb')
backup=()
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
# The tag's source archive. `updpkgsums` recomputes it after a version bump.
sha256sums=('765c61479b99febecb92217c4ded414191e8747a10d93853204705370166b1ee')

# The GitHub archive names its root after the repository, which is not the
# package name, so find the extracted tree instead of assuming it.
_src_root() {
  local dir
  for dir in "$srcdir"/*/; do
    if [ -d "$dir" ]; then
      cd "$dir" && return 0
    fi
  done
  return 1
}

build() {
  _src_root
  cargo build --release --locked

  for po in po/*.po; do
    _lang="${po##*/}"
    _lang="${_lang%.po}"
    mkdir -p "gui/locale/${_lang}/LC_MESSAGES"
    msgfmt -o "gui/locale/${_lang}/LC_MESSAGES/ilutex.mo" "$po"
  done
}

package() {
  _src_root

  install -Dm755 target/release/ilutex "$pkgdir/usr/bin/ilutex"
  install -Dm755 packaging/ilutex-gui "$pkgdir/usr/bin/ilutex-gui"

  install -d "$pkgdir/usr/share/ilutex/gui"
  install -m644 gui/*.py "$pkgdir/usr/share/ilutex/gui/"

  # The window looks its catalogs up in /usr/share/locale; build() compiles them.
  for mo in gui/locale/*/LC_MESSAGES/ilutex.mo; do
    _lang="${mo#gui/locale/}"
    _lang="${_lang%%/*}"
    install -Dm644 "$mo" "$pkgdir/usr/share/locale/${_lang}/LC_MESSAGES/ilutex.mo"
  done

  install -Dm644 packaging/desktop/ilutex.desktop \
    "$pkgdir/usr/share/applications/ilutex.desktop"
  install -Dm644 assets/icons/ilutex.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/ilutex.svg"

  install -Dm644 gui/org.alexendros.ilutex.gschema.xml \
    "$pkgdir/usr/share/glib-2.0/schemas/org.alexendros.ilutex.gschema.xml"

  install -Dm644 packaging/udev/70-ilutex.rules \
    "$pkgdir/usr/lib/udev/rules.d/70-ilutex.rules"

  # The lock directory and its file come from tmpfiles, owned by the group
  # that sysusers creates. The binary refuses to write anywhere else.
  install -Dm644 packaging/sysusers.d/ilutex.conf \
    "$pkgdir/usr/lib/sysusers.d/ilutex.conf"
  install -Dm644 packaging/tmpfiles.d/ilutex.conf \
    "$pkgdir/usr/lib/tmpfiles.d/ilutex.conf"

  install -Dm644 packaging/systemd/ilutex.service \
    "$pkgdir/usr/lib/systemd/user/ilutex.service"
  install -Dm644 packaging/systemd/ilutex-animation@.service \
    "$pkgdir/usr/lib/systemd/user/ilutex-animation@.service"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
