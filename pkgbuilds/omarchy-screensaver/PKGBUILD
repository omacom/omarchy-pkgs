pkgname=omarchy-screensaver
pkgver=1.3.0
pkgrel=1
pkgdesc="Native Wayland screensaver for Omarchy"
arch=('x86_64' 'aarch64')
url="https://github.com/omacom/omarchy-screensaver"
license=('MIT')
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'fontconfig')
makedepends=('cargo' 'pkgconf')
options=('!debug')

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('81b8b47cb6af23fa74d812e3fd99ca08b9cb072c38b3ff87ffbd1046b36a905e')

prepare() {
  cd "$pkgname-$pkgver"

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"

  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$pkgname-$pkgver"

  # omarchy-launch-screensaver in Omarchy hands off to this path.
  install -Dm755 "target/release/omarchy-launch-screensaver" "$pkgdir/usr/lib/$pkgname/omarchy-screensaver"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
