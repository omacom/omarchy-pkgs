diff --git a/backend/drm/drm.c b/backend/drm/drm.c
index 827c9a23..78e25875 100644
--- a/backend/drm/drm.c
+++ b/backend/drm/drm.c
@@ -861,6 +861,60 @@ static bool drm_connector_set_pending_layer_fbs(struct wlr_drm_connector *conn,
 
 static bool drm_connector_alloc_crtc(struct wlr_drm_connector *conn);
 
+// No GPU scans out of CPU memory, so buffers there, like those of a software
+// renderer, are copied into ones of the GPU's own, as on a secondary GPU. The
+// renderer for that is created when the compositor asks for formats to render
+// to in CPU memory, which only a software renderer does: a compositor that
+// renders on the GPU never has its buffers copied, nor a client's buffer in
+// shared memory accepted for direct scan-out. Once the renderer exists, the
+// GPU copies every buffer.
+static const struct wlr_drm_format_set *drm_get_copy_formats(struct wlr_drm_backend *drm) {
+	if (!drm->mgpu_renderer.wlr_rend) {
+		if (!init_drm_renderer(drm, &drm->mgpu_renderer, WLR_BUFFER_CAP_DATA_PTR)) {
+			wlr_log(WLR_ERROR, "Failed to create a renderer to copy buffers in CPU memory");
+			return NULL;
+		}
+		drm->backend.features.timeline = drm->backend.features.timeline &&
+			drm->mgpu_renderer.wlr_rend->features.timeline;
+	}
+	drm->copies_cpu_buffers = true;
+	return wlr_renderer_get_texture_formats(drm->mgpu_renderer.wlr_rend,
+		WLR_BUFFER_CAP_DATA_PTR);
+}
+
+static bool drm_connector_check_buffer(struct wlr_drm_connector *conn,
+		struct wlr_buffer *buffer) {
+	struct wlr_drm_backend *drm = conn->backend;
+
+	struct wlr_dmabuf_attributes dmabuf;
+	if (wlr_buffer_get_dmabuf(buffer, &dmabuf)) {
+		if (drm->mgpu_renderer.wlr_rend &&
+				!wlr_drm_format_set_has(&drm->mgpu_formats, dmabuf.format, dmabuf.modifier)) {
+			wlr_drm_conn_log(conn, WLR_DEBUG,
+				"Buffer format 0x%"PRIX32" with modifier 0x%"PRIX64" cannot be "
+				"imported into multi-GPU renderer",
+				dmabuf.format, dmabuf.modifier);
+			return false;
+		}
+		return true;
+	}
+
+	struct wlr_shm_attributes shm;
+	if (!drm->copies_cpu_buffers || !wlr_buffer_get_shm(buffer, &shm)) {
+		wlr_drm_conn_log(conn, WLR_DEBUG, "Buffer is not a DMA-BUF");
+		return false;
+	}
+	const struct wlr_drm_format_set *formats = wlr_renderer_get_texture_formats(
+		drm->mgpu_renderer.wlr_rend, WLR_BUFFER_CAP_DATA_PTR);
+	if (formats == NULL || wlr_drm_format_set_get(formats, shm.format) == NULL) {
+		wlr_drm_conn_log(conn, WLR_DEBUG,
+			"Buffer format 0x%"PRIX32" cannot be copied by multi-GPU renderer",
+			shm.format);
+		return false;
+	}
+	return true;
+}
+
 static bool drm_connector_prepare(struct wlr_drm_connector_state *conn_state, bool test_only) {
