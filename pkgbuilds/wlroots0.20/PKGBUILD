# Maintainer: The Omarchy Authors
# Contributor: Robin Candau <antiz@archlinux.org>
#
# Arch's wlroots0.20 0.20.2-1 plus patches, for Omarchy's boot splash, whose
# sway draws with the pixman renderer on every GPU that has displays:
# - 0001: split allocator_autocreate_with_drm_fd() out of
#   wlr_allocator_autocreate(), with no functional change;
# - 0002: a GPU copying another's buffers copies only the damage;
# - 0003: such a GPU runs test commits for real, so a compositor can still
#   fall back from a configuration the kernel rejects;
# - 0004: buffers in CPU memory are shown by copying them into each GPU's
#   own buffers, the first GPU's included;
# - 0005: GPU buffers are copied whole, and a GPU-rendered compositor's
#   secondary GPU skips test commits, as in Arch's build.
# This build replaces Arch's for every wlroots 0.20 compositor: software
# rendering changes as above, and GPU rendering stays as in Arch's build.
# Releases are held (sync: false): rebase the series with --fuzz=0 and try
# the splash on one GPU and on two before one ships.

pkgname=wlroots0.20
_pkgname=wlroots
pkgver=0.20.2
pkgrel=1.2
pkgdesc="Modular Wayland compositor library"
url="https://gitlab.freedesktop.org/wlroots/wlroots"
license=('MIT')
arch=('x86_64' 'aarch64')
depends=('glibc' 'libdisplay-info.so' 'libdrm' 'libglvnd' 'libinput' 'liblcms2.so' 'libliftoff.so' 'libpixman-1.so'
         'libseat.so' 'libudev.so' 'libvulkan.so' 'libwayland-client.so' 'libwayland-server.so' 'libxcb' 'libxkbcommon.so'
         'wayland-protocols' 'opengl-driver' 'xcb-util-errors' 'xcb-util-renderutil' 'xcb-util-wm')
makedepends=('git' 'glslang' 'meson' 'ninja' 'systemd' 'vulkan-headers' 'xorg-xwayland')
optdepends=('xorg-xwayland: Xwayland support'
            'vulkan-validation-layers: validation layers for the experimental vulkan renderer backend')
provides=("libwlroots-${pkgver%.*}.so")
source=("${pkgname}::git+${url}.git#tag=${pkgver}?signed"
        0001-render-allocator-add-allocator_autocreate_with_drm_fd.patch
        0002-backend-drm-copy-only-damage-in-multi-GPU-blits.patch
        0003-backend-drm-run-multi-GPU-test-commits-for-real.patch
        0004-backend-drm-show-buffers-in-CPU-memory-by-copying-them.patch
        0005-omarchy-keep-GPU-rendered-multi-GPU-copies-as-upstream.patch)
sha256sums=('6c8595da579a8df74bc307294c2485e90f5379b84390381f500da33ff3f276d2'
            'c02978e0ecd5e92482ee2aa4750b3acfa53ba29c5f8171c5bf72707b42ccb3f3'
            '3fce936f159ff0b039f3d8b55f09d5aeba44bc8446219a83ef78402101e582d2'
            '32ef9028407292bd2fb726bb64b3beedd76686516bf760424c27f55a1a159b42'
            'f40c47bcf389576823530dacccb02e1f946d5cc34bec898d2b9314eb3117cba6'
            '8e0ed18d0406d4137b48b7c6f92a5fee3754c18647195cc13f0143045f731cdb')
validpgpkeys=('34FF9526CFEF0E97A340E2E40FDE7BE0E88F5E48') # Simon Ser

prepare() {
	cd "${pkgname}"
	local src
	for src in "${source[@]}"; do
		[[ $src == *.patch ]] || continue
		patch -Np1 --fuzz=0 -i "../${src}"
	done
}

build() {
	arch-meson "${pkgname}" build
	ninja -C build
}

package() {
	DESTDIR="${pkgdir}" ninja -C build install
	install -Dm 644 "${pkgname}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
