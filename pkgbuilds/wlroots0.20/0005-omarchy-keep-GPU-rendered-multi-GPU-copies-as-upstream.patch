Omarchy: keep GPU-rendered multi-GPU copies as wlroots 0.20 makes them

Not for upstream. Omarchy's wlroots0.20 replaces Arch's for every
compositor, and the damage-limited copies and real test commits of the
patches before this one are untested on multi-GPU hardware here. Keep them
to what the boot splash needs:
- A buffer in CPU memory is copied damage-limited; a GPU buffer is copied
  whole, as before.
- A GPU that copies buffers in CPU memory runs every test commit for real. A
  test gives KMS a buffer of the GPU's own without copying into it, so it
  tests the same thing whatever kind of buffer is under test. A secondary GPU
  of a GPU-rendered compositor skips test commits, as before.

diff --git a/backend/drm/drm.c b/backend/drm/drm.c
index 78e25875..ff23e90e 100644
--- a/backend/drm/drm.c
+++ b/backend/drm/drm.c
@@ -731,6 +731,15 @@ static void drm_connector_state_finish(struct wlr_drm_connector_state *state) {
 	wlr_drm_syncobj_timeline_unref(state->wait_timeline);
 }
 
+// Omarchy: real test commits are untried on multi-GPU hardware here, so a GPU
+// that copies a GPU-rendered compositor's buffers skips them, as wlroots 0.20
+// does. A GPU that copies buffers in CPU memory tests every buffer for real: a
+// test gives KMS a buffer of the GPU's own without copying into it, so what it
+// tests doesn't depend on the kind of buffer under test.
+static bool drm_skips_tests(const struct wlr_drm_backend *drm) {
+	return drm->mgpu_renderer.wlr_rend != NULL && !drm->copies_cpu_buffers;
+}
+
 // The frame's damage is in buffer coordinates when the buffer covers the
 // output pixel for pixel
 static const pixman_region32_t *get_buffer_damage(const struct wlr_output_state *state) {
@@ -791,8 +800,13 @@ static bool drm_connector_state_update_primary_fb(struct wlr_drm_connector *conn
 			// not the copy in it
 			local_buf = wlr_swapchain_acquire(plane->mgpu_surf.swapchain);
 		} else {
-			local_buf = drm_surface_blit(&plane->mgpu_surf, source_buf,
-				get_buffer_damage(state->base), wait_timeline, wait_point);
+			// Omarchy: a GPU buffer is copied whole, as in wlroots 0.20, until
+			// damage-limited copies are tried on multi-GPU hardware
+			struct wlr_dmabuf_attributes dmabuf;
+			const pixman_region32_t *damage = wlr_buffer_get_dmabuf(source_buf, &dmabuf) ?
+				NULL : get_buffer_damage(state->base);
+			local_buf = drm_surface_blit(&plane->mgpu_surf, source_buf, damage,
+				wait_timeline, wait_point);
 		}
 		if (local_buf == NULL) {
 			return false;
@@ -961,6 +975,10 @@ static bool drm_connector_prepare(struct wlr_drm_connector_state *conn_state, bo
 		return false;
 	}
 
+	if (test_only && drm_skips_tests(conn->backend)) {
+		return true;
+	}
+
 	if (state->committed & WLR_OUTPUT_STATE_BUFFER) {
 		if (!drm_connector_state_update_primary_fb(conn, conn_state, test_only)) {
 			return false;
@@ -1025,6 +1043,11 @@ static bool drm_connector_commit_state(struct wlr_drm_connector *conn,
 		goto out;
 	}
 
+	if (test_only && drm_skips_tests(conn->backend)) {
+		ok = true;
+		goto out;
+	}
+
 	if (!pending.active && conn->crtc == NULL) {
 		// Disabling an already-disabled connector
 		ok = true;
@@ -2034,6 +2057,11 @@ bool commit_drm_device(struct wlr_drm_backend *drm,
 		modeset |= output_state->base.allow_reconfiguration;
 	}
 
+	if (test_only && drm_skips_tests(drm)) {
+		ok = true;
+		goto out;
+	}
+
 	uint32_t flags = 0;
 	if (!test_only) {
 		flags |= DRM_MODE_PAGE_FLIP_EVENT;
