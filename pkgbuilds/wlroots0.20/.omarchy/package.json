{
  "source": "local",
  "sync": false,
  "upstream": {
    "watch": {
      "git_tags": "https://gitlab.freedesktop.org/wlroots/wlroots.git",
      "pattern": "(?P<version>0\\.20\\.[0-9]+)"
    }
  },
  "rebuild_on": [
    "libdisplay-info",
    "libliftoff"
  ],
  "rebuilt_against": {
    "x86_64": {
      "libdisplay-info": "0.3.0-1",
      "libliftoff": "0.5.0-1"
    },
    "aarch64": {
      "libdisplay-info": "0.3.0-1",
      "libliftoff": "0.5.0-1"
    }
  }
}
