# Maintainer: Victor Hong <https://github.com/vichong>

pkgname=omawin365
pkgver=0.2.0
pkgrel=1
pkgdesc='Windows 365 Cloud PC launcher for Omarchy, with security keys inside the Cloud PC'
arch=('x86_64')
url='https://github.com/vichong/omawin365'
license=('MIT')
depends=('chromium' 'fontconfig' 'freerdp>=2:3.32.2' 'glib2' 'glibc' 'hicolor-icon-theme' 'libgcc'
         'libsecret' 'libstdc++' 'libx11' 'qt6-base' 'qt6-svg' 'qt6-wayland' 'xorg-xwayland')
optdepends=('omawin365-freerdp: reliable security keys inside the Cloud PC while the distro freerdp is older than 3.33.1')
checkdepends=('desktop-file-utils')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('602ea595d107fd0cad7e50f3d087c70c729392ac56474485751bd20e0ef08417')

build() {
  cd "$pkgname-$pkgver"
  # Pass the version: qmake would otherwise ask git, which here is the recipe repository.
  mkdir -p .build
  cd .build
  qmake6 ../omawin365.pro CONFIG+=release "OMAWIN365_VERSION=$pkgver" \
    "QMAKE_CFLAGS_RELEASE=$CFLAGS" "QMAKE_CXXFLAGS_RELEASE=$CXXFLAGS" \
    "QMAKE_LFLAGS_RELEASE=$LDFLAGS"
  make
}

check() {
  cd "$pkgname-$pkgver"
  desktop-file-validate assets/omawin365.desktop
  [[ $(env -u QT_QPA_PLATFORMTHEME QT_QPA_PLATFORM=offscreen .build/omawin365 --version) == "omawin365 $pkgver" ]]
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 .build/omawin365 "$pkgdir/usr/lib/omawin365/omawin365"
  install -Dm755 packaging/app/omawin365-launcher "$pkgdir/usr/bin/omawin365"
  install -Dm644 assets/omawin365.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 assets/omawin365.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 LICENSE THIRD_PARTY_NOTICES.md licenses/omarchy-MIT.txt -t "$pkgdir/usr/share/licenses/$pkgname"
}
