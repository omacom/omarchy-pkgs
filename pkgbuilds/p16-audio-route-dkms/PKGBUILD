license=('GPL-2.0-only')
depends=('dkms')
source=('mt8901-acp-sdw-legacy-mach.c' 'Makefile' 'dkms.conf')
sha256sums=('c2f40519feadc69d6626953a04f57a4bc5345723c556d6b6eebf5134fff7c9ec'
            '5fb2bb7d15adf4fc4a766c3ef32c7ec4048237a07bf74ae686e10076ae9f77af'
            '30c6fef3bfaa06fe8e800b00379ff8b60be8c095524ab0e1fca8efa7f4497992')

package() {
    local module_src="${pkgdir}/usr/src/p16-audio-route-${pkgver}"
    install -d "${module_src}"
    install -Dm644 "${srcdir}/mt8901-acp-sdw-legacy-mach.c" "${module_src}/mt8901-acp-sdw-legacy-mach.c"
    install -Dm644 "${srcdir}/Makefile" "${module_src}/Makefile"
    install -Dm644 "${srcdir}/dkms.conf" "${module_src}/dkms.conf"
