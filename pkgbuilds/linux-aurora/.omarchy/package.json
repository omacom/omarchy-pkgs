{
  "source": "local",
  "skip_build": true,
  "channels": ["edge"],
  "auto_merge": true,
  "min_release_age": "30m",
  "upstream": {
    "watch": {
      "git_branch": "https://github.com/omacom/linux-aurora.git",
      "branch": "integration/aurora",
      "tag_pattern": "aurora-(?P<version>[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+)",
      "version": "7.1.12.aurora2.{version}.r{distance}.g{commit:.7}",
      "variables": {
        "_commit": "{commit}"
      }
    }
  }
}
