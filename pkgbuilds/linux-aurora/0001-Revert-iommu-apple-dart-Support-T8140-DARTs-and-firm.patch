+				u8 idx)
 {
 	struct apple_dart *dart = stream_map->dart;
 	int sid;
 
 	for_each_set_bit(sid, stream_map->sidmap, dart->num_streams) {
-		u64 *live = dart->locked_ttbr[sid][idx];
-		u64 *owned = dart->locked_owned[sid][idx];
