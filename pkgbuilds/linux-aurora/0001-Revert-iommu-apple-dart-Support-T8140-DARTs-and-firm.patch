-	unsigned int i, drained = 0;
-
-	if (dart->hw->type != DART_T8110 || dart->version < 0x0202)
-		return;
-
-	for (i = 0; i < DIV_ROUND_UP(dart->num_streams, 32) && i < 8; i++) {
