diff --git a/tests/test-lid-covered.c b/tests/test-lid-covered.c
new file mode 100644
index 00000000..3afb15d7
--- /dev/null
+++ b/tests/test-lid-covered.c
@@ -0,0 +1,316 @@
+/*
+ * FpContext: readers that a closed lid covers
+ * Copyright (C) 2026 Ryan Murray <ryan@aurorasilicon.org>
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/*
+ * How FpContext hides a lid-covered reader and probes it again. A detached
+ * lid switch stands in for the real one and the fake driver for the reader,
+ * so these run anywhere: no udev, uinput or hardware.
+ */
+
+#include <libfprint/fprint.h>
+
+#include "fpi-device.h"
+#include "fpi-lid-switch.h"
+#include "test-device-fake.h"
+
+#define SETTLE_US (G_USEC_PER_SEC / 5)
+#define WAIT_US (5 * G_USEC_PER_SEC)
+
+typedef struct
+{
+  FpContext    *context;
+  FpiLidSwitch *lid;
+  GPtrArray    *devices;   /* what device-added/removed say is there */
+  guint         added;
+  guint         removed;
+} Fixture;
+
+static void
+device_added_cb (FpContext *context, FpDevice *device, Fixture *f)
+{
+  g_assert_false (g_ptr_array_find (f->devices, device, NULL));
+  g_ptr_array_add (f->devices, g_object_ref (device));
+  f->added++;
+}
+
+static void
+device_removed_cb (FpContext *context, FpDevice *device, Fixture *f)
+{
+  g_assert_false (fp_device_is_open (device));
+  g_assert_true (g_ptr_array_remove (f->devices, device));
+  f->removed++;
+}
+
+static void
+fixture_set_up (Fixture *f, gconstpointer user_data)
+{
+  f->context = fp_context_new ();
+  f->lid = fpi_lid_switch_new_detached ();
+  f->devices = g_ptr_array_new_with_free_func (g_object_unref);
+
+  g_signal_connect (f->context, "device-added", G_CALLBACK (device_added_cb), f);
+  g_signal_connect (f->context, "device-removed", G_CALLBACK (device_removed_cb), f);
+}
+
+static void
+fixture_tear_down (Fixture *f, gconstpointer user_data)
+{
+  if (f->context)
+    g_signal_handlers_disconnect_by_data (f->context, f);
+  g_clear_object (&f->context);
+  g_clear_pointer (&f->devices, g_ptr_array_unref);
+
+  /* Let callbacks still in flight finish against a context that is gone. */
+  while (g_main_context_iteration (NULL, FALSE))
+    ;
+
+  g_clear_object (&f->lid);
+}
+
+static void
+add_reader (Fixture *f)
+{
+  fpi_context_add_lid_covered_device (f->context, f->lid, FPI_TYPE_DEVICE_FAKE,
+                                      0, NULL, NULL, NULL);
+}
+
+/* Iterate until device-added and device-removed have fired @added and
+ * @removed times, then a little longer to see nothing else happens. */
+static void
+wait_for_counts (Fixture *f, guint added, guint removed)
+{
+  gint64 deadline = g_get_monotonic_time () + WAIT_US;
+  gint64 settle;
+
+  while (f->added < added || f->removed < removed)
+    {
+      g_assert_cmpint (g_get_monotonic_time (), <, deadline);
+      if (!g_main_context_iteration (NULL, FALSE))
+        g_usleep (1000);
+    }
+
+  settle = g_get_monotonic_time () + SETTLE_US;
+  while (g_get_monotonic_time () < settle)
+    if (!g_main_context_iteration (NULL, FALSE))
+      g_usleep (1000);
+
+  g_assert_cmpuint (f->added, ==, added);
+  g_assert_cmpuint (f->removed, ==, removed);
+}
+
+static FpDevice *
+the_reader (Fixture *f)
+{
+  g_assert_cmpuint (f->devices->len, ==, 1);
+  return g_ptr_array_index (f->devices, 0);
+}
+
+static gboolean
+is_removed (FpDevice *device)
+{
+  gboolean removed = FALSE;
+
+  g_object_get (device, "removed", &removed, NULL);
+  return removed;
+}
+
+/* Lid open: the reader is there. Closing removes it, opening brings back a
+ * new instance. */
+static void
+test_close_and_open (Fixture *f, gconstpointer user_data)
+{
+  FpDevice *first;
+
+  add_reader (f);
+  wait_for_counts (f, 1, 0);
+  first = the_reader (f);
+
+  fpi_lid_switch_set_closed (f->lid, TRUE);
+  g_assert_true (is_removed (first));
+  wait_for_counts (f, 1, 1);
+  g_assert_cmpuint (f->devices->len, ==, 0);
+
+  fpi_lid_switch_set_closed (f->lid, FALSE);
+  wait_for_counts (f, 2, 1);
+  g_assert_false (is_removed (the_reader (f)));
+
+  /* And once more, to show nothing is left over from the first round. */
+  fpi_lid_switch_set_closed (f->lid, TRUE);
+  wait_for_counts (f, 2, 2);
+  fpi_lid_switch_set_closed (f->lid, FALSE);
+  wait_for_counts (f, 3, 2);
+}
+
+/* A reader matched while the lid is closed is only probed once it opens. */
+static void
+test_matched_while_closed (Fixture *f, gconstpointer user_data)
+{
+  fpi_lid_switch_set_closed (f->lid, TRUE);
+
+  add_reader (f);
+  wait_for_counts (f, 0, 0);
+
+  fpi_lid_switch_set_closed (f->lid, FALSE);
+  wait_for_counts (f, 1, 0);
+}
+
+/* The lid closes while the reader is being probed: it stays hidden, and
+ * appears when the lid opens. */
+static void
+test_closed_during_probe (Fixture *f, gconstpointer user_data)
+{
+  add_reader (f);
+  /* The probe is in flight: nothing has dispatched yet. */
+  fpi_lid_switch_set_closed (f->lid, TRUE);
+  wait_for_counts (f, 0, 0);
+
+  fpi_lid_switch_set_closed (f->lid, FALSE);
+  wait_for_counts (f, 1, 0);
+}
+
+/* The lid closes and opens again while the removed instance is still open
+ * (claimed by fprintd, say). The new instance is probed only once the old
+ * one is closed, never next to it. */
+static void
+test_opened_while_still_claimed (Fixture *f, gconstpointer user_data)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(FpDevice) first = NULL;
+
+  add_reader (f);
+  wait_for_counts (f, 1, 0);
+  first = g_object_ref (the_reader (f));
+  g_assert_true (fp_device_open_sync (first, NULL, &error));
+  g_assert_no_error (error);
+
+  fpi_lid_switch_set_closed (f->lid, TRUE);
+  g_assert_true (is_removed (first));
+  /* Still open, so the context keeps it. */
+  wait_for_counts (f, 1, 0);
+
+  fpi_lid_switch_set_closed (f->lid, FALSE);
+  wait_for_counts (f, 1, 0);
+
+  /* Closing it reports the removal; then it is dropped and a new one
+   * probed in its place. */
+  fp_device_close_sync (first, NULL, &error);
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_REMOVED);
+  wait_for_counts (f, 2, 1);
+  g_assert_true (the_reader (f) != first);
+  g_assert_false (is_removed (the_reader (f)));
+}
+
+/* The removed instance is closed while the lid is still shut: it is
+ * dropped, and nothing comes back until the lid opens. */
+static void
+test_released_while_closed (Fixture *f, gconstpointer user_data)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(FpDevice) first = NULL;
+
+  add_reader (f);
+  wait_for_counts (f, 1, 0);
+  first = g_object_ref (the_reader (f));
+  g_assert_true (fp_device_open_sync (first, NULL, &error));
+
+  fpi_lid_switch_set_closed (f->lid, TRUE);
+  fp_device_close_sync (first, NULL, &error);
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_REMOVED);
+  wait_for_counts (f, 1, 1);
+
+  fpi_lid_switch_set_closed (f->lid, FALSE);
+  wait_for_counts (f, 2, 1);
+}
+
+static void
+verify_done_cb (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  GError **error = user_data;
+
+  g_assert_false (fp_device_verify_finish (FP_DEVICE (source), res, NULL, NULL, error));
+  g_assert_nonnull (*error);
+}
+
+/* The lid closes while a verify runs: the verify ends as removed, the way
+ * fprintd reports verify-disconnected, and the reader goes once it is
+ * closed. */
+static void
+test_closed_during_verify (Fixture *f, gconstpointer user_data)
+{
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GError) verify_error = NULL;
+  g_autoptr(FpPrint) enrolled = NULL;
+  gint64 deadline;
+  FpDevice *reader;
+
+  add_reader (f);
+  wait_for_counts (f, 1, 0);
+  reader = the_reader (f);
+  g_assert_true (fp_device_open_sync (reader, NULL, &error));
+  g_assert_no_error (error);
+
+  FPI_DEVICE_FAKE (reader)->ret_result = FPI_MATCH_FAIL;
+  enrolled = g_object_ref_sink (fp_print_new (reader));
+  fp_device_verify (reader, enrolled, NULL, NULL, NULL, NULL,
+                    verify_done_cb, &verify_error);
+  fpi_lid_switch_set_closed (f->lid, TRUE);
+
+  deadline = g_get_monotonic_time () + WAIT_US;
+  while (verify_error == NULL)
+    {
+      g_assert_cmpint (g_get_monotonic_time (), <, deadline);
+      g_main_context_iteration (NULL, TRUE);
+    }
+  g_assert_error (verify_error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_REMOVED);
+  g_assert_true (is_removed (reader));
+  wait_for_counts (f, 1, 0);
+
+  fp_device_close_sync (reader, NULL, &error);
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_REMOVED);
+  wait_for_counts (f, 1, 1);
+}
+
+/* The context goes away with a probe in flight. */
+static void
+test_context_gone_during_probe (Fixture *f, gconstpointer user_data)
+{
+  add_reader (f);
+  g_signal_handlers_disconnect_by_data (f->context, f);
+  g_clear_object (&f->context);
+  /* fixture_tear_down() dispatches the cancelled probe. */
+}
+
+int
+main (int argc, char *argv[])
+{
+  g_test_init (&argc, &argv, NULL);
+
+#define ADD(path, func) \
+  g_test_add ("/lid-covered/" path, Fixture, NULL, fixture_set_up, func, fixture_tear_down)
+
+  ADD ("close-and-open", test_close_and_open);
+  ADD ("matched-while-closed", test_matched_while_closed);
+  ADD ("closed-during-probe", test_closed_during_probe);
+  ADD ("opened-while-still-claimed", test_opened_while_still_claimed);
+  ADD ("released-while-closed", test_released_while_closed);
+  ADD ("closed-during-verify", test_closed_during_verify);
+  ADD ("context-gone-during-probe", test_context_gone_during_probe);
+
+  return g_test_run ();
+}
diff --git a/tests/test-lid-switch.c b/tests/test-lid-switch.c
new file mode 100644
index 00000000..ef3f6d36
--- /dev/null
+++ b/tests/test-lid-switch.c
@@ -0,0 +1,306 @@
+/*
+ * FpiLidSwitch tests, with uinput lid switches
+ * Copyright (C) 2026 Ryan Murray <ryan@aurorasilicon.org>
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/*
+ * These tests make real lid switches with uinput, so they need write access
+ * to /dev/uinput and a running udev; without either they are skipped. They
+ * also need a system whose own lid, if it has one, is open.
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/uinput.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include <glib.h>
+
+#include "fpi-lid-switch.h"
+
+#define LID_TIMEOUT_US (5 * G_USEC_PER_SEC)
+
+typedef struct
+{
+  gint fd;
+} TestLid;
+
+static TestLid *
+test_lid_new (const gchar *name)
+{
+  struct uinput_setup setup = { 0 };
+  TestLid *lid;
+  gint fd;
+
+  fd = open ("/dev/uinput", O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+  if (fd < 0)
+    return NULL;
+
+  setup.id.bustype = BUS_VIRTUAL;
+  g_strlcpy (setup.name, name, sizeof (setup.name));
+
+  if (ioctl (fd, UI_SET_EVBIT, EV_SW) < 0 ||
+      ioctl (fd, UI_SET_SWBIT, SW_LID) < 0 ||
+      ioctl (fd, UI_DEV_SETUP, &setup) < 0 ||
+      ioctl (fd, UI_DEV_CREATE) < 0)
+    {
+      close (fd);
+      return NULL;
+    }
+
+  lid = g_new0 (TestLid, 1);
+  lid->fd = fd;
+  return lid;
+}
+
+static void
+test_lid_emit (TestLid *lid, guint16 type, guint16 code, gint32 value)
+{
+  struct input_event ev = { 0 };
+
+  ev.type = type;
+  ev.code = code;
+  ev.value = value;
+  g_assert_cmpint (write (lid->fd, &ev, sizeof (ev)), ==, sizeof (ev));
+}
+
+static void
+test_lid_set_closed (TestLid *lid, gboolean closed)
+{
+  test_lid_emit (lid, EV_SW, SW_LID, closed);
+  test_lid_emit (lid, EV_SYN, SYN_REPORT, 0);
+}
+
+static void
+test_lid_free (TestLid *lid)
+{
+  ioctl (lid->fd, UI_DEV_DESTROY);
+  close (lid->fd);
+  g_free (lid);
+}
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (TestLid, test_lid_free)
+
+/* Iterate @context until @self says @closed, for at most LID_TIMEOUT_US. */
+static gboolean
+wait_for_closed (GMainContext *context, FpiLidSwitch *self, gboolean closed)
+{
+  gint64 deadline = g_get_monotonic_time () + LID_TIMEOUT_US;
+
+  while (fpi_lid_switch_get_closed (self) != closed)
+    {
+      if (g_get_monotonic_time () > deadline)
+        return FALSE;
+      if (!g_main_context_iteration (context, FALSE))
+        g_usleep (10000);
+    }
+
+  return TRUE;
+}
+
+/* Settle for a while and check @self never says anything but @closed. */
+static gboolean
+stays_closed (GMainContext *context, FpiLidSwitch *self, gboolean closed)
+{
+  gint64 deadline = g_get_monotonic_time () + G_USEC_PER_SEC / 2;
+
+  while (g_get_monotonic_time () < deadline)
+    {
+      if (fpi_lid_switch_get_closed (self) != closed)
+        return FALSE;
+      if (!g_main_context_iteration (context, FALSE))
+        g_usleep (10000);
+    }
+
+  return fpi_lid_switch_get_closed (self) == closed;
+}
+
+static guint
+count_open_fds (void)
+{
+  g_autoptr(GDir) dir = g_dir_open ("/proc/self/fd", 0, NULL);
+  guint n = 0;
+
+  g_assert_nonnull (dir);
+  while (g_dir_read_name (dir))
+    n++;
+  return n;
+}
+
+static gboolean
+skip_unless_usable (void)
+{
+  g_autoptr(FpiLidSwitch) lid = NULL;
+
+  if (access ("/dev/uinput", W_OK) != 0)
+    {
+      g_test_skip ("needs write access to /dev/uinput");
+      return TRUE;
+    }
+
+  if (access ("/run/udev/control", F_OK) != 0)
+    {
+      g_test_skip ("needs a running udev");
+      return TRUE;
+    }
+
+  lid = fpi_lid_switch_new ();
+  if (fpi_lid_switch_get_closed (lid))
+    {
+      g_test_skip ("this system's own lid is closed");
+      return TRUE;
+    }
+
+  return FALSE;
+}
+
+/* A switch that appears after we started, bounces, and goes away again. */
+static void
+test_lid_switch_hotplug (void)
+{
+  g_autoptr(FpiLidSwitch) self = NULL;
+  g_autoptr(TestLid) lid = NULL;
+  guint fds_before;
+
+  if (skip_unless_usable ())
+    return;
+
+  fds_before = count_open_fds ();
+  self = fpi_lid_switch_new ();
+  g_assert_false (fpi_lid_switch_get_closed (self));
+
+  lid = test_lid_new ("libfprint test lid");
+  g_assert_nonnull (lid);
+
+  test_lid_set_closed (lid, TRUE);
+  g_assert_true (wait_for_closed (NULL, self, TRUE));
+
+  /* Bounce */
+  test_lid_set_closed (lid, FALSE);
+  test_lid_set_closed (lid, TRUE);
+  test_lid_set_closed (lid, FALSE);
+  g_assert_true (wait_for_closed (NULL, self, FALSE));
+  g_assert_true (stays_closed (NULL, self, FALSE));
+
+  /* A switch that goes away while closed no longer counts */
+  test_lid_set_closed (lid, TRUE);
+  g_assert_true (wait_for_closed (NULL, self, TRUE));
+  g_clear_pointer (&lid, test_lid_free);
+  g_assert_true (wait_for_closed (NULL, self, FALSE));
+
+  g_clear_object (&self);
+  while (g_main_context_iteration (NULL, FALSE))
+    continue;
+  g_assert_cmpuint (count_open_fds (), ==, fds_before);
+}
+
+/* Any closed lid counts, as for logind. */
+static void
+test_lid_switch_two_lids (void)
+{
+  g_autoptr(FpiLidSwitch) self = NULL;
+  g_autoptr(TestLid) a = NULL;
+  g_autoptr(TestLid) b = NULL;
+
+  if (skip_unless_usable ())
+    return;
+
+  a = test_lid_new ("libfprint test lid A");
+  b = test_lid_new ("libfprint test lid B");
+  g_assert_nonnull (a);
+  g_assert_nonnull (b);
+
+  self = fpi_lid_switch_new ();
+
+  /* Both must be followed before we go on */
+  test_lid_set_closed (a, TRUE);
+  g_assert_true (wait_for_closed (NULL, self, TRUE));
+  test_lid_set_closed (a, FALSE);
+  g_assert_true (wait_for_closed (NULL, self, FALSE));
+  test_lid_set_closed (b, TRUE);
+  g_assert_true (wait_for_closed (NULL, self, TRUE));
+
+  test_lid_set_closed (a, TRUE);
+  test_lid_set_closed (b, FALSE);
+  g_assert_true (stays_closed (NULL, self, TRUE));
+
+  test_lid_set_closed (a, FALSE);
+  g_assert_true (wait_for_closed (NULL, self, FALSE));
+}
+
+static gpointer
+lid_thread_func (gpointer user_data)
+{
+  TestLid *lid = user_data;
+  g_autoptr(GMainContext) context = g_main_context_new ();
+  g_autoptr(FpiLidSwitch) self = NULL;
+  gboolean ok;
+
+  g_main_context_push_thread_default (context);
+
+  self = fpi_lid_switch_new ();
+  g_assert_false (fpi_lid_switch_get_closed (self));
+
+  test_lid_set_closed (lid, TRUE);
+  ok = wait_for_closed (context, self, TRUE);
+
+  g_clear_object (&self);
+  g_main_context_pop_thread_default (context);
+
+  return GINT_TO_POINTER (ok);
+}
+
+/* Like the rest of libfprint, the switch must dispatch in the thread-default
+ * main context of the thread that made it, not in the global default one. */
+static void
+test_lid_switch_thread_default_context (void)
+{
+  g_autoptr(TestLid) lid = NULL;
+  g_autoptr(FpiLidSwitch) settle = NULL;
+  GThread *thread;
+
+  if (skip_unless_usable ())
+    return;
+
+  lid = test_lid_new ("libfprint test lid");
+  g_assert_nonnull (lid);
+
+  /* Wait until udev knows the switch, so the thread finds it at once. */
+  settle = fpi_lid_switch_new ();
+  test_lid_set_closed (lid, TRUE);
+  g_assert_true (wait_for_closed (NULL, settle, TRUE));
+  test_lid_set_closed (lid, FALSE);
+  g_assert_true (wait_for_closed (NULL, settle, FALSE));
+  g_clear_object (&settle);
+
+  thread = g_thread_new ("lid", lid_thread_func, lid);
+  g_assert_true (GPOINTER_TO_INT (g_thread_join (thread)));
+}
+
+int
+main (int argc, char *argv[])
+{
+  g_test_init (&argc, &argv, NULL);
+
+  g_test_add_func ("/lid-switch/hotplug", test_lid_switch_hotplug);
+  g_test_add_func ("/lid-switch/two-lids", test_lid_switch_two_lids);
+  g_test_add_func ("/lid-switch/thread-default-context", test_lid_switch_thread_default_context);
+
+  return g_test_run ();
+}
