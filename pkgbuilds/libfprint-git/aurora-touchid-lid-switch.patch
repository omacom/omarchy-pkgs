diff --git a/tests/test-fpi-device.c b/tests/test-fpi-device.c
index 165532d7..0b9b3b9e 100644
--- a/tests/test-fpi-device.c
+++ b/tests/test-fpi-device.c
@@ -2834,6 +2834,43 @@ test_driver_identify_suspend_while_idle (void)
   g_assert_no_error (error);
 }
 
+static void
+on_removed_set_flag (gboolean *flag)
+{
+  *flag = TRUE;
+}
+
+/* A device removed while the system sleeps, such as a reader that a closed
+ * lid covers, must still be closable after resume. */
+static void
+test_driver_removed_while_suspended (void)
+{
+  g_autoptr(FpAutoResetClass) dev_class = auto_reset_device_class ();
+  g_autoptr(FpDevice) device = NULL;
+  g_autoptr(GError) error = NULL;
+  gboolean removed_emitted = FALSE;
+
+  device = g_object_new (FPI_TYPE_DEVICE_FAKE, NULL);
+  g_signal_connect_swapped (device, "removed", G_CALLBACK (on_removed_set_flag), &removed_emitted);
+  g_assert_true (fp_device_open_sync (device, NULL, NULL));
+
+  g_assert_true (fp_device_suspend_sync (device, NULL, &error));
+  g_assert_no_error (error);
+
+  fpi_device_remove (device);
+  g_assert_true (removed_emitted);
+
+  fp_device_resume_sync (device, NULL, &error);
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_REMOVED);
+  g_clear_error (&error);
+
+  /* Closing reports the removal, but must close the device rather than
+   * refuse as busy. */
+  fp_device_close_sync (device, NULL, &error);
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_REMOVED);
+  g_assert_false (fp_device_is_open (device));
+}
+
