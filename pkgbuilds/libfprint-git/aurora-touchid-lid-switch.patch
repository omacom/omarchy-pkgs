+#ifdef HAVE_UDEV
+/* A udev device whose sensor a closed lid covers (FpDeviceClass:covered_by_lid).
+ *
+ * Nobody can touch such a sensor while the lid is closed, so the device is
+ * removed then, and anyone asking for a reader sees none instead of one that
+ * waits for a finger that cannot come. This record outlives the FpDevice
+ * instances made from it, so the device can be probed again once the lid
+ * opens. */
+typedef struct
+{
+  FpContext *context;     /* NULL once the context is gone */
+  GType      driver;
+  guint64    driver_data;
+  gchar     *spidev_path;
+  gchar     *hidraw_path;
+  gchar     *misc_path;
+  FpDevice  *device;      /* current instance, until the context drops it */
+  gboolean   probing;
+} LidCoveredDevice;
+
+static void lid_covered_probe (FpContext        *context,
+                               LidCoveredDevice *covered);
+#endif
