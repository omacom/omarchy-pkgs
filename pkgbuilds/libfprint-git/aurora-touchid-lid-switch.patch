+
+static void
+lid_covered_init_done_cb (GObject *source_object, GAsyncResult *res, gpointer user_data)
+{
+  LidCoveredDevice *covered = user_data;
+  g_autoptr(GError) error = NULL;
+  g_autoptr(FpDevice) device = NULL;
+  FpContextPrivate *priv;
+
+  device = FP_DEVICE (g_async_initable_new_finish (G_ASYNC_INITABLE (source_object),
+                                                   res, &error));
+
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED) || !covered->context)
+    {
+      lid_covered_device_release (covered);
+      return;
+    }
+
+  priv = fp_context_get_instance_private (covered->context);
+  priv->pending_devices--;
+  covered->probing = FALSE;
+
+  if (error)
+    {
+      g_message ("Ignoring device due to initialization error: %s", error->message);
+    }
+  else if (fpi_lid_switch_get_closed (priv->lid))
+    {
+      /* The lid closed while the device was being probed. */
+      fp_dbg ("Lid closed during probe; %s stays hidden",
+              fp_device_get_driver (device));
+    }
+  else
+    {
+      covered->device = device;
+      add_device (covered->context, g_steal_pointer (&device));
+    }
+
+  lid_covered_device_release (covered);
+}
+
+static void
+lid_covered_probe (FpContext *context, LidCoveredDevice *covered)
+{
+  FpContextPrivate *priv = fp_context_get_instance_private (context);
+
+  if (covered->device || covered->probing)
+    return;
+
+  covered->probing = TRUE;
+  priv->pending_devices++;
+  g_async_initable_new_async (covered->driver,
+                              G_PRIORITY_LOW,
+                              priv->cancellable,
+                              lid_covered_init_done_cb,
+                              g_rc_box_acquire (covered),
+                              "fpi-driver-data", covered->driver_data,
+                              "fpi-udev-data-spidev", covered->spidev_path,
+                              "fpi-udev-data-hidraw", covered->hidraw_path,
+                              "fpi-udev-data-misc", covered->misc_path,
+                              NULL);
+}
+
+static void
+lid_closed_changed_cb (FpContext *context)
+{
+  FpContextPrivate *priv = fp_context_get_instance_private (context);
+  gboolean closed = fpi_lid_switch_get_closed (priv->lid);
+  guint i;
+
+  for (i = 0; i < priv->lid_covered->len; i++)
+    {
+      LidCoveredDevice *covered = g_ptr_array_index (priv->lid_covered, i);
+
+      if (!closed)
+        {
+          /* Probed now if the old instance is gone, else once it is. */
+          lid_covered_probe (context, covered);
+        }
+      else if (covered->device)
+        {
+          gboolean removed;
+
+          g_object_get (covered->device, "removed", &removed, NULL);
+          if (!removed)
+            {
+              fp_dbg ("Lid closed; removing %s", fp_device_get_driver (covered->device));
+              /* The context drops the device once its user has closed it. */
+              fpi_device_remove (covered->device);
+            }
+        }
+    }
+}
+
+/*
+ * fpi_context_add_lid_covered_device:
+ * @lid: (nullable): the lid switch to follow, or %NULL for the system's.
+ *   Only the first device added decides it.
+ *
+ * Register a udev device whose sensor a closed lid covers, and probe it
+ * unless the lid is closed. Tests use @lid to drive a detached switch.
+ */
+void
+fpi_context_add_lid_covered_device (FpContext    *context,
+                                    FpiLidSwitch *lid,
+                                    GType         driver,
+                                    guint64       driver_data,
+                                    const gchar  *spidev_path,
+                                    const gchar  *hidraw_path,
+                                    const gchar  *misc_path)
+{
+  FpContextPrivate *priv = fp_context_get_instance_private (context);
+  LidCoveredDevice *covered;
+
+  if (!priv->lid)
+    {
+      priv->lid = lid ? g_object_ref (lid) : fpi_lid_switch_new ();
+      priv->lid_covered = g_ptr_array_new_with_free_func ((GDestroyNotify) lid_covered_device_release);
+      g_signal_connect_object (priv->lid, "notify::closed",
+                               G_CALLBACK (lid_closed_changed_cb),
+                               context,
+                               G_CONNECT_SWAPPED);
+    }
+
+  covered = g_rc_box_new0 (LidCoveredDevice);
+  covered->context = context;
+  covered->driver = driver;
+  covered->driver_data = driver_data;
+  covered->spidev_path = g_strdup (spidev_path);
+  covered->hidraw_path = g_strdup (hidraw_path);
+  covered->misc_path = g_strdup (misc_path);
+  g_ptr_array_add (priv->lid_covered, covered);
+
+  if (fpi_lid_switch_get_closed (priv->lid))
+    {
+      g_autoptr(FpDeviceClass) cls = g_type_class_ref (driver);
+
+      fp_info ("The lid covers the %s sensor; it appears once the lid opens", cls->id);
+      return;
+    }
+
+  lid_covered_probe (context, covered);
 }
+#endif
 
