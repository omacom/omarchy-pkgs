# Maintainer: Mikko Nyman <mikko@nyman.xyz>
# Based on the Arch libfprint package by Jan Alexander Steffens (heftig).
#
# Omarchy's fingerprint setup installs this in place of stock libfprint, so
# readers upstream supports ahead of an Arch release reach users by bumping
# the pin here. Pinned to the commit adding the Synaptics reader USB
# 06cb:010b, missing from stock libfprint 1.94.100; the FocalTech MOC support
# carried by the previous pin is retained.
#
# The Elan MOC reader 04f3:0c90 (ASUS Vivobook) is carried as upstream MR !641
# (elanmoc-add-pid-0x0C90.patch) until it merges, with the fixes it needs for
# everyday use, each written for upstream as well:
#  - elanmoc-0c90-delete-prints.patch lets fprintd delete the prints the
#    sensor stores, so removing a finger or enrolling it again no longer
#    leaves a stale print behind to fill a slot or be matched in its place;
#  - elanmoc-0c90-discard-stale-replies.patch keeps a reply left from the
#    previous session from shifting every later one;
#  - elanmoc-identify-complete-after-user-id.patch keeps a failed identify
#    from leaving the reader busy until fprintd restarts;
#  - device-close-after-resume.patch closes a reader released while
#    suspended once it resumes, rather than leaving it open for good.
#
# On aarch64 it also carries the aurora driver for Apple Touch ID, which the
# aurora kernel's Secure Enclave driver exposes as /dev/sep-bio
# (aurora-apple-sep.patch, by Chris Kearney). The x86_64 build is unchanged.
# The driver accepts only /dev/sep-bio interface version 4
# (AURORA_BIO_IFACE_VERSION): a kernel that bumps it turns Touch ID off until
# this patch follows, so move the two together.

pkgname=libfprint-git
pkgver=1.94.100.r10.g6f9479c
pkgrel=4
# Retain the epoch used to supersede the previously published untested build.
epoch=1
pkgdesc="Library for fingerprint readers (pinned upstream snapshot with FocalTech, Synaptics 06cb:010b and Elan 04f3:0c90 support, and Apple Touch ID on aarch64)"
url="https://fprint.freedesktop.org/"
arch=(x86_64 aarch64)
license=(LGPL-2.1-or-later)
depends=(
  gcc-libs
  glib2
  glibc
  libgudev
  libgusb
  openssl
  pixman
)
makedepends=(
  git
  glib2-devel
  gobject-introspection
  gtk-doc
  meson
  python-cairo
  python-gobject
  systemd
)
checkdepends=(
  cairo
  umockdev
)
# Versioned, so a package that requires a libfprint version still installs.
provides=("libfprint=$pkgver" libfprint-2.so)
conflicts=(libfprint)
groups=(fprint)
source=(
  "git+https://gitlab.freedesktop.org/libfprint/libfprint.git#commit=6f9479c3d55f847c1b3769f28ceb99227f9858cf"
  "focaltech_moc-add-pid-0xA97A.patch"
  "elanmoc-add-pid-0x0C90.patch"
  "elanmoc-identify-complete-after-user-id.patch"
  "device-close-after-resume.patch"
  "elanmoc-0c90-discard-stale-replies.patch"
  "elanmoc-0c90-delete-prints.patch"
)
source_aarch64=("aurora-apple-sep.patch")
b2sums=(
  'SKIP'
  'SKIP'
  'e654869553e8faf502d7d5fe13ed1a26c998fdcf6f3fadcb1dd6299fa94c60955d0daefe2e89a8061d94ce7701b5a2fffd3910715cfb4250d6b4143292ba2b4c'
  '6a9df14989c37627b56ad14a6bc030b71859bf571cf9a1a3c751f199355956e1ed509c87606300e16fd915739f98672ec3a72cb7373a9cb9991b514fbea73e22'
  '8460ccc61e647c4e97066cd9d1d498d8a42b56856a17b3cd997fbdb3ab18e548d4645ffc381b6050c99b46618f2d6d0f549982476211aadbc5d47f5e1bc8c7e6'
  '66eeeafd370ed5762e468b66a821d13f90ef0d35f874cac12fc47b071435440326966d16ddb9dfe3319bb189d436e2ae2900c27b895e40dc45aecfdc73fdc7c9'
  '0819c09bc188ef2629d2c16bfca6fa8d75b2ea7af0abf34f2265104ba59e5c83815bcdc17311f4ec4d8919cdc02154e615b2a8d6f5ff16e64392915dc5ba870a'
)
b2sums_aarch64=('ec577996066baf6db6d741763abd681aae5556d52a8b67f7a52a60a4df7015c5d1edf3637835e563b2fb0edde2499173d61c50717b621f6bddf94a1f700075e5')

pkgver() {
  cd libfprint
  ( set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null \
      | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
      || printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  )
}

prepare() {
  cd libfprint

  if ! grep -qi 'pid = 0xa97a' libfprint/drivers/focaltech_moc/focaltech_moc.c; then
    patch -p1 < "$srcdir/focaltech_moc-add-pid-0xA97A.patch"
  fi

  # Applied in order, each skipped only when every hunk is already in: a pin
  # that carries one upstream drops it, and a tree a failed run left
  # half-patched fails here instead of building.
  local elan_patch
  for elan_patch in \
    elanmoc-add-pid-0x0C90.patch \
    elanmoc-identify-complete-after-user-id.patch \
    device-close-after-resume.patch \
    elanmoc-0c90-discard-stale-replies.patch \
    elanmoc-0c90-delete-prints.patch; do
    if ! patch -p1 -R --dry-run --silent --force < "$srcdir/$elan_patch" >/dev/null 2>&1; then
      patch -p1 --forward < "$srcdir/$elan_patch"
    fi
  done

  # Skipped only when every hunk is already in: a tree a failed run left
  # half-patched fails here instead of building.
  if [[ $CARCH == "aarch64" ]] &&
    ! patch -p1 -R --dry-run --silent --force < "$srcdir/aurora-apple-sep.patch" >/dev/null 2>&1; then
    patch -p1 --forward < "$srcdir/aurora-apple-sep.patch"
  fi
}

build() {
  local meson_options=(
    -D drivers=all
    -D installed-tests=false
  )
  arch-meson libfprint build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}

