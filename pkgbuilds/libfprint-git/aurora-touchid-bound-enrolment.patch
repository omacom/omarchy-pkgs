 #define AURORA_BIO_GUIDANCE_PLACE         1
 #define AURORA_BIO_GUIDANCE_LIFT_AND_MOVE 2
@@ -130,3 +142,9 @@ struct aurora_bio_attest {
 #define AURORA_BIO_DELETE       _IOW (AURORA_BIO_IOC_MAGIC, 0x08, struct aurora_bio_delete)
 #define AURORA_BIO_DELETE_ALL   _IO  (AURORA_BIO_IOC_MAGIC, 0x09)
 #define AURORA_BIO_ATTEST       _IOWR(AURORA_BIO_IOC_MAGIC, 0x0a, struct aurora_bio_attest)
+#define AURORA_BIO_LIST_ENCLAVE _IOR (AURORA_BIO_IOC_MAGIC, 0x0b, struct aurora_bio_enclave_list)
+#define AURORA_BIO_DELETE_ORPHAN _IOW (AURORA_BIO_IOC_MAGIC, 0x0c, struct aurora_bio_delete)
+/* Creates the empty Linux owner context only when SEP lists zero Linux
+ * identities. ENROL_START itself never repairs a missing persistence binding.
+ */
+#define AURORA_BIO_PREPARE_ENROL _IOW (AURORA_BIO_IOC_MAGIC, 0x0d, struct aurora_bio_enrol_start)
