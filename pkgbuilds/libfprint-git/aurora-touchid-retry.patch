+/* Why the kernel ended an enrol or verify, in a poll's 'status'. Headers from
+ * before these were named carry the same numbers; those kernels never report
+ * RETRY while an enrolment is running, nor REJECTED at all. */
+#ifndef AURORA_BIO_STATUS_REJECTED
+#define AURORA_BIO_STATUS_NONE     0
+#define AURORA_BIO_STATUS_SENSOR   1
+#define AURORA_BIO_STATUS_ENCLAVE  2
+#define AURORA_BIO_STATUS_TOO_MANY 3
+#define AURORA_BIO_STATUS_TIMEOUT  4
+#define AURORA_BIO_STATUS_RETRY    5
+#define AURORA_BIO_STATUS_UNFILED  6
+#define AURORA_BIO_STATUS_REJECTED 7
+#endif
