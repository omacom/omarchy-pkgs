+static const gchar *
+aurora_status_reason (guint32 status)
+{
+  switch (status)
+    {
+    case AURORA_BIO_STATUS_NONE:
+      return "it was cancelled or ended by the system";
+
+    case AURORA_BIO_STATUS_SENSOR:
+      return "the fingerprint sensor failed";
+
+    case AURORA_BIO_STATUS_ENCLAVE:
+      return "the secure enclave refused a step";
+
+    case AURORA_BIO_STATUS_TOO_MANY:
+      return "the enclave did not complete the enrolment within its captures";
+
+    case AURORA_BIO_STATUS_TIMEOUT:
+      return "no finger was placed on the sensor in time";
+
+    case AURORA_BIO_STATUS_RETRY:
+      return "the capture was not usable";
+
+    case AURORA_BIO_STATUS_UNFILED:
+      return "the fingerprint was enrolled but could not be recorded";
+
+    case AURORA_BIO_STATUS_REJECTED:
+      return "too many captures in a row were not usable; "
+             "rest more of the finger flat on the sensor and enrol again";
+
+    default:
+      return NULL;
+    }
+}
+
+static GError *
+aurora_failure_new (const gchar *operation, guint32 status)
+{
+  const gchar *reason = aurora_status_reason (status);
+
+  if (reason == NULL)
+    return fpi_device_error_new_msg (FP_DEVICE_ERROR_GENERAL,
+                                     "%s failed, driver status 0x%x",
+                                     operation, status);
+
+  return fpi_device_error_new_msg (FP_DEVICE_ERROR_GENERAL,
+                                   "%s failed: %s (driver status %u)",
+                                   operation, reason, status);
+}
+
+/* The kernel reports an unusable capture without saying why it was unusable,
+ * so the general retry is the most specific code that is always true. */
+static GError *
+aurora_retry_new (void)
+{
+  return fpi_device_retry_new_msg (FP_DEVICE_RETRY_GENERAL,
+                                   "the capture was not usable; touch the sensor again");
+}
