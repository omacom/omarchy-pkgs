pkgname=dicolens
pkgver=0.8.0
pkgrel=1
pkgdesc='A DICOM viewer for Omarchy: open a hospital CD, a folder, or a file and look through your scans, from the keyboard'
arch=('x86_64' 'aarch64')
url='https://github.com/yamz8/dicolens'
license=('MIT')
options=('!debug')
depends=(
  'ffmpeg'
  'hicolor-icon-theme'
  'libarchive'
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'qt6-wayland'
  'xdg-desktop-portal'
  'xdg-utils'
  'zlib'
)
makedepends=('cmake' 'gcc' 'make')
checkdepends=()
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c3810389aafd87f29bd3551954224b885c76538b46df92bcb092c672dd65ffef')
install='dicolens.install'

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ctest --test-dir build --output-on-failure
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build --prefix /usr
}
