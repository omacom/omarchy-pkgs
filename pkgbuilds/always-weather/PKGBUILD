# Maintainer: Pavel Guzhikov <apps@guzh.uk>

pkgname=always-weather
pkgver=1.0.5
pkgrel=1
pkgdesc='Drag through the hours and see when the rain comes. Calm, clear and ad-free.'
arch=('x86_64')
url='https://guzh.uk/weather/'
license=('LicenseRef-Always-Weather')
# Java 21 with AWT (not the headless runtime); gdbus (glib2) follows the desktop's light or dark.
depends=('java-runtime=21' 'glib2' 'hicolor-icon-theme')
provides=('always-weather-bin')
conflicts=('always-weather-bin')
options=(!debug)
# The vendor's release build: jars, launcher, desktop entry, icon and licence.
source=("https://github.com/xternal/guzh.uk/releases/download/always-weather-linux-$pkgver/always-weather-$pkgver-linux-x86_64.tar.gz")
sha256sums=('5b2d765784dd195a57a2f1d4967c14177f5bb3d8c6365b7fec250f7db4acfffb')

package() {
  cd "always-weather-$pkgver"
  install -d "$pkgdir/usr/lib/always-weather" "$pkgdir/usr/bin"
  cp -r --no-preserve=ownership bin lib "$pkgdir/usr/lib/always-weather/"
  # The launcher finds its jars beside itself, through the link, and runs on Java 21.
  ln -s /usr/lib/always-weather/bin/always-weather "$pkgdir/usr/bin/always-weather"
  install -Dm644 share/always-weather.desktop "$pkgdir/usr/share/applications/always-weather.desktop"
  install -Dm644 share/always-weather.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/always-weather.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
