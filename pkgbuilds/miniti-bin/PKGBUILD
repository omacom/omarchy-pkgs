# Maintainer: Ian Ahuja <hello@miniti.app>
# Prebuilt miniti for Linux from the GitHub release tarball (built on Ubuntu
# 22.04 / glibc 2.35). The same directory is kept under
# packaging/omarchy-pkgs/miniti-bin/ in the miniti-linux repository; keep the two in step.
pkgname=miniti-bin
pkgver=0.6.2
pkgrel=1
pkgdesc="AI meeting assistant with live transcription, insights and coaching (binary release)"
arch=(x86_64)
url="https://github.com/12ian34/miniti-linux"
license=(Elastic-2.0)
# The tray library is dlopen'd (libayatana-appindicator3.so.1 first, then
# libappindicator3.so.1), so ldd does not show it; libayatana-appindicator is
# what Omarchy ships. gtk-layer-shell is what pins the floating recording
# surface on Hyprland, Omarchy's compositor, so it is a real dependency here.
depends=(webkit2gtk-4.1 gtk3 libsoup3 librsvg libayatana-appindicator gtk-layer-shell alsa-lib
         pipewire pipewire-pulse libpulse libsecret libnotify hicolor-icon-theme)
optdepends=('gnome-keyring: mirror the account credentials into the secret service'
            'xdg-desktop-portal: keep the machine awake during a meeting on desktops without a screensaver service'
            'xdg-utils: open Polar / OAuth pages in the browser')
provides=("miniti=${pkgver}")
conflicts=(miniti)
# The release binary is already stripped; nothing for makepkg's debug split.
options=(!debug)
source_x86_64=("$url/releases/download/v$pkgver/miniti-$pkgver-x86_64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('e046e9aff44612a634165e24db71bcda1810343151c2aeb5777768ee10d4eb3b')

# Install a file only if this release ships it. The binary, the desktop entry
# and the icons are in every release; the metainfo, man page and completions
# arrived in 0.5.0. Globbing the icons keeps the size list out of here.
_opt() { # _opt <source> <destination>
  [[ -f "$1" ]] && install -Dm644 "$1" "$2"
  return 0
}

package() {
  cd "miniti-$pkgver-x86_64-unknown-linux-gnu"
  install -Dm755 miniti "$pkgdir/usr/bin/miniti"
  install -Dm644 miniti.desktop "$pkgdir/usr/share/applications/miniti.desktop"
  for icon in icons/hicolor/*/apps/*; do
    install -Dm644 "$icon" "$pkgdir/usr/share/icons/${icon#icons/}"
  done
  _opt com.miniti.linux.metainfo.xml "$pkgdir/usr/share/metainfo/com.miniti.linux.metainfo.xml"
  _opt miniti.1 "$pkgdir/usr/share/man/man1/miniti.1"
  _opt completions/miniti.bash "$pkgdir/usr/share/bash-completion/completions/miniti"
  _opt completions/_miniti "$pkgdir/usr/share/zsh/site-functions/_miniti"
  _opt completions/miniti.fish "$pkgdir/usr/share/fish/vendor_completions.d/miniti.fish"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
