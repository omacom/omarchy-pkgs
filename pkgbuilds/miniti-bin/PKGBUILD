# Maintainer: Ian Ahuja <hello@miniti.app>
# Prebuilt miniti for Linux from the GitHub release tarball (built on Ubuntu
# 22.04 / glibc 2.35). The same directory is kept under
# packaging/omarchy-pkgs/miniti-bin/ in the miniti-linux repository; keep the two in step.
pkgname=miniti-bin
pkgver=0.4.1
pkgrel=1
pkgdesc="AI meeting assistant with live transcription, insights and coaching (binary release)"
arch=(x86_64)
url="https://github.com/12ian34/miniti-linux"
license=(Elastic-2.0)
depends=(webkit2gtk-4.1 gtk3 libsoup3 librsvg libappindicator-gtk3 alsa-lib
         pipewire pipewire-pulse libpulse libsecret libnotify hicolor-icon-theme)
optdepends=('gtk-layer-shell: pin the floating recording surface on Hyprland and other wlr compositors'
            'gnome-keyring: keep the account credentials and device id in the secret service'
            'xdg-desktop-portal: keep the machine awake during a meeting on desktops without a screensaver service'
            'xdg-utils: open Polar / OAuth pages in the browser')
provides=("miniti=${pkgver}")
conflicts=(miniti)
# The release binary is already stripped; nothing for makepkg's debug split.
options=(!debug)
source_x86_64=("$url/releases/download/v$pkgver/miniti-$pkgver-x86_64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('d50efc366cb49349b99fdaacbae8f765b72ea9bf2f2736a9c744c2b666f597b5')

package() {
  cd "miniti-$pkgver-x86_64-unknown-linux-gnu"
  install -Dm755 miniti "$pkgdir/usr/bin/miniti"
  install -Dm644 miniti.desktop "$pkgdir/usr/share/applications/miniti.desktop"
  install -Dm644 com.miniti.linux.metainfo.xml "$pkgdir/usr/share/metainfo/com.miniti.linux.metainfo.xml"
  install -Dm644 miniti.1 "$pkgdir/usr/share/man/man1/miniti.1"
  install -Dm644 completions/miniti.bash "$pkgdir/usr/share/bash-completion/completions/miniti"
  install -Dm644 completions/_miniti "$pkgdir/usr/share/zsh/site-functions/_miniti"
  install -Dm644 completions/miniti.fish "$pkgdir/usr/share/fish/vendor_completions.d/miniti.fish"
  for size in 32x32 48x48 64x64 128x128 256x256 512x512; do
    install -Dm644 "icons/hicolor/$size/apps/miniti.png" "$pkgdir/usr/share/icons/hicolor/$size/apps/miniti.png"
  done
  install -Dm644 icons/hicolor/scalable/apps/miniti.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/miniti.svg"
  install -Dm644 icons/hicolor/symbolic/apps/miniti-symbolic.svg "$pkgdir/usr/share/icons/hicolor/symbolic/apps/miniti-symbolic.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
