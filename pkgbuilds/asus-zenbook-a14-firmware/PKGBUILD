  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'asus-socpackage-48168/QualcommBSP/qcsubsys_ext_adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1e80100/ASUSTeK/zenbook-a14/adsp_dtbs.elf'
  install -Dm644 'asus-socpackage-48168/QualcommBSP/qcsubsys_ext_adsp8380/adspr.jsn' "$fw"/'qcom/x1e80100/ASUSTeK/zenbook-a14/adspr.jsn'
