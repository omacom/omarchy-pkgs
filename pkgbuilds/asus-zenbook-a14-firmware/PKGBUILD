# Maintainer: Birk Skyum <birk.skyum@pm.me>
#
# Audio DSP, compute DSP and GPU firmware for the ASUS Zenbook A14 and Zenbook 14 (2026). The
# firmware only runs if it is signed for this board by ASUS, so linux-firmware cannot carry it
# until the OEM submits it. The OEM ships it in its Windows driver download, which this recipe
# unpacks without running. The files are installed unmodified, under the names the device tree
# requests, and checked against the SHA-256 each was matched to.

pkgname=asus-zenbook-a14-firmware
pkgver=20261102
pkgrel=1
pkgdesc='Audio DSP, compute DSP and GPU firmware for the ASUS Zenbook A14 and Zenbook 14 (2026)'
arch=('aarch64')
url='https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/48168/SOCPackage_forWebSite_Qualcomm_Z_V1.312.8100.0_48168.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1e80100-asustek-zenbook-a14' 'qcom-firmware-x1p42100-asustek-zenbook-a14')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'asus-socpackage-48168.exe::https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/48168/SOCPackage_forWebSite_Qualcomm_Z_V1.312.8100.0_48168.exe'
  'asus-socpackage-50096.exe::https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/50096/SOCPackage_forWebSite_Qualcomm_Z_V1.315.8800.0_50096.exe'
)
noextract=('asus-socpackage-48168.exe' 'asus-socpackage-50096.exe')
sha256sums=('ce4593e948157ede6d936bec0db03b09bcbb39c3b11fab5d89c52b8954e72fde' 'a4da90754407bd0348c507fc97989459c20c90be39023ca11068072306ad722d')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'asus-socpackage-48168.exe' 'asus-socpackage-48168' 7z-appended
  _unpack 'asus-socpackage-50096.exe' 'asus-socpackage-50096' 7z-appended
}

