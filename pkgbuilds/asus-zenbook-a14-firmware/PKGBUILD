  install -Dm644 'asus-socpackage-50096/QualcommBSP/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1p42100/ASUSTeK/zenbook-a14/cdsp_dtbs.elf'
