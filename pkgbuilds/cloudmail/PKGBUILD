# Maintainer: Ferdous Bhai <23114244+ferdousbhai@users.noreply.github.com>
pkgname=cloudmail
pkgver=0.5.0
pkgrel=1
pkgdesc="Screened email on your own domains, running in your Cloudflare account (CLI + GTK app)"
arch=('x86_64' 'aarch64')
url="https://github.com/ferdousbhai/cloud-mail"
license=('MIT')
depends=('gtk4' 'webkitgtk-6.0' 'glib2' 'gcc-libs' 'glibc')
makedepends=('cargo')
options=('!debug' '!lto')  # makepkg's C LTO breaks ring's assembly objects
optdepends=(
  'npm: deploying the worker with `cloudmail setup`, and Google'\''s Workspace CLI for an opt-in Gmail account'
  'libnotify: new-mail notifications in cloudmail-gtk'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c6fbd375cbfda33405bdf4b89079e059617cec324037ed195161b1ebcc3ff076')

_srcdir() { echo "$srcdir/cloud-mail-$pkgver"; }

prepare() {
  cd "$(_srcdir)"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$(_srcdir)"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p cloudmail -p cloudmail-gtk
}

check() {
  cd "$(_srcdir)"
  export CARGO_TARGET_DIR=target
  cargo test --frozen -p cloudmail -p cloudmail-api
}

package() {
  cd "$(_srcdir)"
  install -Dm755 target/release/cloudmail "$pkgdir/usr/bin/cloudmail"
  ln -s cloudmail "$pkgdir/usr/bin/cmail"
  install -Dm755 target/release/cloudmail-gtk "$pkgdir/usr/bin/cloudmail-gtk"
  install -Dm644 crates/cloudmail-gtk/data/com.ferdousbhai.Cloudmail.desktop \
    "$pkgdir/usr/share/applications/com.ferdousbhai.Cloudmail.desktop"
  install -Dm644 crates/cloudmail-gtk/data/com.ferdousbhai.Cloudmail.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.ferdousbhai.Cloudmail.svg"

  # Worker source for `cloudmail setup` (copied to ~/.local/share/cloudmail/worker when run).
  local w="$pkgdir/usr/share/cloudmail/worker"
  install -Dm644 -t "$w" worker/package.json worker/bun.lock worker/tsconfig.json \
    worker/cloudflare.config.ts worker/worker-configuration.d.ts
  install -Dm644 -t "$w/src" worker/src/*.ts
  install -Dm644 -t "$w/migrations" worker/migrations/*.sql

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md docs/API.md -t "$pkgdir/usr/share/doc/$pkgname"
}
