# Maintainer: Ferdous Bhai <23114244+ferdousbhai@users.noreply.github.com>
pkgname=cloudmail
pkgver=0.8.2
pkgrel=1
pkgdesc="Email for people and organizations on their own domains, run from their own Cloudflare account, plus Gmail, iCloud Mail and HEY (CLI + GTK app)"
arch=('x86_64' 'aarch64')
url="https://github.com/ferdousbhai/cloud-mail"
license=('MIT' 'ISC')  # ISC: the Lucide icons compiled into cloudmail-gtk (THIRD_PARTY_NOTICES.md)
# The API token and other secrets live only in the Secret Service, so one is
# required; Omarchy ships gnome-keyring with an unlocked default keyring.
depends=('gtk4' 'webkitgtk-6.0' 'glib2' 'gcc-libs' 'glibc' 'org.freedesktop.secrets')
makedepends=('cargo')
checkdepends=('dbus')  # the CLI tests' private session bus
options=('!debug' '!lto')  # makepkg's C LTO breaks ring's assembly objects
optdepends=(
  'npm: deploying the worker with `cloudmail setup`, and Google'\''s Workspace CLI for an opt-in Gmail account'
  'libnotify: new-mail notifications in the desktop app'
  'icloud-session: an opt-in iCloud Mail account (from icloud-for-omarchy)'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b5534da658885e281ecdfd466c836c9fb170d4f9a52096b42c6581b0896a7b03')

_srcdir() { echo "$srcdir/cloud-mail-$pkgver"; }

prepare() {
  cd "$(_srcdir)"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$(_srcdir)"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
  cargo build --frozen --release -p cloudmail -p cloudmail-gtk
}

check() {
  cd "$(_srcdir)"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
  # The app's unit tests need no display. Its scripted QA (dev/qa.sh, feature `qa`) stays with bin/check and CI.
  cargo test --frozen -p cloudmail -p cloudmail-api -p cloudmail-gtk
}

package() {
  cd "$(_srcdir)"
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/cloudmail" "$pkgdir/usr/bin/cloudmail"
  ln -s cloudmail "$pkgdir/usr/bin/cmail"
  # One name, as Omarchy's apps have: `cloudmail open` starts the desktop app, which lives beside the package's
  # other files so that the command on PATH is the CLI alone; the .desktop file, icon and window class are `cloudmail`.
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/cloudmail-gtk" "$pkgdir/usr/lib/cloudmail/cloudmail-gtk"
  # The app's command before 0.8, kept for key bindings and notification actions that name it: it runs `cloudmail open`.
  install -Dm755 crates/cloudmail-gtk/data/cloudmail-gtk "$pkgdir/usr/bin/cloudmail-gtk"
  install -Dm644 crates/cloudmail-gtk/data/cloudmail.desktop "$pkgdir/usr/share/applications/cloudmail.desktop"
  install -Dm644 crates/cloudmail-gtk/data/cloudmail.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/cloudmail.svg"

  # Worker source for `cloudmail setup` (copied to ~/.local/share/cloudmail/worker when run). The whole
  # directory minus tests, so adding or renaming a worker file never breaks the package.
  local w="$pkgdir/usr/share/cloudmail/worker" f
  while IFS= read -r -d '' f; do
    install -Dm644 "worker/${f#./}" "$w/${f#./}"
  done < <(cd worker && find . -type f ! -path './test/*' ! -name .gitignore -print0)

  install -Dm644 LICENSE THIRD_PARTY_NOTICES.md -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 README.md docs/API.md -t "$pkgdir/usr/share/doc/$pkgname"
}
