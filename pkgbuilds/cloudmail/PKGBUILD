# Maintainer: Ferdous Bhai <23114244+ferdousbhai@users.noreply.github.com>
pkgname=cloudmail
pkgver=0.7.6
pkgrel=1
pkgdesc="Email for people and organizations on their own domains, run from their own Cloudflare account, plus Gmail, iCloud Mail and HEY (CLI + GTK app)"
arch=('x86_64' 'aarch64')
url="https://github.com/ferdousbhai/cloud-mail"
license=('MIT')
# The API token and other secrets live only in the Secret Service, so one is
# required; Omarchy ships gnome-keyring with an unlocked default keyring.
depends=('gtk4' 'webkitgtk-6.0' 'glib2' 'gcc-libs' 'glibc' 'org.freedesktop.secrets')
makedepends=('cargo')
checkdepends=('dbus')  # the CLI tests' private session bus
options=('!debug' '!lto')  # makepkg's C LTO breaks ring's assembly objects
optdepends=(
  'npm: deploying the worker with `cloudmail setup`, and Google'\''s Workspace CLI for an opt-in Gmail account'
  'libnotify: new-mail notifications in cloudmail-gtk'
  'icloud-session: an opt-in iCloud Mail account (from icloud-for-omarchy)'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('37dfcc14f19523a8af9216aa6c90de241f9636fc6967b97ce0eef7cc8ea183e5')

_srcdir() { echo "$srcdir/cloud-mail-$pkgver"; }

prepare() {
  cd "$(_srcdir)"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$(_srcdir)"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
  cargo build --frozen --release -p cloudmail -p cloudmail-gtk
}

check() {
  cd "$(_srcdir)"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
  cargo test --frozen -p cloudmail -p cloudmail-api
}

package() {
  cd "$(_srcdir)"
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/cloudmail" "$pkgdir/usr/bin/cloudmail"
  ln -s cloudmail "$pkgdir/usr/bin/cmail"
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/cloudmail-gtk" "$pkgdir/usr/bin/cloudmail-gtk"
  install -Dm644 crates/cloudmail-gtk/data/com.ferdousbhai.Cloudmail.desktop \
    "$pkgdir/usr/share/applications/com.ferdousbhai.Cloudmail.desktop"
  install -Dm644 crates/cloudmail-gtk/data/com.ferdousbhai.Cloudmail.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.ferdousbhai.Cloudmail.svg"

  # Worker source for `cloudmail setup` (copied to ~/.local/share/cloudmail/worker when run). The whole
  # directory minus tests, so adding or renaming a worker file never breaks the package.
  local w="$pkgdir/usr/share/cloudmail/worker" f
  while IFS= read -r -d '' f; do
    install -Dm644 "worker/${f#./}" "$w/${f#./}"
  done < <(cd worker && find . -type f ! -path './test/*' ! -name .gitignore -print0)

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md docs/API.md -t "$pkgdir/usr/share/doc/$pkgname"
}
