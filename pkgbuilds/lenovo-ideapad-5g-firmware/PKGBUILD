# Audio DSP, compute DSP, GPU and modem firmware for the Lenovo IdeaPad 5G 14Q8X05. The firmware
# only runs if it is signed for this board by Lenovo, so linux-firmware cannot carry it until the
# OEM submits it. The OEM ships it in the driver bundle it publishes for the machine on Windows
# Update, whose cabinets this recipe fetches with wudrivers and unpacks without running anything.
# Each file is checked against the SHA-256 it was matched to and installed under the name the
# device tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so
# once linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=lenovo-ideapad-5g-firmware
pkgver=20261116
pkgrel=1
pkgdesc='Audio DSP, compute DSP, GPU and modem firmware for the Lenovo IdeaPad 5G 14Q8X05'
arch=('aarch64')
url='https://github.com/birkskyum/wudrivers'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-sc8180xp-lenovo-82kf')
makedepends=('7zip' 'wudrivers')
options=('!strip' '!debug')
# Windows Update's links are short-lived, so wudrivers fetches a fresh one by update ID, revision and SHA-1.
DLAGENTS+=('wu::/usr/bin/wudrivers fetch %u -o %o')
source=(
  'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcwlan8180.cab::wu://58e60859-8f55-4ef0-b8b9-5bf35d6b20be/1/a6156fd58f815a8f470f8c5db0ac7c298db64dbd'
  'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcsubsys-ext-cdsp8180.cab::wu://58e60859-8f55-4ef0-b8b9-5bf35d6b20be/1/c3e05090fc46fdbea241c3c0a1c74ceba286a060'
  'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcsubsys-ext-adsp8180.cab::wu://58e60859-8f55-4ef0-b8b9-5bf35d6b20be/1/785b6fe34d22f74f71c950e2f7382e303479ca86'
  'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcdx8180.cab::wu://58e60859-8f55-4ef0-b8b9-5bf35d6b20be/1/ed1719eaaf12377682796d86dc47b61d46ec5b09'
  'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcsubsys-ext-mpss8180.cab::wu://58e60859-8f55-4ef0-b8b9-5bf35d6b20be/1/376227d8a3e1f92d6c1e8e17521924e79697dda2'
)
source+=('README.package.md')
noextract=('lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcwlan8180.cab' 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcsubsys-ext-cdsp8180.cab' 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcsubsys-ext-adsp8180.cab' 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcdx8180.cab' 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcsubsys-ext-mpss8180.cab')
sha256sums=('4641519a02db3db7c837f269e5cb195c76f8b5f194cc97c4583c6682d0823ad2' 'b2d5c7861a52c22edfe26be20c446d38f7c3a623f987cf5b802cf582dadf8b28' '815d18b38d1d279b51cc4e1efd565a343ae5516359c0c31e6543ac44e4ba1445' '1fa296f8247b2cf0768079d2d1a0bf3a3c4b715d040273303b9614cb636f07ef' 'bdff9d3603e111d6d442edb3f3e0cc6519b17c8391da6f5e0fa334e16c0d19eb')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcwlan8180.cab' 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcwlan8180' 7z
  _unpack 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcsubsys-ext-cdsp8180.cab' 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcsubsys-ext-cdsp8180' 7z
  _unpack 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcsubsys-ext-adsp8180.cab' 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcsubsys-ext-adsp8180' 7z
  _unpack 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcdx8180.cab' 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcdx8180' 7z
  _unpack 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcsubsys-ext-mpss8180.cab' 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcsubsys-ext-mpss8180' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcsubsys-ext-adsp8180/qcadsp8180.mbn' "$fw"/'qcom/sc8180xp/LENOVO/82KF/qcadsp8180.mbn'
  install -Dm644 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcsubsys-ext-cdsp8180/qccdsp8180.mbn' "$fw"/'qcom/sc8180xp/LENOVO/82KF/qccdsp8180.mbn'
  install -Dm644 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcdx8180/qcdxkmsuc8180.mbn' "$fw"/'qcom/sc8180xp/LENOVO/82KF/qcdxkmsuc8180.mbn'
  install -Dm644 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcsubsys-ext-mpss8180/qcmpss8180_nm.mbn' "$fw"/'qcom/sc8180xp/LENOVO/82KF/qcmpss8180_nm.mbn'
  install -Dm644 'lenovo-ideapad-5g-14q8x05-wu-200.0.3.0-qcwlan8180/WLANMDSP.MBN' "$fw"/'qcom/sc8180xp/LENOVO/82KF/wlanmdsp.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
af96686581d869fb0b038c5650745c95a1582dfa7895323acf31929b03fd9d00  qcom/sc8180xp/LENOVO/82KF/qcadsp8180.mbn
66816c7815cbb90fd2136de63fe76392a37fc96a18c9d0bf51e3261f5f7dcfda  qcom/sc8180xp/LENOVO/82KF/qccdsp8180.mbn
7bc9035fc38bcdc49e0a2ffbb797e65cf331592e4fab3984ae2fdacf271a4bbb  qcom/sc8180xp/LENOVO/82KF/qcdxkmsuc8180.mbn
02a5958ce3de36c57c148f1ea426aef41d62f740a89275ff42c865f44fe155f5  qcom/sc8180xp/LENOVO/82KF/qcmpss8180_nm.mbn
757ddc182369acd7dee153104c03011b973ced6da09461f84f41adc6e724d9b9  qcom/sc8180xp/LENOVO/82KF/wlanmdsp.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
