# Maintainer: Vahid Khoshnoud <khoshnud@gmail.com>
pkgname=vazirmatn-fonts
pkgver=33.003
pkgrel=1
pkgdesc='Vazirmatn Persian and Arabic typeface'
arch=('any')
url='https://github.com/rastikerdar/vazirmatn'
license=('custom:OFL')
depends=('fontconfig')
makedepends=('git')
_commit='83629f877e8f084cc07b47030b5d3a0ff06c76ec'
source=("vazirmatn::git+https://github.com/rastikerdar/vazirmatn.git#commit=${_commit}")
sha256sums=('SKIP')

package() {
  cd "$srcdir/vazirmatn"

  install -d "$pkgdir/usr/share/fonts/vazirmatn"
  install -m644 fonts/ttf/*.ttf "$pkgdir/usr/share/fonts/vazirmatn/"
  install -Dm644 OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"

  install -d "$pkgdir/usr/share/fontconfig/conf.avail" "$pkgdir/etc/fonts/conf.d"
  cat > "$pkgdir/usr/share/fontconfig/conf.avail/60-vazirmatn-persian.conf" <<'EOF'
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <!-- Use Vazirmatn for Persian UI text without replacing terminal monospace fonts. -->
  <match target="pattern">
    <test name="lang" compare="contains">
      <string>fa</string>
    </test>
    <test name="family" qual="any">
      <string>sans-serif</string>
    </test>
    <edit name="family" mode="prepend" binding="strong">
      <string>Vazirmatn</string>
    </edit>
  </match>

  <!-- Omarchy maps system-ui to Liberation Sans in its default fontconfig rules. -->
  <match target="pattern">
    <test name="lang" compare="contains">
      <string>fa</string>
    </test>
    <test name="family" qual="any">
      <string>Liberation Sans</string>
    </test>
    <edit name="family" mode="prepend" binding="strong">
      <string>Vazirmatn</string>
    </edit>
  </match>
</fontconfig>
EOF
  ln -s /usr/share/fontconfig/conf.avail/60-vazirmatn-persian.conf \
    "$pkgdir/etc/fonts/conf.d/60-vazirmatn-persian.conf"
}
