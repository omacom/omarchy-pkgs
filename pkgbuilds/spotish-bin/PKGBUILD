# Maintainer: Jason Lee <huacnlee@gmail.com>

pkgname=spotish-bin
_name=spotish
pkgver=0.1.3
pkgrel=1
pkgdesc="Lightweight native Spotify client built with NSH, driving Spotify's web player"
arch=('x86_64')
url="https://github.com/huacnlee/spotish"
license=('Apache-2.0')
depends=('glibc' 'gcc-libs' 'glib2' 'gtk4' 'webkitgtk-6.0' 'libsoup3' 'cairo' 'pango' 'harfbuzz' 'fontconfig' 'graphene' 'gstreamer' 'gst-plugins-base-libs' 'libxkbcommon' 'wayland' 'libglvnd' 'vulkan-icd-loader')
provides=("$_name")
conflicts=("$_name")
options=('!debug' '!strip')
noextract=("$_name-$pkgver-linux-x86_64.tar.gz")
source=("LICENSE-APACHE-$pkgver::https://raw.githubusercontent.com/huacnlee/spotish/v$pkgver/LICENSE-APACHE")
source_x86_64=("$url/releases/download/v$pkgver/$_name-$pkgver-linux-x86_64.tar.gz")
sha256sums=('2c6dd45590bae703f466589f0d38d40d61f39d14e9bd03b225a0d322e236076b')
sha256sums_x86_64=('e9e0a7c5034ef9c3e621af49e98722b45ba8505a0b590e6872f981e39900641b')

package() {
  install -dm755 "$pkgdir/opt/$_name"
  bsdtar --no-same-owner -xf "$_name-$pkgver-linux-x86_64.tar.gz" -C "$pkgdir/opt/$_name" --strip-components 1 \
    Spotish/Spotish Spotish/nsh
  install -dm755 "$pkgdir/usr/bin"
  ln -s "/opt/$_name/Spotish" "$pkgdir/usr/bin/$_name"
  bsdtar --no-same-owner -xf "$_name-$pkgver-linux-x86_64.tar.gz" -C "$srcdir" \
    Spotish/dev.huacnlee.spotish.desktop Spotish/dev.huacnlee.spotish.png
  sed 's|^Exec=.*|Exec=spotish|' "$srcdir/Spotish/dev.huacnlee.spotish.desktop" > "$srcdir/$_name.desktop"
  install -Dm644 "$srcdir/$_name.desktop" "$pkgdir/usr/share/applications/dev.huacnlee.spotish.desktop"
  install -Dm644 "$srcdir/Spotish/dev.huacnlee.spotish.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/dev.huacnlee.spotish.png"
  install -Dm644 "LICENSE-APACHE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
