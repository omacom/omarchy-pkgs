# Maintainer: Brandon Williams <turbine.bmw@gmail.com>

# Wi-Fi and Bluetooth addresses for Snapdragon Surfaces (Surface Pro 11,
# Surface Laptop 8), taken from the firmware's MacAddressEmulationAddress
# variable as Windows does.

pkgname=surface-snapdragon-addresses
pkgver=1
pkgrel=2
pkgdesc="Wi-Fi and Bluetooth addresses for Snapdragon Microsoft Surface devices from the firmware address variable"
arch=('aarch64')
# Qualcomm-only: the pacman platform guard keeps it off other hardware.
groups=('omarchy-platform-qualcomm')
url="https://github.com/omacom/omarchy-pkgs"
license=('MIT')
depends=('bash' 'bluez-utils' 'iproute2' 'systemd')
source=(
  'surface-bluetooth-address'
  'surface-bluetooth-address@.service'
  '60-surface-bluetooth-address.rules'
  'surface-wifi-address'
  '81-surface-wifi-address.rules'
  'README.package.md'
  'LICENSE'
)
sha256sums=('615c5054cf3bce6fa291fb48906f675eb665cc0d60df694e1855ce10aa3d8a9c'
            '47546a949145721b51644ecc369f1fac18343a6218a339469fd5fac48cf4a8e5'
            '356dcef5b1d5fed6f44165dbb54025789223bfbd912defe59da2d77c87284cb2'
            'd4f8c4dd46529e7c4546a243fdfd8976eb2f078fd438d4b060ce20f30f3f94f9'
            'a21697fd8ad43aa90bf50a74f77507665062811d31224cd57c90ca2ee5102a85'
            'b867e1dd62a2c3699a8686b65a43b392c7c81e9af413bb40c00bda877a936afb'
            'f74f925ccd6fc2f4b9bdf7682f6927a64809c8668e8232997c541cc6f992787b')

package() {
  local lib=/usr/lib/$pkgname
  install -Dm755 surface-bluetooth-address "$pkgdir$lib/surface-bluetooth-address"
  install -Dm644 surface-bluetooth-address@.service \
    "$pkgdir/usr/lib/systemd/system/surface-bluetooth-address@.service"
  install -Dm644 60-surface-bluetooth-address.rules \
    "$pkgdir/usr/lib/udev/rules.d/60-surface-bluetooth-address.rules"
  install -Dm755 surface-wifi-address "$pkgdir$lib/surface-wifi-address"
  install -Dm644 81-surface-wifi-address.rules \
    "$pkgdir/usr/lib/udev/rules.d/81-surface-wifi-address.rules"

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
