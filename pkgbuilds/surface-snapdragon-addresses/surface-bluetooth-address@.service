[Unit]
Description=Surface Bluetooth public address for %i
ConditionFirmware=smbios-field(sys_vendor = "Microsoft Corporation")
ConditionPathExistsGlob=/sys/firmware/efi/efivars/MacAddressEmulationAddress-*
BindsTo=sys-subsystem-bluetooth-devices-%i.device
After=sys-subsystem-bluetooth-devices-%i.device
Before=bluetooth.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/surface-bluetooth-address.conf
ExecStart=/usr/lib/surface-snapdragon-addresses/surface-bluetooth-address %i
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_BLUETOOTH AF_UNIX
RestrictRealtime=yes
SystemCallArchitectures=native

