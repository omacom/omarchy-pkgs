# Maintainer: David Heinemeier Hansson <david@hey.com>
pkgname=omarchy-local-ai
pkgver=0.2.0
pkgrel=1
pkgdesc="Run open models locally for Omarchy's coding agents, with curated recipes per machine"
arch=('any')
url="https://github.com/omacom/omarchy-local-ai"
license=('MIT')
options=('!debug')
# The engine is Python and drives models through systemd's user manager with
# Quadlet units. Every Omarchy machine has it, so the agents panel can tell
# which recipes fit; Podman and crun, which run the models, are installed by
# `omarchy agent local use` the first time a model is set up.
depends=('python' 'systemd')
optdepends=('podman: runs the models as rootless containers'
            'crun: the container runtime the models use')
makedepends=('git')
source=("git+https://github.com/omacom/omarchy-local-ai.git#tag=v$pkgver")
sha256sums=('SKIP')

check() {
  cd "$srcdir/$pkgname"
  ./omarchy-local-ai validate .
}

package() {
  cd "$srcdir/$pkgname"

  # The engine reads the recipe catalog from the directory it's installed in,
  # so the catalog and the engine ship as one tree and always match. Omarchy's
  # omarchy-agent-local runs it through the one command on PATH.
  install -dm755 "$pkgdir/usr/share/$pkgname"
  cp -a catalog.toml best.toml recipes runtimes reviews measurements "$pkgdir/usr/share/$pkgname/"
  install -Dm644 agent_local.py "$pkgdir/usr/share/$pkgname/agent_local.py"
  install -Dm755 omarchy-local-ai "$pkgdir/usr/share/$pkgname/omarchy-local-ai"

  install -dm755 "$pkgdir/usr/bin"
  ln -s "/usr/share/$pkgname/omarchy-local-ai" "$pkgdir/usr/bin/$pkgname"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/engine.md "$pkgdir/usr/share/doc/$pkgname/engine.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
