# Maintainer: Greg Sargent <11890383+gsargent70@users.noreply.github.com>

pkgname=cargohatch
pkgver=0.2.0
pkgrel=1
pkgdesc='Power-user file manager with two sides, tabs, a folder tree and favourites'
arch=('x86_64' 'aarch64')
url='https://github.com/gsargent70/cargohatch'
license=('MIT')
install='cargohatch.install'
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-wayland'
)
optdepends=(
  'xdg-desktop-portal: the desktop folder chooser'
  'xdg-terminal-exec: open a terminal in a folder'
)
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('3974c1936834cf9c7ec914a4d032691fe3de9892b2b2af0ed72b9182c7eda349')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/cargohatch "$pkgdir/usr/bin/cargohatch"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/cargohatch.desktop "$pkgdir/usr/share/applications/cargohatch.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  local size
  for size in 16 32 48 64 128 256 512; do
    install -Dm644 "assets/icons/hicolor/${size}x${size}/apps/cargohatch.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/cargohatch.png"
  done
}
