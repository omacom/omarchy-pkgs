-#[cfg(feature = "wayland")]
-pub use wayland::get_modifiers_state;
+// Read the already-open input devices instead of mapping a focus-stealing
+// Wayland window. EVIOCGKEY and EVIOCGLED return the kernel's current state.
+pub fn get_modifiers_state(devices: &[i32]) -> anyhow::Result<Option<ModifiersState>> {
+    let mut keys = [0u8; 96];
+    let mut leds = [0u8; 8];
+    let mut queried = false;
+    for fd in devices {
+        let mut device_keys = [0u8; 96];
+        let mut device_leds = [0u8; 8];
+        let key_request = 0x8000_0000u64 | (96 << 16) | (0x45 << 8) | 0x18;
+        let led_request = 0x8000_0000u64 | (8 << 16) | (0x45 << 8) | 0x19;
+        if unsafe { libc::ioctl(*fd, key_request as libc::c_ulong, device_keys.as_mut_ptr()) } >= 0
+        {
+            queried = true;
+            for (combined, device) in keys.iter_mut().zip(device_keys) {
+                *combined |= device;
+            }
+        }
+        if unsafe { libc::ioctl(*fd, led_request as libc::c_ulong, device_leds.as_mut_ptr()) } >= 0
+        {
+            for (combined, device) in leds.iter_mut().zip(device_leds) {
+                *combined |= device;
+            }
+        }
+    }
+    Ok(queried.then(|| decode(&keys, &leds)))
+}
 
-#[cfg(not(feature = "wayland"))]
-pub fn get_modifiers_state() -> anyhow::Result<Option<ModifiersState>> {
-    // Fallback for non-wayland systems
-    Ok(None)
+fn decode(keys: &[u8; 96], leds: &[u8; 8]) -> ModifiersState {
+    let pressed = |key: usize| keys[key / 8] & (1 << (key % 8)) != 0;
+    ModifiersState {
+        ctrl: pressed(29) || pressed(97),
+        shift: pressed(42) || pressed(54),
+        alt: pressed(56) || pressed(100),
+        meta: pressed(125) || pressed(126),
+        caps_lock: leds[0] & 2 != 0,
+        num_lock: leds[0] & 1 != 0,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn decodes_left_and_right_modifiers_and_lock_leds() {
+        for group in [[29, 42, 56, 125], [97, 54, 100, 126]] {
+            let mut keys = [0u8; 96];
+            for key in group {
+                keys[key / 8] |= 1 << (key % 8);
+            }
+            let state = decode(&keys, &[3; 8]);
+            assert!(state.ctrl && state.shift && state.alt && state.meta);
+            assert!(state.caps_lock && state.num_lock);
+        }
+        let state = decode(&[0; 96], &[0; 8]);
+        assert!(!state.ctrl && !state.shift && !state.alt && !state.meta);
+        assert!(!state.caps_lock && !state.num_lock);
+    }
 }
