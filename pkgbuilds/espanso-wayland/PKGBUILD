pkgname=espanso-wayland
pkgver=2.4.1
pkgrel=4
pkgdesc='Text expander with Wayland input, native search, and forms'
arch=('x86_64' 'aarch64')
url='https://espanso.org/'
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'dbus' 'libxkbcommon' 'wxwidgets-gtk3' 'wl-clipboard' 'libcap')
makedepends=('cargo' 'pkgconf')
optdepends=('hyprland: automatic keyboard layout detection on Hyprland')
provides=("espanso=$pkgver")
conflicts=('espanso')
install=espanso-wayland.install
options=('!debug' '!lto')
source=("espanso-$pkgver.tar.gz::https://github.com/espanso/espanso/archive/refs/tags/v$pkgver.tar.gz"
        '0001-hyprland-keyboard-layout.patch'
        '0002-query-evdev-modifiers.patch')
sha256sums=('3121627138be4b1f106b8dfd73fb4b7030ecb44c6a8f4e7628a1174b58e5cfe2' 'd9443e87b13825aff96278e8d522d5306826a62a86ab17caafe2b4d4d389637d' 'a855e891cf8edf6217f27ec9f2b57c376f7b68e735ed13b83d77168ca4725d74')

prepare() {
  cd "espanso-$pkgver"
  patch -Np1 -i "$srcdir/0001-hyprland-keyboard-layout.patch"
  patch -Np1 -i "$srcdir/0002-query-evdev-modifiers.patch"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "espanso-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --no-default-features --features wayland,modulo,vendored-tls
}

check() {
  cd "espanso-$pkgver"
  export CARGO_TARGET_DIR=target
  # Match upstream's Wayland CI selection: GUI and IPC tests need extra setup.
  cargo test --frozen --release --workspace --exclude espanso-modulo --exclude espanso-ipc \
    --no-default-features --features wayland,vendored-tls
}

package() {
  cd "espanso-$pkgver"
  install -Dm755 target/release/espanso "$pkgdir/usr/bin/espanso"
  install -Dm644 espanso/src/res/linux/espanso.desktop "$pkgdir/usr/share/applications/espanso.desktop"
  install -Dm644 espanso/src/res/linux/espanso.png "$pkgdir/usr/share/pixmaps/espanso.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
