pkgname=panora
pkgver=0.7.0
pkgrel=1
pkgdesc='Wallpaper rotation and playback controls for Omarchy'
arch=('x86_64')
url='https://github.com/vadim82/panora'
license=('MIT')
install=panora.install
depends=(
  'at-spi2-core' 'ca-certificates' 'cairo' 'gdk-pixbuf2' 'glib2' 'glibc'
  'gtk3' 'harfbuzz' 'libsoup3' 'pango' 'socat' 'systemd' 'util-linux' 'webkit2gtk-4.1' 'xdg-utils' 'zlib'
)
makedepends=('corepack' 'desktop-file-utils' 'go>=1.27.3' 'nodejs')
options=('!debug')
_revision=f05f156c3a8ee4d4c4df7cbebcf255d91fb27fb2
source=("$url/releases/download/v$pkgver/panora-${_revision}.tar.gz" panora.install)
sha256sums=('1bd3bd0d2b449685284eeb57218c6753fcf9003a366632a9a019f003ffe882d7' '3c32beafa2842c1aca3709c9bcb67f0641c4f5fed19e66b28f101fbf3b265d7f')

prepare() {
  cd "$srcdir/panora/ui"
  corepack pnpm install --frozen-lockfile --prod=false
}

_arch_package_version() {
  if (( ${epoch:-0} > 0 )); then
    printf '%s:' "$epoch"
  fi
  printf '%s-%s' "$pkgver" "$pkgrel"
}

build() {
  export GOTOOLCHAIN=local
  export CGO_CPPFLAGS="$CPPFLAGS" CGO_CFLAGS="$CFLAGS" CGO_LDFLAGS="$LDFLAGS"

  cd "$srcdir/panora/ui"
  corepack pnpm build
  # GCC LTO makes Go's action-based build ID vary between clean builds.
  # Keep the content-based GNU ELF ID used by native debugging tools.
  local ldflags="-buildid= -extldflags=-Wl,--build-id=sha1 -X main.builtArchPackage=$(_arch_package_version)"
  ldflags+=" -X main.builtVersion=$pkgver -X main.builtRevision=$_revision"
  CGO_ENABLED=1 go build -buildvcs=false -trimpath -mod=readonly -buildmode=pie \
    -tags 'wails,production,webkit2_41' \
    -ldflags "$ldflags" -o "$srcdir/panora-ui" .

  cd "$srcdir/panora"
  CGO_ENABLED=0 go build -buildvcs=false -trimpath -mod=readonly -buildmode=pie \
    -o "$srcdir/panora-cli" ./cmd/panora

  node ui/tools/bundled-notices.mjs "$srcdir/panora-cli" "$srcdir/panora-ui" \
    "$srcdir/THIRD-PARTY-NOTICES"
}

check() {
  desktop-file-validate "$srcdir/panora/packaging/arch/io.github.vadim82.panora.desktop"
  bash -n "$srcdir/panora/packaging/arch/package-restart"
  "$srcdir/panora-cli" --help >/dev/null
  local identity
  if ! identity=$("$srcdir/panora-ui" --version) ||
    ! grep -Fxq "Arch package: $(_arch_package_version)" <<<"$identity" ||
    ! grep -Fxq "Source revision: ${_revision:0:12}" <<<"$identity" ||
    ! grep -Fxq "Version: $pkgver" <<<"$identity"; then
    printf 'Panora build identity did not match the package recipe.\n' >&2
    return 1
  fi
}

package() {
  cd "$srcdir/panora"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/THIRD-PARTY-NOTICES" \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES"
  install -Dm755 "$srcdir/panora-cli" "$pkgdir/usr/bin/panora"
  install -Dm755 "$srcdir/panora-ui" "$pkgdir/usr/bin/panora-ui"
  install -Dm644 packaging/arch/io.github.vadim82.panora.desktop \
    "$pkgdir/usr/share/applications/io.github.vadim82.panora.desktop"
  local icons=assets/branding/icons/2026-11-02
  local size
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "$icons/exports/canyon-passage/app/app-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/panora.png"
  done
  install -Dm644 "$icons/masters/canyon-passage.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/panora.svg"
  install -Dm644 packaging/arch/panora.service "$pkgdir/usr/lib/systemd/user/panora.service"
  install -Dm644 packaging/arch/90-panora-restart.hook "$pkgdir/usr/share/libalpm/hooks/90-panora-restart.hook"
  install -Dm755 packaging/arch/package-restart "$pkgdir/usr/lib/panora/package-restart"

  local plugin=io.github.vadim82.panora
  local plugin_source="integrations/omarchy/$plugin"
  local plugin_root="$pkgdir/usr/share/panora/omarchy/$plugin"
  local release_dir="releases/${pkgver}-${pkgrel}"
  local file
  # Quickshell caches QML by URL, including popup components and JS imports.
  for file in "$plugin_source"/{*.qml,*.js,i18n/en.json}; do
    install -Dm644 "$file" "$plugin_root/$release_dir/${file#"$plugin_source/"}"
  done
  node -e '
    const fs = require("node:fs");
    const [source, release] = process.argv.slice(1);
    const manifest = JSON.parse(fs.readFileSync(source, "utf8"));
    manifest.entryPoints.barWidget = release + "/" + manifest.entryPoints.barWidget;
    process.stdout.write(JSON.stringify(manifest, null, 2) + "\n");
  ' "$plugin_source/manifest.json" "$release_dir" > "$plugin_root/manifest.json"
  printf 'var cli = "/usr/bin/panora";\nvar ui = "/usr/bin/panora-ui";\n' > \
    "$plugin_root/$release_dir/PackagePaths.js"
}
