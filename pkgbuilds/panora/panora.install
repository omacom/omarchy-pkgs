# A single root-owned inode is shared across compatible package upgrades.
# Keeping it inside this root also isolates chroot and offline transactions.
_panora_marker=/var/lib/panora-package-lifetime

_panora_valid_marker() {
  [ ! -L "$_panora_marker" ] && [ -f "$_panora_marker" ] &&
    [ "$(stat -c '%u:%a:%h' -- "$_panora_marker")" = '0:644:1' ]
}

post_install() {
  if [ ! -e "$_panora_marker" ] && [ ! -L "$_panora_marker" ]; then
    (umask 022 && set -C && : > "$_panora_marker") || return 1
  fi
  _panora_valid_marker || {
    echo "Panora could not verify the package lifetime file $_panora_marker." >&2
    return 1
  }
}

post_upgrade() {
  post_install
}

post_remove() (
  if ! _panora_valid_marker; then
    echo "Panora's package lifetime file is missing or altered; service shutdown could not be verified." >&2
    return 1
  fi
  exec 9< "$_panora_marker" || return 1
  rm -- "$_panora_marker" || return 1
  # New admissions now fail. All admitted services hold a shared lock until
  # playback, database and private socket cleanup have finished.
  flock --exclusive --timeout 30 9 || {
    echo "Timed out waiting for Panora package service shutdown. Inspect the panora.service user journals." >&2
    return 1
  }
)
