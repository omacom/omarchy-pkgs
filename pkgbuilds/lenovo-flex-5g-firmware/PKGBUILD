# Audio DSP, compute DSP, GPU and modem firmware for the Lenovo Flex 5G and Yoga 5G. The firmware
# only runs if it is signed for this board by Lenovo, so linux-firmware cannot carry it until the
# OEM submits it. The OEM ships it in the driver bundle it publishes for the machine on Windows
# Update, whose cabinets this recipe fetches with wudrivers and unpacks without running anything.
# Each file is checked against the SHA-256 it was matched to and installed under the name the
# device tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so
# once linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=lenovo-flex-5g-firmware
pkgver=20261115
pkgrel=1
pkgdesc='Audio DSP, compute DSP, GPU and modem firmware for the Lenovo Flex 5G and Yoga 5G'
arch=('aarch64')
url='https://github.com/birkskyum/wudrivers'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-sc8180x-lenovo-82ak')
makedepends=('7zip' 'wudrivers')
options=('!strip' '!debug')
# Windows Update's links are short-lived, so wudrivers fetches a fresh one by update ID, revision and SHA-1.
DLAGENTS+=('wu::/usr/bin/wudrivers fetch %u -o %o')
source=(
  'lenovo-82ak-wu-200.0.11.0-qcsubsys-ext-cdsp8180.cab::wu://c1bb02d4-f34d-46bc-9603-5117190782f3/1/b6f1388e8151a54c49ac43e0a0e87d577fa27621'
  'lenovo-82ak-wu-200.0.11.0-qcsubsys-ext-adsp8180.cab::wu://c1bb02d4-f34d-46bc-9603-5117190782f3/1/425da23f481e7d189708f17ab006efc777f4ea49'
  'lenovo-82ak-wu-200.0.11.0-qcdx8180.cab::wu://c1bb02d4-f34d-46bc-9603-5117190782f3/1/0cc89ff2ec57ee1fe1f1a83897ad24e20769ca44'
  'lenovo-82ak-wu-200.0.11.0-qcsubsys-ext-mpss8180.cab::wu://c1bb02d4-f34d-46bc-9603-5117190782f3/1/94c43f41885ff179033aa255463945c7a4f2074a'
)
source+=('README.package.md')
noextract=('lenovo-82ak-wu-200.0.11.0-qcsubsys-ext-cdsp8180.cab' 'lenovo-82ak-wu-200.0.11.0-qcsubsys-ext-adsp8180.cab' 'lenovo-82ak-wu-200.0.11.0-qcdx8180.cab' 'lenovo-82ak-wu-200.0.11.0-qcsubsys-ext-mpss8180.cab')
sha256sums=('38fae7299f1caeb0024af21c46ea62c529da5803243694d79c02aeb790fda54e' 'aa62164ef193d36ff2b8dfb008e07dc312cd79d280ae53166d9a94de6ed95426' '3e269d0384979319518ea2d55f1c5f57726a90ec1a1e46caa9ea8fabccecb1c8' '0076174aa398e4c4eef3ec70936c594fb3e41a9c4e0fd67fd5a438534c516643')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'lenovo-82ak-wu-200.0.11.0-qcsubsys-ext-cdsp8180.cab' 'lenovo-82ak-wu-200.0.11.0-qcsubsys-ext-cdsp8180' 7z
  _unpack 'lenovo-82ak-wu-200.0.11.0-qcsubsys-ext-adsp8180.cab' 'lenovo-82ak-wu-200.0.11.0-qcsubsys-ext-adsp8180' 7z
  _unpack 'lenovo-82ak-wu-200.0.11.0-qcdx8180.cab' 'lenovo-82ak-wu-200.0.11.0-qcdx8180' 7z
  _unpack 'lenovo-82ak-wu-200.0.11.0-qcsubsys-ext-mpss8180.cab' 'lenovo-82ak-wu-200.0.11.0-qcsubsys-ext-mpss8180' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'lenovo-82ak-wu-200.0.11.0-qcsubsys-ext-adsp8180/qcadsp8180.mbn' "$fw"/'qcom/sc8180x/LENOVO/82AK/qcadsp8180.mbn'
  install -Dm644 'lenovo-82ak-wu-200.0.11.0-qcsubsys-ext-cdsp8180/qccdsp8180.mbn' "$fw"/'qcom/sc8180x/LENOVO/82AK/qccdsp8180.mbn'
  install -Dm644 'lenovo-82ak-wu-200.0.11.0-qcdx8180/qcdxkmsuc8180.mbn' "$fw"/'qcom/sc8180x/LENOVO/82AK/qcdxkmsuc8180.mbn'
  install -Dm644 'lenovo-82ak-wu-200.0.11.0-qcsubsys-ext-mpss8180/qcmpss8180_nm.mbn' "$fw"/'qcom/sc8180x/LENOVO/82AK/qcmpss8180_nm.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
23351f379a9cca01a28cee7be0b88c93c76b445d7f38853d592dbca9005bb18e  qcom/sc8180x/LENOVO/82AK/qcadsp8180.mbn
7c146e68f4b3a80ccbc03539e38440c69da4ce4c9e0a8feb74e6d21feb837a33  qcom/sc8180x/LENOVO/82AK/qccdsp8180.mbn
416f200c6bbf9bf3685b332848e733e56f4944954271be9195e9636573002493  qcom/sc8180x/LENOVO/82AK/qcdxkmsuc8180.mbn
fc819b43e639212d9f32a5c356db26aaef6ba0cf89aa7392575b735ac76b2c92  qcom/sc8180x/LENOVO/82AK/qcmpss8180_nm.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
