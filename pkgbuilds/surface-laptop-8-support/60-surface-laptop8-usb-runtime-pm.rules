# Surface Laptop 8: allow idle USB controllers and their PHYs to runtime suspend.
# The kernel forbids runtime PM for DWC3 and xHCI platform devices by default.
# Left active, each Qualcomm USB controller holds its GDSC on and CX at the
# nominal level, so the SoC never reaches CX power collapse in s2idle.
ACTION=="add|bind", SUBSYSTEM=="platform", DRIVER=="dwc3-qcom", TEST=="power/control", ATTR{power/control}="auto"
ACTION=="add|bind", SUBSYSTEM=="platform", DRIVER=="xhci-hcd", DRIVERS=="dwc3-qcom", TEST=="power/control", ATTR{power/control}="auto"
# The USB-C combo PHYs forbid runtime PM at probe too. Only a runtime-suspended
# PHY enters autonomous mode, which is what wakes an idle controller when a
# device is plugged in; without it the first device plugged into an idle port
# is not seen until it is replugged.
ACTION=="add|bind", SUBSYSTEM=="platform", DRIVER=="qcom-qmp-combo-phy", TEST=="power/control", ATTR{power/control}="auto"
# The multiport controller's SuperSpeed PHYs (USB-A) need the same for a USB 3
# device plugged into the idle USB-A port.
ACTION=="add|bind", SUBSYSTEM=="platform", DRIVER=="qcom-qmp-usb-phy", TEST=="power/control", ATTR{power/control}="auto"
