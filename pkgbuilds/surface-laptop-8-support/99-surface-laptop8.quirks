# Surface Laptop 8 13.8-inch ELAN 3370 reports physical force, not contact size.
# Its HID Button Type reports clickpad (0), and force resolution rounds to zero.
# Select libinput's pressure-pad handling so light contact does not need force.
[Surface Laptop 8 ELAN 3370 pressure pad]
MatchUdevType=touchpad
MatchBus=i2c
MatchVendor=0x04F3
MatchProduct=0x3370
MatchDMIModalias=dmi:*svnMicrosoftCorporation:pnSurfaceLaptop13.8in8thEdSnapdragon:*
AttrInputProp=+INPUT_PROP_PRESSUREPAD
