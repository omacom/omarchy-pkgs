# Maintainer: Jim Martin <jimmartin@gmail.com>
# Hardware support for the Microsoft Surface Laptop 8 (13.8-inch, Snapdragon X2
# Elite) that no upstream package carries yet.
pkgname=surface-laptop-8-support
pkgver=1
pkgrel=1
pkgdesc="Hardware support for the Microsoft Surface Laptop 8 (Snapdragon X2 Elite) not yet carried upstream"
arch=('aarch64')
# Qualcomm-only: the pacman platform guard keeps it off other hardware.
groups=('omarchy-platform-qualcomm')
url="https://github.com/omacom/omarchy-pkgs"
license=('MIT' 'BSD-3-Clause' 'LicenseRef-QualcommAtheros-ath10k')
# linux-omarchy carries this laptop's patches and device tree from 7.3-4.
depends=('alsa-ucm-conf' 'linux-firmware-atheros' 'linux-omarchy>=7.3-4' 'python' 'surface-snapdragon-addresses')
makedepends=('alsa-ucm-conf' 'alsa-utils' 'git' 'linux-firmware-atheros' 'm4' 'python' 'zstd')
# The Surface Pro 11 package installs the same reference board record at the
# same path; the two never share a machine.
conflicts=('surface-pro-11-support')
# The board data is an ELF image; stripping it corrupts the record.
options=('!debug' '!strip')
_audioreach_commit=b4c1510fe6686ab8053715a02c34bec875ca5c6c
source=(
  "audioreach-topology::git+https://github.com/linux-msm/audioreach-topology.git#commit=${_audioreach_commit}"
  'GLYMUR-Microsoft-Surface-Laptop-8.m4'
  'GLYMUR-Microsoft-Surface-Laptop-8.conf'
  'HiFi.conf'
  'WSAInit.conf'
  'SpeakerSeq.conf'
  'extract-ath12k-board.py'
  'glymur-microsoft-surface-laptop8.json'
  'qcom-firmware-extract-provided.list'
  'surface-laptop8-usb4-firmware'
  '60-surface-laptop8-usb-runtime-pm.rules'
  '60-surface-laptop8-sleep.conf'
  '99-surface-laptop8.quirks'
  'README.package.md'
  'LICENSE'
)
sha256sums=('f742bfeb0b4c61a78c3dbbb92abc83b986d371a6121c3390000cfafe9ebc2bf1'
            'ad4015e464fa10edee7a66e73e9c392eea37a989eb0e8ca7d36956aacfce0d7d'
