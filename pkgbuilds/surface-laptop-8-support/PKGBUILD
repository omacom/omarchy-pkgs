            '60bcd71dba1d3671d7a961d09a77da0c11b57d24ca9aafa0fb71350d365bc86f'
            '0df9b4b1f54906155f326aa49225fbc5d854ae1ce3f208c6c5193953ae3a98e5'
            'fabedf66bb8a5118e2abadc0548d759217da0d53acb67c4cb9467d6269a1e766'
            '4e24ae5a00ec2179f12e266301bf5c159b15f54be0ff74d764d984c67e4a8f80')

# The laptop's WCN7850 reports generic identifiers (subsystem 17cb:1107,
# board-id 255) that match no board-2.bin entry. This is Qualcomm's own
# reference-design record from linux-firmware, not Surface calibration, the
# one the Surface Pro 11 package uses; it brings Wi-Fi up until linux-firmware
# carries a Surface Laptop 8 entry.
_board_record='bus=pci,vendor=17cb,device=1107,subsystem-vendor=17cb,subsystem-device=3378,qmi-chip-id=2,qmi-board-id=255'
_board_bytes=88872
_board_sha256=0ef5f6f3cb124f33c6de52371819ccd7c13763ceb86d476a178fd56e4cdc26a3
# Deliberate tripwire: the topology must stay byte-identical to the one
# validated on the laptop. An alsa-utils change to alsatplg's output fails the
# build here and needs a fresh check on hardware before this value moves.
_topology_sha256=4f81077a0d8bb7568bfcd490eeea27cf25ec08357eb0f9c5788413bdd79af28e

build() {
  m4 -I "$srcdir/audioreach-topology" GLYMUR-Microsoft-Surface-Laptop-8.m4 >topology.conf
  alsatplg -c topology.conf -o GLYMUR-Microsoft-Surface-Laptop-8-tplg.bin
  echo "$_topology_sha256  GLYMUR-Microsoft-Surface-Laptop-8-tplg.bin" | sha256sum -c

  local container=/usr/lib/firmware/ath12k/WCN7850/hw2.0/board-2.bin
  if [[ ! -f $container && -f $container.zst ]]; then
    zstd -dq "$container.zst" -o board-2.bin
    container=board-2.bin
  fi
  rm -f board.bin
  python extract-ath12k-board.py --expected-bytes "$_board_bytes" \
    --expected-sha256 "$_board_sha256" "$container" "$_board_record" board.bin
}

package() {
  install -Dm644 board.bin "$pkgdir/usr/lib/firmware/ath12k/WCN7850/hw2.0/board.bin"
  install -Dm644 GLYMUR-Microsoft-Surface-Laptop-8-tplg.bin \
    "$pkgdir/usr/lib/firmware/qcom/glymur/GLYMUR-Microsoft-Surface-Laptop-8-tplg.bin"

  local ucm=/usr/share/alsa/ucm2 name
  for name in GLYMUR-Microsoft-Surface-Laptop-8.conf HiFi.conf WSAInit.conf SpeakerSeq.conf; do
    install -Dm644 "$name" "$pkgdir$ucm/Qualcomm/surface-laptop8/$name"
  done
  install -d "$pkgdir$ucm/conf.d/glymur"
  ln -s ../../Qualcomm/surface-laptop8/GLYMUR-Microsoft-Surface-Laptop-8.conf \
    "$pkgdir$ucm/conf.d/glymur/MicrosoftCorporation-SurfaceLaptop13.8in8thEdSnapdragon-124I00137T000M000000.conf"

  # systemd-stub picks the device tree for the UKI by this SMBIOS identity.
  install -Dm644 glymur-microsoft-surface-laptop8.json \
    "$pkgdir/usr/lib/systemd/boot/hwids/aa64/glymur-microsoft-surface-laptop8.json"
  install -Dm644 qcom-firmware-extract-provided.list \
    "$pkgdir/usr/share/qcom-firmware-extract/provided.d/microsoft,surface-laptop8.list"
  install -Dm755 surface-laptop8-usb4-firmware "$pkgdir/usr/bin/surface-laptop8-usb4-firmware"

  install -Dm644 60-surface-laptop8-usb-runtime-pm.rules \
    "$pkgdir/usr/lib/udev/rules.d/60-surface-laptop8-usb-runtime-pm.rules"
  install -Dm644 60-surface-laptop8-sleep.conf "$pkgdir/usr/lib/systemd/sleep.conf.d/60-surface-laptop8.conf"
  install -Dm644 99-surface-laptop8.quirks "$pkgdir/usr/share/libinput/99-surface-laptop8.quirks"

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/audioreach-topology/LICENSE.BSD-3-Clause" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.audioreach-topology"
  install -Dm644 /usr/share/licenses/alsa-ucm-conf/LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.alsa-ucm-conf"
  install -Dm644 /usr/share/licenses/linux-firmware-atheros/LICENSE.QualcommAtheros_ath10k \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.QualcommAtheros_ath10k"
}
