# Maintainer: Brandon Williams <turbine.bmw@gmail.com>

# libcamera with Sony IMX681 support, for the Surface Pro 11's front camera.

pkgname=libcamera-surface-pro-11
_pkgname=libcamera
pkgver=0.7.2
pkgrel=1
pkgdesc="libcamera with Sony IMX681 support for the Microsoft Surface Pro 11 front camera"
arch=('aarch64')
url="https://libcamera.org/"
license=(
  'Apache-2.0'
  'BSD-2-Clause'
  'CC-BY-SA-4.0'
  'CC0-1.0'
  'GPL-2.0-only WITH Linux-syscall-note'
  'GPL-2.0-or-later'
  'LGPL-2.1-or-later'
  'GPL-2.0-or-later WITH Linux-syscall-note OR BSD-3-Clause'
  'GPL-2.0-or-later WITH Linux-syscall-note OR MIT'
)
depends=('glibc' 'gnutls' 'libelf' 'libgcc' 'libglvnd' 'libstdc++' 'libunwind' 'libyaml' 'systemd-libs')
makedepends=('git' 'meson' 'python-jinja' 'python-ply' 'python-pyyaml')
provides=("libcamera=$pkgver" "libcamera-ipa=$pkgver" "libcamera.so" "libcamera-base.so")
conflicts=('libcamera' 'libcamera-ipa')
# makepkg's strip would invalidate the IPA module signature and libcamera
# would then run the IPA isolated; package() strips and re-signs instead.
options=('!strip' '!debug')
source=(
  "git+https://git.libcamera.org/libcamera/libcamera.git#tag=v$pkgver"
  '0001-libcamera-camera_sensor_properties-Add-IMX681.patch'
  '0002-libipa-camera_sensor_helper-add-imx681.patch'
  '0003-ipa-simple-Add-initial-IMX681-tuning-data.patch'
  'README.package.md'
)
sha256sums=('9a69690566abf41304b7a48c5279971a4d00f9ac930479ee8ef56345d8d2cc07'
            '02ce6ec9fbb6651441c4f1b928c433c35651925a856a59df53bb5699d66306fc'
            'ac2742367e5dc5090b58648b56f89204ad2273d1c309cf3600a63ab8c85f3319'
            '5f7340b38b1eff8c6138ecb2cbda86a79d4ade93005f2b68296c553bbfcf6956'
            '162c2f44e53057663f38563e5400ffd48ccfdc60f275220504ea063465896f65')

prepare() {
  cd "$_pkgname"
  local patch
  for patch in ../000*.patch; do
    git apply "$patch"
  done
  printf '%s\n' "$pkgver" >.tarball-version
}

build() {
  # The Surface's camera subsystem uses the simple pipeline with the software
  # ISP; uvcvideo and the V4L2 compatibility layer match Arch's libcamera for
  # USB webcams. GCC 16 array-bounds warnings in libstdc++ would otherwise
  # fail -Werror.
  arch-meson "$_pkgname" build \
    -D pipelines=simple,uvcvideo \
    -D ipas=simple \
    -D softisp-gpu=enabled \
    -D v4l2=enabled \
    -D cam=disabled \
    -D qcam=disabled \
    -D lc-compliance=disabled \
    -D apps-output-dng=disabled \
    -D gstreamer=disabled \
    -D pycamera=disabled \
    -D documentation=disabled \
    -D tracing=disabled \
    -D test=false \
    -D rpi-awb-nn=disabled \
    -D werror=false
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir" --no-rebuild
  # Arch ships the bug-report script in libcamera-tools.
  rm "$pkgdir/usr/bin/libcamera-bug-report"

  # Strip everything, then re-sign the IPA modules with the build's key, as
  # Arch's libcamera-ipa does.
  local file
  while read -rd '' file; do
    strip $STRIP_SHARED "$file"
  done < <(find "$pkgdir/usr/lib" -type f \( -name '*.so*' -o -name '*_proxy' \) ! -name '*.sign' -print0)
  local key
  key=$(find build -type f -iname '*ipa-priv-key.pem' -print -quit)
  for file in "$pkgdir"/usr/lib/libcamera/ipa/*.so; do
    "$_pkgname/src/ipa/ipa-sign.sh" "$key" "$file" "$file.sign"
  done

  install -Dm644 "$_pkgname"/LICENSES/{BSD-2-Clause,BSD-3-Clause,Linux-syscall-note,MIT}.txt \
    -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.package.md"
}
