#
# Video firmware for the Dell XPS 13 9345. The firmware only runs if it is signed for this board
# by Dell, so linux-firmware cannot carry it until the OEM submits it. The OEM ships it in its
# Windows driver download, which this recipe unpacks without running. The files are installed
# unmodified, under the names the device tree requests, and checked against the SHA-256 each was
# matched to.
#
# Generated from https://arewearmyet.com/firmware-sources.json by bin/snapdragon-firmware-recipes;
# change the table, not this file.

pkgname=dell-xps-13-9345-firmware
pkgver=20261102
pkgrel=1
pkgdesc='Video firmware for the Dell XPS 13 9345'
arch=('aarch64')
url='https://dl.dell.com/FOLDER14982355M/1/Qualcomm-Adreno-X1-85-X1-45-Graphics-Driver_2CHK7_WINARM64_31.0.170.0_A11.EXE'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1e80100-dell-xps13-9345')
makedepends=('7zip')
options=('!strip' '!debug')
# dl.dell.com turns away clients that do not name a browser.
DLAGENTS=('https::/usr/bin/curl -qgb "" -A Mozilla/5.0 -fLC - --retry 3 --retry-delay 3 -o %o %u')
source=(
  "dell-2chk7.exe::https://dl.dell.com/FOLDER14982355M/1/Qualcomm-Adreno-X1-85-X1-45-Graphics-Driver_2CHK7_WINARM64_31.0.170.0_A11.EXE"
)
noextract=('dell-2chk7.exe')
sha256sums=('c6daba34013c69cc7331dfd3d1be7eb10e8765f0d082ed1091e9dad8d46f4191')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'dell-2chk7.exe' 'dell-2chk7' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'dell-2chk7/16299/Drivers/MUP/qcdx8380/qcvss8380.mbn' "$fw/qcom/x1e80100/dell/xps13-9345/qcvss8380.mbn"

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
38b88f6050459e03e6c3b8c160bb3b3b09312c9e30ce9edca5103b943f928f71  qcom/x1e80100/dell/xps13-9345/qcvss8380.mbn
SUMS
  )
}
