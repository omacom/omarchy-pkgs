post_install() {
  # Presets also work in an installer chroot, where systemctl ignores
  # daemon-reload and start. Administrators can override NVIDIA's preset in
  # /etc/systemd.
  systemctl preset nvidia-cdi-refresh.service nvidia-cdi-refresh.path
  systemd-notify --booted || return 0
  systemctl daemon-reload
  local unit
  for unit in nvidia-cdi-refresh.service nvidia-cdi-refresh.path; do
    if systemctl --quiet is-enabled "$unit"; then
      # Don't hold the pacman transaction while the driver is probed.
      systemctl start --no-block "$unit"
    fi
  done
}

post_upgrade() {
  # 1.20.0-1 and older used a transaction hook instead of these units.
  if (( $(vercmp "$2" '1.20.0-1') <= 0 )); then
    post_install
  fi
}
