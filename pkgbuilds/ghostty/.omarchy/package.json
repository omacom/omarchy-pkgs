{
  "source": "local",
  "release_ring": "fast",
  "upstream": {
    "watch": {
      "pattern": "v(?P<version>[0-9]+(?:\\.[0-9]+)*)",
      "git_tags": "https://github.com/ghostty-org/ghostty.git"
    }
  },
  "artifacts": {
    "pkgbase": "ghostty",
    "packages": [
      "ghostty",
      "ghostty-shell-integration",
      "ghostty-terminfo",
      "ghostty-nautilus"
    ]
  }
}
