# Maintainer: The Omarchy Authors
# Upstream's standalone Linux release, run by Arch's nodejs instead of the
# Node it bundles. Its native addons (node-pty, clipboard, audio capture) use
# N-API and its ripgrep and landlock helpers are static, so it does not care
# which Node or snapshot it runs on and can follow upstream on the fast ring.
pkgname=qwen-code
pkgver=0.29.0
pkgrel=1
pkgdesc="Open-source AI agent for the terminal, optimized for Qwen-Coder"
arch=('x86_64' 'aarch64')
url="https://github.com/QwenLM/qwen-code"
license=('Apache-2.0')
depends=('nodejs' 'glibc' 'gcc-libs')
optdepends=(
  'alsa-utils: voice dictation recording via arecord'
  'sox: voice dictation recording'
)
options=('!strip' '!debug')
source_x86_64=("qwen-code-${pkgver}-x86_64.tar.gz::https://github.com/QwenLM/qwen-code/releases/download/v${pkgver}/qwen-code-linux-x64.tar.gz")
source_aarch64=("qwen-code-${pkgver}-aarch64.tar.gz::https://github.com/QwenLM/qwen-code/releases/download/v${pkgver}/qwen-code-linux-arm64.tar.gz")
sha256sums_x86_64=('58dccc08819a263cf2845da9207fddbd8f36143e8d3ad071d1cc121a33971fd7')
sha256sums_aarch64=('fd655a12fdc1fb5964e229b7cef58d4e73246467672b95d5ae3b8425599f26e2')
noextract=("qwen-code-${pkgver}-${CARCH}.tar.gz")

package() {
  local _arch=x64
  if [[ $CARCH == "aarch64" ]]; then
    _arch=arm64
  fi

  # Only lib/: the bundled Node is replaced by Arch's, and the release's
  # manifest.json would make Qwen Code treat this as a self-updating install.
  install -dm755 "${pkgdir}/usr/lib/qwen-code" "${pkgdir}/usr/bin"
  bsdtar --no-same-owner --strip-components 2 -xf "qwen-code-${pkgver}-${CARCH}.tar.gz" \
    -C "${pkgdir}/usr/lib/qwen-code" qwen-code/lib

  # Keep only this machine's ripgrep and landlock helper.
  local _dir _name
  for _dir in "${pkgdir}"/usr/lib/qwen-code/vendor/{ripgrep,landlock-run}/*/; do
    _name=$(basename "$_dir")
    if [[ $_name != "${_arch}-linux" && $_name != "src" ]]; then
      rm -r "$_dir"
    fi
  done

  install -Dm644 "${pkgdir}/usr/lib/qwen-code/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # pacman updates this install, so Qwen Code's own update check would only
  # point at an updater that cannot replace it.
  cat >"${pkgdir}/usr/bin/qwen" <<'WRAPPER'
#!/bin/sh
export QWEN_CODE_SKIP_UPDATE_CHECK_ONCE=true
exec /usr/bin/node /usr/lib/qwen-code/cli-entry.js "$@"
WRAPPER
  chmod 755 "${pkgdir}/usr/bin/qwen"
}
