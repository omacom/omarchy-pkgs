# Maintainer: Muhammad Essam <muhammadessam@users.noreply.github.com>

pkgname=omascope
pkgver=0.1.0
pkgrel=1
pkgdesc='Keyboard-first process manager for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/muhammadessam/omascope'
license=('MIT')
depends=('quickshell' 'hicolor-icon-theme' 'omarchy')
makedepends=('cargo' 'gcc')
optdepends=('nvidia-utils: GPU utilisation and VRAM in the vitals strip')
options=('!debug')

source=("$pkgname-$pkgver.zip::$url/archive/refs/tags/v$pkgver.zip")
sha256sums=('175e351daacddae619244247c3652f5ced9508afa842f792de78b8dbfe3e7a90')

build() {
  cd "$pkgname-$pkgver"

  export CARGO_TARGET_DIR=build
  cargo build --release --locked --offline
}

check() {
  cd "$pkgname-$pkgver"

  export CARGO_TARGET_DIR=build
  cargo test --release --locked --offline
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 build/release/omascope "$pkgdir/usr/bin/omascope"

  # Quickshell serves the interface as a config directory, not a Qt resource.
  install -d "$pkgdir/usr/share/omascope/ui/i18n"
  install -Dm644 ui/*.qml -t "$pkgdir/usr/share/omascope/ui"
  install -Dm644 ui/i18n/*.json -t "$pkgdir/usr/share/omascope/ui/i18n"

  # qs.Commons and qs.Ui resolve inside the config root, so the shared shell
  # components are linked rather than copied.
  ln -sfn /usr/share/omarchy/shell/Commons "$pkgdir/usr/share/omascope/ui/Commons"
  ln -sfn /usr/share/omarchy/shell/Ui "$pkgdir/usr/share/omascope/ui/Ui"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 pkgbuild/omascope.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omascope.svg"
  install -Dm644 pkgbuild/omascope.desktop "$pkgdir/usr/share/applications/omascope.desktop"
}
