# Maintainer: The Omarchy Authors
pkgname=hunk
pkgver=0.25.0
pkgrel=1
pkgdesc="Review-first terminal diff viewer for agentic coders"
arch=('x86_64' 'aarch64')
url="https://hunk.dev"
license=('MIT')
depends=('glibc')
optdepends=('git: review working tree changes and history')
# The binary is a Bun executable with its JavaScript appended; stripping breaks it.
options=('!strip' '!debug')
source=("LICENSE-${pkgver}::https://raw.githubusercontent.com/modem-dev/hunk/v${pkgver}/LICENSE")
source_x86_64=("hunk-${pkgver}-x86_64.tar.gz::https://github.com/modem-dev/hunk/releases/download/v${pkgver}/hunkdiff-linux-x64.tar.gz")
source_aarch64=("hunk-${pkgver}-aarch64.tar.gz::https://github.com/modem-dev/hunk/releases/download/v${pkgver}/hunkdiff-linux-arm64.tar.gz")
sha256sums=('83fee01b5d874e1a0f57be868acdb90167b15963cebc2c9b9b75a27af063f3e6')
sha256sums_x86_64=('fc3301151a9b35400b0223d73041cea85fb18972d6dc5c97a2bbdc427fad2afe')
sha256sums_aarch64=('12cf4a38ae1df282dee29fffe539134dd6943d667253a11c23b1d9ec249f1d88')

package() {
  local _dir
  if [[ $CARCH == "aarch64" ]]; then
    _dir="${srcdir}/hunkdiff-linux-arm64"
  else
    _dir="${srcdir}/hunkdiff-linux-x64"
  fi

  # Hunk reads its bundled agent skills from beside the binary.
  install -Dm755 "${_dir}/hunk" "${pkgdir}/usr/lib/hunk/hunk"
  cp -r --no-preserve=ownership "${_dir}/skills" "${pkgdir}/usr/lib/hunk/skills"
  install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  "${_dir}/hunk" completion bash | install -Dm644 /dev/stdin "${pkgdir}/usr/share/bash-completion/completions/hunk"
  "${_dir}/hunk" completion zsh | install -Dm644 /dev/stdin "${pkgdir}/usr/share/zsh/site-functions/_hunk"

  # Hunk recognises a pacman install only from this variable. With it, Hunk
  # skips its startup release check and `hunk update` points at pacman.
  install -dm755 "${pkgdir}/usr/bin"
  cat >"${pkgdir}/usr/bin/hunk" <<'WRAPPER'
#!/bin/bash
export HUNK_INSTALL_SOURCE=pacman
exec /usr/lib/hunk/hunk "$@"
WRAPPER
  chmod 755 "${pkgdir}/usr/bin/hunk"
}
