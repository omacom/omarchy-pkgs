pkgname=ttf-vazirmatn-nl
pkgver=33.003
pkgrel=1
pkgdesc="Persian/Arabic Vazirmatn font, without Latin glyphs"
arch=("any")
url="https://github.com/rastikerdar/vazirmatn"
license=("OFL-1.1")
source=("vazirmatn-v${pkgver}.zip::${url}/releases/download/v${pkgver}/vazirmatn-v${pkgver}.zip")
sha256sums=('0a9afd41967e6f57096a56a181a23f81a2b999b62f1f2a4e4b26736580854fdb')

package() {
  install -Dm644 misc/Non-Latin/fonts/ttf/*.ttf -t "$pkgdir/usr/share/fonts/vazirmatn-nl"
  install -Dm644 OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  install -Dm644 AUTHORS.txt "$pkgdir/usr/share/doc/$pkgname/AUTHORS.txt"
}
