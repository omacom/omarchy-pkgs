# The icon and desktop caches are refreshed by Arch's pacman hooks
# (gtk-update-icon-cache, update-desktop-database); only the MIME database
# is refreshed here.
_refresh_caches() {
  update-mime-database usr/share/mime >/dev/null 2>&1 || true
}

_skill_hint() {
  echo '==> To give Claude Code the Omasheet skill: mkdir -p ~/.claude/skills && ln -sfn /usr/share/omasheet/agent-skill/omasheet ~/.claude/skills/omasheet'
}

post_install() {
  _refresh_caches
  _skill_hint
}

post_upgrade() {
  _refresh_caches
  _skill_hint
}

post_remove() {
  _refresh_caches
}
