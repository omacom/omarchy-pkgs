_refresh_caches() {
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor >/dev/null 2>&1 || true
  update-mime-database usr/share/mime >/dev/null 2>&1 || true
  update-desktop-database -q >/dev/null 2>&1 || true
}

_skill_hint() {
  echo '==> To give Claude Code the Omasheet skill: ln -sfn /usr/share/omasheet/agent-skill/omasheet ~/.claude/skills/omasheet'
}

post_install() {
  _refresh_caches
  _skill_hint
}

post_upgrade() {
  _refresh_caches
  _skill_hint
}

post_remove() {
  _refresh_caches
}
