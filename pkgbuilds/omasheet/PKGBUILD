# Maintainer: Stephen Roe <stephen.john.roe@gmail.com>

pkgname=omasheet
pkgver=0.1.0
pkgrel=1
pkgdesc='Text-native spreadsheet: plain-text .omx sheets, with a Qt Quick app'
arch=('x86_64' 'aarch64')
url='https://github.com/librasteve/omasheet'
license=('MIT')
install='omasheet.install'
# The C++ of the Qt bridge is linked by rustc, which cannot read GCC's LTO.
options=('!debug' '!lto')
depends=(
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'xdg-desktop-portal'
)
makedepends=(
  'cargo'
  'gcc'
  'lld'
  'qt6-base'
  'qt6-declarative'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/librasteve/omasheet/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('85ef2f3814565cf6e24008eb48742a5a8a674d137d8296834886ece90803bbe4')

prepare() {
  cd "$srcdir/$pkgname-$pkgver"

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$srcdir/$pkgname-$pkgver"

  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The headers of the Qt bridge name themselves by full path in the binary.
  export CFLAGS+=" -ffile-prefix-map=$srcdir=/usr/src/$pkgname"
  export CXXFLAGS+=" -ffile-prefix-map=$srcdir=/usr/src/$pkgname"
  cargo build --frozen --release --package omasheet-ui
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 target/release/omasheet "$pkgdir/usr/bin/omasheet"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/omasheet.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omasheet.svg"
  install -Dm644 pkgbuild/omasheet.desktop "$pkgdir/usr/share/applications/omasheet.desktop"
  install -Dm644 pkgbuild/omasheet.xml "$pkgdir/usr/share/mime/packages/omasheet.xml"
}
