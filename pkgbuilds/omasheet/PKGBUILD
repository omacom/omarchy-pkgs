# Maintainer: Stephen Roe <stephen.john.roe@gmail.com>

# The recipe for omacom-io/omarchy-pkgs: it builds the tagged source archive,
# where ../PKGBUILD builds the checkout it is in. Keep the two alike.

pkgname=omasheet
pkgver=0.1.8
pkgrel=1
pkgdesc='Text-native spreadsheet: plain-text .omx files, with a Qt Quick app'
arch=('x86_64' 'aarch64')
url='https://github.com/librasteve/omasheet'
license=('MIT')
install='omasheet.install'
# The C++ of the Qt bridge is linked by rustc, which cannot read GCC's LTO.
options=('!debug' '!lto')
# The QML is compiled against the Qt it is built with, and does not start on
# an older one: so the package needs at least the Qt that is here when it is
# made. Before that Qt is installed, to build with, any will do.
_at_least() {
  local built
  built=$(pacman -Q "$1" 2>/dev/null | cut -d' ' -f2)
  if [[ -n $built ]]; then
    printf '%s>=%s' "$1" "${built%-*}"
  else
    printf '%s' "$1"
  fi
}
depends=(
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
  "$(_at_least qt6-base)"
  "$(_at_least qt6-declarative)"
  'xdg-desktop-portal'
)
makedepends=(
  'cargo'
  'gcc'
  'lld'
  'qt6-base'
  'qt6-declarative'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c52f98eadbb4f339a1c250e0d42c675c5aaf33d010569695c7511ed7f14c2b9d')

prepare() {
  cd "$srcdir/$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # Cargo.lock pins a crate whose compatible releases are all yanked, so
  # only the locked version can be had: `--locked` here, `--frozen` below.
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # The size levers live here and not in Cargo.toml, so that a working build
  # stays quick: fat LTO and a single codegen unit fold the Polars generics
  # that most of the binary is, and `panic = abort` drops the unwind tables.
  # `opt-level` stays at 3, as "s" would cost Polars its hot loops. This LTO
  # is Rust's own, and not the `!lto` above.
  CARGO_PROFILE_RELEASE_STRIP=true \
  CARGO_PROFILE_RELEASE_LTO=fat \
  CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 \
  CARGO_PROFILE_RELEASE_PANIC=abort \
    cargo build --release --frozen --package omasheet-ui
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 target/release/omasheet "$pkgdir/usr/bin/omasheet"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/omasheet.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omasheet.svg"
  install -Dm644 pkgbuild/omasheet.desktop "$pkgdir/usr/share/applications/omasheet.desktop"
  install -Dm644 pkgbuild/omasheet.xml "$pkgdir/usr/share/mime/packages/omasheet.xml"
  install -Dm644 skill/omasheet/SKILL.md "$pkgdir/usr/share/omasheet/agent-skill/omasheet/SKILL.md"
}
