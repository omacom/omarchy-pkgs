# aarch64-only build: Arch Linux ARM builds qemu without the static user-mode
# binaries, so the Omarchy default set (qemu-user-static-binfmt, used for
# foreign-architecture containers) builds them here, with Arch's static
# configure options, from the upstream release. On x86_64 both packages come
# from the Arch extra repository.
#
# 1002 is upstream qemu 586284af4c2c (in 11.2): sigcontext.trapno carries the
# real trap number instead of -1, which SQL Server 2022 needs to grow its
# thread stacks. Drop it on 11.2.
#
# 1001 passes Linux AIO (io_setup and friends) through to the host for 64-bit
# guests of the host's endianness, after checking every pointer against
# guest memory.
pkgbase=qemu-user-static
pkgname=('qemu-user-static' 'qemu-user-static-binfmt')
# The epoch of the earlier Debian repackaging (1:1.11.1.2+ds.3) stays, so
# upstream versions sort above it.
epoch=1
pkgver=11.1.3
pkgrel=1
pkgdesc="A generic and open source machine emulator and virtualizer - static user-mode emulation"
arch=('aarch64')
url="https://www.qemu.org"
license=('GPL-2.0-only' 'LGPL-2.1-only')
makedepends=('glib2' 'glib2-devel' 'meson' 'ninja' 'pcre2' 'python' 'zlib-static')
source=("https://download.qemu.org/qemu-$pkgver.tar.xz"
        "1001-linux-user-pass-Linux-AIO-through-to-the-host.patch"
        "1002-linux-user-i386-report-the-real-trap-number-in-sigcontext.patch"
        "qemu-binfmt-conf.sh")
# The tarball's detached signature verifies with Michael Roth's key
# CEACC9E15534EBABB82D3FA03353C9CEF108B584, as Arch's qemu recipe pins it; the
# checksum is the integrity check here.
sha256sums=('5a8289c7940dc77d3873c81a6c29ba3afe1446fc9d36e77fa1658cdbecb84b22'
            'd39341b96554f14b4ef9d5146d691b81050da1b1d1910ab0db5b16d7b4a48061'
            'ea2a082d0c096dea17722701560caf8f186181a04dee5f0ba6e9903190fdd246'
            '5e12ef484b8364e1ba7bae4acda837d2e6320ffbeb7fab341034124553cdb137')

prepare() {
  cd "qemu-$pkgver"
  local patch
  for patch in "$srcdir"/10*.patch; do
    patch -Np1 -i "$patch"
  done
}

build() {
  # Arch's qemu-user-static options.
  local options=(
    --prefix=/usr
    --sysconfdir=/etc
    --libexecdir=/usr/lib/qemu
    --localstatedir=/var
    --docdir=/usr/share/doc/qemu
    --enable-attr
    --enable-linux-user
    --enable-tcg
    --disable-bpf
    --disable-bsd-user
    --disable-capstone
    --disable-docs
    --disable-fdt
    --disable-gcrypt
    --disable-gnutls
    --disable-gtk
    --disable-install-blobs
    --disable-kvm
    --disable-libiscsi
    --disable-libnfs
    --disable-libssh
    --disable-linux-io-uring
    --disable-nettle
    --disable-opengl
    --disable-qom-cast-debug
    --disable-sdl
    --disable-system
    --disable-tools
    --disable-tpm
    --disable-vde
    --disable-vhost-crypto
    --disable-vhost-kernel
    --disable-vhost-net
    --disable-vhost-user
    --disable-vnc
    --disable-werror
    --disable-xen
    --disable-zstd
    --static
  )
  mkdir -p build-static
  cd build-static
  "../qemu-$pkgver/configure" "${options[@]}"
  ninja
}

package_qemu-user-static() {
  pkgdesc="A generic and open source machine emulator and virtualizer - static user-mode emulation"
  depends=('glibc')
  optdepends=('qemu-user-static-binfmt: binary format rules for foreign-architecture binaries')
  provides=('qemu-user-static')
  conflicts=('qemu-user-static-bin')

  install -dm755 "$pkgdir/usr/bin"
  local binary alias
  for binary in build-static/qemu-*; do
    [[ -f $binary && -x $binary ]] || continue
    install -Dm755 "$binary" "$pkgdir/usr/bin/$(basename "$binary")-static"
  done
  # The Debian architecture names the earlier package shipped.
  for alias in amd64:x86_64 arm64:aarch64 armel:arm armhf:arm loong64:loongarch64 \
               powerpc:ppc ppc64el:ppc64le; do
    ln -s "qemu-${alias#*:}-static" "$pkgdir/usr/bin/qemu-${alias%%:*}-static"
  done
  install -Dm644 "qemu-$pkgver"/{COPYING,COPYING.LIB,LICENSE} -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_qemu-user-static-binfmt() {
  pkgdesc="Binary format rules for the static QEMU user-mode emulators"
  depends=('qemu-user-static')
  provides=('qemu-user-binfmt-provider')
  conflicts=('qemu-user-binfmt-provider' 'binfmt-qemu-static')

  install -dm755 "$pkgdir/usr/lib/binfmt.d"
  # HOST_ARCH keeps the native architecture out of the rule set regardless
  # of the build host, so the package is identical under native and QEMU builds.
  # --ignore-family keeps 32-bit ARM: the script groups it with aarch64, but
  # Apple Silicon cannot execute AArch32 natively.
  HOST_ARCH=aarch64 sh "$srcdir/qemu-binfmt-conf.sh" \
    --systemd ALL \
    --exportdir "$pkgdir/usr/lib/binfmt.d/" \
    --qemu-path /usr/bin \
    --qemu-suffix -static \
    --persistent yes \
    --preserve-argv0 yes \
    --ignore-family yes
  local conf interpreter
  for conf in "$pkgdir"/usr/lib/binfmt.d/*.conf; do
    mv "$conf" "${conf%.conf}-static.conf"
    # Every rule must name an emulator that qemu-user-static ships.
    interpreter=$(sed -nE 's|.*:/usr/bin/(qemu-[^:/]+)-static:[A-Z]*$|\1|p' "${conf%.conf}-static.conf")
    [[ -n $interpreter && -x $srcdir/build-static/$interpreter ]] ||
      { echo "${conf##*/}: no static emulator for '$interpreter'" >&2; return 1; }
  done
}
