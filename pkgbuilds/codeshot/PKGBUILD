# Maintainer: Volker Schwaberow <volker@schwaberow.de>

pkgname=codeshot
pkgver=0.1.0
pkgrel=1
pkgdesc='Turn code into a shareable image'
arch=('x86_64' 'aarch64')
url='https://github.com/vschwaberow/codeshot'
license=('MIT')
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
  'wl-clipboard'
)
makedepends=(
  'gcc'
  'make'
  'qt6-base'
  'qt6-declarative'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('6ffa45729570a09e524ba13e32545705738b7763b0a1043d0db6db161380f4f6')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/codeshot "$pkgdir/usr/bin/codeshot"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/codeshot.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/codeshot.svg"
  install -Dm644 pkgbuild/codeshot.desktop "$pkgdir/usr/share/applications/codeshot.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
