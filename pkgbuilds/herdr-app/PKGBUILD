# Maintainer: John Kopanas <john@kopanas.com>

pkgname=herdr-app
pkgver=0.1.7
pkgrel=1
pkgdesc="Desktop app for terminals and coding agents, running on herdr-core"
arch=('x86_64' 'aarch64')
url="https://github.com/herdrdev/herdr-app"
license=('Apache-2.0')
# libxcb and libxkbcommon are linked. GPUI opens libwayland-client, libvulkan
# and libEGL at run time, so namcap calls wayland and vulkan-icd-loader
# unneeded; they are.
depends=('gcc-libs' 'glibc' 'herdr-core>=0.1.11' 'hicolor-icon-theme'
         'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'vulkan-icd-loader' 'wayland')
# A Vulkan ICD is needed to draw, but as a hard dependency makepkg -s would
# resolve it to nvidia-utils in the build container; Omarchy installs the
# right driver per machine.
optdepends=('vulkan-driver: GPU rendering (any Vulkan ICD, vulkan-swrast in software)'
            'libglvnd: OpenGL ES rendering through EGL when Vulkan is unavailable')
# The vendor's binary ships byte-exact, like the vendor's own installer.
options=('!strip' '!debug')
# Releases are published on releases.herdr.dev, not as GitHub release
# assets; the tags on GitHub carry the source. .omarchy/package.json watches
# the vendor's manifest, which is what the vendor's own installer reads.
_releases="https://releases.herdr.dev/app/$pkgver"
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/herdrdev/herdr-app/v$pkgver/LICENSE"
        "herdr-app.desktop")
source_x86_64=("herdr-app-$pkgver-linux-x86_64.tar.gz::$_releases/herdr-app-linux-x86_64.tar.gz")
source_aarch64=("herdr-app-$pkgver-linux-aarch64.tar.gz::$_releases/herdr-app-linux-aarch64.tar.gz")
sha256sums=('c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4'
            'ddaa11ae7bce621700190267e38e9545276ed70061fc11d8e978426a515b59b2')
sha256sums_x86_64=('7678f9706552220047eb51ed1c781cef9495eab69dbff19e7b8952a1d096802e')
sha256sums_aarch64=('f170b2600a1abdf04bce81c066704db86282e98cfbe38797ce3bedc1e0d9dfd6')

package() {
  # The app updates itself when herdr-app.svg sits beside its binary (that is
  # how it recognises the vendor's ~/.local/share/herdr-app install), and it
  # would fail trying under /usr. The binary goes to /usr/bin on its own and
  # the icon to the icon theme, so the app leaves updates to pacman.
  install -Dm755 "$srcdir/herdr-app/herdr-app" "$pkgdir/usr/bin/herdr-app"
  install -Dm644 "$srcdir/herdr-app/herdr-app.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/herdr-app.svg"
  install -Dm644 "$srcdir/herdr-app.desktop" "$pkgdir/usr/share/applications/herdr-app.desktop"
  install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
