# Maintainer: Shawn Yeager <shawn@upshiftco.com>

pkgname=herdr-app
pkgver=0.1.9
pkgrel=1
pkgdesc="Herdr desktop app: terminals and coding agents that keep running"
arch=('x86_64' 'aarch64')
url="https://github.com/herdrdev/herdr-app"
license=('Apache-2.0')
# The oldest core this app works with is upstream's distribution/core-version.
depends=('herdr-core>=0.1.11' 'fontconfig' 'glibc' 'libgcc' 'libxcb' 'libxkbcommon'
         'libxkbcommon-x11' 'vulkan-driver' 'vulkan-icd-loader' 'wayland')
makedepends=('cargo' 'clang' 'git')
options=('!debug' '!lto')

_zigver=0.16.0
source=("$pkgname::git+$url.git#tag=v$pkgver"
        "herdr-app.desktop")
source_x86_64=("zig-x86_64-linux-$_zigver.tar.xz::https://ziglang.org/download/$_zigver/zig-x86_64-linux-$_zigver.tar.xz")
source_aarch64=("zig-aarch64-linux-$_zigver.tar.xz::https://ziglang.org/download/$_zigver/zig-aarch64-linux-$_zigver.tar.xz")
sha256sums=('ee1828381066ad498797115d8bb6e03433a41e13a8a2fd3ae4d2e7de9f40698b'
            '2cc1199525a1bac6364a7397363f96a00db3faaf51aea049f9d4a7f694ef885a')
sha256sums_x86_64=('70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00')
sha256sums_aarch64=('ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17')

prepare() {
  cd "$pkgname"

  # libghostty-vt, at the commit the tag records.
  git submodule update --init --depth 1 vendor/ghostty
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname"

  # Leave HERDR_APP_RELEASE unset: release builds update themselves and send
  # telemetry; pacman owns this one.
  export CARGO_TARGET_DIR=target
  export ZIG="$srcdir/zig-$CARCH-linux-$_zigver/zig"
  export ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-cache"
  cargo build --frozen --release
}

package() {
  cd "$pkgname"

  install -Dm755 target/release/herdr-app "$pkgdir/usr/bin/herdr-app"
  install -Dm644 "$srcdir/herdr-app.desktop" "$pkgdir/usr/share/applications/herdr-app.desktop"
  install -Dm644 assets/icons/herdr-ui-icon-clean.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/herdr-app.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD-PARTY-NOTICES "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES"
}
