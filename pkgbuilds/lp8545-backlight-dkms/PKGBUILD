# Maintainer: MarkPronkin <109197080+MarkPronkin@users.noreply.github.com>
pkgname=lp8545-backlight-dkms
pkgver=1.1
pkgrel=2
pkgdesc='TI LP8545 backlight for MacBookPro8,2 with a disabled AMD GPU'
arch=(x86_64)
url='https://github.com/omacom/omarchy'
license=(GPL-2.0-only)
depends=(dkms)
checkdepends=(fakeroot linux-omarchy-headers)
source=(lp8545_bl.c Makefile dkms.conf lp8545-backlight.conf)
sha256sums=('d15959b2cac7daf3b925b9edb36a4d9759e68daf1a448d9823c22385af05af29'
            '8f3cb94d80b774edfdb03bc6ad4c9e5ee14f5736b40697773d6e950b0d614ac4'
            'a19f41bd643714c2abf41f0c6ca25fb850abbd51ed39046761b8a611bf1cf906'
            'b0c8814714878b38f8d247040909b6d52ebb0c4f3f0602bc0efae46f855c91f1')

check() {
  local build=(/usr/lib/modules/*/build)
  if [[ ! -d ${build[0]} ]]; then
    echo "Matching kernel headers are required for the DKMS build check" >&2
    return 1
  fi
  local kver=${build[0]%/build}
  kver=${kver##*/}
  rm -rf "$srcdir/check" "$srcdir/check-source"
  mkdir -p "$srcdir/check/dkms" "$srcdir/check/src"
  _install_source "$srcdir/check-source/lp8545-backlight-$pkgver"
  local dkms_options=(--dkmstree "$srcdir/check/dkms" --sourcetree "$srcdir/check/src" -k "$kver")
  fakeroot dkms "${dkms_options[@]}" add "$srcdir/check-source/lp8545-backlight-$pkgver"
  fakeroot dkms "${dkms_options[@]}" build "lp8545-backlight/$pkgver"
}

package() {
  _install_source "$pkgdir/usr/src/lp8545-backlight-$pkgver"
  install -Dm644 "$srcdir/lp8545-backlight.conf" "$pkgdir/usr/lib/modules-load.d/lp8545-backlight.conf"
}

_install_source() {
  install -Dm644 -t "$1" "$srcdir"/{lp8545_bl.c,Makefile,dkms.conf}
}
