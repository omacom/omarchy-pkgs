# Maintainer: Shawn Yeager <shawn@upshiftco.com>

pkgname=herdr-core
pkgver=0.1.14
pkgrel=1
pkgdesc="Herdr core (hc): the server that keeps Herdr terminals and coding agents running"
arch=('x86_64' 'aarch64')
url="https://github.com/herdrdev/herdr-core"
license=('Apache-2.0')
depends=('glibc' 'libgcc')
makedepends=('cargo' 'git')
# The AUR's prebuilt packages install the same files.
conflicts=('hc-bin' 'herdr-core-bin')
options=('!debug' '!lto')

_zigver=0.16.0
source=("$pkgname::git+$url.git#tag=v$pkgver")
source_x86_64=("zig-x86_64-linux-$_zigver.tar.xz::https://ziglang.org/download/$_zigver/zig-x86_64-linux-$_zigver.tar.xz")
source_aarch64=("zig-aarch64-linux-$_zigver.tar.xz::https://ziglang.org/download/$_zigver/zig-aarch64-linux-$_zigver.tar.xz")
sha256sums=('76b4bd1713f6c45593d6a9cf257675812d142d7153f3a524a93ff31d5c72149b')
sha256sums_x86_64=('70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00')
sha256sums_aarch64=('ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17')

prepare() {
  cd "$pkgname"

  # libghostty-vt, at the commit the tag records.
  git submodule update --init --depth 1 vendor/ghostty
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname"

  export CARGO_TARGET_DIR=target
  export ZIG="$srcdir/zig-$CARCH-linux-$_zigver/zig"
  export ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-cache"
  cargo build --frozen --release -p herdr-core
}

package() {
  cd "$pkgname"

  # A root-owned hc reports "system package manager" and never updates itself.
  install -Dm755 target/release/herdr-core "$pkgdir/usr/bin/herdr-core"
  ln -s herdr-core "$pkgdir/usr/bin/hc"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/notices" distribution/notices/*.txt
}
