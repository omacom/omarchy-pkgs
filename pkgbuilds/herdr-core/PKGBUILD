# Maintainer: John Kopanas <john@kopanas.com>

pkgname=herdr-core
pkgver=0.1.14
pkgrel=1
pkgdesc="Terminals for coding agents that keep running after you leave (hc)"
arch=('x86_64' 'aarch64')
url="https://github.com/herdrdev/herdr-core"
license=('Apache-2.0')
# The vendor's Linux build is a static binary, already stripped. It ships
# byte-exact: `hc update` swaps the file as a whole and compares versions.
options=('!strip' '!debug')
# Releases are published on releases.herdr.dev, not as GitHub release
# assets; the tags on GitHub carry the source. .omarchy/package.json watches
# the vendor's manifest, which is what the vendor's own installer reads.
_releases="https://releases.herdr.dev/core/$pkgver"
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/herdrdev/herdr-core/v$pkgver/LICENSE")
source_x86_64=("herdr-core-$pkgver-linux-x86_64.tar.gz::$_releases/herdr-core-linux-x86_64.tar.gz")
source_aarch64=("herdr-core-$pkgver-linux-aarch64.tar.gz::$_releases/herdr-core-linux-aarch64.tar.gz")
sha256sums=('c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4')
sha256sums_x86_64=('e9dbabdead0ce0ce3de51b6f54cc9549efedbb41b2f8448b6932ab0d1442343e')
sha256sums_aarch64=('19cef6a2e52f14c22c4b6f3fdaf1a462d2dafc78e8b03fabbfad5b063477a370')

package() {
  install -Dm755 "$srcdir/herdr-core" "$pkgdir/usr/bin/herdr-core"
  # The vendor's installer links `hc` beside herdr-core; the docs and the
  # agent skill use that name.
  ln -s herdr-core "$pkgdir/usr/bin/hc"
  install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
