# Maintainer: Jure Sršen <hoornet@users.noreply.github.com>
#
# Vega, built from the release tag. Upstream tags are immutable by policy (a
# bad release is superseded by a patch release, never re-tagged). The upstream
# watch in .omarchy/package.json brings each new tag here after a day's hold.

pkgname=vega-nostr
pkgver=0.16.4
pkgrel=1
pkgdesc='Nostr desktop client with long-form articles, Lightning zaps and podcasts'
arch=('x86_64' 'aarch64')
url='https://github.com/hoornet/vega'
license=('MIT')
# Linked directly (readelf -d): cairo, dbus (the keyring's Secret Service
# client), gdk-pixbuf2, glib2, glibc, gtk3, libgcc, libsoup3, webkit2gtk-4.1.
# libayatana-appindicator is dlopen'ed for the tray icon. The GStreamer
# plugins are what WebKit plays podcasts and video with: webkit2gtk-4.1
# depends on the GStreamer libraries only, and without the plugins media
# fails silently.
depends=(
  'cairo'
  'dbus'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gst-libav'
  'gst-plugins-base'
  'gst-plugins-good'
  'gtk3'
  'hicolor-icon-theme'
  'libayatana-appindicator'
  'libgcc'
  'libsoup3'
  'webkit2gtk-4.1'
)
optdepends=(
  'gnome-keyring: keeps the secret key across restarts (any Secret Service provider works)'
  'kwallet: Secret Service provider on KDE'
  'gst-plugins-bad: more audio and video formats'
)
makedepends=('cargo' 'nodejs' 'npm' 'pkgconf')
conflicts=('vega-nostr-git')
# Arch's GCC LTO objects cannot be consumed when crates compile bundled C
# libraries (secp256k1-sys, bundled SQLite). The debug info of a Rust binary
# with bundled C is a package nobody has asked for.
options=('!lto' '!debug')

_srcdir="vega-$pkgver"
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        'com.veganostr.Vega.desktop')
sha256sums=('befb2c5b7ceeb856b36251b0984f483e94f434f6743d76c968bf6f3446505acc'
            'd06f3de531f728567f973a75f862968473443db3c17525e5a2cad52bed929af2')

prepare() {
  cd "$_srcdir"

  # `npm ci --ignore-scripts`, never `npm install`: `install` re-resolves
  # inside the caret ranges, so a compromised patch release could reach the
  # build without appearing in the reviewed lockfile, and postinstall
  # scripts would run as the builder. This mirrors upstream's release.yml.
  npm ci --ignore-scripts --cache "$srcdir/npm-cache"

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu" \
    --manifest-path src-tauri/Cargo.toml
}

build() {
  cd "$_srcdir"

  # Tells the app who packaged it (upstream's install_info reads it at build
  # time, from v0.16.4): the update banner then names `sudo pacman -Syu`
  # instead of the AUR's development package.
  export VEGA_PACKAGED_BY=omarchy

  # The Tauri CLI runs `npm run build` (tsc + vite) first, then cargo with
  # the trailing arguments. --frozen: the lockfile is the resolution, and
  # nothing is fetched in build().
  npx tauri build --no-bundle -- --frozen
}

check() {
  cd "$_srcdir"

  npx vitest run
  # The feature the Tauri CLI builds with; without it cargo compiles the
  # crate a second time, for the dev server.
  cargo test --frozen --release --features tauri/custom-protocol \
    --manifest-path src-tauri/Cargo.toml
}

package() {
  cd "$_srcdir"

  install -Dm755 src-tauri/target/release/vega "$pkgdir/usr/bin/vega"

  install -Dm644 "$srcdir/com.veganostr.Vega.desktop" \
    "$pkgdir/usr/share/applications/com.veganostr.Vega.desktop"
  install -Dm644 flatpak/com.veganostr.Vega.metainfo.xml \
    "$pkgdir/usr/share/metainfo/com.veganostr.Vega.metainfo.xml"

  local icons=src-tauri/icons
  install -Dm644 "$icons/32x32.png" \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/com.veganostr.Vega.png"
  install -Dm644 "$icons/128x128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/com.veganostr.Vega.png"
  install -Dm644 "$icons/128x128@2x.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/com.veganostr.Vega.png"
  install -Dm644 "$icons/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/com.veganostr.Vega.png"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
