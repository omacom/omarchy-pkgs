# Maintainer: Abel Mulugeta Dagne <abel.mulugeta.dagne@gmail.com>

pkgname=pomo
pkgver=0.1.0
pkgrel=1
pkgdesc='Pomodoro timer built with Qt Quick that follows the Omarchy theme'
arch=('x86_64' 'aarch64')
url='https://github.com/abelgroot/pomo'
license=('MIT')
install='pomo.install'
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'libnotify'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
)
makedepends=(
  'gcc'
  'make'
  'qt6-base'
  'qt6-declarative'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/abelgroot/pomo/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('4d32a3443383522ad16c749fb66611737e2fd3607863e8c9626e726f691ae1ef')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/pomo "$pkgdir/usr/bin/pomo"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/pomo.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/pomo.svg"
  install -Dm644 pkgbuild/pomo.desktop "$pkgdir/usr/share/applications/pomo.desktop"
}
