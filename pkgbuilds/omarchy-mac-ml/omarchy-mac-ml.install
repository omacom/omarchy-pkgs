post_install() {
  cat <<'MSG'
The offline voice assistant is installed but not started.

  1. Download the pinned models once (the only network step):
       omarchy-voice-setup            # or: omarchy-voice-setup quality
  2. Run it by hand, or at login:
       omarchy-voice --wake-word
       systemctl --user enable --now omarchy-voice.service
MSG
}
post_upgrade() {
  post_install
}
