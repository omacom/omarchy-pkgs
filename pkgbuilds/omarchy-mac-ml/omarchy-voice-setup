#!/usr/bin/env bash
# One-time model download for the offline voice assistant. This is the ONLY
# step that needs a network: it approves and fetches the pinned pair
# (chat model + Parakeet STT + openWakeWord + Kokoro voices) into the user
# data home and writes assistant/prefetch-manifest.json — a sha256 record of
# every fetched file. After it completes, `omarchy-voice` and the login
# service run fully offline; nothing on the serve path fetches.
set -euo pipefail
PAIR="${1:-everyday}"
case "$PAIR" in everyday|quality|compact) ;;
  *) echo "usage: omarchy-voice-setup [everyday|quality|compact]" >&2; exit 2;;
esac
exec /usr/lib/omarchy-mlx/venv/bin/python -m mlx_omarchy_assistant.prefetch \
  --pair "$PAIR" --wake-word
