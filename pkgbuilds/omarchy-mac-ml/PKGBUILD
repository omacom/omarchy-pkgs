# Maintainer: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>

pkgname=omarchy-mac-ml
pkgver=1
pkgrel=2
pkgdesc='MLX on the GPU and Core ML models on the Neural Engine for Apple Silicon Macs'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/omacom/omarchy-pkgs'
license=('MIT')
depends=('omarchy-mlx' 'omarchy-mlx-vulkan' 'omarchy-ane-dkms' 'mil-hwx-compiler'
         'speakerguardd')
install=omarchy-mac-ml.install
source=(omarchy-voice omarchy-voice-setup omarchy-voice.service)
sha256sums=('b988c8439ed40b2b884a521ae6aca48651b64acddd4f3772d86f5e92e02dc117'
            'ac29ee6d77399424fa41282418a27eb2c081f37e6b2716c267ebfc54fac146d6'
            'a134cb3ce2bb91282e94ea35f74edd98285c61877d7a72e80f3f171b12920805')

package() {
  # Launcher + explicit model-download step. Both run the assistant from the
  # omarchy-mlx system venv at /usr/lib/omarchy-mlx/venv; this package ships no
  # models — omarchy-voice-setup is the only step that needs a network.
  install -Dm755 omarchy-voice "$pkgdir/usr/bin/omarchy-voice"
  install -Dm755 omarchy-voice-setup "$pkgdir/usr/bin/omarchy-voice-setup"
  # systemd --user unit; staged, never enabled by the package.
  install -Dm644 omarchy-voice.service "$pkgdir/usr/lib/systemd/user/omarchy-voice.service"
}
