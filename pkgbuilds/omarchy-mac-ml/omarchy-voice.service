[Unit]
Description=Omarchy offline voice assistant (wake word -> STT -> local model -> TTS)
After=sound.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/omarchy-voice --wake-word --resume --no-browser
Restart=on-failure
RestartSec=5
# Service logs go to their own journal namespace:
# journalctl --user --namespace omarchy-voice
LogNamespace=omarchy-voice

# Sandboxing. The assistant needs PipeWire (AF_UNIX), its loopback model
# server (AF_INET/AF_INET6), netlink for the socket stack, and two
# writable dirs: the data home (pair homes, state) and the cache the
# prefetch step fills. Everything else is closed off.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.local/share/mlx-omarchy %h/.cache
ProtectClock=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
