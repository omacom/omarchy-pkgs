#!/usr/bin/env bash
# Offline voice assistant: wake word -> VAD -> Parakeet STT -> local LLM -> Kokoro TTS.
# Runs entirely in the omarchy-mlx system venv; models live in the user data
# home after `omarchy-voice-setup` (they are not shipped in this package).
exec /usr/lib/omarchy-mlx/venv/bin/python -m mlx_omarchy_assistant "$@"
