#!/usr/bin/env bash
# omarchy:group=mlx
# omarchy:name=voice
# omarchy:summary=Offline voice assistant (wake word -> STT -> local model -> TTS)
# omarchy:args=[--wake-word [WORD]] [--pair everyday|quality|compact] [--resume] [--no-browser]
# omarchy:examples=omarchy-voice --wake-word | omarchy-voice
# Offline voice assistant: wake word -> VAD -> Parakeet STT -> local MLX model
# -> Kokoro TTS. Runs entirely in the omarchy-mlx system venv; models live in
# the user data home after `omarchy-voice-setup` and are never shipped by a
# package.
exec /usr/lib/omarchy-mlx/venv/bin/python -m mlx_omarchy_assistant "$@"
