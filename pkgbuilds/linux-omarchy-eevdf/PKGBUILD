pkgbase=linux-omarchy-eevdf
pkgver=7.3.6
pkgrel=3
# NVIDIA's open kernel modules ship prebuilt as $pkgbase-nvidia-open, built in
# this recipe so every kernel lands with modules for it and nobody compiles
# them through DKMS on a kernel update. Keep this version in step with
# nvidia-utils, lib32-nvidia-utils and nvidia-open-dkms.
_nvidiaver=620.73.04
_nvidia=NVIDIA-kernel-module-source-$_nvidiaver
# Intel IPU7 camera and v4l2loopback modules ship prebuilt as $pkgbase-ipu7 and
# $pkgbase-v4l2loopback so Panther Lake laptops avoid DKMS compilation on
# install and kernel updates. Keep _ipu7_drivers_commit and ipu7-*.patch in
# step with intel-ipu7-camera (checked by tests/ipu7-lockstep.sh).
_ipu7ver=1.0.6
_ipu7_drivers_commit=a88b19096a738d0708742a78d6540d6d4a3021ff
_ipu7=ipu7-drivers-$_ipu7_drivers_commit
_v4l2loopbackver=0.15.4
_v4l2loopback=v4l2loopback-$_v4l2loopbackver
pkgdesc='Omarchy Linux'
url='https://omarchy.org'
