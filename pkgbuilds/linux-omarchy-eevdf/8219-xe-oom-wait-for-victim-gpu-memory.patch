+static void xe_file_update_oom_pid(struct drm_file *file, unsigned int cmd)
+{
+	struct xe_file *xef = file->driver_priv;
+	struct pid *pid = task_tgid(current);
+
+	if (DRM_IOCTL_NR(cmd) < DRM_COMMAND_BASE ||
+	    DRM_IOCTL_NR(cmd) >= DRM_COMMAND_END ||
+	    pid == READ_ONCE(xef->oom_pid))
+		return;
+
+	spin_lock(&xef->xe->oom.lock);
+	put_pid(xef->oom_pid);
+	WRITE_ONCE(xef->oom_pid, get_pid(pid));
+	spin_unlock(&xef->xe->oom.lock);
+}
+
 static long xe_drm_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
 {
 	struct drm_file *file_priv = file->private_data;
 	struct xe_device *xe = to_xe_device(file_priv->minor->dev);
 	long ret;
 
+	xe_file_update_oom_pid(file_priv, cmd);
+
 	if (xe_device_wedged(xe))
 		return -ECANCELED;
 
@@ -241,6 +271,8 @@ static long xe_drm_compat_ioctl(struct file *file, unsigned int cmd, unsigned lo
 	struct xe_device *xe = to_xe_device(file_priv->minor->dev);
 	long ret;
 
+	xe_file_update_oom_pid(file_priv, cmd);
+
 	if (xe_device_wedged(xe))
 		return -ECANCELED;
 
@@ -512,6 +544,61 @@ struct xe_device *xe_device_create(struct pci_dev *pdev)
 }
 ALLOW_ERROR_INJECTION(xe_device_create, ERRNO); /* See xe_pci_probe() */
 
+static int xe_device_oom_notify(struct notifier_block *nb, unsigned long event, void *data)
+{
+	struct xe_device *xe = container_of(nb, struct xe_device, oom.nb);
+	unsigned long *freed = data, now = jiffies;
+	struct xe_file *xef;
+
+	spin_lock(&xe->oom.lock);
+	list_for_each_entry(xef, &xe->oom.clients, oom_link) {
+		long pages = atomic_long_read(&xef->bound_pages);
+		struct task_struct *task;
+		bool exiting;
+
+		if (pages <= 0)
+			continue;
+
+		rcu_read_lock();
+		task = pid_task(xef->oom_pid, PIDTYPE_TGID);
+		exiting = task && tsk_is_oom_victim(task) &&
+			  mm_flags_test(MMF_OOM_SKIP, task->signal->oom_mm);
+		rcu_read_unlock();
+		if (!exiting)
+			continue;
+
+		if (!xef->oom_seen)
+			xef->oom_seen = now | 1;
+		if (time_before(now, xef->oom_seen + HZ))
+			*freed += pages;
+	}
+	spin_unlock(&xe->oom.lock);
+
+	return NOTIFY_OK;
+}
+
+static void xe_device_oom_fini(struct drm_device *drm, void *arg)
+{
+	struct xe_device *xe = arg;
+
+	unregister_oom_notifier(&xe->oom.nb);
+}
+
+int xe_device_oom_init(struct xe_device *xe)
+{
+	int err;
+
+	if (IS_DGFX(xe))
+		return 0;
+
+	xe->oom.nb.notifier_call = xe_device_oom_notify;
+	err = register_oom_notifier(&xe->oom.nb);
+	if (err)
+		return err;
+
+	return drmm_add_action_or_reset(&xe->drm, xe_device_oom_fini, xe);
+}
+
 /**
  * xe_device_init_early() - Initialize a new &xe_device instance
  * @xe: the &xe_device to initialize
@@ -538,6 +625,9 @@ int xe_device_init_early(struct xe_device *xe)
 	if (err)
 		return err;
 
+	spin_lock_init(&xe->oom.lock);
+	INIT_LIST_HEAD(&xe->oom.clients);
+
 	xe->atomic_svm_timeslice_ms = 5;
 	xe->min_run_period_lr_ms = 5;
 
