diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -5029,6 +5029,7 @@ static void reweight_task_fair(struct rq
 {
 	struct sched_entity *se = &p->se;
 	unsigned long weight = NICE_0_LOAD;
+	bool reweight_curr;
 
 	if (se->on_rq)
 		update_curr_fair(rq);
@@ -5039,10 +5040,15 @@ static void reweight_task_fair(struct rq
 	if (!se->on_rq)
 		return;
 
+	reweight_curr = parent_entity(se) && cfs_rq_of(se)->h_curr &&
+			se != rq->cfs.curr;
+
 	for_each_sched_entity(se)
 		weight = __calc_prop_weight(cfs_rq_of(se), se, weight);
 
 	reweight_eevdf(&rq->cfs, &p->se, weight, p->se.on_rq);
+	if (reweight_curr)
+		reweight_curr_eevdf(&rq->cfs);
 }
 
 static inline int throttled_hierarchy(struct cfs_rq *cfs_rq);
@@ -8330,7 +8336,8 @@ enqueue_task_fair(struct rq *rq, struct
 	hrtick_update(rq);
 }
 
-static void dequeue_hierarchy(struct task_struct *p, int flags)
+static void dequeue_hierarchy(struct task_struct *p, int flags,
+			      bool *reweight_curr)
 {
 	struct sched_entity *se = &p->se;
 	bool task_sleep = flags & DEQUEUE_SLEEP;
@@ -8369,6 +8376,9 @@ static void dequeue_hierarchy(struct tas
 		if (throttled_hierarchy(cfs_rq) && task_throttled)
 			record_throttle_clock(cfs_rq);
 
+		if (parent_entity(se) && cfs_rq->h_curr)
+			*reweight_curr = true;
+
 		flags |= DEQUEUE_SLEEP;
 		flags &= ~(DEQUEUE_DELAYED | DEQUEUE_SPECIAL);
 	}
@@ -8388,6 +8398,7 @@ static bool __dequeue_task(struct rq *rq
 	bool was_sched_idle = sched_idle_rq(rq);
 	bool task_sleep = flags & DEQUEUE_SLEEP;
 	bool task_delayed = flags & DEQUEUE_DELAYED;
+	bool reweight_curr = false;
 
 	clear_buddies(cfs_rq, se);
 
@@ -8415,14 +8426,17 @@ static bool __dequeue_task(struct rq *rq
 		}
 	}
 
-	dequeue_hierarchy(p, flags);
+	dequeue_hierarchy(p, flags, &reweight_curr);
 
 	if (sched_feat(PLACE_REL_DEADLINE) && !task_sleep) {
 		se->deadline -= se->vruntime;
 		se->rel_deadline = 1;
 	}
-	if (se != cfs_rq->curr)
+	if (se != cfs_rq->curr) {
 		__dequeue_entity(cfs_rq, se);
+		if (reweight_curr)
+			reweight_curr_eevdf(cfs_rq);
+	}
 
 	sub_nr_running(rq, 1);
 
