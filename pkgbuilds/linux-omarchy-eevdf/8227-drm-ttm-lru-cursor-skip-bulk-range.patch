diff --git a/drivers/gpu/drm/ttm/ttm_bo_util.c b/drivers/gpu/drm/ttm/ttm_bo_util.c
--- a/drivers/gpu/drm/ttm/ttm_bo_util.c
+++ b/drivers/gpu/drm/ttm/ttm_bo_util.c
@@ -1076,6 +1076,20 @@ struct ttm_buffer_object *ttm_bo_lru_cursor_first(struct ttm_bo_lru_cursor *curs
 }
 EXPORT_SYMBOL(ttm_bo_lru_cursor_first);
 
+void ttm_bo_lru_cursor_skip_bulk(struct ttm_bo_lru_cursor *curs)
+{
+	struct ttm_lru_bulk_move *bulk;
+	spinlock_t *lru_lock = &curs->res_curs.man->bdev->lru_lock;
+
+	dma_resv_assert_held(curs->bo->base.resv);
+	bulk = curs->bo->bulk_move;
+
+	spin_lock(lru_lock);
+	ttm_resource_cursor_skip_bulk(&curs->res_curs, bulk);
+	spin_unlock(lru_lock);
+}
+EXPORT_SYMBOL(ttm_bo_lru_cursor_skip_bulk);
+
