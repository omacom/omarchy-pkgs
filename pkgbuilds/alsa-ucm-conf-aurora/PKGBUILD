pkgname=alsa-ucm-conf-aurora
pkgver=10.aurora3
pkgrel=2
pkgdesc='Aurora Apple Silicon ALSA profiles including J700'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/aurora-silicon/alsa-ucm-conf-asahi'
license=('BSD-3-Clause')
_commit=b9b2d0c82cbb46025e586b2dc9f2cae644d29999
makedepends=('git')
depends=('alsa-ucm-conf')
provides=("alsa-ucm-conf-asahi=$pkgver" "alsa-ucm-conf-asahi-aurora=$pkgver")
conflicts=('alsa-ucm-conf-asahi' 'alsa-ucm-conf-asahi-aurora')
replaces=('alsa-ucm-conf-asahi-aurora')
source=(
  "ucm::git+$url.git#commit=$_commit"
  "cs42l84-k114-headphones.conf"
  "test-cs42l84-headset-ucm.sh"
  "m5-card1-mixer-names.fixture"
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

prepare() {
  # K114/cs42l84: macaudio driver uses *Capture Volume names; stock UCM used Gain/PGA shorts.
  install -Dm644 "$srcdir/cs42l84-k114-headphones.conf" \
    "$srcdir/ucm/ucm2/conf.d/macaudio/cs42l84/Headphones.conf"
}

package() {
  install -d "$pkgdir/usr/share/alsa"
  cp -a ucm/ucm2 "$pkgdir/usr/share/alsa/"
  install -Dm644 ucm/LICENSE.asahi "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm755 "$srcdir/test-cs42l84-headset-ucm.sh" \
    "$pkgdir/usr/share/doc/$pkgname/test-cs42l84-headset-ucm.sh"
  install -Dm644 "$srcdir/m5-card1-mixer-names.fixture" \
    "$pkgdir/usr/share/doc/$pkgname/m5-card1-mixer-names.fixture"
}
