  install -Dm644 'hp-sp174046/src/driver/regrouped_driver/qcnspmcdm_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1p42100/hp/elitebook-6-g1q/qccdsp8380.mbn'
  install -Dm644 'hp-sp174046/src/driver/regrouped_driver/qcdx8380/qcdxkmsucpurwa.mbn' "$fw"/'qcom/x1p42100/hp/elitebook-6-g1q/qcdxkmsucpurwa.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
