# Audio DSP, compute DSP and GPU firmware for the HP EliteBook 6 G1q. The firmware only runs if it
# is signed for this board by HP, so linux-firmware cannot carry it until the OEM submits it. The
# OEM ships it in its Windows driver download, which this recipe unpacks without running. The
# files are installed unmodified, under the names the device tree requests, and checked against
# the SHA-256 each was matched to.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=hp-elitebook-6-g1q-firmware
pkgver=20261102
pkgrel=1
pkgdesc='Audio DSP, compute DSP and GPU firmware for the HP EliteBook 6 G1q'
arch=('aarch64')
url='https://ftp.hp.com/pub/softpaq/sp174001-174500/sp174046.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1p42100-hp-elitebook-6-g1q')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'hp-sp174046.exe::https://ftp.hp.com/pub/softpaq/sp174001-174500/sp174046.exe'
)
noextract=('hp-sp174046.exe')
sha256sums=('f2ac41c45ae121ed8d14c532c018ac12e46c83c880c672f21d7a563786395723')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'hp-sp174046.exe' 'hp-sp174046' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'hp-sp174046/src/driver/regrouped_driver/qcsubsys_ext_adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1p42100/hp/elitebook-6-g1q/adsp_dtbs.elf'
  install -Dm644 'hp-sp174046/src/driver/regrouped_driver/qcsubsys_ext_adsp8380/adspr.jsn' "$fw"/'qcom/x1p42100/hp/elitebook-6-g1q/adspr.jsn'
  install -Dm644 'hp-sp174046/src/driver/regrouped_driver/qcsubsys_ext_adsp8380/adsps.jsn' "$fw"/'qcom/x1p42100/hp/elitebook-6-g1q/adsps.jsn'
  install -Dm644 'hp-sp174046/src/driver/regrouped_driver/qcsubsys_ext_adsp8380/adspua.jsn' "$fw"/'qcom/x1p42100/hp/elitebook-6-g1q/adspua.jsn'
  install -Dm644 'hp-sp174046/src/driver/regrouped_driver/qcsubsys_ext_adsp8380/battmgr.jsn' "$fw"/'qcom/x1p42100/hp/elitebook-6-g1q/battmgr.jsn'
  install -Dm644 'hp-sp174046/src/driver/regrouped_driver/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1p42100/hp/elitebook-6-g1q/cdsp_dtbs.elf'
