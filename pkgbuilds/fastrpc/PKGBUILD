# FastRPC: the CPU side of Qualcomm's remote procedure calls to the Hexagon DSPs (the audio DSP and
# the compute DSP, the "NPU"). The kernel driver (qcom,fastrpc) creates /dev/fastrpc-*; this package
# adds the libraries programs link to (libcdsprpc, libadsprpc, libsdsprpc), the rpcd daemons that
# serve file access and logs for each DSP's root process, the udev rule and sysusers group that let
# members of "fastrpc" open the nodes, and fastrpc_test / fastrpc-healthcheck.
#
# It carries no DSP-side code. A program on the compute DSP runs inside a process the library
# starts from fastrpc_shell_3 or fastrpc_shell_unsigned_3, which it reads from the directory a
# conf.d file under /usr/share/qcom names for this machine's device tree model (hexagon-dsp-binaries'
# layout), then /usr/lib/rfsa/adsp and /usr/lib/dsp. Those shells are Qualcomm binaries tied to the
# DSP firmware build and come from a firmware package, not from here.

pkgname=fastrpc
pkgver=1.0.9
pkgrel=2
pkgdesc='Qualcomm FastRPC libraries, DSP RPC daemons and test tools for Hexagon DSPs'
arch=('aarch64')
url='https://github.com/qualcomm/fastrpc'
license=('BSD-3-Clause')
depends=('acl' 'glibc' 'libbsd' 'libyaml')
makedepends=('autoconf' 'automake' 'libtool' 'systemd')
source=("$pkgname-$pkgver.tar.gz::https://github.com/qualcomm/fastrpc/archive/refs/tags/v$pkgver.tar.gz"
        'README.package.md'
        '0001-dspqueue-drive-Queue-Monitor-through-method-9.patch'
        '0002-dspqueue-async-Queue-Monitor-pump-and-exit-cancel.patch')
sha256sums=('127f729a9fd34cbcdcc254a93702442ebe309e826b7be68be2c1ba6efde113a1'
            'fcceb42421297f1cf9ae4b7234dbe2b909da38d8c728bcb03b50d1c58f758416'
            'da444ac8d21f87e7cc6cfedc108943b086368303f7138187e387e2b02c0a98f4'
            '2c3cd268e99df208ac39f52ee762950b26842fa9b68f76aef51c233ca8da8d5b')

prepare() {
  cd "$pkgname-$pkgver"
  # Upstream's rule starts adsprpcd_audiopd whenever /dev/fastrpc-adsp appears. That daemon asks
  # the audio DSP to create its static audio process in memory the kernel hands over; on boards
  # whose device tree does not reserve and protect that memory it resets the machine
  # (qualcomm/fastrpc#414, QRB2210), and Linux audio on Snapdragon laptops does not use the audio
  # process. Keep the unit for a manual start, but do not start it from udev.
  sed -i 's/, ENV{SYSTEMD_WANTS}+="adsprpcd_audiopd.service"//' files/60-fastrpc.rules
  if grep -q audiopd files/60-fastrpc.rules; then
    echo 'the audiopd line in 60-fastrpc.rules changed; update the sed above' >&2
    return 1
  fi

  # Some CDSP firmware builds (X1E80100 CDSP.HT.2.9.c1-00078, as on the Surface Laptop 7 and the
  # Galaxy Book4 Edge; X2 Elite CDSP.HT.3.3-00304) run dspqueues in "Queue Monitor" mode, made for
  # the Windows MCDM scheduler: the DSP consumes packets only inside a host-issued dspqueue_rpc
  # method 9 call, which upstream never makes, so llama.cpp's Hexagon backend hangs at its first
  # request (qualcomm/fastrpc#377, open; not in any release as of 1.0.9). 0001 adds that call,
  # 0002 moves it to a pump thread per queue (about 8x faster generation) and cancels the
  # receive-signal invoke at exit so a normal exit does not leak DSP mappings. Both are opt-in:
  # nothing changes unless the client's environment has DSPQUEUE_QUEUE_MONITOR=1 or 2.
  # Drop them when upstream ships a fix.
  patch -Np1 -i "$srcdir/0001-dspqueue-drive-Queue-Monitor-through-method-9.patch"
  patch -Np1 -i "$srcdir/0002-dspqueue-async-Queue-Monitor-pump-and-exit-cancel.patch"

  autoreconf -fi
}

build() {
  cd "$pkgname-$pkgver"
  ./configure \
    --prefix=/usr \
    --sbindir=/usr/bin \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --mandir=/usr/share/man \
    --with-systemdsystemunitdir=/usr/lib/systemd/system \
    --with-udevrulesdir=/usr/lib/udev/rules.d \
    --with-sysusersdir=/usr/lib/sysusers.d \
    --with-config-base-dir=/usr/share/qcom
  make
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
  # makepkg's strip reports "has no sections" for the six prebuilt Hexagon test skeletons in
  # /usr/share/fastrpc_test and leaves them unchanged; that is expected.

  # libtool archives are not shipped on Arch.
  find "$pkgdir" -name '*.la' -delete

  # The directory the library reads machine configuration from, even before any DSP package fills it.
  install -dm755 "$pkgdir"/usr/share/qcom/conf.d

  install -Dm644 LICENSE.txt "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
  install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README.md
  install -Dm644 "$srcdir"/README.package.md "$pkgdir"/usr/share/doc/$pkgname/README.package.md
}
