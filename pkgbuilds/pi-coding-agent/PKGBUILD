# Maintainer: The Omarchy Authors
pkgname=pi-coding-agent
pkgver=1.6.1
pkgrel=1
pkgdesc="Pi, a terminal coding agent that works with any model provider"
arch=('x86_64' 'aarch64')
url="https://pi.dev"
license=('MIT')
depends=('glibc')
# The binary is a Bun executable with its JavaScript appended; stripping breaks it.
options=('!strip' '!debug')
source=("LICENSE-${pkgver}::https://raw.githubusercontent.com/earendil-works/pi/v${pkgver}/LICENSE")
source_x86_64=("pi-${pkgver}-x86_64.tar.gz::https://github.com/earendil-works/pi/releases/download/v${pkgver}/pi-linux-x64.tar.gz")
source_aarch64=("pi-${pkgver}-aarch64.tar.gz::https://github.com/earendil-works/pi/releases/download/v${pkgver}/pi-linux-arm64.tar.gz")
sha256sums=('0457f5bcec3b3b211605dfb5d1a49042fd638f3686a410fe099c24a25af13c48')
sha256sums_x86_64=('3c7f00715eb512e165c0da8cad314d73c83b54d5bf7748be4adc618fc8357b68')
sha256sums_aarch64=('afde641d6c5904d26960ddb4223bf563b0860cf1a0ebc443b85deff67d048753')

package() {
  # Pi reads its themes, docs and native modules from beside the binary.
  install -dm755 "${pkgdir}/usr/lib" "${pkgdir}/usr/bin"
  cp -r --no-preserve=ownership "${srcdir}/pi" "${pkgdir}/usr/lib/pi-coding-agent"
  install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # pacman updates this install, so Pi's own check for a newer release would
  # only point at a `pi update` that cannot replace it.
  cat >"${pkgdir}/usr/bin/pi" <<'WRAPPER'
#!/bin/sh
export PI_SKIP_VERSION_CHECK=1
exec /usr/lib/pi-coding-agent/pi "$@"
WRAPPER
  chmod 755 "${pkgdir}/usr/bin/pi"
}
