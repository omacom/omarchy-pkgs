# Maintainer: Jon Iler <16842926+joniler@users.noreply.github.com>
# Upstream ships Linux binaries for x86_64 only (GitHub release .deb); an
# aarch64 build would have to compile from source.
pkgname=workspaced
pkgver=0.1.3
pkgrel=1
pkgdesc='Several Google Workspace accounts signed in at once, in one window'
arch=('x86_64')
url='https://github.com/outcrop-labs/workspaced'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'dbus')
source=("workspaced-${pkgver}.deb::https://github.com/outcrop-labs/workspaced/releases/download/workspaced-v${pkgver}/Workspaced_${pkgver}_amd64.deb"
        'workspaced.desktop'
        'LICENSE')
sha256sums=('b43e3f5825a88fe17c11f3b85a4cea82be675fcf097346a957fc20a4bbbf0ef3'
            'f8b4b7f194ab8baa32c32611dac3d8d19829a90b4c3490a49e1ad3078c2e77be'
            'a3b92bc611868e84e13d2c79ceba56e6b45e46b0dda63b73b68893e66986e1cd')

package() {
    cd "${srcdir}"

    # The .deb is an ar archive. Extract its payload with --no-same-owner:
    # pacman installs the owners an archive records, and every file in a
    # package must be owned by root.
    bsdtar -xOf "workspaced-${pkgver}.deb" data.tar.gz | bsdtar --no-same-owner -xf -

    install -Dm755 usr/bin/workspaced "${pkgdir}/usr/bin/workspaced"

    # The .deb parks its 256px png under 256x256@2, a context hicolor does
    # not read, so only 32 and 128 would ever resolve without this.
    install -Dm644 usr/share/icons/hicolor/32x32/apps/workspaced.png "${pkgdir}/usr/share/icons/hicolor/32x32/apps/workspaced.png"
    install -Dm644 usr/share/icons/hicolor/128x128/apps/workspaced.png "${pkgdir}/usr/share/icons/hicolor/128x128/apps/workspaced.png"
    install -Dm644 "usr/share/icons/hicolor/256x256@2/apps/workspaced.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/workspaced.png"

    install -Dm644 workspaced.desktop "${pkgdir}/usr/share/applications/workspaced.desktop"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
