# Maintainer: Ryan Hughes <ryan@heyoodle.com>

pkgname=omarchy-hyprland-titlebars
pkgver=0.2.2
pkgrel=1
pkgdesc="Titlebars for Omarchy's floating workspaces"
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/omarchy-hyprland-titlebars'
license=('BSD-3-Clause' 'MIT')
# A Hyprland plugin only loads into the exact Hyprland build it was compiled
# against. rebuild_on in .omarchy/package.json rebuilds it with every Hyprland,
# and bin/sync-rebuilds moves these pins to the Hyprland it rebuilds against.
depends=('glibc' 'libgcc' 'libstdc++' 'hyprlang' 'hyprutils')
depends_x86_64=('hyprland=0.56.2')
depends_aarch64=('hyprland=0.56.2')
makedepends=('cmake' 'pkgconf')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('98a2c43024b7e72dbe97620e6560b5e59d5b02eb25c5fd806586a6efacc7e23e')

build() {
  cmake -S "$srcdir/$pkgname-$pkgver" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$pkgname-$pkgver/LICENSE.MIT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.MIT"
}
