# Maintainer: ujo4eva <92157639+ujo4eva@users.noreply.github.com>

pkgname=gridcraft-bin
_name=gridcraft
pkgver=0.6.1
pkgrel=1
pkgdesc="Calculate, analyse and chart data in workbooks"
arch=('x86_64' 'aarch64')
url="https://github.com/storytold/gridcraft"
license=('MIT OR Apache-2.0')
depends=('glibc' 'libgcc' 'hicolor-icon-theme' 'libxkbcommon' 'vulkan-icd-loader')
optdepends=('wayland: native Wayland windows'
            'libx11: X11 and XWayland windows'
            'libxcursor: X11 and XWayland windows'
            'libxi: X11 and XWayland windows'
            'libxrandr: X11 and XWayland windows'
            'vulkan-driver: GPU rendering through Vulkan'
            'xdg-desktop-portal: native file dialogs')
provides=("$_name")
conflicts=("$_name" "ai.storyteller.$_name")
options=('!debug')
source_x86_64=("$url/releases/download/v$pkgver/$_name-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/$_name-$pkgver-linux-aarch64.tar.gz")
sha256sums_x86_64=('61163b62d9faf814b864e1b255d15dc310a71a72ca03d8791fa8024420162745')
sha256sums_aarch64=('ec8e2c43653d24382f59cb167643b487b2d5063cb21efa0ad1ef25ebe24a500a')

package() {
  cd "$_name-$pkgver-linux-$CARCH"
  install -Dm755 "bin/$_name" "$pkgdir/usr/bin/$_name"
  install -Dm755 "bin/$_name-cli" "$pkgdir/usr/bin/$_name-cli"
  cp -r --no-preserve=ownership share "$pkgdir/usr/"
  install -dm755 "$pkgdir/usr/share/licenses/$pkgname"
  mv "$pkgdir/usr/share/doc/$_name/LICENSE-"{APACHE,MIT} "$pkgdir/usr/share/licenses/$pkgname/"
}
