pkgname=libretro-ppsspp
pkgver=20261001.194250.g604333e99827
pkgrel=1
pkgdesc='Sony PlayStation Portable core'
# Built for aarch64 only: Arch Linux builds this core for x86_64 alone, and
# Arch Linux ARM ships ppsspp-assets but not the core, so RetroArch's install
# fails on ARM without it. The snapshot follows Arch's x86_64 package.
arch=(aarch64)
url=https://github.com/hrydgard/ppsspp
license=(GPL-2.0-only)
groups=(libretro)
depends=(
  glibc
  libgcc
  libgl
  libretro-core-info
  libstdc++
  ppsspp-assets
)
makedepends=(
  cmake
  git
  libglvnd
  ninja
)
_commit=604333e99827f40cdce1012433a3daa6da0666dc
# The submodule commits ppsspp records at $_commit.
