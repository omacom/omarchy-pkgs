# Maintainer: Birk Skyum <birk.skyum@pm.me>

# The speaker and microphone topology for the ASUS ProArt PZ13 (HT5306QA,
# Snapdragon X Plus X1P-42-100). Its device tree names the sound card
# X1P42100-ASUS-ProArt-PZ13, and linux-firmware has no topology under that
# name, so the card never registers. The tablet wires its audio as the Surface
# Pro 12in does, so this builds Linaro's Surface Pro 12in description under the
# tablet's name, as the tree's author does. Its UCM profile is in alsa-ucm-conf.

pkgname=asus-proart-pz13-audio
pkgver=1
pkgrel=1
pkgdesc='Speaker and microphone topology for the ASUS ProArt PZ13 (HT5306QA)'
arch=('aarch64')
# Qualcomm-only: the pacman platform guard keeps it off other hardware.
groups=('omarchy-platform-qualcomm')
url="https://github.com/omacom/omarchy-pkgs"
license=('BSD-3-Clause')
# Unversioned here: the build installs these from the published repository.
# The package itself asks for the alsa-ucm-conf with the tablet's profile, below.
depends=('alsa-ucm-conf')
makedepends=('alsa-utils' 'git' 'm4')
_audioreach_commit=d6bb205aca5f4b8fa6b2f44cf8b5f6a081cbf037
source=("audioreach-topology::git+https://github.com/linux-msm/audioreach-topology.git#commit=${_audioreach_commit}"
        'README.package.md')
sha256sums=('SKIP'
            '4f67d9f669012d792190bc9c3a841c75c23b676fa6bbe9ab1f0a9467b95e9f06')
# The Surface Pro 12in topology linux-firmware ships, byte for byte, which is
# also what surface-pro-11-support builds. A change in alsatplg's output fails
# the build here.
_topology_sha256=89b731f3f98fc2b84699bca39a56e390925a44a26d5aea80382cf617e00c08d8

build() {
  m4 -I "$srcdir/audioreach-topology" \
    "$srcdir/audioreach-topology/X1P42100-Microsoft-Surface-Pro-12in.m4" >topology.conf
  alsatplg -c topology.conf -o X1P42100-ASUS-ProArt-PZ13-tplg.bin
  echo "$_topology_sha256  X1P42100-ASUS-ProArt-PZ13-tplg.bin" | sha256sum -c
}

package_asus-proart-pz13-audio() {
  depends=('alsa-ucm-conf>=1.2.16.1.r45.gd260eed-2')

  local fw="$pkgdir/usr/lib/firmware/qcom/x1e80100"
  install -Dm644 X1P42100-ASUS-ProArt-PZ13-tplg.bin "$fw/X1P42100-ASUS-ProArt-PZ13-tplg.bin"
  # Compressed, so a copy linux-firmware may ship later is the one the kernel
  # loads (it tries a plain name, then .zst, then .xz), and the two packages
  # never install the same path.
  xz -C crc32 "$fw/X1P42100-ASUS-ProArt-PZ13-tplg.bin"

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
