# Maintainer: David Heinemeier Hansson <david@hey.com>

pkgname=omatrack
pkgver=1.8.6
pkgrel=1
pkgdesc="Cross-format motorsport telemetry analysis workstation"
arch=('x86_64' 'aarch64')
url="https://github.com/tobi/omatrack"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'mpv' 'libyaml' 'gcc-libs' 'glibc' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'rust')
options=('!debug' '!lto')

_commit=cd3fcdda3f8e15fda73288f6cf3803164138a7e4
source=(
  "omatrack-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
  'lua-5.4.7.tar.gz::https://www.lua.org/ftp/lua-5.4.7.tar.gz'
  'sol2-d805d027.tar.gz::https://github.com/ThePhD/sol2/archive/d805d027e0a0a7222e936926139f06e23828ce9f.tar.gz'
)
sha256sums=(
  '6beb5703fe0b08a3bb99409581246498300f5cd91195239da00b91123681b8a3'
  '9fbf5e28ef86c69858f6d3d34eccc32e911c1a28b4120ff3e84aaa70cfbf1e30'
  'e7877a14e90d44e1b2d00ec77b85090b3b441f4634a63f23bfe44cedbac8ac9c'
)

prepare() {
  cd "omatrack-$_commit/third_party/motorsport-telemetry"

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "omatrack-$_commit"

  cmake -B build -S . -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DFETCHCONTENT_SOURCE_DIR_LUA_SRC="$srcdir/lua-5.4.7" \
    -DFETCHCONTENT_SOURCE_DIR_SOL2="$srcdir/sol2-d805d027e0a0a7222e936926139f06e23828ce9f" \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON
  cmake --build build
}

package() {
  cd "omatrack-$_commit"

  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
