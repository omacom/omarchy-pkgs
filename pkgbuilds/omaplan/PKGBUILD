# Maintainer: inumineq (https://github.com/inumineq)

pkgname=omaplan
pkgver=0.3.1
pkgrel=1
pkgdesc='Plan your tasks with AI: write them in plain text and see the plan as overview, calendar, list or timeline'
arch=('x86_64' 'aarch64')
url='https://github.com/inumineq/omaplan'
license=('MIT')
options=('!debug')
depends=(
  'fontconfig'
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'qt6-wayland'
  'xdg-utils'
)
makedepends=('cmake' 'gcc' 'make')
checkdepends=('nodejs' 'noto-fonts')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('75ce3ad16434c0228c7c31979fbfd36fb0fa60471c3d4b48c90ed96afdf004de')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure --no-tests=error
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build --prefix /usr
}
