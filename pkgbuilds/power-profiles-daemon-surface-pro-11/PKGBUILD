# Maintainer: Brandon Williams <turbine.bmw@gmail.com>

# power-profiles-daemon that drives the Surface Pro 11's platform profile.

pkgname=power-profiles-daemon-surface-pro-11
_pkgname=power-profiles-daemon
pkgver=0.30
pkgrel=1
pkgdesc="power-profiles-daemon build for the Microsoft Surface Pro 11's platform profile"
arch=('aarch64')
url="https://gitlab.freedesktop.org/upower/power-profiles-daemon"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glib2' 'glibc' 'libgudev' 'polkit' "power-profiles-daemon>=$pkgver" 'upower')
makedepends=('git' 'glib2-devel' 'meson' 'python')
options=('!debug')
source=(
  "git+https://gitlab.freedesktop.org/upower/power-profiles-daemon.git#tag=$pkgver"
  '0001-platform-profile-use-the-class-device.patch'
  '10-surface-pro-11.conf'
  'README.package.md'
)
sha256sums=('e955e833b01cbff9b5b00349592239e58c559d717eb49f3371f42932676e7a40'
            '79de5641f2bb4edafab8aa56ee797b2e481619221a2386d3e8edebbc44eca47a'
            'a251d7aff0c028a1292cef99e7d4218d9c509bfad601400ad027f31bab3960f3'
            '6808045035284b452ac7c4515f9785081b6eb983b36346a7ed473d6e1f8986f5')

prepare() {
  git -C "$_pkgname" apply ../0001-platform-profile-use-the-class-device.patch
}

build() {
  arch-meson "$_pkgname" build -D tests=false -D manpage=disabled -D bashcomp=disabled -D pylint=disabled -D gtk_doc=false
  meson compile -C build src/power-profiles-daemon
}

package() {
  # Only the daemon: Arch's power-profiles-daemon keeps the D-Bus interface,
  # polkit policy, CLI and service, and a drop-in selects this binary.
  install -Dm755 build/src/power-profiles-daemon "$pkgdir/usr/lib/$pkgname/power-profiles-daemon"
  install -Dm644 10-surface-pro-11.conf "$pkgdir/usr/lib/systemd/system/power-profiles-daemon.service.d/10-surface-pro-11.conf"
  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.package.md"
}
