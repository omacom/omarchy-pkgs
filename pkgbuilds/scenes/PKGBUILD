# Maintainer: Peter Vinter <5145479+PeterVinter@users.noreply.github.com>

pkgname=scenes
pkgver=0.1.0
pkgrel=1
pkgdesc='Save and restore named setups of the Omarchy desktop'
arch=('x86_64' 'aarch64')
url='https://github.com/PeterVinter/scenes'
license=('MIT')
install='scenes.install'
options=('!debug')
depends=(
  'gtk3'
  'hicolor-icon-theme'
  'hyprland'
  'omarchy'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
  'uwsm'
)
makedepends=(
  'gcc'
  'make'
  'qt6-base'
  'qt6-declarative'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('920111a84cec173826cb07e82be2f75b9effee687e14834f902bcb2dad709f7c')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/scenes "$pkgdir/usr/bin/scenes"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/scenes.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/scenes.svg"
  install -Dm644 pkgbuild/scenes.desktop "$pkgdir/usr/share/applications/scenes.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
