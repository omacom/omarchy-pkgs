# Maintainer: J. Tanner <tanner.jc@gmail.com>
pkgname=markov-bin
pkgver=0.2.2
pkgrel=1
pkgdesc='Declarative workflow engine for agents and native steps'
arch=('x86_64')
url='https://markovd.com'
license=('Apache-2.0')
depends=('bash' 'ca-certificates')
provides=("markov=${pkgver}")
conflicts=('markov')
options=('!strip' '!debug')

_archive="markov_${pkgver}_linux_amd64.tar.gz"
_checksums="markov-${pkgver}-checksums.txt"
_release="https://github.com/vokramd/markov/releases/download/v${pkgver}"
source=(
  "${_archive}::${_release}/${_archive}"
  "${_checksums}::${_release}/checksums.txt"
  "${_checksums}.sig::${_release}/checksums.txt.sig"
  'markov.1'
)
noextract=("${_archive}")
validpgpkeys=('F50B9360C2C9C876476017A33B8A1C64696AECEF')
sha256sums=(
  '8417ad7f9dc5ced5d1667445b1e086bc923dc0438ef878602610c08c977059a6'
  'SKIP'
  'SKIP'
  'fb0f25bf9e9fbf1c2d19af5ca0b350cddbb112f27cbb329367c14ac1da1be579'
)

prepare() {
  local checksum_line
  checksum_line=$(awk -v name="$_archive" '$2 == name { print; count++ } END { if (count != 1) exit 1 }' "$_checksums") || return
  printf '%s\n' "$checksum_line" | sha256sum --check --status || return
}

package() {
  local unpacked="$srcdir/markov-release"
  mkdir -p "$unpacked"
  bsdtar --no-same-owner -xf "$srcdir/$_archive" -C "$unpacked"
  install -Dm755 "$unpacked/markov" "$pkgdir/usr/bin/markov"
  install -Dm644 "$unpacked/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$unpacked/THIRD_PARTY_LICENSES.txt" "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_LICENSES.txt"
  install -Dm644 "$unpacked/license-inventory.json" "$pkgdir/usr/share/licenses/$pkgname/license-inventory.json"
  install -Dm644 "$unpacked/README.md" "$pkgdir/usr/share/doc/markov/README.md"
  install -Dm644 "$unpacked/examples/quickstart.yaml" "$pkgdir/usr/share/markov/examples/quickstart.yaml"
  install -Dm644 "$srcdir/markov.1" "$pkgdir/usr/share/man/man1/markov.1"
  install -dm755 "$pkgdir/usr/share/bash-completion/completions" "$pkgdir/usr/share/zsh/site-functions" "$pkgdir/usr/share/fish/vendor_completions.d"
  "$unpacked/markov" completion bash > "$pkgdir/usr/share/bash-completion/completions/markov"
  "$unpacked/markov" completion zsh > "$pkgdir/usr/share/zsh/site-functions/_markov"
  "$unpacked/markov" completion fish > "$pkgdir/usr/share/fish/vendor_completions.d/markov.fish"
}
