[Unit]
Description=Gaze daemon for the current device adapter
Documentation=https://github.com/calledtoconstruct/tobii-eye

[Service]
ExecStart=/usr/bin/tobiifreed --ws 127.0.0.1:7081
# The daemon waits through unplug and replug. This restarts a crash.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
