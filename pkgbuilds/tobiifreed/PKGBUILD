# Maintainer: Joseph Woolley <joe@calledtoconstruct.net>
pkgname=tobiifreed
pkgver=0.1.0
pkgrel=1
pkgdesc='Userspace gaze daemon for the current device adapter'
arch=('x86_64' 'aarch64')
url='https://github.com/calledtoconstruct/tobii-eye'
license=('GPL-3.0-only')
depends=('libusb' 'gcc-libs' 'glibc')
makedepends=('cargo')
install=tobiifreed.install
options=('!debug' '!lto')

source=(
  "https://github.com/calledtoconstruct/tobii-eye/archive/refs/tags/v${pkgver}.tar.gz"
  '60-tobii-eyetracker.rules'
  'tobiifreed.service'
)
sha256sums=(
  'dd581142c0bcab258139010ad14d89a6cb23639bd743017de7061291c8e3ff71'
  '8dedaf217f116306e94be5876dac44d341b34092ea98cc4decfeb157465ecf2f'
  '219c7069e3ff01eb088e39591cd86d37c02a5fbce5752aa96b793756a42e17ae'
)

prepare() {
  cd "tobii-eye-${pkgver}/daemon"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "tobii-eye-${pkgver}/daemon"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  install -Dm755 "$srcdir/tobii-eye-${pkgver}/daemon/target/release/tobiifreed" \
    "$pkgdir/usr/bin/tobiifreed"
  install -Dm644 "$srcdir/60-tobii-eyetracker.rules" \
    "$pkgdir/usr/lib/udev/rules.d/60-tobii-eyetracker.rules"
  install -Dm644 "$srcdir/tobiifreed.service" \
    "$pkgdir/usr/lib/systemd/user/tobiifreed.service"
  install -Dm644 "$srcdir/tobii-eye-${pkgver}/daemon/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
