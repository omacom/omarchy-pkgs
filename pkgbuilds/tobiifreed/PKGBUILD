# Maintainer: Joseph Woolley <joe@calledtoconstruct.net>
pkgname=tobiifreed
pkgver=0+424af66
pkgrel=1
pkgdesc='Userspace daemon for the Tobii Eye Tracker 5'
arch=('x86_64' 'aarch64')
url='https://github.com/calledtoconstruct/tobii-eye'
license=('GPL-3.0-only')
depends=('libusb' 'gcc-libs' 'glibc')
makedepends=('cargo' 'git')
install=tobiifreed.install
options=('!debug' '!lto')

_commit=424af665c424d435b9d1ae475a5e9c51b0bd98a5
source=(
  "tobii-eye::git+https://github.com/calledtoconstruct/tobii-eye.git#commit=${_commit}"
  '60-tobii-eyetracker.rules'
  'tobiifreed.service'
)
sha256sums=(
  'SKIP'
  '06ceddcdcf7d5be5a9a06d7723157f0f1c099c4db9ff073cdf85f29724e668a2'
  '975c00c5dd9ccbbbb589a7a86fdf36d2f2bea30df5fe189d10a13d7cbb22f26d'
)

prepare() {
  cd tobii-eye/daemon
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd tobii-eye/daemon
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  install -Dm755 "$srcdir/tobii-eye/daemon/target/release/tobiifreed" \
    "$pkgdir/usr/bin/tobiifreed"
  install -Dm644 "$srcdir/60-tobii-eyetracker.rules" \
    "$pkgdir/usr/lib/udev/rules.d/60-tobii-eyetracker.rules"
  install -Dm644 "$srcdir/tobiifreed.service" \
    "$pkgdir/usr/lib/systemd/user/tobiifreed.service"
  install -Dm644 "$srcdir/tobii-eye/daemon/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
