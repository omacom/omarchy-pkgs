4d2aa10aa60245177ca253d4a8f7ee15c0a0390e877efec29fa25c7d4b725568  qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/qccdsp8380.mbn
848341997c48213d818168ed0ec48ee722c30738e5ffede40550d38252e3ac71  qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/qcdxkmsucpurwa.mbn
