# Audio DSP, compute DSP, GPU and video firmware for the ASUS Zenbook 14 UX3480QA. The firmware
# only runs if it is signed for this board by ASUS, so linux-firmware cannot carry it until the
# OEM submits it. The OEM ships it in its Windows driver download, which this recipe unpacks
# without running. Each file is checked against the SHA-256 it was matched to and installed under
# the name the device tree requests, compressed with xz. The kernel tries a plain name, then .zst,
# then .xz, so once linux-firmware ships the same file, its copy is the one loaded, and the two
# packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=asus-zenbook-14-ux3480qa-firmware
pkgver=20261106
pkgrel=1
pkgdesc='Audio DSP, compute DSP, GPU and video firmware for the ASUS Zenbook 14 UX3480QA'
arch=('aarch64')
url='https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/50883/SOCPackage_forWebSite_Qualcomm_Z_V1.304.9300.0_50883.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1p42100-asustek-zenbook-14-ux3480qa')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'asus-socpackage-50883.exe::https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/50883/SOCPackage_forWebSite_Qualcomm_Z_V1.304.9300.0_50883.exe'
)
noextract=('asus-socpackage-50883.exe')
sha256sums=('6d0eb7e86116fa108e13a064a023312c328efaf44c6358e5c0e2832de0ad4390')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'asus-socpackage-50883.exe' 'asus-socpackage-50883' 7z-appended
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'asus-socpackage-50883/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/adsp_dtbs.elf'
  install -Dm644 'asus-socpackage-50883/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adspr.jsn' "$fw"/'qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/adspr.jsn'
  install -Dm644 'asus-socpackage-50883/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adsps.jsn' "$fw"/'qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/adsps.jsn'
  install -Dm644 'asus-socpackage-50883/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adspua.jsn' "$fw"/'qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/adspua.jsn'
  install -Dm644 'asus-socpackage-50883/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/battmgr.jsn' "$fw"/'qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/battmgr.jsn'
  install -Dm644 'asus-socpackage-50883/QualcommBSP/NPU/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/cdsp_dtbs.elf'
  install -Dm644 'asus-socpackage-50883/QualcommBSP/NPU/qcnspmcdm_ext_cdsp8380/cdspr.jsn' "$fw"/'qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/cdspr.jsn'
  install -Dm644 'asus-socpackage-50883/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/qcadsp8380.mbn' "$fw"/'qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/qcadsp8380.mbn'
  install -Dm644 'asus-socpackage-50883/QualcommBSP/NPU/qcnspmcdm_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/qccdsp8380.mbn'
  install -Dm644 'asus-socpackage-50883/QualcommBSP/GFX/qcdx8380/qcdxkmsucpurwa.mbn' "$fw"/'qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/qcdxkmsucpurwa.mbn'
  install -Dm644 'asus-socpackage-50883/QualcommBSP/GFX/qcdx8380/qcvss8380.mbn' "$fw"/'qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/qcvss8380.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
53740156633d1fe1d0f15f46425d033db30ae7981651ffb82f15bca90e6716cd  qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/adsp_dtbs.elf
