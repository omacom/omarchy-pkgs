12ac2f3ae8ced12aa4b06b3ab3a01bc4d8efe1c92ebea503c002f209a6ec176f  qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/adsps.jsn
982a99853495e34726b8e44697fdfad303334de0a67cbf6cde306c8f1731000b  qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/adspua.jsn
be8c6fba330908e4683fb6282761cb08485a302d6a66e09721e102e342f27236  qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/battmgr.jsn
c1e3cdeee17e61ee5f9426fef78e5e35eaf9fdd49d3d39b9bd82dcad04c71647  qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/cdsp_dtbs.elf
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa/cdspr.jsn
