# Maintainer: Emir Beganovic <emir@omarchy.org>
#
# Audio and compute DSP, GPU zap shader and video firmware for the ASUS Zenbook
# 14 UX3480QA (Snapdragon X X1-26-100). These only run images signed for this
# model, so linux-firmware cannot carry them. Without the audio DSP there is no
# battery reporting, charging status or sound, and without the zap shader no GPU
# acceleration. ASUS ships all of them in the Qualcomm board support package for
# the UX3480QA, which this recipe unpacks without running; they are installed
# unmodified, where the device tree asks for them.
#
# Not in omarchy-platform-qualcomm: the files serve this model only. It provides
# qcom-firmware-<folder> for the folder it fills, so Omarchy installs it on the
# machine whose device tree asks for that folder.

pkgname=asus-zenbook-14-ux3480qa-firmware
pkgver=1.304.9300.0
pkgrel=1
pkgdesc='DSP, GPU and video firmware for the ASUS Zenbook 14 UX3480QA'
arch=('aarch64')
url='https://www.asus.com/supportonly/ux3480qa/helpdesk_download/'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1p42100-asustek-zenbook-14-ux3480qa')
makedepends=('7zip')
options=('!strip' '!debug')
_exe=SOCPackage_forWebSite_Qualcomm_Z_V${pkgver}_50883.exe
source=("$_exe::https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/50883/$_exe?model=UX3480QA")
sha256sums=('6d0eb7e86116fa108e13a064a023312c328efaf44c6358e5c0e2832de0ad4390')

prepare() {
  # A self-extracting executable with the package appended as a 7z archive.
  # Cut the archive out and unpack only what the recipe installs.
  local offset
  offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$_exe" | head -1 | cut -d: -f1)
  [[ -n $offset ]] || { echo "no 7z archive in $_exe" >&2; return 1; }
  tail -c +$((offset + 1)) "$_exe" > bsp.7z
  rm -rf bsp
  7z x -y -obsp bsp.7z >/dev/null \
    QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/qcadsp8380.mbn \
    QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adsp_dtbs.elf \
    QualcommBSP/NPU/qcnspmcdm_ext_cdsp8380/qccdsp8380.mbn \
    QualcommBSP/NPU/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf \
    QualcommBSP/GFX/qcdx8380/qcdxkmsucpurwa.mbn \
    QualcommBSP/GFX/qcdx8380/qcvss8380.mbn
}

package() {
  local bsp=bsp/QualcommBSP

  install -Dm644 -t "$pkgdir/usr/lib/firmware/qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa" \
    "$bsp/Subsystem/qcsubsys_ext_adsp8380/qcadsp8380.mbn" \
    "$bsp/Subsystem/qcsubsys_ext_adsp8380/adsp_dtbs.elf" \
    "$bsp/NPU/qcnspmcdm_ext_cdsp8380/qccdsp8380.mbn" \
    "$bsp/NPU/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf" \
    "$bsp/GFX/qcdx8380/qcdxkmsucpurwa.mbn" \
    "$bsp/GFX/qcdx8380/qcvss8380.mbn"

  # The bytes each file was checked against on the laptop, so a changed
  # download fails the build instead of shipping untested firmware.
  (
    cd "$pkgdir/usr/lib/firmware/qcom/x1p42100/ASUSTeK/zenbook-14-ux3480qa" || exit 1
    sha256sum -c --quiet <<'SUMS'
204cafa21a5129b78194a9e668f656176cea251515e784cce4e287e0c0cbcefc  qcadsp8380.mbn
53740156633d1fe1d0f15f46425d033db30ae7981651ffb82f15bca90e6716cd  adsp_dtbs.elf
4d2aa10aa60245177ca253d4a8f7ee15c0a0390e877efec29fa25c7d4b725568  qccdsp8380.mbn
c1e3cdeee17e61ee5f9426fef78e5e35eaf9fdd49d3d39b9bd82dcad04c71647  cdsp_dtbs.elf
848341997c48213d818168ed0ec48ee722c30738e5ffede40550d38252e3ac71  qcdxkmsucpurwa.mbn
fa5e78c9743c5ca3439baadfe7f1e118591f8a1ad976e9f87b75937945d42e8b  qcvss8380.mbn
SUMS
  )
}
