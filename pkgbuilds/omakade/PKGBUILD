pkgname=omakade
pkgver=1.15.0
pkgrel=2
pkgdesc='A beautiful, local-first game library for Omarchy'
arch=('x86_64' 'aarch64')
url='https://btsouth.github.io/omakade/'
license=('GPL-3.0-or-later' 'CC-BY-SA-3.0')
depends=('glib2' 'hicolor-icon-theme' 'layer-shell-qt' 'libsecret' 'libzip' 'openssl' 'python' 'qt6-base' 'qt6-declarative' 'qt6-imageformats' 'qt6-svg' 'qt6-wayland' 'sdl3' 'wayland' 'zstd')
optdepends=('libpulse: switch Game Mode sound outputs with pactl'
            'umu-launcher: launch Windows GOG and Proton Battle.net games')
# wayland-protocols turns the optional idle-inhibit feature on
# deterministically instead of leaving it to what the chroot happens to carry.
makedepends=('cmake' 'ninja' 'pkgconf' 'wayland-protocols')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/btsouth/omakade/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('cb5bfd208a151f6071956555c6afd93efc04a0490e951523bf5ec7d0f5e2b982')

build() {
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
