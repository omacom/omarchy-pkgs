# Audio DSP, compute DSP and GPU firmware for the Lenovo ThinkBook 16 G7 QOY. The firmware only
# runs if it is signed for this board by Lenovo, so linux-firmware cannot carry it until the OEM
# submits it. The OEM ships it in the driver bundle it publishes for the machine on Windows
# Update, whose cabinets this recipe fetches with wudrivers and unpacks without running anything.
# Each file is checked against the SHA-256 it was matched to and installed under the name the
# device tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so
# once linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=lenovo-thinkbook-16-g7-qoy-firmware
pkgver=20261115
pkgrel=1
pkgdesc='Audio DSP, compute DSP and GPU firmware for the Lenovo ThinkBook 16 G7 QOY'
arch=('aarch64')
url='https://github.com/birkskyum/wudrivers'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1p42100-lenovo-21nh')
makedepends=('7zip' 'wudrivers')
options=('!strip' '!debug')
# Windows Update's links are short-lived, so wudrivers fetches a fresh one by update ID, revision and SHA-1.
DLAGENTS+=('wu::/usr/bin/wudrivers fetch %u -o %o')
source=(
  'lenovo-21nh-wu-200.0.21.0-qcsubsys-ext-adsp8380.cab::wu://ee26dfb9-8d80-4eb7-8017-6ba24022412c/1/26e4b6286ce79b6d0112552e8133a6018395c38e'
  'lenovo-21nh-wu-200.0.21.0-qcnspmcdm-ext-cdsp8380.cab::wu://ee26dfb9-8d80-4eb7-8017-6ba24022412c/1/747466cde047783a391760230cbca3195a2df7b3'
  'lenovo-21nh-wu-200.0.21.0-qcdx8380.cab::wu://ee26dfb9-8d80-4eb7-8017-6ba24022412c/1/e4da45e7d76bb3d109312897dbfa15e7446df9d9'
)
source+=('README.package.md')
noextract=('lenovo-21nh-wu-200.0.21.0-qcsubsys-ext-adsp8380.cab' 'lenovo-21nh-wu-200.0.21.0-qcnspmcdm-ext-cdsp8380.cab' 'lenovo-21nh-wu-200.0.21.0-qcdx8380.cab')
sha256sums=('fdbac05da6490bf621d715112ea68fef19fc3de025f5768386e5700855abad9e' 'd6e5f7c9affca5d3aa93f384841676bf93750e285acc2e26461081c3857cf00a' 'aa86b26d1a91ce66990a915e4f26798ff547779e537aebadb175d30e56ad09d8')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'lenovo-21nh-wu-200.0.21.0-qcsubsys-ext-adsp8380.cab' 'lenovo-21nh-wu-200.0.21.0-qcsubsys-ext-adsp8380' 7z
  _unpack 'lenovo-21nh-wu-200.0.21.0-qcnspmcdm-ext-cdsp8380.cab' 'lenovo-21nh-wu-200.0.21.0-qcnspmcdm-ext-cdsp8380' 7z
  _unpack 'lenovo-21nh-wu-200.0.21.0-qcdx8380.cab' 'lenovo-21nh-wu-200.0.21.0-qcdx8380' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'lenovo-21nh-wu-200.0.21.0-qcsubsys-ext-adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1p42100/LENOVO/21NH/adsp_dtbs.elf'
  install -Dm644 'lenovo-21nh-wu-200.0.21.0-qcsubsys-ext-adsp8380/adspr.jsn' "$fw"/'qcom/x1p42100/LENOVO/21NH/adspr.jsn'
  install -Dm644 'lenovo-21nh-wu-200.0.21.0-qcsubsys-ext-adsp8380/adsps.jsn' "$fw"/'qcom/x1p42100/LENOVO/21NH/adsps.jsn'
  install -Dm644 'lenovo-21nh-wu-200.0.21.0-qcsubsys-ext-adsp8380/adspua.jsn' "$fw"/'qcom/x1p42100/LENOVO/21NH/adspua.jsn'
  install -Dm644 'lenovo-21nh-wu-200.0.21.0-qcsubsys-ext-adsp8380/battmgr.jsn' "$fw"/'qcom/x1p42100/LENOVO/21NH/battmgr.jsn'
  install -Dm644 'lenovo-21nh-wu-200.0.21.0-qcnspmcdm-ext-cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1p42100/LENOVO/21NH/cdsp_dtbs.elf'
  install -Dm644 'lenovo-21nh-wu-200.0.21.0-qcnspmcdm-ext-cdsp8380/cdspr.jsn' "$fw"/'qcom/x1p42100/LENOVO/21NH/cdspr.jsn'
  install -Dm644 'lenovo-21nh-wu-200.0.21.0-qcsubsys-ext-adsp8380/qcadsp8380.mbn' "$fw"/'qcom/x1p42100/LENOVO/21NH/qcadsp8380.mbn'
  install -Dm644 'lenovo-21nh-wu-200.0.21.0-qcnspmcdm-ext-cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1p42100/LENOVO/21NH/qccdsp8380.mbn'
  install -Dm644 'lenovo-21nh-wu-200.0.21.0-qcdx8380/qcdxkmsucpurwa.mbn' "$fw"/'qcom/x1p42100/LENOVO/21NH/qcdxkmsucpurwa.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
09b0518af0362fb34b0492d1c4081033313ba32fd94dc07a51b05a3122e55033  qcom/x1p42100/LENOVO/21NH/adsp_dtbs.elf
4b9566fcfdc1656c38d8158d79db6964e9c4b57a6e42b46241e8d63aabc42d8d  qcom/x1p42100/LENOVO/21NH/adspr.jsn
19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e  qcom/x1p42100/LENOVO/21NH/adsps.jsn
d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d  qcom/x1p42100/LENOVO/21NH/adspua.jsn
b8aad1d149128f414eb1fd6fcbb6e0a5b7dabcd2cba001599e1ce9a0e2e291a4  qcom/x1p42100/LENOVO/21NH/battmgr.jsn
1e0535bd2a8adcd14d6079ffa99f6fce5c6561d4759a60f6076dcfbaa4437f8a  qcom/x1p42100/LENOVO/21NH/cdsp_dtbs.elf
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x1p42100/LENOVO/21NH/cdspr.jsn
4e0af6492355e4264a183728b6251a416a6cb2fa4ee2a4baca076cfb8d433c64  qcom/x1p42100/LENOVO/21NH/qcadsp8380.mbn
4387fa1a234aacbff50f8a215b96536d17c4b25b6b798392e15a162e4adcd7a0  qcom/x1p42100/LENOVO/21NH/qccdsp8380.mbn
f9342cb44a79f5abdd1f0ae888c6c3df8e60f28a6c3a5077591369268d1b5c0a  qcom/x1p42100/LENOVO/21NH/qcdxkmsucpurwa.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
