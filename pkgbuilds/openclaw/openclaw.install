post_install() {
    printf "%s\n" \
        "==> This is the release a self-updating OpenClaw starts from." \
        "==> Set it up under ~/.openclaw: omarchy-install-openclaw-cli --now"
}

post_upgrade() {
    # Before 2026.9.5-2 this package was OpenClaw itself, under
    # /usr/lib/node_modules/openclaw. Omarchy's migration moves an install
    # and its gateway service to ~/.openclaw; a root pacman hook has no
    # session bus to do that from.
    if (( $(vercmp "$2" 2026.9.5-2) < 0 )); then
        printf "%s\n" \
            "==> OpenClaw now runs from ~/.openclaw and updates itself." \
            "==> omarchy update moves an existing install there; or run:" \
            "    omarchy-install-openclaw-cli --now"
    else
        printf "%s\n" \
            "==> This only changes the release new installs start from." \
            "==> Update the OpenClaw in ~/.openclaw with: openclaw update"
    fi
}
