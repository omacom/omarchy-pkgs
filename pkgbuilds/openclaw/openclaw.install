post_install() {
    printf '%s\n' \
        '==> Run omarchy-install-openclaw-cli as your desktop user to set up OpenClaw.' \
        '==> OpenClaw owns its application updates; Arch supplies Node/npm and this integration.'
}

post_upgrade() {
    printf '%s\n' \
        '==> Existing system installations must migrate to the user-owned runtime.' \
        '==> Run omarchy-install-openclaw-cli as your desktop user to migrate and rebind the gateway.' \
        '==> Configuration and credentials remain in your OpenClaw user state directory.'
}
