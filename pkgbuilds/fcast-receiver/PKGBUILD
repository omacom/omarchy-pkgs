# Maintainer: Omarchy Package Repository <https://github.com/omacom/omarchy-pkgs>
# Upstream: https://github.com/futo-org/fcast (receivers/desktop)
# Version and checksums are managed by `bin/sync-upstream` via the
# `upstream.git_tags` declaration in .omarchy/package.json.
# Build follows the official Linux path (see receivers/desktop/README.md
# and the Flatpak manifest): cargo xtask with the pinned static GStreamer.
pkgname=fcast-receiver
pkgver=3.0.4
pkgrel=1
pkgdesc="Receiver for displaying multimedia content from FCast sender applications"
arch=('x86_64' 'aarch64')
url="https://fcast.org/"
license=('GPL-3.0-only')
depends=('glib2' 'pango' 'harfbuzz' 'fribidi' 'cairo' 'pixman' 'graphene'
         'json-glib' 'freetype2' 'fontconfig' 'expat' 'pcre2' 'libffi' 'zlib'
         'libpng' 'libjpeg-turbo' 'openssl' 'libsoup3' 'libxml2' 'libpsl'
         'libsoup3' 'libxml2' 'libpsl' 'libnghttp2' 'libogg' 'libvorbis' 'libtheora' 'opus' 'flac' 'dav1d'
         'libass' 'libsrtp' 'srt' 'wavpack' 'libva' 'libgudev' 'alsa-lib'
         'libpulse' 'pipewire' 'libnice' 'libheif' 'shaderc'
         'vulkan-icd-loader' 'wayland' 'libxkbcommon' 'libx11' 'libxcursor'
         'libxi' 'libxrandr' 'libxcb' 'libglvnd')
makedepends=('rust' 'clang' 'lld' 'meson' 'ninja' 'cmake' 'nasm' 'pkgconf'
             'python' 'python-jinja' 'git' 'protobuf' 'glib2-devel'
             'vulkan-headers')
optdepends=('yt-dlp: playing URLs that need extracting')
# No LTO on the C side: tikv-jemalloc-sys builds jemalloc through
# autotools, and objects carrying LTO bytecode lose their symbols at
# the final Rust link (undefined _rjem_malloc). Rust-side thin LTO
# from the workspace profile is unaffected.
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz"::"https://github.com/futo-org/fcast/archive/refs/tags/desktop-receiver-${pkgver}.tar.gz"
        "libplacebo-v7.360.1.tar.gz"::"https://code.videolan.org/videolan/libplacebo/-/archive/v7.360.1/libplacebo-v7.360.1.tar.gz"
        "glad-73db193f853e2ee079bf3ca8a64aa2eaf6459043.tar.gz"::"https://github.com/Dav1dde/glad/archive/73db193f853e2ee079bf3ca8a64aa2eaf6459043.tar.gz")
sha256sums=('54bc8a7e39c2e83d8e05a40fae19c65e3fdf488e68be7b4dba4b8c37fa5a3fd2'
            '14c0a99f4b01557ec9826ce6b1d52f6de21be274ba03fd5aab7307f18766dc39'
            '33dbeae44d8315ece57e14eba4b1b4a02ac5406d1c4f49cd20048c91522a6b9a')

prepare() {
  # libplacebo is a git submodule, so it is missing from the release
  # tarball. Vendor the exact revision the crate pins (TAG in
  # crates/libplacebo-sys/build.rs) into its expected location.
  # Bump this together with that TAG when upstream moves it.
  rm -rf "${srcdir}/fcast-desktop-receiver-${pkgver}/crates/libplacebo-sys/libplacebo"
  cp -r "${srcdir}/libplacebo-v7.360.1" "${srcdir}/fcast-desktop-receiver-${pkgver}/crates/libplacebo-sys/libplacebo"
  # Same story one level down: libplacebo's own glad generator submodule.
  # Commit recorded in libplacebo's tree at the vendored TAG.
  rm -rf "${srcdir}/fcast-desktop-receiver-${pkgver}/crates/libplacebo-sys/libplacebo/3rdparty/glad"
  cp -r "${srcdir}/glad-73db193f853e2ee079bf3ca8a64aa2eaf6459043" "${srcdir}/fcast-desktop-receiver-${pkgver}/crates/libplacebo-sys/libplacebo/3rdparty/glad"
}

build() {
  cd "${srcdir}/fcast-desktop-receiver-${pkgver}"

  # The repo pins the `wild` linker, which is not packaged for Arch;
  # use lld instead (same as Flatpak). --no-gc-sections / --no-as-needed
  # keep tikv-jemallocator's symbols alive: the workspace builds with thin
  # LTO, under which makepkg's defaults drop the jemalloc archive before
  # LTO resolution (undefined _rjem_malloc at link).
  export RUSTFLAGS="-C link-arg=-fuse-ld=lld -C link-arg=-Wl,--no-gc-sections -C link-arg=-Wl,--no-as-needed"

  cargo xtask receiver build-static --release
}

package() {
  cd "${srcdir}/fcast-desktop-receiver-${pkgver}"

  install -Dm755 "target/release/desktop-receiver" "${pkgdir}/usr/bin/fcast-receiver"

  install -Dm644 ".flatpak/org.fcast.Receiver.desktop" "${pkgdir}/usr/share/applications/org.fcast.Receiver.desktop"
  install -Dm644 ".flatpak/org.fcast.Receiver.metainfo.xml" "${pkgdir}/usr/share/metainfo/org.fcast.Receiver.metainfo.xml"

  install -Dm644 "receivers/extra/icon128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/org.fcast.Receiver.png"
  install -Dm644 "receivers/extra/icon256.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/org.fcast.Receiver.png"
  install -Dm644 "receivers/extra/icon512.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/org.fcast.Receiver.png"

  install -Dm644 "senders/extra/LICENSE-GPL" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
