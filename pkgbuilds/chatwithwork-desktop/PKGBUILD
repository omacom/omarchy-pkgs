# Maintainer: Carmine Paolino <carmine@paolino.me>
pkgname=chatwithwork-desktop
pkgver=0.16.2
pkgrel=1
pkgdesc="Chat with Work Desktop: the desktop app, terminal interface and background agent"
arch=('x86_64' 'aarch64')
url="https://github.com/crmne/chatwithwork-desktop"
license=('GPL-3.0-only')
install="${pkgname}.install"
depends=('alsa-lib' 'libpipewire' 'glibc' 'gcc-libs' 'webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'dbus' 'bubblewrap' 'slirp4netns' 'util-linux' 'iptables-nft')
makedepends=('cargo' 'pkgconf' 'cmake' 'clang' 'python' 'npm')
optdepends=('org.freedesktop.secrets: store the device key in your keyring'
            'xdg-desktop-portal: native folder picker'
            'sane: scan with a USB scanner'
            'cups: print with your printers'
            'tesseract: make scans searchable (with tesseract-data-<language>)'
            'systemd: start the agent now and at login with cww daemon install')
provides=('cww' 'cww-app')
conflicts=('cww' 'chatwithwork-desktop-bin' 'chatwithwork-desktop-git')
# !lto because ring compiles its own C and Arch's default CFLAGS put LTO
# objects in the archive, which the linker then cannot resolve. !debug
# because the release profile strips symbols, so a debug package would be
# empty.
options=('!debug' '!lto' '!strip')
# The browser engine bundles the Node.js runtime that upstream pins in
# browser/engine/runtime-platforms.json. It is a source here so the build
# never downloads it; prepare() fails if upstream moves to another version.
_nodever=26.12.1
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/crmne/chatwithwork-desktop/archive/refs/tags/v${pkgver}.tar.gz")
source_x86_64=("https://nodejs.org/dist/v${_nodever}/node-v${_nodever}-linux-x64.tar.xz")
source_aarch64=("https://nodejs.org/dist/v${_nodever}/node-v${_nodever}-linux-arm64.tar.xz")
noextract=("node-v${_nodever}-linux-x64.tar.xz" "node-v${_nodever}-linux-arm64.tar.xz")
sha256sums=('1e2cd6afd64a540d31cb319a1b23233bdc563c47293667495c52f1725a572ae7')
sha256sums_x86_64=('6170b2d474e1c626f43cff3adc118df9fe3b573258a4fc3d850c8dbc6b079bbd')
sha256sums_aarch64=('42aa04922591ee5d4dbc7740d452621acf28508239daa512f5ee8c47ee224fdb')

prepare() {
  cd "${srcdir}/chatwithwork-desktop-${pkgver}"
  local node_version
  node_version=$(python -c 'import json, sys; print(json.load(open(sys.argv[1]))["node_version"])' \
    browser/engine/runtime-platforms.json)
  if [[ $node_version != "$_nodever" ]]; then
    echo "Upstream bundles Node.js $node_version; set _nodever and its checksums to match." >&2
    return 1
  fi
  # package.py takes the runtime from its cache when the file is there and
  # its SHA-256 matches the one upstream pins, and only downloads otherwise.
  local node_arch=x64
  [[ $CARCH == aarch64 ]] && node_arch=arm64
  mkdir -p "${srcdir}/node-runtime-cache"
  ln -sf "${srcdir}/node-v${_nodever}-linux-${node_arch}.tar.xz" "${srcdir}/node-runtime-cache/"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${srcdir}/chatwithwork-desktop-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=/"
  cargo build --frozen --release --workspace
  python browser/engine/scripts/package.py stage --replace \
    --target "$(rustc -vV | sed -n 's/host: //p')" \
    --app-version "$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n 1)" \
    --output browser-engine --cache "${srcdir}/node-runtime-cache"
}

check() {
  cd "${srcdir}/chatwithwork-desktop-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Two jobs: the test binaries link with thin LTO and one codegen unit each,
  # and linking them all at once ran a 12 GiB aarch64 builder out of memory.
  # The skipped test runs a binary it compiles inside the command sandbox,
  # which the sandbox refuses (exit 126) in the package builder's container.
  cargo test --frozen --release --workspace --jobs 2 -- \
    --skip commands::tests::a_command_compiles_c_against_the_system_headers
}

package() {
  cd "${srcdir}/chatwithwork-desktop-${pkgver}"
  install -dm755 "${pkgdir}/usr/lib/chatwithwork"
  cp -R browser-engine "${pkgdir}/usr/lib/chatwithwork/"
  install -Dm755 target/release/cww "${pkgdir}/usr/bin/cww"
  install -Dm755 target/release/cww-app "${pkgdir}/usr/bin/cww-app"
  install -Dm644 packaging/linux/cww-app.desktop "${pkgdir}/usr/share/applications/cww-app.desktop"
  install -Dm644 app/assets/mark.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/cww-app.svg"
  install -Dm644 packaging/systemd/cww.service "${pkgdir}/usr/lib/systemd/user/cww.service"
  install -Dm644 README.md PROTOCOL.md SECURITY.md -t "${pkgdir}/usr/share/doc/${pkgname}/"
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
