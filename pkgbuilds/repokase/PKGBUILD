# Maintainer: Tim Apple <179739321+ninepointlabs@users.noreply.github.com>
pkgname=repokase
pkgver=0.1.0
pkgrel=2
pkgdesc="Your repos, chef's choice. A native Omarchy app for managing GitHub repositories"
arch=('any')
url="https://github.com/ninepointlabs/repokase"
license=('MIT')
depends=(
  'python'
  'pyside6'
  'python-httpx'
  'python-qasync'
  'python-secretstorage'
  'python-yaml'
  # anyio (used by httpx for async requests) imports typing_extensions on
  # Python < 3.15, but Arch's python-anyio does not declare it.
  'python-typing_extensions'
  'hicolor-icon-theme'
)
optdepends=(
  'gnome-keyring: Secret Service provider to store the GitHub token'
  'kwallet: alternative Secret Service provider'
  'xdg-utils: open GitHub pages in your browser'
)
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest' 'python-pytest-asyncio' 'python-respx')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('59b04e728f5ddbe70978533c458dc1a909e851656846f4d2f9282203e9121743')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  QT_QPA_PLATFORM=offscreen PYTHONPATH="$PWD/src" python -m pytest -q
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 packaging/repokase.desktop "$pkgdir/usr/share/applications/repokase.desktop"
  local size
  for size in 16 32 48 64 128 256 512; do
    install -Dm644 "packaging/icons/hicolor/${size}x${size}/apps/repokase.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/repokase.png"
  done
  install -Dm644 packaging/icons/hicolor/scalable/apps/repokase.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/repokase.svg"
  install -Dm644 packaging/systemd/repokase-traffic.service "$pkgdir/usr/lib/systemd/user/repokase-traffic.service"
  install -Dm644 packaging/systemd/repokase-traffic.timer "$pkgdir/usr/lib/systemd/user/repokase-traffic.timer"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
