# Audio DSP, compute DSP, GPU and video firmware for the Acer Swift 14 Go Pro AI. The firmware
# only runs if it is signed for this board by Acer, so linux-firmware cannot carry it until the
# OEM submits it. The OEM ships it in its Windows driver download, which this recipe unpacks
# without running. The files are installed unmodified, under the names the device tree requests,
# and checked against the SHA-256 each was matched to.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=acer-swift-14-go-pro-ai-firmware
pkgver=20261102
pkgrel=1
pkgdesc='Audio DSP, compute DSP, GPU and video firmware for the Acer Swift 14 Go Pro AI'
arch=('aarch64')
url='https://www.acer.com/us-en/support/product-support/SFA14-11'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1e80100-acer-sfa14-11')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'acer-others-acer-2.0-w11x64-a.zip::https://global-download.acer.com/GDFiles/Driver/Others/Others_Acer_2.0_W11x64_A.zip?acerid=639005191616021898&Step1=&Step2=&Step3=SWIFT%20SFA14-11&OS=ALL&LC=en&BC=ACER&SC=PA_6'
)
noextract=('acer-others-acer-2.0-w11x64-a.zip')
sha256sums=('3c955be4bbfcfc64d556b0073dc19af38db75d35292e18acec3bd49781db5df0')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'acer-others-acer-2.0-w11x64-a.zip' 'acer-others-acer-2.0-w11x64-a' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'acer-others-acer-2.0-w11x64-a/SFA14-11_Drivers/qcsubsys_ext_adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1e80100/ACER/SFA14-11/adsp_dtbs.elf'
  install -Dm644 'acer-others-acer-2.0-w11x64-a/SFA14-11_Drivers/qcsubsys_ext_adsp8380/adspr.jsn' "$fw"/'qcom/x1e80100/ACER/SFA14-11/adspr.jsn'
  install -Dm644 'acer-others-acer-2.0-w11x64-a/SFA14-11_Drivers/qcsubsys_ext_adsp8380/adsps.jsn' "$fw"/'qcom/x1e80100/ACER/SFA14-11/adsps.jsn'
  install -Dm644 'acer-others-acer-2.0-w11x64-a/SFA14-11_Drivers/qcsubsys_ext_adsp8380/adspua.jsn' "$fw"/'qcom/x1e80100/ACER/SFA14-11/adspua.jsn'
  install -Dm644 'acer-others-acer-2.0-w11x64-a/SFA14-11_Drivers/qcsubsys_ext_adsp8380/battmgr.jsn' "$fw"/'qcom/x1e80100/ACER/SFA14-11/battmgr.jsn'
  install -Dm644 'acer-others-acer-2.0-w11x64-a/SFA14-11_Drivers/qcsubsys_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1e80100/ACER/SFA14-11/cdsp_dtbs.elf'
  install -Dm644 'acer-others-acer-2.0-w11x64-a/SFA14-11_Drivers/qcsubsys_ext_cdsp8380/cdspr.jsn' "$fw"/'qcom/x1e80100/ACER/SFA14-11/cdspr.jsn'
  install -Dm644 'acer-others-acer-2.0-w11x64-a/SFA14-11_Drivers/qcsubsys_ext_adsp8380/qcadsp8380.mbn' "$fw"/'qcom/x1e80100/ACER/SFA14-11/qcadsp8380.mbn'
  install -Dm644 'acer-others-acer-2.0-w11x64-a/SFA14-11_Drivers/qcsubsys_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1e80100/ACER/SFA14-11/qccdsp8380.mbn'
