# Maintainer: The Omarchy Authors

# Hardware support for the Anduril BlueChip (Snapdragon X2 Elite / Glymur)
# that no upstream package carries yet.

pkgname=anduril-bluechip-support
pkgver=1
pkgrel=2
pkgdesc="Hardware support for the Anduril BlueChip not yet carried upstream"
arch=('aarch64')
# Qualcomm-only: the pacman platform guard keeps it off other hardware.
groups=('omarchy-platform-qualcomm')
url="https://github.com/omacom/omarchy-pkgs"
license=('MIT')
depends=('bash' 'systemd' 'wireplumber'
         'libcamera' 'gst-plugin-libcamera' 'gst-plugins-base' 'gst-plugins-good'
         'v4l2loopback-dkms' 'v4l2-relayd' 'v4l-utils')
backup=('etc/v4l2-relayd.d/bluechip.conf')
_libdir=/usr/lib/$pkgname
source=(
  '50-bluechip-cameras.conf'
  '70-bluechip-camera.rules'
  'bluechip-camera-announce'
  'bluechip-camera-guard'
  'bluechip-camera-guard.service'
  'bluechip-camera-modprobe.conf'
  'v4l2-relayd-bluechip.conf'
  'v4l2-relayd-bluechip.service.conf'
  'ov08x40.yaml'
  'README.package.md'
  'LICENSE'
)
sha256sums=('6783b538a1558f970bdb1d53b12b1e5d49859cbe84955eb20c3996ea477cb0e3'
            'c84a878788b46330a0baa4d795cc56e71d32cc1355bdd9c8a62dad912cde5a74'
            '3f43803814805a80cdd5beaebb6f3873713d55a380d11e40dc988cacc9543df3'
            '9b54806ba43ec8c8b2372bca0aa79f0faa7356c4040c4b481a4a3886dc15fae9'
            '1e07a765877ca6a1110633c62e802086e738dac4739d97ff8eeadb4113e0d8ea'
            '9f677bbe9689af43ef434ae6ccab5c2f452c6d060e103df5886e0628399e7588'
            'b62c454f8bfc54da2a1960611db740cb106231ecfecbe802fa986711789f3db0'
            '2b893edb877f3b4d826f08606f578141d034c7b2dcb5f9fdbd37847384fb609d'
            '6e1a5f339cfad459c32c58835520e51e92de98724a184464042de454ab2ac5f3'
            'd654f2eaca7ca5f88a9e63270a6093195ac0503af00d9c40e8840eac77f98fdf'
            'f88a5dcbb1d13dd88a582d47243f6d558d66d39c3a7d2c91723d361dcd3f50ff')

package() {
  install -Dm644 50-bluechip-cameras.conf \
    "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/50-bluechip-cameras.conf"
  install -Dm644 70-bluechip-camera.rules \
    "$pkgdir/usr/lib/udev/rules.d/70-bluechip-camera.rules"

  # Front camera as a V4L2 webcam: v4l2loopback's "Front Camera", filled from
  # libcamera by v4l2-relayd while an app has it open. Enabled by the package;
  # the relay's drop-in checks for this laptop's device tree.
  install -Dm644 bluechip-camera-modprobe.conf \
    "$pkgdir/usr/lib/modprobe.d/bluechip-camera.conf"
  install -Dm644 v4l2-relayd-bluechip.conf \
    "$pkgdir/etc/v4l2-relayd.d/bluechip.conf"
  install -Dm755 bluechip-camera-announce "$pkgdir$_libdir/bluechip-camera-announce"
  install -Dm644 v4l2-relayd-bluechip.service.conf \
    "$pkgdir/usr/lib/systemd/system/v4l2-relayd@bluechip.service.d/bluechip.conf"
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../v4l2-relayd@.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/v4l2-relayd@bluechip.service"

  install -Dm644 ov08x40.yaml "$pkgdir/usr/share/$pkgname/libcamera/ipa/simple/ov08x40.yaml"

  # Restarts the relay when libcamera 0.7.2 leaks its buffers or deadlocks, so
  # the camera doesn't stop mid-call. Enabled by the package; it checks for this
  # laptop's device tree.
  install -Dm755 bluechip-camera-guard "$pkgdir$_libdir/bluechip-camera-guard"
  install -Dm644 bluechip-camera-guard.service \
    "$pkgdir/usr/lib/systemd/system/bluechip-camera-guard.service"
  ln -s ../bluechip-camera-guard.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/bluechip-camera-guard.service"

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
