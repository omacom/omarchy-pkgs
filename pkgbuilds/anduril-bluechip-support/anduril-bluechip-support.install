_stop_retired_services() {
  [ -d /run/systemd/system ] || return 0
  # Stop the guard first so it cannot restart the relay while stopping.
  systemctl stop bluechip-camera-guard.service v4l2-relayd@bluechip.service 2>/dev/null || true
}

pre_upgrade() {
  if [ "$(vercmp "$2" 1-7)" -lt 0 ]; then
    _stop_retired_services
  fi
}

post_upgrade() {
  if [ "$(vercmp "$2" 1-8)" -lt 0 ]; then
    _stop_retired_services
    [ -d /run/systemd/system ] && systemctl daemon-reload 2>/dev/null || true
  fi
}
