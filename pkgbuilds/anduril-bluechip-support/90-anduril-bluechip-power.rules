# Active/idle and sleep power management for the Anduril BlueChip (NY4P9, Glymur).

# Positive DMI guard so machines without DMI or with another board skip all rules.
ATTR{[dmi/id]sys_vendor}=="Anduril", ATTR{[dmi/id]board_name}=="NY4P9", GOTO="bluechip_power_start"
GOTO="bluechip_power_end"
LABEL="bluechip_power_start"

# Enable runtime PM auto-suspend on idle Qualcomm USB controllers and PHYs so
# unused USB GDSCs (gcc_usb20_prim_gdsc, gcc_usb30_mp_gdsc, gcc_usb30_prim_gdsc,
# gcc_usb30_sec_gdsc, ss0/ss1 PHY GDSCs) power down at idle and across s2idle.
ACTION=="add|bind|change", SUBSYSTEM=="platform", DRIVER=="dwc3-qcom", \
  ATTR{power/control}="auto", ATTR{power/autosuspend_delay_ms}="200"
ACTION=="add|bind|change", SUBSYSTEM=="platform", DRIVER=="xhci-hcd", \
  ATTR{power/control}="auto"
ACTION=="add|bind|change", SUBSYSTEM=="platform", DRIVER=="qcom-qmp-combo-phy|qcom-qmp-usb-phy", \
  ATTR{power/control}="auto"

# Disable wakeup on the PCIe4 Wi-Fi root port (0004:00:00.0) and WCN7850
# endpoint (0004:01:00.0) so dw_pcie_suspend_noirq() power-cycles WL_EN via
# pci_pwrctrl across CX collapse instead of setting skip_pwrctrl_off=true
# (which leaves the Wi-Fi 7 chip unable to start MHI on resume, -110).
ACTION=="add|bind|change", SUBSYSTEM=="pci", KERNEL=="0004:00:00.0|0004:01:00.0", \
  ATTR{power/wakeup}="disabled"

LABEL="bluechip_power_end"
