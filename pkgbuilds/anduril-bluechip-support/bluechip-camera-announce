#!/bin/sh
# Tell udev (and so WirePlumber) once the Front Camera loopback switches to Video Capture.
# v4l2loopback with exclusive_caps=1 initially reports output-only capabilities; udev does
# not re-probe when v4l2-relayd opens the output side and unlocks capture.
label="${CARD_LABEL:-Front Camera}"
i=0
while [ "$i" -lt 50 ]; do # up to 10 s
  name=$(grep -Flx "$label" /sys/devices/virtual/video4linux/*/name 2>/dev/null | head -n1)
  if [ -n "$name" ]; then
    node=$(basename "$(dirname "$name")")
    if /usr/bin/v4l2-ctl -d "/dev/$node" --info 2>/dev/null | grep -q "Video Capture"; then
      # Already recorded as capture (e.g. a guard restart mid-call): leave WirePlumber alone.
      if /usr/bin/udevadm info -q property -p "/sys/devices/virtual/video4linux/$node" 2>/dev/null |
        grep -q '^ID_V4L_CAPABILITIES=.*:capture:'; then
        exit 0
      fi
      exec /usr/bin/udevadm trigger --action=change "/sys/devices/virtual/video4linux/$node"
    fi
  fi
  i=$((i + 1))
  sleep 0.2
done
echo "bluechip-camera-announce: $label never switched to Video Capture; WirePlumber will not list it" >&2
exit 1
