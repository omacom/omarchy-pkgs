# Restarts the front camera relay when libcamera 0.7.2 leaks its buffers or
# deadlocks, so the camera keeps working through a call. See the script.
[Unit]
Description=Keep the Anduril BlueChip front camera relay working
ConditionFirmware=|device-tree-compatible(anduril,bluechip)
After=v4l2-relayd@bluechip.service
Wants=v4l2-relayd@bluechip.service
StartLimitIntervalSec=0

[Service]
# Stands down once libcamera 0.8.0, which fixes both faults, is installed: the
# unit is then skipped, neither failed nor restarted.
ExecCondition=/usr/lib/anduril-bluechip-support/bluechip-camera-guard --needed
ExecStart=/usr/lib/anduril-bluechip-support/bluechip-camera-guard
Restart=always
RestartSec=2
