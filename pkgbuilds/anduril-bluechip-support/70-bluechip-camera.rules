# libcamera software ISP buffers need access for the active desktop user
# (user-session tools such as cam/qcam; v4l2-relayd runs as a system service
# with its own DeviceAllow=char-dma_heap rw).
# Keep CMA heaps private: full-resolution colour buffers use system memory.
SUBSYSTEM=="dma_heap", KERNEL=="system", TAG+="uaccess"
