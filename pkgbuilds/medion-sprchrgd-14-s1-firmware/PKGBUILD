# Audio DSP, compute DSP, GPU and video firmware for the Medion SPRCHRGD 14 S1. The firmware only
# runs if it is signed for this board by Medion, so linux-firmware cannot carry it until the OEM
# submits it. The OEM ships it in its Windows driver download, which this recipe unpacks without
# running. Each file is checked against the SHA-256 it was matched to and installed under the name
# the device tree requests, compressed with xz. The kernel tries a plain name, then .zst, then
# .xz, so once linux-firmware ships the same file, its copy is the one loaded, and the two
# packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=medion-sprchrgd-14-s1-firmware
pkgver=20261102
pkgrel=2
pkgdesc='Audio DSP, compute DSP, GPU and video firmware for the Medion SPRCHRGD 14 S1'
arch=('aarch64')
url='https://cdn.medion.com/downloads/treiber/drv_s30_14s1_elite_wx.zip'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1e80100-medion-sprchrgd-14-s1')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'medion-drv-s30-14s1-elite-wx.zip::https://cdn.medion.com/downloads/treiber/drv_s30_14s1_elite_wx.zip'
)
noextract=('medion-drv-s30-14s1-elite-wx.zip')
sha256sums=('97db3a55900067eedc715fdbf68eb8e910fa6b147baade541b908aa9cf5bfe92')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'medion-drv-s30-14s1-elite-wx.zip' 'medion-drv-s30-14s1-elite-wx' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'medion-drv-s30-14s1-elite-wx/qcsubsys_ext_adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1e80100/Medion/sprchrgd-14-s1/adsp_dtbs.elf'
  install -Dm644 'medion-drv-s30-14s1-elite-wx/qcsubsys_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1e80100/Medion/sprchrgd-14-s1/cdsp_dtbs.elf'
  install -Dm644 'medion-drv-s30-14s1-elite-wx/qcsubsys_ext_adsp8380/qcadsp8380.mbn' "$fw"/'qcom/x1e80100/Medion/sprchrgd-14-s1/qcadsp8380.mbn'
  install -Dm644 'medion-drv-s30-14s1-elite-wx/qcsubsys_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1e80100/Medion/sprchrgd-14-s1/qccdsp8380.mbn'
  install -Dm644 'medion-drv-s30-14s1-elite-wx/qcdx8380/qcdxkmsuc8380.mbn' "$fw"/'qcom/x1e80100/Medion/sprchrgd-14-s1/qcdxkmsuc8380.mbn'
  install -Dm644 'medion-drv-s30-14s1-elite-wx/qcdx8380/qcvss8380.mbn' "$fw"/'qcom/x1e80100/Medion/sprchrgd-14-s1/qcvss8380.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
d7a5e0f29bf1f9d215b080a8420f5aab5fe0e370d5a6192ab7d7bac61dd63e23  qcom/x1e80100/Medion/sprchrgd-14-s1/adsp_dtbs.elf
99cf5af4c2503e94fd4f7f65ddf529d9d8ecd20fee293d22c1f049069942b453  qcom/x1e80100/Medion/sprchrgd-14-s1/cdsp_dtbs.elf
a8d004cbf1095ddecd8a0aba0ae2cccb8951f19560778a0152ea615d4d43bcce  qcom/x1e80100/Medion/sprchrgd-14-s1/qcadsp8380.mbn
d3877b0cadf55b67dd77610fc7082175cb8e862a96e019553aa4b399d10eac51  qcom/x1e80100/Medion/sprchrgd-14-s1/qccdsp8380.mbn
063054b8723be0cb16b0699816267b247f17213a5ba36b81d6de5c101abe7bc0  qcom/x1e80100/Medion/sprchrgd-14-s1/qcdxkmsuc8380.mbn
3804756fc5e1d372ac1cc438714a3a5d952d8f6d24dab77b01a4a23b6e9a3eed  qcom/x1e80100/Medion/sprchrgd-14-s1/qcvss8380.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +
}
