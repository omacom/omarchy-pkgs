+{
+	unsigned int i;
+
+	if (!eint->event_pins || !eint->num_event_pins)
+		return;
+
+	for (i = 0; i < eint->num_event_pins; i++)
+		mtk_eint_event_unmask_one(eint, eint->event_pins[i]);
+}
+
