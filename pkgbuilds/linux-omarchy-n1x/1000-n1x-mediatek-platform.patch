+	mtk_eint_apply_event_unmask(eint);
 
 	return 0;
 }
@@ -628,6 +673,11 @@ int mtk_eint_do_init(struct mtk_eint *eint, struct mtk_eint_pin *eint_pin)
 	irq_set_chained_handler_and_data(eint->irq, mtk_eint_irq_handler,
