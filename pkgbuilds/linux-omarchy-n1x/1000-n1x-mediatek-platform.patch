diff --git a/drivers/soc/mediatek/power_wrap/inc/power_wrap.h b/drivers/soc/mediatek/power_wrap/inc/power_wrap.h
index ee0181dab1..a2b64a4c79 100644
--- a/drivers/soc/mediatek/power_wrap/inc/power_wrap.h
+++ b/drivers/soc/mediatek/power_wrap/inc/power_wrap.h
@@ -97,6 +97,8 @@ struct pwrap_driver_data {
 	//struct pwrap_dev_ctrl dev_ctrl;
