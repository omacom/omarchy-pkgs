From 09226e2bd84aa33c507441ec03ebe47c4a0dd1b4 Mon Sep 17 00:00:00 2001
From: Ryan Hughes <ryan@heyoodle.com>
Date: Fri, 2 Oct 2026 20:14:16 -0400
Subject: [PATCH 1075/1078] thunderbolt: nhi: share teardown and export the NHI
 core

Move the teardown from nhi_pci_remove() into nhi_remove() so other host
interface glue can use it, and export nhi_probe(), nhi_remove(),
nhi_pm_ops and nhi_handle_interrupts() in the THUNDERBOLT_NHI namespace.
Glue for host interfaces that are not on PCIe can then be a module of
its own, loaded only on the systems that have such a host interface.
---
 drivers/thunderbolt/nhi.c | 24 ++++++++++++++++++++++++
 drivers/thunderbolt/nhi.h |  1 +
 drivers/thunderbolt/pci.c |  9 +--------
 3 files changed, 26 insertions(+), 8 deletions(-)

diff --git a/drivers/thunderbolt/nhi.c b/drivers/thunderbolt/nhi.c
index 2e26967b0f..08791311c5 100644
--- a/drivers/thunderbolt/nhi.c
+++ b/drivers/thunderbolt/nhi.c
@@ -1294,6 +1294,29 @@ int nhi_probe(struct tb_nhi *nhi)
 
 	return 0;
 }
+EXPORT_SYMBOL_NS_GPL(nhi_probe, "THUNDERBOLT_NHI");
+
+/**
+ * nhi_remove() - Tear down a host interface set up by nhi_probe()
+ * @nhi: Host interface to remove
+ *
+ * Removes the domain, waits for it to be released and shuts the host
+ * interface down. Leaves runtime PM forbidden.
+ */
+void nhi_remove(struct tb_nhi *nhi)
+{
+	struct device *dev = nhi->dev;
+	struct tb *tb = dev_get_drvdata(dev);
+
+	pm_runtime_get_sync(dev);
+	pm_runtime_dont_use_autosuspend(dev);
+	pm_runtime_forbid(dev);
+
+	tb_domain_remove(tb);
+	wait_for_completion(&nhi->domain_released);
+	nhi_shutdown(nhi);
+}
+EXPORT_SYMBOL_NS_GPL(nhi_remove, "THUNDERBOLT_NHI");
 
 /*
  * The tunneled pci bridges are siblings of us. Use resume_noirq to reenable
@@ -1316,3 +1339,4 @@ const struct dev_pm_ops nhi_pm_ops = {
 	.runtime_suspend = nhi_runtime_suspend,
 	.runtime_resume = nhi_runtime_resume,
 };
+EXPORT_SYMBOL_NS_GPL(nhi_pm_ops, "THUNDERBOLT_NHI");
diff --git a/drivers/thunderbolt/nhi.h b/drivers/thunderbolt/nhi.h
index 4fcf818fea..6babd71e4d 100644
--- a/drivers/thunderbolt/nhi.h
+++ b/drivers/thunderbolt/nhi.h
@@ -36,6 +36,7 @@ bool nhi_handle_interrupts(struct tb_nhi *nhi);
 irqreturn_t nhi_msi(int irq, void *data);
 irqreturn_t ring_msix(int irq, void *data);
 int nhi_probe(struct tb_nhi *nhi);
+void nhi_remove(struct tb_nhi *nhi);
 void nhi_shutdown(struct tb_nhi *nhi);
 extern const struct dev_pm_ops nhi_pm_ops;
 
diff --git a/drivers/thunderbolt/pci.c b/drivers/thunderbolt/pci.c
index bbd186c29e..8bf3c961bf 100644
--- a/drivers/thunderbolt/pci.c
+++ b/drivers/thunderbolt/pci.c
@@ -482,15 +482,8 @@ static int nhi_pci_probe(struct pci_dev *pdev, const struct pci_device_id *id)
 static void nhi_pci_remove(struct pci_dev *pdev)
 {
 	struct tb *tb = pci_get_drvdata(pdev);
-	struct tb_nhi *nhi = tb->nhi;
 
-	pm_runtime_get_sync(&pdev->dev);
-	pm_runtime_dont_use_autosuspend(&pdev->dev);
-	pm_runtime_forbid(&pdev->dev);
-
-	tb_domain_remove(tb);
-	wait_for_completion(&nhi->domain_released);
-	nhi_shutdown(nhi);
+	nhi_remove(tb->nhi);
 }
 
 static struct pci_device_id nhi_ids[] = {
