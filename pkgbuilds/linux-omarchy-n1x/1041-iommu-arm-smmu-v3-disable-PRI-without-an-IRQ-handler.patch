From: The Omarchy Authors <dev@omarchy.org>
Subject: [PATCH] iommu/arm-smmu-v3: Disable PRI without an IRQ handler

Backport the failure-path handling proposed by Nicolin Chen in v5 09/15 of the SMMUv3 PRI series to Linux 7.2.5. Missing or failed IRQ requests must clear PRI before interrupt generation and the final CR0 write. Kdump must not advertise PRI either.

This tree does not contain the series' IRQ bookkeeping changes. Keep its existing teardown conventions and add braces around the two single-statement failure paths. Do not enable endpoint PRI or change the GPU DMA-domain quirk.

Upstream-Reference: https://lists.openwall.net/linux-kernel/2026/09/15/2458
---
diff --git a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
--- a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
+++ b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
@@ -4675,11 +4675,14 @@
 							IRQF_ONESHOT,
 							"arm-smmu-v3-priq",
 							smmu);
-			if (ret < 0)
+			if (ret < 0) {
 				dev_warn(smmu->dev,
-					 "failed to enable priq irq\n");
+					 "failed to enable priq irq - disabling PRI\n");
+				smmu->features &= ~ARM_SMMU_FEAT_PRI;
+			}
 		} else {
-			dev_warn(smmu->dev, "no priq irq - PRI will be broken\n");
+			dev_warn(smmu->dev, "no priq irq - disabling PRI\n");
+			smmu->features &= ~ARM_SMMU_FEAT_PRI;
 		}
 	}
 }
@@ -4708,8 +4711,10 @@
 					arm_smmu_combined_irq_thread,
 					IRQF_ONESHOT,
 					"arm-smmu-v3-combined-irq", smmu);
-		if (ret < 0)
+		if (ret < 0) {
 			dev_warn(smmu->dev, "failed to enable combined irq\n");
+			smmu->features &= ~ARM_SMMU_FEAT_PRI;
+		}
 	} else
 		arm_smmu_setup_unique_irqs(smmu);
 
@@ -4874,6 +4879,10 @@
 		dev_err(smmu->dev, "failed to setup irqs\n");
 		return ret;
 	}
+
+	/* IRQ setup can leave the PRI queue without a handler. */
+	if (!(smmu->features & ARM_SMMU_FEAT_PRI))
+		enables &= ~CR0_PRIQEN;
 
 	if (is_kdump_kernel())
 		enables &= ~(CR0_EVTQEN | CR0_PRIQEN);
@@ -5011,7 +5020,7 @@
 	}
 
 	/* Boolean feature flags */
-	if (IS_ENABLED(CONFIG_PCI_PRI) && reg & IDR0_PRI)
+	if (IS_ENABLED(CONFIG_PCI_PRI) && reg & IDR0_PRI && !is_kdump_kernel())
 		smmu->features |= ARM_SMMU_FEAT_PRI;
 
 	if (IS_ENABLED(CONFIG_PCI_ATS) && reg & IDR0_ATS)
