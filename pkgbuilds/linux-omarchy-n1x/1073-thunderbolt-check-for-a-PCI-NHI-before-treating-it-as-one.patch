From 982dd56219fa2dd46ec434cd956dcc361f769681 Mon Sep 17 00:00:00 2001
From: Ryan Hughes <ryan@heyoodle.com>
Date: Fri, 2 Oct 2026 20:13:29 -0400
Subject: [PATCH 1073/1078] thunderbolt: check for a PCI NHI before treating it
 as one

icm_probe() and tb_apple_add_links() convert the NHI device with
to_pci_dev() unconditionally. icm_probe() then reads the PCI device ID,
which would read past the end of the device on a host interface that is
not on PCIe. The firmware connection manager only exists on Intel PCIe
host routers, so return early for anything else in both places.
---
 drivers/thunderbolt/icm.c | 7 ++++++-
 drivers/thunderbolt/tb.c  | 6 ++++--
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/drivers/thunderbolt/icm.c b/drivers/thunderbolt/icm.c
index 669807f0ea..7f38b4d7a6 100644
--- a/drivers/thunderbolt/icm.c
+++ b/drivers/thunderbolt/icm.c
@@ -2478,10 +2478,15 @@ static const struct tb_cm_ops icm_icl_ops = {
 
 struct tb *icm_probe(struct tb_nhi *nhi)
 {
-	struct pci_dev *pdev = to_pci_dev(nhi->dev);
+	struct pci_dev *pdev;
 	struct icm *icm;
 	struct tb *tb;
 
+	/* Firmware connection managers only run on Intel PCIe host routers */
+	if (!dev_is_pci(nhi->dev))
+		return NULL;
+	pdev = to_pci_dev(nhi->dev);
+
 	tb = tb_domain_alloc(nhi, ICM_TIMEOUT, sizeof(struct icm));
 	if (!tb)
 		return NULL;
diff --git a/drivers/thunderbolt/tb.c b/drivers/thunderbolt/tb.c
index f43f2d9523..c2fe727800 100644
--- a/drivers/thunderbolt/tb.c
+++ b/drivers/thunderbolt/tb.c
@@ -3311,13 +3311,15 @@ static const struct tb_cm_ops tb_cm_ops = {
  */
 static bool tb_apple_add_links(struct tb_nhi *nhi)
 {
-	struct pci_dev *nhi_pdev = to_pci_dev(nhi->dev);
+	struct pci_dev *nhi_pdev;
 	struct pci_dev *upstream, *pdev;
 	bool ret;
 
-	if (!x86_apple_machine)
+	if (!x86_apple_machine || !dev_is_pci(nhi->dev))
 		return false;
 
+	nhi_pdev = to_pci_dev(nhi->dev);
+
 	switch (nhi_pdev->device) {
 	case PCI_DEVICE_ID_INTEL_LIGHT_RIDGE:
 	case PCI_DEVICE_ID_INTEL_CACTUS_RIDGE_4C:
-- 
