From e913ccc6495263079ed6f7ae530e56b497575073 Mon Sep 17 00:00:00 2001
From: Ryan Hughes <ryan@heyoodle.com>
Date: Fri, 2 Oct 2026 10:43:42 -0400
Subject: [PATCH] HID: asus: turn the keyboard backlight off for sleep without
 asus-wmi

On laptops without asus-wmi, such as the arm64 ProArt P14, hid-asus
drives the keyboard backlight itself and nothing else turns it off
when the system sleeps: the keyboard stays lit through suspend.
Set the level to 0 on suspend; asus_resume() already restores the
level on the way back.
---
 drivers/hid/hid-asus.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/drivers/hid/hid-asus.c b/drivers/hid/hid-asus.c
index 791a78bd5e..a42acd5c20 100644
--- a/drivers/hid/hid-asus.c
+++ b/drivers/hid/hid-asus.c
@@ -1237,6 +1237,28 @@ static int asus_start_multitouch(struct hid_device *hdev)
 	return 0;
 }
 
+static int __maybe_unused asus_suspend(struct hid_device *hdev,
+				       pm_message_t message)
+{
+	struct asus_drvdata *drvdata = hid_get_drvdata(hdev);
+	const u8 buf[] = { FEATURE_KBD_REPORT_ID, 0xba, 0xc5, 0xc4, 0x00 };
+	int ret;
+
+	/*
+	 * Without asus-wmi nothing else turns the keyboard backlight off for
+	 * sleep, so it would stay lit. asus_resume() restores the level.
+	 */
+	if (!drvdata->kbd_backlight || !drvdata->kbd_backlight->standalone)
+		return 0;
+
+	cancel_work_sync(&drvdata->kbd_backlight->work);
+	ret = asus_kbd_set_report(hdev, buf, sizeof(buf));
+	if (ret < 0)
+		hid_err(hdev, "Asus failed to turn off keyboard backlight: %d\n", ret);
+
+	return 0;
+}
+
 static int __maybe_unused asus_resume(struct hid_device *hdev)
 {
 	struct asus_drvdata *drvdata = hid_get_drvdata(hdev);
@@ -1635,6 +1657,7 @@ static struct hid_driver asus_driver = {
 	.remove			= asus_remove,
 	.input_mapping          = asus_input_mapping,
 	.input_configured       = asus_input_configured,
+	.suspend		= pm_ptr(asus_suspend),
 	.reset_resume           = pm_ptr(asus_reset_resume),
 	.resume			= pm_ptr(asus_resume),
 	.event			= asus_event,
-- 
