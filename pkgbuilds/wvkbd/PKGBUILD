pkgname=wvkbd
pkgver=0.21
pkgrel=2
pkgdesc='On-screen keyboard for Wayland'
arch=('x86_64' 'aarch64')
url='https://git.sr.ht/~proycon/wvkbd'
license=('GPL-3.0-only' 'MIT')
depends=('cairo' 'glibc' 'pango' 'wayland')
makedepends=('libxkbcommon' 'scdoc')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz"
        'wvkbd-0.21-output.patch')
sha256sums=('9fbe3beca107d1ebbee90116d891a353df8deadeea491edea96fb29a5bff9378'
            '59a51efad82a7e31dddd724bc7f9302dfad4a50fa402976b70ece8e75819f61d')

prepare() {
  # Keep makepkg's compiler flags alongside the upstream version defines.
  sed -i 's/^CFLAGS = /CFLAGS += /' "$pkgname-v$pkgver/config.mk"
  # Backport connector selection so handheld controls stay on the built-in panel.
  patch -d "$pkgname-v$pkgver" -Np1 -i "$srcdir/wvkbd-0.21-output.patch"
}

build() {
  make -C "$pkgname-v$pkgver"
}

package() {
  make -C "$pkgname-v$pkgver" PREFIX=/usr DESTDIR="$pkgdir" install
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    "$pkgname-v$pkgver/"{LICENSE,COPYING,COPYING_WESTON}
}
