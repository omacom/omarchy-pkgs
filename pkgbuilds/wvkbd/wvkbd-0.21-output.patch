+                die("wvkbd: --output requires a Wayland connector name\n");
+            }
+            output_connector = argv[++i];
@@ -1219,0 +1326 @@ main(int argc, char **argv)
+    wl_list_init(&outputs);
@@ -1240 +1347 @@ main(int argc, char **argv)
-    // A second round-trip to receive wl_outputs events
+    // A second round-trip to receive the advertised wl_output names.
@@ -1241,0 +1349 @@ main(int argc, char **argv)
+    keyboard_output();
diff --git a/wvkbd.1.scd b/wvkbd.1.scd
index 4a3a62b..64607bc 100644
--- a/wvkbd.1.scd
+++ b/wvkbd.1.scd
@@ -50,0 +51,5 @@ can be patched to add new features.
+*--output* _CONNECTOR_
+	Show on the named Wayland output, e.g. eDP-1. The name must exactly match
+	one advertised by the compositor. If that output is unavailable or removed,
+	exit with an error. By default the compositor selects the output.
+
