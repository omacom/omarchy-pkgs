--- a/main.c
+++ b/main.c
@@ -53,0 +54,10 @@ static bool layer_surface_configured;
+struct output {
+    struct wl_list link;
+    struct wl_output *wl;
+    uint32_t global;
+};
+
+static struct wl_list outputs;
+static struct output *selected_output;
+static const char *output_connector;
+
@@ -145,0 +156 @@ static void hide();
+static void output_unavailable(void);
@@ -184,0 +196,2 @@ wl_surface_enter(void *data, struct wl_surface *wl_surface,
+    if (selected_output && wl_output != selected_output->wl)
+        output_unavailable();
@@ -209,0 +223,61 @@ static const struct wl_surface_listener surface_listener = {
+static void
+output_unavailable(void)
+{
+    hide();
+    wl_display_flush(display);
+    die("wvkbd: Wayland output '%s' is unavailable\n", output_connector);
+}
+
+static void
+output_geometry(void *data, struct wl_output *output, int32_t x, int32_t y,
+                int32_t width, int32_t height, int32_t subpixel,
+                const char *make, const char *model, int32_t transform)
+{
+}
+
+static void
+output_mode(void *data, struct wl_output *output, uint32_t flags,
+            int32_t width, int32_t height, int32_t refresh)
+{
+}
+
+static void
+output_done(void *data, struct wl_output *output)
+{
+}
+
+static void
+output_scale(void *data, struct wl_output *output, int32_t scale)
+{
+}
+
+static void
+output_name(void *data, struct wl_output *output, const char *name)
+{
+    if (strcmp(name, output_connector) == 0)
+        selected_output = data;
+}
+
+static void
+output_description(void *data, struct wl_output *output, const char *description)
+{
+}
+
+static const struct wl_output_listener output_listener = {
+    .geometry = output_geometry,
+    .mode = output_mode,
+    .done = output_done,
+    .scale = output_scale,
+    .name = output_name,
+    .description = output_description,
+};
+
+static struct wl_output *
+keyboard_output(void)
+{
+    if (output_connector && !selected_output)
+        output_unavailable();
+
+    return selected_output ? selected_output->wl : NULL;
+}
+
@@ -226,0 +301,2 @@ initiate_closed(void *data, struct zwlr_layer_surface_v1 *surface)
+    if (output_connector)
+        output_unavailable();
@@ -473,0 +550,11 @@ handle_global(void *data, struct wl_registry *registry, uint32_t name,
+    } else if (output_connector && strcmp(interface, wl_output_interface.name) == 0 &&
+               version >= WL_OUTPUT_NAME_SINCE_VERSION) {
+        struct output *output = calloc(1, sizeof(*output));
+        if (!output) {
+            die("wvkbd: could not allocate Wayland output\n");
+        }
+        output->global = name;
+        output->wl = wl_registry_bind(registry, name, &wl_output_interface,
+                                     WL_OUTPUT_NAME_SINCE_VERSION);
+        wl_list_insert(&outputs, &output->link);
+        wl_output_add_listener(output->wl, &output_listener, output);
@@ -479,0 +567,12 @@ handle_global_remove(void *data, struct wl_registry *registry, uint32_t name)
+    struct output *output;
+    wl_list_for_each(output, &outputs, link) {
+        if (output->global != name)
+            continue;
+        if (output == selected_output)
+            output_unavailable();
+
+        wl_output_release(output->wl);
+        wl_list_remove(&output->link);
+        free(output);
+        return;
+    }
@@ -660,0 +760,3 @@ layer_surface_closed(void *data, struct zwlr_layer_surface_v1 *surface)
+    if (output_connector)
