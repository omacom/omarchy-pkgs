66ce8531efb7979d234e0f0eabbe18d038ac97da771a8a194f613df8f0724e81  qcom/glymur/hp/omnibook-ultra-14-kg0xxx/adspr.jsn
12ac2f3ae8ced12aa4b06b3ab3a01bc4d8efe1c92ebea503c002f209a6ec176f  qcom/glymur/hp/omnibook-ultra-14-kg0xxx/adsps.jsn
982a99853495e34726b8e44697fdfad303334de0a67cbf6cde306c8f1731000b  qcom/glymur/hp/omnibook-ultra-14-kg0xxx/adspua.jsn
9bee104a48d4aac647287d6c1454df170c1cff7158a2352711fd1e2163ea6d1d  qcom/glymur/hp/omnibook-ultra-14-kg0xxx/cdsp_dtbs.elf
0b68b188aac54f7beecb3234c19e794092864a4690aafea20bf379643305bf93  qcom/glymur/hp/omnibook-ultra-14-kg0xxx/qcadsp8480.mbn
acf13d29288d283793f418a36650e8a261eed927d30de109a59cb2210f458794  qcom/glymur/hp/omnibook-ultra-14-kg0xxx/qccdsp8480.mbn
