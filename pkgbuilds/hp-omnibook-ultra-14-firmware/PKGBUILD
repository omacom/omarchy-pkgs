# Audio DSP and compute DSP firmware for the HP OmniBook Ultra 14. The firmware only runs if it is
# signed for this board by HP, so linux-firmware cannot carry it until the OEM submits it. The OEM
# ships it in its Windows driver download, which this recipe unpacks without running. The files
# are installed unmodified, under the names the device tree requests, and checked against the
# SHA-256 each was matched to.
#
# Generated from https://arewearmyet.com/firmware-sources.json by bin/snapdragon-firmware-recipes;
# change the table, not this file.

pkgname=hp-omnibook-ultra-14-firmware
pkgver=20261102
pkgrel=1
pkgdesc='Audio DSP and compute DSP firmware for the HP OmniBook Ultra 14'
arch=('aarch64')
url='https://ftp.hp.com/pub/softpaq/sp174001-174500/sp174082.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-glymur-hp-omnibook-ultra-14-kg0xxx')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  "hp-sp174082.exe::https://ftp.hp.com/pub/softpaq/sp174001-174500/sp174082.exe"
)
noextract=('hp-sp174082.exe')
sha256sums=('98fe80a7588e1c3cc4a460726c9907e28a1fd6e5f18669d9187554804002c7dd')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'hp-sp174082.exe' 'hp-sp174082' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'hp-sp174082/src/Driver/qcsubsys_ext_adsp8480_fix_listen_WHQL/adsp_dtbs.elf' "$fw/qcom/glymur/hp/omnibook-ultra-14-kg0xxx/adsp_dtbs.elf"
  install -Dm644 'hp-sp174082/src/Driver/qcsubsys_ext_adsp8480_fix_listen_WHQL/adspr.jsn' "$fw/qcom/glymur/hp/omnibook-ultra-14-kg0xxx/adspr.jsn"
  install -Dm644 'hp-sp174082/src/Driver/qcsubsys_ext_adsp8480_fix_listen_WHQL/adsps.jsn' "$fw/qcom/glymur/hp/omnibook-ultra-14-kg0xxx/adsps.jsn"
  install -Dm644 'hp-sp174082/src/Driver/qcsubsys_ext_adsp8480_fix_listen_WHQL/adspua.jsn' "$fw/qcom/glymur/hp/omnibook-ultra-14-kg0xxx/adspua.jsn"
  install -Dm644 'hp-sp174082/src/Driver/qcnspmcdm8480/cdsp_dtbs.elf' "$fw/qcom/glymur/hp/omnibook-ultra-14-kg0xxx/cdsp_dtbs.elf"
  install -Dm644 'hp-sp174082/src/Driver/qcsubsys_ext_adsp8480_fix_listen_WHQL/qcadsp8480.mbn' "$fw/qcom/glymur/hp/omnibook-ultra-14-kg0xxx/qcadsp8480.mbn"
  install -Dm644 'hp-sp174082/src/Driver/qcnspmcdm8480/qccdsp8480.mbn' "$fw/qcom/glymur/hp/omnibook-ultra-14-kg0xxx/qccdsp8480.mbn"

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
