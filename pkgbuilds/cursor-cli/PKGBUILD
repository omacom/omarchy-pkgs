# Maintainer: The Omarchy Authors
pkgname=cursor-cli
pkgver=2026.11.22.1.e9042b2
# Upstream is YYYY.MM.DD-<hash>. pkgver cannot contain hyphens, and hashes are
# not monotonically ordered, so pkgver is YYYY.MM.DD.<n>.<hash>: n resets to 1
# on a new date and increments when the same date gets a new hash.
# Derive the upstream version (YYYY.MM.DD-<hash>) from that pkgver.
_upstream_ver="${pkgver%.*}"
_upstream_ver="${_upstream_ver%.*}-${pkgver##*.}"
pkgrel=2
# epoch=1: bumped when switching from the original `20250808.0.<sha>` scheme
# to the current `YYYY.MM.DD.<n>.<hash>` scheme (2025-08-09). Never decrease.
epoch=1
pkgdesc="Cursor Agent, the terminal coding agent from Cursor"
arch=('x86_64' 'aarch64')
url="https://cursor.com/cli"
license=('LicenseRef-Cursor')
depends=('gcc-libs' 'glibc' 'git' 'zlib')
# Upstream bundles its own node, ripgrep and native modules; leave them as built.
options=('!strip' '!debug')
source=('Cursor-TOS')
source_x86_64=("cursor-cli-${_upstream_ver}-x86_64.tar.gz::https://downloads.cursor.com/lab/${_upstream_ver}/linux/x64/agent-cli-package.tar.gz")
source_aarch64=("cursor-cli-${_upstream_ver}-aarch64.tar.gz::https://downloads.cursor.com/lab/${_upstream_ver}/linux/arm64/agent-cli-package.tar.gz")
b2sums=('d241ee9895bdb1c17514438fde8528222a8f2326568bd7a033d7a1b11432ce6b4575ff1a50625764bfe6bc6f8a9dc060f7439c3be7e95f8fd02912cdd37a011d')
b2sums_x86_64=('8ac7350dd767e8cebeeb2b2d7bfef4650a0e45d401e346666b31fa8e31bfc2182b56045ec66a869daed5e9a1469482f55aa980599958a4d0308ca0249b8c5b94')
b2sums_aarch64=('68b9037ae69e72652b9a394df88431dbb5e1bd59095255e038015b6c35190d21618459f0dc1fc66a7f5d064ca1604a1d25e69316150e5a23aa2edc3675ec63ec')

package() {
  # cursor-agent runs its bundled node, workers and native modules from beside itself.
  install -dm755 "${pkgdir}/usr/lib" "${pkgdir}/usr/bin"
  cp -r --no-preserve=ownership "${srcdir}/dist-package" "${pkgdir}/usr/lib/cursor-cli"
  install -Dm644 Cursor-TOS "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # pacman updates this install, so keep the CLI from updating itself in the
  # background into ~/.local/share/cursor-agent (and ~/.local/bin ahead of it).
  cat >"${pkgdir}/usr/bin/cursor-agent" <<'WRAPPER'
#!/bin/bash
exec /usr/lib/cursor-cli/cursor-agent --disable-auto-update "$@"
WRAPPER
  chmod 755 "${pkgdir}/usr/bin/cursor-agent"
}
