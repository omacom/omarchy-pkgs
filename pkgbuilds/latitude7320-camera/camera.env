LD_LIBRARY_PATH=/opt/latitude7320-camera/lib
LIBCAMERA_IPA_MODULE_PATH=/opt/latitude7320-camera/lib/libcamera/ipa
LIBCAMERA_IPA_CONFIG_PATH=/opt/latitude7320-camera/share/libcamera/ipa
GST_PLUGIN_PATH=/opt/latitude7320-camera/lib/gstreamer-1.0
LIBCAMERA_SOFTISP_MODE=cpu
LIBCAMERA_RGBIR=1
RGBIR_FRONT_ONLY=1
RGBIR_THREADS=4
RGBIR_IRSUB=0
RGBIR_IRSUB_ADAPT=1
RGBIR_DENOISE=0.25
RGBIR_CHROMA_BLUR=2
RGBIR_CCM_HIGHLIGHT=0.85
RGBIR_EXPOSURE_TARGET=2.5
RGBIR_ANALOGUE_GAIN_MAX=2.0
