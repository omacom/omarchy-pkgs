pre_install() {
  if [[ $(cat /sys/class/dmi/id/sys_vendor) != 'Dell Inc.' ||
        $(cat /sys/class/dmi/id/product_name) != 'Latitude 7320 Detachable' ]]; then
    echo 'latitude7320-camera supports only the Dell Latitude 7320 Detachable.' >&2
    return 1
  fi
  if command -v dkms >/dev/null && dkms status | grep -Eq '^(camera-dell7320|rear-camera-dell7320)/'; then
    echo 'Migrate/remove the previous camera-dell7320 and rear-camera-dell7320 DKMS packages first.' >&2
    return 1
  fi
}

pre_upgrade() {
  pre_install
}

post_install() {
  echo 'Experimental camera drivers installed; no service or facial authentication enabled.'
  echo 'Read /usr/share/latitude7320-camera/README.md before running latitude-camera-setup enable.'
}

pre_remove() {
  if [[ -e /etc/latitude7320-camera/enabled ]]; then
    /usr/bin/latitude-camera-setup disable
  fi
}
