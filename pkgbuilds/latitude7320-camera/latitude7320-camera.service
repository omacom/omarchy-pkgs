[Unit]
Description=Latitude 7320 on-demand processed camera feeds
After=systemd-udevd.service
Wants=latitude-camera-discovery.service
ConditionPathExists=/etc/latitude7320-camera/enabled

[Service]
User=latitude-camera
SupplementaryGroups=video
ExecStart=/usr/bin/python /usr/lib/latitude7320-camera/latitude-demand-camera.py
EnvironmentFile=/usr/share/latitude7320-camera/camera.env
EnvironmentFile=-/etc/latitude7320-camera/camera.env
StateDirectory=latitude7320-camera
RuntimeDirectory=latitude7320-camera
Environment=GST_REGISTRY=/var/lib/latitude7320-camera/registry.bin
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
