prepare() {
  cd "$srcdir/libcamera"
  git apply "$srcdir/libcamera-rgbir.patch"
  for name in rgbir_to_bayer.cpp rgbir_to_bayer.h temporal_denoise.cpp temporal_denoise.h thread_pool.h; do
    cp "$srcdir/$name" src/libcamera/software_isp/
  done
  cp "$srcdir/ov5675.yaml" src/ipa/simple/data/ov5675.yaml
  mkdir -p "$srcdir/kernel" "$srcdir/pipewire-enumerator"
  for name in tps68470.c tps68470.h tps68470_board_data.c ov5675.c ipu-bridge.c ov8856.c dw9714.c Makefile dkms.conf; do
    cp "$srcdir/$name" "$srcdir/kernel/"
  done
  for name in config.h plugin.c v4l2.h v4l2-udev.c; do
    cp "$srcdir/pipewire-$name" "$srcdir/pipewire-enumerator/$name"
  done
}

build() {
  arch-meson "$srcdir/libcamera" "$srcdir/build" --prefix=/opt/latitude7320-camera --libdir=lib \
    -Dpipelines=simple -Dipas=simple -Dgstreamer=enabled \
    -Ddocumentation=disabled -Dtest=false -Dcam=disabled -Dqcam=disabled \
    -Dlc-compliance=disabled -Dpycamera=disabled -Dtracing=disabled
  meson compile -C "$srcdir/build" -j4
  cc -shared -fPIC -O2 -Wall -Wextra -ffile-prefix-map="$srcdir"=. \
    -o "$srcdir/libspa-latitude-camera-enum.so" \
    "$srcdir/pipewire-enumerator/v4l2-udev.c" "$srcdir/pipewire-enumerator/plugin.c" \
    $(pkg-config --cflags --libs libspa-0.2 libudev libsystemd)
}

check() {
  g++ -std=c++17 -O2 -Wall -Wextra -o "$srcdir/test-threads" \
    "$srcdir/test-threads.cpp" "$srcdir/rgbir_to_bayer.cpp" -lpthread
  "$srcdir/test-threads"
  make -C /usr/src/linux-omarchy M="$srcdir/kernel" modules
  python -m py_compile "$srcdir/latitude-demand-camera.py" "$srcdir/latitude-camera-discovery.py" "$srcdir/rear-camera-focus.py"
  bash -n "$srcdir/latitude-camera" "$srcdir/latitude-camera-setup"
}

package() {
  DESTDIR="$pkgdir" meson install -C "$srcdir/build"
  install -Dm755 "$srcdir/libspa-latitude-camera-enum.so" \
    "$pkgdir/usr/lib/spa-0.2/latitude-camera/libspa-latitude-camera-enum.so"
  for name in tps68470.c tps68470.h tps68470_board_data.c ov5675.c ipu-bridge.c ov8856.c dw9714.c Makefile dkms.conf; do
    install -Dm644 "$srcdir/$name" "$pkgdir/usr/src/$pkgname-$pkgver/$name"
  done
  for name in latitude-demand-camera.py latitude-camera-discovery.py rear-camera-focus.py; do
    install -Dm755 "$srcdir/$name" "$pkgdir/usr/lib/latitude7320-camera/$name"
  done
  for name in latitude-camera latitude-camera-setup; do
    install -Dm755 "$srcdir/$name" "$pkgdir/usr/bin/$name"
  done
  for name in latitude7320-camera.service latitude-camera-discovery.service; do
    install -Dm644 "$srcdir/$name" "$pkgdir/usr/lib/systemd/system/$name"
  done
  install -Dm644 "$srcdir/latitude-camera.sysusers" "$pkgdir/usr/lib/sysusers.d/latitude-camera.conf"
  for name in camera.env latitude-camera-loopback.conf latitude-camera-modules.conf \
      72-latitude-camera-private.rules latitude-camera-enumerator.conf latitude-camera-sources.conf latitude-camera-firmware.conf README.md; do
    install -Dm644 "$srcdir/$name" "$pkgdir/usr/share/latitude7320-camera/$name"
  done
  for name in latitude-front-camera.desktop latitude-rear-camera.desktop; do
    install -Dm644 "$srcdir/$name" "$pkgdir/usr/share/applications/$name"
  done
  install -Dm644 "$srcdir/libcamera/LICENSES/MIT.txt" "$pkgdir/usr/share/licenses/$pkgname/MIT.txt"
}
