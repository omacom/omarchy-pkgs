#!/bin/bash
set -euo pipefail
case "${1:-}" in
  front) device=/dev/video0 ;;
  rear)
    /usr/bin/python /usr/lib/latitude7320-camera/rear-camera-focus.py
    device=/dev/video1
    ;;
  *) echo 'Usage: latitude-camera front|rear' >&2; exit 2 ;;
esac
exec /usr/bin/gst-launch-1.0 -q v4l2src device="$device" \
  ! video/x-raw,format=YUY2,width=1280,height=720,framerate=30/1 \
  ! videoconvert ! autovideosink sync=false
