#!/bin/bash
set -euo pipefail
[[ $EUID == 0 ]] || { echo 'Run with sudo.' >&2; exit 1; }
[[ $(cat /sys/class/dmi/id/sys_vendor) == 'Dell Inc.' &&
   $(cat /sys/class/dmi/id/product_name) == 'Latitude 7320 Detachable' ]] || {
  echo 'This experimental setup supports only the Dell Latitude 7320 Detachable.' >&2
  exit 1
}
resources=/usr/share/latitude7320-camera
case "${1:-}" in
  enable)
    # Do not silently replace another loopback configuration or local service.
    for path in /etc/modprobe.d/latitude-camera-loopback.conf \
      /etc/modules-load.d/latitude-camera-modules.conf \
      /etc/mkinitcpio.conf.d/latitude-camera-firmware.conf \
      /etc/udev/rules.d/72-latitude-camera-private.rules \
      /etc/wireplumber/wireplumber.conf.d/latitude-camera-enumerator.conf \
      /etc/wireplumber/wireplumber.conf.d/latitude-camera-sources.conf; do
      if [[ -e $path || -L $path ]]; then
        [[ -L $path && $(readlink "$path") == "$resources/${path##*/}" ]] || {
          echo "Existing configuration needs manual migration: $path" >&2; exit 1;
        }
      fi
    done
    if systemctl is-enabled latitude-front-camera.service >/dev/null 2>&1; then
      echo 'Disable the previous local camera service and migrate its settings first.' >&2
      exit 1
    fi
    if dkms status | grep -Eq '^(camera-dell7320|rear-camera-dell7320)/'; then
      echo 'Remove the previous local camera DKMS packages before enabling this package.' >&2
      exit 1
    fi
    systemd-sysusers /usr/lib/sysusers.d/latitude-camera.conf
    install -d /etc/latitude7320-camera /etc/modprobe.d /etc/modules-load.d /etc/mkinitcpio.conf.d \
      /etc/udev/rules.d /etc/wireplumber/wireplumber.conf.d
    ln -sfn "$resources/latitude-camera-loopback.conf" /etc/modprobe.d/latitude-camera-loopback.conf
    ln -sfn "$resources/latitude-camera-modules.conf" /etc/modules-load.d/latitude-camera-modules.conf
    ln -sfn "$resources/latitude-camera-firmware.conf" /etc/mkinitcpio.conf.d/latitude-camera-firmware.conf
    ln -sfn "$resources/72-latitude-camera-private.rules" /etc/udev/rules.d/72-latitude-camera-private.rules
    for name in latitude-camera-enumerator.conf latitude-camera-sources.conf; do
      ln -sfn "$resources/$name" "/etc/wireplumber/wireplumber.conf.d/$name"
    done
    touch /etc/latitude7320-camera/enabled
    udevadm control --reload-rules
    systemctl daemon-reload
    systemctl enable latitude7320-camera.service
    echo 'Rebuild your boot image, then reboot to load all camera drivers together.'
    echo 'On Omarchy: sudo limine-mkinitcpio linux-omarchy'
    ;;
  disable)
    systemctl disable --now latitude7320-camera.service
    rm -f /etc/latitude7320-camera/enabled
    for path in /etc/modprobe.d/latitude-camera-loopback.conf \
      /etc/modules-load.d/latitude-camera-modules.conf \
      /etc/mkinitcpio.conf.d/latitude-camera-firmware.conf \
      /etc/udev/rules.d/72-latitude-camera-private.rules \
      /etc/wireplumber/wireplumber.conf.d/latitude-camera-enumerator.conf \
      /etc/wireplumber/wireplumber.conf.d/latitude-camera-sources.conf; do
      if [[ -L $path && $(readlink "$path") == "$resources/${path##*/}" ]]; then
        rm "$path"
      fi
    done
    udevadm control --reload-rules
    echo 'Restart WirePlumber in your user session. Remove the package, rebuild the boot image, and reboot to restore stock drivers.'
    ;;
  *) echo 'Usage: latitude-camera-setup enable|disable' >&2; exit 2 ;;
esac
