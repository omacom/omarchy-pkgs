  "source": "local",
  "auto_merge": true,
  "upstream": {
    "watch": {
      "github": "omacom/omareel",
      "pattern": "v(?P<version>[0-9]+(?:\\.[0-9]+)*)"
    }
  },
  "rebuild_on": [
    "hyprland",
    "layer-shell-qt",
    "qt6-base",
    "qt6-declarative"
