# Maintainer: Ryan <ryan@heyoodle.com>

pkgname=omareel
pkgver=0.5.0
pkgrel=2
pkgdesc='Screen recorder and editor for Omarchy with a synthetic cursor, auto zooms, and a camera bubble'
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/omareel'
license=('MIT')
install='omareel.install'
# LTO would put GCC bytecode inside the Rust static library, which then fails to link.
options=('!debug' '!lto')
depends=(
  'ffmpeg'
  'gpu-screen-recorder'
  'hicolor-icon-theme'
  'hyprland'
  'layer-shell-qt'
  'libevdev'
  'libjpeg-turbo'
  'qt6-base'
  'qt6-declarative'
  'qt6-multimedia'
  'qt6-svg'
  'slurp'
  'xdg-desktop-portal'
)
makedepends=(
  'cargo'
  'cmake'
  'corrosion'
  'ninja'
  'pkgconf'
  'qt6-shadertools'
  'wayland'
)
optdepends=('gifsicle: optimize exported GIF files')
conflicts=('omarecord')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('fe1d62903a19935deb63df3eec4fd8aecb1cc09bc8077abdb98f23795b014d95')
# Hyprland 0.56.2's headers, for a second capture-exclusion plugin while Omarchy's stable
# channel runs 0.56; the app loads whichever build matches the running Hyprland. Drop these
# once stable moves to 0.57. Only headers are taken. aquamarine's, hyprgraphics' and hyprutils'
# are the same on both architectures, so the permanent Arch archive serves both; Omarchy
# patches its aarch64 Hyprland, so that one comes from Omarchy's stable repository. They sit
# in the architecture arrays so that sha256sums stays the release tarball's alone.
_archive=https://archive.archlinux.org/packages
_hypr056_headers=(
  'aquamarine-0.15.1-1-x86_64.pkg.tar.zst'
  'hyprgraphics-0.5.1-4-x86_64.pkg.tar.zst'
  'hyprutils-0.14.2-1-x86_64.pkg.tar.zst'
)
_hypr056_sources=("$_archive/a/aquamarine/${_hypr056_headers[0]}"
                  "$_archive/h/hyprgraphics/${_hypr056_headers[1]}"
                  "$_archive/h/hyprutils/${_hypr056_headers[2]}")
_hypr056_sums=('ac96995cceea132e32cafd9bf63fd6cbe3d0599ab175e82bcee85b0c7da9706c'
               'c916b1fb9d7ad0e78fab2d94b0066dcdc8be0a2810be7e72df57ddf5b639fea3'
               '177dfe5d64dba65ef2f1274d84d647b12cc1bc0b808394fd556f135ac8d7e65e')
source_x86_64=("${_hypr056_sources[@]}" "$_archive/h/hyprland/hyprland-0.56.2-4-x86_64.pkg.tar.zst")
sha256sums_x86_64=("${_hypr056_sums[@]}" '163bc740241880192d90027fad39ddb809b1705b04800a1f0185a58f3ce0884a')
source_aarch64=("${_hypr056_sources[@]}" 'https://pkgs.omarchy.org/stable/aarch64/hyprland-0.56.2-7-aarch64.pkg.tar.zst')
sha256sums_aarch64=("${_hypr056_sums[@]}" 'e803467584537b9e1c5dfdac80b71c2e4bb4829ed23c084c143dcfe93f1dbce5')
noextract=("${_hypr056_headers[@]}" 'hyprland-0.56.2-4-x86_64.pkg.tar.zst' 'hyprland-0.56.2-7-aarch64.pkg.tar.zst')

prepare() {
  local sdk="$srcdir/hyprland-0.56.2" header
  rm -rf "$sdk"
  mkdir -p "$sdk"
  for header in "${_hypr056_headers[@]}" hyprland-0.56.2-*-"$CARCH".pkg.tar.zst; do
    bsdtar -xf "$srcdir/$header" -C "$sdk" usr/include
  done
  cd "$srcdir/$pkgname-$pkgver"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  # Corrosion builds the crates with --locked; everything was fetched in prepare().
  export CARGO_NET_OFFLINE=true
  ./bin/build -DOMAREEL_EXTRA_HYPRLAND_SDKS="$srcdir/hyprland-0.56.2/usr"
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 build/omareel "$pkgdir/usr/bin/omareel"
  ln -s omareel "$pkgdir/usr/bin/omarecord"
  # The capture-exclusion plugin is bound to the Hyprland commit it was built
  # against; rebuild_on hyprland keeps this package in step with the compositor.
  # The builds for other Hyprland versions go to hyprland-<version>/ beside it.
  local plugin
  for plugin in build/plugin/omareel-capture-exclude.so build/plugin/hyprland-*/omareel-capture-exclude.so; do
    install -Dm755 "$plugin" "$pkgdir/usr/lib/omareel/${plugin#build/plugin/}"
    install -Dm644 "$plugin.hash" "$pkgdir/usr/lib/omareel/${plugin#build/plugin/}.hash"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSES/lucide.txt "$pkgdir/usr/share/licenses/$pkgname/lucide.txt"
  install -Dm644 LICENSES/inter.txt "$pkgdir/usr/share/licenses/$pkgname/inter.txt"
  install -Dm644 LICENSES/cxx-qt-cmake-MIT.txt "$pkgdir/usr/share/licenses/$pkgname/cxx-qt-cmake-MIT.txt"
  install -Dm644 LICENSES/rust-crates.txt "$pkgdir/usr/share/licenses/$pkgname/rust-crates.txt"
  install -Dm644 pkg/omareel.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omareel.svg"
  local size
  for size in 16 32 48 64 128 256 512; do
    install -Dm644 "pkg/icons/omareel-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/omareel.png"
  done
  install -Dm644 pkg/omareel.desktop "$pkgdir/usr/share/applications/omareel.desktop"
}
