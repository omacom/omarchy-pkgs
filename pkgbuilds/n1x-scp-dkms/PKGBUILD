pkgname=n1x-scp-dkms
pkgver=0.2.0
pkgrel=2
pkgdesc='NVIDIA N1X SCP bounded firmware diagnostics (manual loading)'
arch=('aarch64')
url='https://github.com/johannhartmann/asus-proart-p16-rtx-spark-linux'
license=('GPL-2.0-only')
depends=('dkms')
makedepends=('gcc' 'python')
source=('Kbuild' 'README.md' 'README.package.md' 'dkms.conf' 'n1x_scp.c' 'source-provenance.json' 'test_package.py' 'test_snapshot.py' 'test_mailbox.py')
sha256sums=('f29b39dad7e4c5795c6e075680149dad09e7bb4015c68c23d555eb73518af1d2' '813d3865df2543ac19214c10becaa3579e72fa35d8e1757a5a8714d160ade4cc' '6c4e5266c57cfdcc17c545ee8a78f6c5ae868124840cd07a470279836418ddca' '0b3aac3f01ede19e1a385f4cacbccc6c8c662c6a567e91d711405136b8910397' '2df4c7139c1c52b07a8404a6b2faeed4b4f61edbefb748a12ec33ab45510acc1' '81f6041ce4dea4fc4bd0f5268f98108d2085897386f790023f3b15b0ddf647fe' '8e9aadcb2e6cc55c975ce9eaace0cff6a36c6cf963d790c62fb6f131ba8cf1cf' '427df361b8b4e3e1586cc56c638aff9b2e918f693ecf71e7714b95a8f14e6199' '78b5b986f292e96a2e6103658a76c1347b8fc5b2fa74c6b070a1560fd8776dab')

check() {
  cd "$srcdir"
  python test_mailbox.py
  python test_snapshot.py
  python test_package.py
}

package() {
  install -Dm644 "$srcdir/n1x_scp.c" "$pkgdir/usr/src/n1x-scp-$pkgver/n1x_scp.c"
  install -Dm644 "$srcdir/Kbuild" "$pkgdir/usr/src/n1x-scp-$pkgver/Kbuild"
  install -Dm644 "$srcdir/dkms.conf" "$pkgdir/usr/src/n1x-scp-$pkgver/dkms.conf"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/README.package.md" "$pkgdir/usr/share/doc/$pkgname/README.package.md"
  install -Dm644 "$srcdir/source-provenance.json" "$pkgdir/usr/share/doc/$pkgname/source-provenance.json"
  install -Dm644 "$srcdir/test_package.py" "$pkgdir/usr/share/doc/$pkgname/test_package.py"
  install -Dm644 "$srcdir/test_mailbox.py" "$pkgdir/usr/share/doc/$pkgname/test_mailbox.py"
  install -Dm644 "$srcdir/test_snapshot.py" "$pkgdir/usr/share/doc/$pkgname/test_snapshot.py"
}
