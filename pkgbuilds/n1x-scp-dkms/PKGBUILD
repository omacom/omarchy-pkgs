pkgname=n1x-scp-dkms
pkgver=0.2.0
pkgrel=1
pkgdesc='NVIDIA N1X SCP bounded firmware diagnostics (manual loading)'
arch=('aarch64')
url='https://github.com/johannhartmann/asus-proart-p16-rtx-spark-linux'
license=('GPL-2.0-only')
depends=('dkms')
makedepends=('gcc' 'python')
source=('Kbuild' 'README.md' 'README.package.md' 'dkms.conf' 'n1x_scp.c' 'source-provenance.json' 'test_package.py' 'test_snapshot.py')
sha256sums=('f29b39dad7e4c5795c6e075680149dad09e7bb4015c68c23d555eb73518af1d2' '2f1fa63bd229e8db9f8cacdf5b63d0dfefbc09328c3a9aea00b04eaab3d23427' '87b0683a382232f4db047ac5fe90cd75ca456139f2eda90fbc329b828f6f155f' '0b3aac3f01ede19e1a385f4cacbccc6c8c662c6a567e91d711405136b8910397' 'e12ec5d3e333a10753dc4d634191748d0f4738d243e3d13ef1b1478c81fabea3' '32f91b337b19ca6695df7cfca161b0fa05555ac7887f026a2ec3f271cfed5ba9' '8e9aadcb2e6cc55c975ce9eaace0cff6a36c6cf963d790c62fb6f131ba8cf1cf' '427df361b8b4e3e1586cc56c638aff9b2e918f693ecf71e7714b95a8f14e6199')

check() {
  cd "$srcdir"
  python test_snapshot.py
  python test_package.py
}

package() {
  install -Dm644 "$srcdir/n1x_scp.c" "$pkgdir/usr/src/n1x-scp-$pkgver/n1x_scp.c"
  install -Dm644 "$srcdir/Kbuild" "$pkgdir/usr/src/n1x-scp-$pkgver/Kbuild"
  install -Dm644 "$srcdir/dkms.conf" "$pkgdir/usr/src/n1x-scp-$pkgver/dkms.conf"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/README.package.md" "$pkgdir/usr/share/doc/$pkgname/README.package.md"
  install -Dm644 "$srcdir/source-provenance.json" "$pkgdir/usr/share/doc/$pkgname/source-provenance.json"
  install -Dm644 "$srcdir/test_package.py" "$pkgdir/usr/share/doc/$pkgname/test_package.py"
  install -Dm644 "$srcdir/test_snapshot.py" "$pkgdir/usr/share/doc/$pkgname/test_snapshot.py"
}
