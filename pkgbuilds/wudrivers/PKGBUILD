pkgname=wudrivers
pkgver=0.1.0
pkgrel=2
pkgdesc='Find and download the driver bundle a PC maker publishes on Windows Update'
url='https://github.com/birkskyum/wudrivers'
arch=('any')
license=('MIT')
depends=('python')
optdepends=('cabextract: unpack the driver cabinets with --extract'
            '7zip: unpack the driver cabinets with --extract')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('4a96f525c2f396ac6af8d95224f8d546715f38416dc10df9d0b302a14ad83788')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  PYTHONPATH=src python -m unittest discover -s tests
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
