_aurora_wip_modules() {
  local dir
  for dir in /usr/lib/modules/*/; do
    if [[ -f ${dir}pkgbase && $(<"${dir}pkgbase") == "$1" ]]; then
      printf '%s\n' "${dir%/}"
      return 0
    fi
  done
  return 1
}

# m1n1 stage 2 carries linux-aurora's device trees, and this kernel boots with
# them. A difference in this Mac's is drift to know about, not a failure.
_aurora_wip_device_tree() {
  local model wip default dtb
  [[ -r /proc/device-tree/compatible ]] || return 0
  model=$(tr '\0' '\n' </proc/device-tree/compatible | head -n 1)
  [[ $model =~ ^apple,[a-z0-9]+$ ]] || return 0
  wip=$(_aurora_wip_modules linux-aurora-wip) && default=$(_aurora_wip_modules linux-aurora) || return 0
  for dtb in "$default"/dtbs/*.dtb; do
    tr '\0' '\n' <"$dtb" | grep -Eq "(^|[^a-z0-9,])$model\$" || continue
    cmp -s "$dtb" "$wip/dtbs/${dtb##*/}" && return 0
    cat <<EOF
==> linux-aurora-wip's device tree for this Mac (${dtb##*/}) differs from linux-aurora's.
    It boots with linux-aurora's, so hardware that needs the new one may not work yet.
EOF
    return 0
  done
}

_aurora_wip_notice() {
  cat <<'EOF'
==> linux-aurora-wip is a second boot menu entry, after linux-aurora, which stays the default.
    To test it, pick it in the boot menu; any other boot starts linux-aurora.
    While it runs, omarchy-apple-silicon-boot-check refuses (it checks linux-aurora's boot).
    To remove it, boot linux-aurora and run: sudo pacman -Rns linux-aurora-wip linux-aurora-wip-headers
EOF
  [[ -e /var/lib/omarchy/limine.enabled ]] ||
    echo "==> This Mac boots GRUB, which may start linux-aurora-wip first. It is for Limine Macs: remove it."
  _aurora_wip_device_tree
}

post_install() {
  _aurora_wip_notice
}

post_upgrade() {
  _aurora_wip_device_tree
}
