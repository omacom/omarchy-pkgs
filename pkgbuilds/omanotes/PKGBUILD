# Maintainer: Cristian Fleischer <cristian.fleischer@gmail.com>

pkgname=omanotes
pkgver=0.6.0
pkgrel=1
pkgdesc='Markdown notes app and fast viewer with a notes sidebar, built on Omawrite'
arch=('x86_64' 'aarch64')
url='https://github.com/cristian-fleischer/omanotes'
license=('MIT' 'OFL-1.1' 'HPND')
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
  'xdg-desktop-portal'
)
optdepends=('ripgrep: faster content search in the sidebar')
makedepends=(
  'gcc'
  'make'
)
checkdepends=(
  'noto-fonts'
  'noto-fonts-cjk'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a063acc12f91096ad737a11bcc302bdd01477b09169e07c354df8f8dc77525b2')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/test
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/omanotes "$pkgdir/usr/bin/omanotes"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  install -Dm644 third_party/lexilla/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.lexilla"
  install -Dm644 pkgbuild/omanotes.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omanotes.svg"
  install -Dm644 pkgbuild/omanotes.desktop "$pkgdir/usr/share/applications/omanotes.desktop"
}
