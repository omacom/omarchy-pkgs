# Maintainer: pch <https://github.com/pch>
pkgname=rawmakase-bin
pkgver=0.4.0
pkgrel=1
pkgdesc="Fast, Lightroom-compatible RAW photo editor (binary release)"
arch=(x86_64 aarch64)
url="https://github.com/pch/rawmakase"
license=(MIT)
# LibRaw, lcms2, libjpeg and ONNX Runtime are bundled under /usr/lib/rawmakase
# and found through the binary's $ORIGIN runpath. The windowing, input and GPU
# libraries are dlopen'd, so this list follows upstream's own Arch recipe
# rather than the ELF NEEDED entries.
depends=(dbus gcc-libs glibc hicolor-icon-theme libglvnd libx11 libxcb
         libxcursor libxi libxkbcommon libxkbcommon-x11 libxrandr
         vulkan-icd-loader wayland zlib)
# A Vulkan ICD is needed to draw, but as a hard dependency makepkg -s would
# resolve it to nvidia-utils in the build container; Omarchy installs the right
# driver per machine.
optdepends=('vulkan-driver: GPU rendering'
            'xdg-desktop-portal: native file dialogs')
provides=(rawmakase)
conflicts=(rawmakase)
options=(!strip !debug)
source_x86_64=("$url/releases/download/v$pkgver/rawmakase-$pkgver-x86_64-linux.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/rawmakase-$pkgver-aarch64-linux.tar.gz")
sha256sums_x86_64=('4eedc4ab3b40e5e8c97f052dc9a099a6b279eb07aeaac049f0b29d65554ac6dd')
sha256sums_aarch64=('55e558f28049857f59da49ac586ffbe722eb2df6e965d0a553684650288fc09f')

package() {
  # The release tarball is a ready usr/ tree: a launcher script in /usr/bin,
  # the binary and its bundled libraries in /usr/lib/rawmakase, plus the
  # desktop entry, icon and licences.
  cp -a "$srcdir/usr" "$pkgdir/"
  mv "$pkgdir/usr/share/licenses/rawmakase" "$pkgdir/usr/share/licenses/$pkgname"
}
