pkgname=hid-nintendo2-dkms
pkgver=0.1.0.r1.g32a981e
pkgrel=1
pkgdesc='USB HID driver for Nintendo Switch 2 controllers'
arch=('any')
url='https://github.com/XenuIsWatching/hid-nintendo2-dkms'
license=('GPL-2.0-or-later')
depends=('dkms')
optdepends=('linux-omarchy-headers: build the module for linux-omarchy'
            'clang: build the module for kernels compiled with Clang'
            'llvm: build the module for kernels compiled with Clang'
            'lld: link the module for kernels compiled with Clang')
_commit=32a981ea7f916f1792a7e35aa0ecf79063ec4001
source=("hid-nintendo2-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz")
sha256sums=('19e6ba4ef5349f6e0e14fd27a51c9bb175e416f1b445144d65a7103c47b9cd76')

prepare() {
  cd "hid-nintendo2-dkms-${_commit}"
  # Keep the DKMS identity in sync with this pinned source snapshot.
  sed -i "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"${pkgver}\"/" dkms.conf
}

package() {
  cd "hid-nintendo2-dkms-${_commit}"
  install -Dm644 -t "${pkgdir}/usr/src/hid-nintendo2-${pkgver}" \
    hid-nintendo2.c Makefile dkms.conf
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
