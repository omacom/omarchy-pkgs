# Maintainer: The Omarchy Authors
pkgname=openai-codex
pkgver=0.172.0
pkgrel=1
pkgdesc="OpenAI's coding agent that runs in your terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/openai/codex"
license=('Apache-2.0')
depends=('glibc')
optdepends=('git: allow for repository actions')
# Arch's voice helper pins Arch's own openai-codex; this one carries voice mode.
conflicts=('openai-codex-voice')
# The voice runtime checks its libraries against the hashes in runtime.json.
options=('!strip' '!debug')
source=('LICENSE' 'NOTICE')
source_x86_64=("codex-${pkgver}-x86_64.tar.gz::https://github.com/openai/codex/releases/download/rust-v${pkgver}/codex-package-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("codex-${pkgver}-aarch64.tar.gz::https://github.com/openai/codex/releases/download/rust-v${pkgver}/codex-package-aarch64-unknown-linux-musl.tar.gz")
noextract=("codex-${pkgver}-${CARCH}.tar.gz")
sha256sums=(
  'd17f227e4df5da1600391338865ce0f3055211760a36688f816941d58232d8dc'
  '9d71575ecfd9a843fc1677b0efb08053c6ba9fd686a0de1a6f5382fd3c220915'
)
sha256sums_x86_64=('63e3b00065ed7f62166d0522e17f663cb866a31d80d03e63365482ed34a1d991')
sha256sums_aarch64=('faf17b8071927f33346a805dc8cb45de4e08c0d75cf0e5e68cecddca28b8861e')

package() {
  # Upstream's standalone package: Codex finds its sandbox, ripgrep and voice
  # runtime through codex-package.json beside the binary.
  local root="${pkgdir}/usr/lib/openai-codex"
  install -dm755 "${root}" "${pkgdir}/usr/bin"
  bsdtar --no-same-owner -xf "codex-${pkgver}-${CARCH}.tar.gz" -C "${root}"

  # pacman updates this install, so Codex's own check for a newer release
  # would only nag. A -c override applies to every subcommand.
  cat >"${pkgdir}/usr/bin/codex" <<'WRAPPER'
#!/bin/sh
exec /usr/lib/openai-codex/bin/codex -c check_for_update_on_startup=false "$@"
WRAPPER
  chmod 755 "${pkgdir}/usr/bin/codex"

  # Keep the binary off the network and out of the builder's home while it
  # writes its completions.
  local home="${srcdir}/home"
  mkdir -p "${home}"
  install -d "${pkgdir}/usr/share/bash-completion/completions" \
    "${pkgdir}/usr/share/zsh/site-functions" \
    "${pkgdir}/usr/share/fish/vendor_completions.d"
  HOME="${home}" "${root}/bin/codex" -c check_for_update_on_startup=false completion bash >"${pkgdir}/usr/share/bash-completion/completions/codex"
  HOME="${home}" "${root}/bin/codex" -c check_for_update_on_startup=false completion zsh >"${pkgdir}/usr/share/zsh/site-functions/_codex"
  HOME="${home}" "${root}/bin/codex" -c check_for_update_on_startup=false completion fish >"${pkgdir}/usr/share/fish/vendor_completions.d/codex.fish"

  install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" LICENSE NOTICE
}
