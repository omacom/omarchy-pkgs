{
  "source": "local",
  "upstream": {
    "watch": {
      "github": "obsproject/obs-studio",
      "pattern": "(?P<version>[0-9]+(?:\\.[0-9]+)*)"
    }
  },
  "rebuild_on": [
    "ffmpeg",
    "libdatachannel",
    "libfdk-aac",
    "librist",
    "libva",
    "luajit",
    "mbedtls3",
    "python",
    "srt",
    "x264"
  ]
}
