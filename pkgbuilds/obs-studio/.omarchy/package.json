{
  "source": "local",
  "upstream": {
    "watch": {
      "github": "obsproject/obs-studio",
      "pattern": "(?P<version>[0-9]+(?:\\.[0-9]+)*)"
    }
  },
  "rebuild_on": [
    "ffmpeg",
    "libdatachannel",
    "libfdk-aac",
    "librist",
    "libva",
    "luajit",
    "mbedtls3",
    "python",
    "srt",
    "x264"
  ],
  "rebuilt_against": {
    "aarch64": {
      "ffmpeg": "2:9.1-1",
      "libdatachannel": "0.24.5-3",
      "libfdk-aac": "3.0.0-1",
      "librist": "0.2.20-1",
      "libva": "2.24.1-1",
      "luajit": "2.1.1795687819+3bfb8fa-1",
      "mbedtls3": "3.6.7-1",
      "python": "3.14.10-1",
      "srt": "1.5.7-3",
      "x264": "3:0.165.r3222.b35605a-2"
    }
  }
}
