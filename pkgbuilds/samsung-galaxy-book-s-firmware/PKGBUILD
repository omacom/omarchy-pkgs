# Audio DSP, compute DSP, GPU and modem firmware for the Samsung Galaxy Book S. The firmware only
# runs if it is signed for this board by Samsung, so linux-firmware cannot carry it until the OEM
# submits it. The OEM ships it in the driver bundle it publishes for the machine on Windows
# Update, whose cabinets this recipe fetches with wudrivers and unpacks without running anything.
# Each file is checked against the SHA-256 it was matched to and installed under the name the
# device tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so
# once linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=samsung-galaxy-book-s-firmware
pkgver=20261116
pkgrel=1
pkgdesc='Audio DSP, compute DSP, GPU and modem firmware for the Samsung Galaxy Book S'
arch=('aarch64')
url='https://github.com/birkskyum/wudrivers'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-samsung-w767')
makedepends=('7zip' 'wudrivers')
options=('!strip' '!debug')
# Windows Update's links are short-lived, so wudrivers fetches a fresh one by update ID, revision and SHA-1.
DLAGENTS+=('wu::/usr/bin/wudrivers fetch %u -o %o')
source=(
  'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcsubsys-ext-cdsp8180.cab::wu://809f4e4e-5cd6-413e-a02b-2f480c16ea97/1/7148262bc53894856196ef36e23798f315dc7f5b'
  'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcsubsys-ext-adsp8180.cab::wu://809f4e4e-5cd6-413e-a02b-2f480c16ea97/1/1309e0637a651486b8bfe5787ec6cc464ab51c1a'
  'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcdx8180.cab::wu://809f4e4e-5cd6-413e-a02b-2f480c16ea97/1/ed1719eaaf12377682796d86dc47b61d46ec5b09'
  'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcsubsys-ext-mpss8180.cab::wu://809f4e4e-5cd6-413e-a02b-2f480c16ea97/1/201e1b626c7c78cb98e5259ac247a828fdd91451'
)
source+=('README.package.md')
noextract=('samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcsubsys-ext-cdsp8180.cab' 'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcsubsys-ext-adsp8180.cab' 'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcdx8180.cab' 'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcsubsys-ext-mpss8180.cab')
sha256sums=('3f8b392d3d99c1e3df9a66f0d20ed28760dbe261737fc795610ade94e2c9ce8f' '1de90d36e2aeae67956e46f6ea2a5512bcb9ebaf1105c7eebb5b69697b585506' '1fa296f8247b2cf0768079d2d1a0bf3a3c4b715d040273303b9614cb636f07ef' '3e698d6ab1f5817336e68ee16019277de3b8a0036f1c8fb9abb7f319ffc64282')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcsubsys-ext-cdsp8180.cab' 'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcsubsys-ext-cdsp8180' 7z
  _unpack 'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcsubsys-ext-adsp8180.cab' 'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcsubsys-ext-adsp8180' 7z
  _unpack 'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcdx8180.cab' 'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcdx8180' 7z
  _unpack 'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcsubsys-ext-mpss8180.cab' 'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcsubsys-ext-mpss8180' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcsubsys-ext-adsp8180/qcadsp8180.mbn' "$fw"/'qcom/samsung/w767/qcadsp8180.mbn'
  install -Dm644 'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcsubsys-ext-cdsp8180/qccdsp8180.mbn' "$fw"/'qcom/samsung/w767/qccdsp8180.mbn'
  install -Dm644 'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcdx8180/qcdxkmsuc8180.mbn' "$fw"/'qcom/samsung/w767/qcdxkmsuc8180.mbn'
  install -Dm644 'samsung-galaxy-book-s-pahp-wu-200.0.25.0-qcsubsys-ext-mpss8180/qcmpss8180_XEF.mbn' "$fw"/'qcom/samsung/w767/qcmpss8180_XEF.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
9a84b218a468120c93ae982e5e0da18c6b8d6ffc90587e12fa395d3970b86e4b  qcom/samsung/w767/qcadsp8180.mbn
4989653e99b027457ae102970b001ca5c34658b8a6ddb6fc59610aa17a981012  qcom/samsung/w767/qccdsp8180.mbn
7bc9035fc38bcdc49e0a2ffbb797e65cf331592e4fab3984ae2fdacf271a4bbb  qcom/samsung/w767/qcdxkmsuc8180.mbn
ecefb772cc57531edff255d59bf5639e35f00359b438eb2f4586218110e65663  qcom/samsung/w767/qcmpss8180_XEF.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
