# Audio DSP, compute DSP and GPU firmware for the Microsoft Windows Dev Kit 2023. The firmware
# only runs if it is signed for this board by Microsoft, so linux-firmware cannot carry it until
# the OEM submits it. The OEM ships it in its Windows driver download, which this recipe unpacks
# without running. Each file is checked against the SHA-256 it was matched to and installed under
# the name the device tree requests, compressed with xz. The kernel tries a plain name, then .zst,
# then .xz, so once linux-firmware ships the same file, its copy is the one loaded, and the two
# packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=microsoft-windows-dev-kit-2023-firmware
pkgver=20261106
pkgrel=1
pkgdesc='Audio DSP, compute DSP and GPU firmware for the Microsoft Windows Dev Kit 2023'
arch=('aarch64')
url='https://www.microsoft.com/en-us/download/details.aspx?id=105941'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-sc8280xp-microsoft-blackrock')
makedepends=('7zip' 'msitools')
options=('!strip' '!debug')
source=(
  'microsoft-surfacepro9-5g.msi::https://download.microsoft.com/download/9ba185b4-fd54-44da-9c54-adb8b2bc6c09/SurfacePro9-5G_Win11_22631_26.062.19189.0.msi'
)
noextract=('microsoft-surfacepro9-5g.msi')
sha256sums=('f371bbe1c262ad4526b16e898b30958eeeb7df38e7e87026cc2ff781829c23eb')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'microsoft-surfacepro9-5g.msi' 'microsoft-surfacepro9-5g' msi
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'microsoft-surfacepro9-5g/SurfaceUpdate/surfaceproextadsp8280/qcadsp8280.mbn' "$fw"/'qcom/sc8280xp/microsoft/blackrock/qcadsp8280.mbn'
  install -Dm644 'microsoft-surfacepro9-5g/SurfaceUpdate/surfaceproextcdsp8280/qccdsp8280.mbn' "$fw"/'qcom/sc8280xp/microsoft/blackrock/qccdsp8280.mbn'
  install -Dm644 'microsoft-surfacepro9-5g/SurfaceUpdate/qcdx8280/qcdxkmsuc8280.mbn' "$fw"/'qcom/sc8280xp/microsoft/blackrock/qcdxkmsuc8280.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
bfa1382134cfe9c053607ae0ed8d319ed83459b2e731f4fdd5b93458063af1d6  qcom/sc8280xp/microsoft/blackrock/qcadsp8280.mbn
5da3feeb5ca7231c14a3dcfa1a137644f2955dca46909897334bb4012df06320  qcom/sc8280xp/microsoft/blackrock/qccdsp8280.mbn
3847033eee563763317b918e047c83b42b9e76341be6f1912e65619019e8f3be  qcom/sc8280xp/microsoft/blackrock/qcdxkmsuc8280.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +
}
