# Maintainer: The Omarchy Authors
pkgname=antigravity-cli
pkgver=1.5.18
pkgrel=1
pkgdesc="Google Antigravity CLI (agy), a terminal coding agent"
arch=('x86_64' 'aarch64')
url="https://github.com/google-antigravity/antigravity-cli"
license=('LicenseRef-Google-Antigravity')
depends=('glibc')
options=('!strip' '!debug')
_dl="https://github.com/google-antigravity/antigravity-cli/releases/download/${pkgver}"
# TERMS is https://antigravity.google/terms, which the README names as the CLI's terms.
source=('TERMS')
source_x86_64=("agy-${pkgver}-x86_64.tar.gz::${_dl}/agy_cli_linux_x64.tar.gz")
source_aarch64=("agy-${pkgver}-aarch64.tar.gz::${_dl}/agy_cli_linux_arm64.tar.gz")
noextract=("agy-${pkgver}-x86_64.tar.gz" "agy-${pkgver}-aarch64.tar.gz")
sha256sums=('e13239673ed0adf44fe2eeab19e3e33ebca2d8fa4851ee548f018c3d47f646f1')
sha256sums_x86_64=('a4960723ed9cf5b5ac72ed541db8df4d62741795261eb93a4681006ccb23d5ad')
sha256sums_aarch64=('97799abac91ba0b29b77598b62f903b866461da17680263a182fef2cb796ab0d')

package() {
  # The archive holds one binary, named antigravity. Install it as agy only:
  # /usr/bin/antigravity belongs to the antigravity desktop app.
  install -d "${pkgdir}/usr/bin"
  bsdtar --no-same-owner -xOf "${srcdir}/agy-${pkgver}-${CARCH}.tar.gz" antigravity >"${pkgdir}/usr/bin/agy"
  chmod 755 "${pkgdir}/usr/bin/agy"

  # agy has no switch for its background self-update. It skips the update when
  # the directory holding the binary is not writable, as /usr/bin is not, so
  # pacman stays the only thing that replaces it.

  install -Dm644 "${srcdir}/TERMS" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
