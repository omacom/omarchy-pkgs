pkgname=automountd
pkgver=0.2.0
pkgrel=1
pkgdesc='Small daemon that automounts removable drives through UDisks2'
arch=('x86_64' 'aarch64')
url='https://github.com/yamz8/automountd'
license=('MIT')
depends=('gcc-libs' 'glibc' 'udisks2')
makedepends=('cargo' 'git')
source=("automountd::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd automountd
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd automountd
  export CARGO_TARGET_DIR=target
  # Let makepkg strip the binary and split the symbols into the -debug package.
  export CARGO_PROFILE_RELEASE_STRIP=false
  cargo build --frozen --release
}

check() {
  cd automountd
  cargo test --frozen
}

package() {
  cd automountd
  install -Dm755 target/release/automountd -t "$pkgdir/usr/bin"
  install -Dm644 automountd.service -t "$pkgdir/usr/lib/systemd/user"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
