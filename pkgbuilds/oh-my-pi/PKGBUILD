# Maintainer: The Omarchy Authors
pkgname=oh-my-pi
pkgver=19.2.1
pkgrel=1
pkgdesc="Oh My Pi, a terminal coding agent with the IDE wired in"
arch=('x86_64' 'aarch64')
url="https://omp.sh"
license=('MIT')
depends=('glibc')
optdepends=(
  'git: repository integration and isolated task worktrees'
  'python: Python eval backend'
  'chromium: system browser for the browser tool'
  'libpulse: PulseAudio/PipeWire client backend for voice'
  'at-spi2-core: accessibility backend for the computer tool'
  'xdg-desktop-portal: Wayland input for the computer tool'
  'sshfs: mount SSH remote workspaces'
)
# The binary is a Bun executable with its JavaScript appended; stripping breaks it.
options=('!strip' '!debug')
source=('LICENSE')
# Upstream builds omp-linux-x64 for Bun's baseline target, so it needs no AVX2.
source_x86_64=("omp-${pkgver}-x86_64::https://github.com/can1357/oh-my-pi/releases/download/v${pkgver}/omp-linux-x64")
source_aarch64=("omp-${pkgver}-aarch64::https://github.com/can1357/oh-my-pi/releases/download/v${pkgver}/omp-linux-arm64")
sha256sums=('16c45f9d667442781f03fa198914cc39abcaa48ec5ed8f644643e554ca2fbf63')
sha256sums_x86_64=('e8b937f9bf023baa147bdd300ad5421af0a6ef8b1f350c47a9a93d5fca94feca')
sha256sums_aarch64=('92d4cce4b14814f6b838aa86dcec6359f0cb089cbcc300e8463cbb5326991fe0')

package() {
  local root="${pkgdir}/usr/lib/oh-my-pi"
  install -Dm755 "omp-${pkgver}-${CARCH}" "${root}/bin/omp"

  # pacman updates this install. omp leaves an install alone, with no update
  # check, auto-update or `omp update`, when the folder two above its real
  # path holds a manager.json naming who keeps it current. The /usr/bin link
  # must stay a symlink so that real path resolves here.
  printf '{"manager": "pacman", "name": "pacman"}\n' >"${root}/manager.json"
  chmod 644 "${root}/manager.json"
  install -dm755 "${pkgdir}/usr/bin"
  ln -s ../lib/oh-my-pi/bin/omp "${pkgdir}/usr/bin/omp"

  local home="${srcdir}/home"
  mkdir -p "${home}"
  install -d "${pkgdir}/usr/share/bash-completion/completions" \
    "${pkgdir}/usr/share/zsh/site-functions" \
    "${pkgdir}/usr/share/fish/vendor_completions.d"
  HOME="${home}" "${root}/bin/omp" completions bash >"${pkgdir}/usr/share/bash-completion/completions/omp"
  HOME="${home}" "${root}/bin/omp" completions zsh >"${pkgdir}/usr/share/zsh/site-functions/_omp"
  HOME="${home}" "${root}/bin/omp" completions fish >"${pkgdir}/usr/share/fish/vendor_completions.d/omp.fish"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
