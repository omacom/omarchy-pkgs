#!/bin/bash
set -euo pipefail
mode=${1:---install}
[[ $# -le 1 && ( $mode == --install || $mode == --remove ) ]] || exit 2

readonly dmi_root=/sys/class/dmi/id
readonly acpi_root=/sys/bus/acpi/devices
readonly config_source=/usr/share/p16-audio/80-p16-internal-sinks.conf
readonly service_source=/usr/lib/systemd/user/p16-audio-jack.service
readonly config_installer=/usr/libexec/p16-audio/install-user-config
readonly legacy_config=/etc/wireplumber/wireplumber.conf.d/80-p16-internal-sinks.conf
readonly runtime_root=/run/user

uid=${SUDO_UID:-1000}
passwd_entry=$(getent passwd "$uid")
user=$(cut -d: -f1 <<<"$passwd_entry")
user_home=$(cut -d: -f6 <<<"$passwd_entry")
[[ -n $user ]] || exit 1
[[ -n $user_home && $user_home == /* ]] || exit 1
run_user_helper() {
  runuser -u "$user" -- env HOME="$user_home" XDG_CONFIG_HOME="$user_home/.config" \
    P16_AUDIO_CONFIG_SOURCE="$config_source" \
    P16_AUDIO_SERVICE_SOURCE="$service_source" \
    "$config_installer" "$@"
}

model=$(<"$dmi_root/product_name")
board=$(<"$dmi_root/board_name")
if [[ $mode == --install && ( $model != 'ProArt P16 H7607BA' || $board != 'H7607BA' ) ]]; then
  exit 0
fi
if [[ $mode == --install && ! -e $acpi_root/NVDA6210:00 ]]; then
  exit 0
fi

if [[ $mode == --remove ]]; then
  runtime_bus="$runtime_root/$uid/bus"
  if [[ -S $runtime_bus ]]; then
    runuser -u "$user" -- env HOME="$user_home" XDG_RUNTIME_DIR="$runtime_root/$uid" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime_bus" \
      systemctl --user disable --now p16-audio-jack.service 'p16-audio-host@*.service' || true
    runuser -u "$user" -- env HOME="$user_home" XDG_RUNTIME_DIR="$runtime_root/$uid" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime_bus" \
      systemctl --user daemon-reload || true
  fi
  removed_rules=$(run_user_helper --remove)
  if [[ -f $legacy_config && ! -L $legacy_config ]] && cmp -s -- "$config_source" "$legacy_config"; then
    rm -- "$legacy_config"
    removed_rules=rules-removed
  fi
  # Existing ALSA nodes retain their properties until the monitor recreates them.
  if [[ $removed_rules == rules-removed && -S $runtime_bus ]]; then
    runuser -u "$user" -- env HOME="$user_home" XDG_RUNTIME_DIR="$runtime_root/$uid" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime_bus" \
      systemctl --user try-restart wireplumber.service
  fi
  exit 0
fi

run_user_helper

# Retire only the exact global rule written by the previous package version.
if [[ -f $legacy_config && ! -L $legacy_config ]] && cmp -s -- "$config_source" "$legacy_config"; then
  rm -- "$legacy_config"
fi

if [[ -S $runtime_root/$uid/bus ]]; then
  runuser -u "$user" -- env HOME="$user_home" XDG_RUNTIME_DIR="$runtime_root/$uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
    systemctl --user daemon-reload
  runuser -u "$user" -- env HOME="$user_home" XDG_RUNTIME_DIR="$runtime_root/$uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
    systemctl --user enable p16-audio-jack.service
fi
