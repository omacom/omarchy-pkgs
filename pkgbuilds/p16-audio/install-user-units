#!/bin/bash
set -euo pipefail
uid=${SUDO_UID:-1000}
user=$(getent passwd "$uid" | cut -d: -f1)
[[ -n $user ]] || exit 1
model=$(</sys/class/dmi/id/product_name)
board=$(</sys/class/dmi/id/board_name)
[[ $model == 'ProArt P16 H7607BA' && $board == 'H7607BA' ]] || exit 0
[[ -e /sys/bus/acpi/devices/NVDA6210:00 ]] || exit 0
mkdir -p /etc/wireplumber/wireplumber.conf.d
cat > /etc/wireplumber/wireplumber.conf.d/80-p16-internal-sinks.conf <<'EOF'
monitor.alsa.rules = [
  {
    matches = [ { node.name = "alsa_output.platform-mtk_sdw_mc.HiFi__Speaker__sink" } ]
    actions = { update-props = { media.class = "Audio/Sink/Internal" } }
  }
  {
    matches = [ { node.name = "alsa_output.platform-mtk_sdw_mc.HiFi__Headphones__sink" } ]
    actions = { update-props = { media.class = "Audio/Sink/Internal" } }
  }
]
EOF

if [[ -S /run/user/$uid/bus ]]; then
  runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
    systemctl --user daemon-reload
  runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
    systemctl --user enable p16-audio-jack.service
else
  user_home=$(getent passwd "$uid" | cut -d: -f6)
  install -d -o "$uid" -g "$(id -g "$user")" "$user_home/.config/systemd/user/pipewire.service.wants"
  ln -sfn /usr/lib/systemd/user/p16-audio-jack.service "$user_home/.config/systemd/user/pipewire.service.wants/p16-audio-jack.service"
fi
