#!/bin/bash
set -euo pipefail

model=$(</sys/class/dmi/id/product_name)
board=$(</sys/class/dmi/id/board_name)
[[ $model == 'ProArt P16 H7607BA' && $board == 'H7607BA' ]] || exit 0
[[ -e /sys/bus/acpi/devices/NVDA6210:00 ]] || exit 0

modprobe mt8901_acp_sdw_legacy_mach

card=mt8901soundwire
for _ in {1..50}; do
  amixer -c "$card" controls >/dev/null 2>&1 && break
  sleep 0.2
done
amixer -c "$card" controls >/dev/null

amixer -c "$card" cset name='cs42l43 Speaker Digital Switch' off,off
amixer -c "$card" cset name='Speaker Switch' off
amixer -c "$card" cset name='AMP1 Speaker Switch' off
amixer -c "$card" cset name='AMP2 Speaker Switch' off
amixer -c "$card" cset name='Headphone Switch' on
amixer -c "$card" cset name='cs42l43 Speaker Digital Volume' 100,100
amixer -c "$card" cset name='cs42l43 Speaker L Input 1 Volume' 32
amixer -c "$card" cset name='cs42l43 Speaker R Input 1 Volume' 32
amixer -c "$card" cset name='cs42l43 Speaker L Input 1' DP5RX1
amixer -c "$card" cset name='cs42l43 Speaker R Input 1' DP5RX2
amixer -c "$card" cset name='cs42l43 Headphone Digital Volume' 229,229
amixer -c "$card" cset name='cs42l43 Speaker L Input 1' DP5RX1
amixer -c "$card" cset name='cs42l43 Speaker R Input 1' DP5RX2
amixer -c "$card" cset name='cs42l43 Speaker L Input 1 Volume' 32
amixer -c "$card" cset name='cs42l43 Speaker R Input 1 Volume' 32

