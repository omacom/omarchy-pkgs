#!/bin/bash
set -euo pipefail

config_source=${P16_AUDIO_CONFIG_SOURCE:-/usr/share/p16-audio/80-p16-internal-sinks.conf}
service_source=${P16_AUDIO_SERVICE_SOURCE:-/usr/lib/systemd/user/p16-audio-jack.service}
config_home=${XDG_CONFIG_HOME:-$HOME/.config}

config_dir="$config_home/wireplumber/wireplumber.conf.d"
unit_dir="$config_home/systemd/user/pipewire.service.wants"
install -d -m 755 "$config_dir" "$unit_dir"
install -m 644 "$config_source" "$config_dir/80-p16-internal-sinks.conf"
ln -sfn "$service_source" "$unit_dir/p16-audio-jack.service"
