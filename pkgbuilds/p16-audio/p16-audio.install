post_install() {
  systemctl enable p16-audio-route.service
  /usr/libexec/p16-audio/install-user-units
}

post_upgrade() {
  systemctl enable p16-audio-route.service
  /usr/libexec/p16-audio/install-user-units
}

pre_remove() {
  /usr/libexec/p16-audio/install-user-units --remove
  systemctl disable --now p16-audio-route.service || true
}

post_remove() {
  legacy_config=/etc/wireplumber/wireplumber.conf.d/80-p16-internal-sinks.conf
  packaged_config=/usr/share/p16-audio/80-p16-internal-sinks.conf
  if [[ -f $legacy_config && ! -L $legacy_config && -f $packaged_config ]] \
    && cmp -s -- "$packaged_config" "$legacy_config"; then
    rm -- "$legacy_config"
  fi
}
