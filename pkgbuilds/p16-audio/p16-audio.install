managed_global_rule() {
  [[ -f $1 && ! -L $1 ]] || return 1
  local digest
  digest=$(sha256sum -- "$1")
  case ${digest%% *} in
    904c5d19be12d0277785c59cbd339854672652c4c0478a98215cdc600e9acac7|1e8d3c6ca35942f72ac6d475d264b3717b3dbd06130e5ac18ec9fc712736bad6) return 0 ;;
    *) return 1 ;;
  esac
}

post_install() {
  systemctl enable p16-audio-route.service
  /usr/libexec/p16-audio/install-user-units
}

post_upgrade() {
  systemctl enable p16-audio-route.service
  /usr/libexec/p16-audio/install-user-units
}

pre_remove() {
  /usr/libexec/p16-audio/install-user-units --remove
  systemctl disable --now p16-audio-route.service || true
}

post_remove() {
  legacy_config=/etc/wireplumber/wireplumber.conf.d/80-p16-internal-sinks.conf
  if managed_global_rule "$legacy_config"; then
    rm -- "$legacy_config"
  fi
}
