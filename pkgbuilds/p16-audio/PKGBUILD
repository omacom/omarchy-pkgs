pkgname=p16-audio
pkgver=0.1.0
pkgrel=5
pkgdesc='Persistent two-way and Dolby audio routing for ASUS ProArt P16 H7607BA'
arch=('aarch64')
license=('MIT')
optdepends=('p16-audio-route-dkms: four-channel speaker and DP5 headphone PCM routes' 'asus-proart-p16-speaker-firmware-local: OEM Cirrus DSP firmware')
depends=('pipewire' 'pipewire-pulse' 'wireplumber' 'alsa-utils' 'lsp-plugins-lv2' 'python' 'systemd')
options=('!strip')
install=p16-audio.install

source=(
  'p16-audio-route.service'
  'p16-audio-host@.service'
  'p16-audio-jack.service'
  'install-user-units'
  'install-user-config'
  '80-p16-internal-sinks.conf'
  'jack-watch'
  'setup-route'
  'LICENSE.converter'
  'Dolby_Balanced.irs'
  'README.md'
  'headphones.conf'
  'speakers.conf'
)
