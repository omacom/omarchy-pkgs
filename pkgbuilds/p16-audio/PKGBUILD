package() {
  install -Dm644 "$srcdir/LICENSE.converter" "$pkgdir/usr/share/licenses/p16-audio/LICENSE.converter"
  install -Dm644 "$srcdir/speakers.conf" "$pkgdir/usr/share/p16-audio/speakers.conf"
  install -Dm644 "$srcdir/headphones.conf" "$pkgdir/usr/share/p16-audio/headphones.conf"
  install -Dm644 "$srcdir/Dolby_Balanced.irs" "$pkgdir/usr/share/p16-audio/Dolby_Balanced.irs"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/p16-audio/README.md"
  install -Dm644 "$srcdir/p16-audio-route.service" "$pkgdir/usr/lib/systemd/system/p16-audio-route.service"
  install -Dm644 "$srcdir/p16-audio-host@.service" "$pkgdir/usr/lib/systemd/user/p16-audio-host@.service"
  install -Dm644 "$srcdir/p16-audio-jack.service" "$pkgdir/usr/lib/systemd/user/p16-audio-jack.service"
  install -Dm755 "$srcdir/setup-route" "$pkgdir/usr/libexec/p16-audio/setup-route"
  install -Dm755 "$srcdir/install-user-units" "$pkgdir/usr/libexec/p16-audio/install-user-units"
  install -Dm755 "$srcdir/install-user-config" "$pkgdir/usr/libexec/p16-audio/install-user-config"
  install -Dm644 "$srcdir/80-p16-internal-sinks.conf" "$pkgdir/usr/share/p16-audio/80-p16-internal-sinks.conf"
  install -Dm755 "$srcdir/jack-watch" "$pkgdir/usr/libexec/p16-audio/jack-watch"
}

