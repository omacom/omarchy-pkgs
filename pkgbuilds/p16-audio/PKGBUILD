pkgname=p16-audio
pkgver=0.1.0
pkgrel=3
pkgdesc='Persistent two-way and Dolby audio routing for ASUS ProArt P16 H7607BA'
arch=('aarch64')
license=('MIT')
optdepends=('p16-audio-route-dkms: four-channel speaker and DP5 headphone PCM routes' 'asus-proart-p16-speaker-firmware-local: OEM Cirrus DSP firmware')
depends=('pipewire' 'pipewire-pulse' 'wireplumber' 'alsa-utils' 'lsp-plugins-lv2' 'python' 'systemd')
options=('!strip')
install=p16-audio.install

source=(
  'p16-audio-route.service'
  'p16-audio-host@.service'
  'p16-audio-jack.service'
  'install-user-units'
  'jack-watch'
  'setup-route'
  'LICENSE.converter'
  'Dolby_Balanced.irs'
  'README.md'
  'headphones.conf'
  'speakers.conf'
)
sha256sums=(
  '83b5957c2e0c1c43a7506e51e38284dc8d38967bf3b6c7e8092910d7619e787a'
  'd8cf21c7c3992df2bcd954fda271f53d6e6bf009f8bc88408ad21ff46a8392b2'
  '05958082182676c897cb45cc29aeba14631e082227cec962627ed3636cd4e6d1'
  'd281854281202fe1bc983155f96dfc1c26806815024d25fcfee4035799feda50'
  '14ef192b57c14d290d9703b26f987e871c19dc88d2f4303b2197a0de62c29de6'
  '344d90cafd8d6b9cde5ab5ac55ced49fa5aa889fc738fad3a905cbc981c8ff93'
  '37a4e0886c11d67bae17e5e8a8637490fd18c2ff808685c830f7893fb44aa9c2'
  '44dca71b4110e59861557bd742fa981a3bb070228ff51818fd07864ba7dccf56'
