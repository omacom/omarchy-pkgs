# Maintainer: Yashwanth Kamireddi <yashwanthkamireddi@users.noreply.github.com>

pkgname=skykeep
pkgver=0.1.7
pkgrel=1
pkgdesc="iCloud Notes, Reminders, Calendar, Contacts, Drive and Photos as desktop apps"
arch=('x86_64')
url="https://github.com/YashwanthKamireddi/Skykeep"
license=('GPL-3.0-only')
# webkit2gtk for the window, libsecret for the session in the keyring, libheif for iPhone
# photos, GStreamer (with good and libav plugins) for videos.
depends=('webkit2gtk-4.1' 'gtk3' 'libsecret' 'libheif' 'gstreamer' 'gst-plugins-base-libs'
         'gst-plugins-base' 'gst-plugins-good' 'gst-libav')
optdepends=('fuse3: iCloud Drive and Photos as folders in the file manager')
makedepends=('rust' 'nodejs' 'npm' 'pkgconf')
# ring and libsqlite3-sys carry C and assembly that Rust's linker can't read as LLVM bitcode.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('43377ae577f0f127e60192e9c09539ba1df6f1257f7154cc4f46add86f487046')

_dir="Skykeep-$pkgver"

prepare() {
  cd "$_dir"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
  npm ci --no-audit --no-fund
}

build() {
  cd "$_dir"
  export CARGO_TARGET_DIR="$srcdir/target"
  npm run build
  cargo build --release --frozen -p quince-app
}

package() {
  cd "$_dir"
  local id=io.github.yashwanthkamireddi.Skykeep

  install -Dm755 "$srcdir/target/release/quince-app" "$pkgdir/usr/bin/skykeep"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  sed "s|<launchable type=\"desktop-id\">Skykeep.desktop</launchable>|<launchable type=\"desktop-id\">$id.desktop</launchable>|" \
    "packaging/$id.metainfo.xml" | install -Dm644 /dev/stdin "$pkgdir/usr/share/metainfo/$id.metainfo.xml"
  sed -e 's/{{name}}/Skykeep/' -e 's/{{comment}}/Your iCloud, on this computer/' \
      -e 's/{{exec}}/skykeep/g' -e "s/{{icon}}/$id/" -e 's/{{categories}}/Office;Calendar;ContactManagement;/' \
    "packaging/$id.desktop.in" | install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$id.desktop"

  local size src
  for size in 16x16:16x16 24x24:24x24 32x32:32x32 48x48:48x48 64x64:64x64 128x128:128x128 \
              256x256:128x128@2x 512x512:icon; do
    src=${size#*:}
    install -Dm644 "src-tauri/icons/$src.png" "$pkgdir/usr/share/icons/hicolor/${size%%:*}/apps/$id.png"
  done

  # Each of the six apps has its own launcher entry (skykeep --app notes, ...).
  for entry in packaging/apps/*.desktop; do
    install -Dm644 "$entry" "$pkgdir/usr/share/applications/$(basename "$entry")"
  done

  # Results in GNOME Shell and KRunner search.
  sed "s|^DesktopId=Skykeep.desktop$|DesktopId=$id.desktop|" "packaging/$id.search-provider.ini" \
    | install -Dm644 /dev/stdin "$pkgdir/usr/share/gnome-shell/search-providers/$id.search-provider.ini"
  install -Dm644 "packaging/$id.SearchProvider.service" "$pkgdir/usr/share/dbus-1/services/$id.SearchProvider.service"
  install -Dm644 "packaging/$id.krunner.desktop" "$pkgdir/usr/share/krunner/dbusplugins/$id.krunner.desktop"
}
