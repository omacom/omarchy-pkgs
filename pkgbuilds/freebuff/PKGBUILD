# Maintainer: The Omarchy Authors
# The Freebuff binary itself, from the GitHub release its npm launcher
# downloads into ~/.config/manicode. The launcher is left out: it exists only
# to fetch and replace that binary, which pacman does here. The checksums are
# the ones the npm package pins in binaryChecksums.
pkgname=freebuff
pkgver=0.2.38
pkgrel=1
pkgdesc="Freebuff, a free AI coding agent for the terminal"
arch=('x86_64' 'aarch64')
url="https://freebuff.com"
license=('MIT')
depends=('glibc')
# The binary is a Bun executable with its JavaScript appended; stripping breaks it.
options=('!strip' '!debug')
_release="https://github.com/CodebuffAI/codebuff-community/releases/download/freebuff-v${pkgver}"
source=('LICENSE')
# The baseline x86_64 build runs on CPUs without AVX2 too.
source_x86_64=("freebuff-${pkgver}-x86_64.tar.gz::${_release}/freebuff-linux-x64-baseline.tar.gz")
source_aarch64=("freebuff-${pkgver}-aarch64.tar.gz::${_release}/freebuff-linux-arm64.tar.gz")
sha256sums=('afa36c5fdd18bfbceb572158b94604e0c9e358da7f349d00777ee47b5ca139c3')
sha256sums_x86_64=('77e1ee2200339c92d03fedcb42546cfaa1706a58aa605cf4bdeadd93555d2114')
sha256sums_aarch64=('cd68e2e41295578a545cd020437fb913cfb6e9aac247319156759985939b270f')
noextract=("freebuff-${pkgver}-${CARCH}.tar.gz")

package() {
  # Freebuff finds tree-sitter.wasm beside its executable.
  install -dm755 "${pkgdir}/usr/lib/freebuff" "${pkgdir}/usr/bin"
  bsdtar --no-same-owner -xf "freebuff-${pkgver}-${CARCH}.tar.gz" -C "${pkgdir}/usr/lib/freebuff"
  ln -s /usr/lib/freebuff/freebuff "${pkgdir}/usr/bin/freebuff"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
