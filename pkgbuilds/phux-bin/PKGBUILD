# Maintainer: phux <https://github.com/no-phux/phux>

pkgname=phux-bin
pkgver=0.141.0
pkgrel=1
pkgdesc='Terminal multiplexer built for coding agents, with a server you can drive from code'
url='https://github.com/no-phux/phux'
arch=('x86_64' 'aarch64')
license=('Apache-2.0')
depends=('glibc' 'gcc-libs')
provides=('phux')
conflicts=('phux')
options=('!strip' '!debug')

_tarball="phux-v${pkgver}-${CARCH}-unknown-linux-gnu"
source_x86_64=("https://github.com/no-phux/phux/releases/download/v${pkgver}/phux-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("https://github.com/no-phux/phux/releases/download/v${pkgver}/phux-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
noextract=("phux-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz" "phux-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('58c0a2459c8b73a8802ff2a32b1271db062b687a239f93b050df202b021a7c3b')
sha256sums_aarch64=('dc7286f4f62a5db4f8c582210719246410af7daf07f4bc9ccc9322d7684d67be')

package() {
  # Extracted here, not by makepkg, so every file is owned by root.
  bsdtar --no-same-owner -xf "${_tarball}.tar.gz"
  cd "${_tarball}"

  install -Dm755 phux phux-mcp -t "${pkgdir}/usr/bin/"
  install -Dm644 LICENSE NOTICE THIRD-PARTY-NOTICES.md -t "${pkgdir}/usr/share/licenses/phux/"
  install -Dm644 README.md -t "${pkgdir}/usr/share/doc/phux/"
}
