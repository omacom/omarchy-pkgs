# Contributor: Carlo Teubner <carlo@cteubner.net>

# Carried ahead of Arch's 0.4-2: 0.5 stops wtype dropping punctuation and
# deleting the previous letter in Chromium and Electron (atx/wtype#71)
pkgname=wtype
pkgver=0.5
pkgrel=1
pkgdesc='xdotool type for wayland'
arch=(x86_64 aarch64)
url=https://github.com/atx/wtype
license=('MIT')
depends=('libxkbcommon' 'wayland')
makedepends=('meson')
source=("$url/archive/v$pkgver/wtype-v$pkgver.tar.gz")
b2sums=('827cb0badf17474a1badd613a7434f4a148d3d12aa1d7f9940b87b95ca4c1f1cca0a4d4fa9923cd9634f5541a6904832a9d0b4006f3f4477f91051c6b0798674')

build() {
  cd wtype-$pkgver
  arch-meson build
  ninja -C build
}

package() {
  cd wtype-$pkgver
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 -t "$pkgdir"/usr/share/licenses/$pkgname LICENSE
}
