# Audio DSP and compute DSP firmware for the Lenovo ThinkPad T14s Gen 7. The firmware only runs if
# it is signed for this board by Lenovo, so linux-firmware cannot carry it until the OEM submits
# it. The OEM ships it in its Windows driver download, which this recipe unpacks without running.
# The files are installed unmodified, under the names the device tree requests, and checked
# against the SHA-256 each was matched to.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=lenovo-thinkpad-t14s-gen7-firmware
pkgver=20261102
pkgrel=1
pkgdesc='Audio DSP and compute DSP firmware for the Lenovo ThinkPad T14s Gen 7'
arch=('aarch64')
url='https://download.lenovo.com/pccbbs/mobiles/n4pqq02w.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-glymur-lenovo-22a8')
makedepends=('7zip' 'innoextract')
options=('!strip' '!debug')
source=(
  'lenovo-n4pqq02w.exe::https://download.lenovo.com/pccbbs/mobiles/n4pqq02w.exe'
)
noextract=('lenovo-n4pqq02w.exe')
sha256sums=('ef833926fd9d739c53d6c79e8d819e27047f09267985b682a0ccd21d143dd3f4')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'lenovo-n4pqq02w.exe' 'lenovo-n4pqq02w' inno
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'lenovo-n4pqq02w/code$GetExtractPath$/N4PQQ02W/N4PQC20W/Core_drivers/qcsubsys_ext_adsp8480/adsp_dtbs.elf' "$fw"/'qcom/glymur/LENOVO/22A8/adsp_dtbs.elf'
  install -Dm644 'lenovo-n4pqq02w/code$GetExtractPath$/N4PQQ02W/N4PQC20W/Core_drivers/qcsubsys_ext_adsp8480/adspr.jsn' "$fw"/'qcom/glymur/LENOVO/22A8/adspr.jsn'
  install -Dm644 'lenovo-n4pqq02w/code$GetExtractPath$/N4PQQ02W/N4PQC20W/Core_drivers/qcsubsys_ext_adsp8480/adsps.jsn' "$fw"/'qcom/glymur/LENOVO/22A8/adsps.jsn'
  install -Dm644 'lenovo-n4pqq02w/code$GetExtractPath$/N4PQQ02W/N4PQC20W/Core_drivers/qcsubsys_ext_adsp8480/adspua.jsn' "$fw"/'qcom/glymur/LENOVO/22A8/adspua.jsn'
  install -Dm644 'lenovo-n4pqq02w/code$GetExtractPath$/N4PQQ02W/N4PQC20W/Core_drivers/qcnspmcdm8480/cdsp_dtbs.elf' "$fw"/'qcom/glymur/LENOVO/22A8/cdsp_dtbs.elf'
  install -Dm644 'lenovo-n4pqq02w/code$GetExtractPath$/N4PQQ02W/N4PQC20W/Core_drivers/qcsubsys_ext_adsp8480/qcadsp8480.mbn' "$fw"/'qcom/glymur/LENOVO/22A8/qcadsp8480.mbn'
  install -Dm644 'lenovo-n4pqq02w/code$GetExtractPath$/N4PQQ02W/N4PQC20W/Core_drivers/qcnspmcdm8480/qccdsp8480.mbn' "$fw"/'qcom/glymur/LENOVO/22A8/qccdsp8480.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
694ae22f6832eda33b9c97fad02daea8197f4a0474d6d3b031b26caafdd121f6  qcom/glymur/LENOVO/22A8/adsp_dtbs.elf
e9ba7199626b0c03f2ec02822d744f678ad567fe0625a28fe5f5908b7281e9db  qcom/glymur/LENOVO/22A8/adspr.jsn
19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e  qcom/glymur/LENOVO/22A8/adsps.jsn
d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d  qcom/glymur/LENOVO/22A8/adspua.jsn
9bee104a48d4aac647287d6c1454df170c1cff7158a2352711fd1e2163ea6d1d  qcom/glymur/LENOVO/22A8/cdsp_dtbs.elf
2563e5a1907b97bb055c0d65f4e0a96d19ed026f9d0f9155942d9752b3ac6c3a  qcom/glymur/LENOVO/22A8/qcadsp8480.mbn
acf13d29288d283793f418a36650e8a261eed927d30de109a59cb2210f458794  qcom/glymur/LENOVO/22A8/qccdsp8480.mbn
SUMS
  )
}
