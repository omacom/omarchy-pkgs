# Maintainer: Ryan Hughes <ryan@omarchy.org>

pkgname=omarchy-zsh
pkgver=1.5.0
pkgrel=2
pkgdesc="Omarchy shell configuration for Zsh"
arch=('any')
url="https://github.com/omacom-io/omarchy-zsh"
license=('MIT')
depends=('zsh' 'eza' 'mise' 'zoxide' 'starship' 'fzf' 'fd' 'bat' 'zsh-syntax-highlighting')
options=('!debug')
install=omarchy-zsh.install
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('e481aad290692a2a4560ee340dcd2c9839b85ab1ed05a8d482793cb219ce8313')

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  # Install the zsh-specific shell config. The shared envs/aliases/functions
  # are not bundled: shell/all sources them live from $OMARCHY_PATH.
  install -dm755 "${pkgdir}/usr/share/${pkgname}/shell"
  install -m644 shell/all shell/inits shell/zoptions "${pkgdir}/usr/share/${pkgname}/shell/"

  # Install zsh completions to the standard site-functions dir so they
  # autoload via the default fpath. compinit is invoked from zoptions.
  install -dm755 "${pkgdir}/usr/share/zsh/site-functions"
  cp shell/completions/* "${pkgdir}/usr/share/zsh/site-functions/"

  # Install templates and documentation
  install -dm755 "${pkgdir}/usr/share/${pkgname}"
  cp -r templates LICENSE README.md "${pkgdir}/usr/share/${pkgname}/"

  # Install setup script
  install -Dm755 bin/omarchy-setup-zsh "${pkgdir}/usr/bin/omarchy-setup-zsh"
}
