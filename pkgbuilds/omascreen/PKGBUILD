# Maintainer: Ted Charles <me@tedcharles.net>
pkgname=omascreen
pkgver=0.3.1
pkgrel=1
pkgdesc='Native connection manager for Apple High Performance Screen Sharing and VNC'
arch=('any')
url='https://github.com/BuiltByTed/omascreen'
license=('AGPL-3.0-or-later' 'ISC' 'MIT')
depends=(
  'python' 'python-cryptography' 'python-pycryptodome' 'python-av' 'python-numpy'
  'pyside6' 'python-keyring' 'python-dnspython' 'python-wgpu>=0.31'
  'python-rendercanvas>=2.6' 'python-glfw>=2.10' 'python-sounddevice'
  'python-pyperclip' 'libfdk-aac' 'portaudio' 'vulkan-icd-loader'
  'wl-clipboard' 'tigervnc' 'hicolor-icon-theme'
)
makedepends=('python-build' 'python-installer' 'python-hatchling')
checkdepends=('python-pytest')
optdepends=('avahi: discover Mac model information on the local network'
            'openssh: fetch a Mac icon through a trusted SSH key login'
            'gnome-keyring: save passwords through Secret Service')
source=("${url}/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz" 'omascreen.desktop')
sha256sums=('293016aa83a983d0df66a50529e08339c60489135a25272219d463c4e2d1d16f' 'd900e1f9e83135f8f2573be3f906a352feff78c75a5d9b34314d9c459d03f8a4')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  PYTHONPATH=src QT_QPA_PLATFORM=offscreen python -m pytest
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 "$srcdir/omascreen.desktop" "$pkgdir/usr/share/applications/omascreen.desktop"
  install -Dm644 src/screen_sharing/native/assets/omascreen.png "$pkgdir/usr/share/pixmaps/omascreen.png"
  install -Dm644 NOTICE "$pkgdir/usr/share/doc/$pkgname/NOTICE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 src/screen_sharing/native/assets/LICENSE-lucide "$pkgdir/usr/share/licenses/$pkgname/LICENSE-lucide"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 docs/*.md -t "$pkgdir/usr/share/doc/$pkgname/docs/"
}
