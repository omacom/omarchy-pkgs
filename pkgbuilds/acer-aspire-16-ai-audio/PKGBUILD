# Maintainer: Birk Skyum <birk.skyum@pm.me>

# The speaker and microphone topology for the Acer Aspire 16 AI (A16-11M,
# Snapdragon X X1-26-100). Its device tree names the sound card
# X1P42100-ACER-Aspire-16-AI, and linux-firmware has no topology under that
# name, so the card never registers. The laptop wires its audio as the ThinkPad
# T14s does, so this builds Linaro's T14s description under the laptop's name.
# Its UCM profile is in alsa-ucm-conf.

pkgname=acer-aspire-16-ai-audio
pkgver=1
pkgrel=1
pkgdesc='Speaker and microphone topology for the Acer Aspire 16 AI (A16-11M)'
arch=('aarch64')
# Qualcomm-only: the pacman platform guard keeps it off other hardware.
groups=('omarchy-platform-qualcomm')
url="https://github.com/omacom/omarchy-pkgs"
license=('BSD-3-Clause')
# Unversioned here: the build installs these from the published repository.
# The package itself asks for the alsa-ucm-conf with the laptop's profile, below.
depends=('alsa-ucm-conf')
makedepends=('alsa-utils' 'git' 'm4')
_audioreach_commit=d6bb205aca5f4b8fa6b2f44cf8b5f6a081cbf037
source=("audioreach-topology::git+https://github.com/linux-msm/audioreach-topology.git#commit=${_audioreach_commit}"
        'README.package.md')
sha256sums=('SKIP'
            '7568d440e6998b7d4d6a7905d950f944f16dd020718e2e5343e327c24ce56c77')
# linux-firmware's X1E80100-Romulus-tplg.bin, byte for byte, which is built
# from the same T14s description and is what the laptop's owner tested. A
# change in alsatplg's output fails the build here.
_topology_sha256=aa303397750f883ecaeed874d7547da658500596247676a6d405bf1ec43290b5

build() {
  m4 -I "$srcdir/audioreach-topology" \
    "$srcdir/audioreach-topology/X1E80100-LENOVO-Thinkpad-T14s.m4" >topology.conf
  alsatplg -c topology.conf -o X1P42100-ACER-Aspire-16-AI-tplg.bin
  echo "$_topology_sha256  X1P42100-ACER-Aspire-16-AI-tplg.bin" | sha256sum -c
}

package_acer-aspire-16-ai-audio() {
  depends=('alsa-ucm-conf>=1.2.16.1.r45.gd260eed-4')

  local fw="$pkgdir/usr/lib/firmware/qcom/x1e80100"
  install -Dm644 X1P42100-ACER-Aspire-16-AI-tplg.bin "$fw/X1P42100-ACER-Aspire-16-AI-tplg.bin"
  # Compressed, so a copy linux-firmware may ship later is the one the kernel
  # loads (it tries a plain name, then .zst, then .xz), and the two packages
  # never install the same path.
  xz -C crc32 "$fw/X1P42100-ACER-Aspire-16-AI-tplg.bin"

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
