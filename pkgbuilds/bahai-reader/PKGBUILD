# Maintainer: Tim Apple <179739321+ninepointlabs@users.noreply.github.com>

# A Flutter Linux app since 1.0. The recipe builds the release bundle with the
# Flutter version upstream's release workflow pins (FLUTTER_VERSION in
# .github/workflows/release.yml), installed through fvm as pkgbuilds/localsend
# does, and lays it out like upstream's packaging/nfpm.yaml. Upstream ships
# Linux packages for x86_64 only.

: ${FVM_CACHE_PATH:=$SRCDEST/fvm-cache}
export FVM_CACHE_PATH

pkgname=bahai-reader
pkgver=1.1.2
pkgrel=1
_flutter_version=3.47.9
pkgdesc="Offline Bahá’í prayers and writings reader"
arch=('x86_64')
url="https://bahaireader.org"
license=('MIT' 'LicenseRef-BahaiPrayers-Content')
depends=('fontconfig' 'gtk3' 'hicolor-icon-theme' 'libglvnd')
makedepends=('clang' 'cmake' 'fvm' 'git' 'ninja' 'unzip')
checkdepends=('desktop-file-utils')
optdepends=('noto-fonts: additional reading font coverage'
            'ttf-dejavu: DejaVu reading fonts')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::https://github.com/ninepointlabs/bahai-reader/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('155ec1942f8e33e1fa16015985792a2fc6f7b8131715e21fdcf2af7857730762')

prepare() {
  cd "$pkgname-$pkgver"
  printf '{"flutter": "%s"}\n' "$_flutter_version" > .fvmrc
}

build() {
  cd "$pkgname-$pkgver"
  export PUB_CACHE="$srcdir/pub-cache"

  fvm install
  fvm flutter --disable-analytics
  fvm flutter --no-version-check pub get --enforce-lockfile
  fvm flutter --no-version-check build linux --no-pub --release
}

check() {
  cd "$pkgname-$pkgver"
  desktop-file-validate packaging/org.bahai.Reader.desktop
  test -x build/linux/x64/release/bundle/bahai-reader
}

package() {
  cd "$pkgname-$pkgver"

  # The Flutter bundle: the binary, its lib/ and data/ (texts included).
  install -dm755 "$pkgdir/usr/lib/$pkgname"
  cp -r --no-preserve=ownership build/linux/x64/release/bundle/. "$pkgdir/usr/lib/$pkgname/"
  install -Dm755 packaging/bahai-reader "$pkgdir/usr/bin/bahai-reader"

  install -Dm644 packaging/org.bahai.Reader.desktop \
    "$pkgdir/usr/share/applications/org.bahai.Reader.desktop"
  install -Dm644 packaging/org.bahai.Reader.metainfo.xml \
    "$pkgdir/usr/share/metainfo/org.bahai.Reader.metainfo.xml"
  install -Dm644 packaging/org.bahai.Reader.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.bahai.Reader.svg"
  cp -r --no-preserve=ownership packaging/icons/hicolor "$pkgdir/usr/share/icons/"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 DATA-NOTICE.md "$pkgdir/usr/share/licenses/$pkgname/DATA-NOTICE.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  chmod -R u+rwX,go+rX,go-w "$pkgdir/"
}
