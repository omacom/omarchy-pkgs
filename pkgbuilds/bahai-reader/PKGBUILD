# Maintainer: Tim Apple <179739321+ninepointlabs@users.noreply.github.com>

pkgname=bahai-reader
pkgver=0.1.1
pkgrel=1
pkgdesc="Offline Bahá’í prayers and writings reader for Linux"
arch=('any')
url="https://bahaireader.org"
license=('MIT' 'LicenseRef-BahaiPrayers-Content')
depends=('python>=3.11' 'python-gobject' 'gtk4>=4.8' 'hicolor-icon-theme')
optdepends=('noto-fonts: additional reading font coverage'
            'ttf-dejavu: DejaVu reading fonts')
source=("$pkgname-$pkgver.tar.gz::https://github.com/ninepointlabs/bahai-reader/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('6f19d79df59363a6c6a65f7a93b6b1fa50804ea2fdf9e4a95cf93007ce74e685')

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 packaging/bahai-reader "$pkgdir/usr/bin/bahai-reader"
  install -Dm755 reader.py "$pkgdir/usr/share/$pkgname/reader.py"
  cp -a data "$pkgdir/usr/share/$pkgname/"

  install -Dm644 packaging/org.bahai.Reader.desktop \
    "$pkgdir/usr/share/applications/org.bahai.Reader.desktop"
  install -Dm644 packaging/org.bahai.Reader.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.bahai.Reader.svg"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 DATA-NOTICE.md "$pkgdir/usr/share/licenses/$pkgname/DATA-NOTICE.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
