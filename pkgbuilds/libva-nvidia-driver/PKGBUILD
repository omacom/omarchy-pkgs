# Maintainer: Spencer Bull <spencer@omarchy.org>
# Contributor: Daniel Bermond <dbermond@archlinux.org>
#
# Arch's libva-nvidia-driver 0.0.18-1 plus upstream PR #485:
# - use NVOS32_ATTR_PHYSICALITY_NONCONTIGUOUS on unified-memory (IS_ZERO_FB)
#   systems so NV01_MEMORY_SYSTEM surface allocations > 4 MiB succeed on
#   4 KiB-page kernels (NVIDIA N1X / GB10).
# Drop this package once a release carrying elFarto/nvidia-vaapi-driver#485
# reaches Arch Linux ARM.

pkgname=libva-nvidia-driver
pkgver=0.0.18
# Above Arch Linux ARM's 0.0.18-1 so existing installs move to this build.
pkgrel=1.1
pkgdesc='VA-API implementation that uses NVDEC as a backend'
arch=('aarch64')
url='https://github.com/elFarto/nvidia-vaapi-driver/'
license=('MIT')
depends=(
  'glibc'
  'gst-plugins-bad-libs'
  'libegl'
)
makedepends=(
  'ffnvcodec-headers'
  'libdrm'
  'libva'
  'meson'
)
conflicts=('libva-vdpau-driver')
source=(
  "https://github.com/elFarto/nvidia-vaapi-driver/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz"
  '0001-direct-use-noncontiguous-allocation-on-unified-memory.patch'
)
sha256sums=(
  '7459205cd1719a5865ab9c8969723c27e9863add5e7229e8e56c5f8816017b2a'
  '4273f20dad6ab345b40bfbe699f3064fd74092cbb9beae78aa2218e556ac5390'
)

prepare() {
  patch -d "nvidia-vaapi-driver-${pkgver}" -Np1 \
    -i "$srcdir/0001-direct-use-noncontiguous-allocation-on-unified-memory.patch"
}

build() {
  # Plain meson rather than arch-meson: the latter lives in devtools, which is
  # not a safe assumption outside a clean chroot. buildtype=plain hands the
  # compiler makepkg's own CFLAGS/LDFLAGS, which is what arch-meson does too.
  meson setup \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode=nodownload \
    "nvidia-vaapi-driver-${pkgver}" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -D -m644 "nvidia-vaapi-driver-${pkgver}/COPYING" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
