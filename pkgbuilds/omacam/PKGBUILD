# Maintainer: Areen <168860259+areen-dev@users.noreply.github.com>
pkgname=omacam
pkgver=0.1.3
pkgrel=1
pkgdesc='Native camera app for Omarchy: live preview, photo and video capture'
arch=('x86_64')
url='https://github.com/areen-dev/omacam'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland')
makedepends=('cmake' 'ninja')
source=("omacam-${pkgver}.tar.gz::https://github.com/areen-dev/omacam/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('d11bc76df8325d09af5a97a4759631b47ea99cc4e2ebc62b7201fc7b446a4744')

build() {
    cmake -S "${pkgname}-${pkgver}" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
    install -Dm644 "${pkgname}-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
