# Audio DSP, compute DSP, GPU and video firmware for the ASUS Vivobook S 15. The firmware only
# runs if it is signed for this board by ASUS, so linux-firmware cannot carry it until the OEM
# submits it. The OEM ships it in its Windows driver download, which this recipe unpacks without
# running. Each file is checked against the SHA-256 it was matched to and installed under the name
# the device tree requests, compressed with xz. The kernel tries a plain name, then .zst, then
# .xz, so once linux-firmware ships the same file, its copy is the one loaded, and the two
# packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=asus-vivobook-s15-firmware
pkgver=20261102
pkgrel=2
pkgdesc='Audio DSP, compute DSP, GPU and video firmware for the ASUS Vivobook S 15'
arch=('aarch64')
url='https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/43699/SOCPackage_forWebSite_Qualcomm_Z_V1.318.7800.0_43699_1.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1e80100-asustek-vivobook-s15' 'qcom-firmware-x1p42100-asustek-vivobook-s15')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'asus-socpackage-43699.exe::https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/43699/SOCPackage_forWebSite_Qualcomm_Z_V1.318.7800.0_43699_1.exe'
  'asus-socpackage-44984.exe::https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/44984/SOCPackage_forWebSite_Qualcomm_Z_V1.367.7800.0_44984.exe'
)
noextract=('asus-socpackage-43699.exe' 'asus-socpackage-44984.exe')
sha256sums=('7d8fa75780fe2a2fd90882ac7c4dcca21152ba3cd4eb33183bfa6c72f4f20801' '90bb38a0e60085ce5cd43ab8583d84843c36cc7763d457241f022c8b032867bc')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'asus-socpackage-43699.exe' 'asus-socpackage-43699' 7z-appended
  _unpack 'asus-socpackage-44984.exe' 'asus-socpackage-44984' 7z-appended
}

