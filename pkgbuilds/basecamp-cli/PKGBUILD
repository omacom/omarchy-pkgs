# Maintainer: The Omarchy Authors
pkgname=basecamp-cli
pkgver=0.30.0
pkgrel=2
pkgdesc="CLI for Basecamp project management"
arch=('x86_64' 'aarch64')
url="https://github.com/basecamp/basecamp-cli"
license=('MIT')
provides=('basecamp')
conflicts=('basecamp' 'basecamp-bin')
# A static Go binary, the same file Basecamp publishes.
options=('!strip' '!debug')
source_x86_64=("basecamp-${pkgver}-x86_64.tar.gz::https://github.com/basecamp/basecamp-cli/releases/download/v${pkgver}/basecamp_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("basecamp-${pkgver}-aarch64.tar.gz::https://github.com/basecamp/basecamp-cli/releases/download/v${pkgver}/basecamp_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('2fb3d1422eb95629c18712ed99f8dd305b925f74bd99f4ba0f244d76530bbc4e')
sha256sums_aarch64=('b61e2281a52bc7cf36120c75577a1a2a82026762809f1841446ddc1dcd8ea742')

package() {
  install -Dm755 basecamp "${pkgdir}/usr/lib/${pkgname}/basecamp"
  install -Dm644 MIT-LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/MIT-LICENSE"
  install -Dm644 completions/basecamp.bash "${pkgdir}/usr/share/bash-completion/completions/basecamp"
  install -Dm644 completions/_basecamp "${pkgdir}/usr/share/zsh/site-functions/_basecamp"
  install -Dm644 completions/basecamp.fish "${pkgdir}/usr/share/fish/vendor_completions.d/basecamp.fish"

  # pacman updates this install, so skip the daily GitHub check that ends
  # interactive commands with a notice to run `basecamp upgrade`.
  install -dm755 "${pkgdir}/usr/bin"
  cat >"${pkgdir}/usr/bin/basecamp" <<'WRAPPER'
#!/bin/bash
export BASECAMP_NO_UPDATE_CHECK=1
exec /usr/lib/basecamp-cli/basecamp "$@"
WRAPPER
  chmod 755 "${pkgdir}/usr/bin/basecamp"
}
