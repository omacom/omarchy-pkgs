# Maintainer: Craig Derington <craig@craigderington.dev>

pkgname=omaviewer
pkgver=0.1.1
pkgrel=1
pkgdesc='A small image viewer and editor for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/craigderington/omaviewer'
license=('MIT')
options=('!debug')
depends=(
  'libgcc'
  'libstdc++'
  'glibc'
  'hicolor-icon-theme'
  'imagemagick>=7'
  'qt6-base>=6.8'
  'qt6-declarative>=6.8'
  'qt6-svg'
  'qt6-wayland'
  'xdg-desktop-portal'
)
optdepends=(
  'qt6-imageformats: additional native image previews'
  'kimageformats: native HEIC, AVIF and JPEG XL previews'
  'xdg-desktop-portal-gtk: file chooser backend if the desktop does not provide one'
)
makedepends=('gcc' 'make')
checkdepends=('dbus' 'qt6-imageformats' 'ttf-dejavu')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('98edc764956aa8b1ee2185424671a559e4663e82e8804dbf5c8d4c2d8b08af86')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/test
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/omaviewer "$pkgdir/usr/bin/omaviewer"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/omaviewer.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaviewer.svg"
  install -Dm644 pkgbuild/omaviewer.desktop "$pkgdir/usr/share/applications/omaviewer.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
