post_install() {
  printf ':: Reboot to switch the touchpad to RMI4/SMBus, then run thinkpad-t14-amd-touchpad-check.\n'
}
post_upgrade() {
  printf ':: Reboot to load the updated touchpad modules, then run thinkpad-t14-amd-touchpad-check.\n'
}
post_remove() {
  printf ':: Reboot to return the touchpad to the stock modules.\n'
}
