[Trigger]
Operation = Upgrade
Type = Package
Target = omarchy-faceauth

[Action]
Description = Restarting faceauth.service on the new unit and binaries...
When = PostTransaction
# Pacman runs hooks in file-name order, so this one is installed as
# 90-omarchy-faceauth-restart.hook: after 30-systemd-daemon-reload-system.hook
# has reloaded the unit files, so the restart picks up a changed unit, not the
# old one. try-restart leaves a stopped or disabled service alone. The
# /run/systemd/system check is the one Arch's own systemd-hook script makes,
# so an upgrade inside a chroot or an unbooted root skips the restart instead
# of failing it; that script has no restart operation of its own to call.
Exec = /bin/sh -c '[ -d /run/systemd/system ] && systemctl try-restart faceauth.service || :'
