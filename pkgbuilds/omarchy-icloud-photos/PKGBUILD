# Maintainer: Jankees van Woezik <mail@jankeesvw.com>

pkgname=omarchy-icloud-photos
pkgver=1.1.0
pkgrel=1
# icloudpd does the syncing; the app's sign-in and delete helper imports
# pyicloud_ipd from the same release, so both come from one version.
_icloudpd=1.32.3
_srp=1.0.22
pkgdesc="The last month of your iCloud Photos library as a native window on Omarchy, synced by icloudpd"
arch=('x86_64' 'aarch64')
url="https://github.com/jankeesvw/omarchy-icloud-photos"
license=('MIT')
depends=('quickshell' 'imagemagick' 'ffmpeg' 'jq' 'wl-clipboard' 'util-linux' 'systemd'
         'python' 'python-requests' 'python-keyring' 'python-tzlocal' 'python-pytz'
         'python-typing_extensions' 'python-six' 'python-piexif')
install="$pkgname.install"
options=('!debug' '!strip')
_ipd_url="https://github.com/icloud-photos-downloader/icloud_photos_downloader"
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "icloudpd-src-$_icloudpd.tar.gz::$_ipd_url/archive/refs/tags/v$_icloudpd.tar.gz"
        "https://files.pythonhosted.org/packages/source/s/srp/srp-$_srp.tar.gz")
source_x86_64=("icloudpd-$_icloudpd-linux-amd64::$_ipd_url/releases/download/v$_icloudpd/icloudpd-$_icloudpd-linux-amd64")
source_aarch64=("icloudpd-$_icloudpd-linux-arm64::$_ipd_url/releases/download/v$_icloudpd/icloudpd-$_icloudpd-linux-arm64")
noextract=("icloudpd-$_icloudpd-linux-amd64" "icloudpd-$_icloudpd-linux-arm64")
sha256sums=('5052cd4d97dd02cfb87e2ed24113afb760ee7ed129b2f7e353a39a33e4b050ad'
            'fdcea37bb9e4516f72a060550db253e973039acee42398ba11912135ff020825'
            'f330d0ec7387e2ac8577487b164963155d4a031bca6e2024f1b0930eb92baa5d')
sha256sums_x86_64=('cbe4de08f715a9b524795eccd75f33a97661cd27fa7f0282c58611d760fce093')
sha256sums_aarch64=('b869453b8282f50c9e7e79d96d1a11f1f9d126e8017b395fa62fd04e1acd3031')

package() {
  local app="$pkgdir/usr/lib/$pkgname"

  cd "$pkgname-$pkgver"
  install -Dm755 -t "$app/bin" bin/omarchy-icloud-photos* bin/icloud_helper.py
  install -Dm644 -t "$app/ui" ui/*.qml
  install -d "$pkgdir/usr/bin"
  ln -s "/usr/lib/$pkgname/bin/$pkgname" "$pkgdir/usr/bin/$pkgname"
  ln -s "/usr/lib/$pkgname/bin/$pkgname-sync" "$pkgdir/usr/bin/$pkgname-sync"

  sed "s|@ICON@|$pkgname|" "$pkgname.desktop" | install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 assets/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" systemd/$pkgname-sync.timer
  sed "s|^ExecStart=.*|ExecStart=/usr/bin/$pkgname-sync|" systemd/$pkgname-sync.service \
    | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/$pkgname-sync.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  # icloudpd itself, found by the sync script next to it.
  install -Dm755 "$srcdir/icloudpd-$_icloudpd-linux-$([[ $CARCH == aarch64 ]] && echo arm64 || echo amd64)" "$app/bin/icloudpd"

  # pyicloud_ipd and the bits of icloudpd it imports, plus srp, which Arch
  # does not package. The helper runs them with the system python.
  cd "$srcdir/icloud_photos_downloader-$_icloudpd/src"
  install -d "$app/lib"
  cp -r --no-preserve=ownership pyicloud_ipd foundation icloudpd "$app/lib/"
  cp -r --no-preserve=ownership "$srcdir/srp-$_srp/srp" "$app/lib/"
  install -Dm644 "$srcdir/icloud_photos_downloader-$_icloudpd/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/icloudpd-LICENSE.md"
  install -Dm644 "$srcdir/srp-$_srp/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/srp-LICENSE"
  python -m compileall -q -s "$pkgdir" -p / "$app/lib"
}
