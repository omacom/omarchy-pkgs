post_install() {
  cat <<'MSG'
Omarchy iCloud Photos is installed; open it from the launcher and sign in
with your Apple ID. The sync timer turns on at the first sign-in.

Installed it before with install.sh from a checkout? Remove the links that
script made, or they take precedence over the package:
  rm ~/.local/bin/omarchy-icloud-photos ~/.local/bin/omarchy-icloud-photos-sync \
     ~/.local/share/applications/omarchy-icloud-photos.desktop \
     ~/.config/systemd/user/omarchy-icloud-photos-sync.{service,timer}
  systemctl --user daemon-reload
Your config, session and library stay where they are.
MSG
}
