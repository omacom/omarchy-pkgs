# Maintainer: Omarchy
# Tailscale's own static builds from pkgs.tailscale.com, installed where
# Arch's package puts them: a machine moves from extra/tailscale to this one
# and keeps its /etc/default/tailscaled and its enabled units. The binaries
# link no libraries, so one build runs on every channel and follows
# Tailscale's stable track on the fast ring, on both architectures.
pkgname=tailscale
pkgver=1.104.7
pkgrel=1
pkgdesc='A mesh VPN that makes it easy to connect your devices, wherever they are'
arch=('x86_64' 'aarch64')
url='https://tailscale.com'
license=('BSD-3-Clause')
backup=('etc/default/tailscaled')
# Ship the bytes Tailscale published, Go build ID and debug info included.
options=('!strip' '!debug')
source=("LICENSE-${pkgver}::https://raw.githubusercontent.com/tailscale/tailscale/v${pkgver}/LICENSE")
source_x86_64=("https://pkgs.tailscale.com/stable/tailscale_${pkgver}_amd64.tgz"
               "tailscale_${pkgver}_amd64.tgz.signature::https://pkgs.tailscale.com/stable/tailscale_${pkgver}_amd64.tgz.sig")
source_aarch64=("https://pkgs.tailscale.com/stable/tailscale_${pkgver}_arm64.tgz"
                "tailscale_${pkgver}_arm64.tgz.signature::https://pkgs.tailscale.com/stable/tailscale_${pkgver}_arm64.tgz.sig")
sha256sums=('a7ca6186a7963a0a60740f6047760eecd7a0234e8c38bd7e1e0bbcb324bda45b')
sha256sums_x86_64=('e56693ff74a64f2591b7e819c280635a100aae1ddfb0ef058fcd052b7cd8d16c' 'cee4ba69e2a7a0738c10b2727a16aa5ca930a903b9c5dd08cb4e27b93d815e20')
sha256sums_aarch64=('d6bed2720310b328b861f943d7b4016c5358a9bad60575eb51e8143b79068484' '7c36baea0bad90fec71321895450029e8315a20028e4977ef813676da53c9b3a')

# _signed_by <message file> <signature file> <key file>...: whether any key in
# those files signed the message. A key file is as Tailscale publishes one.
_signed_by() {
  local message=$1 signature=$2 key
  shift 2

  while read -r key; do
    # The key as openssl reads one: a fixed header, then the 32 bytes.
    openssl pkeyutl -verify -pubin -keyform DER -rawin -in "$message" -sigfile "$signature" \
      -inkey <(printf '\x30\x2a\x30\x05\x06\x03\x2b\x65\x70\x03\x21\x00'; base64 -d <<<"$key") &>/dev/null && return 0
  done < <(grep -hv '^-----' "$@")

  return 1
}

# Tailscale signs with its own format, not PGP: a root key signs the bundle of
# signing keys, and one of those signs each tarball. Both sets are in
# keys/distsign, so the build asks no server for a key. makepkg runs this in
# the recipe's directory.
verify() {
  local goarch=amd64 keys=keys/distsign tarball message size byte
  [[ $CARCH == "aarch64" ]] && goarch=arm64
  tarball="$SRCDEST/tailscale_${pkgver}_${goarch}.tgz"

  if ! _signed_by "$keys/distsign.pub" "$keys/distsign.pub.sig" "$keys"/roots/*.pem; then
    echo "No Tailscale root key in keys/distsign/roots signed keys/distsign/distsign.pub" >&2
    return 1
  fi

  # What is signed: the tarball's BLAKE2s-256, then its size as 8 bytes, lowest first.
  message=$(mktemp)
  size=$(stat -c %s "$tarball")
  {
    openssl dgst -blake2s256 -binary "$tarball"
    for (( byte = 0; byte < 8; byte++ )); do
      printf "\\x$(printf '%02x' $(( size >> 8 * byte & 255 )))"
    done
  } >"$message"

  if ! _signed_by "$message" "$tarball.signature" "$keys/distsign.pub"; then
    rm -f "$message"
    echo "No key in keys/distsign/distsign.pub signed ${tarball##*/}. If Tailscale has a new signing key, see keys/distsign/README.md" >&2
    return 1
  fi
  rm -f "$message"
}

package() {
  local goarch=amd64
  [[ $CARCH == "aarch64" ]] && goarch=arm64

  cd "tailscale_${pkgver}_${goarch}"

  install -Dm755 tailscale tailscaled -t "${pkgdir}/usr/bin"
  install -Dm644 systemd/tailscaled.defaults "${pkgdir}/etc/default/tailscaled"
  install -Dm644 systemd/tailscaled.service systemd/tailscale-wait-online.service \
    systemd/tailscale-online.target -t "${pkgdir}/usr/lib/systemd/system"
  install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # The tarball carries no completions; the CLI writes its own. To files first,
  # because a pipe into install would hide a generator that failed.
  ./tailscale completion bash >tailscale.bash
  ./tailscale completion zsh >_tailscale
  ./tailscale completion fish >tailscale.fish
  install -Dm644 tailscale.bash "${pkgdir}/usr/share/bash-completion/completions/tailscale"
  install -Dm644 _tailscale -t "${pkgdir}/usr/share/zsh/site-functions"
  install -Dm644 tailscale.fish -t "${pkgdir}/usr/share/fish/vendor_completions.d"
}
