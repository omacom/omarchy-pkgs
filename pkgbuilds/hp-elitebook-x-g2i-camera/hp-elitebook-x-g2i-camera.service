[Unit]
Description=HP EliteBook X G2i webcam (CamHAL or SoftISP engine -> v4l2loopback)
Documentation=file:/usr/share/doc/hp-elitebook-x-g2i-camera/README.md
# v4l2-relayd would fight us for both /dev/video50 and the sensor. Our camhal
# engine uses the pinned runtime in /usr/lib/hp-elitebook-x-g2i-camhal, never
# the system-wide CamHAL that relayd fronts.
Conflicts=v4l2-relayd@ipu7.service
After=multi-user.target

[Service]
Type=simple
# Nothing else loads v4l2loopback for us. v4l2loopback-dkms builds the module but
# installs no modules-load.d entry, so without this /dev/video50 never appears on
# a machine that does not also have v4l2-relayd, whose own modules-load.d file is
# what happens to load it wherever intel-ipu7-camera is installed. Load it here
# rather than at boot: this service is its only consumer, and doing it on start
# also covers the case where a kernel upgrade rebuilt the module after boot.
# Options come from /usr/lib/modprobe.d/99-hp-elitebook-x-g2i-v4l2loopback.conf.
ExecStartPre=/usr/bin/modprobe v4l2loopback
ExecStart=/usr/bin/hp-elitebook-x-g2i-camera
# Machine-local knobs (engine choice, NR strength, tuning) without a unit edit.
# Read after any Environment= lines here, so the file wins.
EnvironmentFile=-/etc/hp-elitebook-x-g2i-camera.conf
# Status file, the camhal gst registry and the aiqb-override overlay live here.
# Fixed names in a private 0700 directory, so nothing can pre-create them.
RuntimeDirectory=hp-elitebook-x-g2i-camera
RuntimeDirectoryMode=0700
# Restart=always, not on-failure. v4l2loopback runs with exclusive_caps=1, which
# reports capture-only ONLY while a writer is attached -- if this service stops
# for any reason, every camera application starts failing with
# "VIDIOC_STREAMON: Input/output error". Self-healing matters more here than it
# would for an ordinary daemon.
Restart=always
RestartSec=5
# Needs the raw ISYS nodes and the media device
DevicePolicy=auto

# Knobs, all optional -- prefer /etc/hp-elitebook-x-g2i-camera.conf over
# editing this unit. See the daemon header in hpcam-lc.cpp for the full list.
# Environment=HPCAM_ENGINE=softisp
# Environment=HPCAM_NR_STRENGTH=-120
# Environment=IDLE_STOP=5
# Environment=AE_TARGET=105

[Install]
WantedBy=multi-user.target
