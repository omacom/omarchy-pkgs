# The DKMS modules are built by the dkms pacman hooks, which fire on any
# package that installs /usr/src/*/dkms.conf. Nothing to do here for that.

# Earlier revisions of this work, installed by hand from the enablement repo,
# registered a DKMS module named ipu7-ov05c10-hp-g2i that built both ov05c10
# and a forked ipu-bridge. Its ipu-bridge overrides the in-tree one, which now
# carries the link-frequency patch from linux-ptl, so leaving it registered
# would quietly undo that.
_warn_about_predecessor() {
  if dkms status 2>/dev/null | grep -q '^ipu7-ov05c10-hp-g2i'; then
    cat <<'MSG'

  NOTE: a DKMS module named ipu7-ov05c10-hp-g2i is still registered. It builds
  a forked ipu-bridge that overrides the in-tree one, which would undo the
  link-frequency patch this machine's kernel now carries. Remove it:

    sudo dkms remove ipu7-ov05c10-hp-g2i/1.0 --all
    sudo rm -rf /usr/src/ipu7-ov05c10-hp-g2i-1.0

MSG
  fi
}

# Anyone who brought this machine up by hand before the package existed has
# services in /etc/systemd/system doing the same job. Two writers fighting over
# the sensor and /dev/video50 does not fail cleanly: both units report active,
# and this one crash-loops while the older one keeps the device. Stand them down
# rather than leave the user to work that out from a restart counter.
_retire_legacy_units() {
  local u
  for u in hp-g2i-camera-bypass hp-g2i-camera-watchdog camera-init; do
    # Only ever touch units no package owns.
    [ -e "/etc/systemd/system/$u.service" ] || continue
    if pacman -Qo "/etc/systemd/system/$u.service" >/dev/null 2>&1; then
      echo "  leaving $u alone -- a package owns it"
      continue
    fi
    systemctl disable --now "$u.service" >/dev/null 2>&1 || true
    echo "  retired the hand-installed $u.service, superseded by this package"
  done
}

# This package installs the tuning file to /etc/libcamera/ipa/simple, which
# libcamera searches before /usr/share/libcamera/ipa/simple. A hand-placed copy
# in the datadir therefore stops having any effect the moment this package is
# installed, without anything saying so. Editing that copy afterwards and seeing
# no change in the colour is a bad afternoon, so say it out loud. Do not delete
# it: no package owns it, and it may be someone's newer working copy.
_warn_about_shadowed_tuning() {
  local stale=/usr/share/libcamera/ipa/simple/ov05c10.yaml
  [ -e "$stale" ] || return 0
  pacman -Qo "$stale" >/dev/null 2>&1 && return 0
  cat <<MSG

  NOTE: $stale is still present and no package owns it. libcamera reads
  /etc/libcamera/ipa/simple/ov05c10.yaml first, so that copy is now inert.
  Delete it once you have confirmed nothing there is newer:

    sudo rm $stale

MSG
}

post_install() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  _retire_legacy_units
  _warn_about_shadowed_tuning
  systemctl enable hp-elitebook-x-g2i-camera.service >/dev/null 2>&1 || true

  cat <<'MSG'
HP EliteBook X G2i webcam installed.

  Reboot required: the ov05c10 module cannot be swapped live (the intel_ipu7
  stack hard-hangs the machine if unloaded while active), v4l2loopback must
  reload to pick up exclusive_caps=1, and the ipu-bridge link frequency comes
  from linux-ptl.

  After rebooting the camera appears as "Hardware ISP Camera" (/dev/video50)
  in Chrome, Firefox, OBS and the Omarchy screen recorder.

  This is a bypass of Intel's CamHAL, not a fix -- see
  /usr/share/doc/hp-elitebook-x-g2i-camera/README.md for what that costs and
  why. Two things worth knowing up front:

    * The service must stay enabled. It holds /dev/video50 open at all times so
      the device keeps advertising capture-only, which is what makes Chrome
      list it. Disable it without also reverting the modprobe drop-in and every
      camera app will fail to open the device.

    * The privacy LED lights only while an application is actually using the
      camera; the sensor is powered down otherwise.
MSG

  _warn_about_predecessor
}

post_upgrade() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl try-restart hp-elitebook-x-g2i-camera.service >/dev/null 2>&1 || true
  _warn_about_predecessor
  _warn_about_shadowed_tuning
}

pre_remove() {
  systemctl disable --now hp-elitebook-x-g2i-camera.service >/dev/null 2>&1 || true
}

post_remove() {
  echo "Removed. Reboot to drop exclusive_caps=1, or readers will fail with"
  echo "VIDIOC_STREAMON: Input/output error while no writer is attached."
}
