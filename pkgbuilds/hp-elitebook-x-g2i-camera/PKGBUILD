# Maintainer: Meir Dick <mdick85@gmail.com>
#
# Webcam support for the HP EliteBook X G2i (Panther Lake, IPU7 + OV05C10).
#
# 2.0.0: the hardware ISP is back, as the default engine. 1.x bypassed CamHAL
# because the then-current release set delivered black frames (the 2944x1632
# graph-settings mismatch, diagnosed August 2026 and still true of current
# tags). The pinned release set 20260327_1 - the one intel/ipu7-camera-hal
# issue #48 reports working - predates that graph change and was verified on
# this machine; hp-elitebook-x-g2i-camhal-runtime carries it in a private
# prefix. The daemon now has two engines behind one unchanged contract
# (loopback ownership, black idle frames, LED semantics):
#
#   camhal  (default) spawn gst-launch icamerasrc out of the pinned runtime,
#           relay NV12 frames from a pipe into the loopback writer. Intel AIQ
#           with HP's aiqb: proper NR, CCM, lens shading, and ~0 CPU cost.
#           Falls back to softisp for the rest of the boot after two
#           consecutive failures, loudly, via a /run flag.
#   softisp the 1.x libcamera SoftISP path, unchanged, as the fallback and as
#           HPCAM_ENGINE=softisp.
#
# Engine choice and tuning live in /etc/hp-elitebook-x-g2i-camera.conf.
# A local AIQ tuning drop-in at /etc/hp-elitebook-x-g2i/OV05C10_CJFPE50_PTL.aiqb
# overrides the packaged one at every sensor start (for the Windows-extracted
# tuning, which measures better NR but cannot be redistributed).
#
# The 1.x story, kept because the softisp engine is still that code:
#
#   ov05c10 -> CSI2 -> ISYS (raw Bayer) -> debayer, AE, WB -> v4l2loopback
#
# Two things this package deliberately does not carry:
#
#   - The IPU7 kernel drivers. They come from intel-ipu7-drivers, which this
#     depends on. Mainline has no ipu7 driver at all, so without that package
#     there is no ISYS to read from and the camera cannot work.
#   - The ipu-bridge link-frequency change. ipu-bridge is an in-tree file, so
#     it ships as a patch in linux-ptl rather than as a DKMS module that would
#     fork it and freeze every other sensor's entry.
#
# What is left is one genuinely out-of-tree module: Intel's ov05c10 sensor
# driver, which exists in neither mainline nor intel-ipu7-camera.
#
# Not folded into intel-ipu7-camera: that package targets OV08X40 with a working
# hardware ISP, and its install gate already excludes this machine.

pkgname=hp-elitebook-x-g2i-camera
pkgver=2.0.2
pkgrel=1
pkgdesc="Webcam support for HP EliteBook X G2i (IPU7 + OV05C10, CamHAL or SoftISP engine)"
arch=('x86_64')
url="https://github.com/omacom-io/omarchy-pkgs"
license=('GPL-2.0-or-later')
makedepends=('gcc' 'pkgconf')

depends=(
  'intel-ipu7-drivers'
  'linux-ptl'
  'libcamera-ov05c10'
  'ffmpeg'
  'v4l-utils'
  'v4l2loopback-dkms'
  'dkms'
  'linux-headers'
  # the camhal engine: the pinned runtime, gst-launch-1.0 + fdsink
  # (gstreamer), and the base/good plugin sets around icamerasrc
  'hp-elitebook-x-g2i-camhal-runtime'
  'gstreamer'
  'gst-plugins-base'
  'gst-plugins-good'
  # 2.0.2: the default-on HPCAM_DENOISE stage is vapostproc from the SYSTEM
  # gstreamer (GST_PLUGIN_PATH is additive), Intel VEBOX temporal denoise.
  'gst-plugin-va'
)
# Both packages drive the same IPU7 and would fight over /dev/video50 and the
# sensor; intel-ipu7-camera also starts v4l2-relayd. They are gated on different
# sensors, so this should never trigger.
conflicts=('intel-ipu7-camera')
install=hp-elitebook-x-g2i-camera.install
options=('!debug' '!strip')

# Intel's sensor driver, at a pinned commit, the same way intel-ipu7-camera
# pins every Intel repo it builds from. The file is taken unmodified.
_ipu6_drivers_commit="c09fa9a6e98b951ea4ab9d4100aa85281a659074"

source=(
  "ipu6-drivers::git+https://github.com/intel/ipu6-drivers.git#commit=${_ipu6_drivers_commit}"
  '99-hp-elitebook-x-g2i-camera.conf'
  '99-hp-elitebook-x-g2i-v4l2loopback.conf'
  'Makefile.ov05c10'
  'README.package.md'
  'dkms-ov05c10.conf'
  'hpcam-lc.cpp'
  'hp-elitebook-x-g2i-camera.install'
  'hp-elitebook-x-g2i-camera.service'
  'hp-elitebook-x-g2i-camera.conf'
  'ov05c10.yaml'
  '50-hp-elitebook-x-g2i-disable-libcamera.conf'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

# Calibration data, not user configuration, but it lives in /etc because that is
# where libcamera looks first. backup= gets this right either way: pacman
# replaces the file on upgrade while it still matches the version this package
# shipped, and only falls back to .pacnew once someone has edited it by hand.
# The daemon conf is ordinary user configuration and gets the same treatment.
backup=(
  'etc/libcamera/ipa/simple/ov05c10.yaml'
  'etc/hp-elitebook-x-g2i-camera.conf'
)

build() {
  # The daemon links the private-prefix libcamera, not Arch's: it needs the
  # ov05c10 sensor helper and the lens shading algorithm, and its IPA is signed
  # by a key that only exists inside that build. Same soname either way, so the
  # rpath is what decides, and getting it wrong fails at runtime rather than here.
  local prefix=/usr/lib/libcamera-ov05c10
  PKG_CONFIG_PATH="${prefix}/lib/pkgconfig" g++ -O2 -std=c++20 -Wall -Wextra \
    -o hp-elitebook-x-g2i-camera hpcam-lc.cpp \
    $(PKG_CONFIG_PATH="${prefix}/lib/pkgconfig" pkg-config --cflags --libs libcamera) \
    $(pkg-config --cflags --libs libswscale libavutil) \
    -Wl,-rpath,"${prefix}/lib"
}

package() {
  install -Dm755 hp-elitebook-x-g2i-camera "${pkgdir}/usr/bin/hp-elitebook-x-g2i-camera"
  install -Dm644 hp-elitebook-x-g2i-camera.service "${pkgdir}/usr/lib/systemd/system/hp-elitebook-x-g2i-camera.service"

  # Engine choice and tuning; read by the unit as an EnvironmentFile.
  install -Dm644 hp-elitebook-x-g2i-camera.conf "${pkgdir}/etc/hp-elitebook-x-g2i-camera.conf"

  # Where the local aiqb tuning drop-in goes (see the conf file). The package
  # deliberately ships only the empty directory: the better-measured tuning is
  # Windows-extracted and cannot be redistributed.
  install -dm755 "${pkgdir}/etc/hp-elitebook-x-g2i"

  # INT3472 is the camera PMIC that owns the sensor's 19.2 MHz clock and rails.
  # It and intel_cvs must load before intel_ipu7, or the sensor is never clocked.
  install -Dm644 99-hp-elitebook-x-g2i-camera.conf "${pkgdir}/usr/lib/modprobe.d/99-hp-elitebook-x-g2i-camera.conf"

  # exclusive_caps=1 is required for Chrome, which lists only V4L2 devices that
  # advertise CAPTURE without OUTPUT. It reports capture-only while a writer is
  # attached, so it depends on the service above holding the device open. The
  # two are a pair; see README.package.md.
  install -Dm644 99-hp-elitebook-x-g2i-v4l2loopback.conf "${pkgdir}/usr/lib/modprobe.d/99-hp-elitebook-x-g2i-v4l2loopback.conf"

  # DKMS: the ov05c10 sensor driver only.
  local dkms_dir="${pkgdir}/usr/src/ov05c10-${pkgver}"
  install -Dm644 "${srcdir}/ipu6-drivers/drivers/media/i2c/ov05c10.c" "${dkms_dir}/src/ov05c10.c"
  install -Dm644 Makefile.ov05c10 "${dkms_dir}/src/Makefile"
  install -Dm644 dkms-ov05c10.conf "${dkms_dir}/dkms.conf"
  sed -i "s/@PKGVER@/${pkgver}/" "${dkms_dir}/dkms.conf"

  # Colour tuning for libcamera's software ISP: black level and the CCM set.
  # Nothing in the current ffmpeg pipeline reads it -- it is here for the
  # libcamera path, and it is here rather than in libcamera-ov05c10 because
  # these are HP's matrices for this laptop's camera module, not a property of
  # every ov05c10 ever fitted. This package is already gated to this machine;
  # that one is not.
  install -Dm644 ov05c10.yaml "${pkgdir}/etc/libcamera/ipa/simple/ov05c10.yaml"

  # Silences 32 ERROR lines per WirePlumber start from the root-only raw ISYS
  # nodes. Noise only -- the camera is measured to work without it. See the file.
  install -Dm644 50-hp-elitebook-x-g2i-disable-libcamera.conf \
    "${pkgdir}/usr/share/wireplumber/wireplumber.conf.d/50-hp-elitebook-x-g2i-disable-libcamera.conf"

  install -Dm644 README.package.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
