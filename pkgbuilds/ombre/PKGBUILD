pkgname=ombre
pkgver=0.1.0
pkgrel=1
pkgdesc='Generate gradient wallpapers from your Omarchy theme colours'
arch=('x86_64' 'aarch64')
url="https://github.com/benhedrington/ombre"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'python' 'python-numpy' 'python-pillow')
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('51fc3d35125198a2e98fd1668472827327d86ece9b6fe7e65216464890bce15a')

build() {
  cd "$pkgname-$pkgver"
  qmake6 ombre.pro
  make -j"$(nproc)"
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 ombre "$pkgdir/usr/bin/ombre"
  install -Dm644 backend/gradgen.py "$pkgdir/usr/share/ombre/gradgen.py"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/ombre.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ombre.svg"
  install -Dm644 pkgbuild/ombre.desktop "$pkgdir/usr/share/applications/ombre.desktop"
}
