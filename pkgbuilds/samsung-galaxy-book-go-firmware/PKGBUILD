c75d16fc0805e5a0f51c6d0e0fcc315c09d5d2174d655fa038e9d9eb4217df2b  qcom/sc7180/Samsung/galaxy-book-go/adspua.jsn
68d946cbc26fecd262e042d03dca02fd42a3d10110327621ea7c17c73b53aed8  qcom/sc7180/Samsung/galaxy-book-go/modemr.jsn
b7e32e64c7f323dddbe8c687861c1f9d312191d306fbfee49ce404f80ce46807  qcom/sc7180/Samsung/galaxy-book-go/modemuw.jsn
5704b2b9be07fda4faeb8b3ba91dfff8124bc0fb7b96f85de4a14e787b9a8c9d  qcom/sc7180/Samsung/galaxy-book-go/qcadsp7180.mbn
ab040159aee7ab7e2631acc3d2873be3bf72eafe066521a9fd5d906759deefe6  qcom/sc7180/Samsung/galaxy-book-go/qcdxkmsuc7180.mbn
