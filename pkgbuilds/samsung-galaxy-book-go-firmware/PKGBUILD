# Audio DSP, GPU, video and modem firmware for the Samsung Galaxy Book Go. The firmware only runs
# if it is signed for this board by Samsung, so linux-firmware cannot carry it until the OEM
# submits it. The OEM ships it in the driver bundle it publishes for the machine on Windows
# Update, whose cabinets this recipe fetches with wudrivers and unpacks without running anything.
# Each file is checked against the SHA-256 it was matched to and installed under the name the
# device tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so
# once linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=samsung-galaxy-book-go-firmware
pkgver=20261116
pkgrel=1
pkgdesc='Audio DSP, GPU, video and modem firmware for the Samsung Galaxy Book Go'
arch=('aarch64')
url='https://github.com/birkskyum/wudrivers'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-sc7180-samsung-galaxy-book-go')
makedepends=('7zip' 'wudrivers')
options=('!strip' '!debug')
# Windows Update's links are short-lived, so wudrivers fetches a fresh one by update ID, revision and SHA-1.
DLAGENTS+=('wu::/usr/bin/wudrivers fetch %u -o %o')
source=(
  'samsung-galaxy-book-go-pajw-wu-200.0.17.0-qcsubsys-ext-adsp7180.cab::wu://96754232-ab9d-43a4-ab41-e6ffdc1b74b0/1/51ef3d273670c1df1df846d19ac283ddd745756f'
  'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcsubsys-ext-mpss7180.cab::wu://25c4b8c0-921d-48ee-9507-3064890b5e64/1/695c8f743c8e0676e4bb912e286436bb852e9ed9'
  'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcdx7180.cab::wu://25c4b8c0-921d-48ee-9507-3064890b5e64/1/fc0b35b7dd7eaf03782857844f7ce5e82038fa68'
  'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcwlan7180.cab::wu://25c4b8c0-921d-48ee-9507-3064890b5e64/1/1ad942b5aeff85656081cde8a5ad288cd4e84b15'
)
source+=('README.package.md')
noextract=('samsung-galaxy-book-go-pajw-wu-200.0.17.0-qcsubsys-ext-adsp7180.cab' 'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcsubsys-ext-mpss7180.cab' 'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcdx7180.cab' 'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcwlan7180.cab')
sha256sums=('56b2f48c292cd769e3b40de1f0413ef75986e57ab6213c68d1751260253530d4' '29c680eac1c3d35d679ee510417a17f1b032e56753b9fd5c46449c811b2534b7' '9270114e230e18a4d82016770ccb85e84fbe21a15f3db7e4ce0fb3fc0afb4aba' 'a53a79f652eee23952257f96a825921a0705970eb4f520ca18d042aaa42c5b2c')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'samsung-galaxy-book-go-pajw-wu-200.0.17.0-qcsubsys-ext-adsp7180.cab' 'samsung-galaxy-book-go-pajw-wu-200.0.17.0-qcsubsys-ext-adsp7180' 7z
  _unpack 'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcsubsys-ext-mpss7180.cab' 'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcsubsys-ext-mpss7180' 7z
  _unpack 'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcdx7180.cab' 'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcdx7180' 7z
  _unpack 'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcwlan7180.cab' 'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcwlan7180' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'samsung-galaxy-book-go-pajw-wu-200.0.17.0-qcsubsys-ext-adsp7180/adspr.jsn' "$fw"/'qcom/sc7180/Samsung/galaxy-book-go/adspr.jsn'
  install -Dm644 'samsung-galaxy-book-go-pajw-wu-200.0.17.0-qcsubsys-ext-adsp7180/adspua.jsn' "$fw"/'qcom/sc7180/Samsung/galaxy-book-go/adspua.jsn'
  install -Dm644 'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcsubsys-ext-mpss7180/modemr.jsn' "$fw"/'qcom/sc7180/Samsung/galaxy-book-go/modemr.jsn'
  install -Dm644 'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcsubsys-ext-mpss7180/modemuw.jsn' "$fw"/'qcom/sc7180/Samsung/galaxy-book-go/modemuw.jsn'
  install -Dm644 'samsung-galaxy-book-go-pajw-wu-200.0.17.0-qcsubsys-ext-adsp7180/qcadsp7180.mbn' "$fw"/'qcom/sc7180/Samsung/galaxy-book-go/qcadsp7180.mbn'
  install -Dm644 'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcdx7180/qcdxkmsuc7180.mbn' "$fw"/'qcom/sc7180/Samsung/galaxy-book-go/qcdxkmsuc7180.mbn'
  install -Dm644 'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcsubsys-ext-mpss7180/qcmpss7180_nm.mbn' "$fw"/'qcom/sc7180/Samsung/galaxy-book-go/qcmpss7180_nm.mbn'
  install -Dm644 'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcdx7180/qcvss7180.mbn' "$fw"/'qcom/sc7180/Samsung/galaxy-book-go/qcvss7180.mbn'
  install -Dm644 'samsung-galaxy-book-go-pajs-wu-200.0.18.0-qcwlan7180/WLANMDSP.MBN' "$fw"/'qcom/sc7180/Samsung/galaxy-book-go/wlanmdsp.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
