# Maintainer: David Heinemeier Hansson <david@hey.com>
pkgname='omarchy-amiga-screensaver'
pkgver=2026.10.27
pkgrel=1
# Pinned by hand to the demo repository's commit and versioned by its date:
# bump both when a demo is added or changed.
_commit=f5d2d0869d1b1b5b1f3af61d68b9be7fabbb6eec
pkgdesc='Amiga demos for the Omarchy screensaver'
arch=('any')
url='https://github.com/omacom/omarchy-amiga-screensaver'
license=('custom')
depends=('fs-uae')
makedepends=('git')
source=("omarchy-amiga-screensaver::git+https://github.com/omacom/omarchy-amiga-screensaver.git#commit=${_commit}")
sha256sums=('b15d042237f39daa954c054872ec8ed1707a27f8a9c362718c3e915669b2a1d5')

package() {
  cd "$srcdir/omarchy-amiga-screensaver"

  install -d "$pkgdir/usr/share/omarchy-amiga-screensaver"
  cp -a demos "$pkgdir/usr/share/omarchy-amiga-screensaver/"
  install -Dm644 README.md "$pkgdir/usr/share/licenses/$pkgname/README.md"
}
