# Maintainer: Michael Zimmerman <mmzim05@proton.me>

pkgname=ommata
pkgver=0.4.0
pkgrel=1
pkgdesc='Fast photo, RAW and video viewer with crop, frame-perfect video trimming and tags'
arch=('x86_64')
url='https://github.com/mmzim05/Ommata'
license=('GPL-3.0-or-later')
depends=(
  'alsa-lib'           # libasound, audio output
  'curl'               # update checks
  'gcc-libs'           # libgcc_s and libstdc++
  'glibc'
  'hicolor-icon-theme' # owns the directory the icon is installed into
  'libdrm'             # linked through libva-drm
  'libglvnd'           # libEGL, loaded at runtime for the GL window and zero-copy video
  'libva'              # GPU video decoding (VA-API)
  'libxkbcommon'       # keyboard maps, loaded by the window toolkit
  'wayland'            # libwayland-client, loaded by the window toolkit
  'x264'               # re-encodes the frames before a frame-exact trim cut
  'x265'
  'xdg-utils'          # xdg-open, for links
)
optdepends=(
  'xdg-desktop-portal: the Open file dialog'
)
# FFmpeg and dav1d are built from the pinned tarballs below and linked
# statically, as in upstream's AppImage.
makedepends=('cargo' 'clang' 'meson' 'nasm' 'ninja')
options=('!lto' '!debug')
_ffmpeg=9.0.2
_dav1d=1.5.4
source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
  "https://ffmpeg.org/releases/ffmpeg-$_ffmpeg.tar.xz"
  "https://downloads.videolan.org/pub/videolan/dav1d/$_dav1d/dav1d-$_dav1d.tar.xz"
)
sha256sums=('bba18f6e7270dca4cc3777f1cf336761b630492f79119f8b9b1d56b8a4cea9f4'
            '8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e'
            '686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5')
_dir="Ommata-$pkgver"

prepare() {
  cd "$_dir"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_dir"
  FFMPEG_SOURCE="$srcdir/ffmpeg-$_ffmpeg" DAV1D_SOURCE="$srcdir/dav1d-$_dav1d" \
    ./scripts/build-ffmpeg.sh
  cargo build --frozen --release
}

check() {
  cd "$_dir"
  cargo test --frozen --release
}

package() {
  cd "$_dir"
  DESTDIR="$pkgdir" PREFIX=/usr ./scripts/install.sh
}
