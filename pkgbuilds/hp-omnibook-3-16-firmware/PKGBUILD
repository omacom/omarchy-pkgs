# Audio DSP, compute DSP and GPU firmware for the HP OmniBook 3 16. The firmware only runs if it
# is signed for this board by HP, so linux-firmware cannot carry it until the OEM submits it. The
# OEM ships it in its Windows driver download, which this recipe unpacks without running. Each
# file is checked against the SHA-256 it was matched to and installed under the name the device
# tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so once
# linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=hp-omnibook-3-16-firmware
pkgver=20261107
pkgrel=1
pkgdesc='Audio DSP, compute DSP and GPU firmware for the HP OmniBook 3 16'
arch=('aarch64')
url='https://ftp.hp.com/pub/softpaq/sp174001-174500/sp174413.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1p42100-hp-omnibook-3-16-bz0')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'hp-sp174413.exe::https://ftp.hp.com/pub/softpaq/sp174001-174500/sp174413.exe'
)
noextract=('hp-sp174413.exe')
sha256sums=('86fcb80854fea8ac886c4bccd43b778c53a7b57ee2a79d68b1606a0954f372e9')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'hp-sp174413.exe' 'hp-sp174413' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'hp-sp174413/src/Driver/qcsubsys_ext_adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1p42100/hp/omnibook-3-16-bz0/adsp_dtbs.elf'
  install -Dm644 'hp-sp174413/src/Driver/qcsubsys_ext_adsp8380/adspr.jsn' "$fw"/'qcom/x1p42100/hp/omnibook-3-16-bz0/adspr.jsn'
  install -Dm644 'hp-sp174413/src/Driver/qcsubsys_ext_adsp8380/adsps.jsn' "$fw"/'qcom/x1p42100/hp/omnibook-3-16-bz0/adsps.jsn'
  install -Dm644 'hp-sp174413/src/Driver/qcsubsys_ext_adsp8380/adspua.jsn' "$fw"/'qcom/x1p42100/hp/omnibook-3-16-bz0/adspua.jsn'
  install -Dm644 'hp-sp174413/src/Driver/qcsubsys_ext_adsp8380/battmgr.jsn' "$fw"/'qcom/x1p42100/hp/omnibook-3-16-bz0/battmgr.jsn'
  install -Dm644 'hp-sp174413/src/Driver/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1p42100/hp/omnibook-3-16-bz0/cdsp_dtbs.elf'
  install -Dm644 'hp-sp174413/src/Driver/qcnspmcdm_ext_cdsp8380/cdspr.jsn' "$fw"/'qcom/x1p42100/hp/omnibook-3-16-bz0/cdspr.jsn'
  install -Dm644 'hp-sp174413/src/Driver/qcsubsys_ext_adsp8380/qcadsp8380.mbn' "$fw"/'qcom/x1p42100/hp/omnibook-3-16-bz0/qcadsp8380.mbn'
  install -Dm644 'hp-sp174413/src/Driver/qcnspmcdm_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1p42100/hp/omnibook-3-16-bz0/qccdsp8380.mbn'
  install -Dm644 'hp-sp174413/src/Driver/qcdx8380/qcdxkmsucpurwa.mbn' "$fw"/'qcom/x1p42100/hp/omnibook-3-16-bz0/qcdxkmsucpurwa.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
253c250971a7b8e1b263106b6415d578959b9c6233bd1a3aa10ddc033d6c5415  qcom/x1p42100/hp/omnibook-3-16-bz0/adsp_dtbs.elf
e9ba7199626b0c03f2ec02822d744f678ad567fe0625a28fe5f5908b7281e9db  qcom/x1p42100/hp/omnibook-3-16-bz0/adspr.jsn
19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e  qcom/x1p42100/hp/omnibook-3-16-bz0/adsps.jsn
d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d  qcom/x1p42100/hp/omnibook-3-16-bz0/adspua.jsn
b8aad1d149128f414eb1fd6fcbb6e0a5b7dabcd2cba001599e1ce9a0e2e291a4  qcom/x1p42100/hp/omnibook-3-16-bz0/battmgr.jsn
c1e3cdeee17e61ee5f9426fef78e5e35eaf9fdd49d3d39b9bd82dcad04c71647  qcom/x1p42100/hp/omnibook-3-16-bz0/cdsp_dtbs.elf
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x1p42100/hp/omnibook-3-16-bz0/cdspr.jsn
bb88ad197f538044f160cfe2a293eb5a9db82900b91e7db9f77376fa5ca3848e  qcom/x1p42100/hp/omnibook-3-16-bz0/qcadsp8380.mbn
4d2aa10aa60245177ca253d4a8f7ee15c0a0390e877efec29fa25c7d4b725568  qcom/x1p42100/hp/omnibook-3-16-bz0/qccdsp8380.mbn
05b09b7951148134068024e948c93f7a4688102600f1d8f9548ab470b73f6234  qcom/x1p42100/hp/omnibook-3-16-bz0/qcdxkmsucpurwa.mbn
