# Maintainer: Jason Alexander <jason@greatspark.com>
pkgname=omarchy-notes
pkgver=1.0.0
pkgrel=2
pkgdesc='Fast, native notes for Omarchy, inspired by Apple Notes'
arch=('x86_64')
url='https://lastrefuge.ai/projects/omarchy-notes'
license=('MIT')
depends=('glibc' 'hicolor-icon-theme' 'libgcc' 'libstdc++' 'qt6-base>=6.8' 'qt6-declarative>=6.8' 'qt6-svg' 'qt6-wayland' 'sqlite' 'xdg-utils')
makedepends=('cmake' 'ninja' 'pkgconf')
optdepends=('qt6-imageformats: WebP, TIFF and other image formats in notes')
source=("https://github.com/last-refuge/omarchy-notes/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
b2sums=('0d093ec9adafd01d8f08923df2493fb24f977171bb20f0b2b4f1fd11eb18f4288942efdad2e8df65a23d13523fef30b55ea3c8ff1ee3e5047fa2a62b8597e9f5')

build() {
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DBUILD_TESTING=OFF \
    -Wno-dev
  cmake --build build
}

check() {
  QT_QPA_PLATFORM=offscreen "$srcdir/build/src/app/omarchy-notes" --version
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
