# Maintainer: Jason Alexander <jason@greatspark.com>
# Generated from an immutable revision. Preserve the Rust executable identity.
pkgname=omarchy-notes
replaces=('omarchy-notes-rust')
conflicts=('omarchy-notes-rust')
pkgver=1.1.0
# Distinguish this cutover from the retired omarchy-notes 1.0.0-1 Qt package.
pkgrel=2
pkgdesc='Omarchy Notes — private local notes'
arch=('x86_64')
url='https://lastrefuge.ai/projects/omarchy-notes'
license=('MIT')
# GCC LTO objects from bundled C crates cannot link with Rust's LLVM linker.
options=('!lto')
depends=('glibc' 'libgcc' 'glib2' 'cairo' 'pango' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11'
         'wayland' 'vulkan-icd-loader' 'hicolor-icon-theme' 'noto-fonts-cjk' 'noto-fonts-emoji'
         'xdg-desktop-portal' 'xdg-utils')
makedepends=('rustup' 'clang' 'cmake' 'pkgconf' 'git' 'vulkan-headers' 'python')
optdepends=('vulkan-driver: Vulkan driver for your GPU'
            'xdg-desktop-portal-hyprland: Hyprland portal integration'
            'xdg-desktop-portal-gtk: file chooser portal backend')
source=("https://github.com/last-refuge/omarchy-notes/releases/download/rust-v${pkgver}/${pkgname}-${pkgver}.tar.gz")
b2sums=('9ac45fba8d38dd66c38a38215848d0ea88804aefd59ba006db1a53a321a32043e9edaedc1d307b4dd7fb699962a809ad80f13600836d764498244adfbf38c5d1')

prepare() {
  export CARGO_HOME="$srcdir/cargo-home"
  cd "$srcdir/$pkgname-$pkgver"
  # The source's rust-toolchain.toml supplies the exact toolchain.
  rustup show
  cargo fetch --locked --target x86_64-unknown-linux-gnu
}

build() {
  export CARGO_HOME="$srcdir/cargo-home" CARGO_TARGET_DIR="$srcdir/target"
  cd "$srcdir/$pkgname-$pkgver"
  cargo build --release --locked --offline -p omarchy-notes-preview --bin omarchy-notes-rust
  rm -rf -- "$srcdir/target/dependency-licenses"
  local license_flags=()
  case "$(< RELEASE_KIND)" in
    candidate) license_flags=(--candidate) ;;
    stable) license_flags=(--require-complete) ;;
    *) printf 'Unknown release kind; refusing package.\n' >&2; return 1 ;;
  esac
  python3 packaging/rust/collect-licenses.py --package omarchy-notes-preview \
    --target x86_64-unknown-linux-gnu --output "$srcdir/target/dependency-licenses" "${license_flags[@]}"
}

check() {
  [[ "$("$srcdir/target/release/omarchy-notes-rust" --version)" == "omarchy-notes-rust $pkgver" ]]
}

package() {
  local source_root="$srcdir/$pkgname-$pkgver"
  install -Dm755 "$srcdir/target/release/omarchy-notes-rust" "$pkgdir/usr/bin/omarchy-notes-rust"
  install -Dm755 "$source_root/packaging/rust/omarchy-notes-preview" "$pkgdir/usr/bin/omarchy-notes-preview"
  install -Dm644 "$source_root/packaging/desktop/org.omarchy.Notes.Rust.desktop" "$pkgdir/usr/share/applications/org.omarchy.Notes.Rust.desktop"
  install -Dm644 "$source_root/packaging/icons/org.omarchy.Notes.Rust.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.omarchy.Notes.Rust.svg"
  install -Dm644 "$source_root/packaging/metainfo/org.omarchy.Notes.Rust.metainfo.xml" "$pkgdir/usr/share/metainfo/org.omarchy.Notes.Rust.metainfo.xml"
  install -Dm644 "$source_root/packaging/man/omarchy-notes-rust.1" "$pkgdir/usr/share/man/man1/omarchy-notes-rust.1"
  local name
  for name in LICENSE; do install -Dm644 "$source_root/$name" "$pkgdir/usr/share/licenses/$pkgname/$name"; done
  install -Dm644 "$source_root/crates/notes-ui/assets/NOTICE.md" "$pkgdir/usr/share/licenses/$pkgname/ASSET-NOTICES.md"
  install -Dm644 "$source_root/crates/notes-ui/assets/GPUI-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/GPUI-LICENSE"
  install -Dm644 "$source_root/crates/notes-ui/assets/fonts/OFL.txt" "$pkgdir/usr/share/licenses/$pkgname/FONT-OFL.txt"
  for name in LICENSE-APACHE LICENSE-MIT; do
    install -Dm644 "$source_root/vendor/accesskit_unix/$name" "$pkgdir/usr/share/licenses/$pkgname/ACCESSKIT-$name"
  done
  install -d "$pkgdir/usr/share/licenses/$pkgname/dependencies"
  cp -r --no-preserve=ownership,mode -- "$srcdir/target/dependency-licenses/." "$pkgdir/usr/share/licenses/$pkgname/dependencies/"
  chmod -R a+rX "$pkgdir/usr/share/licenses/$pkgname/dependencies"
  for name in rust-edition.md rust-release.md; do
    install -Dm644 "$source_root/docs/$name" "$pkgdir/usr/share/doc/$pkgname/$name"
  done
  install -Dm644 "$source_root/SOURCE_REVISION" "$pkgdir/usr/share/doc/$pkgname/SOURCE_REVISION"
  install -Dm644 "$source_root/RELEASE_KIND" "$pkgdir/usr/share/doc/$pkgname/RELEASE_KIND"
}
