# Contributor: Peter Jung <ptr1337@archlinux.org>
# Contributor: Norbert Preining <norbert@preining.info>

pkgname=intel-lpmd
_commit='8ad715ff96dbe1dc01a35614c65bdfb0baef4a92'
pkgver=0.1.0.r175.g8ad715f
pkgrel=1
pkgdesc="Intel Low Power Mode Daemon"
arch=('x86_64')
url="https://github.com/intel/intel-lpmd"
license=('GPL-2.0-or-later')
install=intel-lpmd.install
makedepends=(
  autoconf-archive
  git
  glib2-devel
  gtk-doc
  systemd
)
depends=(
  glibc
  glib2
  libxml2
  libnl
  systemd-libs
  polkit
  upower
)
source=(
  "$pkgname::git+${url}.git#commit=${_commit}"
  'panther-lake-auto-lpm.patch'
)
sha256sums=(
  'SKIP'
  '46f6fdead0d826f399efee87e45133038204714ab28e256db99ab22d6eac8867'
)

prepare() {
  cd "$pkgname"

  # Upstream leaves Panther Lake in Mode=-1 and BalancedDef/PowersaverDef=-1
  # (DEFAULT_OFF), so WLT idle hints never engage LP-E pinning or power states.
  patch -p1 -i "$srcdir/panther-lake-auto-lpm.patch"

  # Let makepkg handle manpage compression and avoid running mandb during install.
  sed -i '/^install-data-hook:/,+2d' Makefile.am

  ./autogen.sh \
    --prefix=/usr \
    --sysconfdir=/etc \
    --sbindir=/usr/bin \
    --localstatedir=/var \
    --with-dbus-sys-dir=/usr/share/dbus-1/system.d
}

build() {
  cd "$pkgname"
  make
}

package() {
  cd "$pkgname"
  DESTDIR="$pkgdir" make install
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md doc/WLT_proxy.md
}
