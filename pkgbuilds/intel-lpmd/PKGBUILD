# Contributor: Norbert Preining <norbert@preining.info>

pkgname=intel-lpmd
_commit='8ad715ff96dbe1dc01a35614c65bdfb0baef4a92'
pkgver=0.1.0.r175.g8ad715f
pkgrel=3
pkgdesc="Intel Low Power Mode Daemon"
arch=('x86_64')
url="https://github.com/intel/intel-lpmd"
license=('GPL-2.0-or-later')
install=intel-lpmd.install
makedepends=(
  autoconf-archive
  git
  glib2-devel
  gtk-doc
  systemd
)
depends=(
  glibc
  glib2
  libxml2
  libnl
  systemd-libs
  polkit
  upower
)
source=(
  "$pkgname::git+${url}.git#commit=${_commit}"
  'panther-lake-auto-lpm.patch'
  'wildcat-lake-tuning.patch'
  'preserve-ppd-epb-on-restore.patch'
)
sha256sums=(
  'SKIP'
  '46f6fdead0d826f399efee87e45133038204714ab28e256db99ab22d6eac8867'
  '8f0a95c74e111e5553e6cf254954a313165d84f0765e4628e52f527a1812d0dd'
  '95aab4d8d0a033efe7244def07b23345799c9a83adc2f47f3b6d8e7997a9b176'
)

prepare() {
  cd "$pkgname"

  # Upstream leaves Panther Lake in Mode=-1 and BalancedDef/PowersaverDef=-1
  # (DEFAULT_OFF), so WLT idle hints never engage LP-E pinning or power states.
  patch -p1 -i "$srcdir/panther-lake-auto-lpm.patch"

  # Tune Wildcat Lake: Mode=0 / PowersaverDef=0, event-driven WLT (Poll=0),
  # fix UTIL_IDLE IRQMigrate=1 leak, add SoC Power Slider states, and let PPD
  # own EPP/EPB.
  patch -p1 -i "$srcdir/wildcat-lake-tuning.patch"

  # Upstream PR intel/intel-lpmd#146: keep DEFAULT_OFF (SETTING_RESTORE) from
  # overwriting power-profiles-daemon's energy_perf_bias (e.g. 0 -> 8 on
  # performance).
  patch -p1 -i "$srcdir/preserve-ppd-epb-on-restore.patch"

  # Let makepkg handle manpage compression and avoid running mandb during install.
  sed -i '/^install-data-hook:/,+2d' Makefile.am

  ./autogen.sh \
    --prefix=/usr \
    --sysconfdir=/etc \
    --sbindir=/usr/bin \
    --localstatedir=/var \
    --with-dbus-sys-dir=/usr/share/dbus-1/system.d
}

build() {
  cd "$pkgname"
  make
}

package() {
  cd "$pkgname"
  DESTDIR="$pkgdir" make install
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md doc/WLT_proxy.md
}
