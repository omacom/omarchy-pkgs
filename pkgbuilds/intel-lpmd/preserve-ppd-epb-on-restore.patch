+static int get_ppd_default_epb(void)
+{
+	int ppd_mode = get_ppd_mode();
+
+	if (ppd_mode == PPD_INVALID)
+		return -1;
+
+	if (ppd_mode == PPD_PERFORMANCE)
+		return 0;
+
+	if (ppd_mode == PPD_POWERSAVER)
+		return 15;
+
+	if (is_on_battery())
+		return 8;
+
+	return 6;
