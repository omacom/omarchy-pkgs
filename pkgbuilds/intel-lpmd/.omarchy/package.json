{
  "source": "local",
  "upstream": {
    "watch": {
      "git_branch": "https://github.com/intel/intel-lpmd.git",
      "branch": "main",
      "tag_pattern": "v(?P<version>[0-9]+(?:\\.[0-9]+)*)",
      "version": "{version}.r{distance}.g{commit:.7}",
      "variables": {
        "_commit": "{commit}"
      }
    }
  },
  "rebuild_on": [
    "libxml2"
  ],
  "rebuilt_against": {
    "x86_64": {
      "libxml2": "2.15.4-1"
    }
  }
}
