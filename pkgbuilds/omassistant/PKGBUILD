# Maintainer: Tom-Erik (https://github.com/trollieske)
pkgname=omassistant
pkgver=0.9.0
pkgrel=1
pkgdesc='Capability broker for Omassistant, a permissioned desktop assistant for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/trollieske/omassistant-plugin'
license=('MIT' 'Apache-2.0')
depends=(
  'curl'
  'grim'
  'hyprland'
  'omarchy'
  'util-linux'
  'wl-clipboard'
  'wtype'
  'xdg-utils'
)
makedepends=('cargo')
optdepends=(
  'betterbird-bin: mail launch action'
  'imagemagick: smaller vision captures'
  'pi: the agent runtime; Omarchy manages it through mise'
  'voxtype: local dictation'
  'wlrctl: pointer control'
)
conflicts=('omassistant-git')
options=('!debug' '!lto')
install='omassistant.install'

# The tag archive extracts to omassistant-plugin-<version>.
_archive="omassistant-plugin-$pkgver"
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f800ecc511955cd0ab056ee9345797075979215490875dc17340314da80f3396')

prepare() {
  cd "$srcdir/$_archive/daemon"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$srcdir/$_archive/daemon"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --locked --bins
}

check() {
  cd "$srcdir/$_archive/daemon"
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release --locked
}

package() {
  cd "$srcdir/$_archive/daemon"

  install -Dm755 target/release/omassistantd "$pkgdir/usr/bin/omassistantd"
  install -Dm755 target/release/omassistantctl "$pkgdir/usr/bin/omassistantctl"
  install -Dm755 target/release/omassistant-mcp "$pkgdir/usr/bin/omassistant-mcp"

  install -Dm644 "$srcdir/$_archive/LICENSE-MIT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 "$srcdir/$_archive/LICENSE-APACHE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
