# Maintainer: The Omarchy Authors

# linux-omarchy-bore was the BORE build of the Omarchy kernel, which is now
# linux-omarchy itself (pkgbuilds/linux-omarchy). These empty packages move a
# machine that installed linux-omarchy-bore onto linux-omarchy; the old
# kernel's files leave with the upgrade.
pkgbase=linux-omarchy-bore
pkgname=(
  linux-omarchy-bore
  linux-omarchy-bore-headers
)
pkgver=7.2.15
pkgrel=1
pkgdesc='Omarchy Linux (BORE CPU scheduler, ADIOS I/O scheduler), now linux-omarchy'
url='https://omarchy.org'
arch=(
  x86_64
)
license=(GPL-2.0-only)

package_linux-omarchy-bore() {
  pkgdesc="Transitional package: installs linux-omarchy, the Omarchy kernel this package became"
  depends=(
    linux-omarchy
  )
}

package_linux-omarchy-bore-headers() {
  pkgdesc="Transitional package: installs linux-omarchy-headers, the headers of the Omarchy kernel this package became"
  depends=(
    linux-omarchy-headers
  )
}
