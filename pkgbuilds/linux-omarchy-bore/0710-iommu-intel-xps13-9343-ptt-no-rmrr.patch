diff --git a/drivers/iommu/intel/iommu.c b/drivers/iommu/intel/iommu.c
--- a/drivers/iommu/intel/iommu.c
+++ b/drivers/iommu/intel/iommu.c
@@ -209,6 +209,7 @@ static int intel_iommu_superpage = 1;
 static int iommu_identity_mapping;
 static int iommu_skip_te_disable;
 static int disable_igfx_iommu;
+static int dmar_cmdline_on;
 
 #define IDENTMAP_AZALIA		4
 
@@ -241,6 +242,7 @@ static int __init intel_iommu_setup(char *str)
 	while (*str) {
 		if (!strncmp(str, "on", 2)) {
 			dmar_disabled = 0;
+			dmar_cmdline_on = 1;
 			pr_info("IOMMU enabled\n");
 		} else if (!strncmp(str, "off", 3)) {
 			dmar_disabled = 1;
@@ -2538,6 +2540,41 @@ static int __init probe_acpi_namespace_devices(void)
 	return 0;
 }
 
+/*
+ * On these machines the firmware-TPM (Intel PTT) command/response buffers
+ * live in system RAM and are fetched by a hidden ME function (00:16.7) via
+ * DMA, but the DMAR table has no RMRR covering them. With DMA remapping
+ * enabled those reads fault and tpm_crb probe times out, so the TPM is
+ * unusable. Keep the IOMMU off by default there; "intel_iommu=on" still
+ * enables it.
+ */
+static const struct dmi_system_id intel_iommu_ptt_no_rmrr[] __initconst = {
+	{
+		.ident = "Dell XPS 13 9343",
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "Dell Inc."),
+			DMI_MATCH(DMI_PRODUCT_NAME, "XPS 13 9343"),
+		},
+	},
+	{ }
+};
+
+static __init void intel_iommu_apply_dmi_quirks(void)
+{
+	const struct dmi_system_id *id;
+
+	if (dmar_disabled || dmar_cmdline_on)
+		return;
+
+	id = dmi_first_match(intel_iommu_ptt_no_rmrr);
+	if (!id)
+		return;
+
+	pr_info("%s: disabling DMA remapping by default, firmware TPM DMA is not covered by an RMRR (use intel_iommu=on to override)\n",
+		id->ident);
+	dmar_disabled = 1;
+}
+
 static __init int tboot_force_iommu(void)
 {
 	if (!tboot_enabled())
@@ -2558,6 +2595,8 @@ int __init intel_iommu_init(void)
 	struct dmar_drhd_unit *drhd;
 	struct intel_iommu *iommu;
 
+	intel_iommu_apply_dmi_quirks();
+
 	/*
 	 * Intel IOMMU is required for a TXT/tboot launch or platform
 	 * opt in, so enforce that.
