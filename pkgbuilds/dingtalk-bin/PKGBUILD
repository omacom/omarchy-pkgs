pkgname=dingtalk-bin
_appid=com.alibabainc.dingtalk
pkgver=8.3.1.261008001
pkgrel=1
pkgdesc='DingTalk (钉钉), the official Linux client'
arch=('x86_64' 'aarch64')
url='https://www.dingtalk.com/'
license=('LicenseRef-DingTalk')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'curl'
  'fontconfig'
  'freetype2'
  'gcc-libs'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'glu'
  'gnutls'
  'gtk3'
  'harfbuzz'
  'libdrm'
  'libglvnd'
  'libice'
  'libpulse'
  'libsm'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxcrypt-compat'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxkbcommon-x11'
  'libxrandr'
  'libxss'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'util-linux-libs'
  'xcb-util-image'
  'xcb-util-keysyms'
  'xcb-util-renderutil'
  'xcb-util-wm'
)
optdepends=('fcitx5-chinese-addons: Chinese input through the bundled fcitx5 Qt plugin')
makedepends=('icoutils' 'patchelf')
provides=("$_appid" 'dingtalk')
conflicts=("$_appid" 'dingtalk')
options=('!strip' '!debug')
source=('dingtalk.sh' 'dingtalk.desktop' 'LICENSE')
source_x86_64=("${_appid}_${pkgver}_amd64.deb::https://dtapp-pub.dingtalk.com/dingtalk-desktop/xc_dingtalk_update/linux_deb/Release/${_appid}_${pkgver}_amd64.deb")
source_aarch64=("${_appid}_${pkgver}_arm64.deb::https://dtapp-pub.dingtalk.com/dingtalk-desktop/xc_dingtalk_update/linux_deb/Release/${_appid}_${pkgver}_arm64.deb")
noextract=("${_appid}_${pkgver}_amd64.deb" "${_appid}_${pkgver}_arm64.deb")
sha256sums=('4f47dfc75704660d4aa5696cd584e04d3c7bc92ffdb308e9783bcb9068d47945'
            '22487737c65c99677eafce080746ab18b45df4cb2fc19a70a7359f99cacd038a'
            'f19abdda1e177879372c261f111a0e6b17c6912264d3a51f419b7c214015752c')
sha256sums_x86_64=('35ab680ded104abcdc53a67fcfcff2b56479997f16e8abfe11c41fbf58f5825e')
sha256sums_aarch64=('19c31e3eddec37c5b5c8adc5b12a7dbb20b9cd0416b97872477a6f865acf8603')

# Bundled copies the vendor's own postinst deletes on a current glibc distro
# (and Arch is newer than all of them): left in place, the GCC 8 libstdc++ and
# the old libm, libgbm and GL dispatch shadow Arch's and break Mesa and GTK.
# The bundled libcurl links OpenLDAP 2.4 and librtmp, which Arch does not have;
# Arch's libcurl then needs Arch's libssh2 and nghttp2, not the older bundled ones.
_unbundle=(
  'libstdc++.so.6*'
  'libm.so.6'
  'libm-2.31.so'
  'libgbm.so*'
  'libGLX.so*'
  'libGLdispatch.so*'
  'libharfbuzz.so*'
  'libcurl.so.4'
  'libssh2.so.1'
  'libnghttp2.so.14'
)

prepare() {
  local deb
  case $CARCH in
    x86_64) deb="${_appid}_${pkgver}_amd64.deb" ;;
    aarch64) deb="${_appid}_${pkgver}_arm64.deb" ;;
  esac
  rm -rf deb && mkdir deb
  bsdtar -O -xf "$deb" 'data.tar.*' | bsdtar -C deb -xf -
}

package() {
  local files="deb/opt/apps/$_appid/files"
  local version=$(<"$files/version")
  if [[ ${version/-Release./.} != "$pkgver" ]]; then
    error "The deb carries DingTalk $version, not $pkgver"
    return 1
  fi
  local release="$files/$version"
  local dest="$pkgdir/opt/dingtalk"
  [[ -x $release/$_appid ]] || { error "No $_appid binary under $release"; return 1; }
  local machine
  machine=$(readelf -h "$release/$_appid" | sed -n 's/^ *Machine: *//p')
  case $CARCH:$machine in
    'x86_64:Advanced Micro Devices X86-64' | aarch64:AArch64) ;;
    *) error "The $CARCH deb ships a $machine binary"; return 1 ;;
  esac

  install -d "$dest"
  cp -a --no-preserve=ownership "$release" "$dest/release"
  install -m644 "$files/version" "$dest/version"

  local lib
  for lib in "${_unbundle[@]}"; do
    rm -f "$dest/release/"$lib
  done

  # glibc 2.41 refuses to dlopen a library that asks for an executable stack.
  local file
  while IFS= read -r -d '' file; do
    if readelf -lW "$file" 2>/dev/null | grep -q 'GNU_STACK.*RWE'; then
      patchelf --clear-execstack "$file"
    fi
  done < <(find "$dest/release" -type f -name '*.so*' -print0)

  # The vendor postinst makes chrome-sandbox setuid root, but DingTalk starts
  # its CEF processes with --no-sandbox, so the helper never runs.
  chmod 755 "$dest/release/plugins/dtwebview/chrome-sandbox"

  local odd
  odd=$(find "$dest" \( -perm /6000 -o \( ! -type l -perm /022 \) \) -printf '%M %P\n')
  if [[ -n $odd ]]; then
    error "Unexpected setuid, setgid or writable paths in the vendor tree:"
    plain "$odd"
    return 1
  fi

  install -Dm755 dingtalk.sh "$pkgdir/usr/bin/dingtalk"
  install -Dm644 dingtalk.desktop "$pkgdir/usr/share/applications/$_appid.desktop"

  icotool -x -w 256 -o dingtalk.png "$files/logo.ico"
  install -Dm644 dingtalk.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/dingtalk.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
