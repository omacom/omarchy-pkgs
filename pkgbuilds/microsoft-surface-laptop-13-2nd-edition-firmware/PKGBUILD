# Audio DSP and compute DSP firmware for the Microsoft Surface Laptop 13-inch 2nd Edition. The
# firmware only runs if it is signed for this board by Microsoft, so linux-firmware cannot carry
# it until the OEM submits it. The OEM ships it in its Windows driver download, which this recipe
# unpacks without running. Each file is checked against the SHA-256 it was matched to and
# installed under the name the device tree requests, compressed with xz. The kernel tries a plain
# name, then .zst, then .xz, so once linux-firmware ships the same file, its copy is the one
# loaded, and the two packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=microsoft-surface-laptop-13-2nd-edition-firmware
pkgver=20261114
pkgrel=1
pkgdesc='Audio DSP and compute DSP firmware for the Microsoft Surface Laptop 13-inch 2nd Edition'
arch=('aarch64')
url='https://www.microsoft.com/en-us/download/details.aspx?id=108876'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-kalambo-microsoft-surfacelaptop13')
makedepends=('7zip' 'msitools')
options=('!strip' '!debug')
source=(
  'microsoft-surfacelaptop13in2ndeditionwithsnapdragon.msi::https://download.microsoft.com/download/30ff24b5-e65e-4fde-9c22-491e6ac81c16/SurfaceLaptop13in2ndEditionwithSnapdragon_Win11_28000_26.083.37733.0.msi'
)
source+=('README.package.md')
noextract=('microsoft-surfacelaptop13in2ndeditionwithsnapdragon.msi')
sha256sums=('6301570ca49f810c6b63b0eb5c2f729bb3072508e42cdfa980be65af8f1950ef')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'microsoft-surfacelaptop13in2ndeditionwithsnapdragon.msi' 'microsoft-surfacelaptop13in2ndeditionwithsnapdragon' msi
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'microsoft-surfacelaptop13in2ndeditionwithsnapdragon/SurfaceUpdate/proextadsp8480/adsp_dtbs.elf' "$fw"/'qcom/kalambo/Microsoft/SurfaceLaptop13/adsp_dtbs.elf'
  install -Dm644 'microsoft-surfacelaptop13in2ndeditionwithsnapdragon/SurfaceUpdate/proextadsp8480/adspr.jsn' "$fw"/'qcom/kalambo/Microsoft/SurfaceLaptop13/adspr.jsn'
  install -Dm644 'microsoft-surfacelaptop13in2ndeditionwithsnapdragon/SurfaceUpdate/proextadsp8480/adsps.jsn' "$fw"/'qcom/kalambo/Microsoft/SurfaceLaptop13/adsps.jsn'
  install -Dm644 'microsoft-surfacelaptop13in2ndeditionwithsnapdragon/SurfaceUpdate/proextadsp8480/adspua.jsn' "$fw"/'qcom/kalambo/Microsoft/SurfaceLaptop13/adspua.jsn'
  install -Dm644 'microsoft-surfacelaptop13in2ndeditionwithsnapdragon/SurfaceUpdate/qcnspmcdm8480/cdsp_dtbs.elf' "$fw"/'qcom/kalambo/Microsoft/SurfaceLaptop13/cdsp_dtbs.elf'
  install -Dm644 'microsoft-surfacelaptop13in2ndeditionwithsnapdragon/SurfaceUpdate/proextadsp8480/qcadsp8480.mbn' "$fw"/'qcom/kalambo/Microsoft/SurfaceLaptop13/qcadsp8480.mbn'
  install -Dm644 'microsoft-surfacelaptop13in2ndeditionwithsnapdragon/SurfaceUpdate/qcnspmcdm8480/qccdsp8480.mbn' "$fw"/'qcom/kalambo/Microsoft/SurfaceLaptop13/qccdsp8480.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
dc2230da43b08c8c0fdf80a27f73d69a2acd74e98eec2462480220d71b20c6d6  qcom/kalambo/Microsoft/SurfaceLaptop13/adsp_dtbs.elf
e9ba7199626b0c03f2ec02822d744f678ad567fe0625a28fe5f5908b7281e9db  qcom/kalambo/Microsoft/SurfaceLaptop13/adspr.jsn
19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e  qcom/kalambo/Microsoft/SurfaceLaptop13/adsps.jsn
d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d  qcom/kalambo/Microsoft/SurfaceLaptop13/adspua.jsn
dfd345ab5ee9dba7fc7d717a35a3b9bb96f195a1d2cde18af41be1945d8599db  qcom/kalambo/Microsoft/SurfaceLaptop13/cdsp_dtbs.elf
4755dc27cf447fa2f54236c33d16434d8223971b1c0b364f03fa2afba45499f2  qcom/kalambo/Microsoft/SurfaceLaptop13/qcadsp8480.mbn
2798125b8458d47b4e1adbd3ae2451fdb20ee6add9ea4dc6211c96d96210a2b9  qcom/kalambo/Microsoft/SurfaceLaptop13/qccdsp8480.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
