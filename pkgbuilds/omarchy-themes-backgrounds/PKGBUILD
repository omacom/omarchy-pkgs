# Maintainer: David Heinemeier Hansson <david@hey.com>
pkgname='omarchy-themes-backgrounds'
pkgver=2026.11.28
pkgrel=1
pkgdesc='Background stills for the Omarchy themes'
arch=('any')
url='https://github.com/omacom/omarchy-themes-backgrounds'
license=('MIT')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('6f6327f867ef9000f0a415d90bac7e3d7296ef313577a7fbcbe90bb3a3560549')

package() {
  cd "$srcdir/$pkgname-$pkgver"

  local still theme
  for still in */*; do
    theme=${still%%/*}
    install -Dm644 "$still" "$pkgdir/usr/share/omarchy/themes/$theme/backgrounds/${still#*/}"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
