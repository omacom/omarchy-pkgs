# Maintainer: David Heinemeier Hansson <david@hey.com>
pkgname='omarchy-themes-backgrounds'
pkgver=2026.11.25
pkgrel=1
pkgdesc='Background stills for the Omarchy themes'
arch=('any')
url='https://github.com/omacom/omarchy-themes-backgrounds'
license=('MIT')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('dee1fe631c1569a3199e10dcf3f204fad95973d369047293245423d3b71bd92f')

package() {
  cd "$srcdir/$pkgname-$pkgver"

  local still theme
  for still in */*; do
    theme=${still%%/*}
    install -Dm644 "$still" "$pkgdir/usr/share/omarchy/themes/$theme/backgrounds/${still#*/}"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
