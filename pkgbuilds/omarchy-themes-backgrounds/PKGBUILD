# Maintainer: David Heinemeier Hansson <david@hey.com>
pkgname='omarchy-themes-backgrounds'
pkgver=2026.11.27
pkgrel=1
pkgdesc='Background stills for the Omarchy themes'
arch=('any')
url='https://github.com/omacom/omarchy-themes-backgrounds'
license=('MIT')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('1612a941fffde6542bf1250bdda10c9577bbeebe5df10d60abfc3ca8c74d6327')

package() {
  cd "$srcdir/$pkgname-$pkgver"

  local still theme
  for still in */*; do
    theme=${still%%/*}
    install -Dm644 "$still" "$pkgdir/usr/share/omarchy/themes/$theme/backgrounds/${still#*/}"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
