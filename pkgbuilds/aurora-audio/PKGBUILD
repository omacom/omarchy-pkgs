pkgname=aurora-audio
pkgver=4.1.aurora3
pkgrel=4
pkgdesc='Aurora Apple Silicon PipeWire/WirePlumber DSP profiles including J700'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/aurora-silicon/asahi-audio'
license=('MIT' 'GPL-2.0-only')
_commit=06aec67a8ac866eb5b40f44634652beff454e297
makedepends=('git' 'make')
provides=("asahi-audio=$pkgver" "asahi-audio-aurora=$pkgver")
conflicts=('asahi-audio' 'asahi-audio-aurora')
replaces=('asahi-audio-aurora')
# J616s speakers, which asahi-audio at $_commit does not cover yet:
# - graph-j616.json: aurora-silicon/asahi-audio c967141161be, firs/j616/graph.json (MIT)
# - 99-asahi-j616.conf: the WirePlumber rule that puts that graph on hw:AppleJ616,1
# - speakersafetyd-j616.conf: aurora-silicon/alarm-aurora f757ef3e3a,
#   packages/speakersafetyd-aurora-profiles/j616.conf (GPL-2.0-only): speakersafetyd
#   2.0.1's j316.conf model values with the J616 sense layout
source=("asahi-audio::git+$url.git#commit=$_commit"
        graph-j616.json
        99-asahi-j616.conf
        speakersafetyd-j616.conf)
sha256sums=('SKIP'
            '2e23da890a094249cef03b3d74eca7a246794fcfbb2c255444b12df18db28dd0'
            'c7ee9605e02d20bef07666441de5648a6845cd8e39146ead1cd053b63c9d2bf2'
            'a410bfd1a17cb4ebaed95278152029c6e9dd5862d52a918c12a4b3db01f0ffaf')
package() {
  # The profile files can be packaged without installing the target audio stack.
  depends=('alsa-ucm-conf-aurora' 'pipewire-audio' 'wireplumber' 'bankstown'
           'lsp-plugins-lv2' 'triforce-lv2>=0.2.0' 'speakersafetyd' 'speakerguardd')
  make -C asahi-audio install DESTDIR="$pkgdir" PREFIX=/usr
  install -Dm644 asahi-audio/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 graph-j616.json "$pkgdir/usr/share/asahi-audio/j616/graph.json"
  install -Dm644 99-asahi-j616.conf "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/99-asahi-j616.conf"
  install -Dm644 speakersafetyd-j616.conf "$pkgdir/usr/share/speakersafetyd/apple/j616.conf"
}
