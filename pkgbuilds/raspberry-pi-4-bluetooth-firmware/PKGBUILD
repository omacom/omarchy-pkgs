# Maintainer: Emir Beganovic <beganovic.emir@gmail.com>

pkgname=raspberry-pi-4-bluetooth-firmware
pkgver=20251002
pkgrel=1
pkgdesc="Bluetooth patch firmware for the Raspberry Pi 4 Model B's CYW43455"
arch=('aarch64')
url="https://github.com/RPi-Distro/bluez-firmware"
license=('LicenseRef-LICENCE.cypress')
options=('!strip' '!debug')
_commit=cdf61dc691a49ff01a124752bd04194907f0f9cd
_linux_firmware=20261019
source=(
  "BCM4345C0-${_commit}.hcd::https://raw.githubusercontent.com/RPi-Distro/bluez-firmware/${_commit}/debian/firmware/broadcom/BCM4345C0.hcd"
  "LICENCE.cypress-${_linux_firmware}::https://gitlab.com/kernel-firmware/linux-firmware/-/raw/${_linux_firmware}/LICENSES/LICENCE.cypress"
)
sha256sums=('51c45e77ddad91a19e96dc8fb75295b2087c279940df2634b23baf71b6dea42c'
            'ae0db6cc4db33941148df0f67de53e76a77b1b5a46b3165edb7040aa2750015f')

package() {
  # btbcm asks for the board-specific name first, so only a Pi 4 Model B
  # picks this file up.
  install -Dm644 "BCM4345C0-${_commit}.hcd" \
    "${pkgdir}/usr/lib/firmware/brcm/BCM4345C0.raspberrypi,4-model-b.hcd"
  install -Dm644 "LICENCE.cypress-${_linux_firmware}" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENCE.cypress"
}
