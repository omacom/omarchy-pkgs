#!/usr/bin/env bash
# Move leftover per-user files from the old Omareader curl installer aside.
# Never deletes. Run as the user who installed it, not as root.
set -euo pipefail

if [[ "${EUID}" -eq 0 ]]; then
  printf '%s\n' "omareader-cleanup-legacy: refusing to run as root. Run it as your user." >&2
  exit 1
fi

shopt -s nullglob

host_json="com.bhp.omareader.json"
ext_json="mhglniaepbokfgnpeennihlifandcgjh.json"
config="${HOME}/.config"
stamp="$(date +%Y%m%d-%H%M%S)"
backup="${HOME}/omareader-old/${stamp}"
share="${HOME}/.local/share/omareader"

candidates=()

add_existing() {
  local path="$1"
  if [[ -e "${path}" || -L "${path}" ]]; then
    candidates+=("${path}")
  fi
}

add_matches() {
  local path
  for path in "$@"; do
    candidates+=("${path}")
  done
}

add_existing "${config}/chromium/NativeMessagingHosts/${host_json}"
add_matches "${config}/BraveSoftware/"*"/NativeMessagingHosts/${host_json}"
add_existing "${config}/google-chrome/NativeMessagingHosts/${host_json}"
add_existing "${config}/microsoft-edge/NativeMessagingHosts/${host_json}"

# One level covers Chromium, Chrome, and Edge. Brave and Brave Origin are
# ~/.config/BraveSoftware/<browser>/External Extensions/.
add_matches "${config}/"*"/External Extensions/${ext_json}"
add_matches "${config}/BraveSoftware/"*"/External Extensions/${ext_json}"

if [[ -e "${share}" || -L "${share}" ]]; then
  candidates+=("${share}")
fi

print_moved() {
  local src="$1"
  local file
  if [[ -d "${src}" && ! -L "${src}" ]]; then
    while IFS= read -r -d '' file; do
      printf '%s\n' "${file}"
    done < <(find "${src}" -print0)
  else
    printf '%s\n' "${src}"
  fi
}

move_path() {
  local src="$1"
  local rel="${src#"${HOME}/"}"
  local target

  if [[ "${rel}" == "${src}" || -z "${rel}" || "${rel}" == /* ]]; then
    printf 'omareader-cleanup-legacy: refusing to move %s\n' "${src}" >&2
    exit 1
  fi

  target="${backup}/${rel}"
  if [[ -e "${target}" || -L "${target}" ]]; then
    printf 'omareader-cleanup-legacy: refusing to overwrite %s\n' "${target}" >&2
    exit 1
  fi

  print_moved "${src}"
  mkdir -p -- "$(dirname -- "${target}")"
  mv -- "${src}" "${target}"
}

if [[ "${#candidates[@]}" -eq 0 ]]; then
  printf '%s\n' "nothing to clean up"
else
  if [[ -e "${backup}" || -L "${backup}" ]]; then
    printf 'omareader-cleanup-legacy: %s already exists\n' "${backup}" >&2
    exit 1
  fi
  for path in "${candidates[@]}"; do
    move_path "${path}"
  done
fi

printf '%s\n' "Run: pkill -f omareader-host"
printf '%s\n' "Then fully restart your browser."
