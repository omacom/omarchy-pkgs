pkgname=bypass
pkgver=0.3.0
pkgrel=1
pkgdesc='KeePass-compatible secrets manager with agent CLI access'
arch=('x86_64' 'aarch64')
url='https://github.com/yaroshevych/bypass'
license=('MIT')
optdepends=('wl-clipboard: copy fields on Wayland' 'xclip: copy fields on X11')

source=("LICENSE-$pkgver::https://raw.githubusercontent.com/yaroshevych/bypass/v$pkgver/LICENSE")
sha256sums=('54cf7b716c85a4a5911a09de2fe15689f6b40d1c27ca0bb6153c800f54e71570')
source_x86_64=("bypass_${pkgver}_linux_amd64.tar.gz::https://github.com/yaroshevych/bypass/releases/download/v${pkgver}/bypass_${pkgver}_linux_amd64.tar.gz")
sha256sums_x86_64=('332fe59ac7955fd1590a3918efd411bcabe650ddd419d2fa83467a96582b3e99')
source_aarch64=("bypass_${pkgver}_linux_arm64.tar.gz::https://github.com/yaroshevych/bypass/releases/download/v${pkgver}/bypass_${pkgver}_linux_arm64.tar.gz")
sha256sums_aarch64=('702857b66212a666e90ddeba84d54f907edb0009a247bfcf3fe8e754c8fd4d6f')
noextract=("bypass_${pkgver}_linux_amd64.tar.gz" "bypass_${pkgver}_linux_arm64.tar.gz")

package() {
    local goarch
    case "$CARCH" in
        x86_64) goarch=amd64 ;;
        aarch64) goarch=arm64 ;;
        *) return 1 ;;
    esac
    mkdir -p "$pkgdir/usr/bin"
    bsdtar --no-same-owner -xzf "$srcdir/bypass_${pkgver}_linux_${goarch}.tar.gz" -C "$pkgdir/usr/bin" bypass
    chmod 755 "$pkgdir/usr/bin/bypass"
    install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
