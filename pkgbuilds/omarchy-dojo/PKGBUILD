# Maintainer: Pierre Charlier <pierre.charlier@cit-consulting.be>
pkgname=omarchy-dojo
pkgver=1.0.0
pkgrel=1
pkgdesc='Train Omarchy shortcuts, one belt at a time'
arch=('x86_64' 'aarch64')
url='https://github.com/aponhcet/omarchy-dojo'
license=('MIT')
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
)
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c14880102f87988138f27ba9329177edcc61f1d49815857c42a4ebe276e13e04')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 build/omarchy-dojo "$pkgdir/usr/bin/omarchy-dojo"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/omarchy-dojo.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omarchy-dojo.svg"
  install -Dm644 pkgbuild/omarchy-dojo.desktop "$pkgdir/usr/share/applications/omarchy-dojo.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
