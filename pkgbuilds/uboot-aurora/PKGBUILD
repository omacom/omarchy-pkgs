pkgname=uboot-aurora
pkgver=2026.07.aurora6
pkgrel=1
pkgdesc='Aurora common Apple Silicon U-Boot with Neo MTP handoff (Omarchy build: silent console)'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/aurora-silicon/u-boot'
license=('GPL-2.0-or-later')
_commit=d30213eadcaa886f4206d7661b61bc6cf7837828
provides=("uboot-asahi=$pkgver")
conflicts=('uboot-asahi' 'uboot-asahi-j700')
replaces=('uboot-asahi-j700')
makedepends=('git' 'bc' 'dtc' 'python' 'python-pyelftools' 'swig' 'openssl')
options=('!strip' '!debug')
source=("u-boot::git+$url.git#commit=$_commit" quiet-console.patch)
sha256sums=('SKIP' '9c3db1a504c5eeac54fadb1dadb45ac5ea36316c39fadb73836102ac4bf125f0')
prepare() {
  cd u-boot
  patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f < ../quiet-console.patch
  make O=build-aurora CROSS_COMPILE="${CROSS_COMPILE:-}" PYTHON3=/usr/bin/python3 apple_m1_defconfig
  # Same silent console as uboot-asahi: no banner, logo, environment or
  # bootflow text on the panel or serial port, and no boot delay. The
  # kernel's console is untouched.
  scripts/config --file build-aurora/.config \
    -e SILENT_CONSOLE \
    -e SILENT_CONSOLE_UPDATE_ON_SET \
    -e SILENT_CONSOLE_UPDATE_ON_RELOC \
    -e SILENT_CONSOLE_UNTIL_ENV \
    -e SILENT_U_BOOT_ONLY \
    -d VIDEO_LOGO \
    --set-val BOOTDELAY 0
  # asahi-alarm's uefi-enable-SetVariableRT-with-volotile-storage.patch, as
  # config: SetVariable at runtime in RAM, with the file store named through
  # RTStorageVolatile/VarToFile. Without it efivarfs is read-only, so
  # systemctl reboot --boot-loader-menu (Reboot to Boot Menu) cannot ask
  # Limine for its menu. The file store it depends on is already the default.
  scripts/config --file build-aurora/.config -e EFI_RT_VOLATILE_STORE
  make O=build-aurora CROSS_COMPILE="${CROSS_COMPILE:-}" PYTHON3=/usr/bin/python3 olddefconfig
  grep -qx 'CONFIG_EFI_RT_VOLATILE_STORE=y' build-aurora/.config
}
build() {
  cd u-boot
  make O=build-aurora CROSS_COMPILE="${CROSS_COMPILE:-}" PYTHON3=/usr/bin/python3 -j"${OMARCHY_BUILD_JOBS:-10}"
}
package() {
  install -Dm644 u-boot/build-aurora/u-boot-nodtb.bin "$pkgdir/usr/lib/asahi-boot/u-boot-nodtb.bin"
  install -d "$pkgdir/usr/lib/asahi-boot-j700"
  ln -s ../asahi-boot/u-boot-nodtb.bin "$pkgdir/usr/lib/asahi-boot-j700/u-boot-nodtb.bin"
  install -Dm644 u-boot/Licenses/gpl-2.0.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # DTBs come from linux-aurora; generated u-boot.dtb is the default J274 tree.
}
