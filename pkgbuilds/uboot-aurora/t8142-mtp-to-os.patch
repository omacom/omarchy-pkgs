diff --git a/drivers/input/apple_mtp_kbd.c b/drivers/input/apple_mtp_kbd.c
index 9aca5d50f0c..66f70fc35c9 100644
--- a/drivers/input/apple_mtp_kbd.c
+++ b/drivers/input/apple_mtp_kbd.c
@@ -404,6 +404,17 @@ static int apple_mtp_kbd_check(struct input_config *input)
 	return 0;
 }
 
+/* Whether the keyboard's helper is a T8142 MTP. */
+static bool apple_mtp_kbd_t8142(struct udevice *dev)
+{
+	u32 phandle;
+
+	if (dev_read_u32(dev, "apple,helper-cpu", &phandle) < 0)
+		return false;
+	return ofnode_device_is_compatible(ofnode_get_by_phandle(phandle),
+					   "apple,t8142-mtp");
+}
+
 static int get_rtkit_helper(struct udevice *dev)
 {
 	struct apple_mtp_kbd_priv *priv = dev_get_priv(dev);
@@ -442,11 +453,13 @@ static int apple_mtp_kbd_probe(struct udevice *dev)
 	fdt_addr_t reg;
 
 	/*
-	 * J813 and J604 cannot restart MTP after U-Boot shuts it down, and Linux
-	 * wakes the T6050 MTP from the state iBoot left it in. J713 retains its
-	 * running helper and replays discovery packets to Linux at OS handoff.
+	 * iBoot starts the T8142 MTP before the OS, and its firmware cannot be
+	 * started again once U-Boot shuts it down, so it is left to the OS
+	 * untouched. J604 cannot restart its MTP either, and Linux wakes the
+	 * T6050 MTP from the state iBoot left it in. J713 retains its running
+	 * helper and replays discovery packets to Linux at OS handoff.
 	 */
-	if (of_machine_is_compatible("apple,j813") ||
+	if (apple_mtp_kbd_t8142(dev) ||
 	    of_machine_is_compatible("apple,j604") ||
 	    of_machine_is_compatible("apple,t6050"))
 		return -ENODEV;
