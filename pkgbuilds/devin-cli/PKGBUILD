# Maintainer: The Omarchy Authors
pkgname=devin-cli
pkgver=3000.14.30821
pkgrel=1
pkgdesc="Devin for Terminal, Cognition's coding agent CLI"
arch=('x86_64' 'aarch64')
url="https://docs.devin.ai/cli"
license=('LicenseRef-Cognition')
# The binary is statically linked, so it depends on nothing.
optdepends=('git: work with repositories')
options=('!strip' '!debug')
# Copied from https://cognition.ai/terms-of-service, the license the devin npm package names.
source=('Cognition-Platform-Terms')
source_x86_64=("devin-${pkgver}-x86_64.tar.gz::https://static.devin.ai/cli/${pkgver}/devin-${pkgver}-x86_64-unknown-linux.tar.gz")
source_aarch64=("devin-${pkgver}-aarch64.tar.gz::https://static.devin.ai/cli/${pkgver}/devin-${pkgver}-aarch64-unknown-linux.tar.gz")
noextract=("devin-${pkgver}-x86_64.tar.gz" "devin-${pkgver}-aarch64.tar.gz")
sha256sums=('de69acad53d40805405affe8bcdd80c0c2c8fe60a2389ac2ebb6b402fb9e1a4b')
sha256sums_x86_64=('4dc43e3e4388bace60fe2aa8010cbb399402e724892d7175845b1cdef00e7ddb')
sha256sums_aarch64=('3deb8af6b026060e975ed371936e139818020e5dc5abbcba07cde039f473a5a5')

package() {
  # Devin reads its bundled docs from share/devin beside bin/.
  install -dm755 "${pkgdir}/usr/lib/${pkgname}" "${pkgdir}/usr/bin" "${pkgdir}/usr/share"
  bsdtar --no-same-owner -xf "${srcdir}/devin-${pkgver}-${CARCH}.tar.gz" -C "${pkgdir}/usr/lib/${pkgname}"
  mv "${pkgdir}/usr/lib/${pkgname}/share/man" "${pkgdir}/usr/share/man"

  # Devin only updates itself from the per-user layout its install script
  # creates (~/.local/share/devin). Installed here, that updater stays off and
  # pacman brings new releases. It has no switch to hide its notice of a newer
  # release.
  ln -s "/usr/lib/${pkgname}/bin/devin" "${pkgdir}/usr/bin/devin"

  install -Dm644 Cognition-Platform-Terms "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
