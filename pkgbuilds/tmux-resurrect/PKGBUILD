# Maintainer: Omarchy <support@omarchy.org>

pkgname=tmux-resurrect
pkgver=4.0.0
pkgrel=1
pkgdesc='Persist tmux sessions across server restarts'
arch=('any')
url='https://github.com/tmux-plugins/tmux-resurrect'
license=('MIT')
depends=('bash' 'tmux')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f8559d86d81be769054d63b28a268229a09bc6cc311f0623656c3090ec781b76')

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -d "$pkgdir/usr/share/$pkgname"
  cp -a . "$pkgdir/usr/share/$pkgname/"
  find "$pkgdir/usr/share/$pkgname" -type f -name '*.sh' -exec chmod 0755 {} +
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
