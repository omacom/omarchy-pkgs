# Audio DSP and compute DSP firmware for the Acer Swift Spin 14 AI. The firmware only runs if it
# is signed for this board by Acer, so linux-firmware cannot carry it until the OEM submits it.
# The OEM ships it in its Windows driver download, which this recipe unpacks without running. Each
# file is checked against the SHA-256 it was matched to and installed under the name the device
# tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so once
# linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=acer-swift-spin-14-ai-firmware
pkgver=20261115
pkgrel=1
pkgdesc='Audio DSP and compute DSP firmware for the Acer Swift Spin 14 AI'
arch=('aarch64')
url='https://www.acer.com/us-en/support/product-support/SFSP14-Q51T'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-glymur-acer-sfsp14-q51t')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'acer-sfsp14-q51t-qualcomm-base-driver-685.13804.40.0.zip::https://global-download.acer.com/GDFiles/Driver/Base%20Driver/Base%20Driver_Qualcomm_685.13804.40.0_W11ARM64_A.zip?acerid=639186471105972146&Step1=&Step2=&Step3=SWIFT%20SFSP14-Q51T&OS=ALL&LC=en&BC=ACER&SC=PA_6'
)
source+=('README.package.md')
noextract=('acer-sfsp14-q51t-qualcomm-base-driver-685.13804.40.0.zip')
sha256sums=('58d0aa896171fc3b895ccb0423ff506e5282bc0edcd2dcc5357bec35a10faeb9')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'acer-sfsp14-q51t-qualcomm-base-driver-685.13804.40.0.zip' 'acer-sfsp14-q51t-qualcomm-base-driver-685.13804.40.0' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'acer-sfsp14-q51t-qualcomm-base-driver-685.13804.40.0/Base Driver_Qualcomm_685.13804.40.0_W11ARM64_(Qualcomm Base Driver)/longcheer/qcsubsys_ext_adsp8480/adsp_dtbs.elf' "$fw"/'qcom/glymur/ACER/SFSP14-Q51T/adsp_dtbs.elf'
  install -Dm644 'acer-sfsp14-q51t-qualcomm-base-driver-685.13804.40.0/Base Driver_Qualcomm_685.13804.40.0_W11ARM64_(Qualcomm Base Driver)/longcheer/qcsubsys_ext_adsp8480/adspr.jsn' "$fw"/'qcom/glymur/ACER/SFSP14-Q51T/adspr.jsn'
  install -Dm644 'acer-sfsp14-q51t-qualcomm-base-driver-685.13804.40.0/Base Driver_Qualcomm_685.13804.40.0_W11ARM64_(Qualcomm Base Driver)/longcheer/qcsubsys_ext_adsp8480/adsps.jsn' "$fw"/'qcom/glymur/ACER/SFSP14-Q51T/adsps.jsn'
  install -Dm644 'acer-sfsp14-q51t-qualcomm-base-driver-685.13804.40.0/Base Driver_Qualcomm_685.13804.40.0_W11ARM64_(Qualcomm Base Driver)/longcheer/qcsubsys_ext_adsp8480/adspua.jsn' "$fw"/'qcom/glymur/ACER/SFSP14-Q51T/adspua.jsn'
  install -Dm644 'acer-sfsp14-q51t-qualcomm-base-driver-685.13804.40.0/Base Driver_Qualcomm_685.13804.40.0_W11ARM64_(Qualcomm Base Driver)/QC/qcnspmcdm8480/cdsp_dtbs.elf' "$fw"/'qcom/glymur/ACER/SFSP14-Q51T/cdsp_dtbs.elf'
  install -Dm644 'acer-sfsp14-q51t-qualcomm-base-driver-685.13804.40.0/Base Driver_Qualcomm_685.13804.40.0_W11ARM64_(Qualcomm Base Driver)/longcheer/qcsubsys_ext_adsp8480/qcadsp8480.mbn' "$fw"/'qcom/glymur/ACER/SFSP14-Q51T/qcadsp8480.mbn'
  install -Dm644 'acer-sfsp14-q51t-qualcomm-base-driver-685.13804.40.0/Base Driver_Qualcomm_685.13804.40.0_W11ARM64_(Qualcomm Base Driver)/QC/qcnspmcdm8480/qccdsp8480.mbn' "$fw"/'qcom/glymur/ACER/SFSP14-Q51T/qccdsp8480.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
9fbeaada8541c03ce5cbe78079d9cc6f4f2ea4b8280d84d154dbec111277b70e  qcom/glymur/ACER/SFSP14-Q51T/adsp_dtbs.elf
66ce8531efb7979d234e0f0eabbe18d038ac97da771a8a194f613df8f0724e81  qcom/glymur/ACER/SFSP14-Q51T/adspr.jsn
12ac2f3ae8ced12aa4b06b3ab3a01bc4d8efe1c92ebea503c002f209a6ec176f  qcom/glymur/ACER/SFSP14-Q51T/adsps.jsn
982a99853495e34726b8e44697fdfad303334de0a67cbf6cde306c8f1731000b  qcom/glymur/ACER/SFSP14-Q51T/adspua.jsn
9bee104a48d4aac647287d6c1454df170c1cff7158a2352711fd1e2163ea6d1d  qcom/glymur/ACER/SFSP14-Q51T/cdsp_dtbs.elf
5b61be789919d3d0486e99f342063708974065f6f6312ca4aebe638e55547f5d  qcom/glymur/ACER/SFSP14-Q51T/qcadsp8480.mbn
acf13d29288d283793f418a36650e8a261eed927d30de109a59cb2210f458794  qcom/glymur/ACER/SFSP14-Q51T/qccdsp8480.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
