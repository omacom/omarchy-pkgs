# Maintainer: Omarchy <https://omarchy.org>
# Based on Noa Himesaka's arch-mact2-PKGBUILDs recipe.
pkgname=t2fanrd
pkgver=r16.48baf96
pkgrel=1.1
_commit=48baf962697ec3d4d969c74cf601ee8e15b7aeaa
_srcname=T2FanRD-$_commit
pkgdesc='Fan control daemon for Intel T2 Macs'
url='https://github.com/GnomedDev/t2fanrd'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('glibc' 'libgcc' 'systemd')
makedepends=('cargo')
conflicts=('t2fand')
replaces=('t2fand')
backup=('etc/t2fand.conf')
options=('!debug' '!lto')
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
        't2fanrd.service'
        't2fand.conf')
sha256sums=('33cd1644bd7602587b0d486a4396de6bdaae3d704d91e1e762604980beaa6e84'
            'fe53204414f6e9427b341a29310162b47cb8a16b9b425bb1285650897f263cec'
            '4d1d4eabe0bd44b0f0b4ab095f96af256e9a7f844b9c76965f5d80f086ea9eea')

prepare() {
  cd "$_srcname"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$_srcname"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --all-features
}

package() {
  install -Dm755 "$_srcname/target/release/t2fanrd" "$pkgdir/usr/bin/t2fanrd"
  install -Dm644 t2fanrd.service "$pkgdir/usr/lib/systemd/system/t2fanrd.service"
  install -Dm644 t2fand.conf "$pkgdir/etc/t2fand.conf"
  install -Dm644 "$_srcname/LICENCE" "$pkgdir/usr/share/licenses/$pkgname/LICENCE"
  install -Dm644 "$_srcname/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
