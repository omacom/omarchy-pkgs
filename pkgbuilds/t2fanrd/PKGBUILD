# Maintainer: The Omarchy Authors

pkgname=t2fanrd
_commit=48baf962697ec3d4d969c74cf601ee8e15b7aeaa
pkgver=r16.48baf96
pkgrel=3
pkgdesc='Fan control daemon for Macs with the Apple T2 chip'
url='https://github.com/GnomedDev/t2fanrd'
arch=(x86_64)
license=(GPL-3.0-only)
depends=(gcc-libs glibc)
makedepends=(cargo git)
conflicts=(t2fand)
replaces=(t2fand)
# Upstream is archived. 0001 is its unmerged PR #19, which finds the GPU
# sensor on any DRM card instead of only card0 (the Radeon is card2 on a
# MacBookPro16,1). 0002 looks for a lost GPU sensor again, follows the
# hotter of amdgpu's edge and junction, and clears the read buffer.
source=("t2fanrd::git+https://github.com/GnomedDev/t2fanrd.git#commit=$_commit"
        t2fanrd.service
        0001-pr19-gpu-sensor-any-card.patch
        0002-rescan-gpu-junction-clean-buffer.patch)
sha256sums=('SKIP'
            '4d63a9c04f57d933875acf809b99fbd048970af8dcd5b17260624f7b414f7e03'
            '34eae3f5b53c7444d160e1b7b98ce544faadabc3a8a2feb673491b0ad6eca7a4'
            'e43f393d2a488ed3aa066735bc371a11fef65c1c2ae434afae30e4fd25beb458')

prepare() {
  cd t2fanrd
  patch -Np1 -i ../0001-pr19-gpu-sensor-any-card.patch
  patch -Np1 -i ../0002-rescan-gpu-junction-clean-buffer.patch
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd t2fanrd
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --all-features
}

package() {
  install -Dm755 t2fanrd/target/release/t2fanrd "$pkgdir/usr/bin/t2fanrd"
  install -Dm644 t2fanrd.service "$pkgdir/usr/lib/systemd/system/t2fanrd.service"
  install -Dm644 t2fanrd/LICENCE "$pkgdir/usr/share/licenses/$pkgname/LICENCE"
}
