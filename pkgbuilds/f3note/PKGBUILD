# Maintainer: Luiz Felipe - F360c4 <https://github.com/f360c4>
pkgname=f3note
pkgver=1.0.2
pkgrel=1
pkgdesc="A fast, minimal tabbed text editor for Wayland"
arch=('x86_64' 'aarch64')
url="https://github.com/f360c4/f3note"
license=('MIT')
depends=('gtk4' 'gtksourceview5')
makedepends=('cargo')

# Arch turns LTO on for every package (OPTIONS=(... lto) in makepkg.conf), and
# it breaks this one. zstd-sys compiles the bundled C zstd with the CFLAGS
# makepkg exports, so -flto=auto makes those objects LTO bitcode; the Rust
# link step is not using the LTO plugin, so every ZSTD_* symbol comes out
# undefined and the build dies at the very end. Found by building the package
# rather than by reading about it.
options=(!lto)

# An uploaded release asset, not GitHub's generated /archive/<ref>.tar.gz.
# Those are built on demand and GitHub has never promised them to be
# byte-identical over time — the January 2023 change to their tar output broke
# checksums across Homebrew, the AUR and Nix at once. A stored asset cannot
# change under you.
#
# The asset is `git archive` of one commit gzipped with `-n`, so it is
# reproducible rather than something to take on trust; the commit it was made
# from is recorded in packaging/PKGBUILD upstream.
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('6403b28fe5af9bad61d90b8f8bd4f8b5dc40deecc135cd3617f8fbc359a864a1')

prepare() {
  cd "$pkgname-$pkgver"
  # Build offline from the committed lock file: reproducible, and it works on
  # a machine with no network once the source is fetched.
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --bin f3note
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # Only the tests that need no display. The window and recovery tests are
  # separate binaries and need a compositor, so they run in CI instead.
  cargo test --frozen --release --lib
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "packaging/io.github.f360c4.$pkgname.desktop" \
    "$pkgdir/usr/share/applications/io.github.f360c4.$pkgname.desktop"
  install -Dm644 "packaging/$pkgname.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.f360c4.$pkgname.svg"
  # The same AppStream metadata Flathub gets, so a software centre on Arch
  # describes the package instead of showing a bare name.
  install -Dm644 "packaging/flatpak/io.github.f360c4.$pkgname.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/io.github.f360c4.$pkgname.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/MANUAL.md "$pkgdir/usr/share/doc/$pkgname/MANUAL.md"
}
