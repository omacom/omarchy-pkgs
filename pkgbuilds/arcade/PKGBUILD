# Maintainer: Tom Ballard <https://github.com/tcballard>
pkgname=arcade
pkgver=0.4.0
pkgrel=1
pkgdesc='Fourteen classic games in one native Omarchy app, including FreeSki'
arch=('x86_64')
url='https://github.com/tcballard/omarchy-retro-arcade'
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11'
         'libglvnd' 'wayland' 'xdg-desktop-portal' 'libpulse'
         'sdl2' 'sdl2_image' 'sdl2_mixer')
optdepends=('xdg-desktop-portal-gtk: file chooser fallback')
provides=("omarchy-retro-arcade=$pkgver")
conflicts=('omarchy-retro-arcade' 'omarchy-chess' 'omarchy-solitaire'
           'omarchy-scram' 'omarchy-munch' 'omarchy-invaders' 'omarchy-spacecadet')
# Keep the tested upstream binaries byte-identical; debug symbols are separate.
options=('!strip' '!debug')
# Rewrap the verified upstream player package, following schist-bin's pattern.
# Matching GPL source (including Stockfish and its NNUE) is on the same release:
# omarchy-retro-arcade-${pkgver}-corresponding-source.tar.gz
source_x86_64=("$url/releases/download/v$pkgver/omarchy-retro-arcade-$pkgver-1-x86_64.pkg.tar.zst")
sha256sums_x86_64=('33fba0ba9da1edf9a81f9989cba6811ddbfc5f0f99ce73d3a2f8e340bf12323a')

package() {
  # Only the installed payload: upstream .PKGINFO/.BUILDINFO/.MTREE stay behind.
  cp -a "$srcdir/usr" "$pkgdir/"
  mv "$pkgdir/usr/share/licenses/omarchy-retro-arcade" \
     "$pkgdir/usr/share/licenses/$pkgname"
  # Retain the desktop entry, executable and save identities for existing users.
  ln -s omarchy-retro-arcade "$pkgdir/usr/bin/arcade"
}
