# Maintainer: CalmaSaCow <calmasacow@gmail.com>
pkgname=wavesink-bin
pkgver=1.1.2
pkgrel=1
pkgdesc="Per-app audio routing and independent mixes for PipeWire"
arch=('x86_64')
url="https://github.com/calmasacow/WaveSink"
license=('GPL-3.0-only')
# Direct library deps plus the tray library: libayatana-appindicator is
# dlopen'd, but the app aborts on startup without it, so it's a hard dep.
depends=('glibc' 'libgcc' 'glib2' 'gtk3' 'gdk-pixbuf2' 'cairo' 'dbus'
         'webkit2gtk-4.1' 'libsoup3' 'libpipewire' 'pipewire-pulse'
         'wireplumber' 'hicolor-icon-theme' 'libayatana-appindicator')
provides=('wavesink')
# sink-bin is the pre-rebrand name; it only ever existed as a local build.
conflicts=('wavesink' 'sink-bin')
replaces=('sink-bin')
options=('!strip' '!debug')
source=("https://github.com/calmasacow/WaveSink/releases/download/v${pkgver}/${pkgname}-${pkgver}-1-x86_64.pkg.tar.zst"
        "https://raw.githubusercontent.com/calmasacow/WaveSink/v${pkgver}/LICENSE")
sha256sums=('42dfd6b765d4160161550e07db0f9eaeeb027a433d3db614d9890bc579ef1e34'
            '3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986')

package() {
  # The upstream release artifact is already an Arch package in the FHS
  # layout; makepkg has unpacked it, so take its payload as-is.
  cp -a "$srcdir/usr" "$pkgdir/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
