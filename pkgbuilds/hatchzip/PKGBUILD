# Maintainer: Daniella Anokwu <anokwudaniella@gmail.com>

pkgname=hatchzip
pkgver=0.1.2
pkgrel=1
pkgdesc="Extract huge archives in place, freeing the archive as it goes (CLI + desktop app)"
arch=(x86_64 aarch64)
url="https://github.com/xevrion/hatchzip"
license=('MIT OR Apache-2.0')
depends=(
  fontconfig
  gcc-libs
  glibc
  # loaded at runtime by the Slint/winit window
  libglvnd
  libxkbcommon
  wayland
)
makedepends=(cargo)
optdepends=(
  'xdg-desktop-portal-impl: open/save dialogs in the desktop app'
  'libxkbcommon-x11: desktop app on X11'
  'libxcursor: desktop app on X11'
  'libxi: desktop app on X11'
  'libxrandr: desktop app on X11'
)
options=(!lto)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('6872f90c06bf4ec0f0c8342728412f20812803452186c88883f972a878581be1')

prepare() {
  cd $pkgname-$pkgver
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $pkgname-$pkgver
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p hatchzip -p hatchzip-gui

  local bin=target/release/hatchzip
  $bin man > hatchzip.1
  $bin completions bash > hatchzip.bash
  $bin completions zsh > _hatchzip
  $bin completions fish > hatchzip.fish
}

check() {
  cd $pkgname-$pkgver
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # not --release: the crash-and-resume tests rely on HATCHZIP_CRASH_AT,
  # which only debug builds honour
  cargo test --frozen -p hatchzip-core -p hatchzip
}

package() {
  cd $pkgname-$pkgver

  install -vDm 755 target/release/hatchzip target/release/hatchzip-gui -t "$pkgdir/usr/bin/"
  ln -vs hatchzip "$pkgdir/usr/bin/hz"

  install -vDm 644 hatchzip.1 -t "$pkgdir/usr/share/man/man1/"
  # makepkg gzips the page and repoints this link
  ln -vs hatchzip.1 "$pkgdir/usr/share/man/man1/hz.1"
  install -vDm 644 hatchzip.bash "$pkgdir/usr/share/bash-completion/completions/hatchzip"
  install -vDm 644 _hatchzip -t "$pkgdir/usr/share/zsh/site-functions/"
  install -vDm 644 hatchzip.fish -t "$pkgdir/usr/share/fish/vendor_completions.d/"

  install -vDm 644 packaging/linux/io.github.xevrion.hatchzip.desktop -t "$pkgdir/usr/share/applications/"
  install -vDm 644 packaging/linux/io.github.xevrion.hatchzip.metainfo.xml -t "$pkgdir/usr/share/metainfo/"
  cp -vr --no-preserve=mode packaging/linux/icons "$pkgdir/usr/share/"

  install -vDm 644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
