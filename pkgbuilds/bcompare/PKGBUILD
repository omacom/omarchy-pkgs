pkgbase=bcompare
pkgname=('bcompare' 'bcompare-kde6' 'bcompare-nautilus' 'bcompare-thunar' 'bcompare-cinnamon' 'bcompare-mate')
pkgver=5.2.8.33052
pkgrel=1
pkgdesc='Beyond Compare 5: compare, sync, and merge files and folders'
arch=('x86_64')
url='https://www.scootersoftware.com'
license=('custom')
depends=('qt6-base')
source=("https://www.scootersoftware.com/files/${pkgbase}-${pkgver}.x86_64.tar.gz")
sha256sums=('dc1af3f9f731159d4458014a7af087d830baa167064cc0ea7245ce6576986bdb')
# The vendor binaries are already stripped; stripping them breaks them.
options=('!strip' '!debug')

# The AUR recipe runs the archive's install.sh into a staging prefix. That is
# not done here: under makepkg's fakeroot the script's `file BCompare` dies
# with SIGSYS (file's own seccomp sandbox blocks the semtimedop libfakeroot
# interposes), and its `cp -r` copies the archive's owners into $pkgdir, which
# the owner check refuses. Installing the same files explicitly keeps every
# path root-owned.
_bclib=usr/lib/beyondcompare
_bcdoc=usr/share/doc/bcompare

package_bcompare() {
  pkgdesc='Beyond Compare 5: compare, sync, and merge files and folders'
  depends=('bzip2' 'dbus' 'gcc-libs' 'glibc' 'libx11' 'libxcb' 'qt6-base' 'systemd-libs' 'zlib')
  optdepends=('bcompare-kde6: KDE Plasma 6 service menus'
              'bcompare-nautilus: Nautilus service menus'
              'bcompare-thunar: Thunar service menus'
              'bcompare-cinnamon: Nemo service menus'
              'bcompare-mate: Caja service menus')
  install=bcompare.install

  cd "$pkgbase-$pkgver"
  local lib="$pkgdir/$_bclib" doc="$pkgdir/$_bcdoc"

  # bcompare.sh is the launcher install.sh rewrites with BC_LIB and
  # BC_PACKAGE_TYPE; fill in the same values without running the script.
  sed -e 's|^BC_LIB=.*|BC_LIB=/usr/lib/beyondcompare|' \
      -e 's|^BC_PACKAGE_TYPE=.*|BC_PACKAGE_TYPE=archive|' \
    bcompare.sh | install -Dm755 /dev/stdin "$pkgdir/usr/bin/bcompare"

  install -d "$lib" "$doc"
  install -m755 BCompare bcmount.sh "$lib/"
  install -m644 libQt6Pas.so.6 lib7z.so libcloudstorage.so.22.0 libunrar.so \
    bcompare.conf.sample BCompare.mad mime.types "$lib/"
  install -m644 -t "$doc/" README copyright
  find help -type f -exec install -Dm644 '{}' "$doc/{}" \;

  install -Dm644 bcompare.desktop "$pkgdir/usr/share/applications/bcompare.desktop"
  install -Dm644 bcompare.xml "$pkgdir/usr/share/mime/packages/bcompare.xml"
  install -Dm644 bcompare.png "$pkgdir/usr/share/pixmaps/bcompare.png"
  install -Dm644 bcomparefull32.png "$pkgdir/usr/share/pixmaps/bcomparefull32.png"
  install -Dm644 bcomparehalf32.png "$pkgdir/usr/share/pixmaps/bcomparehalf32.png"
  install -Dm644 copyright "$pkgdir/usr/share/licenses/bcompare/LICENSE"
}

package_bcompare-kde6() {
  pkgdesc='KDE Plasma 6 service menus for Beyond Compare'
  depends=('bcompare')
  cd "$pkgbase-$pkgver"
  install -Dm755 ext/bcompare_ext_kde6.amd64.so \
    "$pkgdir/usr/lib/qt6/plugins/kf6/kfileitemaction/bcompare_ext_kde6.so"
}

package_bcompare-nautilus() {
  pkgdesc='Nautilus service menus for Beyond Compare'
  depends=('bcompare')
  provides=('bcompare-gnome')
  cd "$pkgbase-$pkgver"
  install -Dm755 ext/bcompare-ext-nautilus.amd64.so.ext4 \
    "$pkgdir/usr/lib/nautilus/extensions-4/bcompare-ext-nautilus.so"
}

package_bcompare-thunar() {
  pkgdesc='Thunar service menus for Beyond Compare'
  depends=('bcompare')
  provides=('bcompare-xfce')
  cd "$pkgbase-$pkgver"
  install -Dm755 ext/bcompare-ext-thunarx-3.amd64.so \
    "$pkgdir/usr/lib/thunarx-3/bcompare-ext-thunarx.so"
}

package_bcompare-cinnamon() {
  pkgdesc='Nemo service menus for Beyond Compare'
  depends=('bcompare')
  cd "$pkgbase-$pkgver"
  install -Dm755 ext/bcompare-ext-nemo.amd64.so \
    "$pkgdir/usr/lib/nemo/extensions-3.0/bcompare-ext-nemo.so"
}

package_bcompare-mate() {
  pkgdesc='Caja service menus for Beyond Compare'
  depends=('bcompare')
  cd "$pkgbase-$pkgver"
  install -Dm755 ext/bcompare-ext-caja.amd64.so \
    "$pkgdir/usr/lib/caja/extensions-3.0/bcompare-ext-caja.so"
}
