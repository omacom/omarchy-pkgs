# Maintainer: The Omarchy Authors
pkgname=kimi-code
pkgver=2.8.1
pkgrel=1
pkgdesc="Kimi Code CLI, Moonshot AI's terminal coding agent"
arch=('x86_64' 'aarch64')
url="https://github.com/MoonshotAI/kimi-code"
license=('MIT')
depends=('glibc' 'gcc-libs')
# The binary is a Node single executable with its JavaScript appended;
# stripping breaks it.
options=('!strip' '!debug')
_release="https://github.com/MoonshotAI/kimi-code/releases/download/%40moonshot-ai%2Fkimi-code%40${pkgver}"
source=('LICENSE')
source_x86_64=("kimi-code-${pkgver}-x86_64.tar.gz::${_release}/kimi-code-linux-x64.tar.gz")
source_aarch64=("kimi-code-${pkgver}-aarch64.tar.gz::${_release}/kimi-code-linux-arm64.tar.gz")
sha256sums=('23cc68e17992e0b512ae2e80afc5787d7d8e0fbfbdb4fff54ec0245508fa400e')
sha256sums_x86_64=('5d6fc22fc49b4c4a1cfc8d61e3fe7ae64a247636dea73796029840e1cbb7efdb')
sha256sums_aarch64=('1951e624991a9497405f4a49de84b039ce13c83cfbc28d64ebf7df8d92fff7cc')
noextract=("kimi-code-${pkgver}-${CARCH}.tar.gz")

package() {
  install -dm755 "${pkgdir}/usr/lib/kimi-code" "${pkgdir}/usr/bin"
  bsdtar --no-same-owner -xf "kimi-code-${pkgver}-${CARCH}.tar.gz" -C "${pkgdir}/usr/lib/kimi-code" kimi
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # pacman updates this install, so Kimi's own update check and background
  # installer would only fight it.
  cat >"${pkgdir}/usr/bin/kimi" <<'WRAPPER'
#!/bin/sh
export KIMI_CODE_NO_AUTO_UPDATE=true
exec /usr/lib/kimi-code/kimi "$@"
WRAPPER
  chmod 755 "${pkgdir}/usr/bin/kimi"
}
