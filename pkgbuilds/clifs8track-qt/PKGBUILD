# Maintainer: Jaycee Appi <appi.jaycee@gmail.com>
#
# Clif's 8track — a free and open-source 8-track recorder, ported to native
# Qt6/QML. The audio engine is a compiled C++ QML module (Clifs8track) built
# with moc + g++; the UI is QML assembled by scripts/build.sh.
pkgname=clifs8track-qt
pkgver=0.1.0
pkgrel=1
pkgdesc="Clif's 8track — an 8-track recorder (Qt6/QML)"
arch=('x86_64')
url="https://github.com/alchemicAV/Clifs-8track"
license=('MIT')
depends=('qt6-declarative' 'qt6-multimedia' 'hicolor-icon-theme')
makedepends=('qt6-base' 'pkgconf')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('7751ccba48d759e2b4a3d9155dc70f64171dd3ded42fb05a930adef763e2bcf9')
options=('!debug')

build() {
  cd "Clifs-8track-${pkgver}"
  bash scripts/build.sh
}

package() {
  cd "Clifs-8track-${pkgver}"

  # C++ QML audio module
  install -Dm755 build/Clifs8track/libclifs8track.so \
    "$pkgdir/usr/lib/qt6/qml/Clifs8track/libclifs8track.so"
  install -Dm644 build/Clifs8track/qmldir \
    "$pkgdir/usr/lib/qt6/qml/Clifs8track/qmldir"

  # QML app + assets
  install -dm755 "$pkgdir/usr/share/clifs8track-qt"
  cp -r build/app/* "$pkgdir/usr/share/clifs8track-qt/"

  # Launcher
  install -Dm755 packaging/clifs8track-qt "$pkgdir/usr/bin/clifs8track-qt"

  # Desktop entry + icons
  install -Dm644 packaging/clifs8track-qt.desktop \
    "$pkgdir/usr/share/applications/clifs8track-qt.desktop"
  for s in 16 24 32 48 64 128 256 512; do
    install -Dm644 "packaging/icons/hicolor/${s}x${s}/apps/clifs8track-qt.png" \
      "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/clifs8track-qt.png"
  done

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
