+{
+	unsigned long mclk_freq = priv->codec_priv[0].mclk_freq;
+
+	/*
+	 * Set CPU sysclk frequency from codec MCLK only if not already
+	 * set by the CPU DAI init (e.g. ESAI extal clock takes precedence).
