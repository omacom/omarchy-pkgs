From 2f66d3cbbc418e0fe706f8d0de0e902a88bfc0ba Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Sun, 8 Nov 2026 12:00:00 +0100
Subject: [PATCH 1/2] dt-bindings: Add the ASUS Vivobook S14 (S3407QA) and its
 panel

The ASUS Vivobook S 14 S3407QA is a laptop on the Snapdragon X
X1-26-100 (Purwa). Add its compatible to the X1P42100 boards, and its
Samsung ATNA40KW01 OLED panel to the ATNA33XC20 family it falls back to.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 Documentation/devicetree/bindings/arm/qcom.yaml                  | 1 +
 .../devicetree/bindings/display/panel/samsung,atna33xc20.yaml    | 1 +
 2 files changed, 2 insertions(+)

diff --git a/Documentation/devicetree/bindings/arm/qcom.yaml b/Documentation/devicetree/bindings/arm/qcom.yaml
index 6ddea49..ac984e4 100644
--- a/Documentation/devicetree/bindings/arm/qcom.yaml
+++ b/Documentation/devicetree/bindings/arm/qcom.yaml
@@ -1301,6 +1301,7 @@ properties:
               - acer,aspire-a14-11m
               - acer,aspire-a16-11m
               - asus,proart-pz13-ht5306qa
+              - asus,vivobook-s14-s3407qa
               - asus,vivobook-s15-x1p4
               - asus,zenbook-14-ux3480qa
               - hp,elitebook-6-g1q
diff --git a/Documentation/devicetree/bindings/display/panel/samsung,atna33xc20.yaml b/Documentation/devicetree/bindings/display/panel/samsung,atna33xc20.yaml
index 50d3616..49b1809 100644
--- a/Documentation/devicetree/bindings/display/panel/samsung,atna33xc20.yaml
+++ b/Documentation/devicetree/bindings/display/panel/samsung,atna33xc20.yaml
@@ -30,6 +30,7 @@ properties:
               # Samsung 14" WQXGA+ (2880x1800 pixels) eDP AMOLED panel
               - samsung,atna40hq08
               # Samsung 14" FHD+ (1920x1200 pixels) eDP AMOLED panel
+              - samsung,atna40kw01
               - samsung,atna40kw02
               # Samsung 14" WQXGA+ (2880×1800 pixels) eDP AMOLED panel
               - samsung,atna40yk20
-- 
