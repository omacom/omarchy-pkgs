--- 1a/drivers/hid/hid-magicmouse.c
+++ 2b/drivers/hid/hid-magicmouse.c
@@ -390,6 +390,14 @@ static int __magicmouse_raw_event(struct hid_device *hdev,
 	struct input_dev *input = msc->input;
 	int x = 0, y = 0, ii, clicks = 0, npoints;
 
