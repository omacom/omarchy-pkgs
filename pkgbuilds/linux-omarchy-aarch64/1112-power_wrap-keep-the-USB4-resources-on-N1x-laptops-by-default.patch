From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Hughes <ryan@heyoodle.com>
Date: Mon, 26 Oct 2026 22:11:06 -0400
Subject: [PATCH] soc: mediatek: power_wrap: keep the USB4 resources on N1x
 laptops by default

NVIDIA's power_wrap releases the USB4 host routers' SSPM resources once
xHCI is up, which suits systems that leave USB4 unused. On the N1x
laptops thunderbolt_platform drives those routers, and after the
release it refuses to bind, so every install has had to boot with
power_wrap_drv.usb4_release=0, and the installer, which does not, had
no USB4 docks.

Keep the resources by default when the USB4 platform driver is built
and the machine is an N1x laptop, told apart from the GB10 desktops,
which report the same platform id, by its MediaTek I2C controllers
(NVDA0200). usb4_release given on the command line still wins.
---
 drivers/soc/mediatek/power_wrap/power_wrap.c | 29 ++++++++++++++++++--
 1 file changed, 26 insertions(+), 3 deletions(-)

diff --git a/drivers/soc/mediatek/power_wrap/power_wrap.c b/drivers/soc/mediatek/power_wrap/power_wrap.c
index e17b20640..d9fdef87f 100644
--- a/drivers/soc/mediatek/power_wrap/power_wrap.c
+++ b/drivers/soc/mediatek/power_wrap/power_wrap.c
@@ -131,12 +131,26 @@ static bool pwrap_usb4_armed;
 
 /*
  * The release suits systems that leave USB4 unused. A system running a USB4
- * connection manager needs the host routers kept, so it can turn this off.
+ * connection manager needs the host routers kept: the N1x laptops, where
+ * thunderbolt_platform drives them, keep them unless told otherwise.
  */
 static bool usb4_release = true;
-module_param(usb4_release, bool, 0444);
+static bool usb4_release_set;
+
+static int usb4_release_param_set(const char *val,
+				  const struct kernel_param *kp)
+{
+	usb4_release_set = true;
+	return param_set_bool(val, kp);
+}
+
+static const struct kernel_param_ops usb4_release_ops = {
+	.set = usb4_release_param_set,
+	.get = param_get_bool,
+};
+module_param_cb(usb4_release, &usb4_release_ops, &usb4_release, 0444);
 MODULE_PARM_DESC(usb4_release,
-		 "Release the USB4 resources left powered by the bootloader once xHCI has bound (default: true)");
+		 "Release the USB4 resources left powered by the bootloader once xHCI has bound (default: false on N1x laptops, true elsewhere)");
 static struct notifier_block pwrap_usb4_nb;
 
 /* Controllers found unbound by the collection pass, before commit. */
@@ -818,6 +832,15 @@ static void pwrap_usb4_arm_release(struct device *dev)
 	unsigned int i;
 	int ret;
 
+	/*
+	 * The N1x laptops' I2C controllers (NVDA0200) set them apart from the
+	 * GB10 desktops, which report the same platform id.
+	 */
+	if (!usb4_release_set &&
+	    IS_ENABLED(CONFIG_USB4_PLATFORM_NHI) &&
+	    acpi_dev_present("NVDA0200", NULL, -1))
+		usb4_release = false;
+
 	if (!usb4_release) {
 		dev_info(dev, "USB4: release disabled, keeping usb4 resources\n");
 		return;
