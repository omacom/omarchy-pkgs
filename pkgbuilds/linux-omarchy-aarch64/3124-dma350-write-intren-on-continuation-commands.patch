From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Clay Stan <claystan97@gmail.com>
Date: Thu, 26 Nov 2026 00:18:32 -0500
Subject: [PATCH] dmaengine: arm-dma350: write LINK_INTREN in continuation
 slave commands

d350_prep_slave_sg() sets enable_irq = false on all entries before the
last and enable_irq = true only on the final scatter-gather entry.
However, d350_build_slave_command() only included LINK_INTREN in the
first command, leaving CH_INTREN cleared for every continuation entry
so multi-entry scatter-gather transfers never raised a completion IRQ.

Include LINK_INTREN in continuation commands as well and keep
CH_INTREN_ERR enabled on intermediate entries so error interrupts and
final-entry completion interrupts both fire reliably.

Signed-off-by: Clay Stan <claystan97@gmail.com>
---
 drivers/dma/arm-dma350.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/dma/arm-dma350.c b/drivers/dma/arm-dma350.c
index 1cd72c1..17ea891 100644
--- a/drivers/dma/arm-dma350.c
+++ b/drivers/dma/arm-dma350.c
@@ -461,7 +461,7 @@ static void d350_build_slave_command(struct d350 *dmac, struct d350_chan *dch,
 		/* Write full command - fields in order of LINK_* bit positions */
 		idx = 0;
 		cmd[idx++] = header;
-		cmd[idx++] = enable_irq ? (CH_INTREN_DONE | CH_INTREN_ERR) : 0;
+		cmd[idx++] = enable_irq ? (CH_INTREN_DONE | CH_INTREN_ERR) : CH_INTREN_ERR;
 		cmd[idx++] = ctrl;
 		cmd[idx++] = lower_32_bits(src_addr);
 		cmd[idx++] = upper_32_bits(src_addr);
@@ -485,7 +485,8 @@ static void d350_build_slave_command(struct d350 *dmac, struct d350_chan *dch,
 		 * Minimal continuation command - only addresses, size, and link.
 		 * All other configuration inherited from first command.
 		 */
-		header = LINK_SRCADDR | LINK_SRCADDRHI |
+		header = LINK_INTREN |
+			 LINK_SRCADDR | LINK_SRCADDRHI |
 			 LINK_DESADDR | LINK_DESADDRHI |
 			 LINK_XSIZE | LINK_XSIZEHI |
 			 LINK_LINKADDR | LINK_LINKADDRHI;
@@ -493,6 +494,7 @@ static void d350_build_slave_command(struct d350 *dmac, struct d350_chan *dch,
 		/* Write minimal command - packed format */
 		idx = 0;
 		cmd[idx++] = header;
+		cmd[idx++] = enable_irq ? (CH_INTREN_DONE | CH_INTREN_ERR) : CH_INTREN_ERR;
 		cmd[idx++] = lower_32_bits(src_addr);
 		cmd[idx++] = upper_32_bits(src_addr);
 		cmd[idx++] = lower_32_bits(dst_addr);
-- 
