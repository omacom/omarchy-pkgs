From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Thu, 5 Nov 2026 08:52:50 +0000
Subject: [PATCH] dt-bindings: arm: qcom: Add the ASUS Vivobook S16 (S3607QA)

The ASUS Vivobook S 16 S3607QA is built on the Snapdragon X X1-26-100
and sold with an OLED or an LCD panel. Add a compatible for each, with
a shared one for the board, as the Zenbook A14 has.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 Documentation/devicetree/bindings/arm/qcom.yaml | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/Documentation/devicetree/bindings/arm/qcom.yaml b/Documentation/devicetree/bindings/arm/qcom.yaml
index 7891803..af9eeef 100644
--- a/Documentation/devicetree/bindings/arm/qcom.yaml
+++ b/Documentation/devicetree/bindings/arm/qcom.yaml
@@ -1266,6 +1266,13 @@ properties:
           - const: asus,zenbook-a14-ux3407qa
           - const: qcom,x1p42100
 
+      - items:
+          - enum:
+              - asus,vivobook-s16-s3607qa-lcd
+              - asus,vivobook-s16-s3607qa-oled
+          - const: asus,vivobook-s16-s3607qa
+          - const: qcom,x1p42100
+
       - items:
           - enum:
               - lenovo,ideapad-slim5x-lcd
-- 
2.56.0

