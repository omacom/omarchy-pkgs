From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Hughes <ryan@heyoodle.com>
Date: Mon, 26 Oct 2026 22:07:11 -0400
Subject: [PATCH] ACPI: OSI: apply the DMI quirks outside x86, hide Windows
 2022 from N1x laptops

The ASUS ProArt P16 H7607BA, the ASUS ProArt P14 H7407BA from BIOS 303
and the Lenovo Pro 9 15N1X11 (NVIDIA N1x) hide \_SB.SSPM (NVDA8400)
when _OSI("Windows 2022") is true: its _STA and those of the devices it
powers return 0. Without the SSPM the I2C controllers behind the
keyboard, touchpad and touchscreen never power on, so none of these
laptops has a keyboard, in the installer or at the LUKS prompt.

The DMI table that adjusts _OSI per machine is only checked on x86,
from early_acpi_osi_init(). Check it from acpi_osi_init() elsewhere,
unless acpi_osi= was given: there the command line has already been
parsed, and it should still win as it does on x86.

Drop Windows 2022 on the Lenovo, as tested there with
acpi_osi="!Windows 2022". Drop every Windows string on the ProArt P16:
ASUS's \MSOS tries "Windows 2022" and then "Windows 2001", so without
the first it reports Windows XP and the EC sends the brightness and
volume hotkeys only to ASUS WMI. With none it falls back to Windows 8,
as tested there with acpi_osi=!. Do the same on the ProArt P14, whose
firmware is ASUS's too.
---
 drivers/acpi/osi.c | 64 ++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 64 insertions(+)

diff --git a/drivers/acpi/osi.c b/drivers/acpi/osi.c
index 9470f1830..6251fe36a 100644
--- a/drivers/acpi/osi.c
+++ b/drivers/acpi/osi.c
@@ -221,8 +221,11 @@ static void __init acpi_osi_setup_late(void)
 	}
 }
 
+static bool acpi_osi_cmdline __initdata;
+
 static int __init osi_setup(char *str)
 {
+	acpi_osi_cmdline = true;
 	if (str && !strcmp("Linux", str))
 		acpi_osi_setup_linux(true);
 	else if (str && !strcmp("!Linux", str))
@@ -292,6 +295,22 @@ static int __init dmi_disable_osi_win8(const struct dmi_system_id *d)
 	return 0;
 }
 
+static int __init dmi_disable_osi_win11_22h2(const struct dmi_system_id *d)
+{
+	pr_notice("DMI detected: %s\n", d->ident);
+	acpi_osi_setup("!Windows 2022");
+
+	return 0;
+}
+
+static int __init dmi_disable_osi_windows(const struct dmi_system_id *d)
+{
+	pr_notice("DMI detected: %s\n", d->ident);
+	acpi_osi_setup("!");
+
+	return 0;
+}
+
 /*
  * Linux default _OSI response behavior is determined by this DMI table.
  *
@@ -455,6 +474,43 @@ static const struct dmi_system_id acpi_osi_dmi_table[] __initconst = {
 		},
 	},
 
+	/*
+	 * NVIDIA N1x laptops whose firmware hides the SSPM (NVDA8400), and
+	 * every device it powers, from an OS that claims Windows 2022: the
+	 * I2C controllers behind the keyboard and touchpad never power on.
+	 */
+	{
+	.callback = dmi_disable_osi_win11_22h2,
+	.ident = "Lenovo Pro 9 15N1X11",
+	.matches = {
+		    DMI_MATCH(DMI_SYS_VENDOR, "LENOVO"),
+		    DMI_MATCH(DMI_PRODUCT_NAME, "83SS"),
+		},
+	},
+	/*
+	 * ASUS's \MSOS tries "Windows 2022" and then "Windows 2001", so
+	 * without the first it reports Windows XP, and the EC event handler
+	 * sends the brightness and volume hotkeys to ASUS WMI only. With no
+	 * Windows strings at all it falls back to Windows 8.
+	 */
+	{
+	.callback = dmi_disable_osi_windows,
+	.ident = "ASUS ProArt P16 H7607BA",
+	.matches = {
+		    DMI_MATCH(DMI_SYS_VENDOR, "ASUS"),
+		    DMI_MATCH(DMI_PRODUCT_NAME, "H7607BA"),
+		},
+	},
+	/* The ProArt P14 hides the SSPM the same way since BIOS 303. */
+	{
+	.callback = dmi_disable_osi_windows,
+	.ident = "ASUS ProArt P14 H7407BA",
+	.matches = {
+		    DMI_MATCH(DMI_SYS_VENDOR, "ASUS"),
+		    DMI_MATCH(DMI_PRODUCT_NAME, "H7407BA"),
+		},
+	},
+
 	/*
 	 * BIOS invocation of _OSI(Linux) is almost always a BIOS bug.
 	 * Linux ignores it, except for the machines enumerated below.
@@ -494,6 +550,14 @@ int __init early_acpi_osi_init(void)
 
 int __init acpi_osi_init(void)
 {
+	/*
+	 * x86 checks the DMI table from early_acpi_osi_init(), before the
+	 * command line is parsed, so acpi_osi= can override what it sets.
+	 * Elsewhere the command line has been parsed by now; let it win.
+	 */
+	if (!IS_ENABLED(CONFIG_X86) && !acpi_osi_cmdline)
+		acpi_osi_dmi_blacklisted();
+
 	acpi_install_interface_handler(acpi_osi_handler);
 	acpi_osi_setup_late();
 
