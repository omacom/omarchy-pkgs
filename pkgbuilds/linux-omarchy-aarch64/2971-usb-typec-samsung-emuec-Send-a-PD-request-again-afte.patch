From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Tue, 17 Nov 2026 13:02:54 +0000
Subject: [PATCH] usb: typec: samsung-emuec: Send a PD request again
 after the charger turns it down

The driver remembers a PD request once the controller accepts it into
its mailbox and suppresses the same request after that, until the
contract is sufficient, the charger detaches or the system resumes. If
the charger rejects the request or can't complete it, the port stays on
its old contract, and charging doesn't recover without unplugging.

When the same request comes up again with none in flight and no
sufficient contract, send it again, at most twice per attach.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 drivers/usb/typec/samsung-emuec.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/drivers/usb/typec/samsung-emuec.c b/drivers/usb/typec/samsung-emuec.c
index 81de81eda..ad68c46b3 100644
--- a/drivers/usb/typec/samsung-emuec.c
+++ b/drivers/usb/typec/samsung-emuec.c
@@ -70,6 +70,9 @@
 #define S2MM006_ENTER_USB_SUCCESS	(2 << 2)
 #define S2MM006_MAX_CHARGE_MV		20000
 
+/* PD requests sent again per attach after the charger turns one down. */
+#define SAMSUNG_EMUEC_REQUEST_RETRIES	2
+
 enum samsung_emuec_mode {
 	SAMSUNG_EMUEC_MODE_NONE,
 	SAMSUNG_EMUEC_MODE_CONSUMER,
@@ -110,6 +113,7 @@ struct samsung_emuec {
 	u8 dp_pin;
 	u32 requested_rdo;
 	u32 requested_pdo;
+	u8 request_retries;
 	struct notifier_block pm_nb;
 	bool quiesced;
 	bool wake_armed;
@@ -282,6 +286,7 @@ static void samsung_emuec_detach(struct samsung_emuec *pdic)
 	pdic->dp_pin = 0;
 	pdic->requested_rdo = 0;
 	pdic->requested_pdo = 0;
+	pdic->request_retries = 0;
 	pdic->usb_mode = USB_MODE_NONE;
 	pdic->attempted_mode = SAMSUNG_EMUEC_MODE_NONE;
 	pdic->voltage_uv = 0;
@@ -474,9 +479,24 @@ static void samsung_emuec_update_pd(struct samsung_emuec *pdic)
 		/* A later contract loss must be allowed to request this PDO again. */
 		pdic->requested_rdo = 0;
 		pdic->requested_pdo = 0;
+		pdic->request_retries = 0;
 		goto report;
 	}
 
+	/*
+	 * The same request with none in flight and no sufficient contract: the
+	 * charger turned it down or couldn't complete it. Let it go out again,
+	 * a few times per attach, instead of suppressing it until a detach.
+	 */
+	if (!(status & S2MM006_TX_REQUEST) &&
+	    pdic->requested_rdo == requested &&
+	    pdic->requested_pdo == pdos[selected - 1] &&
+	    pdic->request_retries < SAMSUNG_EMUEC_REQUEST_RETRIES) {
+		pdic->request_retries++;
+		pdic->requested_rdo = 0;
+		pdic->requested_pdo = 0;
+	}
+
 	/* Suppress duplicates, but re-evaluate changed source limits. */
 	if (pdic->requested_rdo != requested ||
 	    pdic->requested_pdo != pdos[selected - 1]) {
@@ -1225,6 +1245,7 @@ static int samsung_emuec_resume(struct device *dev)
 	scoped_guard(mutex, &pdic->lock) {
 		pdic->requested_rdo = 0;
 		pdic->requested_pdo = 0;
+		pdic->request_retries = 0;
 		pdic->attempted_mode = SAMSUNG_EMUEC_MODE_NONE;
 	}
 	enable_irq(pdic->client->irq);
