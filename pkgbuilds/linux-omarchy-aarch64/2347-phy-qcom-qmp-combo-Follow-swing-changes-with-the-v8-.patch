From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 8 Oct 2026 13:55:28 -0500
Subject: [PATCH] phy: qcom: qmp-combo: Follow swing changes with the v8 PCS
 drive level

The v8 DP PHY sets the drive level in two places: the TX lane block
(TX_DRV_LVL and TX_EMP_POST1_LVL) and the DP PHY PCS (LN0_DRV_LVL and
LN1_DRV_LVL). qmp_v8_configure_dp_clocks() programs the PCS level once,
at power-on, from the swing and pre-emphasis levels known at that time.
During link training the DP controller requests new levels through
phy_configure(), which only reaches qmp_combo_configure_dp_swing(). The
TX lane block follows the request while the PCS stays at its power-on
level, so training runs with a PCS drive level that no longer matches
the requested swing and pre-emphasis.

Look the PCS level up in the same per-rate table and program
LN0/LN1_DRV_LVL whenever the levels change on a powered DP PHY, and
reject a swing and pre-emphasis pair that the PCS table marks as
invalid. PHYs without PCS drive tables are unaffected.

Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/phy/qualcomm/phy-qcom-qmp-combo.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
index b7a980bb151..7d108353710 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
@@ -3584,8 +3584,10 @@ static int qmp_combo_configure_dp_swing(struct qmp_combo *qmp)
 {
 	const struct phy_configure_opts_dp *dp_opts = &qmp->dp_opts;
 	const struct qmp_phy_cfg *cfg = qmp->cfg;
+	const u8 (*ln_drv_lvl)[4][4];
 	unsigned int v_level = 0, p_level = 0;
 	u8 voltage_swing_cfg, pre_emphasis_cfg;
+	u8 ln_drv_lvl_cfg = 0;
 	int i;
 
 	for (i = 0; i < dp_opts->lanes; i++) {
@@ -3596,15 +3598,23 @@ static int qmp_combo_configure_dp_swing(struct qmp_combo *qmp)
 	if (dp_opts->link_rate <= 2700) {
 		voltage_swing_cfg = (*cfg->swing_hbr_rbr)[v_level][p_level];
 		pre_emphasis_cfg = (*cfg->pre_emphasis_hbr_rbr)[v_level][p_level];
+		ln_drv_lvl = cfg->ln_drv_lvl_hbr_rbr;
 	} else {
 		voltage_swing_cfg = (*cfg->swing_hbr3_hbr2)[v_level][p_level];
 		pre_emphasis_cfg = (*cfg->pre_emphasis_hbr3_hbr2)[v_level][p_level];
+		ln_drv_lvl = cfg->ln_drv_lvl_hbr3_hbr2;
 	}
 
 	/* TODO: Move check to config check */
 	if (voltage_swing_cfg == 0xFF && pre_emphasis_cfg == 0xFF)
 		return -EINVAL;
 
+	if (ln_drv_lvl) {
+		ln_drv_lvl_cfg = (*ln_drv_lvl)[v_level][p_level];
+		if (ln_drv_lvl_cfg == 0xff)
+			return -EINVAL;
+	}
+
 	/* Enable MUX to use Cursor values from these registers */
 	voltage_swing_cfg |= DP_PHY_TXn_TX_DRV_LVL_MUX_EN;
 	pre_emphasis_cfg |= DP_PHY_TXn_TX_EMP_POST1_LVL_MUX_EN;
@@ -3614,6 +3624,14 @@ static int qmp_combo_configure_dp_swing(struct qmp_combo *qmp)
 	writel(voltage_swing_cfg, qmp->dp_tx2 + cfg->regs[QPHY_TX_TX_DRV_LVL]);
 	writel(pre_emphasis_cfg, qmp->dp_tx2 + cfg->regs[QPHY_TX_TX_EMP_POST1_LVL]);
 
+	/* Initial PCS programming is done by configure_dp_clocks(). */
+	if (ln_drv_lvl && qmp->dp_powered_on) {
+		writel(ln_drv_lvl_cfg, qmp->dp_dp_phy + QSERDES_V8_DP_PHY_LN0_DRV_LVL);
+		writel(ln_drv_lvl_cfg, qmp->dp_dp_phy + QSERDES_V8_DP_PHY_LN1_DRV_LVL);
+		dev_dbg(qmp->dev, "DP PCS drive: rate=%u voltage=%u emphasis=%u level=%#x\n",
+			dp_opts->link_rate, v_level, p_level, ln_drv_lvl_cfg);
+	}
+
 	return 0;
 }
 
-- 
