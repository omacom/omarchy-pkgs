From c9709de4300a7eba1a763aa490d20a224d245ed8 Mon Sep 17 00:00:00 2001
From: kk1987 <kk1987@gmail.com>
Date: Fri, 6 Nov 2026 11:13:54 -0800
Subject: [PATCH] Input: soc_button_array - allow it on arm64

The NVIDIA N1x HP OmniBook X 14 reports its power button only through
an ACPI0011 Generic Buttons device, which needs this driver. 7.3 made
it X86-only (bde4905c102f).

Skip MSHW0040 on the Surface Laptop Ultra, another N1x machine. It
passes the OEM platform revision check but wires only the power
button; the volume GPIOs float and gpio-keys reports Volume Down held
forever. The skip is from ikegam, who tested it there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/input/misc/Kconfig            |  2 +-
 drivers/input/misc/soc_button_array.c | 19 +++++++++++++++++++
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/drivers/input/misc/Kconfig b/drivers/input/misc/Kconfig
index 169768e..eea6d95 100644
--- a/drivers/input/misc/Kconfig
+++ b/drivers/input/misc/Kconfig
@@ -904,7 +904,7 @@ config INPUT_IDEAPAD_SLIDEBAR
 config INPUT_SOC_BUTTON_ARRAY
 	tristate "Windows-compatible SoC Button Array"
 	depends on KEYBOARD_GPIO && ACPI
-	depends on X86
+	depends on X86 || ARM64
 	depends on GPIOLIB
 	select GPIOLIB_LEGACY
 	help
diff --git a/drivers/input/misc/soc_button_array.c b/drivers/input/misc/soc_button_array.c
index 0642436..34c9dd0 100644
--- a/drivers/input/misc/soc_button_array.c
+++ b/drivers/input/misc/soc_button_array.c
@@ -556,12 +556,31 @@ static const guid_t MSHW0040_DSM_UUID =
 	GUID_INIT(0x6fd05c69, 0xcde3, 0x49f4, 0x95, 0xed, 0xab, 0x16, 0x65,
 		  0x49, 0x80, 0x35);
 
+/*
+ * The Surface Laptop Ultra (NVIDIA N1X) also has MSHW0040 and passes the
+ * check below, but it has no volume buttons. Only the power button GPIO is
+ * wired; the two volume GPIOs float and gpio-keys reports Volume Down held
+ * forever. Leave the device to a driver that handles only the power button.
+ */
+static const struct dmi_system_id dmi_skip_MSHW0040[] = {
+	{
+		.matches = {
+			DMI_EXACT_MATCH(DMI_SYS_VENDOR, "Microsoft Corporation"),
+			DMI_MATCH(DMI_PRODUCT_NAME, "Surface Laptop Ultra"),
+		},
+	},
+	{} /* Terminating entry */
+};
+
 static int soc_device_check_MSHW0040(struct device *dev)
 {
 	acpi_handle handle = ACPI_HANDLE(dev);
 	union acpi_object *result;
 	u64 oem_platform_rev = 0;	// valid revisions are nonzero
 
+	if (dmi_check_system(dmi_skip_MSHW0040))
+		return -ENODEV;
+
 	// get OEM platform revision
 	result = acpi_evaluate_dsm_typed(handle, &MSHW0040_DSM_UUID,
 					 MSHW0040_DSM_REVISION,
-- 
2.56.0

