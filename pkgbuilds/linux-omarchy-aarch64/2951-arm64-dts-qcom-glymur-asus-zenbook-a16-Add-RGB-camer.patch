From 64ee8e26118aeb86a7def280f03d296f9d6709df Mon Sep 17 00:00:00 2001
From: Konrad Dybcio <konrad.dybcio@oss.qualcomm.com>
Date: Thu, 10 Sep 2026 20:13:49 +0200
Subject: [PATCH] arm64: dts: qcom: glymur-asus-zenbook-a16: Add RGB camera

The A16 features an OmniVison OV02C10 RGB camera sensor in the lid.
Wire it up.

Signed-off-by: Konrad Dybcio <konrad.dybcio@oss.qualcomm.com>
---
 .../qcom/glymur-asus-zenbook-a16-ux3607oa.dts | 76 ++++++++++++++++++-
 1 file changed, 74 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts b/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
index 10061b275c8ae3..c9580ab8cfafdb 100644
--- a/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
@@ -16,6 +16,8 @@
 #include <dt-bindings/input/gpio-keys.h>
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/leds/common.h>
+#include <dt-bindings/media/video-interface-devices.h>
+#include <dt-bindings/media/video-interfaces.h>
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
 
 /delete-node/ &pmh0104_l_e1;
@@ -136,7 +138,7 @@
 			panic-indicator;
 		};
 
-		privacy-led {
+		privacy_led: privacy-led {
 			function = LED_FUNCTION_INDICATOR;
 			color = <LED_COLOR_ID_WHITE>;
 			gpios = <&tlmm 111 GPIO_ACTIVE_HIGH>;
@@ -588,6 +590,69 @@
 	};
 };
 
+
+&camss {
+	status = "okay";
+};
+
+&camss_csiphy4_inep {
+	data-lanes = <1 2>;
+};
+
+&cci1 {
+	pinctrl-0 = <&cci1_1_default>;
+	pinctrl-1 = <&cci1_1_sleep>;
+
+	status = "okay";
+};
+
+&cci1_i2c1 {
+	camera@36 {
+		compatible = "ovti,ov02c10";
+		reg = <0x36>;
+
+		reset-gpios = <&tlmm 239 GPIO_ACTIVE_LOW>;
+
+		leds = <&privacy_led>;
+		led-names = "privacy";
+
+		clocks = <&camcc CAM_CC_MCLK4_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK4_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		orientation = <MEDIA_ORIENTATION_FRONT>;
+
+		avdd-supply = <&vreg_l7m>;
+		dovdd-supply = <&vreg_l4m>;
+		dvdd-supply = <&vreg_l4m>;
+
+		pinctrl-0 = <&cam_mclk4_default>, <&cam_reset4_default>;
+		pinctrl-names = "default";
+
+		port {
+			ov08x40_out_ep: endpoint {
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <400000000>;
+				remote-endpoint = <&csiphy4_in_ep>;
+			};
+		};
+	};
+};
+
+&csiphy4 {
+	vdda-0p9-supply = <&vreg_l1f_e1>;
+	vdda-1p2-supply = <&vreg_l4f_e1>;
+
+	status = "okay";
+};
+
+&csiphy4_in_ep {
+	bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+	clock-lanes = <0>;
+	data-lanes = <1 2>;
+	remote-endpoint = <&ov08x40_out_ep>;
+};
+
 &gpu {
 	status = "okay";
 };
@@ -622,7 +687,7 @@
 	status = "okay";
 
 	pm8010: pmic@8 {
-		status = "disabled";
+	//	status = "disabled";
 		compatible = "qcom,pm8010-i2c";
 		reg = <0x8>;
 
@@ -1188,6 +1253,13 @@
 			bias-pull-up;
 		};
 	};
+
+	cam_reset4_default: cam-reset4-default-state {
+		pins = "gpio239";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
 };
 
 &uart14 {
