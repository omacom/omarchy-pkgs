From fed3ebf6e68956a7d3b697180850fe75236c5cc5 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Mon, 9 Nov 2026 23:00:00 +0100
Subject: [PATCH 2/2] arm64: dts: qcom: Add the Dell Inspiron 14 Plus 5441
 (X1P-42-100)

The Inspiron 14 Plus 5441 with the Snapdragon X Plus X1P-42-100 (Purwa)
has a board of its own, 0DGG6Y. Its DSDT is the Thena DSDT of the
X1P-64-100 model, with the same devices, the same GPIO, I2C and UART
resources, and PEP tables that name the same regulators, voltages and
pins. The two differ in the SoC identity, the CPU and thermal tables,
the camera devices' status and a few methods. So the tree is purwa.dtsi
with x1-dell-thena.dtsi and, as on the other X1P42100 boards, without
the PMC8380 at SID 6.

Three things follow this laptop's own tables instead of the dtsi.

The codec device's _CRS has two resource sets, and with this board's
SPID of 1 it returns the one with a single speaker shutdown line, the
pin the dtsi drives as LPASS GPIO 12. Windows sets its codec driver up
here as "Thena 2spk", which has WSA macro 1 and the WCD but neither WSA
macro 2 nor its SoundWire interrupt. So describe two WSA884x amplifiers
on swr0 and turn swr3 off. linux-firmware has no topology under a 5441
name and the 7441's is the four-speaker one, so name the card after the
ThinkPad T14s's topology, which has the WCD, two-speaker WSA and VA
links this card has.

The panel is a CSOT 1920x1200 LCD, EDID product 0x143d, which _ROM maps
to the "LCD-NTS" configuration with a PWM backlight from PMIC 0, 12
bits at 250 Hz. The display's PEP entry puts PMK8550 GPIO5 on its third
special function. Add a PWM backlight on PMK8550's LPG channel 0
through that pin.

The GPU is the Adreno X1-45 and the video core is Purwa's, so the zap
shader is qcdxkmsucpurwa.mbn and the video firmware qcvss8380_pa.mbn,
loaded from qcom/x1p42100/dell/inspiron-14-plus-5441/ like the ADSP and
CDSP images.

TSC1 is the "NONT0001" placeholder and Windows enumerates no
touchscreen, so none is added, as on the X1P-64-100 model.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 arch/arm64/boot/dts/qcom/Makefile             |   2 +
 .../x1p42100-dell-inspiron-14-plus-5441.dts   | 125 ++++++++++++++++++
 2 files changed, 127 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/x1p42100-dell-inspiron-14-plus-5441.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 550669b..3826470 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -493,6 +493,8 @@ x1p42100-asus-zenbook-14-ux3480qa-el2-dtbs	:= x1p42100-asus-zenbook-14-ux3480qa.
 dtb-$(CONFIG_ARCH_QCOM)	+= x1p42100-asus-zenbook-14-ux3480qa.dtb x1p42100-asus-zenbook-14-ux3480qa-el2.dtb
 x1p42100-crd-el2-dtbs	:= x1p42100-crd.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x1p42100-crd.dtb x1p42100-crd-el2.dtb
+x1p42100-dell-inspiron-14-plus-5441-el2-dtbs	:= x1p42100-dell-inspiron-14-plus-5441.dtb x1-el2.dtbo
+dtb-$(CONFIG_ARCH_QCOM)	+= x1p42100-dell-inspiron-14-plus-5441.dtb x1p42100-dell-inspiron-14-plus-5441-el2.dtb
 x1p42100-hp-elitebook-6-g1q-el2-dtbs := x1p42100-hp-elitebook-6-g1q.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x1p42100-hp-elitebook-6-g1q.dtb x1p42100-hp-elitebook-6-g1q-el2.dtb
 x1p42100-hp-omnibook-3-16-el2-dtbs	:= x1p42100-hp-omnibook-3-16.dtb x1-el2.dtbo
diff --git a/arch/arm64/boot/dts/qcom/x1p42100-dell-inspiron-14-plus-5441.dts b/arch/arm64/boot/dts/qcom/x1p42100-dell-inspiron-14-plus-5441.dts
new file mode 100644
index 0000000..6a8a629
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/x1p42100-dell-inspiron-14-plus-5441.dts
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Copyright (c) 2025 Val Packett <val@packett.cool>
+ * Copyright (c) 2026 Adam Szyma <adamszyma@wp.pl>
+ */
+
+/dts-v1/;
+
+#include "purwa.dtsi"
+#include "x1-dell-thena.dtsi"
+
+/delete-node/ &pmc8380_6;
+/delete-node/ &pmc8380_6_thermal;
+/delete-node/ &pmc8380_6_die_temp;
+
+/delete-node/ &left_tweeter;
+/delete-node/ &left_woofer;
+
+/ {
+	model = "Dell Inspiron 14 Plus 5441 (X1P-42-100)";
+	compatible = "dell,purwa-inspiron-14-plus-5441", "qcom,x1p42100";
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pmk8550_pwm 0 4000000>;
+
+		pinctrl-0 = <&edp_bl_pwm>;
+		pinctrl-names = "default";
+	};
+};
+
+&gpu {
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/x1p42100/dell/inspiron-14-plus-5441/qcdxkmsucpurwa.mbn";
+};
+
+&iris {
+	firmware-name = "qcom/x1p42100/dell/inspiron-14-plus-5441/qcvss8380_pa.mbn";
+	status = "okay";
+};
+
+&mdss_dp3 {
+	aux-bus {
+		panel {
+			backlight = <&backlight>;
+		};
+	};
+};
+
+&pmk8550_gpios {
+	edp_bl_pwm: edp-bl-pwm-state {
+		pins = "gpio5";
+		function = "func3";
+	};
+};
+
+&pmk8550_pwm {
+	status = "okay";
+};
+
+&remoteproc_adsp {
+	firmware-name = "qcom/x1p42100/dell/inspiron-14-plus-5441/qcadsp8380.mbn",
+			"qcom/x1p42100/dell/inspiron-14-plus-5441/adsp_dtbs.elf";
+	status = "okay";
+};
+
+&remoteproc_cdsp {
+	firmware-name = "qcom/x1p42100/dell/inspiron-14-plus-5441/qccdsp8380.mbn",
+			"qcom/x1p42100/dell/inspiron-14-plus-5441/cdsp_dtbs.elf";
+	status = "okay";
+};
+
+&sound {
+	model = "X1E80100-LENOVO-Thinkpad-T14s";
+	audio-routing = "SpkrLeft IN", "WSA WSA_SPK1 OUT",
+			"SpkrRight IN", "WSA WSA_SPK2 OUT",
+			"IN1_HPHL", "HPHL_OUT",
+			"IN2_HPHR", "HPHR_OUT",
+			"AMIC2", "MIC BIAS2",
+			"VA DMIC0", "MIC BIAS1",
+			"VA DMIC1", "MIC BIAS1",
+			"VA DMIC0", "VA MIC BIAS1",
+			"VA DMIC1", "VA MIC BIAS1",
+			"TX SWR_INPUT1", "ADC2_OUTPUT";
+
+	wsa-dai-link {
+		codec {
+			sound-dai = <&left_spkr>, <&right_spkr>,
+				    <&swr0 0>, <&lpass_wsamacro 0>;
+		};
+	};
+};
+
+&swr0 {
+	/* WSA884x, Left Speaker */
+	left_spkr: speaker@0,0 {
+		compatible = "sdw20217020400";
+		reg = <0 0>;
+		reset-gpios = <&lpass_tlmm 12 GPIO_ACTIVE_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "SpkrLeft";
+		vdd-1p8-supply = <&vreg_l15b_1p8>;
+		vdd-io-supply = <&vreg_l12b_1p2>;
+		qcom,port-mapping = <1 2 3 7 10 13>;
+	};
+
+	/* WSA884x, Right Speaker */
+	right_spkr: speaker@0,1 {
+		compatible = "sdw20217020400";
+		reg = <0 1>;
+		reset-gpios = <&lpass_tlmm 12 GPIO_ACTIVE_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "SpkrRight";
+		vdd-1p8-supply = <&vreg_l15b_1p8>;
+		vdd-io-supply = <&vreg_l12b_1p2>;
+		qcom,port-mapping = <4 5 6 7 11 13>;
+	};
+};
+
+&swr3 {
+	status = "disabled";
+};
-- 
