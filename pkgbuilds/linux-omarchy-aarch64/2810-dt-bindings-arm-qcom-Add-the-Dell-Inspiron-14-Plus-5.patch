From d6021832fe107af0092ba2f6b7d935f7f9f06743 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Mon, 9 Nov 2026 23:00:00 +0100
Subject: [PATCH 1/2] dt-bindings: arm: qcom: Add the Dell Inspiron 14 Plus
 5441 (X1P-42-100)

The Dell Inspiron 14 Plus 5441 is also sold with the Snapdragon X Plus
X1P-42-100, the 8-core Purwa die, on a board of its own (0DGG6Y). The
X1P-64-100 model's tree cannot run on it. Add a compatible for the
Purwa model to the X1P42100 boards.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 Documentation/devicetree/bindings/arm/qcom.yaml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Documentation/devicetree/bindings/arm/qcom.yaml b/Documentation/devicetree/bindings/arm/qcom.yaml
index fb0dcd8..de4daae 100644
--- a/Documentation/devicetree/bindings/arm/qcom.yaml
+++ b/Documentation/devicetree/bindings/arm/qcom.yaml
@@ -1305,6 +1305,7 @@ properties:
               - asus,vivobook-s14-s3407qa
               - asus,vivobook-s15-x1p4
               - asus,zenbook-14-ux3480qa
+              - dell,purwa-inspiron-14-plus-5441
               - hp,elitebook-6-g1q
               - hp,omnibook-5
               - hp,omnibook-x14-fe1
