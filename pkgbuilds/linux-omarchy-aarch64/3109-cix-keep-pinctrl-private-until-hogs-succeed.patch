 {
 	struct pinctrl_dev *pctldev;
 	struct acpi_device *adev;
@@ -156,6 +162,9 @@
 	status = acpi_get_handle(NULL, pinctrl_acpi, &handle);
 	if (ACPI_FAILURE(status))
 		return NULL;
+
+	if (hog && ACPI_HANDLE(hog->dev) == handle)
+		return hog;
 
 	adev = acpi_get_acpi_dev(handle);
 	if (!adev)
@@ -275,9 +284,10 @@
 }
 
 static int
-acpi_pin_resource_to_pinctrl_map(struct pinctrl *p, char *pinctrl_acpi,
-				 struct pinctrl_acpi_resource *resource)
-{
+acpi_pin_resource_to_pinctrl_map(struct pinctrl_acpi_context *ctx,
