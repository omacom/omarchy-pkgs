-	adev = ACPI_COMPANION(p->dev);
+	adev = ACPI_COMPANION(ctx->p->dev);
 	ret = acpi_dev_get_resources(adev, &res_list,
-				     parse_acpi_pin_function_resources, p);
+				     parse_acpi_pin_function_resources, ctx);
 	if (ret < 0)
 		return ret;
 
@@ -664,16 +674,16 @@
 	}
 }
 
-static int parse_acpi_pin_configs(struct pinctrl *p)
-{
-	struct pin_config_lookup_info info = { .pctrl = p };
+static int parse_acpi_pin_configs(struct pinctrl_acpi_context *ctx)
