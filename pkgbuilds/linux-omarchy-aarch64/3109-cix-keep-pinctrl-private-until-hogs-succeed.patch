From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Clay Stan <claystan97@gmail.com>
Date: Tue, 24 Nov 2026 12:09:00 +0800
Subject: [PATCH] pinctrl: resolve ACPI hogs before publishing the controller

The ACPI mapper looked up a controller in the global list even for
its own hogs. Early publication lets a consumer get a pointer to a
controller whose registration can still fail.

Pass the known controller through the ACPI resource walk. Use it when
the resource names its ACPI handle and keep the existing provider
lookup for other resources. Publish only after hog setup succeeds, as
in the original pinctrl flow.

Signed-off-by: Clay Stan <claystan97@gmail.com>
---
diff --git a/drivers/pinctrl/core.c b/drivers/pinctrl/core.c
--- a/drivers/pinctrl/core.c
+++ b/drivers/pinctrl/core.c
@@ -1117,7 +1117,7 @@
 
 	if (has_acpi_companion(dev)) {
 		INIT_LIST_HEAD(&p->acpi_maps);
-		ret = pinctrl_acpi_to_map(p);
+		ret = pinctrl_acpi_to_map(p, pctldev);
 	} else {
 		INIT_LIST_HEAD(&p->dt_maps);
 		ret = pinctrl_dt_to_map(p, pctldev);
@@ -2260,18 +2260,13 @@
 {
 	int error;
 
-	/* Add to list before claiming hogs so that ACPI lookups succeed */
+	error = pinctrl_claim_hogs(pctldev);
+	if (error)
+		return error;
+
 	mutex_lock(&pinctrldev_list_mutex);
 	list_add_tail(&pctldev->node, &pinctrldev_list);
 	mutex_unlock(&pinctrldev_list_mutex);
-
-	error = pinctrl_claim_hogs(pctldev);
-	if (error) {
-		mutex_lock(&pinctrldev_list_mutex);
-		list_del_init(&pctldev->node);
-		mutex_unlock(&pinctrldev_list_mutex);
-		return error;
-	}
 
 	pinctrl_init_device_debugfs(pctldev);
 
diff --git a/drivers/pinctrl/pinctrl-acpi.h b/drivers/pinctrl/pinctrl-acpi.h
--- a/drivers/pinctrl/pinctrl-acpi.h
+++ b/drivers/pinctrl/pinctrl-acpi.h
@@ -81,12 +81,12 @@
 };
 
 #ifdef CONFIG_ACPI
-int pinctrl_acpi_to_map(struct pinctrl *p);
+int pinctrl_acpi_to_map(struct pinctrl *p, struct pinctrl_dev *hog);
 void pinctrl_acpi_free_maps(struct pinctrl *p);
 int pinctrl_acpi_get_pin_groups(struct acpi_device *adev,
 				struct list_head *group_desc_list);
 #else
-static inline int pinctrl_acpi_to_map(struct pinctrl *p)
+static inline int pinctrl_acpi_to_map(struct pinctrl *p, struct pinctrl_dev *hog)
 {
 	return -ENXIO;
 }
