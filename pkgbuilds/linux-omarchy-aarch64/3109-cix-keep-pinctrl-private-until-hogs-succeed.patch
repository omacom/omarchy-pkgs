  *
  * Return: Returns 0 on success, negative errno on failure.
  */
-int pinctrl_acpi_to_map(struct pinctrl *p)
-{
+int pinctrl_acpi_to_map(struct pinctrl *p, struct pinctrl_dev *hog)
+{
+	struct pinctrl_acpi_context ctx = { .p = p, .hog = hog };
 	int ret;
 
 	if (!has_acpi_companion(p->dev))
 		return -ENXIO;
 
-	ret = parse_acpi_pin_functions(p);
+	ret = parse_acpi_pin_functions(&ctx);
 	if (ret >= 0)
-		ret = parse_acpi_pin_configs(p);
+		ret = parse_acpi_pin_configs(&ctx);
 	if (ret < 0) {
 		pinctrl_acpi_free_maps(p);
 		return ret;
