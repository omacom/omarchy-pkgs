 						  int group,
 						  int function, int index)
@@ -335,10 +345,10 @@
 		.function.function_number = function
 	};
 
-	return acpi_pin_resource_to_pinctrl_map(p, pinctrl_acpi, &resource);
-}
-
-static int acpi_pin_function_to_pinctrl_map(struct pinctrl *p,
