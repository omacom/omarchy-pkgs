 {
@@ -366,11 +376,11 @@
 		.config.nconfigs = nconfigs
 	};
 
-	return acpi_pin_resource_to_pinctrl_map(p, pinctrl_acpi, &resource);
+	return acpi_pin_resource_to_pinctrl_map(ctx, pinctrl_acpi, &resource);
