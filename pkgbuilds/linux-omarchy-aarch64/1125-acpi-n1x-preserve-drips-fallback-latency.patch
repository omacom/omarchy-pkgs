Subject: [PATCH] ACPI: processor_idle: preserve N1x DRIPS fallback latency

Retain Ryan Hughes' N1x DRIPS latency workaround from downstream patch
1023 when the coordinated LPI path is unavailable or disabled. Firmware
can expose DRIPS with a 966 us wake latency below the package state's
967 us, so suspend-to-idle otherwise selects the package state.

Apply the original 6610 us adjustment only to the non-coordinated N1x
states with U32_MAX minimum residency, before calculating latency in
nanoseconds. Preserve their residency and keep coordinated latencies
unchanged.

Original workaround: Ryan Hughes <ryan@heyoodle.com>, patch 1023,
"ACPI: processor_idle: let suspend-to-idle reach the NVIDIA N1x DRIPS
state".
---
diff --git a/drivers/acpi/processor_idle.c b/drivers/acpi/processor_idle.c
--- a/drivers/acpi/processor_idle.c
+++ b/drivers/acpi/processor_idle.c
@@ -2697,6 +2697,9 @@
 	return __acpi_idle_lpi_enter_domain(dev, drv, index, true);
 }
 
+/* N1x DRIPS wake latency from _LPI with \\_SB.PEPD.MPEL set. */
+#define ACPI_N1X_DRIPS_WAKE_LATENCY_US	6610
+
 static void acpi_processor_setup_lpi_states(struct acpi_processor *pr,
 					    struct cpuidle_driver *drv,
 					    bool coordinated)
@@ -2708,9 +2711,11 @@
 	u32 arch_flags = 0;
 	unsigned int count = pr->power.count;
 	unsigned int i;
+	bool n1x;
 
 	if (!pr->flags.has_lpi)
 		return;
+	n1x = !coordinated && acpi_dev_present("NVDA6210", NULL, -1);
 	if (coordinated) {
 		if (!data || !data->base_map_entry)
 			return;
@@ -2725,6 +2730,15 @@
 		strscpy(state->desc, lpi->desc, CPUIDLE_DESC_LEN);
 		state->exit_latency = lpi->wake_latency;
 		state->target_residency = lpi->min_residency;
+		/*
+		 * Preserve the N1x fallback's DRIPS latency adjustment. Firmware
+		 * reports these states below the package latency until MPEL is
+		 * set, so s2idle otherwise stops at the package state. Retain the
+		 * sentinel residency that keeps ordinary idle from using DRIPS.
+		 * Coordinated mode already supplies its own composite latencies.
+		 */
+		if (n1x && lpi->min_residency == U32_MAX)
+			state->exit_latency += ACPI_N1X_DRIPS_WAKE_LATENCY_US;
 		state->exit_latency_ns =
 			mul_u32_u32(state->exit_latency, NSEC_PER_USEC);
 		state->target_residency_ns =
