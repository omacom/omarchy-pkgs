From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Felipe Infante de Castro <18445184+fidecastro@users.noreply.github.com>
Date: Mon, 16 Nov 2026 01:33:25 -0500
Subject: [PATCH] hwmon: (surface_fan) Add the fan's minimum speed as fan1_min

The Surface embedded controller (SAM) runs the fan from its own board
thermistors. On a Surface Laptop 7 15-inch (X1E80100) those lag the SoC
by 40 to 60 seconds: under an all-core load the hottest CPU sensor is at
95 C within two seconds, while the fan stays at 0 rpm for about a minute
and the firmware slows the cores meanwhile.

Windows does not leave the fan to SAM alone. Its thermal policy driver
writes fan parameters in target category 0x05, among them a minimum
speed in rpm (command 0x0b, u16), set from the SoC's temperatures. SAM
runs its own curve above that floor, and a floor of 0 leaves the fan to
SAM.

Expose that request as the standard hwmon attribute fan1_min. SAM has
no request to read the value back, so reads return the last value
written, 0 after probe. Values are clamped to 0..10000, the range in
Microsoft's policy files. A floor left set would keep the fan running
with nobody watching the temperature, so clear it on remove, shutdown
and suspend.

The floor is not put back on resume. For the first seconds after a
resume SAM accepts a floor without keeping it: one written from the
resume callback, or from a PM notifier once every device had resumed,
left the fan at 0 rpm, while one written about five seconds later held.
So fan1_min reads 0 after a resume until it is written again.

Tested on a Surface Laptop 7 15-inch: writing 3000 brings the fan from
0 to about 3000 rpm in under 30 s, writing 0 returns it to 0 within
2 s, and removing the driver with a floor set stops the fan. Across a
suspend to RAM with a floor of 3000, fan1_min reads 0 and the fan is
off after the resume, and 3000 written ten seconds later holds. With a
user-space policy setting the floor from the SoC's sensors, a 60 s
all-core load does about 10% more work.

Assisted-by: Claude Fable 5.2
Signed-off-by: Felipe Infante de Castro <18445184+fidecastro@users.noreply.github.com>
---
 drivers/hwmon/surface_fan.c | 134 ++++++++++++++++++++++++++++++++++--
 1 file changed, 128 insertions(+), 6 deletions(-)

diff --git a/drivers/hwmon/surface_fan.c b/drivers/hwmon/surface_fan.c
index aafb4ac..c8d81af 100644
--- a/drivers/hwmon/surface_fan.c
+++ b/drivers/hwmon/surface_fan.c
@@ -1,14 +1,17 @@
 // SPDX-License-Identifier: GPL-2.0+
 /*
  * Surface Fan driver for Surface System Aggregator Module. It provides access
- * to the fan's rpm through the hwmon system.
+ * to the fan's rpm and to its minimum rpm through the hwmon system.
  *
  * Copyright (C) 2023 Ivor Wanders <ivor@iwanders.net>
  */
 
 #include <linux/hwmon.h>
 #include <linux/kernel.h>
+#include <linux/minmax.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/pm.h>
 #include <linux/surface_aggregator/device.h>
 #include <linux/types.h>
 
@@ -18,15 +21,59 @@ SSAM_DEFINE_SYNC_REQUEST_CL_R(__ssam_fan_rpm_get, __le16, {
 	.command_id      = 0x01,
 });
 
+/*
+ * Minimum fan speed in rpm. The EC runs the fan on its own curve from its own
+ * (slow) board sensors and never below this floor; 0 leaves the fan to the EC
+ * alone. Windows sets it from its thermal policy, typically 0 or a few
+ * thousand rpm. The EC offers no request to read it back.
+ */
+SSAM_DEFINE_SYNC_REQUEST_CL_W(__ssam_fan_rpm_min_set, __le16, {
+	.target_category = SSAM_SSH_TC_FAN,
+	.command_id      = 0x0b,
+});
+
+/* The range Microsoft's policy files give for the fan speed channels. */
+#define SURFACE_FAN_RPM_MAX	10000
+
+struct surface_fan {
+	struct ssam_device *sdev;
+	struct mutex lock;	/* protects min_rpm against concurrent writes */
+	u16 min_rpm;		/* last value written, the EC cannot be asked */
+};
+
+static int surface_fan_rpm_min_set(struct surface_fan *fan, u16 rpm)
+{
+	__le16 value = cpu_to_le16(rpm);
+
+	return ssam_retry(__ssam_fan_rpm_min_set, fan->sdev, &value);
+}
+
+static umode_t surface_fan_hwmon_is_visible(const void *data,
+					    enum hwmon_sensor_types type,
+					    u32 attr, int channel)
+{
+	if (type == hwmon_fan && attr == hwmon_fan_min)
+		return 0644;
+
+	return 0444;
+}
+
 static int surface_fan_hwmon_read(struct device *dev,
 				  enum hwmon_sensor_types type, u32 attr,
 				  int channel, long *val)
 {
-	struct ssam_device *sdev = dev_get_drvdata(dev);
+	struct surface_fan *fan = dev_get_drvdata(dev);
 	int ret;
 	__le16 value;
 
-	ret = __ssam_fan_rpm_get(sdev, &value);
+	if (attr == hwmon_fan_min) {
+		mutex_lock(&fan->lock);
+		*val = fan->min_rpm;
+		mutex_unlock(&fan->lock);
+		return 0;
+	}
+
+	ret = __ssam_fan_rpm_get(fan->sdev, &value);
 	if (ret)
 		return ret;
 
@@ -35,14 +82,36 @@ static int surface_fan_hwmon_read(struct device *dev,
 	return 0;
 }
 
+static int surface_fan_hwmon_write(struct device *dev,
+				   enum hwmon_sensor_types type, u32 attr,
+				   int channel, long val)
+{
+	struct surface_fan *fan = dev_get_drvdata(dev);
+	int ret;
+
+	if (type != hwmon_fan || attr != hwmon_fan_min)
+		return -EOPNOTSUPP;
+
+	val = clamp_val(val, 0, SURFACE_FAN_RPM_MAX);
+
+	mutex_lock(&fan->lock);
+	ret = surface_fan_rpm_min_set(fan, val);
+	if (!ret)
+		fan->min_rpm = val;
+	mutex_unlock(&fan->lock);
+
+	return ret;
+}
+
 static const struct hwmon_channel_info *const surface_fan_info[] = {
-	HWMON_CHANNEL_INFO(fan, HWMON_F_INPUT),
+	HWMON_CHANNEL_INFO(fan, HWMON_F_INPUT | HWMON_F_MIN),
 	NULL
 };
 
 static const struct hwmon_ops surface_fan_hwmon_ops = {
-	.visible = 0444,
+	.is_visible = surface_fan_hwmon_is_visible,
 	.read = surface_fan_hwmon_read,
+	.write = surface_fan_hwmon_write,
 };
 
 static const struct hwmon_chip_info surface_fan_chip_info = {
@@ -52,16 +121,66 @@ static const struct hwmon_chip_info surface_fan_chip_info = {
 
 static int surface_fan_probe(struct ssam_device *sdev)
 {
+	struct surface_fan *fan;
 	struct device *hdev;
+	int ret;
+
+	fan = devm_kzalloc(&sdev->dev, sizeof(*fan), GFP_KERNEL);
+	if (!fan)
+		return -ENOMEM;
+
+	fan->sdev = sdev;
+	ret = devm_mutex_init(&sdev->dev, &fan->lock);
+	if (ret)
+		return ret;
+
+	ssam_device_set_drvdata(sdev, fan);
 
 	hdev = devm_hwmon_device_register_with_info(&sdev->dev,
-						    "surface_fan", sdev,
+						    "surface_fan", fan,
 						    &surface_fan_chip_info,
 						    NULL);
 
 	return PTR_ERR_OR_ZERO(hdev);
 }
 
+/* Hand the fan back to the EC: a floor must not outlive whoever set it. */
+static void surface_fan_release(struct surface_fan *fan)
+{
+	mutex_lock(&fan->lock);
+	if (fan->min_rpm) {
+		surface_fan_rpm_min_set(fan, 0);
+		fan->min_rpm = 0;
+	}
+	mutex_unlock(&fan->lock);
+}
+
+static void surface_fan_remove(struct ssam_device *sdev)
+{
+	struct surface_fan *fan = ssam_device_get_drvdata(sdev);
+
+	surface_fan_release(fan);
+}
+
+static void surface_fan_shutdown(struct device *dev)
+{
+	surface_fan_release(dev_get_drvdata(dev));
+}
+
+/*
+ * No floor while asleep, and none after: for the first seconds after a resume
+ * the EC accepts a floor without keeping it, so the driver does not put the
+ * old one back. fan1_min reads 0 until it is written again.
+ */
+static int surface_fan_suspend(struct device *dev)
+{
+	surface_fan_release(dev_get_drvdata(dev));
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(surface_fan_pm_ops, surface_fan_suspend, NULL);
+
 static const struct ssam_device_id ssam_fan_match[] = {
 	{ SSAM_SDEV(FAN, SAM, 0x01, 0x01) },
 	{},
@@ -70,10 +189,13 @@ MODULE_DEVICE_TABLE(ssam, ssam_fan_match);
 
 static struct ssam_device_driver surface_fan = {
 	.probe = surface_fan_probe,
+	.remove = surface_fan_remove,
 	.match_table = ssam_fan_match,
 	.driver = {
 		.name = "surface_fan",
 		.probe_type = PROBE_PREFER_ASYNCHRONOUS,
+		.pm = pm_sleep_ptr(&surface_fan_pm_ops),
+		.shutdown = surface_fan_shutdown,
 	},
 };
 module_ssam_device_driver(surface_fan);
-- 
2.56.1

