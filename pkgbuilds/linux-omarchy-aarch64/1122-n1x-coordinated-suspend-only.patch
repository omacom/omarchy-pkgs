+static bool acpi_lpi_has_resource_dependencies(void)
+{
+	struct acpi_idle_data *data;
+	int cpu;
+
+	for_each_possible_cpu(cpu) {
+		if (cpumask_test_cpu(cpu, &acpi_lpi_excluded_cpus))
+			continue;
+
+		data = per_cpu(acpi_idle_data, cpu);
+		if (data && data->has_rdi)
+			return true;
+	}
+
+	return false;
+}
