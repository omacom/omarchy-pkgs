+		if (n1x_coordinated_requested)
+			pr_warn("P16 coordination blocked: OSLPI_ack=%u cached_PSCI_OSI=%u\n",
+				osc_os_lpi_support_confirmed,
+				acpi_processor_ffh_lpi_hierarchy_supported());
+		return -EOPNOTSUPP;
+	}
