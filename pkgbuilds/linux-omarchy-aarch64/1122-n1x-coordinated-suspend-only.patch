+		unregister_pm_notifier(&acpi_idle_pm_notifier);
+	WRITE_ONCE(acpi_lpi_system_sleep, false);
+free_mask:
+	free_cpumask_var(runtime_active);
+
+free_enabled:
+	free_cpumask_var(enabled);
+
+free_disabled:
+	free_cpumask_var(disabled);
+	return ret;
+}
