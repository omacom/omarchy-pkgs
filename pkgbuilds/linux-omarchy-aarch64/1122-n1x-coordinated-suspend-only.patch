+	for_each_possible_cpu(cpu) {
+		drv = per_cpu(acpi_idle_cpu_driver, cpu);
+		if (!drv)
+			continue;
+
+		cpuidle_unregister_driver(drv);
+		per_cpu(acpi_idle_cpu_driver, cpu) = NULL;
+		kfree(drv);
+	}
+
+	WRITE_ONCE(acpi_idle_uses_per_cpu_drivers, false);
