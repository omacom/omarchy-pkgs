+		if (!n1x_coordinated_allowed() || num_present_cpus() != 20) {
+			ret = -EINVAL;
+			goto remove_cpuhp;
+		}
+		for_each_present_cpu(cpu) {
+			struct acpi_idle_data *data = per_cpu(acpi_idle_data, cpu);
