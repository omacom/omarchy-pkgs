+		pr = per_cpu(processors, cpu);
+		data = per_cpu(acpi_idle_data, cpu);
+		if (!pr || !pr->flags.power_setup_done || !pr->flags.has_lpi ||
+		    !data || !data->domain_dev || !data->base_map_entry)
+			return false;
+		if (!acpi_idle_driver_is_registered(cpu))
