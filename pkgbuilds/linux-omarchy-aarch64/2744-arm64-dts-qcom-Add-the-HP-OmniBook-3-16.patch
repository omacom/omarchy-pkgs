From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Sat, 7 Nov 2026 10:39:20 +0100
Subject: [PATCH] arm64: dts: qcom: Add the HP OmniBook 3 16

Add a device tree for the HP OmniBook 3 Laptop 16-bz0xxx (board 8EE6),
with the Snapdragon X X1-26-100. It builds on the OmniBook 3 14's
x1-hp-omnibook-3.dtsi, whose regulators, NVMe, Wi-Fi, Bluetooth, HDMI,
lid, touchpad and sound resources the 16's DSDT gives unchanged, and
overrides what differs:

- the keyboard on i2c0 at 0x3a with HID descriptor 0x1
- the USB-A repeaters on i2c17 at 0x47 and 0x4f, and the camera port's
  on i2c5 at 0x4f
- an LCD panel with a PMIC PWM backlight at the DSDT's 2400 Hz
- a second touchpad source, the DSDT's Synaptics at 0x2c
- the WCN6855's PCI ID as Windows enumerates it

The DSP and GPU firmware go under qcom/x1p42100/hp/omnibook-3-16-bz0/,
since this laptop's ADSP image and GPU zap shader match no other
laptop's.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 arch/arm64/boot/dts/qcom/Makefile             |   2 +
 .../dts/qcom/x1p42100-hp-omnibook-3-16.dts    | 195 ++++++++++++++++++
 2 files changed, 197 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-3-16.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index a2bfd31..f302050 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -489,6 +489,8 @@ x1p42100-crd-el2-dtbs	:= x1p42100-crd.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x1p42100-crd.dtb x1p42100-crd-el2.dtb
 x1p42100-hp-elitebook-6-g1q-el2-dtbs := x1p42100-hp-elitebook-6-g1q.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x1p42100-hp-elitebook-6-g1q.dtb x1p42100-hp-elitebook-6-g1q-el2.dtb
+x1p42100-hp-omnibook-3-16-el2-dtbs	:= x1p42100-hp-omnibook-3-16.dtb x1-el2.dtbo
+dtb-$(CONFIG_ARCH_QCOM)	+= x1p42100-hp-omnibook-3-16.dtb x1p42100-hp-omnibook-3-16-el2.dtb
 x1p42100-hp-omnibook-3-oled-el2-dtbs	:= x1p42100-hp-omnibook-3-oled.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x1p42100-hp-omnibook-3-oled.dtb x1p42100-hp-omnibook-3-oled-el2.dtb
 x1p42100-hp-omnibook-5-el2-dtbs	:= x1p42100-hp-omnibook-5.dtb x1-el2.dtbo
diff --git a/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-3-16.dts b/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-3-16.dts
new file mode 100644
index 0000000..7b76e76
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-3-16.dts
@@ -0,0 +1,195 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * HP OmniBook 3 Laptop 16-bz0xxx (board 8EE6), on the OmniBook 3 14's
+ * x1-hp-omnibook-3.dtsi. Each override below is what the 16's DSDT
+ * (BIOS F.06) gives where it differs from the 14's (board 8EF1).
+ */
+
+/dts-v1/;
+
+#include "purwa.dtsi"
+#include "hamoa-pmics.dtsi"
+#include "x1-hp-omnibook-3.dtsi"
+
+/delete-node/ &pmc8380_6;
+/delete-node/ &pmc8380_6_thermal;
+
+/ {
+	model = "HP OmniBook 3 Laptop 16-bz0xxx";
+	compatible = "hp,omnibook-3-16-bz0", "qcom,x126100", "qcom,x1p42100";
+	chassis-type = "laptop";
+
+	/* DSDT: PMIC PWM, 12 bits, 2400 Hz for AUO 0xd7b5 and BOE 0x0d2e */
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pmk8550_pwm 0 416667>;
+		enable-gpios = <&pmc8380_3_gpios 4 GPIO_ACTIVE_HIGH>;
+		power-supply = <&vreg_edp_bl>;
+
+		pinctrl-0 = <&edp_bl_en>, <&edp_bl_pwm>;
+		pinctrl-names = "default";
+	};
+
+	vreg_edp_bl: regulator-edp-bl {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VBL9";
+		regulator-min-microvolt = <3600000>;
+		regulator-max-microvolt = <3600000>;
+
+		gpio = <&pmc8380_3_gpios 10 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		pinctrl-0 = <&edp_bl_reg_en>;
+		pinctrl-names = "default";
+
+		regulator-boot-on;
+	};
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/x1p42100/hp/omnibook-3-16-bz0/qcdxkmsucpurwa.mbn";
+};
+
+/* DSDT ECKB: I2C1 (QUP0 SE0) 0x3a, HID descriptor 0x1. TCPD is on the same bus */
+&i2c0 {
+	keyboard@3a {
+		compatible = "hid-over-i2c";
+		reg = <0x3a>;
+
+		hid-descr-addr = <0x1>;
+		interrupts-extended = <&tlmm 67 IRQ_TYPE_LEVEL_LOW>;
+
+		vdd-supply = <&vreg_misc_3p3>;
+		vddl-supply = <&vreg_l12b_1p2>;
+
+		pinctrl-0 = <&kybd_default>;
+		pinctrl-names = "default";
+
+		wakeup-source;
+	};
+
+	/* DSDT TCPD's second source, SYNA352E, descriptor 0x20 */
+	touchpad@2c {
+		compatible = "hid-over-i2c";
+		reg = <0x2c>;
+
+		hid-descr-addr = <0x20>;
+		interrupts-extended = <&tlmm 3 IRQ_TYPE_LEVEL_LOW>;
+
+		vdd-supply = <&vreg_misc_3p3>;
+		vddl-supply = <&vreg_l12b_1p2>;
+
+		wakeup-source;
+	};
+};
+
+/* DSDT USB4 (usb_2): I2C6 (QUP0 SE5) 0x4f, reset 7 */
+&i2c5 {
+	/delete-node/ keyboard@3a;
+	/delete-node/ redriver@43;
+	/delete-node/ redriver@4b;
+	/delete-node/ redriver@4f;
+
+	eusb5_repeater: redriver@4f {
+		compatible = "nxp,ptn3222";
+		reg = <0x4f>;
+		#phy-cells = <0>;
+
+		vdd3v3-supply = <&vreg_l13b_3p0>;
+		vdd1v8-supply = <&vreg_l4b_1p8>;
+
+		reset-gpios = <&tlmm 7 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&eusb5_reset_n>;
+		pinctrl-names = "default";
+	};
+};
+
+/* DSDT USB3 (usb_mp): IC18 (QUP2 SE1) 0x47 and 0x4f, resets 6 and 184 */
+&i2c17 {
+	clock-frequency = <400000>;
+
+	status = "okay";
+
+	eusb3_repeater: redriver@47 {
+		compatible = "nxp,ptn3222";
+		reg = <0x47>;
+		#phy-cells = <0>;
+
+		vdd3v3-supply = <&vreg_l13b_3p0>;
+		vdd1v8-supply = <&vreg_l4b_1p8>;
+
+		reset-gpios = <&tlmm 6 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&eusb3_reset_n>;
+		pinctrl-names = "default";
+	};
+
+	eusb6_repeater: redriver@4f {
+		compatible = "nxp,ptn3222";
+		reg = <0x4f>;
+		#phy-cells = <0>;
+
+		vdd3v3-supply = <&vreg_l13b_3p0>;
+		vdd1v8-supply = <&vreg_l4b_1p8>;
+
+		reset-gpios = <&tlmm 184 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&eusb6_reset_n>;
+		pinctrl-names = "default";
+	};
+};
+
+&mdss_dp3 {
+	aux-bus {
+		panel {
+			compatible = "edp-panel";
+
+			/delete-property/ enable-gpios;
+			/delete-property/ pinctrl-0;
+			/delete-property/ pinctrl-names;
+
+			backlight = <&backlight>;
+		};
+	};
+};
+
+/* Windows: PCI 17cb:1103 subsystem 103c:8d9a, a WCN6855 */
+&pcie4_port0 {
+	wifi@0 {
+		compatible = "pci17cb,1103";
+	};
+};
+
+&pmc8380_3_gpios {
+	edp_bl_reg_en: edp-bl-reg-en-state {
+		pins = "gpio10";
+		function = "normal";
+	};
+};
+
+&pmk8550_gpios {
+	edp_bl_pwm: edp-bl-pwm-state {
+		pins = "gpio5";
+		function = "func3";
+	};
+};
+
+&pmk8550_pwm {
+	status = "okay";
+};
+
+&remoteproc_adsp {
+	firmware-name = "qcom/x1p42100/hp/omnibook-3-16-bz0/qcadsp8380.mbn",
+			"qcom/x1p42100/hp/omnibook-3-16-bz0/adsp_dtbs.elf";
+
+	status = "okay";
+};
+
+&remoteproc_cdsp {
+	firmware-name = "qcom/x1p42100/hp/omnibook-3-16-bz0/qccdsp8380.mbn",
+			"qcom/x1p42100/hp/omnibook-3-16-bz0/cdsp_dtbs.elf";
+
+	status = "okay";
+};
-- 
