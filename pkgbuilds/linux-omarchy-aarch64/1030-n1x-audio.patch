From ace64f72d155b720e94e31ac7142920b54d0daac Mon Sep 17 00:00:00 2001
From: Trevor Wu <trevor.wu@mediatek.com>
Date: Thu, 3 Sep 2026 17:45:08 -0700
Subject: [PATCH] NVIDIA: SAUCE: soundwire: mediatek: add mt8901 clock control
 support

BugLink: https://bugs.launchpad.net/bugs/2166301

Integrate clock management into the mt8901 SoundWire manager: bring
the functional clock tree up during link initialization and release it
symmetrically on teardown, using the shared mt8901 AFE clock helpers.

Folded review fixes: release the link top clock when link init fails
partway, and keep the register clock bookkeeping accurate in the probe
unwind path so a failed probe does not leave gates held.

Depends on the MediaTek power_wrap driver (submitted separately).

Signed-off-by: Trevor Wu <trevor.wu@mediatek.com>
Co-developed-by: David Cemin <dcemin@nvidia.com>
Signed-off-by: David Cemin <dcemin@nvidia.com>
Acked-by: Jamie Nguyen <jamien@nvidia.com>
Acked-by: Carol L Soto <csoto@nvidia.com>
Signed-off-by: Brad Figg <bfigg@nvidia.com>
---
 drivers/soundwire/Kconfig                     |  12 +
 drivers/soundwire/mediatek/Makefile           |   3 +-
 drivers/soundwire/mediatek/mt8901-afe-clk.c   | 951 ++++++++++++++++++
 drivers/soundwire/mediatek/mt8901-afe-clk.h   | 162 +++
 drivers/soundwire/mediatek/mtk-sdw-chipglue.c |  34 +
 drivers/soundwire/mediatek/mtk-sdw-common.h   |  29 +-
 drivers/soundwire/mediatek/mtk-sdw.c          |  98 +-
 7 files changed, 1282 insertions(+), 7 deletions(-)
 create mode 100644 drivers/soundwire/mediatek/mt8901-afe-clk.c
 create mode 100644 drivers/soundwire/mediatek/mt8901-afe-clk.h
 create mode 100644 drivers/soundwire/mediatek/mtk-sdw-chipglue.c

diff --git a/drivers/soundwire/Kconfig b/drivers/soundwire/Kconfig
index 9e96cf1bca..38b8835b3c 100644
--- a/drivers/soundwire/Kconfig
+++ b/drivers/soundwire/Kconfig
@@ -61,13 +61,25 @@ config SOUNDWIRE_MTK
 	tristate "MediaTek SoundWire Master driver"
 	select SOUNDWIRE_GENERIC_ALLOCATION
 	depends on SND_SOC && ACPI
+	depends on MTK_POWER_WRAP
 	select SND_SOC_ACPI
+	select SOUNDWIRE_MTK_MT8901_CLK
 	help
 	  SoundWire MediaTek Master driver.
 	  If you have an MediaTek platform which has a SoundWire Master then
 	  enable this config option to get the SoundWire support for that
 	  device.
 
+config SOUNDWIRE_MTK_MT8901_CLK
+	bool
+	depends on SOUNDWIRE_MTK
+	depends on MTK_POWER_WRAP
+	help
+	  MT8901 clock and power control backend for the MediaTek SoundWire
+	  Master driver. Every hardware version the driver supports needs it,
+	  so SOUNDWIRE_MTK selects it; there is no configuration in which the
+	  manager probes without it.
+
 config SOUNDWIRE_GENERIC_ALLOCATION
 	tristate
 
