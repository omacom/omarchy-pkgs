 4 files changed, 195 insertions(+), 1 deletion(-)
 create mode 100644 sound/soc/sof/mediatek/mt8901/Makefile
 create mode 100644 sound/soc/sof/mediatek/mt8901/mt8901.c

diff --git a/sound/soc/sof/mediatek/Kconfig b/sound/soc/sof/mediatek/Kconfig
index 4a2eddf600..66caa6d13b 100644
--- a/sound/soc/sof/mediatek/Kconfig
+++ b/sound/soc/sof/mediatek/Kconfig
@@ -3,7 +3,7 @@
 config SND_SOC_SOF_MTK_TOPLEVEL
 	bool "SOF support for MTK audio DSPs"
