From 3e220be45c709fb8744579f09c5ede4dbbf14fc6 Mon Sep 17 00:00:00 2001
From: Trevor Wu <trevor.wu@mediatek.com>
Date: Thu, 3 Sep 2026 17:45:07 -0700
Subject: [PATCH] NVIDIA: SAUCE: ASoC: mediatek: mt8901: add legacy machine
 driver

BugLink: https://bugs.launchpad.net/bugs/2166301

Add the mt8901 machine driver for SoundWire audio devices: Kconfig
and Makefile entries plus the machine driver implementation that binds
the AFE platform DAIs to the enumerated SoundWire codec endpoints.

Folded review fix: size the codec_conf array by the number of codec
endpoints rather than the number of devices; a device contributing
several endpoints previously overran the array.

Signed-off-by: Trevor Wu <trevor.wu@mediatek.com>
Co-developed-by: David Cemin <dcemin@nvidia.com>
Signed-off-by: David Cemin <dcemin@nvidia.com>
Acked-by: Jamie Nguyen <jamien@nvidia.com>
Acked-by: Carol L Soto <csoto@nvidia.com>
Signed-off-by: Brad Figg <bfigg@nvidia.com>
---
 sound/soc/mediatek/Kconfig                    |  14 +
 sound/soc/mediatek/mt8901/Makefile            |   1 +
 .../mt8901/mt8901-acp-sdw-legacy-mach.c       | 554 ++++++++++++++++++
 3 files changed, 569 insertions(+)
 create mode 100644 sound/soc/mediatek/mt8901/mt8901-acp-sdw-legacy-mach.c

diff --git a/sound/soc/mediatek/Kconfig b/sound/soc/mediatek/Kconfig
index 80306dd20e..e5003dc009 100644
--- a/sound/soc/mediatek/Kconfig
+++ b/sound/soc/mediatek/Kconfig
@@ -404,4 +404,18 @@ config SND_SOC_MT8901
 	  Select Y if you have such device.
 	  If unsure select "N".
 
+config SND_SOC_MT8901_LEGACY_SDW_MACH
+	tristate "ASoC Audio driver for MT8901 SoundWire machine"
+	depends on SND_SOC_MT8901 && ACPI
+	depends on SOUNDWIRE_MTK
+	select SND_SOC_SDW_UTILS
+	select SND_SOC_RT712_SDCA_SDW
+	select SND_SOC_RT712_SDCA_DMIC_SDW
+	select SND_SOC_RT1320_SDW
+	help
+	  This adds support for Legacy(No DSP) sound card for MediaTek
+	  MT8901 boards.
+	  Select Y if you have such device.
+	  If unsure select "N".
+
 endmenu
diff --git a/sound/soc/mediatek/mt8901/Makefile b/sound/soc/mediatek/mt8901/Makefile
index 8b4f9b54f6..b2c921f11c 100644
--- a/sound/soc/mediatek/mt8901/Makefile
+++ b/sound/soc/mediatek/mt8901/Makefile
@@ -6,3 +6,4 @@ snd-soc-mt8901-afe-y := \
