 	{
 		.link_mask = BIT(0) | BIT(1),
 		.links     = mtk_sdw_rt1320_l0_rt712_l1,
 		.drv_name  = "mtk_sdw_mc",
 	},
+	{
+		.link_mask = BIT(0) | BIT(1),
+		.links     = mtk_sdw_cs35l56_l0_cs42l43_l1,
+		.drv_name  = "mtk_sdw_mc",
+	},
 	{}
 };
 
