+static int mt8901_afe_init_regs(struct mtk_base_afe *afe)
+{
+	/*
+	 * Route only the sources a memif can own (IRQ 0 to 15) to the MCU.
+	 * The handler acknowledges through the memif mapping, so an enabled
+	 * source without a memif would retrigger forever. Per-stream gating
+	 * is the CFG0 enable bit driven by the trigger callbacks.
+	 */
+	static const struct reg_sequence init_regs[] = {
+		{ AFE_IRQ_MCU_EN,      GENMASK(MT8901_AFE_MEMIF_NUM - 1, 0) },
+		{ AFE_APLL1_TUNER_CFG, 0x332 },
+		{ AFE_APLL2_TUNER_CFG, 0x374 },
+		{ AFE_MEMIF_CON0,      0x9 },
+	};
+	int i;
+
+	/* Firmware may leave sources asserted; clear them all before routing. */
+	for (i = 0; i < MT8901_AFE_IRQ_NUM; i++)
+		mt8901_afe_irq_clear(afe, &irq_data[i]);
+
+	return regmap_multi_reg_write(afe->regmap,
+				      init_regs, ARRAY_SIZE(init_regs));
+}
