+	SSPM_AUD_CMD_VLP_SYS_CLK_MUX,
+	SSPM_AUD_CMD_VLP_SYS_CLK_SET_RATE,
+	SSPM_AUD_CMD_VLP_SYS_CLK_SET_PARENT,
