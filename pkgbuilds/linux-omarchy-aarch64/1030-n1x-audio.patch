+err_vadsp:
+	mt8901_afe_clk_mux_req(dev, AFE_CLK_VLP_CKSYS_TOP_VADSP_SEL, false);
+err_intbus:
+	mt8901_afe_clk_mux_req(dev, AFE_CLK_VLP_CKSYS_TOP_AUD_INTBUS_SEL,
