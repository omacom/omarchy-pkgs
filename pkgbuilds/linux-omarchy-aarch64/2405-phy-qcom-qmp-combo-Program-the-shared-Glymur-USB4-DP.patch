From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 8 Oct 2026 13:55:30 -0500
Subject: [PATCH] phy: qcom: qmp-combo: Program the shared Glymur USB4 DP/AUX
 block

The Glymur USB4 PHY start-up also writes a DP producer/AUX block outside
the combo PHY's own register space: its mode register is cleared and a
configuration register set to 0x4e, after the common setup and before
the common and PCS resets and the USB4 table. The block is shared
between routers, so more than one PHY instance may describe it.

Map an optional "usb4-dp-aux" register region without claiming it and,
when a board describes it, program the two registers in that place of
the USB4 sequence. Boards without the region keep the previous
sequence.

The values match what the platform's Windows driver programs on the
Surface Laptop 8.

Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/phy/qualcomm/phy-qcom-qmp-combo.c | 28 +++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
index c17eb9cc86d..7ae3c539f56 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
@@ -2663,6 +2663,8 @@ struct qmp_combo {
 
 	void __iomem *usb4_serdes;
 	void __iomem *usb4_pcs;
+	/* Optional shared USB4 DP producer/AUX block programmed before USB4 tables. */
+	void __iomem *usb4_dp_aux;
 
 	struct clk *pipe_clk;
 	struct clk_bulk_data *clks;
@@ -4588,6 +4590,10 @@ static int qmp_combo_dp_power_off(struct phy *phy)
 #define QPHY_V8_USB4_IVCM_RECALIBRATE	GENMASK(2, 1)
 #define QPHY_V8_USB4_IVCM_RESULT_MASK	GENMASK(5, 0)
 #define QPHY_V8_USB4_IVCM_EXPECTED	0x20
+/* Shared USB4 DP producer/AUX block registers */
+#define QMP_USB4_DP_AUX_MODE		0x1c
+#define QMP_USB4_DP_AUX_CFG1		0x24
+#define QMP_USB4_DP_AUX_CFG1_VAL	0x4e
 
 static int qmp_v8_usb4_wait_ready(struct qmp_combo *qmp)
 {
@@ -4658,6 +4664,15 @@ static int qmp_v8_configure_usb4_phy(struct qmp_combo *qmp)
 		return -EINVAL;
 	}
 
+	/*
+	 * Program the shared DP producer/AUX block after the common setup and
+	 * before the common and PCS resets and the selected table.
+	 */
+	if (qmp->usb4_dp_aux) {
+		writel(0, qmp->usb4_dp_aux + QMP_USB4_DP_AUX_MODE);
+		writel(QMP_USB4_DP_AUX_CFG1_VAL, qmp->usb4_dp_aux + QMP_USB4_DP_AUX_CFG1);
+	}
+
 	/* Clock and regulator ownership remains with qmp_combo_com_init(). */
 	tunnel_clock = readl(qmp->com + QPHY_V3_DP_COM_PHY_MODE_CTRL) &
 		       DP_TUNNELING_CLOCK_GEN_EN;
@@ -5830,6 +5845,7 @@ static int qmp_combo_parse_dt(struct qmp_combo *qmp)
 	const struct qmp_phy_cfg *cfg = qmp->cfg;
 	const struct qmp_combo_offsets *offs = cfg->offsets;
 	struct device *dev = qmp->dev;
+	struct resource *res;
 	void __iomem *base;
 	int ret;
 
@@ -5869,6 +5885,18 @@ static int qmp_combo_parse_dt(struct qmp_combo *qmp)
 	qmp->usb4_serdes = base + offs->usb4_serdes;
 	qmp->usb4_pcs = base + offs->usb4_pcs;
 
+	/*
+	 * The Glymur USB4 start-up sequence writes a separate DP producer/AUX
+	 * block that is shared between routers. Map it without claiming the
+	 * region so another instance can describe the same block.
+	 */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "usb4-dp-aux");
+	if (res) {
+		qmp->usb4_dp_aux = devm_ioremap(dev, res->start, resource_size(res));
+		if (!qmp->usb4_dp_aux)
+			return -ENOMEM;
+	}
+
 	ret = qmp_combo_clk_init(qmp);
 	if (ret)
 		return ret;
-- 
2.56.0

