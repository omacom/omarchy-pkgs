From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 8 Oct 2026 18:58:18 -0500
Subject: [PATCH] drm/msm/dp: skip eDP table rates that the source cannot drive

For eDP 1.4 sinks, msm_dp_panel_read_dpcd() takes the highest
SUPPORTED_LINK_RATES entry under the link-frequencies limit without
checking that the controller and its PHY can drive it. They only drive
the standard rates of 1.62, 2.7, 5.4 and 8.1 Gbps, so a sink whose table
ends in an intermediate rate (2.16, 2.43, 3.24 or 4.32 Gbps) is rejected
with "Illegal link rate" and stays dark. When training fails,
msm_dp_ctrl_link_rate_down_shift() can likewise step to an intermediate
table rate.

Keep only the table entries that the source drives, skipping the others
rather than stopping at them, and record them in ascending order with
their table index. Without usable table entries, record the standard
rates up to MAX_LINK_RATE instead. Train at the highest recorded rate,
as before, and step down through the recorded rates when training
fails, instead of walking the table index or the fixed
8.1/5.4/2.7/1.62 Gbps sequence. Whether LINK_RATE_SET or LINK_BW_SET
selects a table rate is decided as before.

With this change msm selects 2.7 Gbps for the Sharp LQ138P1JX61 panel of
the Microsoft Surface Laptop 8, whose table lists 1.62, 2.16, 2.43, 2.7
and 3.24 Gbps, instead of 3.24 Gbps. A MAX_LINK_RATE or LTTPR limit
that is not a standard rate now gives the highest standard rate below
it rather than "Illegal link rate".

Fixes: ed100aa239be ("drm/msm/dp: Enable support for eDP v1.4+ link rates table")
Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/gpu/drm/msm/dp/dp_ctrl.c  |  47 ++----
 drivers/gpu/drm/msm/dp/dp_link.h  |   7 +
 drivers/gpu/drm/msm/dp/dp_panel.c | 240 ++++++++++++++++++++----------
 3 files changed, 186 insertions(+), 108 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index f7f67a7b68a..9177ff76018 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -1508,41 +1508,21 @@ static int msm_dp_ctrl_link_train_1(struct msm_dp_ctrl_private *ctrl,
 
 static int msm_dp_ctrl_link_rate_down_shift(struct msm_dp_ctrl_private *ctrl)
 {
-	int ret = 0;
 	struct msm_dp_link_info *link_params = &ctrl->link->link_params;
+	unsigned int i = link_params->num_supported_rates;
 
-	if (link_params->use_rate_set) {
-		/* Step down the sink's rate table, which rate_set indexes */
-		if (link_params->rate_set) {
-			--link_params->rate_set;
-			link_params->rate = link_params->supported_rates[link_params->rate_set];
-		} else {
-			ret = -EINVAL;
-		}
-	} else {
-		switch (link_params->rate) {
-		case 810000:
-			link_params->rate = 540000;
-			break;
-		case 540000:
-			link_params->rate = 270000;
-			break;
-		case 270000:
-			link_params->rate = 162000;
-			break;
-		case 162000:
-		default:
-			ret = -EINVAL;
-			break;
+	/* Step down to the next rate that the sink and the source share */
+	while (i--) {
+		if (link_params->supported_rates[i] < link_params->rate) {
+			link_params->rate = link_params->supported_rates[i];
+			link_params->rate_set = link_params->supported_rate_sets[i];
+			drm_dbg_dp(ctrl->drm_dev, "new rate=0x%x\n",
+				   link_params->rate);
+			return 0;
 		}
 	}
 
-	if (!ret) {
-		drm_dbg_dp(ctrl->drm_dev, "new rate=0x%x\n",
-				link_params->rate);
-	}
-
-	return ret;
+	return -EINVAL;
 }
 
 static int msm_dp_ctrl_link_lane_down_shift(struct msm_dp_ctrl_private *ctrl,
@@ -2405,7 +2385,7 @@ int msm_dp_ctrl_on_link(struct msm_dp_ctrl *msm_dp_ctrl,
 			panel->link_info.num_lanes;
 		/*
 		 * The eDP 1.4 rate-set selection is computed into
-		 * panel->link_info, but every consumer reads link->link_params
+		 * panel->link_info, but link training reads link->link_params
 		 * -- without this copy use_rate_set can never be seen by
 		 * msm_dp_aux_link_configure(), and rate_set is always 0 in
 		 * msm_dp_ctrl_link_rate_down_shift().
@@ -2417,6 +2397,11 @@ int msm_dp_ctrl_on_link(struct msm_dp_ctrl *msm_dp_ctrl,
 		memcpy(ctrl->link->link_params.supported_rates,
 		       panel->link_info.supported_rates,
 		       sizeof(ctrl->link->link_params.supported_rates));
+		memcpy(ctrl->link->link_params.supported_rate_sets,
+		       panel->link_info.supported_rate_sets,
+		       sizeof(ctrl->link->link_params.supported_rate_sets));
+		ctrl->link->link_params.num_supported_rates =
+			panel->link_info.num_supported_rates;
 		if (panel->msm_dp_mode.out_fmt_is_yuv_420)
 			pixel_rate >>= 1;
 	}
diff --git a/drivers/gpu/drm/msm/dp/dp_link.h b/drivers/gpu/drm/msm/dp/dp_link.h
index 76125e9c07e..cc5e9163047 100644
--- a/drivers/gpu/drm/msm/dp/dp_link.h
+++ b/drivers/gpu/drm/msm/dp/dp_link.h
@@ -17,7 +17,14 @@
 struct msm_dp_link_info {
 	unsigned char revision;
 	unsigned int rate;
+	/*
+	 * The link rates that the sink and the source share, in ascending
+	 * order, each with its LINK_RATE_SET index for use_rate_set.
+	 * rate_set is the index of rate.
+	 */
 	unsigned int supported_rates[DP_MAX_SUPPORTED_RATES];
+	u8 supported_rate_sets[DP_MAX_SUPPORTED_RATES];
+	unsigned int num_supported_rates;
 	unsigned int rate_set;
 	bool use_rate_set;
 	unsigned int num_lanes;
diff --git a/drivers/gpu/drm/msm/dp/dp_panel.c b/drivers/gpu/drm/msm/dp/dp_panel.c
index 909695902e5..5adc151ba17 100644
--- a/drivers/gpu/drm/msm/dp/dp_panel.c
+++ b/drivers/gpu/drm/msm/dp/dp_panel.c
@@ -85,9 +85,168 @@ static void msm_dp_panel_read_psr_cap(struct msm_dp_panel_private *panel)
 	}
 }
 
+/*
+ * The controller and its PHYs drive only the standard link rates of 1.62,
+ * 2.7, 5.4 and 8.1 Gbps, not the eDP intermediate ones, and the board may
+ * limit them through link-frequencies.
+ */
+static bool msm_dp_panel_is_source_rate(const struct msm_dp_link *link, u32 rate)
+{
+	u8 bw_code = drm_dp_link_rate_to_bw_code(rate);
+
+	return rate <= link->max_dp_link_rate && is_link_rate_valid(bw_code) &&
+	       drm_dp_bw_code_to_link_rate(bw_code) == rate;
+}
+
+/*
+ * Read an eDP 1.4 sink's SUPPORTED_LINK_RATES table. Return the number of
+ * entries the source can use, stored in ascending order with their table
+ * index, or a negative error code. Entries the source cannot drive, such
+ * as the eDP intermediate rates, are skipped rather than taken as the end
+ * of the table.
+ */
+static int msm_dp_panel_read_rate_table(struct msm_dp_panel_private *panel,
+					u32 max_lttpr_rate, unsigned int *rates,
+					u8 *rate_sets)
+{
+	__le16 table[DP_MAX_SUPPORTED_RATES];
+	int i, j, n = 0;
+	int rc;
+
+	rc = drm_dp_dpcd_read_data(panel->aux, DP_SUPPORTED_LINK_RATES,
+				   table, sizeof(table));
+	if (rc)
+		return rc;
+
+	for (i = 0; i < ARRAY_SIZE(table); i++) {
+		/*
+		 * The value from the DPCD multiplied by 200 gives
+		 * the link rate in kHz. Divide by 10 to convert to
+		 * symbol rate, accounting for 8b/10b encoding.
+		 */
+		u32 rate = (le16_to_cpu(table[i]) * 200) / 10;
+
+		if (!rate)
+			break;
+
+		drm_dbg_dp(panel->drm_dev,
+			   "SUPPORTED_LINK_RATES[%d]: %d\n", i, rate);
+
+		/* Limit link rate from LTTPR capabilities, if any */
+		if (max_lttpr_rate && rate > max_lttpr_rate)
+			continue;
+
+		if (!msm_dp_panel_is_source_rate(panel->link, rate))
+			continue;
+
+		for (j = n; j > 0 && rates[j - 1] > rate; j--) {
+			rates[j] = rates[j - 1];
+			rate_sets[j] = rate_sets[j - 1];
+		}
+		rates[j] = rate;
+		rate_sets[j] = i;
+		n++;
+	}
+
+	return n;
+}
+
+/*
+ * Find the link rates that the sink and the source share, and the register
+ * that selects them: the usable entries of an eDP 1.4 sink's rate table if
+ * there are any, otherwise the standard rates up to MAX_LINK_RATE.
+ */
+static int msm_dp_panel_read_link_rates(struct msm_dp_panel_private *panel)
+{
+	static const u8 bw_codes[] = {
+		DP_LINK_BW_1_62, DP_LINK_BW_2_7, DP_LINK_BW_5_4, DP_LINK_BW_8_1,
+	};
+	struct msm_dp_link_info *link_info = &panel->msm_dp_panel.link_info;
+	const u8 *dpcd = panel->msm_dp_panel.dpcd;
+	struct msm_dp_link *link = panel->link;
+	unsigned int bw_rates[ARRAY_SIZE(bw_codes)];
+	unsigned int table_rates[DP_MAX_SUPPORTED_RATES];
+	u8 table_sets[DP_MAX_SUPPORTED_RATES];
+	unsigned int i, n_bw = 0, n_table = 0;
+	u32 max_rate, max_lttpr_rate;
+	u8 bw_set = 0;
+	int rc;
+
+	max_lttpr_rate = drm_dp_lttpr_max_link_rate(link->lttpr_common_caps);
+
+	/* LINK_BW_SET: the source's rates up to MAX_LINK_RATE and any LTTPR's */
+	max_rate = drm_dp_max_link_rate(dpcd);
+	if (max_lttpr_rate && max_lttpr_rate < max_rate)
+		max_rate = max_lttpr_rate;
+
+	for (i = 0; i < ARRAY_SIZE(bw_codes); i++) {
+		u32 rate = drm_dp_bw_code_to_link_rate(bw_codes[i]);
+
+		if (rate <= max_rate && msm_dp_panel_is_source_rate(link, rate))
+			bw_rates[n_bw++] = rate;
+	}
+
+	/* LINK_RATE_SET: the entries of an eDP 1.4 sink's rate table */
+	if (dpcd[DP_EDP_CONFIGURATION_CAP]) {
+		u8 edp_rev;
+
+		rc = drm_dp_dpcd_read_byte(panel->aux, DP_EDP_DPCD_REV, &edp_rev);
+		if (rc)
+			return rc;
+
+		drm_dbg_dp(panel->drm_dev, "edp_rev=0x%x\n", edp_rev);
+
+		if (edp_rev >= DP_EDP_14) {
+			rc = msm_dp_panel_read_rate_table(panel, max_lttpr_rate,
+							  table_rates, table_sets);
+			if (rc < 0)
+				return rc;
+
+			n_table = rc;
+
+			rc = drm_dp_dpcd_read_byte(panel->aux, DP_LINK_BW_SET, &bw_set);
+			if (rc)
+				return rc;
+		}
+	}
+
+	if (n_table) {
+		for (i = 0; i < n_table; i++) {
+			link_info->supported_rates[i] = table_rates[i];
+			link_info->supported_rate_sets[i] = table_sets[i];
+		}
+		link_info->num_supported_rates = n_table;
+
+		/* Only use LINK_RATE_SET if LINK_BW_SET hasn't already been written to */
+		link_info->use_rate_set = !bw_set;
+	} else {
+		for (i = 0; i < n_bw; i++)
+			link_info->supported_rates[i] = bw_rates[i];
+		link_info->num_supported_rates = n_bw;
+	}
+
+	for (i = 0; i < link_info->num_supported_rates; i++) {
+		unsigned int rate = link_info->supported_rates[i];
+
+		drm_dbg_dp(panel->drm_dev, "link rate %u: %s 0x%02x\n", rate,
+			   link_info->use_rate_set ? "LINK_RATE_SET" : "LINK_BW_SET",
+			   link_info->use_rate_set ? link_info->supported_rate_sets[i] :
+						     drm_dp_link_rate_to_bw_code(rate));
+	}
+
+	/* Start at the highest shared rate */
+	if (link_info->num_supported_rates) {
+		i = link_info->num_supported_rates - 1;
+		link_info->rate = link_info->supported_rates[i];
+		link_info->rate_set = link_info->supported_rate_sets[i];
+	}
+
+	return 0;
+}
+
 static int msm_dp_panel_read_dpcd(struct msm_dp_panel *msm_dp_panel)
 {
-	int rc, max_lttpr_lanes, max_lttpr_rate;
+	int rc, max_lttpr_lanes;
 	struct msm_dp_panel_private *panel;
 	struct msm_dp_link_info *link_info;
 	struct msm_dp_link *link;
@@ -114,82 +273,9 @@ static int msm_dp_panel_read_dpcd(struct msm_dp_panel *msm_dp_panel)
 		   link->max_dp_lanes, link->max_dp_link_rate);
 
 	max_lttpr_lanes = drm_dp_lttpr_max_lane_count(link->lttpr_common_caps);
-	max_lttpr_rate = drm_dp_lttpr_max_link_rate(link->lttpr_common_caps);
-
-	/* eDP sink */
-	if (msm_dp_panel->dpcd[DP_EDP_CONFIGURATION_CAP]) {
-		u8 edp_rev;
-
-		rc = drm_dp_dpcd_read_byte(panel->aux, DP_EDP_DPCD_REV, &edp_rev);
-		if (rc)
-			return rc;
-
-		drm_dbg_dp(panel->drm_dev, "edp_rev=0x%x\n", edp_rev);
-
-		/* For eDP v1.4+, parse the SUPPORTED_LINK_RATES table */
-		if (edp_rev >= DP_EDP_14) {
-			__le16 rates[DP_MAX_SUPPORTED_RATES];
-			u8 bw_set;
-			int i;
-
-			rc = drm_dp_dpcd_read_data(panel->aux, DP_SUPPORTED_LINK_RATES,
-						   rates, sizeof(rates));
-			if (rc)
-				return rc;
-
-			rc = drm_dp_dpcd_read_byte(panel->aux, DP_LINK_BW_SET, &bw_set);
-			if (rc)
-				return rc;
-
-			/* Find index of max supported link rate that does not exceed dtsi limits */
-			for (i = 0; i < ARRAY_SIZE(rates); i++) {
-				/*
-				 * The value from the DPCD multiplied by 200 gives
-				 * the link rate in kHz. Divide by 10 to convert to
-				 * symbol rate, accounting for 8b/10b encoding.
-				 */
-				u32 rate = (le16_to_cpu(rates[i]) * 200) / 10;
-
-				if (!rate)
-					break;
-
-				drm_dbg_dp(panel->drm_dev,
-					   "SUPPORTED_LINK_RATES[%d]: %d\n", i, rate);
-
-				/*
-				 * Limit link rate from link-frequencies of endpoint
-				 * property of dtsi
-				 */
-				if (rate > link->max_dp_link_rate)
-					break;
-
-				/* Limit link rate from LTTPR capabilities, if any */
-				if (max_lttpr_rate && rate > max_lttpr_rate)
-					break;
-
-				link_info->rate = rate;
-				link_info->supported_rates[i] = rate;
-				link_info->rate_set = i;
-			}
-
-			/* Only use LINK_RATE_SET if LINK_BW_SET hasn't already been written to */
-			if (!bw_set && link_info->rate)
-				link_info->use_rate_set = true;
-		}
-	}
-
-	/* Fall back on MAX_LINK_RATE/LINK_BW_SET (DP, eDP <= v1.3) */
-	if (!link_info->rate) {
-		link_info->rate = drm_dp_max_link_rate(dpcd);
-
-		/* Limit link rate from link-frequencies of endpoint property of dtsi */
-		if (link_info->rate > link->max_dp_link_rate)
-			link_info->rate = link->max_dp_link_rate;
-
-		/* Limit link rate from LTTPR capabilities, if any */
-		if (max_lttpr_rate && max_lttpr_rate < link_info->rate)
-			link_info->rate = max_lttpr_rate;
-	}
+	rc = msm_dp_panel_read_link_rates(panel);
+	if (rc)
+		return rc;
 
 	link_info->num_lanes = drm_dp_max_lane_count(dpcd);
 
-- 
