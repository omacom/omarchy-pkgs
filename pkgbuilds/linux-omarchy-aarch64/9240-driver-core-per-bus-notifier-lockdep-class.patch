From: Staticduo local integration
Subject: [PATCH] driver core: give each bus notifier its own lockdep class

Notifier callbacks on distinct buses can have independent locking orders.
Use a dynamic class per registered bus, retaining all lockdep checks.

--- a/drivers/base/base.h
+++ b/drivers/base/base.h
@@ -50,6 +50,9 @@
 	struct klist klist_devices;
 	struct klist klist_drivers;
 	struct blocking_notifier_head bus_notifier;
+#ifdef CONFIG_LOCKDEP
+	struct lock_class_key bus_notifier_key;
+#endif
 	unsigned int drivers_autoprobe:1;
 	const struct bus_type *bus;
 	struct device *dev_root;
--- a/drivers/base/bus.c
+++ b/drivers/base/bus.c
@@ -209,6 +209,9 @@
 {
 	struct subsys_private *priv = to_subsys_private(kobj);
 
+#ifdef CONFIG_LOCKDEP
+	lockdep_unregister_key(&priv->bus_notifier_key);
+#endif
 	lockdep_unregister_key(&priv->lock_key);
 	kfree(priv);
 }
@@ -952,6 +955,11 @@
 	priv->bus = bus;
 
 	BLOCKING_INIT_NOTIFIER_HEAD(&priv->bus_notifier);
+#ifdef CONFIG_LOCKDEP
+	/* Notifier callbacks on unrelated buses have independent lock orders. */
+	lockdep_register_key(&priv->bus_notifier_key);
+	lockdep_set_class(&priv->bus_notifier.rwsem, &priv->bus_notifier_key);
+#endif
 
 	bus_kobj = &priv->subsys.kobj;
 	retval = kobject_set_name(bus_kobj, "%s", bus->name);
@@ -1013,6 +1021,10 @@
 	/* Above kset_unregister() will kfree @priv */
 	priv = NULL;
 out:
+#ifdef CONFIG_LOCKDEP
+	if (priv)
+		lockdep_unregister_key(&priv->bus_notifier_key);
+#endif
 	kfree(priv);
 	return retval;
 }
