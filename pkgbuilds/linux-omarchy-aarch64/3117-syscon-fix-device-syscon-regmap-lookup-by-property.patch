From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Clay Stan <claystan97@gmail.com>
Date: Tue, 24 Nov 2026 12:17:00 +0800
Subject: [PATCH] mfd: syscon: fix device_syscon_regmap_lookup_by_property safety

device_syscon_regmap_lookup_by_property() leaked its fwnode reference,
dereferenced fwnode->dev without checking whether a platform device had
been created, and lacked static inline on its !CONFIG_MFD_SYSCON stub.

Look up the target on platform_bus_type, drop both firmware and device
references on every path, return -ENODEV for disabled firmware nodes and
-EPROBE_DEFER while an enabled syscon device has not yet bound, and mark
the header stub static inline.

Signed-off-by: Clay Stan <claystan97@gmail.com>
---
 drivers/mfd/syscon.c       | 21 ++++++++++++++-------
 include/linux/mfd/syscon.h |  3 ++-
 2 files changed, 16 insertions(+), 8 deletions(-)

diff --git a/drivers/mfd/syscon.c b/drivers/mfd/syscon.c
index f8b7b8e..ff26725 100644
--- a/drivers/mfd/syscon.c
+++ b/drivers/mfd/syscon.c
@@ -22,7 +22,6 @@
 #include <linux/reset.h>
 #include <linux/mfd/syscon.h>
 #include <linux/slab.h>
-#include <linux/acpi.h>
 #include <linux/property.h>
 
 static DEFINE_MUTEX(syscon_list_lock);
@@ -369,19 +368,27 @@ struct regmap *device_syscon_regmap_lookup_by_property(struct device *dev,
 						       const char *property)
 {
 	struct fwnode_handle *fwnode;
-	struct platform_device *pdev;
+	struct device *syscon_dev;
 	struct syscon *syscon;
 
 	fwnode = fwnode_find_reference(dev_fwnode(dev), property, 0);
 	if (IS_ERR_OR_NULL(fwnode))
 		return ERR_PTR(-ENODEV);
 
-	pdev = to_platform_device(fwnode->dev);
-	if (!pdev->dev.driver_data)
-		return ERR_PTR(-ENOENT);
-	syscon = platform_get_drvdata(pdev);
-	if (!syscon)
+	if (!fwnode_device_is_available(fwnode)) {
+		fwnode_handle_put(fwnode);
 		return ERR_PTR(-ENODEV);
+	}
+
+	syscon_dev = bus_find_device_by_fwnode(&platform_bus_type, fwnode);
+	fwnode_handle_put(fwnode);
+	if (!syscon_dev)
+		return ERR_PTR(-EPROBE_DEFER);
+
+	syscon = dev_get_drvdata(syscon_dev);
+	put_device(syscon_dev);
+	if (!syscon)
+		return ERR_PTR(-EPROBE_DEFER);
 
 	return syscon->regmap;
 }
diff --git a/include/linux/mfd/syscon.h b/include/linux/mfd/syscon.h
index 53f723c..092afc6 100644
--- a/include/linux/mfd/syscon.h
+++ b/include/linux/mfd/syscon.h
@@ -78,7 +78,8 @@ static inline int of_syscon_register_regmap(struct device_node *np,
 	return -EOPNOTSUPP;
 }
 
-struct regmap *device_syscon_regmap_lookup_by_property(struct device *dev,
+static inline struct regmap *device_syscon_regmap_lookup_by_property(
+					struct device *dev,
 					const char *property)
 {
 	return ERR_PTR(-ENOTSUPP);
