From 923fcd1bfb4488da5f0c232e1c62df0d45173a1c Mon Sep 17 00:00:00 2001
From: Konrad Dybcio <konrad.dybcio@oss.qualcomm.com>
Date: Thu, 10 Sep 2026 20:45:10 +0200
Subject: [PATCH] arm64: dts: qcom: glymur-asus-zenbook-a16: Add IR camera

The A16 features an Himax HM1092 IR camera sensor in the lid,
intended for use with face unlock applications. Wire it up.

Signed-off-by: Konrad Dybcio <konrad.dybcio@oss.qualcomm.com>
---
 .../qcom/glymur-asus-zenbook-a16-ux3607oa.dts | 65 +++++++++++++++++++
 1 file changed, 65 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts b/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
index c9580ab8cfafdb..c2ecabb3c85b53 100644
--- a/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
@@ -595,10 +595,21 @@
 	status = "okay";
 };
 
+&camss_csiphy0_inep {
+	data-lanes = <1>;
+};
+
 &camss_csiphy4_inep {
 	data-lanes = <1 2>;
 };
 
+&cci0 {
+	pinctrl-0 = <&cci0_0_default>;
+	pinctrl-1 = <&cci0_0_sleep>;
+
+	status = "okay";
+};
+
 &cci1 {
 	pinctrl-0 = <&cci1_1_default>;
 	pinctrl-1 = <&cci1_1_sleep>;
@@ -606,6 +617,39 @@
 	status = "okay";
 };
 
+&cci0_i2c0 {
+	camera@24 {
+		compatible = "himax,hm1092";
+		reg = <0x24>;
+
+		reset-gpios = <&tlmm 109 GPIO_ACTIVE_LOW>;
+
+		leds = <&privacy_led>;
+		led-names = "privacy";
+
+		clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		orientation = <MEDIA_ORIENTATION_FRONT>;
+
+		dvdd-supply = <&vreg_l4m>;
+		avdd-supply = <&vreg_l3m>;
+		dovdd-supply = <&vreg_l4m>;
+
+		pinctrl-0 = <&cam_mclk0_default>, <&cam_reset0_default>;
+		pinctrl-names = "default";
+
+		port {
+			hm1092_out_ep: endpoint {
+				data-lanes = <1>;
+				link-frequencies = /bits/ 64 <180000000>;
+				remote-endpoint = <&csiphy0_in_ep>;
+			};
+		};
+	};
+};
+
 &cci1_i2c1 {
 	camera@36 {
 		compatible = "ovti,ov02c10";
@@ -639,6 +683,20 @@
 	};
 };
 
+&csiphy0 {
+	vdda-0p9-supply = <&vreg_l1f_e1>;
+	vdda-1p2-supply = <&vreg_l4f_e1>;
+
+	status = "okay";
+};
+
+&csiphy0_in_ep {
+	bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+	clock-lanes = <0>;
+	data-lanes = <1>;
+	remote-endpoint = <&hm1092_out_ep>;
+};
+
 &csiphy4 {
 	vdda-0p9-supply = <&vreg_l1f_e1>;
 	vdda-1p2-supply = <&vreg_l4f_e1>;
@@ -1175,6 +1233,13 @@
 		bias-disable;
 	};
 
+	cam_reset0_default: cam-reset0-default-state {
+		pins = "gpio109";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	cam_indicator_en: cam-indicator-en-state {
 		pins = "gpio111";
 		function = "gpio";
