From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 8 Oct 2026 15:50:58 -0500
Subject: [PATCH] soc: qcom: pmic_glink_altmode: Request V2 notifications on
 Glymur

The PAN_EN request that enables pin-assignment notifications takes an
argument. Bits 0-2 select the notification version (1 for "V2") and
bits 3-6 an environment field (1 for an installed operating system).
The driver always sends 0, the legacy format.

With the legacy argument the Glymur firmware on the Surface Laptop 8
never reports the tunneling mux state, so a USB4 or Thunderbolt partner
is never entered and the port stays in USB3 or DisplayPort alternate
mode. With the V2 argument it reports the tunneling state and the TBT3
and USB4 notifications.

Send the V2 argument on every "qcom,glymur-pmic-glink" and keep 0 on the
other platforms. The value matches what the platform's Windows driver
sends on this laptop. The notifications that this argument produces are
decoded by the preceding change.

This changes the requested format on every Glymur board. It was tested
only on the Surface Laptop 8.

Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/soc/qcom/pmic_glink_altmode.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/qcom/pmic_glink_altmode.c b/drivers/soc/qcom/pmic_glink_altmode.c
index fa3b3fa2dd9..a9568b941eb 100644
--- a/drivers/soc/qcom/pmic_glink_altmode.c
+++ b/drivers/soc/qcom/pmic_glink_altmode.c
@@ -32,6 +32,14 @@
 #define ALTMODE_PAN_EN		0x10
 #define ALTMODE_PAN_ACK		0x11
 
+/*
+ * PAN_EN argument for Glymur: bits 0-2 select the pin-assignment notification
+ * version (1 = "V2"), bits 3-6 an environment field (1 for an installed
+ * operating system). With the legacy argument 0 the firmware of the Surface
+ * Laptop 8 never reports the tunneling mux state, so USB4 is never negotiated.
+ */
+#define ALTMODE_PAN_EN_V2_ARG	(1 | (1 << 3))
+
 struct usbc_write_req {
 	struct pmic_glink_hdr   hdr;
 	__le32 cmd;
@@ -129,6 +137,7 @@ struct pmic_glink_altmode {
 	struct device *dev;
 
 	unsigned int owner_id;
+	u32 pan_en_arg;
 
 	/* To synchronize WRITE_REQ acks */
 	struct mutex lock;
@@ -581,7 +590,9 @@ static void pmic_glink_altmode_enable_worker(struct work_struct *work)
 	struct pmic_glink_altmode *altmode = work_to_altmode(work);
 	int ret;
 
-	ret = pmic_glink_altmode_request(altmode, ALTMODE_PAN_EN, 0);
+	dev_dbg(altmode->dev, "enabling pin-assignment notifications, PAN_EN arg %#x\n",
+		altmode->pan_en_arg);
+	ret = pmic_glink_altmode_request(altmode, ALTMODE_PAN_EN, altmode->pan_en_arg);
 	if (ret)
 		dev_err(altmode->dev, "failed to request altmode notifications: %d\n", ret);
 }
@@ -622,6 +633,9 @@ static int pmic_glink_altmode_probe(struct auxiliary_device *adev,
 	else
 		altmode->owner_id = PMIC_GLINK_OWNER_USBC_PAN;
 
+	if (of_device_is_compatible(dev->parent->of_node, "qcom,glymur-pmic-glink"))
+		altmode->pan_en_arg = ALTMODE_PAN_EN_V2_ARG;
+
 	INIT_WORK(&altmode->enable_work, pmic_glink_altmode_enable_worker);
 	init_completion(&altmode->pan_ack);
 	mutex_init(&altmode->lock);
-- 
