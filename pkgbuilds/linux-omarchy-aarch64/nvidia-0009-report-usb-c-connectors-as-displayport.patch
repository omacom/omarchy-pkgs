From 33107b1447a4e8b4810ff47e2e34856d38ae727a Mon Sep 17 00:00:00 2001
From: Ryan Hughes <ryan@heyoodle.com>
Date: Mon, 12 Oct 2026 18:28:17 -0400
Subject: [PATCH] nvidia-drm: report USB-C connectors as DisplayPort

nvidia-drm has no DRM connector type for NVKMS_CONNECTOR_TYPE_USBC, so
every USB-C output (DisplayPort alt mode, or a USB4 DisplayPort tunnel
on the N1x) shows up as "Unknown". systemd-logind does not count an
Unknown connector as an external display, so a laptop with its lid
closed on a dock still suspends instead of staying up on the dock's
displays. Compositors also name the outputs Unknown-N.

USB-C connectors also skipped the content protection properties that DP
and HDMI connectors get, while the HDCP topology change handler updates
them for every connector, so each dock unplug warned in
drm_sysfs_connector_property_event() for each USB-C connector.

Report USB-C connectors as DisplayPort and give them the DP connector
properties (content protection, DP colorspace and HDR metadata).
---
 kernel-open/nvidia-drm/nvidia-drm-connector.c | 4 +++-
 kernel-open/nvidia-drm/nvidia-drm-utils.c     | 3 +++
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index c830c33..dacc5da 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -937,6 +937,7 @@ nv_drm_connector_new(struct drm_device *dev,
 #ifdef NV_DRM_SUPPORT_CONTENT_PROTECTION_PROPERTY
     /* attach content protection properties */
     if ((nv_connector->type == NVKMS_CONNECTOR_TYPE_DP) ||
+        (nv_connector->type == NVKMS_CONNECTOR_TYPE_USBC) ||
         (nv_connector->type == NVKMS_CONNECTOR_TYPE_HDMI)) {
         ret = drm_connector_attach_content_protection_property(&nv_connector->base, true);
         if (ret != 0) {
@@ -986,7 +987,8 @@ nv_drm_connector_new(struct drm_device *dev,
                                        nv_dev->nv_connector_allm_mode_property,
                                        NV_DRM_ALLM_MODE_DISABLED);
         }
-    } else if (nv_connector->type == NVKMS_CONNECTOR_TYPE_DP) {
+    } else if ((nv_connector->type == NVKMS_CONNECTOR_TYPE_DP) ||
+               (nv_connector->type == NVKMS_CONNECTOR_TYPE_USBC)) {
 #if defined(NV_DRM_MODE_CREATE_DP_COLORSPACE_PROPERTY_HAS_SUPPORTED_COLORSPACES_ARG)
         if (drm_mode_create_dp_colorspace_property(
                 &nv_connector->base,
diff --git a/kernel-open/nvidia-drm/nvidia-drm-utils.c b/kernel-open/nvidia-drm/nvidia-drm-utils.c
index b14947f..12ae4a0 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-utils.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-utils.c
@@ -99,6 +99,9 @@ int nvkms_connector_type_to_drm_connector_type(NvKmsConnectorType type,
             return DRM_MODE_CONNECTOR_DSI;
         case NVKMS_CONNECTOR_TYPE_DP_SERIALIZER:
             return DRM_MODE_CONNECTOR_DisplayPort;
+        /* USB-C connectors carry DisplayPort (alt mode or a USB4 tunnel). */
+        case NVKMS_CONNECTOR_TYPE_USBC:
+            return DRM_MODE_CONNECTOR_DisplayPort;
     }
 }
 
