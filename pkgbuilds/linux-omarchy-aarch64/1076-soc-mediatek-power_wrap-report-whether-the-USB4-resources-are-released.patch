From e8da759b3c4170030c01cc12edc50ae9925d1424 Mon Sep 17 00:00:00 2001
From: Ryan Hughes <ryan@heyoodle.com>
Date: Fri, 2 Oct 2026 20:15:51 -0400
Subject: [PATCH 1076/1078] soc: mediatek: power_wrap: report whether the USB4
 resources are released

Once the USB4 resources are released, the SSPM stops answering device
requests for the USB4 host routers: a probe or D0 request for one times
out, and about a minute later the SoC resets. A USB4 host router driver
has to know before it sends anything.

Add mtk_pwrap_usb4_released(), true once the release is armed. power_wrap
is built in and arms the release at probe, so the answer is settled by
the time a USB4 host router driver can load.
---
 drivers/soc/mediatek/power_wrap/power_wrap.c | 24 ++++++++++++++++++++
 include/linux/soc/mediatek/mtk-pwrap.h       |  6 +++++
 2 files changed, 30 insertions(+)

diff --git a/drivers/soc/mediatek/power_wrap/power_wrap.c b/drivers/soc/mediatek/power_wrap/power_wrap.c
index 50b1858aad..33445cdf4f 100644
--- a/drivers/soc/mediatek/power_wrap/power_wrap.c
+++ b/drivers/soc/mediatek/power_wrap/power_wrap.c
@@ -127,6 +127,7 @@ static struct device *pwrap_usb4_early_bound[PWRAP_USB4_MAX_XHCI];
 static unsigned int pwrap_usb4_nearly;
 static bool pwrap_usb4_tracking;
 static bool pwrap_usb4_done;
+static bool pwrap_usb4_armed;
 
 /*
  * The release suits systems that leave USB4 unused. A system running a USB4
@@ -644,6 +645,27 @@ static void pwrap_write_bestperf_flag(struct device *dev)
 	iounmap(vaddr);
 }
 
+/**
+ * mtk_pwrap_usb4_released() - Whether the USB4 resources are released this boot
+ *
+ * Once the resources are released, the SSPM no longer answers device requests
+ * for the USB4 host routers and stops responding altogether, so a USB4 host
+ * router driver must not send any.
+ *
+ * Return: %true if the release has been armed or issued.
+ */
+bool mtk_pwrap_usb4_released(void)
+{
+	bool armed;
+
+	mutex_lock(&pwrap_usb4_lock);
+	armed = pwrap_usb4_armed;
+	mutex_unlock(&pwrap_usb4_lock);
+
+	return armed;
+}
+EXPORT_SYMBOL_GPL(mtk_pwrap_usb4_released);
+
 /*
  * pwrap_release_usb4_resources() - release USB4 hardware resources via SSPM
  *
@@ -803,6 +825,8 @@ static void pwrap_usb4_arm_release(struct device *dev)
 	pwrap_usb4_dev = dev;
 	pwrap_usb4_nb.notifier_call = pwrap_usb4_bus_notify;
 	ret = bus_register_notifier(&platform_bus_type, &pwrap_usb4_nb);
+	if (!ret)
+		pwrap_usb4_armed = true;
 	mutex_unlock(&pwrap_usb4_lock);
 	if (ret) {
 		dev_err(dev, "USB4: cannot register bus notifier (%d), release not armed\n",
diff --git a/include/linux/soc/mediatek/mtk-pwrap.h b/include/linux/soc/mediatek/mtk-pwrap.h
index 16d98e387c..a655c71444 100644
--- a/include/linux/soc/mediatek/mtk-pwrap.h
+++ b/include/linux/soc/mediatek/mtk-pwrap.h
@@ -76,6 +76,7 @@ int mtk_pwrap_dev_resume(void *dev_ctrl, u8 sys_trans);
 int mtk_pwrap_com_idle(void *dev_ctrl, u8 com_idx);
 int mtk_pwrap_com_active(void *dev_ctrl, u8 com_idx);
 void *mtk_pwrap_dev_probe(const char *acpi_path);
+bool mtk_pwrap_usb4_released(void);
 #else
 static inline int mtk_send_power_control_req(struct _power_cntrl_request *pwrctlreq)
 {
@@ -116,6 +117,11 @@ static inline void *mtk_pwrap_dev_probe(const char *acpi_path)
 {
 	return NULL;
 }
+
+static inline bool mtk_pwrap_usb4_released(void)
+{
+	return false;
+}
 #endif /* CONFIG_MTK_POWER_WRAP */
 
 #endif
