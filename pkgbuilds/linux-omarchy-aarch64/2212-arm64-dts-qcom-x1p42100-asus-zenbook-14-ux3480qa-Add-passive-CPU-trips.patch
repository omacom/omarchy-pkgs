From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emir Beganovic <beganovic.emir@gmail.com>
Date: Tue, 27 Oct 2026 08:36:20 +0100
Subject: [PATCH] arm64: dts: qcom: x1p42100-asus-zenbook-14-ux3480qa: Add
 passive CPU trips

The CPU thermal zones carry only hamoa.dtsi's critical trip at 115 C,
and nothing slows the CPUs before it. Under openssl speed on all eight
cores at 2.96 GHz on the charger, the hottest CPU zone reached 88 C
after 300 s and was still rising by about 1 C every 30 s, with the fan
already at its maximum (3360 RPM) and nothing throttling yet.

Add a passive trip at 85 C to each of the 20 CPU zones, mapped to its
cluster's cpufreq cooling device (cpu0 for CPUs 0-3, cpu4 for CPUs
4-7), with the 200 ms passive polling hamoa.dtsi's GPU zones use, so
step_wise lowers a cluster's clock one step at a time while its zones
stay above 85 C and raises it again below 83 C.

Signed-off-by: Emir Beganovic <beganovic.emir@gmail.com>
---
 .../x1p42100-asus-zenbook-14-ux3480qa.dts     | 47 +++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1p42100-asus-zenbook-14-ux3480qa.dts b/arch/arm64/boot/dts/qcom/x1p42100-asus-zenbook-14-ux3480qa.dts
index d4868f8..d5041ee 100644
--- a/arch/arm64/boot/dts/qcom/x1p42100-asus-zenbook-14-ux3480qa.dts
+++ b/arch/arm64/boot/dts/qcom/x1p42100-asus-zenbook-14-ux3480qa.dts
@@ -313,3 +313,50 @@
 
 	status = "okay";
 };
+
+/*
+ * The CPU zones carry only hamoa.dtsi's critical trip at 115 C, and
+ * nothing slows the CPUs before that: under a sustained all-core load at
+ * 2.96 GHz they pass 88 C with the fan at its maximum. Throttle each
+ * cluster through its cpufreq cooling device from 85 C instead.
+ */
+#define CPU_ALERT(zone, alert, cpu)					\
+&{/thermal-zones/zone-thermal} {					\
+	polling-delay-passive = <200>;					\
+									\
+	trips {								\
+		alert: trip-point0 {					\
+			temperature = <85000>;				\
+			hysteresis = <2000>;				\
+			type = "passive";				\
+		};							\
+	};								\
+									\
+	cooling-maps {							\
+		map0 {							\
+			trip = <&alert>;				\
+			cooling-device = <&cpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>; \
+		};							\
+	};								\
+}
+
+CPU_ALERT(cpu0-0-top, cpu0_0_top_alert, cpu0);
+CPU_ALERT(cpu0-0-btm, cpu0_0_btm_alert, cpu0);
+CPU_ALERT(cpu0-1-top, cpu0_1_top_alert, cpu0);
+CPU_ALERT(cpu0-1-btm, cpu0_1_btm_alert, cpu0);
+CPU_ALERT(cpu0-2-top, cpu0_2_top_alert, cpu0);
+CPU_ALERT(cpu0-2-btm, cpu0_2_btm_alert, cpu0);
+CPU_ALERT(cpu0-3-top, cpu0_3_top_alert, cpu0);
+CPU_ALERT(cpu0-3-btm, cpu0_3_btm_alert, cpu0);
+CPU_ALERT(cpuss0-top, cpuss0_top_alert, cpu0);
+CPU_ALERT(cpuss0-btm, cpuss0_btm_alert, cpu0);
+CPU_ALERT(cpu1-0-top, cpu1_0_top_alert, cpu4);
+CPU_ALERT(cpu1-0-btm, cpu1_0_btm_alert, cpu4);
+CPU_ALERT(cpu1-1-top, cpu1_1_top_alert, cpu4);
+CPU_ALERT(cpu1-1-btm, cpu1_1_btm_alert, cpu4);
+CPU_ALERT(cpu1-2-top, cpu1_2_top_alert, cpu4);
+CPU_ALERT(cpu1-2-btm, cpu1_2_btm_alert, cpu4);
+CPU_ALERT(cpu1-3-top, cpu1_3_top_alert, cpu4);
+CPU_ALERT(cpu1-3-btm, cpu1_3_btm_alert, cpu4);
+CPU_ALERT(cpuss1-top, cpuss1_top_alert, cpu4);
+CPU_ALERT(cpuss1-btm, cpuss1_btm_alert, cpu4);
