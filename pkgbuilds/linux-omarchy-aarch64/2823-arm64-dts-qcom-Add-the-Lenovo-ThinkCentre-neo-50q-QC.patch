From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Mon, 9 Nov 2026 23:30:00 +0100
Subject: [PATCH] arm64: dts: qcom: Add the Lenovo ThinkCentre neo 50q QC

The ThinkCentre neo 50q QC (machine type 13C8, board 3393) is a mini PC
on the Snapdragon X X1-26-100. Its DSDT is the IdeaCentre Mini
01Q8X10's apart from the first USB controller's port, one more
DisplayPort hot-plug interrupt, the EC keyboard device and the thermal
trip points. The two machines' PEP power tables and device resources
are the same, so the tree builds on
x1-lenovo-ideacentre-mini-01q8x10.dtsi.

What differs, from this machine's DSDT and the devices Windows
enumerates on it:

- The first USB controller has no Type-C port. The UCSI device is off,
  the USB4 host router is gone, the controller's SuperSpeed port is
  marked not connectable and it is flagged as high-speed only. So the
  pmic-glink connector, the retimer and the retimer's supplies are
  turned off, and usb_1_ss0 runs as a high-speed host.
- That controller's QMP PHY drives a third DisplayPort output with fixed
  lanes, whose hot-plug detect is TLMM 122. It is the rear port Lenovo
  fits as an option. Describe it as a DisplayPort connector on mdss_dp0,
  with the lane order of the other two outputs.
- The Wi-Fi and Bluetooth card is a WCN6855 (17cb:1103), Lenovo's
  NFA765A, not a WCN7850.
- The ADSP, CDSP, GPU and video firmware are this model's, under
  qcom/x1p42100/LENOVO/13C8/.

Lenovo specifies the DisplayPort connectors for HBR2, so limit the two
DisplayPort outputs to that rate.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 arch/arm64/boot/dts/qcom/Makefile             |   2 +
 .../x126100-lenovo-thinkcentre-neo-50q-qc.dts | 238 ++++++++++++++++++
 2 files changed, 240 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/x126100-lenovo-thinkcentre-neo-50q-qc.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 550669b..ed3dab0 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -437,6 +437,8 @@ x126100-asus-vivobook-16-el2-dtbs := x126100-asus-vivobook-16.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x126100-asus-vivobook-16.dtb x126100-asus-vivobook-16-el2.dtb
 x126100-lenovo-ideapad-slim3-el2-dtbs := x126100-lenovo-ideapad-slim3.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x126100-lenovo-ideapad-slim3.dtb x126100-lenovo-ideapad-slim3-el2.dtb
+x126100-lenovo-thinkcentre-neo-50q-qc-el2-dtbs := x126100-lenovo-thinkcentre-neo-50q-qc.dtb x1-el2.dtbo
+dtb-$(CONFIG_ARCH_QCOM)	+= x126100-lenovo-thinkcentre-neo-50q-qc.dtb x126100-lenovo-thinkcentre-neo-50q-qc-el2.dtb
 x1e001de-devkit-el2-dtbs	:= x1e001de-devkit.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x1e001de-devkit.dtb x1e001de-devkit-el2.dtb
 x1e78100-acer-sfa14-11-el2-dtbs	:= x1e78100-acer-sfa14-11.dtb x1-el2.dtbo
diff --git a/arch/arm64/boot/dts/qcom/x126100-lenovo-thinkcentre-neo-50q-qc.dts b/arch/arm64/boot/dts/qcom/x126100-lenovo-thinkcentre-neo-50q-qc.dts
new file mode 100644
index 0000000..c85593a
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/x126100-lenovo-thinkcentre-neo-50q-qc.dts
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Lenovo ThinkCentre neo 50q QC (13C8), Snapdragon X X1-26-100 (Purwa)
+ */
+
+/dts-v1/;
+
+#include "purwa.dtsi"
+#include "x1-lenovo-ideacentre-mini-01q8x10.dtsi"
+
+/delete-node/ &pmc8380_6;
+/delete-node/ &pmc8380_6_thermal;
+/delete-node/ &pmc8380_6_die_temp;
+
+/ {
+	model = "Lenovo ThinkCentre neo 50q QC";
+	compatible = "lenovo,thinkcentre-neo-50q-qc", "qcom,x126100", "qcom,x1p42100";
+
+	/delete-node/ regulator-wifi-1v8;
+	/delete-node/ wcn7850-pmu;
+
+	/* Optional rear port */
+	dp-connector-1 {
+		compatible = "dp-connector";
+		type = "full-size";
+
+		pinctrl-0 = <&usb0_dp_hot_plug_detect>;
+		pinctrl-names = "default";
+
+		port {
+			dp_port1_in: endpoint {
+				remote-endpoint = <&usb_1_ss0_qmpphy_out_dp>;
+			};
+		};
+	};
+
+	pmic-glink {
+		status = "disabled";
+	};
+
+	vreg_wcn_1p9: regulator-wcn-1p9 {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VREG_WCN_1P9";
+		regulator-min-microvolt = <1900000>;
+		regulator-max-microvolt = <1900000>;
+
+		vin-supply = <&vreg_wifi_3v3>;
+	};
+
+	wcn6855-pmu {
+		compatible = "qcom,wcn6855-pmu";
+
+		vddaon-supply = <&vreg_wcn_0p95>;
+		vddio-supply = <&vreg_wcn_1p9>;
+		vddpcie1p3-supply = <&vreg_wcn_1p9>;
+		vddpcie1p9-supply = <&vreg_wcn_1p9>;
+		vddpmu-supply = <&vreg_wcn_0p95>;
+		vddpmucx-supply = <&vreg_wcn_0p95>;
+		vddpmumx-supply = <&vreg_wcn_0p95>;
+		vddrfa0p95-supply = <&vreg_wcn_0p95>;
+		vddrfa1p3-supply = <&vreg_wcn_1p9>;
+		vddrfa1p9-supply = <&vreg_wcn_1p9>;
+
+		wlan-enable-gpios = <&tlmm 117 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&tlmm 116 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-0 = <&wcn_wlan_bt_en>;
+		pinctrl-names = "default";
+
+		regulators {
+			vreg_pmu_rfa_cmn_0p8: ldo0 {
+				regulator-name = "vreg_pmu_rfa_cmn_0p8";
+			};
+
+			vreg_pmu_aon_0p8: ldo1 {
+				regulator-name = "vreg_pmu_aon_0p8";
+			};
+
+			vreg_pmu_wlcx_0p8: ldo2 {
+				regulator-name = "vreg_pmu_wlcx_0p8";
+			};
+
+			vreg_pmu_wlmx_0p8: ldo3 {
+				regulator-name = "vreg_pmu_wlmx_0p8";
+			};
+
+			vreg_pmu_btcmx_0p8: ldo4 {
+				regulator-name = "vreg_pmu_btcmx_0p8";
+			};
+
+			vreg_pmu_pcie_1p8: ldo5 {
+				regulator-name = "vreg_pmu_pcie_1p8";
+			};
+
+			vreg_pmu_pcie_0p9: ldo6 {
+				regulator-name = "vreg_pmu_pcie_0p9";
+			};
+
+			vreg_pmu_rfa_0p8: ldo7 {
+				regulator-name = "vreg_pmu_rfa_0p8";
+			};
+
+			vreg_pmu_rfa_1p2: ldo8 {
+				regulator-name = "vreg_pmu_rfa_1p2";
+			};
+
+			vreg_pmu_rfa_1p7: ldo9 {
+				regulator-name = "vreg_pmu_rfa_1p7";
+			};
+		};
+	};
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/x1p42100/LENOVO/13C8/qcdxkmsucpurwa.mbn";
+};
+
+&i2c3 {
+	status = "disabled";
+};
+
+&iris {
+	firmware-name = "qcom/x1p42100/LENOVO/13C8/qcvss8380_pa.mbn";
+
+	status = "okay";
+};
+
+&mdss_dp0_out {
+	link-frequencies = /bits/ 64 <1620000000 2700000000 5400000000>;
+};
+
+&mdss_dp1_out {
+	link-frequencies = /bits/ 64 <1620000000 2700000000 5400000000>;
+};
+
+&pcie4_port0 {
+	/delete-node/ wifi@0;
+
+	wifi@0 {
+		compatible = "pci17cb,1103";
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+
+		vddaon-supply = <&vreg_pmu_aon_0p8>;
+		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
+		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p8-supply = <&vreg_pmu_rfa_1p7>;
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn_0p8>;
+		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+		vddwlmx-supply = <&vreg_pmu_wlmx_0p8>;
+	};
+};
+
+&remoteproc_adsp {
+	firmware-name = "qcom/x1p42100/LENOVO/13C8/qcadsp8380.mbn",
+			"qcom/x1p42100/LENOVO/13C8/adsp_dtbs.elf";
+
+	status = "okay";
+};
+
+&remoteproc_cdsp {
+	firmware-name = "qcom/x1p42100/LENOVO/13C8/qccdsp8380.mbn",
+			"qcom/x1p42100/LENOVO/13C8/cdsp_dtbs.elf";
+
+	status = "okay";
+};
+
+&tlmm {
+	usb0_dp_hot_plug_detect: usb0-dp-hot-plug-detect-state {
+		pins = "gpio122";
+		function = "usb0_dp";
+		bias-disable;
+	};
+};
+
+&uart14 {
+	/delete-node/ bluetooth;
+
+	bluetooth {
+		compatible = "qcom,wcn6855-bt";
+		max-speed = <3200000>;
+
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn_0p8>;
+		vddaon-supply = <&vreg_pmu_aon_0p8>;
+		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+		vddwlmx-supply = <&vreg_pmu_wlmx_0p8>;
+		vddbtcmx-supply = <&vreg_pmu_btcmx_0p8>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p7-supply = <&vreg_pmu_rfa_1p7>;
+	};
+};
+
+&usb0_retimer_in {
+	/delete-property/ remote-endpoint;
+};
+
+&usb_1_ss0 {
+	maximum-speed = "high-speed";
+	phys = <&usb_1_ss0_hsphy>;
+	phy-names = "usb2-phy";
+	qcom,select-utmi-as-pipe-clk;
+};
+
+&usb_1_ss0_qmpphy {
+	/delete-property/ mode-switch;
+	/delete-property/ orientation-switch;
+
+	ports {
+		port@0 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			/delete-node/ endpoint;
+
+			usb_1_ss0_qmpphy_out_dp: endpoint@0 {
+				reg = <0>;
+
+				data-lanes = <3 2 1 0>;
+				remote-endpoint = <&dp_port1_in>;
+			};
+		};
+	};
+};
+
+&vreg_v0p9 {
+	status = "disabled";
+};
+
+&vreg_vdd1v8 {
+	status = "disabled";
+};
+
+&vreg_vdd33_rtmr {
+	status = "disabled";
+};
-- 
2.47.3

