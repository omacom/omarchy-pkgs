 x1p42100-asus-zenbook-a14-el2-dtbs	:= x1p42100-asus-zenbook-a14.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x1p42100-asus-zenbook-a14.dtb x1p42100-asus-zenbook-a14-el2.dtb
diff --git a/arch/arm64/boot/dts/qcom/x1p42100-asus-vivobook-s14.dts b/arch/arm64/boot/dts/qcom/x1p42100-asus-vivobook-s14.dts
new file mode 100644
