--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.h
@@ -36,6 +36,7 @@ struct dpu_hw_intf_timing_params {
 	bool wide_bus_en;
 	bool compression_en;
 	u32 dce_bytes_per_line;
+	u32 extra_dto_cycles;	/* DP: data clocks per line, from zero */
 };
 
 struct dpu_hw_intf_prog_fetch {
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_pingpong.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_pingpong.c
index 138071be564..3dba895c1c3 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_pingpong.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_pingpong.c
@@ -272,6 +272,19 @@ static void dpu_hw_pp_dsc_disable(struct dpu_hw_pingpong *pp)
 	DPU_REG_WRITE(c, PP_DSC_MODE, 0);
 }
 
+static void dpu_hw_pp_setup_dsc_swap(struct dpu_hw_pingpong *pp, bool enable)
+{
+	struct dpu_hw_blk_reg_map *pp_c = &pp->hw;
+	int data;
+
+	data = DPU_REG_READ(pp_c, PP_DCE_DATA_OUT_SWAP);
+	if (enable)
+		data |= BIT(18); /* endian flip */
+	else
+		data &= ~BIT(18);
+	DPU_REG_WRITE(pp_c, PP_DCE_DATA_OUT_SWAP, data);
+}
+
 static int dpu_hw_pp_setup_dsc(struct dpu_hw_pingpong *pp)
 {
 	struct dpu_hw_blk_reg_map *pp_c = &pp->hw;
@@ -323,6 +336,8 @@ struct dpu_hw_pingpong *dpu_hw_pingpong_init(struct drm_device *dev,
 		c->ops.setup_dsc = dpu_hw_pp_setup_dsc;
 		c->ops.enable_dsc = dpu_hw_pp_dsc_enable;
 		c->ops.disable_dsc = dpu_hw_pp_dsc_disable;
+	} else {
+		c->ops.setup_dsc_swap = dpu_hw_pp_setup_dsc_swap;
 	}
 
 	if (mdss_rev->core_major_ver >= 3)
