+/*
+ * Slices per line by peak pixel rate, from Qualcomm's downstream DP driver.
+ * The DSC decoder throughput and the source-side merge topology further
+ * constrain the choice below.
+ */
+struct msm_dp_dsc_slices_per_line {
+	u32 min_ppr;
+	u32 max_ppr;
+	u8 num_slices;
+};
+
+static const struct msm_dp_dsc_slices_per_line msm_dp_dsc_slice_tbl[] = {
+	{ 0,    340,  1  },
+	{ 340,  680,  2  },
+	{ 680,  1360, 4  },
+	{ 1360, 3200, 8  },
+	{ 3200, 4800, 12 },
+	{ 4800, 6400, 16 },
+	{ 6400, 8000, 20 },
+	{ 8000, 9600, 24 },
+};
+
+/*
+ * Extra pixel clocks a line needs so that the data throttle (DTO) delivers
+ * every compressed byte, as in Qualcomm's downstream DisplayPort driver.
+ */
+static u32 msm_dp_panel_dsc_extra_pclk(u32 line_width, u32 dto_n, u32 dto_d,
+				       u32 ack_required)
+{
+	u32 last_few_pclk, last_few_pclk_required = 0;
+	int last_few_ack_required, accum_ack = 0;
+	u32 remainder, start;
+
+	/* pixel clocks left outside of the complete DTO set */
+	last_few_pclk = line_width % dto_d;
+
+	last_few_ack_required = ack_required -
+		(int)div_u64((u64)line_width * dto_n, dto_d);
+
+	/* how many more pixel clocks accommodate the last few acks */
+	remainder = dto_n;
+	while (accum_ack < last_few_ack_required) {
+		last_few_pclk_required++;
+
+		if (remainder >= dto_n)
+			start = remainder;
+		else
+			start = remainder + dto_d;
+
+		remainder = start - dto_n;
+		if (remainder < dto_n)
+			accum_ack++;
+	}
+
+	if (last_few_pclk < last_few_pclk_required)
+		return last_few_pclk_required - last_few_pclk;
+
+	return 0;
+}
+
+static void msm_dp_panel_dsc_params_calc(const struct drm_dsc_config *dsc,
+					 struct msm_dp_dsc_params *params)
+{
+	u32 total_bytes = dsc->slice_chunk_size * dsc->slice_count;
+	u32 pclk_per_line;
+
+	params->slice_per_pkt = dsc->slice_count;
+	params->bytes_per_pkt = dsc->slice_chunk_size;
+	params->eol_byte_num = (3 - total_bytes % 3) % 3;
+	params->tgt_bpp = MSM_DP_DSC_TGT_BPP;
+	params->compress_ratio = MSM_DP_DSC_SRC_BPP * 100 / MSM_DP_DSC_TGT_BPP;
+	/* 24 bpp source to 8 bpp compressed: one data clock in three */
+	params->dto_n = 1;
+	params->dto_d = 3;
+	params->pclk_factor = 2;
+
+	/*
+	 * The interface runs in wide bus mode, moving 6 compressed bytes per
+	 * pixel clock; the DTO counts the data clocks per line from zero.
+	 */
+	pclk_per_line = DIV_ROUND_UP(total_bytes, 6);
+	params->extra_width = msm_dp_panel_dsc_extra_pclk(dsc->pic_width / 2,
+							  params->dto_n,
+							  params->dto_d,
+							  pclk_per_line);
+	params->pclk_per_line = pclk_per_line - 1;
+}
+
+/**
+ * msm_dp_panel_dsc_prepare - build a DSC configuration for a mode
+ * @msm_dp_panel: DP panel
+ * @mode: display mode to compress
+ * @min_slices: slice count granularity required by the source topology
+ * @dsc: DSC configuration to fill in
+ * @params: DP controller stream parameters to fill in
+ *
+ * Returns 0 when the sink can decode the mode as 8 bpc RGB compressed to
+ * 8 bpp, or a negative error code.
+ */
+int msm_dp_panel_dsc_prepare(struct msm_dp_panel *msm_dp_panel,
+			     const struct drm_display_mode *mode,
+			     unsigned int min_slices,
+			     struct drm_dsc_config *dsc,
+			     struct msm_dp_dsc_params *params)
+{
+	struct msm_dp_panel_private *panel;
+	const u8 *dsc_dpcd = msm_dp_panel->dsc_dpcd;
+	u32 max_slice_width, slice_mask, ppr;
+	u32 slices = 0, slice_width = 0;
+	int max_throughput, ret, i;
+	u8 version, minor;
+
+	panel = container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
+
+	if (!msm_dp_panel->dsc_capable)
+		return -EOPNOTSUPP;
+
+	version = dsc_dpcd[DP_DSC_REV - DP_DSC_SUPPORT];
+	minor = version >> 4;
+	if ((version & 0xf) != 1 || (minor != 1 && minor != 2)) {
+		drm_dbg_dp(panel->drm_dev, "unsupported sink DSC version 0x%02x\n",
+			   version);
+		return -EOPNOTSUPP;
+	}
+
+	if (!(dsc_dpcd[DP_DSC_DEC_COLOR_DEPTH_CAP - DP_DSC_SUPPORT] & DP_DSC_8_BPC) ||
+	    !(dsc_dpcd[DP_DSC_DEC_COLOR_FORMAT_CAP - DP_DSC_SUPPORT] & DP_DSC_RGB)) {
+		drm_dbg_dp(panel->drm_dev, "sink does not decode 8 bpc RGB DSC\n");
+		return -EOPNOTSUPP;
+	}
+
+	if (drm_dp_dsc_sink_line_buf_depth(dsc_dpcd) < 9) {
+		drm_dbg_dp(panel->drm_dev, "sink DSC line buffer too shallow\n");
+		return -EOPNOTSUPP;
+	}
+
+	max_slice_width = drm_dp_dsc_sink_max_slice_width(dsc_dpcd);
+	slice_mask = drm_dp_dsc_sink_slice_count_mask(dsc_dpcd, false);
+	max_throughput = drm_dp_dsc_sink_max_slice_throughput(dsc_dpcd,
+							      mode->clock, true);
+	ppr = mode->clock / 1000;
+
+	for (i = 0; i < ARRAY_SIZE(msm_dp_dsc_slice_tbl); i++)
+		if (ppr > msm_dp_dsc_slice_tbl[i].min_ppr &&
+		    ppr <= msm_dp_dsc_slice_tbl[i].max_ppr)
+			break;
+
+	for (; i < ARRAY_SIZE(msm_dp_dsc_slice_tbl); i++) {
+		slices = msm_dp_dsc_slice_tbl[i].num_slices;
+
+		if (slices < min_slices || slices % min_slices)
+			continue;
+		if (mode->hdisplay % slices)
+			continue;
+		slice_width = mode->hdisplay / slices;
+		if (slice_width > max_slice_width)
+			continue;
+		if (mode->clock / slices > max_throughput)
+			continue;
+		if (!(slice_mask & drm_dp_dsc_slice_count_to_mask(slices)))
+			continue;
+		break;
+	}
+
+	if (i == ARRAY_SIZE(msm_dp_dsc_slice_tbl)) {
+		drm_dbg_dp(panel->drm_dev,
+			   "no DSC slice layout for %dx%d@%d (max slice width %u, throughput %d, mask 0x%x)\n",
+			   mode->hdisplay, mode->vdisplay, mode->clock,
+			   max_slice_width, max_throughput, slice_mask);
+		return -EINVAL;
+	}
+
+	memset(dsc, 0, sizeof(*dsc));
+	dsc->dsc_version_major = 1;
+	dsc->dsc_version_minor = minor;
+	dsc->pic_width = mode->hdisplay;
+	dsc->pic_height = mode->vdisplay;
+	dsc->slice_width = slice_width;
+	dsc->slice_count = slices;
+
+	if (dsc->pic_height % 108 == 0)
+		dsc->slice_height = 108;
+	else if (dsc->pic_height % 16 == 0)
+		dsc->slice_height = 16;
+	else if (dsc->pic_height % 12 == 0)
+		dsc->slice_height = 12;
+	else
+		dsc->slice_height = 15;
+
+	dsc->bits_per_component = MSM_DP_DSC_SRC_BPP / 3;
+	dsc->bits_per_pixel = MSM_DP_DSC_TGT_BPP << 4;
+	dsc->convert_rgb = 1;
+	dsc->simple_422 = 0;
+	dsc->native_422 = 0;
+	dsc->native_420 = 0;
+	dsc->vbr_enable = 0;
+	dsc->block_pred_enable =
+		!!(dsc_dpcd[DP_DSC_BLK_PREDICTION_SUPPORT - DP_DSC_SUPPORT] &
+		   DP_DSC_BLK_PREDICTION_IS_SUPPORTED);
+
+	drm_dsc_set_const_params(dsc);
+	drm_dsc_set_rc_buf_thresh(dsc);
+
+	ret = drm_dsc_setup_rc_params(dsc, minor == 2 ? DRM_DSC_1_2_444 :
+					   DRM_DSC_1_1_PRE_SCR);
+	if (ret) {
+		drm_dbg_dp(panel->drm_dev, "no DSC RC parameters: %d\n", ret);
+		return ret;
+	}
+
+	dsc->initial_scale_value = drm_dsc_initial_scale_value(dsc);
+	dsc->line_buf_depth = dsc->bits_per_component + 1;
+
+	ret = drm_dsc_compute_rc_parameters(dsc);
+	if (ret) {
+		drm_dbg_dp(panel->drm_dev, "DSC RC computation failed: %d\n", ret);
+		return ret;
+	}
+
+	msm_dp_panel_dsc_params_calc(dsc, params);
+
+	drm_dbg_dp(panel->drm_dev,
+		   "DSC %dx%d: %u slices of %ux%u, chunk %u, eol %u, dto %u/%u count %u extra %u\n",
+		   dsc->pic_width, dsc->pic_height, slices, slice_width,
+		   dsc->slice_height, dsc->slice_chunk_size,
+		   params->eol_byte_num, params->dto_n, params->dto_d,
+		   params->pclk_per_line, params->extra_width);
+
+	return 0;
+}
+
+/*
+ * Link bandwidth in kbit/s a compressed mode needs, including the FEC
+ * overhead (FEC blocks carry 97.582% payload) and the per-slice end-of-chunk
+ * and lane-padding symbols the controller inserts.
+ */
+u64 msm_dp_panel_dsc_link_rate_khz(const struct msm_dp_panel *msm_dp_panel,
+				   const struct drm_display_mode *mode,
+				   const struct msm_dp_dsc_params *params)
+{
+	u32 nlanes = msm_dp_panel->link_info.num_lanes;
+	u32 slices = params->slice_per_pkt;
+	u32 hor_bytes = params->bytes_per_pkt * slices;
+	u32 eoc_bytes = params->bytes_per_pkt % nlanes;
+	u32 dwidth_bytes = hor_bytes + nlanes * slices +
+		(eoc_bytes ? (nlanes - eoc_bytes) * slices : 0);
+	u64 rate;
+
+	rate = (u64)mode->clock * params->tgt_bpp;
+	rate = div_u64(rate * dwidth_bytes, hor_bytes);
+	rate = div_u64(rate * 100000, 97582);
+
+	return rate;
+}
+
+/* the PPS secondary data packet carries 128 payload bytes */
+#define MSM_DP_PPS_WORDS	32
+/* words the link block stores: 88 PPS bytes, and parity for 24 of the words */
+#define MSM_DP_PPS_LINK_WORDS	22
+#define MSM_DP_PPS_PARITY_WORDS	6
+
+static void msm_dp_panel_dsc_write_pps(struct msm_dp_panel_private *panel,
+				       const struct drm_dsc_config *dsc)
+{
+	struct drm_dsc_picture_parameter_set pps;
+	const u8 *bytes = (const u8 *)&pps;
+	u32 words[MSM_DP_PPS_WORDS];
+	u8 parity[MSM_DP_PPS_WORDS];
+	u32 parity_word;
+	int i;
+
+	BUILD_BUG_ON(sizeof(pps) != 4 * MSM_DP_PPS_WORDS);
+
+	drm_dsc_pps_payload_pack(&pps, dsc);
+
+	for (i = 0; i < MSM_DP_PPS_WORDS; i++) {
+		words[i] = bytes[4 * i] | bytes[4 * i + 1] << 8 |
+			   bytes[4 * i + 2] << 16 | bytes[4 * i + 3] << 24;
+		parity[i] = msm_dp_utils_calculate_parity32(words[i]);
+	}
+
+	/* PPS SDP header: type 0x10, 128 bytes, and its parity */
+	msm_dp_write_link(panel, REG_DP_PPS_HB_0_3, 0x7F1000);
+	msm_dp_write_link(panel, REG_DP_PPS_PB_0_3, 0xA22300);
+
+	/*
+	 * The controller stores the 88 defined PPS bytes (22 words) and six
+	 * words of payload parity; the remaining PPS bytes are reserved zeros
+	 * and the registers past the payload belong to the audio block.
+	 */
+	for (i = 0; i < MSM_DP_PPS_PARITY_WORDS; i++) {
+		parity_word = parity[4 * i] |
+			      parity[4 * i + 1] << 8 |
+			      parity[4 * i + 2] << 16 |
+			      parity[4 * i + 3] << 24;
+		msm_dp_write_link(panel, REG_DP_PPS_PB_4_7 + 4 * i, parity_word);
+	}
+
+	for (i = 0; i < MSM_DP_PPS_LINK_WORDS; i++)
+		msm_dp_write_link(panel, REG_DP_PPS_PPS_0_3 + 4 * i, words[i]);
+}
+
+/**
+ * msm_dp_panel_dsc_update_pps - flush the PPS packet for the next frame
+ * @msm_dp_panel: DP panel
+ *
+ * Qualcomm's downstream driver requests a PPS flush on every frame of a
+ * compressed DP stream together with the DPU peripheral flush that carries
+ * it out.
+ */
+void msm_dp_panel_dsc_update_pps(struct msm_dp_panel *msm_dp_panel)
+{
+	struct msm_dp_panel_private *panel;
+	u32 reg;
+
+	panel = container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
+
+	if (!msm_dp_panel->msm_dp_mode.dsc_en || !panel->panel_on)
+		return;
+
+	reg = msm_dp_read_link(panel, MMSS_DP_FLUSH);
+	reg &= ~DP_FLUSH_PPS_ONESHOT;
+	reg |= DP_FLUSH_PPS;
+	msm_dp_write_link(panel, MMSS_DP_FLUSH, reg);
+}
+
+/**
+ * msm_dp_panel_stream_off - note that the stream is off
+ * @msm_dp_panel: DP panel
+ *
+ * Stops msm_dp_panel_dsc_update_pps() from touching the link block.
+ */
+void msm_dp_panel_stream_off(struct msm_dp_panel *msm_dp_panel)
+{
+	struct msm_dp_panel_private *panel;
+
+	panel = container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
+	panel->panel_on = false;
+}
+
+/**
+ * msm_dp_panel_dsc_link_disable - clear the compression control in the link block
+ * @msm_dp_panel: DP panel
+ *
+ * Safe while the link clocks run and the stream (pixel) clock is off.
+ */
+void msm_dp_panel_dsc_link_disable(struct msm_dp_panel *msm_dp_panel)
+{
+	struct msm_dp_panel_private *panel;
+
+	panel = container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
+	msm_dp_write_link(panel, REG_DP_COMPRESSION_MODE_CTRL, 0);
+}
+
+/**
+ * msm_dp_panel_dsc_config - program or clear the compressed stream setup
+ * @msm_dp_panel: DP panel
+ * @enable: program the current mode's DSC parameters, or clear them
+ *
+ * Programs the pixel data throttle, the PPS packet and the compression
+ * control for the mode selected by msm_dp_panel_init_panel_info(); with
+ * @enable false or an uncompressed mode, the stream runs uncompressed.
+ */
+void msm_dp_panel_dsc_config(struct msm_dp_panel *msm_dp_panel, bool enable)
+{
+	struct msm_dp_panel_private *panel;
+	struct msm_dp_display_mode *mode = &msm_dp_panel->msm_dp_mode;
+	const struct msm_dp_dsc_params *params = &mode->dsc_params;
+	u32 reg, compression;
+
+	panel = container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
+
+	if (!enable || !mode->dsc_en) {
+		msm_dp_write_p0(panel, MMSS_DP_DSC_DTO_COUNT, 0);
+		msm_dp_write_p0(panel, MMSS_DP_DSC_DTO, 0);
+		msm_dp_write_link(panel, REG_DP_COMPRESSION_MODE_CTRL, 0);
+		return;
+	}
+
+	msm_dp_write_p0(panel, MMSS_DP_DSC_DTO_COUNT, params->pclk_per_line);
+	reg = DP_DSC_DTO_EN | DP_DSC_DTO_ENABLE_HW_ACK |
+	      params->dto_n << DP_DSC_DTO_NUM_SHIFT |
+	      params->dto_d << DP_DSC_DTO_DENOM_SHIFT;
+	msm_dp_write_p0(panel, MMSS_DP_DSC_DTO, reg);
+
+	msm_dp_panel_dsc_write_pps(panel, &mode->dsc);
+
+	compression = DP_COMPRESSION_MODE_CTRL_EN |
+	      params->eol_byte_num << DP_COMPRESSION_MODE_CTRL_EOL_BYTE_NUM_SHIFT |
+	      (params->slice_per_pkt - 1) << DP_COMPRESSION_MODE_CTRL_SLICE_PER_PKT_SHIFT |
+	      10 << DP_COMPRESSION_MODE_CTRL_BE_IN_LANE_SHIFT |
+	      params->bytes_per_pkt << DP_COMPRESSION_MODE_CTRL_BYTES_PER_PKT_SHIFT;
+	msm_dp_write_link(panel, REG_DP_COMPRESSION_MODE_CTRL, compression);
+
+	/* send the PPS with every frame */
+	reg = msm_dp_read_link(panel, MMSS_DP_FLUSH);
+	reg &= ~DP_FLUSH_PPS_ONESHOT;
+	reg |= DP_FLUSH_PPS;
+	msm_dp_write_link(panel, MMSS_DP_FLUSH, reg);
+
+	msm_dp_panel_update_sdp(panel);
+
+	drm_dbg_dp(panel->drm_dev, "dsc: dto=0x%x count=%u compression=0x%x flush=0x%x\n",
+		   (u32)(DP_DSC_DTO_EN | DP_DSC_DTO_ENABLE_HW_ACK |
+			 params->dto_n << DP_DSC_DTO_NUM_SHIFT |
+			 params->dto_d << DP_DSC_DTO_DENOM_SHIFT),
+		   params->pclk_per_line, compression, reg);
+}
