diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
index 4924bbeb444..3b50cbb6e92 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -650,9 +650,32 @@ struct drm_dsc_config *dpu_encoder_get_dsc_config(struct drm_encoder *drm_enc)
 	if (dpu_enc->disp_info.intf_type == INTF_DSI)
 		return msm_dsi_get_dsc_config(priv->kms->dsi[index]);
 
+	if (dpu_enc->disp_info.intf_type == INTF_DP)
+		return msm_dp_get_dsc_config(priv->kms->dp[index], NULL);
+
 	return NULL;
 }
 
+/**
+ * dpu_encoder_get_dp_dsc_timing - extra interface timing of a compressed DP stream
+ * @drm_enc: Pointer to encoder structure
+ * @timing: filled in when the DP stream is compressed
+ *
+ * Returns: true when the encoder drives a compressed DP stream
+ */
+bool dpu_encoder_get_dp_dsc_timing(struct drm_encoder *drm_enc,
+				   struct msm_dp_dsc_intf_timing *timing)
+{
+	struct msm_drm_private *priv = drm_enc->dev->dev_private;
+	struct dpu_encoder_virt *dpu_enc = to_dpu_encoder_virt(drm_enc);
+	int index = dpu_enc->disp_info.h_tile_instance[0];
+
+	if (dpu_enc->disp_info.intf_type != INTF_DP)
+		return false;
+
+	return !!msm_dp_get_dsc_config(priv->kms->dp[index], timing);
+}
+
 void dpu_encoder_update_topology(struct drm_encoder *drm_enc,
 				 struct msm_display_topology *topology,
 				 struct drm_atomic_commit *state,
@@ -664,7 +687,7 @@ void dpu_encoder_update_topology(struct drm_encoder *drm_enc,
 	struct drm_connector *connector;
 	struct drm_connector_state *conn_state;
 	struct drm_framebuffer *fb;
-	struct drm_dsc_config *dsc;
+	bool dsc_enabled;
 
 	int i;
 
@@ -672,13 +695,23 @@ void dpu_encoder_update_topology(struct drm_encoder *drm_enc,
 		if (dpu_enc->phys_encs[i])
 			topology->num_intf++;
 
-	dsc = dpu_encoder_get_dsc_config(drm_enc);
+	/*
+	 * DP chooses compression per mode, and only programs it in the
+	 * bridge pre-enable, so ask it about the mode being checked.
+	 */
+	if (disp_info->intf_type == INTF_DP) {
+		struct msm_dp *dp = priv->kms->dp[disp_info->h_tile_instance[0]];
+
+		dsc_enabled = msm_dp_dsc_enabled_for_mode(dp, adj_mode);
+	} else {
+		dsc_enabled = !!dpu_encoder_get_dsc_config(drm_enc);
+	}
 
 	/*
 	 * Set DSC number as 1 to mark the enabled status, will be adjusted
 	 * in dpu_crtc_get_topology()
 	 */
-	if (dsc)
+	if (dsc_enabled)
 		topology->num_dsc = 1;
 
 	connector = drm_atomic_get_new_connector_for_encoder(state, drm_enc);
@@ -1650,6 +1683,21 @@ static void _dpu_encoder_trigger_flush(struct drm_encoder *drm_enc,
 	if (extra_flush_bits && ctl->ops.update_pending_flush)
 		ctl->ops.update_pending_flush(ctl, extra_flush_bits);
 
+	/*
+	 * A compressed DP stream carries its PPS with the peripheral flush;
+	 * refresh the packet and request the flush on every frame, as
+	 * Qualcomm's downstream driver does.
+	 */
+	if (dpu_enc->dsc && phys->hw_intf &&
+	    phys->hw_intf->cap->type == INTF_DP &&
+	    ctl->ops.update_pending_flush_periph) {
+		struct msm_drm_private *priv = drm_enc->dev->dev_private;
+		int index = dpu_enc->disp_info.h_tile_instance[0];
+
+		msm_dp_dsc_update_pps(priv->kms->dp[index]);
+		ctl->ops.update_pending_flush_periph(ctl, phys->hw_intf->idx);
+	}
+
 	ctl->ops.trigger_flush(ctl);
 
 	if (ctl->ops.get_pending_flush)
@@ -2057,6 +2105,9 @@ static void dpu_encoder_dsc_pipe_cfg(struct dpu_hw_ctl *ctl,
 	if (hw_pp->ops.setup_dsc)
 		hw_pp->ops.setup_dsc(hw_pp);
 
+	if (hw_pp->ops.setup_dsc_swap)
+		hw_pp->ops.setup_dsc_swap(hw_pp, false);
+
 	if (hw_dsc->ops.dsc_bind_pingpong_blk)
 		hw_dsc->ops.dsc_bind_pingpong_blk(hw_dsc, hw_pp->idx);
 
