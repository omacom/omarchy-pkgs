+	 */
+	void (*setup_dsc_swap)(struct dpu_hw_pingpong *pp, bool enable);
 };
 
 struct dpu_hw_merge_3d;
diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 360e15f6f43..1797138c0f7 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -139,6 +139,7 @@ struct msm_dp_ctrl_private {
 	bool core_clks_on;
 	bool link_clks_on;
 	bool stream_clks_on;
+	bool sink_fec_ready;
 };
 
 static inline u32 msm_dp_read_ahb(const struct msm_dp_ctrl_private *ctrl, u32 offset)
@@ -421,8 +422,12 @@ static void msm_dp_ctrl_config_ctrl_streams(struct msm_dp_ctrl_private *ctrl,
 	if (msm_dp_panel->msm_dp_mode.out_fmt_is_yuv_420)
 		config |= DP_CONFIGURATION_CTRL_RGB_YUV; /* YUV420 */
 
-	tbd = msm_dp_link_get_test_bits_depth(ctrl->link,
-					      msm_dp_panel->msm_dp_mode.bpp);
+	/* the DSC encoders hand the controller a byte stream: signal 8 bpc */
+	if (msm_dp_panel->msm_dp_mode.dsc_en)
+		tbd = DP_TEST_BIT_DEPTH_8 >> DP_TEST_BIT_DEPTH_SHIFT;
+	else
+		tbd = msm_dp_link_get_test_bits_depth(ctrl->link,
+						      msm_dp_panel->msm_dp_mode.bpp);
 
 	config |= tbd << DP_CONFIGURATION_CTRL_BPC_SHIFT;
 
@@ -465,6 +470,74 @@ static void msm_dp_ctrl_config_ctrl_link(struct msm_dp_ctrl_private *ctrl,
 	msm_dp_write_link(ctrl, REG_DP_CONFIGURATION_CTRL, config);
 }
 
+static void msm_dp_ctrl_fec_config(struct msm_dp_ctrl_private *ctrl, bool enable)
+{
+	u32 mainlink_ctrl;
+
+	mainlink_ctrl = msm_dp_read_link(ctrl, REG_DP_MAINLINK_CTRL);
+
+	if (enable)
+		mainlink_ctrl |= DP_MAINLINK_CTRL_FEC_EN |
+				 DP_MAINLINK_CTRL_FEC_SEQ_MODE |
+				 DP_MAINLINK_FLUSH_MODE_SDE_PERIPH_UPDATE |
+				 DP_MAINLINK_FB_BOUNDARY_SEL;
+	else
+		mainlink_ctrl &= ~DP_MAINLINK_CTRL_FEC_EN;
+
+	msm_dp_write_link(ctrl, REG_DP_MAINLINK_CTRL, mainlink_ctrl);
+	/* make sure the mainlink configuration is updated with the FEC sequence */
+	wmb();
+}
+
+/*
+ * Start forward error correction once the link carries video. The FEC
+ * sequence can collide with blanking-start symbols, so the controller may
+ * need more than one attempt before the sink reports FEC decoding.
+ */
+static int msm_dp_ctrl_fec_start(struct msm_dp_ctrl_private *ctrl)
+{
+	int i, ret;
+	u8 fec_sts;
+
+	for (i = 0; i < 3; i++) {
+		msm_dp_ctrl_fec_config(ctrl, true);
+
+		/* wait for the controller to start the FEC sequence */
+		usleep_range(900, 1000);
+
+		ret = drm_dp_dpcd_read_byte(ctrl->aux, DP_FEC_STATUS, &fec_sts);
+		if (ret) {
+			DRM_ERROR("failed to read sink FEC status: %d\n", ret);
+			goto disable_fec;
+		}
+		if (fec_sts & DP_FEC_DECODE_EN_DETECTED) {
+			drm_dbg_dp(ctrl->drm_dev, "fec attempts %d status 0x%02x\n",
+				   i + 1, fec_sts);
+			return 0;
+		}
+	}
+
+	DRM_ERROR("sink did not detect FEC after %d attempts\n", i);
+	ret = -ETIMEDOUT;
+disable_fec:
+	msm_dp_ctrl_fec_config(ctrl, false);
+	return ret;
+}
+
+static int msm_dp_ctrl_sink_dsc_enable(struct msm_dp_ctrl_private *ctrl, bool enable)
+{
+	int rc;
+
+	rc = drm_dp_dpcd_write_byte(ctrl->aux, DP_DSC_ENABLE,
+				    enable ? DP_DECOMPRESSION_EN : 0);
+	if (rc)
+		DRM_ERROR("failed to %s sink DSC: %d\n", str_enable_disable(enable), rc);
+	else
+		drm_dbg_dp(ctrl->drm_dev, "sink dsc %s\n", str_enabled_disabled(enable));
+
+	return rc;
+}
+
 static void msm_dp_ctrl_lane_mapping(struct msm_dp_ctrl_private *ctrl)
 {
 	u32 *lane_map = ctrl->link->lane_map;
@@ -484,8 +557,11 @@ static void msm_dp_ctrl_config_misc1_misc0(struct msm_dp_ctrl_private *ctrl,
 {
 	u32 colorimetry_cfg, test_bits_depth, misc_val;
 
-	test_bits_depth = msm_dp_link_get_test_bits_depth(ctrl->link,
-							  msm_dp_panel->msm_dp_mode.bpp);
+	if (msm_dp_panel->msm_dp_mode.dsc_en)
