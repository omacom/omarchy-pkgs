+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
@@ -46,6 +46,8 @@ static void drm_mode_to_intf_timing_params(
 		const struct drm_display_mode *mode,
 		struct dpu_hw_intf_timing_params *timing)
 {
+	struct msm_dp_dsc_intf_timing dp_dsc = { 0 };
+
 	memset(timing, 0, sizeof(*timing));
 
 	if ((mode->htotal < mode->hsync_end)
@@ -98,6 +100,16 @@ static void drm_mode_to_intf_timing_params(
 	timing->wide_bus_en = dpu_encoder_is_widebus_enabled(phys_enc->parent);
 	timing->compression_en = dpu_encoder_is_dsc_enabled(phys_enc->parent);
 
+	if (phys_enc->hw_intf->cap->type == INTF_DP && timing->compression_en) {
+		struct drm_dsc_config *dsc =
+			dpu_encoder_get_dsc_config(phys_enc->parent);
+
+		if (dsc)
+			timing->dce_bytes_per_line = msm_dsc_get_bytes_per_line(dsc);
+		if (!dpu_encoder_get_dp_dsc_timing(phys_enc->parent, &dp_dsc))
+			timing->compression_en = false;
+	}
+
 	/*
 	 *  For DP/EDP, Shift timings to align it to bottom right.
 	 *  wide_bus_en is set for everything excluding SDM845 &
@@ -112,14 +124,32 @@ static void drm_mode_to_intf_timing_params(
 
 	/*
 	 * for DP, divide the horizonal parameters by 2 when
-	 * widebus is enabled
+	 * widebus or compression is enabled
 	 */
-	if (phys_enc->hw_intf->cap->type == INTF_DP && timing->wide_bus_en) {
-		timing->width = timing->width >> 1;
-		timing->xres = timing->xres >> 1;
-		timing->h_back_porch = timing->h_back_porch >> 1;
-		timing->h_front_porch = timing->h_front_porch >> 1;
-		timing->hsync_pulse_width = timing->hsync_pulse_width >> 1;
+	if (phys_enc->hw_intf->cap->type == INTF_DP &&
+	    (timing->wide_bus_en || timing->compression_en)) {
+		u32 factor = timing->compression_en && dp_dsc.pclk_factor ? dp_dsc.pclk_factor : 2;
+
+		timing->width = timing->width / factor;
+		timing->xres = timing->xres / factor;
+		timing->h_back_porch = timing->h_back_porch / factor;
+		timing->h_front_porch = timing->h_front_porch / factor;
+		timing->hsync_pulse_width = timing->hsync_pulse_width / factor;
+
+		/*
+		 * The DP data throttle needs a few more clocks per line to
+		 * deliver every compressed byte; count them into the active
+		 * width and the back porch.
+		 */
+		if (timing->compression_en) {
+			timing->extra_dto_cycles = dp_dsc.extra_dto_cycles;
+			timing->width += dp_dsc.extra_disp_width;
+			timing->h_back_porch += dp_dsc.extra_disp_width;
+			DPU_DEBUG_VIDENC(phys_enc,
+					 "dp dsc timing: width %u xres %u hbp %u dce_bytes %u dto_cycles %u\n",
+					 timing->width, timing->xres, timing->h_back_porch,
+					 timing->dce_bytes_per_line, timing->extra_dto_cycles);
+		}
 	}
 
 	/*
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c
