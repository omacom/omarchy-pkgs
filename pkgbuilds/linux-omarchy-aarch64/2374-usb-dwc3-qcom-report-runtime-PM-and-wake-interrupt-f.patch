From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 8 Oct 2026 13:43:53 -0500
Subject: [PATCH] usb: dwc3: qcom: report runtime PM and wake interrupt
 failures

When a runtime suspend or resume callback fails with an error other than
-EBUSY or -EAGAIN, the PM core records the error and stops runtime PM
for the device until the error is cleared, without logging anything. The
controller then stays powered, or stays suspended, with no indication of
why. The same is true when setting the trigger type of a wake interrupt
fails: the wake interrupt is still enabled, but may not fire.

Log these failures. -EBUSY and -EAGAIN from the core runtime suspend are
not logged: they mean the controller is still in use and are expected.
The glue suspend cannot fail and is left as it is.

Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/usb/dwc3/dwc3-qcom.c | 23 ++++++++++++++++++-----
 1 file changed, 18 insertions(+), 5 deletions(-)

diff --git a/drivers/usb/dwc3/dwc3-qcom.c b/drivers/usb/dwc3/dwc3-qcom.c
index 9447208afac..0905516ab56 100644
--- a/drivers/usb/dwc3/dwc3-qcom.c
+++ b/drivers/usb/dwc3/dwc3-qcom.c
@@ -255,11 +255,16 @@ static enum usb_device_speed dwc3_qcom_read_usb2_speed(struct dwc3_qcom *qcom, i
 
 static void dwc3_qcom_enable_wakeup_irq(int irq, unsigned int polarity)
 {
+	int ret;
+
 	if (!irq)
 		return;
 
-	if (polarity)
-		irq_set_irq_type(irq, polarity);
+	if (polarity) {
+		ret = irq_set_irq_type(irq, polarity);
+		if (ret)
+			pr_err("failed to set wake IRQ %d type: %d\n", irq, ret);
+	}
 
 	enable_irq(irq);
 	enable_irq_wake(irq);
@@ -809,8 +814,11 @@ static int dwc3_qcom_runtime_suspend(struct device *dev)
 	int ret;
 
 	ret = dwc3_runtime_suspend(&qcom->dwc);
-	if (ret)
+	if (ret) {
+		if (ret != -EBUSY && ret != -EAGAIN)
+			dev_err(dev, "core runtime suspend failed: %d\n", ret);
 		return ret;
+	}
 
 	return dwc3_qcom_suspend(qcom, true);
 }
@@ -822,10 +830,15 @@ static int dwc3_qcom_runtime_resume(struct device *dev)
 	int ret;
 
 	ret = dwc3_qcom_resume(qcom, true);
-	if (ret)
+	if (ret) {
+		dev_err(dev, "glue runtime resume failed: %d\n", ret);
 		return ret;
+	}
 
-	return dwc3_runtime_resume(&qcom->dwc);
+	ret = dwc3_runtime_resume(&qcom->dwc);
+	if (ret)
+		dev_err(dev, "core runtime resume failed: %d\n", ret);
+	return ret;
 }
 
 static int dwc3_qcom_runtime_idle(struct device *dev)
-- 
2.56.0

