# https://www.kernel.org/pub/linux/kernel/v7.x/sha256sums.asc

export KBUILD_BUILD_HOST=omarchy
export KBUILD_BUILD_USER=$_kernel
export KBUILD_BUILD_TIMESTAMP="$(date -Ru${SOURCE_DATE_EPOCH:+d @$SOURCE_DATE_EPOCH})"

prepare() {
  cd $_srcname

  echo "Setting version..."
  echo "-$pkgrel" > localversion.10-pkgrel
  echo "${_kernel#linux}" > localversion.20-pkgname

  if [[ -n ${_rcpatch:-} ]]; then
    echo "Applying patch $_rcpatch..."
    patch -Np1 --fuzz=0 < "../$_rcpatch"
  fi

  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    src="${src%.zst}"
    [[ $src = *.patch && $src != nvidia-* ]] || continue
    echo "Applying patch $src..."
    patch -Np1 --fuzz=0 < "../$src"
  done

  echo "Setting config..."
  cp ../config.$CARCH .config
  make olddefconfig
  diff -u ../config.$CARCH .config || :

  make -s kernelrelease > version
  echo "Prepared $_kernel version $(<version)"

  cd "$srcdir/$_nvidia"
  # As nvidia-open-dkms does, for reproducible builds.
  sed -i "s/^  HOSTNAME.*/  HOSTNAME = echo archlinux/" utils.mk
  sed -i "s/^WHOAMI.*/WHOAMI = echo archlinux-builder/" utils.mk
  sed -i "s/^DATE.*/DATE = date -r version.mk/" utils.mk
  for src in "${source[@]}"; do
    src="${src##*/}"
    [[ $src = nvidia-*.patch ]] || continue
    echo "Applying NVIDIA patch $src..."
    patch --batch --fuzz=0 -p1 < "$srcdir/$src"
  done
}

check() {
  PACKAGE_RECIPE_DIR="$startdir" bash "$srcdir/test.sh" "$srcdir/$_srcname"
}

build() {
  cd $_srcname
  MAKEFLAGS="-j$(nproc) $MAKEFLAGS"
  # N1x boots through ACPI. The Snapdragon laptops get no device tree from
  # their firmware, so build theirs and skip the other arm64 DTBs that
  # "make all" would build. The headers ship these trees' sources, and
  # linux-omarchy-dtbs builds the packaged trees from them.
  local dts=(arch/arm64/boot/dts/qcom/{x1,hamoa,glymur,mahua,sc8280xp}*.dts)
  dts=("${dts[@]#arch/arm64/boot/dts/}")
  make Image modules "${dts[@]/%.dts/.dtb}"
  env -u CFLAGS -u CXXFLAGS -u LDFLAGS \
    make -C tools/bpf/bpftool vmlinux.h feature-clang-bpf-co-re=1

  # Against this tree, which holds the Module.symvers the modules link to.
  # Without makepkg's flags: NVIDIA's Makefiles hand LDFLAGS to ld itself,
  # which rejects -Wl, options, and the kernel build sets its own.
  local ksrc="$PWD"
  cd "$srcdir/$_nvidia"
  env -u CFLAGS -u CXXFLAGS -u LDFLAGS \
    make SYSSRC="$ksrc" SYSOUT="$ksrc" IGNORE_PREEMPT_RT_PRESENCE=1 modules
}

_package() {
  pkgdesc="The $pkgdesc kernel and modules"
  # The Snapdragon laptops' device trees and hardware IDs, which this package
  # shipped until 7.3-46. Built from the headers' tree sources, so a new
  # laptop's tree ships without a kernel build.
  depends=(
    coreutils
    initramfs
    kmod
    "$_kernel-dtbs"
  )
  optdepends=(
    "$_kernel-headers: headers and scripts for building modules"
    'linux-firmware: firmware images needed for some devices'
    'scx-scheds: to use sched-ext schedulers'
    'sof-firmware: firmware for Intel SOF audio'
    'wireless-regdb: to set the correct wireless channels of your country'
  )
  # linux-omarchy-n1x is the name this package had.
  conflicts=(linux-omarchy-n1x)
  replaces=(linux-omarchy-n1x)
  provides=(
    ADIOS-MODULE
    KSMBD-MODULE
    NTSYNC-MODULE
    VIRTUALBOX-GUEST-MODULES
    WIREGUARD-MODULE
  )

  cd $_srcname
  local modulesdir="$pkgdir/usr/lib/modules/$(<version)"

  echo "Installing boot image..."
  # systemd expects to find the kernel here to allow hibernation
  # https://github.com/systemd/systemd/commit/edda44605f06a41fb86b7ab8128dcf99161d2344
  # Limine's aarch64 Linux protocol needs the raw arm64 Image; CONFIG_EFI_ZBOOT
  # makes image_name the PE-wrapped vmlinuz.efi instead.
  install -Dm644 arch/arm64/boot/Image "$modulesdir/vmlinuz"

  # Used by mkinitcpio to name the kernel
  echo "$_kernel" | install -Dm644 /dev/stdin "$modulesdir/pkgbase"

  echo "Installing modules..."
  ZSTD_CLEVEL=19 make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
    DEPMOD=/doesnt/exist modules_install  # Suppress depmod

  # remove build link
  rm "$modulesdir"/build
}

# The sources of the trees the build made, and the files they include, at
# their place in the headers' build tree, which already has dtc and the
# dt-bindings headers. A laptop's tree can then be changed and rebuilt on
# the laptop itself.
_install_dts_sources() {
  local builddir=$1 dtb deps dep
  local -A files=()
  for dtb in arch/arm64/boot/dts/qcom/*.dtb; do
    deps=$(gcc -M -nostdinc -undef -D__DTS__ -x assembler-with-cpp \
      -I scripts/dtc/include-prefixes "${dtb%.dtb}.dts") || return
    for dep in ${deps#*:}; do
      [[ $dep == \\ ]] || files[$(realpath --relative-to=. "$dep")]=1
    done
  done
  for dep in "${!files[@]}"; do
    case $dep in
      arch/arm64/boot/dts/*) install -Dm644 "$dep" "$builddir/$dep" ;;
      include/*) ;;
      *) echo "A tree includes $dep, which the headers don't ship" >&2; return 1 ;;
    esac
  done
}

# Each packaged tree must rebuild from the shipped sources to the same bytes,
# with the shipped dtc and the steps Kbuild takes. Kbuild adds -@ to a tree
# that an overlay can go on, so the trees with symbols get it here too.
_check_dts_sources() {
  local builddir=$1 dtb dts tmp symbols
  local prefixes=$builddir/scripts/dtc/include-prefixes
  tmp=$(mktemp -d) || return
  for dtb in arch/arm64/boot/dts/qcom/*.dtb; do
    dts=$builddir/${dtb%.dtb}.dts
    symbols=()
    grep -aq __symbols__ "$dtb" && symbols=(-@)
    if ! gcc -E -nostdinc -undef -D__DTS__ -x assembler-with-cpp \
        -I "$prefixes" -o "$tmp/tree.dts" "$dts" ||
      ! "$builddir/scripts/dtc/dtc" -q -O dtb -b 0 -i "${dts%/*}" -i "$prefixes" \
        "${symbols[@]}" -o "$tmp/tree.dtb" "$tmp/tree.dts" ||
      ! cmp -s "$tmp/tree.dtb" "$dtb"; then
      echo "$dtb does not rebuild from the sources the headers ship" >&2
      rm -r "$tmp"
      return 1
    fi
  done
  rm -r "$tmp"
}

_package-headers() {
  pkgdesc="Headers and scripts for building modules and device trees for the $pkgdesc kernel"
  depends=(
    binutils
    glibc
    libelf
    libgcc
    openssl
    pahole
    xxhash
    zlib
    zstd
  )
  conflicts=(linux-omarchy-n1x-headers)
  replaces=(linux-omarchy-n1x-headers)
  provides=(LINUX-HEADERS)

  cd $_srcname
  local builddir="$pkgdir/usr/lib/modules/$(<version)/build"

  local karch
  case $CARCH in
    aarch64) karch=arm64 ;;
    *) echo "Unknown CARCH $CARCH"; exit 1 ;;
  esac

  echo "Installing build files..."
  install -Dt "$builddir" -m644 .config Makefile Module.symvers System.map \
    localversion.* version vmlinux tools/bpf/bpftool/vmlinux.h
  install -Dt "$builddir/kernel" -m644 kernel/Makefile
  install -Dt "$builddir/arch/$karch" -m644 arch/$karch/Makefile
  cp -t "$builddir" -a scripts
  ln -srt "$builddir" "$builddir/scripts/gdb/vmlinux-gdb.py"

  if [[ $(scripts/config -s CONFIG_HAVE_STACK_VALIDATION) = y ]]; then
    install -Dt "$builddir/tools/objtool" tools/objtool/objtool
  fi

  if [[ $(scripts/config -s CONFIG_DEBUG_INFO_BTF_MODULES) = y ]]; then
    install -Dt "$builddir/tools/bpf/resolve_btfids" tools/bpf/resolve_btfids/resolve_btfids
  fi

  echo "Installing headers..."
  cp -t "$builddir" -a include
  cp -t "$builddir/arch/$karch" -a arch/$karch/include
  install -Dt "$builddir/arch/$karch/kernel" -m644 arch/$karch/kernel/asm-offsets.s

  install -Dt "$builddir/drivers/md" -m644 drivers/md/*.h
  install -Dt "$builddir/net/mac80211" -m644 net/mac80211/*.h

  # https://bugs.archlinux.org/task/13146
  install -Dt "$builddir/drivers/media/i2c" -m644 drivers/media/i2c/msp3400-driver.h

  # https://bugs.archlinux.org/task/20402
  install -Dt "$builddir/drivers/media/usb/dvb-usb" -m644 drivers/media/usb/dvb-usb/*.h
  install -Dt "$builddir/drivers/media/dvb-frontends" -m644 drivers/media/dvb-frontends/*.h
  install -Dt "$builddir/drivers/media/tuners" -m644 drivers/media/tuners/*.h

  # https://bugs.archlinux.org/task/71392
  install -Dt "$builddir/drivers/iio/common/hid-sensors" -m644 drivers/iio/common/hid-sensors/*.h

  # Before the broken symlinks go, so scripts/dtc/include-prefixes/arm64
  # finds the trees and stays.
  echo "Installing device tree sources..."
  _install_dts_sources "$builddir"

  echo "Installing KConfig files..."
  find . -name 'Kconfig*' -exec install -Dm644 {} "$builddir/{}" \;

  if [[ $(scripts/config -s CONFIG_RUST) = y ]]; then
    echo "Installing Rust files..."
    install -Dt "$builddir/rust" -m644 rust/*.rmeta
    install -Dt "$builddir/rust" rust/*.so
  fi

  echo "Installing unstripped VDSO..."
  make INSTALL_MOD_PATH="$pkgdir/usr" vdso_install \
    link=  # Suppress build-id symlinks

  echo "Removing unneeded architectures..."
  local arch
  for arch in "$builddir"/arch/*/; do
    [[ $arch = */$karch/ ]] && continue
    echo "Removing $(basename "$arch")"
    rm -r "$arch"
  done

  echo "Removing documentation..."
  rm -r "$builddir/Documentation"

  echo "Removing broken symlinks..."
  find -L "$builddir" -type l -printf 'Removing %P\n' -delete

  echo "Removing loose objects..."
  find "$builddir" -type f -name '*.o' -printf 'Removing %P\n' -delete

  echo "Stripping build tools..."
  local file
  while read -rd '' file; do
    case "$(file -Sib "$file")" in
      application/x-sharedlib\;*)      # Libraries (.so)
        strip -v $STRIP_SHARED "$file" ;;
      application/x-archive\;*)        # Libraries (.a)
        strip -v $STRIP_STATIC "$file" ;;
      application/x-executable\;*)     # Binaries
        strip -v $STRIP_BINARIES "$file" ;;
      application/x-pie-executable\;*) # Relocatable binaries
        strip -v $STRIP_SHARED "$file" ;;
    esac
  done < <(find "$builddir" -type f -perm -u+x ! -name vmlinux -print0)

  echo "Stripping vmlinux..."
  strip -v $STRIP_STATIC "$builddir/vmlinux"

  echo "Checking device tree sources..."
  _check_dts_sources "$builddir"

  echo "Adding symlink..."
  mkdir -p "$pkgdir/usr/src"
  ln -sr "$builddir" "$pkgdir/usr/src/$_kernel"
}

_package-nvidia-open() {
  pkgdesc="NVIDIA open kernel modules for the $pkgdesc kernel"
  license=('MIT AND GPL-2.0-only')
  # Modules load only into the exact kernel they were built against.
  depends=(
    "$_kernel=$pkgver-$pkgrel"
    "nvidia-utils=$_nvidiaver"
  )
  provides=(
    NVIDIA-MODULE
    nvidia-open
  )
  conflicts=(nvidia-open-dkms)

  local ksrc="$srcdir/$_srcname"
  local dest="$pkgdir/usr/lib/modules/$(<"$ksrc/version")/extramodules"

  echo "Installing NVIDIA modules..."
  install -Dm644 -t "$dest" "$srcdir/$_nvidia"/kernel-open/*.ko
  # Stripped before signing, which appends the signature, and signed with the
  # key this build generated and signed the kernel's own modules with, which
  # the kernel trusts and which is gone once the build ends.
  local ko
  for ko in "$dest"/*.ko; do
    strip --strip-debug "$ko"
    "$ksrc/scripts/sign-file" sha512 "$ksrc/certs/signing_key.pem" "$ksrc/certs/signing_key.x509" "$ko"
    zstd -19 --rm -q "$ko"
  done

  install -Dm644 "$srcdir/$_nvidia/COPYING" "$pkgdir/usr/share/licenses/$_kernel-nvidia-open/LICENSE"
}

pkgname=(
  "$_kernel"
  "$_kernel-headers"
  "$_kernel-nvidia-open"
)
for _p in "${pkgname[@]}"; do
  eval "package_$_p() {
    $(declare -f "_package${_p#$_kernel}")
    _package${_p#$_kernel}
  }"
done

