# Maintainer: The Omarchy Authors
# Adopted from the Arch Linux linux package.

# The aarch64 build of linux-omarchy. It has a recipe of its own, in a folder
# of its own, and that folder's name is its pkgbase so the build and publish
# tooling can tell its files from the x86_64 recipe's. The packages it makes
# are linux-omarchy and linux-omarchy-headers, the names x86_64 has, and
# linux-omarchy-nvidia-open.
pkgbase=linux-omarchy-aarch64
_kernel=linux-omarchy
pkgver=7.3.6
pkgrel=13
# NVIDIA's open kernel modules ship prebuilt as $_kernel-nvidia-open, built in
# this recipe so every kernel lands with modules for it and nobody compiles
# them through DKMS on a kernel update. Keep this version and the patches in
# step with nvidia-open-dkms and nvidia-utils.
_nvidiaver=620.73.04
_nvidia=NVIDIA-kernel-module-source-$_nvidiaver
# v4l2loopback ships prebuilt as $_kernel-v4l2loopback so camera-relay laptops
# (e.g. Zenbook A16, Anduril BlueChip) avoid DKMS compilation during install
# and kernel updates.
_v4l2loopbackver=0.15.4
_v4l2loopback=v4l2loopback-$_v4l2loopbackver
pkgdesc='Omarchy Linux for aarch64 (BORE CPU scheduler, ADIOS I/O scheduler)'
url='https://omarchy.org'
arch=(
  aarch64
)
license=(GPL-2.0-only)
makedepends=(
  bc
  binutils
  cpio
  gettext
  glibc
  libelf
  libgcc
  openssl
  pahole
  perl
  python
  rust
  rust-bindgen
  rust-src
  tar
  xxhash
  xz
  zlib
  zstd
)
options=(
  !debug
  !strip
)
_major=${pkgver%%.*}
if [[ $pkgver == *rc* ]]; then
  _base=${pkgver%rc*}
  _prev=${_base%.*}.$(( ${_base##*.} - 1 ))
  _srcname=linux-${_prev%.0}
  _rcpatch=patch-${pkgver//rc/-rc}
else
  _srcname=linux-$pkgver
fi
