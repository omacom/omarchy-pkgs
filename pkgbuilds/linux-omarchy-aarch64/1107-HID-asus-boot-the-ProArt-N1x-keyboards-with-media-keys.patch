From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Hughes <ryan@heyoodle.com>
Date: Mon, 26 Oct 2026 22:08:33 -0400
Subject: [PATCH] HID: asus: boot the ProArt N1x keyboards with media keys on
 the top row

The ASUS ProArt P14 H7407BA and P16 H7607BA ship with the top row
sending media keys, and Fn+Esc switching it to F1-F12. Their 0B05:4B42
keyboard leaves Fn-lock to the host, and hid-asus boots it with
function keys, so both needed fnlock_default=0 in the initramfs to
match.

Default to media keys on those two laptops. fnlock_default given on the
command line or in modprobe.d still wins, and every other keyboard with
QUIRK_HID_FN_LOCK still boots with function keys.
---
 drivers/hid/hid-asus.c | 33 ++++++++++++++++++++++++++++-----
 1 file changed, 28 insertions(+), 5 deletions(-)

diff --git a/drivers/hid/hid-asus.c b/drivers/hid/hid-asus.c
index f937a9ab3..3c744a7d5 100644
--- a/drivers/hid/hid-asus.c
+++ b/drivers/hid/hid-asus.c
@@ -40,9 +40,22 @@ MODULE_AUTHOR("Frederik Wenigwieser <frederik.wenigwieser@gmail.com>");
 MODULE_DESCRIPTION("Asus HID Keyboard and TouchPad");
 
 static bool fnlock_default = true;
-module_param(fnlock_default, bool, 0444);
+static bool fnlock_default_set;
+
+static int fnlock_default_param_set(const char *val,
+				    const struct kernel_param *kp)
+{
+	fnlock_default_set = true;
+	return param_set_bool(val, kp);
+}
+
+static const struct kernel_param_ops fnlock_default_ops = {
+	.set = fnlock_default_param_set,
+	.get = param_get_bool,
+};
+module_param_cb(fnlock_default, &fnlock_default_ops, &fnlock_default, 0444);
 MODULE_PARM_DESC(fnlock_default,
-		 "Default Fn-lock state: true makes F1-F12 send function keys (default: true)");
+		 "Default Fn-lock state: true makes F1-F12 send function keys (default: false on the ProArt P14 and P16, true elsewhere)");
 
 #define T100_TPAD_INTF 2
 #define MEDION_E1239T_TPAD_INTF 1
@@ -1273,9 +1286,19 @@ static int asus_input_configured(struct hid_device *hdev, struct hid_input *hi)
 
 	drvdata->input = input;
 
-	if ((drvdata->quirks & QUIRK_HID_FN_LOCK) &&
-	    (asus_kbd_fn_lock_set(drvdata, fnlock_default)))
-		hid_warn(hdev, "Error while setting FN lock\n");
+	if (drvdata->quirks & QUIRK_HID_FN_LOCK) {
+		/*
+		 * The ProArt N1x laptops ship with the top row sending media
+		 * keys; elsewhere hid-asus has always booted with function keys.
+		 */
+		if (!fnlock_default_set)
+			fnlock_default =
+				!(dmi_match(DMI_PRODUCT_FAMILY, "ProArt P14") ||
+				  dmi_match(DMI_PRODUCT_FAMILY, "ProArt P16"));
+
+		if (asus_kbd_fn_lock_set(drvdata, fnlock_default))
+			hid_warn(hdev, "Error while setting FN lock\n");
+	}
 
 	return 0;
 }
