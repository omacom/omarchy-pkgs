From 49fee2a174cd8c8f78d19631250de2ee5d3c620f Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Sun, 8 Nov 2026 16:00:00 +0100
Subject: [PATCH 2/2] arm64: dts: qcom: Add the ASUS Vivobook 14 (X1407QA)

The Vivobook 14 X1407QA's DSDT is the Vivobook 16 X1607QA's apart from
the SKU string, the GPU and audio subsystem IDs and eleven thermal trip
points, and ASUS ships both the same DSP and GPU firmware, so it reuses
the X1607QA's board dtsi.

It ships with a 1920x1200 IPS LCD instead of the dtsi's Samsung OLED.
The DSDT's panel tables give it PMIC PWM backlight, 12 bits at
2400 Hz, as on the Zenbook A14 LCD, so describe the panel as a generic
eDP panel and take that laptop's PWM backlight from PMK8550 LPG
channel 0 through PMK8550 GPIO5, with PMC8380_3 GPIO4 as its enable.
An owner measured the same path on this laptop. Leave out the Zenbook's
VBL9 regulator on PMC8380_3 GPIO10, which nothing here confirms.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 arch/arm64/boot/dts/qcom/Makefile             |  2 +
 .../dts/qcom/x126100-asus-vivobook-14.dts     | 58 +++++++++++++++++++
 2 files changed, 60 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/x126100-asus-vivobook-14.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 39f19e4..550669b 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -431,6 +431,8 @@ dtb-$(CONFIG_ARCH_QCOM)	+= talos-evk-camera-imx577.dtb
 talos-evk-lvds-auo,g133han01-dtbs	:= \
 	talos-evk.dtb talos-evk-lvds-auo,g133han01.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= talos-evk-lvds-auo,g133han01.dtb
+x126100-asus-vivobook-14-el2-dtbs := x126100-asus-vivobook-14.dtb x1-el2.dtbo
+dtb-$(CONFIG_ARCH_QCOM)	+= x126100-asus-vivobook-14.dtb x126100-asus-vivobook-14-el2.dtb
 x126100-asus-vivobook-16-el2-dtbs := x126100-asus-vivobook-16.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x126100-asus-vivobook-16.dtb x126100-asus-vivobook-16-el2.dtb
 x126100-lenovo-ideapad-slim3-el2-dtbs := x126100-lenovo-ideapad-slim3.dtb x1-el2.dtbo
diff --git a/arch/arm64/boot/dts/qcom/x126100-asus-vivobook-14.dts b/arch/arm64/boot/dts/qcom/x126100-asus-vivobook-14.dts
new file mode 100644
index 0000000..320f3f0
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/x126100-asus-vivobook-14.dts
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Copyright (c) 2023 Qualcomm Innovation Center, Inc. All rights reserved.
+ * Copyright (c) 2025, Kellerman Rivero <krsloco@gmail.com>
+ * Copyright (c) 2025 Aleksandrs Vinarskis <alex@vinarskis.com>
+ *
+ * ASUS Vivobook 14 (X1407QA). Its DSDT is the Vivobook 16 X1607QA's
+ * apart from the SKU, the subsystem IDs and the thermal trip points,
+ * so it shares that tree. It ships with a 1920x1200 IPS LCD, which the
+ * DSDT gives PMIC PWM backlight, 12 bits at 2400 Hz, as on the Zenbook
+ * A14 LCD, whose backlight this is.
+ */
+
+/dts-v1/;
+
+#include "purwa.dtsi"
+#include "x126100-asus-vivobook-16.dtsi"
+
+/delete-node/ &pmc8380_6;
+/delete-node/ &pmc8380_6_thermal;
+
+/ {
+	model = "ASUS Vivobook 14 (X1407QA)";
+	compatible = "asus,vivobook-14-x1407qa", "qcom,x126100", "qcom,x1p42100";
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pmk8550_pwm 0 416667>;
+		enable-gpios = <&pmc8380_3_gpios 4 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-0 = <&edp_bl_en>, <&edp_bl_pwm>;
+		pinctrl-names = "default";
+	};
+};
+
+&mdss_dp3 {
+	aux-bus {
+		panel {
+			compatible = "edp-panel";
+			/delete-property/ enable-gpios;
+			/delete-property/ pinctrl-0;
+			/delete-property/ pinctrl-names;
+
+			backlight = <&backlight>;
+		};
+	};
+};
+
+&pmk8550_gpios {
+	edp_bl_pwm: edp-bl-pwm-state {
+		pins = "gpio5";
+		function = "func3";
+	};
+};
+
+&pmk8550_pwm {
+	status = "okay";
+};
-- 
