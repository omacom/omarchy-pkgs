From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Clay Stan <claystan97@gmail.com>
Date: Tue, 24 Nov 2026 12:16:00 +0800
Subject: [PATCH] pmdomain: core: release ACPI fwnode on virtual genpd device teardown

genpd_dev_pm_attach_by_id() acquires a reference to dev_fwnode(dev) when
attaching an ACPI device to multiple power domains, but genpd_release_dev()
only dropped dev->of_node, leaking the ACPI device fwnode reference on
probe deferral or virtual device unregistration. Release dev->fwnode when
no DT node is attached, and clean up the surrounding conditional braces.

Signed-off-by: Clay Stan <claystan97@gmail.com>
---
 drivers/pmdomain/core.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/drivers/pmdomain/core.c b/drivers/pmdomain/core.c
--- a/drivers/pmdomain/core.c
+++ b/drivers/pmdomain/core.c
@@ -3392,6 +3392,8 @@
 static void genpd_release_dev(struct device *dev)
 {
 	of_node_put(dev->of_node);
+	if (!dev->of_node)
+		fwnode_handle_put(dev->fwnode);
 	kfree(dev);
 }
 
@@ -3765,15 +3767,14 @@
 	}
 
 	/* Try to attach the device to the PM domain at the specified index. */
-	if (use_acpi)
-	{
+	if (use_acpi) {
 		virt_dev->fwnode = fwnode_handle_get(dev_fwnode(dev));
 		ret = __genpd_dev_pm_attach_acpi(virt_dev, dev, index,
 						 num_domains, false);
-	}
-	else
+	} else {
 		ret = __genpd_dev_pm_attach(virt_dev, dev, index,
 					    num_domains, false);
+	}
 	if (ret < 1) {
 		device_unregister(virt_dev);
 		return ret ? ERR_PTR(ret) : NULL;
