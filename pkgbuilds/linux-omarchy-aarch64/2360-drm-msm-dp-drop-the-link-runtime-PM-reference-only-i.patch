From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 8 Oct 2026 13:44:20 -0500
Subject: [PATCH] drm/msm/dp: drop the link runtime PM reference only if it was
 taken

msm_dp_display_prepare_link() takes a runtime PM reference that
msm_dp_display_unprepare() drops when the bridge is disabled. When
pm_runtime_resume_and_get() fails, prepare_link() returns without the
reference, but the later atomic_post_disable still calls
pm_runtime_put_sync() and underflows the usage count.

Record whether prepare_link() holds the reference and drop it only in
that case. This also lets prepare_link() stop early when the eDP plug
handler fails, instead of ignoring its result and training a link to a
panel whose capabilities could not be read.

Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/gpu/drm/msm/dp/dp_display.c | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index 62856f21b97..ec7c91b3911 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -51,6 +51,7 @@ struct msm_dp_display_private {
 	/* state variables */
 	bool core_initialized;
 	bool phy_initialized;
+	bool link_pm_ref;
 	bool audio_supported;
 
 	struct mutex plugged_lock;
@@ -625,8 +626,11 @@ static int msm_dp_display_prepare_link(struct msm_dp_display_private *dp)
 
 	drm_dbg_dp(dp->drm_dev, "sink_count=%d\n", dp->link->sink_count);
 
-	if (msm_dp_display->is_edp)
-		msm_dp_hpd_plug_handle(dp);
+	if (msm_dp_display->is_edp) {
+		rc = msm_dp_hpd_plug_handle(dp);
+		if (rc)
+			return rc;
+	}
 
 	rc = pm_runtime_resume_and_get(&msm_dp_display->pdev->dev);
 	if (rc) {
@@ -634,6 +638,8 @@ static int msm_dp_display_prepare_link(struct msm_dp_display_private *dp)
 		return rc;
 	}
 
+	dp->link_pm_ref = true;
+
 	if (dp->link->sink_count == 0)
 		return -ENOTCONN;
 
@@ -1483,7 +1489,10 @@ static void msm_dp_display_unprepare(struct msm_dp_display_private *dp)
 {
 	struct msm_dp *msm_dp_display = &dp->msm_dp_display;
 
-	pm_runtime_put_sync(&msm_dp_display->pdev->dev);
+	if (dp->link_pm_ref) {
+		pm_runtime_put_sync(&msm_dp_display->pdev->dev);
+		dp->link_pm_ref = false;
+	}
 
 	drm_dbg_dp(dp->drm_dev, "type=%d Done\n", msm_dp_display->connector_type);
 }
