From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Fri, 6 Nov 2026 01:10:00 +0000
Subject: [PATCH 2702/2702] arm64: dts: qcom: x1e80100-romulus: Add the
 DisplayPort audio links

The Surface Laptop 7 enables the DisplayPort controllers behind its two
USB-C ports, but its sound card has no link to them, so a monitor gets
no sound. Add a playback link from each controller to the audio DSP,
as the ThinkPad T14s's tree does. The laptop's topology in
linux-firmware, X1E80100-Romulus-tplg.bin, is built from the T14s's
and has the DisplayPort graphs.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 .../dts/qcom/x1e80100-microsoft-romulus.dtsi  | 32 +++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus.dtsi b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus.dtsi
index 13d0f09..0eee890 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus.dtsi
+++ b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus.dtsi
@@ -381,6 +381,38 @@ sound {
 				"VA DMIC1", "VA MIC BIAS3",
 				"TX SWR_INPUT1", "ADC2_OUTPUT";
 
+		displayport-0-dai-link {
+			link-name = "DisplayPort0 Playback";
+
+			codec {
+				sound-dai = <&mdss_dp0>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
+		displayport-1-dai-link {
+			link-name = "DisplayPort1 Playback";
+
+			codec {
+				sound-dai = <&mdss_dp1>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_1>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
 		va-dai-link {
 			link-name = "VA Capture";
 
