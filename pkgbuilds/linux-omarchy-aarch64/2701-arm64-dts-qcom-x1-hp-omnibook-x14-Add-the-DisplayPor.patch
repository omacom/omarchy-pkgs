From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Fri, 6 Nov 2026 01:05:00 +0000
Subject: [PATCH 2701/2702] arm64: dts: qcom: x1-hp-omnibook-x14: Add the
 DisplayPort audio links

The OmniBook X 14 enables the DisplayPort controllers behind its two
USB-C ports, but its sound card has no link to them, so a monitor gets
no sound. Add a playback link from each controller to the audio DSP,
as the ThinkPad T14s's tree does. The laptop's topology in
linux-firmware, X1E80100-HP-OMNIBOOK-X14-tplg.bin, is built from the
T14s's and has the DisplayPort graphs.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 .../boot/dts/qcom/x1-hp-omnibook-x14.dtsi     | 32 +++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1-hp-omnibook-x14.dtsi b/arch/arm64/boot/dts/qcom/x1-hp-omnibook-x14.dtsi
index dba8cee..73d54e6 100644
--- a/arch/arm64/boot/dts/qcom/x1-hp-omnibook-x14.dtsi
+++ b/arch/arm64/boot/dts/qcom/x1-hp-omnibook-x14.dtsi
@@ -183,6 +183,38 @@ sound: sound {
 				"VA DMIC3", "VA MIC BIAS1",
 				"TX SWR_INPUT1", "ADC2_OUTPUT";
 
+		displayport-0-dai-link {
+			link-name = "DisplayPort0 Playback";
+
+			codec {
+				sound-dai = <&mdss_dp0>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
+		displayport-1-dai-link {
+			link-name = "DisplayPort1 Playback";
+
+			codec {
+				sound-dai = <&mdss_dp1>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_1>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
 		wcd-playback-dai-link {
 			link-name = "WCD Playback";
 
-- 
