 drivers/thunderbolt/qcom-usb4-pcie.c | 487 +++++++++++++++++++++++++++
 drivers/thunderbolt/qcom-usb4-pcie.h |  72 ++++
 5 files changed, 608 insertions(+), 6 deletions(-)
 create mode 100644 drivers/thunderbolt/qcom-usb4-pcie.c
 create mode 100644 drivers/thunderbolt/qcom-usb4-pcie.h

