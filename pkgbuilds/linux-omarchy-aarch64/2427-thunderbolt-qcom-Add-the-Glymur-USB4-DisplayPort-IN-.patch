 drivers/thunderbolt/qcom-usb4-dp-link.h |  20 +
 drivers/thunderbolt/qcom-usb4-dp.c      | 965 ++++++++++++++++++++++++
 drivers/thunderbolt/qcom-usb4-dp.h      |  23 +
