From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 12 Nov 2026 20:27:07 -0600
Subject: [PATCH 2850/2856] clk: qcom: gcc-glymur: Add the USB4 router 1 start-up pieces

USB4 host router 1 has a newer microcontroller design than router 0. Its
start-up sets CBCR_FORCE_MEM_CORE_ON on the microcontroller branch
(GCC_USB4_1_UC_HRR_CLK) after the firmware upload, next to the same bit
on the SYS branch. Add glymur_gcc_usb4_uc_hrr_force_mem() for it, with
the register of both routers.

Set GENPD_FLAG_ACTIVE_WAKEUP on GCC_USB4_1_GDSC and GCC_USB_1_PHY_GDSC
as on router 0's domains, and on GCC_PCIE_1_TUNNEL_GDSC, which router 1
holds as well, so a router 1 kept across system sleep keeps its state.

The register and its place in the sequence match what the platform's
Windows driver does on the Surface Laptop 8, where router 1 starts this
way and a dock on it comes back after system sleep.

Assisted-by: Claude Fable 5.2
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/clk/qcom/gcc-glymur.c        | 20 ++++++++++++++++++++
 include/linux/soc/qcom/glymur-usb4.h |  7 +++++++
 2 files changed, 27 insertions(+)

diff --git a/drivers/clk/qcom/gcc-glymur.c b/drivers/clk/qcom/gcc-glymur.c
index aa9dc9f1b..88871445c 100644
--- a/drivers/clk/qcom/gcc-glymur.c
+++ b/drivers/clk/qcom/gcc-glymur.c
@@ -7494,6 +7494,8 @@ static struct gdsc gcc_pcie_1_tunnel_gdsc = {
 	.clk_dis_wait_val = 0xf,
 	.pd = {
 		.name = "gcc_pcie_1_tunnel_gdsc",
+		/* USB4 router 1 holds this domain too, also across system sleep. */
+		.flags = GENPD_FLAG_ACTIVE_WAKEUP,
 	},
 	.pwrsts = PWRSTS_OFF_ON,
 	.flags = POLL_CFG_GDSCR | RETAIN_FF_ENABLE | VOTABLE,
@@ -7748,6 +7750,8 @@ static struct gdsc gcc_usb4_1_gdsc = {
 	.clk_dis_wait_val = 0xf,
 	.pd = {
 		.name = "gcc_usb4_1_gdsc",
+		/* As router 0: a router kept across system sleep holds its state here. */
+		.flags = GENPD_FLAG_ACTIVE_WAKEUP,
 	},
 	.pwrsts = PWRSTS_OFF_ON,
 	.flags = POLL_CFG_GDSCR | RETAIN_FF_ENABLE,
@@ -7786,6 +7790,8 @@ static struct gdsc gcc_usb_1_phy_gdsc = {
 	.clk_dis_wait_val = 0x2,
 	.pd = {
 		.name = "gcc_usb_1_phy_gdsc",
+		/* As router 0: the PHY of a kept router stays initialized. */
+		.flags = GENPD_FLAG_ACTIVE_WAKEUP,
 	},
 	.pwrsts = PWRSTS_RET_ON,
 	.flags = POLL_CFG_GDSCR | RETAIN_FF_ENABLE,
@@ -8443,6 +8449,7 @@ MODULE_DEVICE_TABLE(of, gcc_glymur_match_table);
 struct glymur_usb4_gcc_regs {
 	u32 ctrl;
 	u32 sys;
+	u32 uc_hrr;
 	u32 pipe;
 	u32 rx_gate[2];
 	u32 rx_mux[2];
@@ -8452,6 +8459,7 @@ static const struct glymur_usb4_gcc_regs glymur_usb4_gcc_regs[] = {
 	[0] = {
 		.ctrl = 0x600c0,
 		.sys = 0x2b05c,
+		.uc_hrr = 0x2b06c,
 		.pipe = 0x2b0bc,
 		.rx_gate = { 0x2b0c4, 0x2b0d8 },
 		.rx_mux = { 0x2b0c0, 0x2b0d4 },
@@ -8459,6 +8467,7 @@ static const struct glymur_usb4_gcc_regs glymur_usb4_gcc_regs[] = {
 	[1] = {
 		.ctrl = 0x600ac,
 		.sys = 0x2d05c,
+		.uc_hrr = 0x2d06c,
 		.pipe = 0x2d0e0,
 		.rx_gate = { 0x2d0e8, 0x2d0fc },
 		.rx_mux = { 0x2d0e4, 0x2d0f8 },
@@ -8539,6 +8548,17 @@ int glymur_gcc_usb4_sys_force_mem(unsigned int port, bool on)
 }
 EXPORT_SYMBOL_GPL(glymur_gcc_usb4_sys_force_mem);
 
+int glymur_gcc_usb4_uc_hrr_force_mem(unsigned int port, bool on)
+{
+	const struct glymur_usb4_gcc_regs *r = glymur_usb4_regs(port);
+
+	if (!r)
+		return -ENODEV;
+	return regmap_update_bits(glymur_gcc_regmap, r->uc_hrr, CBCR_FORCE_MEM_CORE_ON,
+				  on ? CBCR_FORCE_MEM_CORE_ON : 0);
+}
+EXPORT_SYMBOL_GPL(glymur_gcc_usb4_uc_hrr_force_mem);
+
 int glymur_gcc_usb4_pipe_hwcg(unsigned int port, bool enable)
 {
 	const struct glymur_usb4_gcc_regs *r = glymur_usb4_regs(port);
diff --git a/include/linux/soc/qcom/glymur-usb4.h b/include/linux/soc/qcom/glymur-usb4.h
index 1a7fc952a..4a23e69b4 100644
--- a/include/linux/soc/qcom/glymur-usb4.h
+++ b/include/linux/soc/qcom/glymur-usb4.h
@@ -21,6 +21,8 @@ int glymur_gcc_usb4_rx_select(unsigned int port, bool phy);
 int glymur_gcc_usb4_ctrl_bit(unsigned int port, bool set);
 /* CBCR_FORCE_MEM_CORE_ON on the router SYS branch, after firmware upload. */
 int glymur_gcc_usb4_sys_force_mem(unsigned int port, bool on);
+/* The same on the router microcontroller (uC HRR) branch; v2 routers only. */
+int glymur_gcc_usb4_uc_hrr_force_mem(unsigned int port, bool on);
 /* Hardware clock gating bit of the USB PIPE branch. */
 int glymur_gcc_usb4_pipe_hwcg(unsigned int port, bool enable);
 /* Poll the SYS branch CLK_OFF status clear after reset deassert. */
@@ -41,6 +43,11 @@ static inline int glymur_gcc_usb4_sys_force_mem(unsigned int port, bool on)
 	return -ENODEV;
 }
 
+static inline int glymur_gcc_usb4_uc_hrr_force_mem(unsigned int port, bool on)
+{
+	return -ENODEV;
+}
+
 static inline int glymur_gcc_usb4_pipe_hwcg(unsigned int port, bool enable)
 {
 	return -ENODEV;
-- 
