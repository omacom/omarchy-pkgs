From c1718016491acfa7aefb6e9b93b26b8f135605a1 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Sun, 8 Nov 2026 01:30:00 +0100
Subject: [PATCH] dt-bindings: arm: qcom: Add the Samsung Galaxy Book4 Edge
 15

The Galaxy Book4 Edge 15 (NP750XQA and NP750XQB) is a laptop on the
Snapdragon X Plus X1P-42-100 or X1-26-100 (Purwa). Add its compatible to
the X1P42100 boards.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 Documentation/devicetree/bindings/arm/qcom.yaml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Documentation/devicetree/bindings/arm/qcom.yaml b/Documentation/devicetree/bindings/arm/qcom.yaml
index 14b46e1..6ddea49 100644
--- a/Documentation/devicetree/bindings/arm/qcom.yaml
+++ b/Documentation/devicetree/bindings/arm/qcom.yaml
@@ -1309,6 +1309,7 @@ properties:
               - lenovo,ideapad-5-2in1
               - lenovo,thinkbook-16
               - qcom,x1p42100-crd
+              - samsung,galaxy-book4-edge-15
           - const: qcom,x1p42100
 
   # Board compatibles go above
-- 
2.47.3

