From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Fri, 6 Nov 2026 00:10:00 +0000
Subject: [PATCH] arm64: dts: qcom: x126100-asus-vivobook-16: Name the sound
 card after its topology

The AudioReach driver loads qcom/x1e80100/<model>-tplg.bin, and
linux-firmware ships this laptop's topology as
X1E80100-ASUS-Vivobook-16-tplg.bin, which Qualcomm builds from the
ThinkPad T14s's. With the model X126100-ASUS-Vivobook-16 the request
fails and the sound card never registers. Use the name linux-firmware
has.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 arch/arm64/boot/dts/qcom/x126100-asus-vivobook-16.dtsi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/x126100-asus-vivobook-16.dtsi b/arch/arm64/boot/dts/qcom/x126100-asus-vivobook-16.dtsi
index f61df68..32db25f 100644
--- a/arch/arm64/boot/dts/qcom/x126100-asus-vivobook-16.dtsi
+++ b/arch/arm64/boot/dts/qcom/x126100-asus-vivobook-16.dtsi
@@ -411,7 +411,7 @@ vreg_wcn_3p3: regulator-wcn-3p3 {
 
 	sound {
 		compatible = "qcom,x1e80100-sndcard";
-		model = "X126100-ASUS-Vivobook-16";
+		model = "X1E80100-ASUS-Vivobook-16";
 		audio-routing = "SpkrLeft IN", "WSA WSA_SPK1 OUT",
 						"SpkrRight IN", "WSA WSA_SPK2 OUT",
 						"IN1_HPHL", "HPHL_OUT",
-- 
