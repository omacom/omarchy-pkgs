+/*
+ * Multiport controller (ACPI USB3): the USB-A port and a second port, host
+ * only by design. ACPI I2C6 carries its two PTN3222 eUSB2 repeaters (0x43 and
+ * 0x4f), whose enable pins, TLMM 8 and 184, the firmware drives high when it
+ * powers the controller. The Linux PTN3222 driver would hold them in reset
+ * until the USB controller initialises, which cut the USB-A port's power, so
+ * the repeaters are left as the firmware configured them and are not
+ * described here.
+ */
+&usb_mp {
+	status = "okay";
+};
+
+&usb_mp_hsphy0 {
+	vdd-supply = <&vreg_l2h_e0>;
+	vdda12-supply = <&vreg_l4h_e0>;
+
+	status = "okay";
+};
+
+&usb_mp_hsphy1 {
+	vdd-supply = <&vreg_l2h_e0>;
+	vdda12-supply = <&vreg_l4h_e0>;
+
+	status = "okay";
+};
+
+&usb_mp_qmpphy0 {
+	vdda-phy-supply = <&vreg_l2h_e0>;
+	vdda-pll-supply = <&vreg_l4h_e0>;
+	refgen-supply = <&vreg_l4f_e1>;
+
+	status = "okay";
+};
+
+&usb_mp_qmpphy1 {
+	vdda-phy-supply = <&vreg_l2h_e0>;
+	vdda-pll-supply = <&vreg_l4h_e0>;
+	refgen-supply = <&vreg_l4f_e1>;
+
+	status = "okay";
+};
