From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Thu, 5 Nov 2026 21:49:50 +0000
Subject: [PATCH] arm64: dts: qcom: x126100-lenovo-ideapad-slim3: Follow the
 bindings

The tree lists the ThinkPad T14s after its own compatible, so that the
QSEECOM allowlist gives the laptop EFI variables. Drop it, since the
next patch gives the IdeaPad Slim 3x its own allowlist entry.

Add qcom,sm8550-pmic-glink between the two pmic-glink compatibles, as
the binding lists them. The TLMM binding has no input-enable, which
the pinctrl driver applies by turning the pin's output off, so give
the keyboard's interrupt pin output-disable instead.

The touchpad at 0x5d has no interrupt. It signals on GPIO 67 with the
keyboard, and i2c-hid takes its interrupt exclusively and refuses to
probe without one. Mark the touchpad disabled.

The HDMI bridge's DP endpoint needs data-lanes. Use the <3 2 1 0> the
tree has commented out. Without data-lanes the PHY runs DP on two
lanes in its default normal orientation, and this mapping is the same
orientation on all four.

PCIe3 has PERST# and WAKE# on the controller, and PCIe6a has them there
as well as on its root port. Keep them on the root ports only, where
the binding wants them and the PCI core looks for WAKE#.

Give the TCSR clock controller its reference clock supplies, which
Linux 7.4's binding requires, as the EliteBook 6 G1q tree here does.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 .../dts/qcom/x126100-lenovo-ideapad-slim3.dts | 40 ++++++++++++++-----
 1 file changed, 31 insertions(+), 9 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/x126100-lenovo-ideapad-slim3.dts b/arch/arm64/boot/dts/qcom/x126100-lenovo-ideapad-slim3.dts
index 9b57538..5aeb853 100644
--- a/arch/arm64/boot/dts/qcom/x126100-lenovo-ideapad-slim3.dts
+++ b/arch/arm64/boot/dts/qcom/x126100-lenovo-ideapad-slim3.dts
@@ -21,7 +21,7 @@
 
 / {
 	model = "Lenovo IdeaPad Slim 3 15Q8X10";
-	compatible = "lenovo,ideapad-slim3", "lenovo,thinkpad-t14s", "qcom,x126100", "qcom,x1p42100";
+	compatible = "lenovo,ideapad-slim3", "qcom,x126100", "qcom,x1p42100";
 	chassis-type = "laptop";
 
 	aliases {
@@ -117,6 +117,7 @@ hdmi_con: endpoint {
 
 	pmic-glink {
 		compatible = "qcom,x1e80100-pmic-glink",
+				"qcom,sm8550-pmic-glink",
 				"qcom,pmic-glink";
 		#address-cells = <1>;
 		#size-cells = <0>;
@@ -992,6 +993,7 @@ touchpad@5d {
 		vdd-supply = <&vreg_misc_3p3>;
 		vddl-supply = <&vreg_l12b_1p2>;
 
+		status = "disabled";
 	};
 };
 
@@ -1097,9 +1099,6 @@ &mdss_dp3_phy {
 };
 
 &pcie3 {
-	perst-gpios = <&tlmm 143 GPIO_ACTIVE_LOW>;
-	wake-gpios = <&tlmm 145 GPIO_ACTIVE_LOW>;
-
 	vddpe-3v3-supply = <&vreg_pcie3_nvme>;
 
 	pinctrl-0 = <&pcie3_default>;
@@ -1117,6 +1116,11 @@ &pcie3_phy {
 	status = "okay";
 };
 
+&pcie3_port0 {
+	reset-gpios = <&tlmm 143 GPIO_ACTIVE_LOW>;
+	wake-gpios = <&tlmm 145 GPIO_ACTIVE_LOW>;
+};
+
 &pcie4 {
 
 	pinctrl-0 = <&pcie4_default>;
@@ -1174,9 +1178,6 @@ &pcie5_port0 {
 };
 
 &pcie6a {
-	perst-gpios = <&tlmm 152 GPIO_ACTIVE_LOW>;
-	wake-gpios = <&tlmm 154 GPIO_ACTIVE_LOW>;
-
 	vddpe-3v3-supply = <&vreg_nvme>;
 
 	pinctrl-0 = <&pcie6a_default>;
@@ -1330,6 +1331,27 @@ wcd_tx: codec@0,3 {
 	};
 };
 
+&tcsr {
+	vdda-qrefrpt0-0p9-supply = <&vreg_l3c_0p8>;
+	vdda-qrefrpt1-0p9-supply = <&vreg_l3i_0p8>;
+	vdda-qrefrpt2-0p9-supply = <&vreg_l3i_0p8>;
+	vdda-qrefrpt3-0p9-supply = <&vreg_l3j_0p8>;
+	vdda-qrefrpt4-0p9-supply = <&vreg_l1d_0p8>;
+	vdda-qrefrx0-0p9-supply = <&vreg_l3c_0p8>;
+	vdda-qrefrx1-0p9-supply = <&vreg_l3i_0p8>;
+	vdda-qrefrx2-0p9-supply = <&vreg_l3i_0p8>;
+	vdda-qrefrx3-0p9-supply = <&vreg_l3j_0p8>;
+	vdda-qrefrx4-0p9-supply = <&vreg_l1d_0p8>;
+	vdda-qreftx0-0p9-supply = <&vreg_l3j_0p8>;
+	vdda-qreftx0-1p2-supply = <&vreg_l2j_1p2>;
+	vdda-qreftx1-0p9-supply = <&vreg_l3j_0p8>;
+	vdda-qreftx1-1p2-supply = <&vreg_l3e_1p2>;
+	vdda-refgen0-0p9-supply = <&vreg_l3i_0p8>;
+	vdda-refgen0-1p2-supply = <&vreg_l3e_1p2>;
+	vdda-refgen2-0p9-supply = <&vreg_l3j_0p8>;
+	vdda-refgen2-1p2-supply = <&vreg_l2j_1p2>;
+};
+
 &tlmm {
 	gpio-reserved-ranges = <34 2>, /* Unused */
 		<44 4>, /* TPM SPI */
@@ -1389,7 +1411,7 @@ kybd_default: kybd-default-state {
 		function = "gpio";
 		bias-pull-up;
 		drive-strength = <2>;
-		input-enable;
+		output-disable;
 	};
 
 	nvme_reg_en: nvme-reg-en-state {
@@ -1619,7 +1641,7 @@ port@0 {
 			usb_1_ss2_qmpphy_out_dp: endpoint@0 {
 				reg = <0>;
 
-//				data-lanes = <3 2 1 0>;
+				data-lanes = <3 2 1 0>;
 				remote-endpoint = <&hdmi_bridge_dp_in>;
 			};
 
-- 
