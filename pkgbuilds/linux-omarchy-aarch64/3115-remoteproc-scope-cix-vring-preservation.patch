From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Clay Stan <claystan97@gmail.com>
Date: Tue, 24 Nov 2026 12:15:00 +0800
Subject: [PATCH] remoteproc: scope vring preservation to CIX DSP firmware

The CIX DSP remoteproc patch removed the unconditional memset() in
rp_find_vq() because Sky1's rpmsg-lite firmware pre-initializes the shared
vrings before Linux creates the virtio device. Leaving vrings unzeroed for
all remoteproc drivers exposes stale shared memory to non-CIX firmware such
as Qualcomm's ADSP/CDSP PAS loaders on attach or restart.

Gate vring preservation behind an explicit rproc->keep_vring_contents flag
set only by cix_dsp_rproc, restoring standard vring zeroing everywhere else.

Signed-off-by: Clay Stan <claystan97@gmail.com>
---
 drivers/remoteproc/cix_dsp_rproc.c     |  1 +
 drivers/remoteproc/remoteproc_virtio.c | 12 +++++-------
 include/linux/remoteproc.h             |  2 ++
 3 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/drivers/remoteproc/cix_dsp_rproc.c b/drivers/remoteproc/cix_dsp_rproc.c
--- a/drivers/remoteproc/cix_dsp_rproc.c
+++ b/drivers/remoteproc/cix_dsp_rproc.c
@@ -867,6 +867,7 @@ static int cix_dsp_rproc_probe(struct platform_device *pdev)
 			    sizeof(*rproc_priv));
 	if (!rproc)
 		return -ENOMEM;
+	rproc->keep_vring_contents = true;
 
 	rproc_priv = rproc->priv;
 	rproc_priv->rproc = rproc;
diff --git a/drivers/remoteproc/remoteproc_virtio.c b/drivers/remoteproc/remoteproc_virtio.c
--- a/drivers/remoteproc/remoteproc_virtio.c
+++ b/drivers/remoteproc/remoteproc_virtio.c
@@ -159,15 +159,13 @@ static struct virtqueue *rp_find_vq(struct virtio_device *vdev,
 	addr = mem->va;
 	num = rvring->num;
 
-	/*
-	 * NOTE: We intentionally do NOT zero the vring here.
-	 * For rpmsg-lite firmware like CIX DSP, the firmware boots
-	 * and initializes the vrings before the kernel creates the
-	 * virtio device. Zeroing the vring would wipe out any
-	 * messages the firmware has already queued (e.g., namespace
-	 * announcements).
-	 */
+	/*
+	 * Zero vring unless the remote processor firmware (such as CIX DSP
+	 * rpmsg-lite) pre-initializes vrings before virtio device creation.
+	 */
 	size = vring_size(num, rvring->align);
+	if (!rproc->keep_vring_contents)
+		memset(addr, 0, size);
 
 	dev_dbg(dev, "vring%d: va %p qsz %d notifyid %d\n",
 		id, addr, num, rvring->notifyid);
diff --git a/include/linux/remoteproc.h b/include/linux/remoteproc.h
--- a/include/linux/remoteproc.h
+++ b/include/linux/remoteproc.h
@@ -253,6 +253,7 @@
  * @elf_machine: firmware ELF machine
  * @cdev: character device of the rproc
  * @cdev_put_on_release: flag to indicate if remoteproc should be shutdown on @char_dev release
+ * @keep_vring_contents: flag to preserve pre-initialized vring contents
  * @features: indicate remoteproc features
  */
 struct rproc {
@@ -298,6 +299,7 @@ struct rproc {
 	u16 elf_machine;
 	struct cdev cdev;
 	bool cdev_put_on_release;
+	bool keep_vring_contents;
 	DECLARE_BITMAP(features, RPROC_MAX_FEATURES);
 };
 
