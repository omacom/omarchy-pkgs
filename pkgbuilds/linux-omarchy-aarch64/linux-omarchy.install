# The device trees moved from /boot/dtbs to /usr/lib/dtbs. Omarchy's Snapdragon
# setup lists them in /etc/kernel/uki.conf by path, and the UKI rebuild that
# follows this transaction reads them from there, so point the list at the new
# place first. That also covers a list written under linux-omarchy-n1x, this
# package's old name.
_uki_dtbs_move() {
  local uki_config=/etc/kernel/uki.conf
  [[ -f $uki_config ]] && grep -q '/boot/dtbs/linux-omarchy[^/ ]*/' "$uki_config" || return 0
  sed -i 's#/boot/dtbs/linux-omarchy[^/ ]*/#/usr/lib/dtbs/linux-omarchy/#g' "$uki_config"
}

post_install() {
  _uki_dtbs_move
}

post_upgrade() {
  _uki_dtbs_move
}
