From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Thu, 5 Nov 2026 21:49:49 +0000
Subject: [PATCH] arm64: dts: qcom: x1p42100-lenovo-ideapad-5-2in1: Follow the
 bindings

The tree lists the ThinkPad T14s after its own compatible, so that the
QSEECOM allowlist gives the laptop EFI variables. Drop it, since the
next patch gives the IdeaPad 5x 2-in-1 its own allowlist entry.

Drop the camera node. No binding or driver has its
regulator-dummy-consumer compatible, and the supply it holds is
always-on already. Drop the panel's max-brightness, which neither the
edp-panel binding nor its driver has. Give the TCSR clock controller
its reference clock supplies, which Linux 7.4's binding requires, as
the EliteBook 6 G1q tree here does.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 .../qcom/x1p42100-lenovo-ideapad-5-2in1.dts   | 31 +++++++++++++------
 1 file changed, 22 insertions(+), 9 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/x1p42100-lenovo-ideapad-5-2in1.dts b/arch/arm64/boot/dts/qcom/x1p42100-lenovo-ideapad-5-2in1.dts
index 556ab06..8e6660b 100644
--- a/arch/arm64/boot/dts/qcom/x1p42100-lenovo-ideapad-5-2in1.dts
+++ b/arch/arm64/boot/dts/qcom/x1p42100-lenovo-ideapad-5-2in1.dts
@@ -21,7 +21,7 @@
 
 / {
 	model = "Lenovo IdeaPad 5 2in1 14Q8X9";
-	compatible = "lenovo,ideapad-5-2in1", "lenovo,thinkpad-t14s", "qcom,x1p42100";
+	compatible = "lenovo,ideapad-5-2in1", "qcom,x1p42100";
 	chassis-type = "laptop";
 
 	aliases {
@@ -56,12 +56,6 @@ wcd938x: audio-codec {
 		#sound-dai-cells = <1>;
 	};
 
-	camera {
-		compatible = "regulator-dummy-consumer";
-
-		vdd-supply = <&vreg_cam_5p0>;
-	};
-
 	hdmi-bridge {
 		compatible = "parade,ps185hdm";
 
@@ -1108,8 +1102,6 @@ panel {
 
 			power-supply = <&vreg_edp_3p3>;
 
-			max-brightness = <2047>;
-
 			port {
 				edp_panel_in: endpoint {
 					remote-endpoint = <&mdss_dp3_out>;
@@ -1323,6 +1315,27 @@ wcd_tx: codec@0,3 {
 	};
 };
 
+&tcsr {
+	vdda-qrefrpt0-0p9-supply = <&vreg_l3c_0p8>;
+	vdda-qrefrpt1-0p9-supply = <&vreg_l3i_0p8>;
+	vdda-qrefrpt2-0p9-supply = <&vreg_l3i_0p8>;
+	vdda-qrefrpt3-0p9-supply = <&vreg_l3j_0p8>;
+	vdda-qrefrpt4-0p9-supply = <&vreg_l1d_0p8>;
+	vdda-qrefrx0-0p9-supply = <&vreg_l3c_0p8>;
+	vdda-qrefrx1-0p9-supply = <&vreg_l3i_0p8>;
+	vdda-qrefrx2-0p9-supply = <&vreg_l3i_0p8>;
+	vdda-qrefrx3-0p9-supply = <&vreg_l3j_0p8>;
+	vdda-qrefrx4-0p9-supply = <&vreg_l1d_0p8>;
+	vdda-qreftx0-0p9-supply = <&vreg_l3j_0p8>;
+	vdda-qreftx0-1p2-supply = <&vreg_l2j_1p2>;
+	vdda-qreftx1-0p9-supply = <&vreg_l3j_0p8>;
+	vdda-qreftx1-1p2-supply = <&vreg_l3e_1p2>;
+	vdda-refgen0-0p9-supply = <&vreg_l3i_0p8>;
+	vdda-refgen0-1p2-supply = <&vreg_l3e_1p2>;
+	vdda-refgen2-0p9-supply = <&vreg_l3j_0p8>;
+	vdda-refgen2-1p2-supply = <&vreg_l2j_1p2>;
+};
+
 &tlmm {
 	gpio-reserved-ranges = <34 2>, /* Unused */
 			       <72 2>; /* Secure EC I2C connection (?) */
-- 
2.47.3

