From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nicola Nicodemo <nicola084@gmail.com>
Date: Sat, 10 Oct 2026 18:28:47 +0200
Subject: [PATCH] usb: typec: samsung-emuec: read the plug
 orientation from the CC pin

The driver takes the orientation from CC_STATUS (0x11) bits 7:4, 1 = normal,
2 = reverse. On a Galaxy Book4 Edge 14" those bits do not change with the
plug: a charger reads 1 and a USB-C hub reads 2 either way round, so they
look like the attach type (sink / source) rather than the orientation.
Register 0x12 bits 1:0 do follow the plug (1 = CC1, 2 = CC2), with bit 2
set while the port is source (charger: 0x02 / 0x01, hub: 0x06 / 0x05). As
it is, a hub or monitor always sets the SBU mux and the combo PHY for a
reversed plug.

Keep CC_STATUS bits 7:4 for attach detection and take the orientation from
0x12 bits 1:0. The register meaning is decoded from reads, not from
documentation.

Tested on the 14" (NP940XMA): port 0 now reports normal / reverse for both
a charger and a hub plugged in either way, and the SBU mux select GPIO
follows.

Signed-off-by: Nicola Nicodemo <nicola084@gmail.com>
Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 drivers/usb/typec/samsung-emuec.c | 23 +++++++++++++++++------
 1 file changed, 17 insertions(+), 6 deletions(-)

diff --git a/drivers/usb/typec/samsung-emuec.c b/drivers/usb/typec/samsung-emuec.c
index 269e9b4b4..fcb0f9ebe 100644
--- a/drivers/usb/typec/samsung-emuec.c
+++ b/drivers/usb/typec/samsung-emuec.c
@@ -39,6 +39,7 @@
 #define S2MM006_IRQ_LAST		0x07
 #define S2MM006_REG_BC_STATUS		0x0e
 #define S2MM006_REG_CC_STATUS		0x11
+#define S2MM006_REG_CC_PIN		0x12
 #define S2MM006_REG_PD_STATUS2		0x14
 #define S2MM006_REG_PD_STATUS3		0x1a
 #define S2MM006_REG_SWITCH_STATUS	0x1c
@@ -770,7 +771,7 @@ static void samsung_emuec_sync(struct work_struct *work)
 	struct samsung_emuec *pdic = container_of(to_delayed_work(work),
 						    struct samsung_emuec, work);
 	struct typec_mux_state mux_state = { .mode = TYPEC_STATE_USB };
-	u8 command, status_bit, bc, cc, pd, sw, enter_usb;
+	u8 command, status_bit, bc, cc, cc_pin, pd, sw, enter_usb;
 	struct typec_partner_desc partner_desc = {
 		.accessory = TYPEC_ACCESSORY_NONE,
 		.usb_capability = 0,
@@ -780,7 +781,7 @@ static void samsung_emuec_sync(struct work_struct *work)
 	enum typec_role power_role;
 	enum typec_data_role data_role;
 	enum usb_role usb_role;
-	bool vbus_present, source_path_attached, consumer_path_active;
+	bool vbus_present, source_path_attached, consumer_path_active, attached;
 	int ret;
 
 	guard(mutex)(&pdic->lock);
@@ -789,6 +790,9 @@ static void samsung_emuec_sync(struct work_struct *work)
 	if (ret)
 		return;
 	ret = samsung_emuec_read(pdic, S2MM006_REG_CC_STATUS, &cc, sizeof(cc));
+	if (ret)
+		return;
+	ret = samsung_emuec_read(pdic, S2MM006_REG_CC_PIN, &cc_pin, sizeof(cc_pin));
 	if (ret)
 		return;
 	ret = samsung_emuec_read(pdic, S2MM006_REG_PD_STATUS2, &pd, sizeof(pd));
@@ -802,16 +806,23 @@ static void samsung_emuec_sync(struct work_struct *work)
 	if (ret)
 		return;
 
-	orientation = (cc >> 4) == 1 ? TYPEC_ORIENTATION_NORMAL :
-		      (cc >> 4) == 2 ? TYPEC_ORIENTATION_REVERSE :
-					  TYPEC_ORIENTATION_NONE;
+	/*
+	 * CC_STATUS bits 7:4 give the attach type (1: attached as sink,
+	 * 2: as source), not the orientation: they read the same with the plug
+	 * either way round. The orientation is the CC pin in CC_PIN bits 1:0
+	 * (1: CC1, 2: CC2); bit 2 is set as source.
+	 */
+	attached = (cc >> 4) == 1 || (cc >> 4) == 2;
+	orientation = (cc_pin & 0x3) == 1 ? TYPEC_ORIENTATION_NORMAL :
+		      (cc_pin & 0x3) == 2 ? TYPEC_ORIENTATION_REVERSE :
+					     TYPEC_ORIENTATION_NONE;
 	power_role = pd & BIT(3) ? TYPEC_SOURCE : TYPEC_SINK;
 	data_role = pd & BIT(2) ? TYPEC_HOST : TYPEC_DEVICE;
 	vbus_present = bc & BIT(0);
 	source_path_attached = bc & BIT(4);
 	consumer_path_active = sw & BIT(1);
 
-	if (orientation == TYPEC_ORIENTATION_NONE) {
+	if (!attached) {
 		samsung_emuec_detach(pdic);
 		return;
 	}
