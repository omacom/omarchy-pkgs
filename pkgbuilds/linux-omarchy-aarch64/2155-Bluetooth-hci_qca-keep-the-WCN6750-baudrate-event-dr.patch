From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brandon Williams <turbine.bmw@gmail.com>
Date: Sat, 17 Oct 2026 19:52:08 -0400
Subject: [PATCH] Bluetooth: hci_qca: keep the WCN6750+ baudrate event drop to
 Denali

The previous patch makes these controllers wait up to 100 ms for a
Command Complete after a baudrate change, and fails setup without it.
That is confirmed only on the Surface Pro 11's WCN7850. Keep it to
microsoft,denali until other boards have been tested, so they keep the
upstream behaviour.

Signed-off-by: Brandon Williams <turbine.bmw@gmail.com>
---
 drivers/bluetooth/hci_qca.c | 40 ++++++++++++++++++++-----------------
 1 file changed, 22 insertions(+), 18 deletions(-)

diff --git a/drivers/bluetooth/hci_qca.c b/drivers/bluetooth/hci_qca.c
index 9aa5cad82bac..047e8a38b891 100644
--- a/drivers/bluetooth/hci_qca.c
+++ b/drivers/bluetooth/hci_qca.c
@@ -1491,6 +1491,26 @@ static int qca_check_speeds(struct hci_uart *hu)
 	return 0;
 }
 
+/*
+ * The WCN3990 answers a baudrate change with a vendor event that has to be
+ * dropped. The WCN6750, WCN6855 and WCN7850 answer with a Command Complete
+ * that needs the same treatment. That is confirmed only on the Surface Pro
+ * 11's WCN7850, so other boards keep the upstream behaviour for now.
+ */
+static bool qca_drops_baudrate_event(enum qca_btsoc_type soc_type)
+{
+	switch (soc_type) {
+	case QCA_WCN3990:
+		return true;
+	case QCA_WCN6750:
+	case QCA_WCN6855:
+	case QCA_WCN7850:
+		return of_machine_is_compatible("microsoft,denali");
+	default:
+		return false;
+	}
+}
+
 static int qca_set_speed(struct hci_uart *hu, enum qca_speed_type speed_type)
 {
 	unsigned int speed, qca_baudrate;
@@ -1527,17 +1547,9 @@ static int qca_set_speed(struct hci_uart *hu, enum qca_speed_type speed_type)
 			break;
 		}
 
-		switch (soc_type) {
-		case QCA_WCN3990:
-		case QCA_WCN6750:
-		case QCA_WCN6855:
-		case QCA_WCN7850:
+		if (qca_drops_baudrate_event(soc_type)) {
 			reinit_completion(&qca->drop_ev_comp);
 			set_bit(QCA_DROP_VENDOR_EVENT, &qca->flags);
-			break;
-
-		default:
-			break;
 		}
 
 		qca_baudrate = qca_get_baudrate_value(speed);
@@ -1565,11 +1577,7 @@ static int qca_set_speed(struct hci_uart *hu, enum qca_speed_type speed_type)
 			break;
 		}
 
-		switch (soc_type) {
-		case QCA_WCN3990:
-		case QCA_WCN6750:
-		case QCA_WCN6855:
-		case QCA_WCN7850:
+		if (qca_drops_baudrate_event(soc_type)) {
 			/* Wait for the controller to send the vendor event
 			 * for the baudrate change command.
 			 */
@@ -1581,10 +1589,6 @@ static int qca_set_speed(struct hci_uart *hu, enum qca_speed_type speed_type)
 			}
 
 			clear_bit(QCA_DROP_VENDOR_EVENT, &qca->flags);
-			break;
-
-		default:
-			break;
 		}
 	}
 
