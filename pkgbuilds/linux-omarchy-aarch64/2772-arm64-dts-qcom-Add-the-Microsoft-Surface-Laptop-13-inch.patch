index 0000000..ee3ed37
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/x1p42100-microsoft-surface-laptop-13.dts
@@ -0,0 +1,1013 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
