@@ -379,6 +413,16 @@ static int nvidia_ffa_fill_notification_map(struct nvidia_ec_ffa_device *ec_ffa_
 		if (!uuid_equal(&uuid, &ec_ffa_dev->ffa_dev->uuid))
 			continue;
 
