From 164d589ddab89fdfc8539fdab8a425ca32c66e9d Mon Sep 17 00:00:00 2001
From: Spencer Bull <spencer@omarchy.org>
Date: Sun, 4 Oct 2026 01:20:06 -0500
Subject: [PATCH] ACPI: thermal: skip the N1x PSYS and PSOC zones on the XPS 16
 and ProArt P16

The Dell XPS 16 DX16263 (NVIDIA N1x) publishes its system and SoC power
readings as the thermal zones PSYS and PSOC. Their _TMP returns
milliwatts, which reads as hundreds of degrees in every temperature
monitor. They have no trip points, so do not register them as thermal
zones on that machine.

The ASUS ProArt P16 H7607BA has the same two zones. On BIOS H7607BA.300,
a kernel without this patch registered PSYS at 117 C and PSOC at 320 C,
while its other ten zones read 19 to 60 C. Skip them there too.
---
 drivers/acpi/thermal.c | 35 +++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/drivers/acpi/thermal.c b/drivers/acpi/thermal.c
index dd7666c..f3efa09 100644
--- a/drivers/acpi/thermal.c
+++ b/drivers/acpi/thermal.c
@@ -781,6 +781,38 @@ static void acpi_thermal_zone_free(void *data)
 	kfree(tz);
 }
 
+/*
+ * The Dell XPS 16 DX16263 and the ASUS ProArt P16 H7607BA (NVIDIA N1x) have
+ * thermal zones PSYS and PSOC whose _TMP is not a temperature (on the XPS 16 it
+ * is system and SoC power in milliwatts). They read as hundreds of degrees and
+ * have no valid trip points. Do not register them as thermal zones there.
+ */
+static const struct dmi_system_id acpi_thermal_power_telemetry_dmi[] = {
+	{
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "Dell Inc."),
+			DMI_MATCH(DMI_PRODUCT_NAME, "XPS 16 DX16263"),
+		},
+	},
+	{
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "ASUS"),
+			DMI_MATCH(DMI_PRODUCT_NAME, "H7607BA"),
+		},
+	},
+	{ }
+};
+
+static bool acpi_thermal_is_power_telemetry(struct acpi_device *device)
+{
+	const char *name = acpi_device_bid(device);
+
+	if (strcmp(name, "PSYS") && strcmp(name, "PSOC"))
+		return false;
+
+	return dmi_check_system(acpi_thermal_power_telemetry_dmi);
+}
+
 static int acpi_thermal_probe(struct platform_device *pdev)
 {
 	struct thermal_trip trip_table[ACPI_THERMAL_MAX_NR_TRIPS] = { 0 };
@@ -797,6 +829,9 @@ static int acpi_thermal_probe(struct platform_device *pdev)
 	if (!device)
 		return -ENODEV;
 
+	if (acpi_thermal_is_power_telemetry(device))
+		return -ENODEV;
+
 	tz = kzalloc_obj(struct acpi_thermal);
 	if (!tz)
 		return -ENOMEM;
