 #include <linux/suspend.h>
 #include <linux/regmap.h>
@@ -55,10 +57,14 @@
 
 #define QCOM_USB4_ROUTER_SIZE		0x100000
 #define QCOM_USB4_NHI_OFFSET		0x3f000
-#define QCOM_USB4_MCU_RAM_OFFSET	0x13000
-#define QCOM_USB4_MCU_RAM_SIZE		0xf000
-#define QCOM_USB4_MCU_IRQ_ACK		0x22018
-#define QCOM_USB4_MCU_IRQ_ENABLE	0x2201c
+/* Relative to the MCU control register, on both layouts. */
+#define QCOM_USB4_MCU_IRQ_ACK		0x18
+#define QCOM_USB4_MCU_IRQ_ENABLE	0x1c
+/* Lane adapter registers the v2 router clears bits 7:6 of on MCU event 6. */
+#define QCOM_USB4_V2_LANE0_CONFIG	0x2058
+#define QCOM_USB4_V2_LANE1_CONFIG	0x3058
+#define QCOM_USB4_V2_LANE_CONFIG_MASK	GENMASK(7, 6)
+#define QCOM_USB4_MCU_EVENT_V2_LANE	6
 #define QCOM_USB4_ROUTER_STOP_FLAG	0x81018
 #define QCOM_USB4_TCSR_ROUTE		0xb004
 #define QCOM_USB4_MCU_STOP_COMMAND	4
@@ -66,7 +72,6 @@
 /* Router state saved before the MCU is halted for sleep. */
 #define QCOM_USB4_ROUTER_SLEEP_SAVE	0x81014
 #define QCOM_USB4_WAKE_STATUS		0x20a4
-#define QCOM_USB4_LANE0_STATUS		0x2050
 #define QCOM_USB4_LANE_STATE		GENMASK(29, 26)
 #define QCOM_USB4_LANE_STATE_ACTIVE	2
 #define QCOM_USB4_LINK_RESUME_TIMEOUT_MS	5000
@@ -84,6 +89,42 @@
 #define QCOM_USB4_SLEEP_STOP_MS		5000
 #define QCOM_USB4_MAX_ROUTERS		3
 
+/*
+ * What differs between the host routers. Router 1 has the v2 MCU layout; its
+ * MCU RAM size is not established beyond the end of its DROM and only bounds
+ * the event ring here.
+ */
+struct qcom_usb4_router_desc {
+	enum qcom_usb4_mcu_layout layout;
+	enum qcom_usb4_start_profile profile;
+	size_t ram_size;
+	u32 lane0_status;
+	/* Only router 0's DisplayPort IN adapters have a display owner. */
+	bool display;
+	/*
+	 * The start-up touches router registers (0xe030 and after) that reset
+	 * the SoC unless the tunnelled PCIe power domain is on as well.
+	 */
+	bool pcie_tunnel_domain;
+};
+
+static const struct qcom_usb4_router_desc qcom_usb4_routers[] = {
+	[0] = {
+		.layout = QCOM_USB4_MCU_LEGACY,
+		.profile = QCOM_USB4_START_SURFACE_A8_PORT0,
+		.ram_size = 0xf000,
+		.lane0_status = 0x2050,
+		.display = true,
+	},
+	[1] = {
+		.layout = QCOM_USB4_MCU_V2,
+		.profile = QCOM_USB4_START_SURFACE_A8_PORT1,
+		.ram_size = 0x11000,
+		.lane0_status = 0x2058,
+		.pcie_tunnel_domain = true,
+	},
+};
+
 /* Verified board facts: PS8830 board retimer on every Surface Laptop 8 port. */
