@@ -1,7 +1,16 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * Cold-start and warm-restart sequences of Glymur USB4 host router 0 with the
- * legacy MCU layout. Only the Surface Laptop 8 profile is defined.
+ * Cold-start and warm-restart sequences of the Glymur USB4 host routers:
+ * router 0 with the legacy MCU layout and router 1 with the v2 layout. Only
+ * the Surface Laptop 8 profiles are defined.
+ *
+ * The v2 router differs in four places: a memory-force bit on its
+ * microcontroller clock after the firmware upload, three other adapter bits
+ * on a cold start, a set-up routine before the MCU starts, and the router
+ * index in its DROM. The set-up routine's registers from 0xe030 on can only
+ * be accessed with the router's tunnelled PCIe power domain on: without it the
+ * access resets the SoC. The adapter bits and the set-up routine stay after
+ * PHY_COMPOSITE, where the platform's Windows driver has them.
  */
 
 #include <linux/array_size.h>
@@ -19,24 +28,68 @@ enum start_kind {
 	START_CLEAR_1200C,
 	START_UPLOAD,
 	START_DROM,
+	START_V2_SETUP,
 	START_MCU,
 	START_PRESET,
 	START_PCIE,
 	START_RESTORE_81010,
 };
 
+/* Which MCU layout an operation applies to. */
+enum start_variant {
+	START_ANY,
+	START_LEGACY,
+	START_V2,
+};
+
 struct start_operation {
 	enum qcom_usb4_start_step step;
 	enum start_kind kind;
 	u32 offset;
 	u32 mask;
 	u32 value;
+	enum start_variant variant;
 };
 
 #define PROVIDER(s) { .step = QCOM_USB4_START_##s, .kind = START_PROVIDER }
+#define PROVIDER_V2(s) \
+	{ .step = QCOM_USB4_START_##s, .kind = START_PROVIDER, .variant = START_V2 }
 #define UPDATE(s, o, m, v) { QCOM_USB4_START_##s, START_UPDATE, o, m, v }
+#define UPDATE_LEGACY(s, o, m, v) \
+	{ QCOM_USB4_START_##s, START_UPDATE, o, m, v, START_LEGACY }
