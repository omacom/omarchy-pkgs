From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 8 Oct 2026 13:55:18 -0500
Subject: [PATCH] drm/msm/dp: show DSC and FEC state in debugfs

Print whether the current mode is compressed and, if it is, its DSC
version, bits per pixel and component, slice layout and data-throttle
values, together with the sink's DSC and FEC capability and its raw DSC
DPCD block. This shows in one place why a mode was or was not
compressed.

Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/gpu/drm/msm/dp/dp_debug.c | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/drivers/gpu/drm/msm/dp/dp_debug.c b/drivers/gpu/drm/msm/dp/dp_debug.c
index cf3838fcd15..5d5ebcb7bc8 100644
--- a/drivers/gpu/drm/msm/dp/dp_debug.c
+++ b/drivers/gpu/drm/msm/dp/dp_debug.c
@@ -66,6 +66,26 @@ static int msm_dp_debug_show(struct seq_file *seq, void *p)
 			drm_mode->clock);
 	seq_printf(seq, "\t\tbpp = %d\n",
 			debug->panel->msm_dp_mode.bpp);
+	seq_printf(seq, "\t\tdsc = %d\n", debug->panel->msm_dp_mode.dsc_en);
+	if (debug->panel->msm_dp_mode.dsc_en) {
+		const struct drm_dsc_config *dsc = &debug->panel->msm_dp_mode.dsc;
+		const struct msm_dp_dsc_params *dp = &debug->panel->msm_dp_mode.dsc_params;
+
+		seq_printf(seq, "\t\tdsc version = %d.%d\n",
+			   dsc->dsc_version_major, dsc->dsc_version_minor);
+		seq_printf(seq, "\t\tdsc bpp = %d bpc = %d\n",
+			   dsc->bits_per_pixel >> 4, dsc->bits_per_component);
+		seq_printf(seq, "\t\tdsc slices = %d x %dx%d chunk %d\n",
+			   dsc->slice_count, dsc->slice_width, dsc->slice_height,
+			   dsc->slice_chunk_size);
+		seq_printf(seq, "\t\tdsc dto = %d/%d count %d extra %d eol %d\n",
+			   dp->dto_n, dp->dto_d, dp->pclk_per_line, dp->extra_width,
+			   dp->eol_byte_num);
+	}
+	seq_printf(seq, "\tdp_sink:\n\t\tdsc_capable = %d fec_capable = %d\n",
+		   debug->panel->dsc_capable, debug->panel->fec_capable);
+	seq_printf(seq, "\t\tdsc_dpcd = %*ph\n",
+		   (int)sizeof(debug->panel->dsc_dpcd), debug->panel->dsc_dpcd);
 
 	/* Link Information */
 	seq_printf(seq, "\tdp_link:\n\t\ttest_requested = %d\n",
-- 
2.56.0

