From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Clay Stan <claystan97@gmail.com>
Date: Fri, 27 Nov 2026 07:26:28 +0000
Subject: [PATCH] cix: irqchip: sky1-pdc: fix __init section, rebind, and
 error-path UAF

sky1_acpi_pdc_irqchip_init() was marked __init even though pdc_probe() invokes it from a platform_driver probe path. After init memory is freed, a deferred probe or sysfs rebind of CIXHA019 jumps into freed .init.text. In addition, the devm_ioremap_resource() failure path freed cd before reading PTR_ERR(cd->pdc_base), and the !domain failure path manually called iounmap() on devm-managed memory.

Remove __init from sky1_acpi_pdc_irqchip_init(), set .suppress_bind_attrs = true on pdc_platform_driver since the built-in irqchip driver registers a global irq_domain and syscore entry with no remove path, save PTR_ERR(cd->pdc_base) before kfree(cd), and drop the redundant iounmap().

Signed-off-by: Clay Stan <claystan97@gmail.com>
---
 drivers/irqchip/irq-sky1-pdc.c | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/drivers/irqchip/irq-sky1-pdc.c b/drivers/irqchip/irq-sky1-pdc.c
index f041e81..ba81d11 100644
--- a/drivers/irqchip/irq-sky1-pdc.c
+++ b/drivers/irqchip/irq-sky1-pdc.c
@@ -206,10 +206,11 @@ static int __init sky1_pdc_irqchip_init(struct device_node *node,
 }
 
 #ifdef CONFIG_ACPI
-static int __init sky1_acpi_pdc_irqchip_init(struct platform_device *pdev)
+static int sky1_acpi_pdc_irqchip_init(struct platform_device *pdev)
 {
 	struct irq_domain *domain;
 	struct pdcv1_irqchip_data *cd;
+	int ret;
 
 	cd = kzalloc(sizeof(struct pdcv1_irqchip_data), GFP_KERNEL);
 	if (!cd) {
@@ -221,16 +222,16 @@ static int __init sky1_acpi_pdc_irqchip_init(struct platform_device *pdev)
 	struct resource *res_dp = platform_get_resource(pdev, IORESOURCE_MEM, 0);
 	cd->pdc_base = devm_ioremap_resource(&pdev->dev, res_dp);
 	if (IS_ERR(cd->pdc_base)) {
+		ret = PTR_ERR(cd->pdc_base);
 		pr_err("%pACPI: unable to map pdc registers\n", pdev);
 		kfree(cd);
-		return PTR_ERR(cd->pdc_base);
+		return ret;
 	}
 
 	domain = acpi_irq_create_hierarchy(0, PDC_MAX_IRQS, pdev->dev.fwnode,
 					   &pdcv1_irqchip_data_domain_ops, cd);
 
 	if (!domain) {
-		iounmap(cd->pdc_base);
 		kfree(cd);
 		return -ENOMEM;
 	}
@@ -257,7 +258,8 @@ static struct platform_driver pdc_platform_driver = {
 	.probe = pdc_probe,
 	.driver = { .name = "sky1-pdc",
 		    .owner = THIS_MODULE,
-		    .acpi_match_table = ACPI_PTR(pdcv1_acpi_match) },
+		    .acpi_match_table = ACPI_PTR(pdcv1_acpi_match),
+		    .suppress_bind_attrs = true },
 };
 
 static int __init sky1_pdc_init(void) {
-- 
