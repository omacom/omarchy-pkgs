From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 8 Oct 2026 18:56:57 -0500
Subject: [PATCH] drm/msm/dp: keep the LINK_RATE_SET index in step with the
 link rate

Now that the link parameters carry the eDP 1.4 rate-set selection, three
paths can leave the table index and the link rate out of step:

- msm_dp_ctrl_link_rate_down_shift() walks the rate table whenever
  rate_set is not 0, also for sinks set up through LINK_BW_SET, where it
  can step to an intermediate table rate that has no LINK_BW_SET code.
- msm_dp_ctrl_link_lane_down_shift() restores the starting rate but
  keeps the lowered table index, so the sink is set to a lower rate than
  the PHY.
- A compliance test request sets the rate from a LINK_BW_SET code but
  leaves use_rate_set, so the old table index is written instead.

Walk the table only for sinks set up through LINK_RATE_SET, stopping at
its first entry. Restore the table index with the rate when the lane
count drops. Select the rate of a compliance test request through
LINK_BW_SET.

Fixes: ed100aa239be ("drm/msm/dp: Enable support for eDP v1.4+ link rates table")
Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/gpu/drm/msm/dp/dp_ctrl.c | 12 +++++++++---
 drivers/gpu/drm/msm/dp/dp_link.c |  3 +++
 2 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 1883c0d2b8a..7b38e0fd88f 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -1511,9 +1511,14 @@ static int msm_dp_ctrl_link_rate_down_shift(struct msm_dp_ctrl_private *ctrl)
 	int ret = 0;
 	struct msm_dp_link_info *link_params = &ctrl->link->link_params;
 
-	if (link_params->rate_set) {
-		--link_params->rate_set;
-		link_params->rate = link_params->supported_rates[link_params->rate_set];
+	if (link_params->use_rate_set) {
+		/* Step down the sink's rate table, which rate_set indexes */
+		if (link_params->rate_set) {
+			--link_params->rate_set;
+			link_params->rate = link_params->supported_rates[link_params->rate_set];
+		} else {
+			ret = -EINVAL;
+		}
 	} else {
 		switch (link_params->rate) {
 		case 810000:
@@ -1549,6 +1554,7 @@ static int msm_dp_ctrl_link_lane_down_shift(struct msm_dp_ctrl_private *ctrl,
 
 	ctrl->link->link_params.num_lanes /= 2;
 	ctrl->link->link_params.rate = panel->link_info.rate;
+	ctrl->link->link_params.rate_set = panel->link_info.rate_set;
 
 	ctrl->link->phy_params.p_level = 0;
 	ctrl->link->phy_params.v_level = 0;
diff --git a/drivers/gpu/drm/msm/dp/dp_link.c b/drivers/gpu/drm/msm/dp/dp_link.c
index 34a91e194a1..a46806da218 100644
--- a/drivers/gpu/drm/msm/dp/dp_link.c
+++ b/drivers/gpu/drm/msm/dp/dp_link.c
@@ -762,6 +762,8 @@ static int msm_dp_link_process_link_training_request(struct msm_dp_link_private
 	link->msm_dp_link.link_params.num_lanes = link->request.test_lane_count;
 	link->msm_dp_link.link_params.rate =
 		drm_dp_bw_code_to_link_rate(link->request.test_link_rate);
+	/* The test gives the rate as a LINK_BW_SET code */
+	link->msm_dp_link.link_params.use_rate_set = false;
 
 	return 0;
 }
@@ -900,6 +902,7 @@ static int msm_dp_link_process_phy_test_pattern_request(
 	link->msm_dp_link.link_params.num_lanes = link->request.test_lane_count;
 	link->msm_dp_link.link_params.rate =
 		drm_dp_bw_code_to_link_rate(link->request.test_link_rate);
+	link->msm_dp_link.link_params.use_rate_set = false;
 
 	msm_dp_link_parse_vx_px(link);
 
-- 
2.56.0

