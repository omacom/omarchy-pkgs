From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 8 Oct 2026 15:50:57 -0500
Subject: [PATCH] thunderbolt: Register the Qualcomm USB4 drivers from the
 module init

The Qualcomm USB4 host router glue and its DisplayPort provider are
built into the thunderbolt module when CONFIG_USB4_QCOM is set, and a
module has only one init function. Register both platform drivers from
nhi_init() after the PCI driver, and unregister them in reverse order on
failure and in nhi_unload().

CONFIG_USB4_QCOM and the two drivers are added later in this series,
the DisplayPort driver with the DisplayPort IN adapter and the host
driver with the host router driver. Until then this code is not built.

Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/thunderbolt/nhi.h |  6 ++++++
 drivers/thunderbolt/pci.c | 27 +++++++++++++++++++++++++--
 2 files changed, 31 insertions(+), 2 deletions(-)

diff --git a/drivers/thunderbolt/nhi.h b/drivers/thunderbolt/nhi.h
index d083d0487ed..682612c0c69 100644
--- a/drivers/thunderbolt/nhi.h
+++ b/drivers/thunderbolt/nhi.h
@@ -46,6 +46,12 @@ void nhi_remove(struct tb_nhi *nhi);
 void nhi_shutdown(struct tb_nhi *nhi);
 extern const struct dev_pm_ops nhi_pm_ops;
 
+#if IS_ENABLED(CONFIG_USB4_QCOM)
+struct platform_driver;
+extern struct platform_driver qcom_usb4_host_driver;
+extern struct platform_driver qcom_usb4_dp_driver;
+#endif
+
 /**
  * struct tb_nhi_ops - NHI specific optional operations
  * @init: NHI specific initialization
diff --git a/drivers/thunderbolt/pci.c b/drivers/thunderbolt/pci.c
index fde7d93bd6e..73e08223cbe 100644
--- a/drivers/thunderbolt/pci.c
+++ b/drivers/thunderbolt/pci.c
@@ -14,6 +14,7 @@
 #include <linux/interrupt.h>
 #include <linux/iommu.h>
 #include <linux/module.h>
+#include <linux/platform_device.h>
 #include <linux/delay.h>
 #include <linux/property.h>
 #include <linux/string_helpers.h>
@@ -620,14 +621,36 @@ static int __init nhi_init(void)
 		return ret;
 
 	ret = pci_register_driver(&nhi_driver);
-	if (ret)
+	if (ret) {
 		tb_domain_exit();
+		return ret;
+	}
 
-	return ret;
+#if IS_ENABLED(CONFIG_USB4_QCOM)
+	ret = platform_driver_register(&qcom_usb4_dp_driver);
+	if (ret) {
+		pci_unregister_driver(&nhi_driver);
+		tb_domain_exit();
+		return ret;
+	}
+	ret = platform_driver_register(&qcom_usb4_host_driver);
+	if (ret) {
+		platform_driver_unregister(&qcom_usb4_dp_driver);
+		pci_unregister_driver(&nhi_driver);
+		tb_domain_exit();
+		return ret;
+	}
+#endif
+
+	return 0;
 }
 
 static void __exit nhi_unload(void)
 {
+#if IS_ENABLED(CONFIG_USB4_QCOM)
+	platform_driver_unregister(&qcom_usb4_host_driver);
+	platform_driver_unregister(&qcom_usb4_dp_driver);
+#endif
 	pci_unregister_driver(&nhi_driver);
 	tb_domain_exit();
 }
