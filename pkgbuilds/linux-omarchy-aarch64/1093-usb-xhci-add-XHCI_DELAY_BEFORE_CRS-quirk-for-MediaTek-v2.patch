From a9ff24715a98cd2080309a0afc98aac49ae13309 Mon Sep 17 00:00:00 2001
From: xin lin <xin.lin@mediatek.com>
Date: Wed, 9 Sep 2026 15:26:23 +0800
Subject: [PATCH 4/6] NVIDIA: SAUCE: usb: xhci: add XHCI_DELAY_BEFORE_CRS quirk
 for MediaTek v2

BugLink: https://bugs.launchpad.net/bugs/2167884

xhci_restore_registers() triggers asynchronous DRAM reads during resume.
On MediaTek v2 platforms, the Controller Restore State operation can start
before those reads complete, causing the controller to time out while
restoring its state.

Add XHCI_DELAY_BEFORE_CRS and insert a 2 ms delay in xhci_resume() between
register restoration and the CRS write. Enable the quirk only for the
MediaTek v2 platform so other controllers do not pay the delay.

Signed-off-by: xin lin <xin.lin@mediatek.com>
Signed-off-by: Bharat Dintakurti <bdintakurti@nvidia.com>
Acked-by: Emily Soto <emilys@nvidia.com>
Acked-by: Jamie Nguyen <jamien@nvidia.com>
Acked-by: Carol L Soto <csoto@nvidia.com>
Signed-off-by: Brad Figg <bfigg@nvidia.com>
---
 drivers/usb/host/xhci-plat.c | 1 +
 drivers/usb/host/xhci.c      | 7 +++++++
 drivers/usb/host/xhci.h      | 1 +
 3 files changed, 9 insertions(+)

diff --git a/drivers/usb/host/xhci-plat.c b/drivers/usb/host/xhci-plat.c
index 07a5388..7316315 100644
--- a/drivers/usb/host/xhci-plat.c
+++ b/drivers/usb/host/xhci-plat.c
@@ -789,6 +789,7 @@ EXPORT_SYMBOL_GPL(xhci_plat_pm_ops);
 #ifdef CONFIG_ACPI
 #if IS_ENABLED(CONFIG_USB_XHCI_MTK_V2)
 static const struct xhci_plat_priv xhci_plat_mtk_v2 = {
+	.quirks = XHCI_DELAY_BEFORE_CRS,
 	.is_mtk_v2 = 1,
 };
 #endif
diff --git a/drivers/usb/host/xhci.c b/drivers/usb/host/xhci.c
index 50cbd74..5552d71 100644
--- a/drivers/usb/host/xhci.c
+++ b/drivers/usb/host/xhci.c
@@ -1142,6 +1142,13 @@ int xhci_resume(struct xhci_hcd *xhci, bool power_lost, bool is_auto_resume)
 		xhci_restore_registers(xhci);
 		/* step 2: initialize command ring buffer */
 		xhci_set_cmd_ring_deq(xhci);
+		if (xhci->quirks & XHCI_DELAY_BEFORE_CRS) {
+			/*
+			 * Allow DRAM reads triggered by register restoration to
+			 * complete before setting CRS.
+			 */
+			mdelay(2);
+		}
 		/* step 3: restore state and start state*/
 		/* step 3: set CRS flag */
 		command = readl(&xhci->op_regs->command);
diff --git a/drivers/usb/host/xhci.h b/drivers/usb/host/xhci.h
index 3915f33..9ebc6e9 100644
--- a/drivers/usb/host/xhci.h
+++ b/drivers/usb/host/xhci.h
@@ -1649,6 +1649,7 @@ struct xhci_hcd {
 #define XHCI_ETRON_HOST	BIT_ULL(49)
 #define XHCI_LIMIT_ENDPOINT_INTERVAL_9 BIT_ULL(50)
 #define XHCI_NVIDIA_MT8901_HOST		BIT_ULL(51)
+#define XHCI_DELAY_BEFORE_CRS		BIT_ULL(52)
 
 	unsigned int		num_active_eps;
 	unsigned int		limit_active_eps;
-- 
