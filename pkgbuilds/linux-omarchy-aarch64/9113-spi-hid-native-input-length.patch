Subject: [PATCH] HID: spi-hid: keep decoded input lengths in CPU byte order

The input-body parser uses get_unaligned_le16(), which returns a CPU-
endian value. Store it in a private decoded structure with u16 fields,
rather than the packed wire structure whose length is __le16. Keep
the shared wire ABI and wire-size calculations unchanged.

---
diff --git a/drivers/hid/spi-hid/spi-hid-core.c b/drivers/hid/spi-hid/spi-hid-core.c
index e92745e..e8fc189 100644
--- a/drivers/hid/spi-hid/spi-hid-core.c
+++ b/drivers/hid/spi-hid/spi-hid-core.c
@@ -106,6 +106,13 @@ struct spi_hid_input_header {
 	u8 sync_const;
 };
 
+/* Decoded input body fields are in CPU byte order, not the packed wire ABI. */
+struct spi_hid_input_body {
+	u8 input_report_type;
+	u16 content_len;
+	u8 content_id;
+};
+
 /* Processed data from an input report */
 struct spi_hid_input_report {
 	u8 report_type;
@@ -197,7 +204,7 @@ static void spi_hid_populate_input_header(const u8 *buf,
 }
 
 static void spi_hid_populate_input_body(const u8 *buf,
-					struct input_report_body_header *body)
+					struct spi_hid_input_body *body)
 {
 	body->input_report_type = buf[0];
 	body->content_len = get_unaligned_le16(&buf[1]);
@@ -208,7 +215,7 @@ static void spi_hid_input_report_prepare(struct spi_hid_input_buf *buf,
 					 struct spi_hid_input_report *report)
 {
 	struct spi_hid_input_header header;
-	struct input_report_body_header body;
+	struct spi_hid_input_body body;
 
 	spi_hid_populate_input_header(buf->header, &header);
 	spi_hid_populate_input_body(buf->body, &body);
@@ -693,7 +700,7 @@ static int spi_hid_input_report_handler(struct spi_hid *shid,
 }
 
 static void spi_hid_response_handler(struct spi_hid *shid,
-				     struct input_report_body_header *body)
+				     struct spi_hid_input_body *body)
 {
 	trace_spi_hid_response_handler(shid);
 
@@ -885,7 +892,7 @@ static int spi_hid_process_input_report(struct spi_hid *shid,
 					struct spi_hid_input_buf *buf)
 {
 	struct spi_hid_input_header header;
-	struct input_report_body_header body;
+	struct spi_hid_input_body body;
 	struct device *dev = &shid->spi->dev;
 	struct hidspi_dev_descriptor *raw;
 
