From d09991adf3f96a679d2cc82c0c427655606f592a Mon Sep 17 00:00:00 2001
From: Ryan Hughes <ryan@heyoodle.com>
Date: Sat, 3 Oct 2026 15:50:45 -0400
Subject: [PATCH 1080/1081] thunderbolt: keep the NVIDIA N1x routers awake in
 system sleep

The software connection manager asks every router to sleep on system
suspend. A router only leaves sleep through the reset it gets when the
host interface is powered off, as a PCI host interface is in system
sleep, and the connection manager reconfigures the routers from scratch
on resume.

The N1x host interfaces are platform devices that stay powered through
suspend to idle, and the SSPM cannot bring a host router back once it
has been powered down. A host router with a device connected was then
left in sleep after resume and no longer answered the control channel,
so the device and its tunnels were lost until it was unplugged twice:

  thunderbolt-platform NVDA8100:02: 0: timeout writing config space 2 to 0x1
  thunderbolt-platform NVDA8100:02: 0: failed to restore TMU configuration

Add a quirk for the N1x host router that keeps the routers of its domain
out of sleep in system sleep. Wakes are still configured, and resume
reconfigures awake routers just as it does reset ones.
---
 drivers/thunderbolt/quirks.c | 12 ++++++++++++
 drivers/thunderbolt/switch.c |  8 ++++++++
 drivers/thunderbolt/tb.h     |  2 ++
 3 files changed, 22 insertions(+)

diff --git a/drivers/thunderbolt/quirks.c b/drivers/thunderbolt/quirks.c
index cc6938a789..801b9472a4 100644
--- a/drivers/thunderbolt/quirks.c
+++ b/drivers/thunderbolt/quirks.c
@@ -30,6 +30,12 @@ static void quirk_clx_disable(struct tb_switch *sw)
 	tb_sw_dbg(sw, "disabling CL states\n");
 }
 
+static void quirk_no_system_sleep(struct tb_switch *sw)
+{
+	sw->quirks |= QUIRK_NO_SYSTEM_SLEEP;
+	tb_sw_dbg(sw, "keeping routers awake in system sleep\n");
+}
+
 static void quirk_usb3_maximum_bandwidth(struct tb_switch *sw)
 {
 	struct tb_port *port;
@@ -120,6 +126,12 @@ static const struct tb_quirk tb_quirks[] = {
 	 * training and keeps dropping HPD.
 	 */
 	{ 0x0955, 0x1372, 0x0000, 0x0000, quirk_clx_disable },
+	/*
+	 * The NVIDIA N1x keeps its host routers powered through system sleep,
+	 * so a router asked to sleep never gets the reset that brings it back
+	 * and stops answering once a device is connected.
+	 */
+	{ 0x0955, 0x1372, 0x0000, 0x0000, quirk_no_system_sleep },
 };
 
 /**
diff --git a/drivers/thunderbolt/switch.c b/drivers/thunderbolt/switch.c
index a830c82bb9..b3c0cba6ca 100644
--- a/drivers/thunderbolt/switch.c
+++ b/drivers/thunderbolt/switch.c
@@ -3673,6 +3673,14 @@ void tb_switch_suspend(struct tb_switch *sw, bool runtime)
 
 	tb_switch_set_wake(sw, flags, runtime);
 
+	/*
+	 * A router leaves sleep through the reset it gets when the host
+	 * interface is powered off. Where that does not happen in system
+	 * sleep, keep the routers awake instead.
+	 */
+	if (!runtime && (sw->tb->root_switch->quirks & QUIRK_NO_SYSTEM_SLEEP))
+		return;
+
 	if (tb_switch_is_usb4(sw))
 		usb4_switch_set_sleep(sw);
 	else
diff --git a/drivers/thunderbolt/tb.h b/drivers/thunderbolt/tb.h
index ec9192b61b..8e1fd42a9c 100644
--- a/drivers/thunderbolt/tb.h
+++ b/drivers/thunderbolt/tb.h
@@ -26,6 +26,8 @@
 #define QUIRK_NO_CLX					BIT(1)
 /* Need to keep power on while USB4 port is in redrive mode */
 #define QUIRK_KEEP_POWER_IN_DP_REDRIVE			BIT(2)
+/* Host interface keeps its power in system sleep, so routers cannot sleep */
+#define QUIRK_NO_SYSTEM_SLEEP				BIT(3)
 
 /**
  * struct tb_nvm - Structure holding NVM information
