From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Clay Stan <claystan97@gmail.com>
Date: Tue, 24 Nov 2026 12:05:00 +0800
Subject: [PATCH] ACPI: thermal: keep generic thermal zone names

Use the vendor's ACPI bus ID only for Sky1. Preserve the existing
acpitz sysfs type for other machines with the shared ARM kernel.

Signed-off-by: Clay Stan <claystan97@gmail.com>
---
diff --git a/drivers/acpi/thermal.c b/drivers/acpi/thermal.c
--- a/drivers/acpi/thermal.c
+++ b/drivers/acpi/thermal.c
@@ -707,7 +707,8 @@
 					      unsigned int trip_count,
 					      int passive_delay)
 {
-	const char *tz_type = acpi_device_bid(tz->device);
+	bool sky1 = cix_sky1_acpi();
+	const char *tz_type = sky1 ? acpi_device_bid(tz->device) : "acpitz";
 #ifdef CONFIG_CIX_THERMAL
 	struct thermal_zone_params tzp = {};
 #endif
@@ -715,7 +716,7 @@
 	int result;
 
 #ifdef CONFIG_CIX_THERMAL
-	if (cix_sky1_acpi()) {
+	if (sky1) {
 		tzp.sustainable_power = tz->sustainable_power;
 		params = &tzp;
 	}
