From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Tue, 17 Nov 2026 13:02:12 +0000
Subject: [PATCH] platform: arm64: samsung-galaxybook-ec: Report a 1
 mA discharge current

The battery current is signed by the charge state and then compared
with -1, the marker for an unknown reading. A discharge of 1 mA is -1 mA
once signed, so it was taken as unknown: it skipped the conversion to
microamps and CURRENT_NOW returned -ENODATA.

Convert the reading before it can meet the marker, and set the marker
only for the EC's 0xffff.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 drivers/platform/arm64/samsung-galaxybook-ec.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/drivers/platform/arm64/samsung-galaxybook-ec.c b/drivers/platform/arm64/samsung-galaxybook-ec.c
index 50292b649..e36f53c15 100644
--- a/drivers/platform/arm64/samsung-galaxybook-ec.c
+++ b/drivers/platform/arm64/samsung-galaxybook-ec.c
@@ -356,19 +356,22 @@ static int galaxybook_battery_refresh(struct samsung_galaxybook_ec *ec,
 		data->voltage_now = -1;
 	if (data->voltage_min_design == 0xffff)
 		data->voltage_min_design = -1;
-	if (current_ma == 0xffff)
-		current_ma = -1;
 	if (data->cycle_count == 0xffff)
 		data->cycle_count = -1;
 
-	if (current_ma >= 0) {
+	/*
+	 * Keep the unknown marker apart from the reading: a discharge of 1 mA
+	 * is -1 mA once signed, which is also the marker.
+	 */
+	if (current_ma == 0xffff) {
+		data->current_now = -1;
+	} else {
 		current_ma = abs((s16)current_ma);
 		if (data->status == POWER_SUPPLY_STATUS_DISCHARGING)
 			current_ma = -current_ma;
+		data->current_now = current_ma * 1000;
 	}
 
-	data->current_now = current_ma;
-
 	/* EC units are mAh, mV and mA; power_supply uses micro units. */
 	if (data->charge_now >= 0)
 		data->charge_now *= 1000;
@@ -380,8 +383,6 @@ static int galaxybook_battery_refresh(struct samsung_galaxybook_ec *ec,
 		data->voltage_now *= 1000;
 	if (data->voltage_min_design >= 0)
 		data->voltage_min_design *= 1000;
-	if (current_ma != -1)
-		data->current_now *= 1000;
 
 	return 0;
 }
