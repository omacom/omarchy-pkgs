From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 12 Nov 2026 11:43:12 -0600
Subject: [PATCH 2768/2769] platform/surface: aggregator_registry: Add the RTC
 on the Surface Laptop 8

The Surface Laptop 8 keeps its real-time clock in SAM. Its ACPI time
device (SRTC, ACPI000E) has no _GRT or _SRT; Windows reaches the clock
through SAM, and the PMIC RTC's UEFI offset variable does not exist on
this firmware. SAM answers the clock requests rtc-surface uses (target
category 0x01, get and set Unix timestamp), so add the RTC device for
it.

The laptop used the Surface Laptop 7's group. Give it its own group, the
same devices plus the RTC, so the Laptop 7, which is untested, keeps its
devices as they are.

Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 .../surface/surface_aggregator_registry.c     | 20 +++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/drivers/platform/surface/surface_aggregator_registry.c b/drivers/platform/surface/surface_aggregator_registry.c
index c33699a..69543f5 100644
--- a/drivers/platform/surface/surface_aggregator_registry.c
+++ b/drivers/platform/surface/surface_aggregator_registry.c
@@ -95,6 +95,12 @@ static const struct software_node ssam_node_tmp_sensors = {
 	.parent = &ssam_node_root,
 };
 
+/* Real-time clock. */
+static const struct software_node ssam_node_sam_rtc = {
+	.name = "ssam:01:01:01:00:00",
+	.parent = &ssam_node_root,
+};
+
 /* Fan speed function. */
 static const struct software_node ssam_node_fan_speed = {
 	.name = "ssam:01:05:01:01:01",
@@ -313,6 +319,16 @@ static const struct software_node *ssam_node_group_sl7[] = {
 	NULL,
 };
 
+/* Devices for Surface Laptop 8. */
+static const struct software_node *ssam_node_group_sl8[] = {
+	&ssam_node_root,
+	&ssam_node_sam_rtc,
+	&ssam_node_tmp_perf_profile_with_fan,
+	&ssam_node_fan_speed,
+	&ssam_node_hid_sam_keyboard,
+	NULL,
+};
+
 /* Devices for Surface Laptop Studio 1. */
 static const struct software_node *ssam_node_group_sls1[] = {
 	&ssam_node_root,
@@ -529,9 +545,9 @@ static const struct of_device_id ssam_platform_hub_of_match[] __maybe_unused = {
 	{ .compatible = "microsoft,romulus13", (void *)ssam_node_group_sl7 },
 	{ .compatible = "microsoft,romulus15", (void *)ssam_node_group_sl7 },
 	/* Surface Laptop 8th Edition (13.8") */
-	{ .compatible = "microsoft,surface-laptop-8-13p8", (void *)ssam_node_group_sl7 },
+	{ .compatible = "microsoft,surface-laptop-8-13p8", (void *)ssam_node_group_sl8 },
 	/* Surface Laptop 8th Edition (15") */
-	{ .compatible = "microsoft,surface-laptop-8-15", (void *)ssam_node_group_sl7 },
+	{ .compatible = "microsoft,surface-laptop-8-15", (void *)ssam_node_group_sl8 },
 	{ },
 };
 
