diff --git a/include/linux/soc/cix/sky1.h b/include/linux/soc/cix/sky1.h
new file mode 100644
--- /dev/null
+++ b/include/linux/soc/cix/sky1.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_SOC_CIX_SKY1_H
+#define _LINUX_SOC_CIX_SKY1_H
+
+#include <linux/acpi.h>
+
+static inline acpi_status cix_sky1_acpi_match(acpi_handle handle, u32 level,
+					      void *context, void **retval)
+{
+	*(bool *)context = true;
+	return AE_CTRL_TERMINATE;
+}
+
+/*
+ * CIXHA006 is the Sky1 ACPI SCMI controller, not a driver-registration test.
+ * Unlike acpi_dev_present(), this namespace walk also works before the ACPI
+ * device-bus scan. ACPICA is initialized before driver initcalls, and the
+ * walker serializes the namespace and filters matching devices through _STA.
+ * Do not cache an early miss: a later lookup must see a newly loaded table.
+ */
+static inline bool cix_sky1_acpi(void)
+{
+	bool found = false;
+
+	if (acpi_disabled)
+		return false;
+
+	acpi_get_devices("CIXHA006", cix_sky1_acpi_match, &found, NULL);
+	return found;
+}
+
+static inline bool cix_sky1_thermal(void)
+{
+	return IS_ENABLED(CONFIG_CIX_THERMAL) && cix_sky1_acpi();
+}
+
+#endif /* _LINUX_SOC_CIX_SKY1_H */
