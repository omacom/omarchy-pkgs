From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Sat, 14 Nov 2026 22:15:04 +0000
Subject: [PATCH] platform/surface: aggregator_registry: Add the Snapdragon X2
 Surfaces

Add the Surface Pro 12th Edition (13"), the Surface Pro 12in 2nd
Edition and the Surface Laptop 13in 2nd Edition, whose device trees
name them "microsoft,surface-pro-12th-edition",
"microsoft,surface-pro-12in-2nd-edition" and
"microsoft,surface-laptop-13in-2nd-edition".

Their ACPI tables, from Microsoft's firmware updates, describe the
same SAM clients as the Surface Laptop 8: the RTC (SRTC, MSHW0217,
depending on SSH), and a pmic_glink battery and power source that
return 0 from _STA, so the battery and charger come from SAM. The two
Pros keep their predecessors' type cover devices, and the 12in, which
has no FAN0, gets no fan or fan-dependent profile. The laptop's
keyboard and touchpad are on USB, as on the first edition, so its
group has no HID devices.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 .../surface/surface_aggregator_registry.c     | 62 +++++++++++++++++++
 1 file changed, 62 insertions(+)

diff --git a/drivers/platform/surface/surface_aggregator_registry.c b/drivers/platform/surface/surface_aggregator_registry.c
index b07fbc6..a7c1d52 100644
--- a/drivers/platform/surface/surface_aggregator_registry.c
+++ b/drivers/platform/surface/surface_aggregator_registry.c
@@ -463,6 +463,62 @@ static const struct software_node *ssam_node_group_sp12in[] = {
 	NULL,
 };
 
+/*
+ * Devices for the Snapdragon X2 Surfaces. Their firmware disables the
+ * pmic_glink battery and power source for Windows (_STA returns 0) and
+ * keeps the time in SAM (SRTC, MSHW0217), as on the Surface Laptop 8.
+ */
+
+/* Devices for Surface Pro 12th Edition (13", ARM/QCOM) */
+static const struct software_node *ssam_node_group_sp12e[] = {
+	&ssam_node_root,
+	&ssam_node_hub_kip,
+	&ssam_node_sam_rtc,
+	&ssam_node_bat_ac,
+	&ssam_node_bat_main,
+	&ssam_node_tmp_perf_profile_with_fan,
+	&ssam_node_tmp_sensors,
+	&ssam_node_fan_speed,
+	&ssam_node_hid_kip_keyboard,
+	&ssam_node_hid_kip_penstash,
+	&ssam_node_hid_kip_touchpad,
+	&ssam_node_hid_kip_fwupd,
+	&ssam_node_hid_kip_oobpair,
+	&ssam_node_hid_sam_sensors,
+	&ssam_node_kip_tablet_switch,
+	NULL,
+};
+
+/* Devices for Surface Pro 12" second edition (ARM/QCOM), which has no fan */
+static const struct software_node *ssam_node_group_sp12in2[] = {
+	&ssam_node_root,
+	&ssam_node_hub_kip,
+	&ssam_node_sam_rtc,
+	&ssam_node_bat_ac,
+	&ssam_node_bat_main,
+	&ssam_node_tmp_sensors,
+	&ssam_node_hid_kip_keyboard,
+	&ssam_node_hid_sam_penstash,
+	&ssam_node_hid_kip_touchpad,
+	&ssam_node_hid_kip_fwupd,
+	&ssam_node_pos_tablet_switch,
+	NULL,
+};
+
+/*
+ * Devices for Surface Laptop 13" second edition (ARM/QCOM). Its keyboard
+ * and touchpad are on USB, as on the first edition.
+ */
+static const struct software_node *ssam_node_group_sl13in2[] = {
+	&ssam_node_root,
+	&ssam_node_sam_rtc,
+	&ssam_node_bat_ac,
+	&ssam_node_bat_main,
+	&ssam_node_tmp_perf_profile_with_fan,
+	&ssam_node_fan_speed,
+	NULL,
+};
+
 /* -- SSAM platform/meta-hub driver. ---------------------------------------- */
 
 static const struct acpi_device_id ssam_platform_hub_acpi_match[] = {
@@ -543,6 +599,10 @@ static const struct of_device_id ssam_platform_hub_of_match[] __maybe_unused = {
 	{ .compatible = "microsoft,denali", (void *)ssam_node_group_sp11 },
 	/* Surface Pro 12in First Edition (ARM/QCOM) */
 	{ .compatible = "microsoft,surface-pro-12in", (void *)ssam_node_group_sp12in },
+	/* Surface Pro 12th Edition (13", ARM/QCOM) */
+	{ .compatible = "microsoft,surface-pro-12th-edition", (void *)ssam_node_group_sp12e },
+	/* Surface Pro 12in Second Edition (ARM/QCOM) */
+	{ .compatible = "microsoft,surface-pro-12in-2nd-edition", (void *)ssam_node_group_sp12in2 },
 	/* Surface Laptop 7 */
 	{ .compatible = "microsoft,romulus13", (void *)ssam_node_group_sl7 },
 	{ .compatible = "microsoft,romulus15", (void *)ssam_node_group_sl7 },
@@ -550,6 +610,8 @@ static const struct of_device_id ssam_platform_hub_of_match[] __maybe_unused = {
 	{ .compatible = "microsoft,surface-laptop-8-13p8", (void *)ssam_node_group_sl8 },
 	/* Surface Laptop 8th Edition (15") */
 	{ .compatible = "microsoft,surface-laptop-8-15", (void *)ssam_node_group_sl8 },
+	/* Surface Laptop 13in Second Edition (ARM/QCOM) */
+	{ .compatible = "microsoft,surface-laptop-13in-2nd-edition", (void *)ssam_node_group_sl13in2 },
 	{ },
 };
 
