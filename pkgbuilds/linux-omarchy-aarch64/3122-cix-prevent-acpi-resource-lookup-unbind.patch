From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Clay Stan <claystan97@gmail.com>
Date: Wed, 25 Nov 2026 22:41:20 -0500
Subject: [PATCH] cix: suppress unbind on cix-acpi-resource-lookup bridge

cix-acpi-resource-lookup is a built-in one-shot ACPI firmware bridge
that stores bridge-owned devm_kstrdup() strings in other platform
devices' res->name and injects devm-allocated _DSD reset property
packages into other ACPI devices without any remove/restore callback.

Set suppress_bind_attrs = true on acpi_resource_lookup_driver so
unbinding CIXA1019 via sysfs cannot free those strings and packages
while consumer devices still reference them. Also drop the device
references acquired via bus_find_device_*() in the RSNL, DLKL and CLKT
helpers.

Signed-off-by: Clay Stan <claystan97@gmail.com>
---
 drivers/soc/cix/cix-acpi-resource-lookup.c | 33 +++++++++++++++++-----
 1 file changed, 26 insertions(+), 7 deletions(-)

diff --git a/drivers/soc/cix/cix-acpi-resource-lookup.c b/drivers/soc/cix/cix-acpi-resource-lookup.c
index 945aa67..170ae87 100644
--- a/drivers/soc/cix/cix-acpi-resource-lookup.c
+++ b/drivers/soc/cix/cix-acpi-resource-lookup.c
@@ -220,16 +220,23 @@ static int resource_name_lookup_handle(acpi_handle handle,
 			continue;
 
 		rdev = acpi_obj_to_platform_device(&el[0]);
-		type = el[1].integer.value;
-		index = el[2].integer.value;
-		name = devm_kstrdup(dev, el[3].string.pointer, GFP_KERNEL);
-		if (!rdev || !name)
+		if (!rdev)
 			continue;
 
+		type = el[1].integer.value;
+		index = el[2].integer.value;
 		res = platform_get_resource(to_platform_device(rdev),
 					    type, index);
-		if (!res)
+		if (!res) {
+			put_device(rdev);
+			continue;
+		}
+
+		name = devm_kstrdup(dev, el[3].string.pointer, GFP_KERNEL);
+		if (!name) {
+			put_device(rdev);
 			continue;
+		}
 		res->name = name;
 
 		if ((res->flags & IORESOURCE_IRQ) &&
@@ -239,6 +246,7 @@ static int resource_name_lookup_handle(acpi_handle handle,
 		dev_dbg(&adev->dev, "resource name [%s][0x%x][%d]->[%s]\n",
 			dev_name(rdev), type, index, name);
 
+		put_device(rdev);
 		count++;
 	}
 
@@ -286,14 +294,19 @@ static int device_link_lookup_handle(acpi_handle handle,
 		consumer = acpi_obj_to_platform_device(&el[1]);
 		flags = (u32)el[2].integer.value;
 
-		if (!supplier || !consumer)
+		if (!supplier || !consumer) {
+			put_device(supplier);
+			put_device(consumer);
 			continue;
+		}
 
 		device_link_add(consumer, supplier, flags);
 
 		dev_dbg(&adev->dev, "device link [%s]->[%s] flags[%u]\n",
 			dev_name(consumer), dev_name(supplier), flags);
 
+		put_device(supplier);
+		put_device(consumer);
 		count++;
 	}
 
@@ -330,13 +343,18 @@ static int clock_dependency_handle(acpi_handle handle,
 
 	supplier = bus_find_device_by_name(&platform_bus_type, NULL,
 					   "CIXHA010:00");
-	if (!supplier || supplier == consumer)
+	if (!supplier || supplier == consumer) {
+		put_device(supplier);
+		put_device(consumer);
 		return 0;
+	}
 
 	device_link_add(consumer, supplier, DL_FLAG_AUTOREMOVE_CONSUMER);
 
 	dev_dbg(data, "clock link [%s]->[CIXHA010:00]\n", dev_name(consumer));
 
+	put_device(supplier);
+	put_device(consumer);
 	return 1;
 }
 
@@ -629,6 +647,7 @@ static struct platform_driver acpi_resource_lookup_driver = {
 	.driver = {
 		.name = "cix-acpi-resource-lookup",
 		.acpi_match_table = ACPI_PTR(acpi_resource_lookup_match),
+		.suppress_bind_attrs = true,
 	},
 	.probe = acpi_resource_lookup_probe,
 };
