+	hdcp = hdev->hdcp;
+
 	switch (kcmd) {
 	case HDCP2_IOCTL_RXSTATE:
 		ret = cix_hdcp2_ioctl_get_rx_state(hdcp, kdata);
@@ -335,6 +504,8 @@ static long cix_hdcp_ioctl(struct file *file, unsigned int ucmd,
 		ret = -ENOTTY;
 	}
 
+	mutex_unlock(&hdev->lock);
+
 	if (ret)
 		goto err;
 
@@ -358,39 +529,83 @@ static const struct file_operations hdcp_fops = {
 int cix_hdcp_init(struct cix_hdcp *hdcp)
 {
 	int ret;
+	struct cix_hdcp_dev *hdev;
 	struct drm_dp_aux *aux = hdcp->aux;
 	struct device *dev = aux->dev;
 
+	hdev = kzalloc(sizeof(*hdev), GFP_KERNEL);
+	if (!hdev)
+		return -ENOMEM;
+
+	kref_init(&hdev->refcount);
+	mutex_init(&hdev->lock);
+	spin_lock_init(&hdev->event_lock);
+	INIT_LIST_HEAD(&hdev->event_list);
+	init_waitqueue_head(&hdev->event_wait);
+	hdev->hdcp = hdcp;
+
 	if (is_acpi_node(dev->fwnode))
 		snprintf(hdcp->name, 17, "hdcp-%s\n", dev_name(dev));
 	else
 		snprintf(hdcp->name, 14, "hdcp-%s\n", dev_name(dev));
-	mutex_init(&hdcp->mutex);
-	spin_lock_init(&hdcp->event_lock);
-	INIT_LIST_HEAD(&hdcp->event_list);
-	init_waitqueue_head(&hdcp->event_wait);
 	hdcp->misc.minor = MISC_DYNAMIC_MINOR;
 	hdcp->misc.name = hdcp->name;
 	hdcp->misc.fops = &hdcp_fops;
 
 	ret = misc_register(&hdcp->misc);
-	if (!ret) {
-		list_add(&hdcp->list, &cix_hdcp_list);
-		dev_info(dev, "succeed register hdcp misc device.\n");
-	} else {
+	if (ret) {
 		dev_err(dev, "cannot register hdcp misc device, ret=%d.\n",
 			ret);
+		kref_put(&hdev->refcount, cix_hdcp_dev_release);
 		return ret;
 	}
 
+	hdev->minor = hdcp->misc.minor;
+
+	mutex_lock(&cix_hdcp_list_lock);
+	hdcp->cdev = hdev;
+	list_add(&hdev->list, &cix_hdcp_list);
+	mutex_unlock(&cix_hdcp_list_lock);
+
+	dev_info(dev, "succeed register hdcp misc device.\n");
 	return 0;
 }
 
 int cix_hdcp_uninit(struct cix_hdcp *hdcp)
 {
+	struct cix_hdcp_dev *hdev;
+
+	/*
+	 * Remove from the lookup list first so any concurrent open() racing
+	 * with misc_deregister() sees -ENODEV without taking a new reference.
+	 * Keep cix_hdcp_list_lock and hdev->lock unlocked across
+	 * misc_deregister() because misc_open() invokes cix_hdcp_open()
+	 * while holding misc_mtx.
+	 */
+	mutex_lock(&cix_hdcp_list_lock);
+	hdev = hdcp->cdev;
+	if (hdev) {
+		list_del_init(&hdev->list);
+		hdcp->cdev = NULL;
+	}
+	mutex_unlock(&cix_hdcp_list_lock);
+
+	if (!hdev)
+		return 0;
+
 	misc_deregister(&hdcp->misc);
-	list_del(&hdcp->list);
+
+	mutex_lock(&hdev->lock);
+	WRITE_ONCE(hdev->unplugged, true);
+	hdev->hdcp = NULL;
 	hdcp->aux = NULL;
+	hdcp->opened = false;
+	mutex_unlock(&hdev->lock);
+
+	cix_hdcp_dev_drain_events(hdev);
+	wake_up_interruptible_all(&hdev->event_wait);
+
+	kref_put(&hdev->refcount, cix_hdcp_dev_release);
 
 	return 0;
 }
