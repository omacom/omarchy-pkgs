From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Clay Stan <claystan97@gmail.com>
Date: Fri, 27 Nov 2026 06:02:02 +0000
Subject: [PATCH] cix: drm: dptx: refcount HDCP file state across driver unbind

cix_hdcp_open() stored a raw pointer to &dp->hdcp (embedded in devm-owned
struct trilin_dp) in filp->private_data, while cix_hdcp_uninit() only
deregistered the miscdevice and cleared hdcp->aux without synchronizing
open file descriptors. Any file kept open across DisplayPort driver
unbind could dereference NULL hdcp->aux on DPCD ioctl or touch freed
struct trilin_dp memory on subsequent read/poll/ioctl/close.

Allocate a refcounted struct cix_hdcp_dev (kref + mutex + unplugged flag
+ open_count + event queue/waitqueue) to back open file descriptors
independently of struct cix_hdcp:

- Protect cix_hdcp_list with cix_hdcp_list_lock, taking a kref in
  cix_hdcp_open() and in driver HPD/timer/CP_IRQ event callbacks, without
  holding cix_hdcp_list_lock or hdev->lock across misc_register() /
  misc_deregister() (respecting misc_mtx lock order).
- In cix_hdcp_uninit(), unlink from cix_hdcp_list, deregister the misc
  device, acquire hdev->lock to wait for in-flight ioctls/callbacks and
  mark unplugged / clear hdev->hdcp and hdcp->aux, drain queued events,
  wake all blocked readers/pollers, and drop the driver reference.
- Reject ioctl/read with -ENODEV and return EPOLLHUP|EPOLLERR from poll
  once teardown begins, ensure cix_hdcp_close() never dereferences freed
  parent DP state, fix the NULL-deref log on open failure, and check
  kmalloc() allocations in event queuing and DPCD access.

Signed-off-by: Clay Stan <claystan97@gmail.com>
---
 drivers/gpu/drm/cix/dptx/hdcp/cix_hdcp.c      | 443 +++++++++++++-----
 drivers/gpu/drm/cix/dptx/hdcp/cix_hdcp.h      |   3 +
 .../gpu/drm/cix/dptx/hdcp/cix_hdcp_ioctl.c    |  11 +-
 3 files changed, 342 insertions(+), 115 deletions(-)

diff --git a/drivers/gpu/drm/cix/dptx/hdcp/cix_hdcp.c b/drivers/gpu/drm/cix/dptx/hdcp/cix_hdcp.c
index 354a19b..f1b040d 100644
--- a/drivers/gpu/drm/cix/dptx/hdcp/cix_hdcp.c
+++ b/drivers/gpu/drm/cix/dptx/hdcp/cix_hdcp.c
@@ -5,13 +5,30 @@
  * Copyright 2024 Cix Technology Group Co., Ltd.
  */
 
-#include <linux/nospec.h>
 #include <linux/fs.h>
+#include <linux/kref.h>
+#include <linux/mutex.h>
+#include <linux/nospec.h>
 #include <linux/poll.h>
+#include <linux/slab.h>
 #include "cix_hdcp_ioctl.h"
 #include "cix_hdcp_ioctl_cmd.h"
 
+struct cix_hdcp_dev {
+	struct kref refcount;
+	struct list_head list;
+	struct mutex lock;
+	struct cix_hdcp *hdcp;
+	bool unplugged;
+	unsigned int open_count;
+	spinlock_t event_lock;
+	struct list_head event_list;
+	wait_queue_head_t event_wait;
+	int minor;
+};
+
 static LIST_HEAD(cix_hdcp_list);
+static DEFINE_MUTEX(cix_hdcp_list_lock);
 
 static unsigned int cix_hdcp_ioctl_cmds[] = {
 	HDCP2_IOCTL_RXSTATE,
@@ -25,21 +42,85 @@ static unsigned int cix_hdcp_ioctl_cmds[] = {
 	HDCP2_IOCTL_GET_DKEY2,
 };
 
+static void cix_hdcp_dev_drain_events(struct cix_hdcp_dev *hdev)
+{
+	struct hdcp_event *e, *tmp;
+	LIST_HEAD(pending);
+
+	spin_lock_irq(&hdev->event_lock);
+	list_splice_init(&hdev->event_list, &pending);
+	spin_unlock_irq(&hdev->event_lock);
+
+	list_for_each_entry_safe(e, tmp, &pending, list) {
+		list_del(&e->list);
+		kfree(e);
+	}
+}
+
+static void cix_hdcp_dev_release(struct kref *kref)
+{
+	struct cix_hdcp_dev *hdev =
+		container_of(kref, struct cix_hdcp_dev, refcount);
+
+	cix_hdcp_dev_drain_events(hdev);
+	mutex_destroy(&hdev->lock);
+	kfree(hdev);
+}
+
+static struct cix_hdcp_dev *cix_hdcp_get_dev(struct cix_hdcp *hdcp)
+{
+	struct cix_hdcp_dev *hdev;
+
+	mutex_lock(&cix_hdcp_list_lock);
+	hdev = hdcp->cdev;
+	if (hdev)
+		kref_get(&hdev->refcount);
+	mutex_unlock(&cix_hdcp_list_lock);
+
+	return hdev;
+}
+
+static bool cix_hdcp_read_ready(struct cix_hdcp_dev *hdev)
+{
+	unsigned long flags;
+	bool ready;
+
+	if (READ_ONCE(hdev->unplugged))
+		return true;
+
+	spin_lock_irqsave(&hdev->event_lock, flags);
+	ready = !list_empty(&hdev->event_list);
+	spin_unlock_irqrestore(&hdev->event_lock, flags);
+
+	return ready;
+}
+
 int cix_hdcp_hpd_event_process(struct cix_hdcp *hdcp, bool plugged)
 {
+	struct cix_hdcp_dev *hdev;
 	struct hdcp_event *e;
+	int ret = 0;
 
-	if (!hdcp->opened) {
-		if (plugged == true)
-			hdcp->state = ST2_H1;
-		else
-			hdcp->state = ST2_H0;
+	hdev = cix_hdcp_get_dev(hdcp);
+	if (!hdev)
 		return 0;
+
+	mutex_lock(&hdev->lock);
+	if (hdev->unplugged || !hdev->hdcp || !hdev->hdcp->aux)
+		goto out_unlock;
+
+	if (!hdev->open_count) {
+		hdcp->state = plugged ? ST2_H1 : ST2_H0;
+		goto out_unlock;
 	}
 
-	e = kmalloc(sizeof(struct hdcp_event), GFP_KERNEL);
+	e = kmalloc(sizeof(*e), GFP_KERNEL);
+	if (!e) {
+		ret = -ENOMEM;
+		goto out_unlock;
+	}
 
-	if (plugged == true) {
+	if (plugged) {
 		e->event = EV2_TX_RX_CONNECT;
 		hdcp->state = ST2_H1;
 		dev_info(hdcp->aux->dev, "report event EV2_TX_RX_CONNECT\n");
@@ -49,129 +130,176 @@ int cix_hdcp_hpd_event_process(struct cix_hdcp *hdcp, bool plugged)
 		dev_info(hdcp->aux->dev, "report event EV2_TX_RX_DISCONNECT\n");
 	}
 
-	spin_lock_irq(&hdcp->event_lock);
-	list_add_tail(&e->list, &hdcp->event_list);
-	spin_unlock_irq(&hdcp->event_lock);
+	spin_lock_irq(&hdev->event_lock);
+	list_add_tail(&e->list, &hdev->event_list);
+	spin_unlock_irq(&hdev->event_lock);
 
-	wake_up_interruptible_poll(&hdcp->event_wait, EPOLLIN | EPOLLRDNORM);
+	wake_up_interruptible_poll(&hdev->event_wait, EPOLLIN | EPOLLRDNORM);
 
-	return 0;
+out_unlock:
+	mutex_unlock(&hdev->lock);
+	kref_put(&hdev->refcount, cix_hdcp_dev_release);
+	return ret;
 }
 
 int cix_hdcp_timer_process(struct cix_hdcp *hdcp)
 {
+	struct cix_hdcp_dev *hdev;
 	struct hdcp_event *e;
+	int ret = 0;
+
+	hdev = cix_hdcp_get_dev(hdcp);
+	if (!hdev)
+		return 0;
+
+	mutex_lock(&hdev->lock);
+	if (hdev->unplugged || !hdev->hdcp || !hdev->hdcp->aux)
+		goto out_unlock;
 
 	hdcp->timer_in_use = false;
 
-	e = kmalloc(sizeof(struct hdcp_event), GFP_KERNEL);
+	e = kmalloc(sizeof(*e), GFP_KERNEL);
+	if (!e) {
+		ret = -ENOMEM;
+		goto out_unlock;
+	}
 	e->event = EV2_TX_TIMER;
 
 	dev_info(hdcp->aux->dev, "report event timer\n");
 
-	spin_lock_irq(&hdcp->event_lock);
-	list_add_tail(&e->list, &hdcp->event_list);
-	spin_unlock_irq(&hdcp->event_lock);
+	spin_lock_irq(&hdev->event_lock);
+	list_add_tail(&e->list, &hdev->event_list);
+	spin_unlock_irq(&hdev->event_lock);
 
-	wake_up_interruptible_poll(&hdcp->event_wait, EPOLLIN | EPOLLRDNORM);
+	wake_up_interruptible_poll(&hdev->event_wait, EPOLLIN | EPOLLRDNORM);
 
-	return 0;
+out_unlock:
+	mutex_unlock(&hdev->lock);
+	kref_put(&hdev->refcount, cix_hdcp_dev_release);
+	return ret;
 }
 
 int cix_hdcp_cp_irq_process(struct cix_hdcp *hdcp, u8 rx_status)
 {
+	struct cix_hdcp_dev *hdev;
 	struct hdcp_event *e;
+	int ret = 0;
 
-	if (rx_status & 0x1f) {
-		e = kmalloc(sizeof(struct hdcp_event), GFP_KERNEL);
-		if (rx_status & 0x1) {
-			e->event = EV2_TX_READY;
-			dev_info(hdcp->aux->dev, "report event EV2_TX_READY\n");
-		}
+	if (!(rx_status & 0x1f))
+		return 0;
 
-		if ((rx_status >> 0x1) & 0x1) {
-			e->event = EV2_TX_HPRIME_AVAILABLE;
-			dev_info(hdcp->aux->dev,
-				 "report event EV2_TX_HPRIME_AVAILABLE\n");
-		}
+	hdev = cix_hdcp_get_dev(hdcp);
+	if (!hdev)
+		return 0;
 
-		if ((rx_status >> 0x2) & 0x1) {
-			e->event = EV2_TX_PAIRING_AVAILABLE;
-			dev_info(hdcp->aux->dev,
-				 "report event EV2_TX_PAIRING_AVAILABLE\n");
-		}
+	mutex_lock(&hdev->lock);
+	if (hdev->unplugged || !hdev->hdcp || !hdev->hdcp->aux)
+		goto out_unlock;
 
-		if ((rx_status >> 0x3) & 0x1) {
-			e->event = EV2_TX_REAUTH_REQ;
-			dev_info(hdcp->aux->dev,
-				 "report event EV2_TX_REAUTH_REQ\n");
-		}
+	e = kmalloc(sizeof(*e), GFP_KERNEL);
+	if (!e) {
+		ret = -ENOMEM;
+		goto out_unlock;
+	}
+	if (rx_status & 0x1) {
+		e->event = EV2_TX_READY;
+		dev_info(hdcp->aux->dev, "report event EV2_TX_READY\n");
+	}
 
-		if ((rx_status >> 0x4) & 0x1) {
-			e->event = EV2_TX_INTEGRITY_FAILURE;
-			dev_info(hdcp->aux->dev,
-				 "report event EV2_TX_INTEGRITY_FAILURE\n");
-		}
+	if ((rx_status >> 0x1) & 0x1) {
+		e->event = EV2_TX_HPRIME_AVAILABLE;
+		dev_info(hdcp->aux->dev,
+			 "report event EV2_TX_HPRIME_AVAILABLE\n");
+	}
 
-		spin_lock_irq(&hdcp->event_lock);
-		list_add_tail(&e->list, &hdcp->event_list);
-		spin_unlock_irq(&hdcp->event_lock);
+	if ((rx_status >> 0x2) & 0x1) {
+		e->event = EV2_TX_PAIRING_AVAILABLE;
+		dev_info(hdcp->aux->dev,
+			 "report event EV2_TX_PAIRING_AVAILABLE\n");
+	}
 
-		wake_up_interruptible_poll(&hdcp->event_wait,
-					   EPOLLIN | EPOLLRDNORM);
+	if ((rx_status >> 0x3) & 0x1) {
+		e->event = EV2_TX_REAUTH_REQ;
+		dev_info(hdcp->aux->dev,
+			 "report event EV2_TX_REAUTH_REQ\n");
 	}
 
-	return 0;
+	if ((rx_status >> 0x4) & 0x1) {
+		e->event = EV2_TX_INTEGRITY_FAILURE;
+		dev_info(hdcp->aux->dev,
+			 "report event EV2_TX_INTEGRITY_FAILURE\n");
+	}
+
+	spin_lock_irq(&hdev->event_lock);
+	list_add_tail(&e->list, &hdev->event_list);
+	spin_unlock_irq(&hdev->event_lock);
+
+	wake_up_interruptible_poll(&hdev->event_wait,
+				   EPOLLIN | EPOLLRDNORM);
+
+out_unlock:
+	mutex_unlock(&hdev->lock);
+	kref_put(&hdev->refcount, cix_hdcp_dev_release);
+	return ret;
 }
 
 static int cix_hdcp_open(struct inode *inode, struct file *filp)
 {
-	int ret;
-	struct cix_hdcp *pos, *hdcp = NULL;
+	struct cix_hdcp_dev *pos, *hdev = NULL;
 
-	list_for_each_entry (pos, &cix_hdcp_list, list) {
-		if (pos->misc.minor == iminor(inode)) {
-			hdcp = pos;
+	mutex_lock(&cix_hdcp_list_lock);
+	list_for_each_entry(pos, &cix_hdcp_list, list) {
+		if (pos->minor == iminor(inode)) {
+			kref_get(&pos->refcount);
+			hdev = pos;
 			break;
 		}
 	}
+	mutex_unlock(&cix_hdcp_list_lock);
 
-	if (hdcp) {
-		hdcp->opened = true;
-		filp->private_data = hdcp;
-		dev_info(hdcp->aux->dev, "succeed to open hdcp file\n");
-		ret = 0;
-	} else {
-		dev_info(hdcp->aux->dev, "failed to open hdcp file\n");
-		ret = -EINVAL;
+	if (!hdev)
+		return -ENODEV;
+
+	mutex_lock(&hdev->lock);
+	if (hdev->unplugged || !hdev->hdcp || !hdev->hdcp->aux) {
+		mutex_unlock(&hdev->lock);
+		kref_put(&hdev->refcount, cix_hdcp_dev_release);
+		return -ENODEV;
 	}
 
-	return ret;
+	hdev->open_count++;
+	hdev->hdcp->opened = true;
+	filp->private_data = hdev;
+	dev_info(hdev->hdcp->aux->dev, "succeed to open hdcp file\n");
+	mutex_unlock(&hdev->lock);
+
+	return 0;
 }
 
 static int cix_hdcp_close(struct inode *inode, struct file *filp)
 {
-	struct cix_hdcp *hdcp = filp->private_data;
+	struct cix_hdcp_dev *hdev = filp->private_data;
 
-	for (;;) {
-		struct hdcp_event *e = NULL;
+	if (!hdev)
+		return 0;
 
-		spin_lock_irq(&hdcp->event_lock);
-		if (!list_empty(&hdcp->event_list)) {
-			e = list_first_entry(&hdcp->event_list,
-					     struct hdcp_event, list);
-			list_del(&e->list);
-			kfree(e);
-		} else {
-			dev_info(hdcp->aux->dev,
-				 "event list is null and close\n");
-			spin_unlock_irq(&hdcp->event_lock);
-			break;
+	mutex_lock(&hdev->lock);
+	if (hdev->open_count > 0)
+		hdev->open_count--;
+
+	if (hdev->open_count == 0) {
+		cix_hdcp_dev_drain_events(hdev);
+		if (!hdev->unplugged && hdev->hdcp) {
+			if (hdev->hdcp->aux)
+				dev_info(hdev->hdcp->aux->dev,
+					 "event list is null and close\n");
+			hdev->hdcp->opened = false;
 		}
-		spin_unlock_irq(&hdcp->event_lock);
 	}
+	mutex_unlock(&hdev->lock);
 
-	hdcp->opened = false;
+	filp->private_data = NULL;
+	kref_put(&hdev->refcount, cix_hdcp_dev_release);
 
 	return 0;
 }
@@ -179,50 +307,67 @@ static int cix_hdcp_close(struct inode *inode, struct file *filp)
 static ssize_t cix_hdcp_read(struct file *filp, char __user *buffer,
 			     size_t count, loff_t *offset)
 {
-	struct cix_hdcp *hdcp = filp->private_data;
+	struct cix_hdcp_dev *hdev = filp->private_data;
 	ssize_t ret;
 
-	ret = mutex_lock_interruptible(&hdcp->mutex);
+	if (!hdev)
+		return -ENODEV;
+
+	ret = mutex_lock_interruptible(&hdev->lock);
 	if (ret)
 		return ret;
 
+	if (hdev->unplugged) {
+		mutex_unlock(&hdev->lock);
+		return -ENODEV;
+	}
+
 	for (;;) {
 		struct hdcp_event *e = NULL;
 
-		spin_lock_irq(&hdcp->event_lock);
-		if (!list_empty(&hdcp->event_list)) {
-			e = list_first_entry(&hdcp->event_list,
+		spin_lock_irq(&hdev->event_lock);
+		if (!list_empty(&hdev->event_list)) {
+			e = list_first_entry(&hdev->event_list,
 					     struct hdcp_event, list);
 			list_del(&e->list);
 		}
-		spin_unlock_irq(&hdcp->event_lock);
+		spin_unlock_irq(&hdev->event_lock);
 
 		if (e == NULL) {
 			if (ret)
 				break;
 
+			if (hdev->unplugged) {
+				ret = -ENODEV;
+				break;
+			}
+
 			if (filp->f_flags & O_NONBLOCK) {
 				ret = -EAGAIN;
 				break;
 			}
 
-			mutex_unlock(&hdcp->mutex);
+			mutex_unlock(&hdev->lock);
 			ret = wait_event_interruptible(
-				hdcp->event_wait,
-				!list_empty(&hdcp->event_list));
+				hdev->event_wait,
+				cix_hdcp_read_ready(hdev));
 			if (ret >= 0)
-				ret = mutex_lock_interruptible(&hdcp->mutex);
+				ret = mutex_lock_interruptible(&hdev->lock);
 			if (ret)
 				return ret;
+			if (hdev->unplugged) {
+				ret = -ENODEV;
+				break;
+			}
 		} else {
-			unsigned length = sizeof(unsigned int);
+			unsigned int length = sizeof(unsigned int);
 
 			if (length > count - ret) {
 put_back_event:
-				spin_lock_irq(&hdcp->event_lock);
-				list_add(&e->list, &hdcp->event_list);
-				spin_unlock_irq(&hdcp->event_lock);
-				wake_up_interruptible_poll(&hdcp->event_wait,
+				spin_lock_irq(&hdev->event_lock);
+				list_add(&e->list, &hdev->event_list);
+				spin_unlock_irq(&hdev->event_lock);
+				wake_up_interruptible_poll(&hdev->event_wait,
 							   EPOLLIN |
 								   EPOLLRDNORM);
 				break;
@@ -238,23 +383,31 @@ put_back_event:
 			kfree(e);
 		}
 	}
-	mutex_unlock(&hdcp->mutex);
+	mutex_unlock(&hdev->lock);
 
 	return ret;
 }
 
 static __poll_t cix_hdcp_poll(struct file *filp, poll_table *wait)
 {
-	struct cix_hdcp *hdcp = filp->private_data;
+	struct cix_hdcp_dev *hdev = filp->private_data;
 	__poll_t mask = 0;
 
-	poll_wait(filp, &hdcp->event_wait, wait);
-	mutex_lock(&hdcp->mutex);
+	if (!hdev)
+		return EPOLLHUP | EPOLLERR;
 
-	if (!list_empty(&hdcp->event_list))
-		mask |= EPOLLIN | EPOLLRDNORM;
+	poll_wait(filp, &hdev->event_wait, wait);
 
-	mutex_unlock(&hdcp->mutex);
+	mutex_lock(&hdev->lock);
+	if (hdev->unplugged) {
+		mask |= EPOLLHUP | EPOLLERR;
+	} else {
+		spin_lock_irq(&hdev->event_lock);
+		if (!list_empty(&hdev->event_list))
+			mask |= EPOLLIN | EPOLLRDNORM;
+		spin_unlock_irq(&hdev->event_lock);
+	}
+	mutex_unlock(&hdev->lock);
 
 	return mask;
 }
@@ -266,9 +419,13 @@ static long cix_hdcp_ioctl(struct file *file, unsigned int ucmd,
 	char *kdata = stack_kdata;
 	unsigned int kcmd;
 	unsigned int in_size, out_size, drv_size, ksize;
-	int nr = _IOC_NR(ucmd);
+	unsigned int nr = _IOC_NR(ucmd);
 	int ret = 0;
-	struct cix_hdcp *hdcp = file->private_data;
+	struct cix_hdcp_dev *hdev = file->private_data;
+	struct cix_hdcp *hdcp;
+
+	if (!hdev)
