 		return -EINVAL;
@@ -303,6 +460,18 @@ static long cix_hdcp_ioctl(struct file *file, unsigned int ucmd,
 	if (ksize > in_size)
 		memset(kdata + in_size, 0, ksize - in_size);
 
+	ret = mutex_lock_interruptible(&hdev->lock);
+	if (ret)
+		goto err;
+
+	if (hdev->unplugged || !hdev->hdcp || !hdev->hdcp->aux) {
+		mutex_unlock(&hdev->lock);
