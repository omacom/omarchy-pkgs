From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emir Beganovic <beganovic.emir@gmail.com>
Date: Mon, 26 Oct 2026 07:21:02 +0000
Subject: [PATCH] arm64: dts: qcom: Add the ASUS Zenbook 14 UX3480QA

The Zenbook 14 UX3480QA is the Zenbook A14's platform (Snapdragon X
X1-26-100, Purwa) in another chassis, so the tree builds on the A14's
x1p42100-asus-zenbook-a14.dtsi. What differs, from the machine's DSDT,
the resources Windows assigns its devices, and boots on it:

- The keyboard (ASUSTeK 0B05:4B42) is HID over I2C at 0x15 on i2c22,
  interrupt TLMM 67, not on the A14's i2c8. Windows and the DSDT put
  that controller's interrupt on SPI 814, not hamoa.dtsi's 461.
- The webcam and IR camera, one USB device (3277:00ef), sit on usb_2
  behind an NXP PTN3222 eUSB2 repeater at 0x47 on i2c5, reset TLMM 7.
- There is no MIPI camera, so the A14's camera indicator on TLMM 110
  goes.
- The panel is a Samsung ATNA40KW01 (EDID SDC 0x4210), driven with
  the A14 OLED's samsung,atna40ct06 description and its enable GPIO
  on PMC8380_3 GPIO 4.
- The video codec runs ASUS's OEM-signed qcvss8380.mbn.
- The internal microphones on VA DMIC0/1 are powered from the WCD938x's
  MIC BIAS3, as on Qualcomm's X1 reference designs, not from MIC BIAS1
  as on the A14: with MIC BIAS3 on, both record a 1 kHz tone played on
  the speakers; MIC BIAS1, 2 and 4 leave them silent.
- There are no PS8833 retimers: the USB-C ports are USB 3.2 Gen 2
  without USB4, nothing answers on i2c3 or i2c7, and a 10 Gb/s device
  links in both orientations with the A14's retimer rails off and its
  reset asserted. The tree deletes the A14's retimers and their rails
  and connects the connectors straight to the QMP PHYs. With them in
  place, 7.3's ps883x fails to probe and pmic_glink_altmode waits for
  it, leaving the ports at USB 2.
- DisplayPort over USB-C: each port's SBU lines go through a GPIO
  mux (enable TLMM 168/179 active low, select TLMM 167/178, in the
  DSDT's UCS0, as on the QCP), described as gpio-sbu-mux, so both DP
  controllers are on. The sound card gets DisplayPort links for both
  and for mdss_dp2, which drives the HDMI bridge. Tested on a Dell
  U3421WE: 3440x1440 with sound on either USB-C port and over HDMI.
  For the panel and LUKS prompt to come up before the root is
  unlocked, the initramfs needs pmic_glink_altmode and gpio_sbu_mux.

Signed-off-by: Emir Beganovic <beganovic.emir@gmail.com>
---
 arch/arm64/boot/dts/qcom/Makefile             |   2 +
 .../x1p42100-asus-zenbook-14-ux3480qa.dts     | 315 ++++++++++++++++++
 2 files changed, 317 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/x1p42100-asus-zenbook-14-ux3480qa.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 6f33c4e..409cf8a 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -449,6 +449,8 @@ x1p42100-asus-zenbook-a14-el2-dtbs	:= x1p42100-asus-zenbook-a14.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x1p42100-asus-zenbook-a14.dtb x1p42100-asus-zenbook-a14-el2.dtb
 x1p42100-asus-zenbook-a14-lcd-el2-dtbs	:= x1p42100-asus-zenbook-a14-lcd.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x1p42100-asus-zenbook-a14-lcd.dtb x1p42100-asus-zenbook-a14-lcd-el2.dtb
+x1p42100-asus-zenbook-14-ux3480qa-el2-dtbs	:= x1p42100-asus-zenbook-14-ux3480qa.dtb x1-el2.dtbo
+dtb-$(CONFIG_ARCH_QCOM)	+= x1p42100-asus-zenbook-14-ux3480qa.dtb x1p42100-asus-zenbook-14-ux3480qa-el2.dtb
 x1p42100-crd-el2-dtbs	:= x1p42100-crd.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x1p42100-crd.dtb x1p42100-crd-el2.dtb
 x1p42100-hp-omnibook-x14-el2-dtbs := x1p42100-hp-omnibook-x14.dtb x1-el2.dtbo
diff --git a/arch/arm64/boot/dts/qcom/x1p42100-asus-zenbook-14-ux3480qa.dts b/arch/arm64/boot/dts/qcom/x1p42100-asus-zenbook-14-ux3480qa.dts
new file mode 100644
index 0000000..d4868f8
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/x1p42100-asus-zenbook-14-ux3480qa.dts
@@ -0,0 +1,315 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * ASUS Zenbook 14 (UX3480QA), Snapdragon X X1-26-100 (Purwa).
+ *
+ * Same platform as the Zenbook A14 UX3407QA. The differences below come
+ * from this machine's DSDT, the resources Windows assigns its devices,
+ * and boots on it.
+ */
+
+/dts-v1/;
+
+#include "x1p42100-asus-zenbook-a14.dtsi"
+
+/ {
+	model = "ASUS Zenbook 14 (UX3480QA)";
+	compatible = "asus,zenbook-14-ux3480qa", "qcom,x1p42100";
+
+	/*
+	 * The A14's camera indicator on TLMM 110 belongs to its MIPI camera.
+	 * This camera is USB and lights its own LED; the DSDT uses TLMM 110
+	 * only in the reference CAMP device.
+	 */
+	/delete-node/ leds;
+
+	/*
+	 * Sound over both USB-C DisplayPort controllers and HDMI (mdss_dp2,
+	 * through the HDMI bridge), as on the ThinkPad T14s.
+	 *
+	 * The internal microphones on VA DMIC0/1 are powered from the WCD938x's
+	 * MIC BIAS3, as on Qualcomm's X1 reference designs, not from MIC BIAS1
+	 * like the A14's: with MIC BIAS3 on, both record a 1 kHz tone played on
+	 * the speakers; MIC BIAS1, 2 and 4 leave them silent.
+	 */
+	sound {
+		audio-routing = "SpkrLeft IN", "WSA WSA_SPK1 OUT",
+				"SpkrRight IN", "WSA WSA_SPK2 OUT",
+				"IN1_HPHL", "HPHL_OUT",
+				"IN2_HPHR", "HPHR_OUT",
+				"AMIC2", "MIC BIAS2",
+				"VA DMIC0", "MIC BIAS3",
+				"VA DMIC1", "MIC BIAS3",
+				"TX SWR_INPUT1", "ADC2_OUTPUT";
+
+		displayport-0-dai-link {
+			link-name = "DisplayPort0 Playback";
+
+			codec {
+				sound-dai = <&mdss_dp0>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
+		displayport-1-dai-link {
+			link-name = "DisplayPort1 Playback";
+
+			codec {
+				sound-dai = <&mdss_dp1>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_1>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
+		displayport-2-dai-link {
+			link-name = "DisplayPort2 Playback";
+
+			codec {
+				sound-dai = <&mdss_dp2>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_2>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+	};
+};
+
+/delete-node/ &cam_indicator_en;
+
+/* The keyboard is on i2c22, not on the A14's i2c8 */
+&i2c8 {
+	status = "disabled";
+};
+
+&i2c22 {
+	/*
+	 * Windows reports this controller (0x898000) on GSI 846 and the
+	 * DSDT's _CRS agrees: SPI 814, not hamoa.dtsi's 461.
+	 */
+	interrupts = <GIC_SPI 814 IRQ_TYPE_LEVEL_HIGH>;
+
+	status = "okay";
+
+	/* ASUSTeK, 0B05:4B42 */
+	keyboard@15 {
+		compatible = "hid-over-i2c";
+		reg = <0x15>;
+
+		hid-descr-addr = <0x1>;
+		interrupts-extended = <&tlmm 67 IRQ_TYPE_LEVEL_LOW>;
+
+		pinctrl-0 = <&kybd_default>;
+		pinctrl-names = "default";
+
+		wakeup-source;
+	};
+};
+
+/*
+ * The webcam and IR camera (one USB device, 3277:00ef) sit on usb_2
+ * (the DSDT's \_SB.USB4) behind an eUSB2 repeater at 0x47 on this bus,
+ * reset TLMM 7 (GpioIo, pull-up). Supplies as on other X1 laptops with a
+ * USB camera on usb_2, e.g. the ASUS Vivobook S15.
+ */
+&i2c5 {
+	eusb5_repeater: redriver@47 {
+		compatible = "nxp,ptn3222";
+		reg = <0x47>;
+		#phy-cells = <0>;
+
+		vdd3v3-supply = <&vreg_l13b_3p0>;
+		vdd1v8-supply = <&vreg_l4b_1p8>;
+
+		reset-gpios = <&tlmm 7 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&eusb5_reset_n>;
+		pinctrl-names = "default";
+	};
+};
+
+/*
+ * The Purwa video codec node is complete in the base tree; only the
+ * firmware is board-specific: ASUS's OEM-signed qcvss8380.mbn from the
+ * UX3480QA BSP (IMAGE_VARIANT_STRING=PROD).
+ */
+&iris {
+	firmware-name = "qcom/x1p42100/ASUSTeK/zenbook-a14/qcvss8380.mbn";
+
+	status = "okay";
+};
+
+/*
+ * The USB-C ports are USB 3.2 Gen 2 without USB4, and there are no PS8833
+ * retimers: nothing answers on i2c3 or i2c7 at any address, and with the
+ * retimers' rails off and reset asserted a 10 Gb/s device links in both
+ * orientations. The QMP PHYs connect to the connectors directly, and
+ * TLMM 167/168 and 178/179 (in the DSDT's UCS0) drive SBU muxes as on the
+ * QCP; 168 and 179 read high with the internal pull-down, an active-low
+ * enable pulled up on the board.
+ */
+/delete-node/ &vreg_rtmr0_1p15;
+/delete-node/ &vreg_rtmr0_1p8;
+/delete-node/ &vreg_rtmr0_3p3;
+/delete-node/ &vreg_rtmr1_1p15;
+/delete-node/ &vreg_rtmr1_1p8;
+/delete-node/ &vreg_rtmr1_3p3;
+
+/ {
+	usb-1-ss0-sbu-mux {
+		compatible = "onnn,fsusb42", "gpio-sbu-mux";
+
+		enable-gpios = <&tlmm 168 GPIO_ACTIVE_LOW>;
+		select-gpios = <&tlmm 167 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-0 = <&usb_1_ss0_sbu_default>;
+		pinctrl-names = "default";
+
+		mode-switch;
+		orientation-switch;
+
+		port {
+			usb_1_ss0_sbu_mux: endpoint {
+				remote-endpoint = <&pmic_glink_ss0_con_sbu_in>;
+			};
+		};
+	};
+
+	usb-1-ss1-sbu-mux {
+		compatible = "onnn,fsusb42", "gpio-sbu-mux";
+
+		enable-gpios = <&tlmm 179 GPIO_ACTIVE_LOW>;
+		select-gpios = <&tlmm 178 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-0 = <&usb_1_ss1_sbu_default>;
+		pinctrl-names = "default";
+
+		mode-switch;
+		orientation-switch;
+
+		port {
+			usb_1_ss1_sbu_mux: endpoint {
+				remote-endpoint = <&pmic_glink_ss1_con_sbu_in>;
+			};
+		};
+	};
+};
+
+&i2c3 {
+	/delete-node/ typec-mux@8;
+};
+
+&i2c7 {
+	/delete-node/ typec-mux@8;
+};
+
+&pmic_glink_ss0_ss_in {
+	remote-endpoint = <&usb_1_ss0_qmpphy_out>;
+};
+
+&pmic_glink_ss0_con_sbu_in {
+	remote-endpoint = <&usb_1_ss0_sbu_mux>;
+};
+
+&pmic_glink_ss1_ss_in {
+	remote-endpoint = <&usb_1_ss1_qmpphy_out>;
+};
+
+&pmic_glink_ss1_con_sbu_in {
+	remote-endpoint = <&usb_1_ss1_sbu_mux>;
+};
+
+&usb_1_ss0_qmpphy_out {
+	remote-endpoint = <&pmic_glink_ss0_ss_in>;
+};
+
+&usb_1_ss1_qmpphy_out {
+	remote-endpoint = <&pmic_glink_ss1_ss_in>;
+};
+
+/*
+ * The panel is a Samsung ATNA40KW01 (EDID SDC 0x4210). It runs with the
+ * A14 OLED panel description until the panel has a binding of its own.
+ */
+&panel {
+	compatible = "samsung,atna40ct06", "samsung,atna33xc20";
+	enable-gpios = <&pmc8380_3_gpios 4 GPIO_ACTIVE_HIGH>;
+
+	pinctrl-0 = <&edp_bl_en>;
+	pinctrl-names = "default";
+};
+
+&tlmm {
+	eusb5_reset_n: eusb5-reset-n-state {
+		pins = "gpio7";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+		output-low;
+	};
+
+	usb_1_ss0_sbu_default: usb-1-ss0-sbu-state {
+		oe-n-pins {
+			pins = "gpio168";
+			function = "gpio";
+			bias-disable;
+			drive-strength = <2>;
+			output-high;
+		};
+
+		sel-pins {
+			pins = "gpio167";
+			function = "gpio";
+			bias-disable;
+			drive-strength = <2>;
+		};
+	};
+
+	usb_1_ss1_sbu_default: usb-1-ss1-sbu-state {
+		oe-n-pins {
+			pins = "gpio179";
+			function = "gpio";
+			bias-disable;
+			drive-strength = <2>;
+			output-high;
+		};
+
+		sel-pins {
+			pins = "gpio178";
+			function = "gpio";
+			bias-disable;
+			drive-strength = <2>;
+		};
+	};
+};
+
+&usb_2 {
+	dr_mode = "host";
+
+	status = "okay";
+};
+
+&usb_2_hsphy {
+	vdd-supply = <&vreg_l2e_0p8>;
+	vdda12-supply = <&vreg_l3e_1p2>;
+
+	phys = <&eusb5_repeater>;
+
+	status = "okay";
+};
