 	spin_lock_irqsave(&gchan->vc.lock, flags);
 	vd = vchan_next_desc(&gchan->vc);
 	if (!vd) {
@@ -1028,7 +1169,20 @@ static void gpi_process_xfer_compl_event(struct gchan *gchan,
 	}
 
