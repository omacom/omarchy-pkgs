From 9064bccf87c0740d1968ef4e417324df26d15510 Mon Sep 17 00:00:00 2001
From: Brandon Williams <turbine.bmw@gmail.com>
Date: Tue, 13 Oct 2026 14:12:38 -0400
Subject: [PATCH 2169/2169] arm64: dts: qcom: x1-microsoft-denali: describe the
 camera privacy LED

The camera privacy indicator next to the front camera is driven by TLMM
gpio225, whose "cam_indicator_en" pin state nothing used. Describe it as a
gpio-leds privacy LED and point the front, rear and IR camera sensors at
it, so the V4L2 core lights it while any of them streams.

Tested on a Microsoft Surface Pro 11 (X1E80100): the LED lights while the
front, rear or IR camera streams and goes off when it stops.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Brandon Williams <turbine.bmw@gmail.com>
---
 .../boot/dts/qcom/x1-microsoft-denali.dtsi    | 23 +++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1-microsoft-denali.dtsi b/arch/arm64/boot/dts/qcom/x1-microsoft-denali.dtsi
index df0de50e0d85..1cafff5cf0e7 100644
--- a/arch/arm64/boot/dts/qcom/x1-microsoft-denali.dtsi
+++ b/arch/arm64/boot/dts/qcom/x1-microsoft-denali.dtsi
@@ -52,6 +52,20 @@ switch-lid {
 		};
 	};
 
+	leds {
+		compatible = "gpio-leds";
+
+		pinctrl-0 = <&cam_indicator_en>;
+		pinctrl-names = "default";
+
+		privacy_led: privacy-led {
+			function = LED_FUNCTION_INDICATOR;
+			color = <LED_COLOR_ID_WHITE>;
+			gpios = <&tlmm 225 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+	};
+
 	pmic-glink {
 		compatible = "qcom,x1e80100-pmic-glink",
 			     "qcom,sm8550-pmic-glink",
@@ -896,6 +910,9 @@ camera@60 {
 		pinctrl-0 = <&cam_ir_default>;
 		pinctrl-names = "default";
 
+		leds = <&privacy_led>;
+		led-names = "privacy";
+
 		clocks = <&camcc CAM_CC_MCLK0_CLK>;
 		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
 		assigned-clock-rates = <19200000>;
@@ -934,6 +951,9 @@ camera@10 {
 		pinctrl-0 = <&cam_rear_default>;
 		pinctrl-names = "default";
 
+		leds = <&privacy_led>;
+		led-names = "privacy";
+
 		clocks = <&camcc CAM_CC_MCLK1_CLK>;
 		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
 		assigned-clock-rates = <19200000>;
@@ -981,6 +1001,9 @@ camera@1a {
 		pinctrl-0 = <&cam_front_default>;
 		pinctrl-names = "default";
 
+		leds = <&privacy_led>;
+		led-names = "privacy";
+
 		clocks = <&camcc CAM_CC_MCLK4_CLK>;
 		assigned-clocks = <&camcc CAM_CC_MCLK4_CLK>;
 		assigned-clock-rates = <19200000>;
