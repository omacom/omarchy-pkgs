From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 8 Oct 2026 13:40:21 -0500
Subject: [PATCH] clk: qcom: reset: Return regmap errors

qcom_reset_set_assert() ignores the result of regmap_update_bits() and of
the read-back that follows it, and qcom_reset() ignores the results of
its assert and deassert calls. A reset that never reached the clock
controller is reported to the consumer as done.

Return the first error instead. With MMIO regmaps nothing changes when
the accesses succeed.

Fixes: b36ba30c8ac6 ("clk: qcom: Add reset controller support")
Fixes: 2f8cf2c3f3e3 ("clk: qcom: reset: Ensure write completion on reset de/assertion")
Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/clk/qcom/reset.c | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/drivers/clk/qcom/reset.c b/drivers/clk/qcom/reset.c
index d96c96a9089..a3aa4e15687 100644
--- a/drivers/clk/qcom/reset.c
+++ b/drivers/clk/qcom/reset.c
@@ -14,12 +14,14 @@
 static int qcom_reset(struct reset_controller_dev *rcdev, unsigned long id)
 {
 	struct qcom_reset_controller *rst = to_qcom_reset_controller(rcdev);
+	int ret;
 
-	rcdev->ops->assert(rcdev, id);
+	ret = rcdev->ops->assert(rcdev, id);
+	if (ret)
+		return ret;
 	fsleep(rst->reset_map[id].udelay ?: 1); /* use 1 us as default */
 
-	rcdev->ops->deassert(rcdev, id);
-	return 0;
+	return rcdev->ops->deassert(rcdev, id);
 }
 
 static int qcom_reset_set_assert(struct reset_controller_dev *rcdev,
@@ -28,17 +30,18 @@ static int qcom_reset_set_assert(struct reset_controller_dev *rcdev,
 	struct qcom_reset_controller *rst;
 	const struct qcom_reset_map *map;
 	u32 mask;
+	int ret;
 
 	rst = to_qcom_reset_controller(rcdev);
 	map = &rst->reset_map[id];
 	mask = map->bitmask ? map->bitmask : BIT(map->bit);
 
-	regmap_update_bits(rst->regmap, map->reg, mask, assert ? mask : 0);
+	ret = regmap_update_bits(rst->regmap, map->reg, mask, assert ? mask : 0);
+	if (ret)
+		return ret;
 
 	/* Read back the register to ensure write completion, ignore the value */
-	regmap_read(rst->regmap, map->reg, &mask);
-
-	return 0;
+	return regmap_read(rst->regmap, map->reg, &mask);
 }
 
 static int qcom_reset_assert(struct reset_controller_dev *rcdev, unsigned long id)
-- 
