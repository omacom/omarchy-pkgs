From 0b4f0ffae064bc32c7d4ee86e780e5f794bb4406 Mon Sep 17 00:00:00 2001
From: kk1987 <kk1987@gmail.com>
Date: Wed, 4 Nov 2026 23:45:27 -0800
Subject: [PATCH] soundwire: mediatek: add the HP OmniBook X 14 topology

The HP OmniBook X 14-ks000 (SSID 103c:8f22) has two CS35L56 on link 0
(uid 0 and 1) and a CS42L43 on link 1. No entry matched, so the card
never registered: "no card from this controller".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/soundwire/mediatek/mtk-sdw-mach.c | 39 +++++++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/drivers/soundwire/mediatek/mtk-sdw-mach.c b/drivers/soundwire/mediatek/mtk-sdw-mach.c
index 00054b2..32b1a59 100644
--- a/drivers/soundwire/mediatek/mtk-sdw-mach.c
+++ b/drivers/soundwire/mediatek/mtk-sdw-mach.c
@@ -225,6 +225,40 @@ static const struct snd_soc_acpi_link_adr mtk_sdw_cs35l56_l0_cs42l43_l1[] = {
 	{}
 };
 
+/*
+ * SDW0 = 2x CS35L56 (amps, aggregated), SDW1 = CS42L43 (jack codec).
+ * HP OmniBook X 14-ks000 (SSID 103c:8f22): amps at uids 0/1 on link0,
+ * CS42L43 at uid 0 on link1 (_ADR from the BIOS F.05 SSDT).
+ */
+static const struct snd_soc_acpi_adr_device cs35l56x2_l0_adr[] = {
+	{
+		.adr = 0x00003001FA355601ull,
+		.num_endpoints = 1,
+		.endpoints = &cs35l56_endpoints[0],
+		.name_prefix = "AMP1",
+	},
+	{
+		.adr = 0x00003101FA355601ull,
+		.num_endpoints = 1,
+		.endpoints = &cs35l56_endpoints[1],
+		.name_prefix = "AMP2",
+	},
+};
+
+static const struct snd_soc_acpi_link_adr mtk_sdw_cs35l56x2_l0_cs42l43_l1[] = {
+	{
+		.mask = BIT(0),
+		.num_adr = ARRAY_SIZE(cs35l56x2_l0_adr),
+		.adr_d = cs35l56x2_l0_adr,
+	},
+	{
+		.mask = BIT(1),
+		.num_adr = ARRAY_SIZE(cs42l43_l1_adr),
+		.adr_d = cs42l43_l1_adr,
+	},
+	{}
+};
+
 /*
  * Config 2: SDW0 = 2x RT1321 (amps, aggregated), SDW1 = RT713 (jack codec).
  * Topology: uids 0x30/0x31 on link0, 0x30
@@ -404,6 +438,11 @@ static struct snd_soc_acpi_mach mtk_sdw_machines[] = {
 		.links     = mtk_sdw_cs35l56_l0_cs42l43_l1,
 		.drv_name  = "mtk_sdw_mc",
 	},
+	{
+		.link_mask = BIT(0) | BIT(1),
+		.links     = mtk_sdw_cs35l56x2_l0_cs42l43_l1,
+		.drv_name  = "mtk_sdw_mc",
+	},
 	/*
 	 * The four-amp single-link entry must precede the two-amp one:
 	 * matching is first-fit and tolerates extra enumerated peripherals,
-- 
2.56.0

