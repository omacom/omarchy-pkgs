From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 8 Oct 2026 13:46:39 -0500
Subject: [PATCH] phy: qcom: edp: Use the training LDO setting for v8 eDP at
 5.4 Gbps

The v8 sequence programs the eDP TX lane LDOs to 0xd0 at every link
rate. Konrad Dybcio's review of that sequence reads 0x91 as the setting
for 5.4 and 8.1 Gbps eDP, which is also what the v6 PHY uses. On the
Surface Laptop 8 the panel trains at 5.4 Gbps on four lanes with the
TX LDOs at 0x91, but with 0x91 left in place the running picture shows
noisy bands; switching the LDOs to 0xd0 once video is running removes
them without retraining.

For eDP at 5.4 Gbps on four lanes, program 0x91 while the link is
brought up and trained, and switch both TX blocks to 0xd0 when the
controller reports that video is running. Link training rewrites the
LDOs through qcom_edp_ldo_config_v8(), so a retrain returns to 0x91
until the next notification. Other rates and lane counts keep 0xd0.

Only this case has been tested. With the driver's earlier v8 sequence
and 0xd0 throughout, the panel's lanes never reached alignment; whether
it trains with 0xd0 under the current sequence has not been tried.

Link: https://lore.kernel.org/r/fc3d0dfc-20cb-4289-a0dd-67ace50d42d8@oss.qualcomm.com
Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/phy/qualcomm/phy-qcom-edp.c | 30 ++++++++++++++++++++++++++---
 1 file changed, 27 insertions(+), 3 deletions(-)

diff --git a/drivers/phy/qualcomm/phy-qcom-edp.c b/drivers/phy/qualcomm/phy-qcom-edp.c
index 5fd0c563d8e..538e909bc78 100644
--- a/drivers/phy/qualcomm/phy-qcom-edp.c
+++ b/drivers/phy/qualcomm/phy-qcom-edp.c
@@ -1124,15 +1124,27 @@ static int qcom_edp_ldo_config_v6(const struct qcom_edp *edp)
 	return 0;
 }
 
+/*
+ * eDP at 5.4 Gbps on four lanes trains with the TX LDOs at 0x91 and
+ * switches them to the video setting, 0xd0, once video is running.
+ */
+static bool qcom_edp_v8_uses_training_ldo(const struct qcom_edp *edp)
+{
+	return edp->is_edp && edp->dp_opts.link_rate == 5400 &&
+	       edp->dp_opts.lanes == 4;
+}
+
 static int qcom_edp_ldo_config_v8(const struct qcom_edp *edp)
 {
 	const struct phy_configure_opts_dp *dp_opts = &edp->dp_opts;
 	u32 ldo_config;
 
-	if (edp->is_edp)
-		ldo_config = 0xd0;
-	else
+	if (!edp->is_edp)
 		ldo_config = 0x00;
+	else if (qcom_edp_v8_uses_training_ldo(edp))
+		ldo_config = 0x91;
+	else
+		ldo_config = 0xd0;
 
 	writel(ldo_config, edp->tx0 + TXn_LDO_CONFIG);
 	writel(dp_opts->lanes > 2 ? ldo_config : 0x00, edp->tx1 + TXn_LDO_CONFIG);
@@ -1372,6 +1384,17 @@ static int qcom_edp_phy_power_on_v8(const struct qcom_edp *edp)
 				     val, val & BIT(7), 5, 200);
 }
 
+static int qcom_edp_video_ready_v8(const struct qcom_edp *edp)
+{
+	if (!qcom_edp_v8_uses_training_ldo(edp))
+		return 0;
+
+	writel(0xd0, edp->tx0 + TXn_LDO_CONFIG);
+	writel(0xd0, edp->tx1 + TXn_LDO_CONFIG);
+
+	return 0;
+}
+
 static const struct phy_ver_ops qcom_edp_phy_ops_v8 = {
 	.com_power_on		= qcom_edp_phy_power_on_v8,
 	.com_resetsm_cntrl	= qcom_edp_phy_com_resetsm_cntrl_v8,
@@ -1385,6 +1408,7 @@ static const struct phy_ver_ops qcom_edp_phy_ops_v8 = {
 	.configure_rate_pcs	= qcom_edp_configure_rate_pcs_v8,
 	.configure_lanes_after_pll = qcom_edp_configure_lanes_after_pll_v8,
 	.finish_power_on	= qcom_edp_finish_power_on_v8,
+	.video_ready		= qcom_edp_video_ready_v8,
 };
 
 static struct qcom_edp_phy_cfg glymur_phy_cfg = {
-- 
