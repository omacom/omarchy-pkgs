From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Clay Stan <claystan97@gmail.com>
Date: Thu, 26 Nov 2026 00:18:32 -0500
Subject: [PATCH] cix: make sky1-gpt timer built-in and non-unbindable

sky1_timer_probe() registers a system clocksource, clock_event_device,
and IRQ using devm-managed state and register mappings without any
teardown or remove callback. Allowing module unload or sysfs unbind
frees sky1tm and unmaps its MMIO registers while the timer interrupt and
clocksource remain active.

Change SKY1_GPT_TIMER from tristate to bool, set suppress_bind_attrs =
true on sky1_timer_driver, and register it with builtin_platform_driver().

Signed-off-by: Clay Stan <claystan97@gmail.com>
---
 drivers/clocksource/Kconfig          | 2 +-
 drivers/clocksource/timer-sky1-gpt.c | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/drivers/clocksource/Kconfig b/drivers/clocksource/Kconfig
index 380417d..dc468b3 100644
--- a/drivers/clocksource/Kconfig
+++ b/drivers/clocksource/Kconfig
@@ -153,7 +153,7 @@ config REALTEK_OTTO_TIMER
 	  such as RTL9301, RTL9302 or RTL9303.
 
 config SKY1_GPT_TIMER
-	tristate "CIX Sky1 GPT timer driver"
+	bool "CIX Sky1 GPT timer driver"
 	depends on HAS_IOMEM
 	depends on (ARCH_CIX || COMPILE_TEST)
 	select CLKSRC_MMIO
diff --git a/drivers/clocksource/timer-sky1-gpt.c b/drivers/clocksource/timer-sky1-gpt.c
index 3799547..241ebab 100644
--- a/drivers/clocksource/timer-sky1-gpt.c
+++ b/drivers/clocksource/timer-sky1-gpt.c
@@ -379,10 +379,11 @@ static struct platform_driver sky1_timer_driver = {
 		.name = TIMER_NAME,
 		.of_match_table = sky1_timer_match_table,
 		.acpi_match_table = ACPI_PTR(sky1_timer_acpi_match),
+		.suppress_bind_attrs = true,
 	},
 	.probe = sky1_timer_probe,
 };
-module_platform_driver(sky1_timer_driver);
+builtin_platform_driver(sky1_timer_driver);
 
 MODULE_LICENSE("GPL v2");
 MODULE_AUTHOR("Jerry Zhu <jerry.zhu@cixtech.com>");
