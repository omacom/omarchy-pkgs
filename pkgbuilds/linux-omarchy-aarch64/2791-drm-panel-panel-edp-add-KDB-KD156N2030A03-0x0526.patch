From 7ea84d8885d61b2847ae0e8729e64e85f3415c2a Mon Sep 17 00:00:00 2001
From: ciscobugger <xizko55@gmail.com>
Date: Wed, 16 Sep 2026 05:18:25 +0200
Subject: [PATCH] drm/panel: panel-edp: add KDB KD156N2030A03 (0x0526)

The 15.6" 1920x1080 eDP panel in the Samsung Galaxy Book4 Edge NP750XQA
identifies as KDB 0x0526 and is not in the panel table, so panel-edp
falls back to the conservative generic timings and logs an "Unknown
panel" warning on every boot. Use the same 200/500/50 delays as the
other KDB entries; the EDID (reports/panel-edid.bin in the port repo)
carries the mode.

Signed-off-by: ciscobugger <xizko55@gmail.com>
---
 drivers/gpu/drm/panel/panel-edp.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/gpu/drm/panel/panel-edp.c b/drivers/gpu/drm/panel/panel-edp.c
index 0d8792de7..14134620c 100644
--- a/drivers/gpu/drm/panel/panel-edp.c
+++ b/drivers/gpu/drm/panel/panel-edp.c
@@ -2116,6 +2116,7 @@ static const struct edp_panel_entry edp_panels[] = {
 	EDP_PANEL_ENTRY('I', 'V', 'O', 0x8ce6, &delay_200_500_e200, "R140NWFW R0"),
 
 	EDP_PANEL_ENTRY('K', 'D', 'B', 0x044f, &delay_200_500_e80_d50, "Unknown"),
+	EDP_PANEL_ENTRY('K', 'D', 'B', 0x0526, &delay_200_500_e50, "KD156N2030A03"),
 	EDP_PANEL_ENTRY('K', 'D', 'B', 0x0624, &kingdisplay_kd116n21_30nv_a010.delay, "116N21-30NV-A010"),
 	EDP_PANEL_ENTRY('K', 'D', 'B', 0x1118, &delay_200_500_e50, "KD116N29-30NK-A005"),
 	EDP_PANEL_ENTRY('K', 'D', 'B', 0x1120, &delay_200_500_e80_d50, "116N29-30NK-C007"),
-- 
2.55.0

