From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brandon Williams <turbine.bmw@gmail.com>
Date: Mon, 19 Oct 2026 12:50:00 -0400
Subject: [PATCH 2178/2179] drm/msm: keep the GMU optional and its lock
 initialised early

Fixes for the "Attach a driver to the GMU" series as carried here:

- add_gpu_components() added the GMU to the match list even when the GPU
  itself was not added (GPU disabled, unknown chip id, msm.skip_gpu=1), so
  the display master waited for a GMU that could never bind. Add it only
  together with its GPU.
- msm_gpu_probe() handed an empty match list to the component framework
  when no GPU was usable. Return -ENXIO instead.
- The GPU code takes gmu.lock (devfreq, hw_init, PM) before the GMU binds.
  Initialise it in a6xx_gpu_init() again, as before the series, instead of
  in the GMU bind callbacks, which could also re-initialise it while held.

Signed-off-by: Brandon Williams <turbine.bmw@gmail.com>
Assisted-by: Claude:claude-opus-5-5
---
 drivers/gpu/drm/msm/adreno/a6xx_gmu.c |  3 ---
 drivers/gpu/drm/msm/adreno/a6xx_gpu.c |  1 +
 drivers/gpu/drm/msm/msm_drv.c         | 16 +++++++++++-----
 3 files changed, 12 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
index e1d932d577e5..71c236d1dff0 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
@@ -2258,8 +2258,6 @@ static int a6xx_gmu_wrapper_pdev_bind(struct a6xx_gpu *a6xx_gpu, struct device_n
 		goto err_mmio;
 	}
 
-	mutex_init(&gmu->lock);
-
 	gmu->initialized = true;
 
 	return 0;
@@ -2467,7 +2465,6 @@ static int a6xx_gmu_pdev_bind(struct a6xx_gpu *a6xx_gpu, struct device_node *nod
 	/* Initialize RPMh */
 	a6xx_gmu_rpmh_init(gmu);
 
-	mutex_init(&gmu->lock);
 	gmu->initialized = true;
 
 	return 0;
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gpu.c b/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
index adccfa186226..576268637713 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
@@ -2693,6 +2693,7 @@ static struct msm_gpu *a6xx_gpu_init(struct drm_device *dev)
 		gpu->num_perfcntr_groups = a8xx_num_perfcntr_groups;
 	}
 
+	mutex_init(&a6xx_gpu->gmu.lock);
 	spin_lock_init(&a6xx_gpu->aperture_lock);
 
 	adreno_gpu->registers = NULL;
diff --git a/drivers/gpu/drm/msm/msm_drv.c b/drivers/gpu/drm/msm/msm_drv.c
index 65df7f0570e9..fd992f42029e 100644
--- a/drivers/gpu/drm/msm/msm_drv.c
+++ b/drivers/gpu/drm/msm/msm_drv.c
@@ -1026,14 +1026,16 @@ static int add_gpu_components(struct device *dev,
 	if (!np)
 		return 0;
 
-	if (of_device_is_available(np) && adreno_has_gpu(np))
+	if (of_device_is_available(np) && adreno_has_gpu(np)) {
 		drm_of_component_match_add(dev, matchptr, component_compare_of, np);
 
-	gmu_np = of_parse_phandle(np, "qcom,gmu", 0);
-	if (of_device_is_available(gmu_np))
-		drm_of_component_match_add(dev, matchptr, component_compare_of, gmu_np);
+		/* The GMU binds only alongside its GPU; never wait for it alone. */
+		gmu_np = of_parse_phandle(np, "qcom,gmu", 0);
+		if (of_device_is_available(gmu_np))
+			drm_of_component_match_add(dev, matchptr, component_compare_of, gmu_np);
+		of_node_put(gmu_np);
+	}
 
-	of_node_put(gmu_np);
 	of_node_put(np);
 
 	return 0;
@@ -1139,6 +1141,10 @@ int msm_gpu_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
+	/* No usable GPU: nothing to bind. */
+	if (!match)
+		return -ENXIO;
+
 	return component_master_add_with_match(&pdev->dev, &msm_gpu_drm_ops,
 					       match);
 }
