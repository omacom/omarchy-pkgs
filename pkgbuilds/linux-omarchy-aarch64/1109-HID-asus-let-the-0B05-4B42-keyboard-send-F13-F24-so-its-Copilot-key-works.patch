From 413a970869fb9c61d627e83230c12e7acde2ae19 Mon Sep 17 00:00:00 2001
From: David Heinemeier Hansson <david@hey.com>
Date: Sun, 1 Nov 2026 19:28:41 +0100
Subject: [PATCH] HID: asus: let the 0B05:4B42 keyboard send F13-F24, so its
 Copilot key works

The notebook keyboards' key array declares a Logical Maximum of 0x65 under
a Usage Maximum of 0xdd, so hid-input drops any key code above 0x65 as out
of range. QUIRK_FIX_NOTEBOOK_REPORT already raises it to 0xdd, but only
when the item sits at bytes 54-55. The 0B05:4B42 I2C keyboard (ASUS
Zenbook A16, ASUS ProArt P14) has a 144-byte descriptor with the key array
at byte 66, so the fixup never applied. Its Copilot key sends Left Shift +
Left Meta + F23 (report 36 0a 00 72), the F23 was dropped, and the key
reached userspace as a bare Shift+Meta.

Keep the fixed-offset check for the keyboards it already matches, and
otherwise find the key array by its items (Logical Maximum 0x65, Usage
Page Keyboard, Usage Minimum 0x00, Usage Maximum 0xdd, Input Data,Array)
and raise its Logical Maximum the same way.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/hid/hid-asus.c | 45 ++++++++++++++++++++++++++++++++++++++----
 1 file changed, 41 insertions(+), 4 deletions(-)

diff --git a/drivers/hid/hid-asus.c b/drivers/hid/hid-asus.c
index 3c744a7..8683065 100644
--- a/drivers/hid/hid-asus.c
+++ b/drivers/hid/hid-asus.c
@@ -1687,15 +1687,52 @@ static const __u8 asus_g752_fixed_rdesc[] = {
         0x2A, 0xFF, 0x00,		/*   Usage Maximum (0xFF)       */
 };
 
+/*
+ * The key array of the notebook keyboards: a Logical Maximum of 0x65 under a
+ * Usage Maximum of 0xdd, so F13-F24 (0x68-0x73) are dropped as out of range.
+ */
+static const __u8 asus_notebook_key_array[] = {
+	0x25, 0x65,			/*   Logical Maximum (101)      */
+	0x05, 0x07,			/*   Usage Page (Keyboard)      */
+	0x19, 0x00,			/*   Usage Minimum (0x00)       */
+	0x29, 0xdd,			/*   Usage Maximum (0xDD)       */
+	0x81, 0x00,			/*   Input (Data,Array,Abs)     */
+};
+
+static __u8 *asus_find_notebook_key_array(__u8 *rdesc, unsigned int rsize)
+{
+	unsigned int i;
+
+	for (i = 0; i + sizeof(asus_notebook_key_array) <= rsize; i++)
+		if (!memcmp(rdesc + i, asus_notebook_key_array,
+			    sizeof(asus_notebook_key_array)))
+			return rdesc + i;
+
+	return NULL;
+}
+
 static const __u8 *asus_report_fixup(struct hid_device *hdev, __u8 *rdesc,
 		unsigned int *rsize)
 {
 	struct asus_drvdata *drvdata = hid_get_drvdata(hdev);
 
-	if (drvdata->quirks & QUIRK_FIX_NOTEBOOK_REPORT &&
-			*rsize >= 56 && rdesc[54] == 0x25 && rdesc[55] == 0x65) {
-		hid_info(hdev, "Fixing up Asus notebook report descriptor\n");
-		rdesc[55] = 0xdd;
+	if (drvdata->quirks & QUIRK_FIX_NOTEBOOK_REPORT) {
+		__u8 *max = NULL;
+
+		if (*rsize >= 56 && rdesc[54] == 0x25 && rdesc[55] == 0x65) {
+			max = rdesc + 54;
+		} else {
+			/*
+			 * Newer keyboards such as the 0B05:4B42 put the key
+			 * array elsewhere; their Copilot key sends F23.
+			 */
+			max = asus_find_notebook_key_array(rdesc, *rsize);
+		}
+
+		if (max) {
+			hid_info(hdev, "Fixing up Asus notebook report descriptor\n");
+			max[1] = 0xdd;
+		}
 	}
 	/* For the T100TA/T200TA keyboard dock */
 	if (drvdata->quirks & QUIRK_T100_KEYBOARD &&
-- 
2.56.0

