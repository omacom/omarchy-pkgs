+/*
+ * DPTX0 to DPTX2 can feed a DP IN adapter of a USB4 host router: the route
+ * register has no value for DPTX3.
+ */
+static bool msm_dp_usb4_capable(struct msm_dp_display_private *dp)
+{
+	return dp->id <= MSM_DP_CONTROLLER_2 && !dp->msm_dp_display.is_edp;
+}
+
 static int msm_dp_usb4_attach_locked(struct device *dev, struct drm_dp_aux *aux,
 		      const struct msm_dp_usb4_ops *ops, void *data)
 {
@@ -638,7 +647,7 @@ static int msm_dp_usb4_attach_locked(struct device *dev, struct drm_dp_aux *aux,
 	if (!dev_get_drvdata(dev))
 		return -EPROBE_DEFER;
 	dp = dev_get_dp_display_private(dev);
-	if (dp->id != MSM_DP_CONTROLLER_0 || dp->msm_dp_display.is_edp)
+	if (!msm_dp_usb4_capable(dp))
 		return -ENODEV;
 	if (!dp->msm_dp_display.connector || !dp->drm_dev || !dp->drm_dev->registered)
 		return -EPROBE_DEFER;
@@ -1867,15 +1876,16 @@ static const struct dev_pm_ops msm_dp_pm_ops = {
 				pm_runtime_force_resume)
 };
 
-static int msm_dp_usb4_route_locked(struct device *dev, unsigned int resource)
+static int msm_dp_usb4_route_locked(struct device *dev, unsigned int adapter,
+				    bool enable)
 {
 	struct msm_dp_display_private *dp;
 	struct msm_drm_private *priv;
 
-	if (!dev || !dev_get_drvdata(dev) || resource > 3)
+	if (!dev || !dev_get_drvdata(dev))
 		return -EINVAL;
 	dp = dev_get_dp_display_private(dev);
-	if (dp->id != MSM_DP_CONTROLLER_0 || dp->msm_dp_display.is_edp ||
+	if (!msm_dp_usb4_capable(dp) ||
 	    !READ_ONCE(dp->usb4_bound) || !dp->drm_dev || !dev->parent ||
 	    !of_device_is_compatible(dev->parent->of_node, "qcom,glymur-mdss"))
 		return -ENODEV;
@@ -1884,18 +1894,22 @@ static int msm_dp_usb4_route_locked(struct device *dev, unsigned int resource)
 	if (!priv || !priv->kms || !priv->kms->funcs->set_usb4_dp_route)
 		return -EOPNOTSUPP;
 
-	/* MDP_TOP routing belongs to DPU and must survive its power collapse. */
-	return priv->kms->funcs->set_usb4_dp_route(priv->kms, resource);
+	/*
+	 * MDP_TOP routing belongs to DPU and must survive its power collapse.
+	 * The route names this controller: 1 for DPTX0.
+	 */
+	return priv->kms->funcs->set_usb4_dp_route(priv->kms, adapter,
+						   enable ? dp->id + 1 : 0);
 }
 
-int msm_dp_usb4_route(struct device *dev, unsigned int resource)
+int msm_dp_usb4_route(struct device *dev, unsigned int adapter, bool enable)
 {
 	int ret;
 
 	if (!dev)
 		return -EINVAL;
 	device_lock(dev);
-	ret = msm_dp_usb4_route_locked(dev, resource);
+	ret = msm_dp_usb4_route_locked(dev, adapter, enable);
 	device_unlock(dev);
 	return ret;
