+/* Glymur only; the caller must hold the DPU runtime-PM reference. */
+#define DPU_USB4_DP_ADAPTERS		6
+#define DPU_USB4_DP_ROUTE_MASK(adapter)	(0x3 << (4 * (adapter)))
+void dpu_hw_setup_usb4_dp_route(struct dpu_hw_mdp *mdp, u32 mask, u32 route);
 
