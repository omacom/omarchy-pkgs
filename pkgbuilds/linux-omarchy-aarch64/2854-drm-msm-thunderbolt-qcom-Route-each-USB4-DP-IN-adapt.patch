diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_top.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_top.c
index 0be29e88e..7df8bb06a 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_top.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_top.c
@@ -22,16 +22,19 @@
 #define TRAFFIC_SHAPER_WR_CLIENT(num)     (0x060 + (num * 4))
 #define TRAFFIC_SHAPER_FIXPOINT_FACTOR    4
 
+/*
+ * One field per DP IN adapter of the USB4 host routers (two per router),
+ * holding the DP controller that feeds it: 1 to 3 for DPTX0 to DPTX2, 0 for
+ * none.
+ */
 #define MDP_DP_USB4_MUX 0x464
-#define MDP_DP_USB4_MUX_DP0_MASK 0x3
 
-void dpu_hw_setup_usb4_dp_route(struct dpu_hw_mdp *mdp, u32 resource)
+void dpu_hw_setup_usb4_dp_route(struct dpu_hw_mdp *mdp, u32 mask, u32 route)
 {
 	struct dpu_hw_blk_reg_map *c = &mdp->hw;
 	u32 val = DPU_REG_READ(c, MDP_DP_USB4_MUX);
 
-	DPU_REG_WRITE(c, MDP_DP_USB4_MUX,
-		      (val & ~MDP_DP_USB4_MUX_DP0_MASK) | resource);
+	DPU_REG_WRITE(c, MDP_DP_USB4_MUX, (val & ~mask) | (route & mask));
 }
 
 static void dpu_hw_setup_split_pipe(struct dpu_hw_mdp *mdp,
