index fb3a67865..d4cc2c001 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
@@ -1069,21 +1069,28 @@ static void dpu_kms_mdp_snapshot(struct msm_disp_state *disp_state, struct msm_k
 static void dpu_kms_restore_usb4_dp_route(struct dpu_kms *dpu_kms)
 {
 	mutex_lock(&dpu_kms->usb4_route_lock);
-	if (dpu_kms->usb4_dp_route_valid && dpu_kms->hw_mdp) {
-		dpu_hw_setup_usb4_dp_route(dpu_kms->hw_mdp, dpu_kms->usb4_dp_route);
-		dev_dbg(&dpu_kms->pdev->dev, "USB4 DP route restored: resource=%u\n",
-			dpu_kms->usb4_dp_route);
+	if (dpu_kms->usb4_dp_route_mask && dpu_kms->hw_mdp) {
+		dpu_hw_setup_usb4_dp_route(dpu_kms->hw_mdp, dpu_kms->usb4_dp_route_mask,
+					   dpu_kms->usb4_dp_route);
+		dev_dbg(&dpu_kms->pdev->dev, "USB4 DP routes restored: %#x of %#x\n",
+			dpu_kms->usb4_dp_route, dpu_kms->usb4_dp_route_mask);
 	}
 	mutex_unlock(&dpu_kms->usb4_route_lock);
 }
 
-static int dpu_kms_set_usb4_dp_route(struct msm_kms *kms, unsigned int resource)
+/*
+ * Route DP controller @source (1 to 3 for DPTX0 to DPTX2, 0 for none) to DP IN
+ * adapter @adapter of the USB4 host routers (two per router, in order).
+ */
+static int dpu_kms_set_usb4_dp_route(struct msm_kms *kms, unsigned int adapter,
+				     unsigned int source)
 {
 	struct dpu_kms *dpu_kms = to_dpu_kms(kms);
 	struct device *dev = &dpu_kms->pdev->dev;
+	u32 mask, route;
 	int ret;
 
-	if (resource > 3)
+	if (adapter >= DPU_USB4_DP_ADAPTERS || source > 3)
 		return -EINVAL;
 	if (!of_device_is_compatible(dev->of_node, "qcom,glymur-dpu") ||
 	    !dpu_kms->hw_mdp)
@@ -1094,12 +1101,14 @@ static int dpu_kms_set_usb4_dp_route(struct msm_kms *kms, unsigned int resource)
 	 * PM disabled during system sleep) cache the route: the resume
 	 * callback restores it.
 	 */
+	mask = DPU_USB4_DP_ROUTE_MASK(adapter);
+	route = source << (4 * adapter);
 	ret = pm_runtime_get_if_active(dev);
 	mutex_lock(&dpu_kms->usb4_route_lock);
-	dpu_kms->usb4_dp_route = resource;
-	dpu_kms->usb4_dp_route_valid = true;
+	dpu_kms->usb4_dp_route = (dpu_kms->usb4_dp_route & ~mask) | route;
+	dpu_kms->usb4_dp_route_mask |= mask;
 	if (ret > 0)
-		dpu_hw_setup_usb4_dp_route(dpu_kms->hw_mdp, resource);
+		dpu_hw_setup_usb4_dp_route(dpu_kms->hw_mdp, mask, route);
 	mutex_unlock(&dpu_kms->usb4_route_lock);
 	if (ret > 0)
 		pm_runtime_put(dev);
