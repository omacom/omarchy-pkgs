From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ItsLucas <11440538+ItsLucas@users.noreply.github.com>
Date: Fri, 23 Oct 2026 10:03:12 +0800
Subject: [PATCH] platform/surface: aggregator: enable POS events on the
 Surface Laptop 7

If the lid closes right after a Windows shutdown starts, the touchpad
comes back with no input and no haptics, even in GRUB. The fault
survives Linux reboots, touchpad power cycles and overnight shutdowns,
and only booting Windows or an EC reset clears it.

The EC keeps the touchpad off until a host has enabled POS (posture)
events and taken the pending lid closed -> laptop change. Windows'
SurfaceHotPlug enables them at every boot; Linux never did on this
model, because the SL7 node group has no POS node.

Add the existing POS tablet-switch node to the SL7 group, so
surface_aggregator_tabletsw enables the events at probe with the same
bytes Windows sends (TC 0x01, CID 0x0b, payload 26 01 26 00 00). The EC
reports one posture source, ID 1 (2 = lid closed, 3 = laptop). The
driver treats unknown sources as tablet mode, which would make libinput
turn off the keyboard and touchpad, so also teach it this source and
never report tablet mode for it.

Tested by the author on the Surface Laptop 7 15" (romulus15, SAM
26.4.139): with the touchpad stuck, enabling the events made the EC
deliver the queued 2 -> 3 change and the touchpad streamed again within
10 ms; after reproducing the fault, the next Linux boot recovered by
itself; SW_TABLET_MODE stays 0; lid close/open and deep suspend/resume
work.

Tested on the Surface Laptop 7 13.8" (X1E80100) on linux-omarchy
7.3.0-75, ported to this tree: without POS events the touchpad raised 28
interrupts; with the patched surface_aggregator_registry and
surface_aggregator_tabletsw modules loaded it raised 471, pointer and
scroll work, SW_TABLET_MODE stays 0 and the keyboard keeps working.

Link: https://github.com/ItsLucas/surface-laptop-7-ubuntu-kernel/commit/004e91d1e125ebdc0547673a3414395b2cdb7e61
Tested-by: Caleb E. <158400752+FoxesRCool1@users.noreply.github.com> # Surface Laptop 7 13.8"
---
 .../surface/surface_aggregator_registry.c     |  1 +
 .../surface/surface_aggregator_tabletsw.c     | 29 +++++++++++++++++++
 2 files changed, 30 insertions(+)

diff --git a/drivers/platform/surface/surface_aggregator_registry.c b/drivers/platform/surface/surface_aggregator_registry.c
index 311f02a..554a8cb 100644
--- a/drivers/platform/surface/surface_aggregator_registry.c
+++ b/drivers/platform/surface/surface_aggregator_registry.c
@@ -308,6 +308,7 @@ static const struct software_node *ssam_node_group_sl7[] = {
 	&ssam_node_root,
 	&ssam_node_tmp_perf_profile_with_fan,
 	&ssam_node_fan_speed,
+	&ssam_node_pos_tablet_switch,
 	&ssam_node_hid_sam_keyboard,
 	/* TODO: evaluate thermal sensors devices when we get a driver for that */
 	NULL,
diff --git a/drivers/platform/surface/surface_aggregator_tabletsw.c b/drivers/platform/surface/surface_aggregator_tabletsw.c
index 4ee64d6..1e8e502 100644
--- a/drivers/platform/surface/surface_aggregator_tabletsw.c
+++ b/drivers/platform/surface/surface_aggregator_tabletsw.c
@@ -419,6 +419,7 @@ MODULE_PARM_DESC(tablet_mode_in_slate_state, "Enable tablet mode in slate device
 
 enum ssam_pos_source_id {
 	SSAM_POS_SOURCE_COVER = 0x00,
+	SSAM_POS_SOURCE_LID   = 0x01,
 	SSAM_POS_SOURCE_SLS   = 0x03,
 };
 
@@ -431,6 +432,12 @@ enum ssam_pos_state_cover {
 	SSAM_POS_COVER_BOOK          = 0x06,
 };
 
+/* Lid of a clamshell laptop (Surface Laptop 7). */
+enum ssam_pos_state_lid {
+	SSAM_POS_LID_CLOSED = 0x02,
+	SSAM_POS_LID_LAPTOP = 0x03,
+};
+
 enum ssam_pos_state_sls {
 	SSAM_POS_SLS_LID_CLOSED = 0x00,
 	SSAM_POS_SLS_LAPTOP     = 0x01,
@@ -470,6 +477,21 @@ static const char *ssam_pos_state_name_cover(struct ssam_tablet_sw *sw, u32 stat
 	}
 }
 
+static const char *ssam_pos_state_name_lid(struct ssam_tablet_sw *sw, u32 state)
+{
+	switch (state) {
+	case SSAM_POS_LID_CLOSED:
+		return "closed";
+
+	case SSAM_POS_LID_LAPTOP:
+		return "laptop";
+
+	default:
+		dev_warn(&sw->sdev->dev, "unknown device posture for lid: %u\n", state);
+		return "<unknown>";
+	}
+}
+
 static const char *ssam_pos_state_name_sls(struct ssam_tablet_sw *sw, u32 state)
 {
 	switch (state) {
@@ -498,6 +520,9 @@ static const char *ssam_pos_state_name(struct ssam_tablet_sw *sw,
 	case SSAM_POS_SOURCE_COVER:
 		return ssam_pos_state_name_cover(sw, state->state);
 
+	case SSAM_POS_SOURCE_LID:
+		return ssam_pos_state_name_lid(sw, state->state);
+
 	case SSAM_POS_SOURCE_SLS:
 		return ssam_pos_state_name_sls(sw, state->state);
 
@@ -552,6 +577,10 @@ static bool ssam_pos_state_is_tablet_mode(struct ssam_tablet_sw *sw,
 	case SSAM_POS_SOURCE_COVER:
 		return ssam_pos_state_is_tablet_mode_cover(sw, state->state);
 
+	case SSAM_POS_SOURCE_LID:
+		/* A clamshell lid has no tablet posture. */
+		return false;
+
 	case SSAM_POS_SOURCE_SLS:
 		return ssam_pos_state_is_tablet_mode_sls(sw, state->state);
 
