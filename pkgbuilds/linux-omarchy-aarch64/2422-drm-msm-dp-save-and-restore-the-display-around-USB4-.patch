From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 8 Oct 2026 13:55:02 -0500
Subject: [PATCH] drm/msm/dp: save and restore the display around USB4 system
 sleep

For system sleep with a USB4 dock attached, the USB4 host router stops
the tunnel and rebuilds it after resume. The DP output fed through the
tunnel must be off before the router releases the DP IN adapter and
must be enabled again only after the tunnel is back; the ordinary
display suspend and resume callbacks run at the wrong points for that.

Add msm_dp_usb4_sleep_prepare() and msm_dp_usb4_sleep_complete() for
the router driver. Each drains pending tunnel HPD work, then asks
msm_kms to save the atomic state and disable the outputs, or to restore
them. msm_kms keeps the ordinary callbacks from touching the saved
state in between.

Experimental; exercised only on the Surface Laptop 8 with its USB4 host
router driver.

Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/gpu/drm/msm/dp/dp_display.c | 55 +++++++++++++++++++++++++++++
 include/linux/soc/qcom/usb4-dp.h    |  7 ++++
 2 files changed, 62 insertions(+)

diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index 28b988f605c..fc5b2cc90ce 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -701,6 +701,61 @@ int msm_dp_usb4_hpd(struct device *dev, bool connected, bool irq)
 }
 EXPORT_SYMBOL_GPL(msm_dp_usb4_hpd);
 
+int msm_dp_usb4_sleep_prepare(struct device *dev)
+{
+	struct msm_dp_display_private *dp;
+	int ret;
+
+	if (!dev)
+		return -ENODEV;
+	device_lock(dev);
+	if (!dev_get_drvdata(dev)) {
+		ret = -ENODEV;
+		goto out;
+	}
+	dp = dev_get_dp_display_private(dev);
+	if (!dp || !dp->drm_dev || !dp->usb4_attached) {
+		ret = -ENODEV;
+		goto out;
+	}
+	/* Drain HPD before taking the atomic snapshot, without a modeset lock. */
+	flush_work(&dp->usb4_hpd_work);
+	ret = msm_kms_usb4_sleep_prepare(dp->drm_dev);
+	dev_dbg(dev, "USB4 sleep modeset saved: ret=%d power=%d link_ref=%d\n",
+		ret, dp->msm_dp_display.power_on, dp->link_pm_ref);
+out:
+	device_unlock(dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(msm_dp_usb4_sleep_prepare);
+
+int msm_dp_usb4_sleep_complete(struct device *dev)
+{
+	struct msm_dp_display_private *dp;
+	int ret;
+
+	if (!dev)
+		return -ENODEV;
+	device_lock(dev);
+	if (!dev_get_drvdata(dev)) {
+		ret = -ENODEV;
+		goto out;
+	}
+	dp = dev_get_dp_display_private(dev);
+	if (!dp || !dp->drm_dev) {
+		ret = -ENODEV;
+		goto out;
+	}
+	flush_work(&dp->usb4_hpd_work);
+	ret = msm_kms_usb4_sleep_complete(dp->drm_dev);
+	dev_dbg(dev, "USB4 sleep modeset restored: ret=%d power=%d link_ref=%d\n",
+		ret, dp->msm_dp_display.power_on, dp->link_pm_ref);
+out:
+	device_unlock(dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(msm_dp_usb4_sleep_complete);
+
 /* Stop reporting HPD before release. DRM owns active-stream teardown. */
 static int msm_dp_usb4_hpd_sync_locked(struct device *dev, bool connected, bool irq)
 {
diff --git a/include/linux/soc/qcom/usb4-dp.h b/include/linux/soc/qcom/usb4-dp.h
index 5773570274c..fd1528fa791 100644
--- a/include/linux/soc/qcom/usb4-dp.h
+++ b/include/linux/soc/qcom/usb4-dp.h
@@ -38,6 +38,9 @@ int msm_dp_usb4_hpd(struct device *dev, bool connected, bool irq);
 /* Returns -EBUSY on disconnect while DRM still owns an active/prepared link. */
 int msm_dp_usb4_hpd_sync(struct device *dev, bool connected, bool irq);
 int msm_dp_usb4_route(struct device *dev, unsigned int resource);
+/* Paired system-sleep calls; restore after the provider has returned. */
+int msm_dp_usb4_sleep_prepare(struct device *dev);
+int msm_dp_usb4_sleep_complete(struct device *dev);
 #else
 static inline int msm_dp_usb4_attach(struct device *dev, struct drm_dp_aux *aux,
 		const struct msm_dp_usb4_ops *ops, void *data) { return -ENODEV; }
@@ -48,5 +51,9 @@ static inline int msm_dp_usb4_hpd_sync(struct device *dev, bool connected, bool
 { return -ENODEV; }
 static inline int msm_dp_usb4_route(struct device *dev, unsigned int resource)
 { return -ENODEV; }
+static inline int msm_dp_usb4_sleep_prepare(struct device *dev)
+{ return -ENODEV; }
+static inline int msm_dp_usb4_sleep_complete(struct device *dev)
+{ return -ENODEV; }
 #endif
 #endif
-- 
