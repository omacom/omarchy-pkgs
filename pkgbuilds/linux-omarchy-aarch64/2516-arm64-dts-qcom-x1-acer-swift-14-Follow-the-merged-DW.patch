From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Mon, 2 Nov 2026 23:06:46 +0000
Subject: [PATCH] arm64: dts: qcom: x1-acer-swift-14: Follow the merged DWC3
 nodes

Hamoa's USB controllers no longer have a separate DWC3 child node, so
the usb_1_ss0_dwc3, usb_1_ss1_dwc3 and usb_2_dwc3 labels are gone. Set
dr_mode on the controllers themselves, as the other X1 boards do.
---
 arch/arm64/boot/dts/qcom/x1-acer-swift-14.dtsi | 18 ++++++------------
 1 file changed, 6 insertions(+), 12 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/x1-acer-swift-14.dtsi b/arch/arm64/boot/dts/qcom/x1-acer-swift-14.dtsi
index 389cc9b..50e09b9 100644
--- a/arch/arm64/boot/dts/qcom/x1-acer-swift-14.dtsi
+++ b/arch/arm64/boot/dts/qcom/x1-acer-swift-14.dtsi
@@ -1372,11 +1372,9 @@ &usb_1_ss0_qmpphy {
 };
 
 &usb_1_ss0 {
-	status = "okay";
-};
-
-&usb_1_ss0_dwc3 {
 	dr_mode = "host";
+
+	status = "okay";
 };
 
 &usb_1_ss0_dwc3_hs {
@@ -1404,11 +1402,9 @@ &usb_1_ss1_qmpphy {
 };
 
 &usb_1_ss1 {
-	status = "okay";
-};
-
-&usb_1_ss1_dwc3 {
 	dr_mode = "host";
+
+	status = "okay";
 };
 
 &usb_1_ss1_dwc3_hs {
@@ -1420,11 +1416,9 @@ &usb_1_ss1_qmpphy_out {
 };
 
 &usb_2 {
-	status = "okay";
-};
-
-&usb_2_dwc3 {
 	dr_mode = "host";
+
+	status = "okay";
 };
 
 &usb_2_hsphy {
-- 
2.56.0

