+	model = "Acer Aspire 14 AI (A14-11M)";
+	compatible = "acer,aspire-a14-11m", "qcom,x1p42100";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/x1p42100/ACER/A14-11M/qcdxkmsucpurwa.mbn";
+};
+
+&remoteproc_adsp {
+	firmware-name = "qcom/x1p42100/ACER/A14-11M/qcadsp8380.mbn",
+			"qcom/x1p42100/ACER/A14-11M/adsp_dtbs.elf";
+
