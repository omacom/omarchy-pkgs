 .../x1p42100-asus-zenbook-14-ux3480qa.dts     | 222 ++++++++++++++++++
 1 file changed, 222 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1p42100-asus-zenbook-14-ux3480qa.dts b/arch/arm64/boot/dts/qcom/x1p42100-asus-zenbook-14-ux3480qa.dts
index 829dc75..749f574 100644
--- a/arch/arm64/boot/dts/qcom/x1p42100-asus-zenbook-14-ux3480qa.dts
+++ b/arch/arm64/boot/dts/qcom/x1p42100-asus-zenbook-14-ux3480qa.dts
@@ -385,3 +385,225 @@ CPU_ALERT(cpu1-3-top, cpu1_3_top_alert, cpu4);
 CPU_ALERT(cpu1-3-btm, cpu1_3_btm_alert, cpu4);
 CPU_ALERT(cpuss1-top, cpuss1_top_alert, cpu4);
 CPU_ALERT(cpuss1-btm, cpuss1_btm_alert, cpu4);
+
+/*
+ * The Zenbook 14 UX3480QAB (BIOS UX3480QAB.304) resets, with no panic, about
+ * half a second after qcom_aoss binds while these CoreSight blocks are on.
+ * qcom_aoss provides the QDSS clock they take as their apb_pclk, and none of
+ * them carries arm,primecell-periphid, so the AMBA bus then enables that
+ * clock and reads each block's peripheral ID. With them off it boots. The
+ * UX3480QA (BIOS UX3480QA.303) boots with them on, but nothing here uses
+ * tracing, so the trace path stays off on both.
+ */
