From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Mon, 2 Nov 2026 23:06:46 +0000
Subject: [PATCH] arm64: dts: qcom: x1p64100-dell-latitude-5455: Reach the
 panel through DP3

x1-dell-thena.dtsi doesn't label its eDP panel in this tree, so the
dp3_panel reference doesn't resolve. Add the backlight to the panel
under mdss_dp3's aux-bus instead.
---
 arch/arm64/boot/dts/qcom/x1p64100-dell-latitude-5455.dts | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/x1p64100-dell-latitude-5455.dts b/arch/arm64/boot/dts/qcom/x1p64100-dell-latitude-5455.dts
index 4396661..28640f5 100644
--- a/arch/arm64/boot/dts/qcom/x1p64100-dell-latitude-5455.dts
+++ b/arch/arm64/boot/dts/qcom/x1p64100-dell-latitude-5455.dts
@@ -87,8 +87,12 @@ &iris {
 	status = "okay";
 };
 
-&dp3_panel {
-	backlight = <&backlight>;
+&mdss_dp3 {
+	aux-bus {
+		panel {
+			backlight = <&backlight>;
+		};
+	};
 };
 
 &remoteproc_adsp {
-- 
2.56.0

