From 99dded9d4ae4144adda4405bb22245880c13570d Mon Sep 17 00:00:00 2001
From: Brandon Williams <turbine.bmw@gmail.com>
Date: Tue, 13 Oct 2026 14:21:46 -0400
Subject: [PATCH 2167/2169] media: i2c: vd55g0: power the sensor off only once
 when probe fails

probe() let runtime PM suspend the sensor, which powers it off, before
registering the subdevice, and the error path then powered it off again,
unbalancing the clock and regulator enables. Keep a runtime PM reference
until the subdevice is registered, as the imx681 driver does, so a failed
or deferred registration powers the sensor off exactly once.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Brandon Williams <turbine.bmw@gmail.com>
---
 drivers/media/i2c/vd55g0.c | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/drivers/media/i2c/vd55g0.c b/drivers/media/i2c/vd55g0.c
index 21b678093b62..98918ecd6e8a 100644
--- a/drivers/media/i2c/vd55g0.c
+++ b/drivers/media/i2c/vd55g0.c
@@ -1920,10 +1920,13 @@ static int vd55g0_probe(struct i2c_client *client)
 		goto error_handler_free;
 	}
 
-	/* Enable runtime PM and turn off the device */
+	/*
+	 * Enable runtime PM, but keep the device powered until it is
+	 * registered: the error path below powers it off itself.
+	 */
 	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
 	pm_runtime_enable(dev);
-	pm_runtime_idle(dev);
 
 	ret = v4l2_async_register_subdev(&sensor->sd);
 	if (ret) {
@@ -1933,6 +1936,7 @@ static int vd55g0_probe(struct i2c_client *client)
 
 	pm_runtime_set_autosuspend_delay(&client->dev, 1000);
 	pm_runtime_use_autosuspend(&client->dev);
+	pm_runtime_put_autosuspend(&client->dev);
 
 	dev_dbg(&client->dev, "vd55g0 probe successfully");
 
@@ -1940,6 +1944,7 @@ static int vd55g0_probe(struct i2c_client *client)
 
 error_pm_runtime:
 	pm_runtime_disable(&client->dev);
+	pm_runtime_put_noidle(&client->dev);
 	pm_runtime_set_suspended(&client->dev);
 	media_entity_cleanup(&sensor->sd.entity);
 error_handler_free:
