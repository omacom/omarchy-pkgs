From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 12 Nov 2026 22:18:22 -0600
Subject: [PATCH 2856/2856] arm64: dts: qcom: surface-laptop8: DisplayPort through USB4
 host router 1

Give the second DP controller the DP-IN and USB router link clocks it
needs to feed USB4 host router 1, as the first one has for router 0,
and describe the second DP producer/AUX block that the PHY of the
second USB-C port programs for USB4.

Tested with a Surface Thunderbolt 4 Dock and a monitor on the second
port: 3840x2160 60 Hz on plug-in, after suspend and at boot.

Assisted-by: Claude Fable 5.2
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 .../qcom/glymur-microsoft-surface-laptop8.dts | 30 +++++++++++++++----
 1 file changed, 24 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/glymur-microsoft-surface-laptop8.dts b/arch/arm64/boot/dts/qcom/glymur-microsoft-surface-laptop8.dts
index 5f5e9d4ea..ee562c014 100644
--- a/arch/arm64/boot/dts/qcom/glymur-microsoft-surface-laptop8.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-microsoft-surface-laptop8.dts
@@ -633,6 +633,24 @@ &mdss_dp0_out {
 &mdss_dp1 {
 	/* DisplayPort alt mode on USB-C port 1, through the pmic-glink bridge */
 	status = "okay";
+
+	/* DP IN and USB router link clocks for DisplayPort tunnelled by USB4 router 1 */
+	clocks = <&dispcc DISP_CC_MDSS_AHB_CLK>,
+		 <&dispcc DISP_CC_MDSS_DPTX1_AUX_CLK>,
+		 <&dispcc DISP_CC_MDSS_DPTX1_LINK_CLK>,
+		 <&dispcc DISP_CC_MDSS_DPTX1_LINK_INTF_CLK>,
+		 <&dispcc DISP_CC_MDSS_DPTX1_PIXEL0_CLK>,
+		 <&dispcc DISP_CC_MDSS_DPTX1_PIXEL1_CLK>,
+		 <&dispcc DISP_CC_MDSS_DPTX1_LINK_DPIN_CLK>,
+		 <&dispcc DISP_CC_MDSS_DPTX1_USB_ROUTER_LINK_INTF_CLK>;
+	clock-names = "core_iface",
+		      "core_aux",
+		      "ctrl_link",
+		      "ctrl_link_iface",
+		      "stream_pixel",
+		      "stream_1_pixel",
+		      "ctrl_link_dpin",
+		      "ctrl_usb4_link_iface";
 };
 
 &mdss_dp1_out {
@@ -1347,14 +1365,14 @@ &usb_1_hsphy {
 
 &usb_1_qmpphy {
 	/*
-	 * USB4 DP producer/AUX block written during USB4 PHY setup, the one
-	 * usb_0_qmpphy describes too. The platform's Windows driver also
-	 * writes a second block at 0x088f0000 for this router, left out
-	 * until DisplayPort through router 1 is worked on.
+	 * USB4 DP producer/AUX blocks written during USB4 PHY setup: the one
+	 * usb_0_qmpphy describes too, and a second one the platform's Windows
+	 * driver writes first for this router.
 	 */
 	reg = <0x0 0x00fde000 0x0 0x8000>,
-	      <0x0 0x00fe6000 0x0 0xcc>;
-	reg-names = "phy", "usb4-dp-aux";
+	      <0x0 0x00fe6000 0x0 0xcc>,
+	      <0x0 0x088f0000 0x0 0xcc>;
+	reg-names = "phy", "usb4-dp-aux", "usb4-dp-aux2";
 	qcom,usb4-rx-eq = <0x6f>;
 	vdda-phy-supply = <&vreg_l1h_e0>;
 	vdda-pll-supply = <&vreg_l4h_e0>;
-- 
