From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Sat, 7 Nov 2026 10:48:44 +0100
Subject: [PATCH] arm64: dts: qcom: x1p42100-hp-omnibook-3-oled: Follow the
 bindings

The tree lists the ThinkPad T14s after its own compatible, so that the
QSEECOM allowlist gives the laptop EFI variables. Drop it, since a
later patch gives the OmniBook 3 its own allowlist entry. Drop the
unlisted hp,omnibook-3 too, and name the X1-26-100 as the other
X1-26-100 boards do.

The samsung,atna33xc20 binding has no max-brightness, and neither the
panel driver nor the DP AUX backlight reads it, since the panel gives
its own brightness range over AUX. Drop it.

The Wi-Fi card is a WCN6855, PCI 17cb:1103, as an owner's boot log and
the 16's Windows show. Name it so, rather than the WCN7850's 1107 the
tree took from the OmniBook X 14's.

Load the DSP and GPU firmware from qcom/x1p42100/hp/omnibook-3/ rather
than the OmniBook X 14's folder. HP signs a different ADSP image and
zap shader for each of these laptops, and owners put their own
laptop's files in that folder.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 arch/arm64/boot/dts/qcom/x1-hp-omnibook-3.dtsi       |  8 +-------
 .../boot/dts/qcom/x1p42100-hp-omnibook-3-oled.dts    | 12 ++++++------
 2 files changed, 7 insertions(+), 13 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/x1-hp-omnibook-3.dtsi b/arch/arm64/boot/dts/qcom/x1-hp-omnibook-3.dtsi
index 9ff4bcb..3d65917 100644
--- a/arch/arm64/boot/dts/qcom/x1-hp-omnibook-3.dtsi
+++ b/arch/arm64/boot/dts/qcom/x1-hp-omnibook-3.dtsi
@@ -1054,12 +1054,6 @@
 			enable-gpios = <&pmc8380_3_gpios 4 GPIO_ACTIVE_HIGH>;
 			power-supply = <&vreg_edp_3p3>;
 
-			/*
-			 * Panel reports 11-bit PWM (PWMGEN_BIT_COUNT=0x0b), so
-			 * 2047 levels. Silences "no max-brightness property found".
-			 */
-			max-brightness = <2047>;
-
 			pinctrl-0 = <&edp_bl_en>;
 			pinctrl-names = "default";
 
@@ -1114,7 +1108,7 @@
 	wake-gpios = <&tlmm 148 GPIO_ACTIVE_LOW>;
 
 	wifi@0 {
-		compatible = "pci17cb,1107";
+		compatible = "pci17cb,1103";
 		reg = <0x10000 0x0 0x0 0x0 0x0>;
 
 		vddaon-supply = <&vreg_pmu_aon_0p8>;
diff --git a/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-3-oled.dts b/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-3-oled.dts
index 35c0aa0..92ff6df 100644
--- a/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-3-oled.dts
+++ b/arch/arm64/boot/dts/qcom/x1p42100-hp-omnibook-3-oled.dts
@@ -11,24 +11,24 @@
 
 / {
 	model = "HP OmniBook 3 Laptop 14-hz0xxx";
-	compatible = "hp,omnibook-3-oled","hp,omnibook-3", "lenovo,thinkpad-t14s", "qcom,x1p42100";
+	compatible = "hp,omnibook-3-oled", "qcom,x126100", "qcom,x1p42100";
 	chassis-type = "laptop";
 };
 
 &gpu_zap_shader {
-	firmware-name = "qcom/x1p42100/hp/omnibook-x14/qcdxkmsucpurwa.mbn";
+	firmware-name = "qcom/x1p42100/hp/omnibook-3/qcdxkmsucpurwa.mbn";
 };
 
 &remoteproc_adsp {
-	firmware-name = "qcom/x1p42100/hp/omnibook-x14/qcadsp8380.mbn",
-			"qcom/x1p42100/hp/omnibook-x14/adsp_dtbs.elf";
+	firmware-name = "qcom/x1p42100/hp/omnibook-3/qcadsp8380.mbn",
+			"qcom/x1p42100/hp/omnibook-3/adsp_dtbs.elf";
 
 	status = "okay";
 };
 
 &remoteproc_cdsp {
-	firmware-name = "qcom/x1p42100/hp/omnibook-x14/qccdsp8380.mbn",
-			"qcom/x1p42100/hp/omnibook-x14/cdsp_dtbs.elf";
+	firmware-name = "qcom/x1p42100/hp/omnibook-3/qccdsp8380.mbn",
+			"qcom/x1p42100/hp/omnibook-3/cdsp_dtbs.elf";
 
 	status = "okay";
 };
-- 
