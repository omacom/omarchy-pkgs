From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nicola Nicodemo <nicola084@gmail.com>
Date: Sun, 4 Oct 2026 14:20:08 +0200
Subject: [PATCH] usb: typec: samsung-emuec: quiesce event handling
 across system sleep

On a Galaxy Book4 Edge 14" (NP940XMA), unplugging the charger while the
system is in s2idle and then resuming on battery resets the machine. No
crash record is left (EFI pstore empty), and nothing from the resume
reaches the journal. Windows survives the same sequence.

With the charging port's driver unbound before suspend, the same unplug
does not reset the machine. Stopping only this driver's event handling
across the transition is enough: the interrupt is masked and the sync
and HPD work stopped from PM_SUSPEND_PREPARE, before any device suspends,
until PM_POST_SUSPEND, after all devices have resumed. Port state (USB
role, orientation, mux/retimer, partner) is left untouched; the port is
resynced once afterwards, which also negotiates a charger plugged in
during sleep (previously the interrupt was replayed early in resume,
clearing it failed with -EACCES and no contract was made).

Tested with the PD retry fix (kernel-anatase#1) on 7.2.7: pm_test=devices
and real s2idle with charger unplugged during sleep, lid-close suspend on
both ports, charger plugged in during sleep (20 V on resume), USB storage
after resume. Which call in the event path brings the machine down is not
identified.

Signed-off-by: Nicola Nicodemo <nicola084@gmail.com>
[birk: rebased onto antheas's samsung-emuec at 00dbccf779]
Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 drivers/usb/typec/samsung-emuec.c | 55 +++++++++++++++++++++++++++++++
 1 file changed, 55 insertions(+)

diff --git a/drivers/usb/typec/samsung-emuec.c b/drivers/usb/typec/samsung-emuec.c
index fcb0f9ebe..5ce664aed 100644
--- a/drivers/usb/typec/samsung-emuec.c
+++ b/drivers/usb/typec/samsung-emuec.c
@@ -20,6 +20,7 @@
 #include <linux/of.h>
 #include <linux/pm.h>
 #include <linux/power_supply.h>
+#include <linux/suspend.h>
 #include <linux/slab.h>
 #include <linux/unaligned.h>
 #include <linux/usb/pd.h>
@@ -109,8 +110,13 @@ struct samsung_emuec {
 	u8 dp_pin;
 	u32 requested_rdo;
 	u32 requested_pdo;
+	struct notifier_block pm_nb;
+	bool quiesced;
 };
 
+static int samsung_emuec_pm_notify(struct notifier_block *nb,
+				   unsigned long action, void *data);
+
 static int samsung_emuec_read(struct samsung_emuec *pdic, u16 reg,
 			      void *buf, size_t len)
 {
@@ -786,6 +792,10 @@ static void samsung_emuec_sync(struct work_struct *work)
 
 	guard(mutex)(&pdic->lock);
 
+	/* System sleep in progress: leave the port as it is, resync afterwards. */
+	if (pdic->quiesced)
+		return;
+
 	ret = samsung_emuec_read(pdic, S2MM006_REG_BC_STATUS, &bc, sizeof(bc));
 	if (ret)
 		return;
@@ -1094,6 +1104,11 @@ static int samsung_emuec_probe(struct i2c_client *client)
 	if (ret)
 		goto err_pd;
 
+	pdic->pm_nb.notifier_call = samsung_emuec_pm_notify;
+	ret = register_pm_notifier(&pdic->pm_nb);
+	if (ret)
+		goto err_pd;
+
 	mod_delayed_work(system_dfl_wq, &pdic->work, 0);
 	return 0;
 
@@ -1113,10 +1128,50 @@ static int samsung_emuec_probe(struct i2c_client *client)
 	return ret;
 }
 
+/*
+ * Unplugging a charger during s2idle and resuming on battery resets the
+ * machine if this driver handles events across the sleep transition. Keep
+ * the port state (role, orientation, mux/retimer, partner) as it is, stop
+ * the interrupt and the sync/HPD work from before any device suspends until
+ * all devices have resumed, then resync once.
+ */
+static int samsung_emuec_pm_notify(struct notifier_block *nb,
+				   unsigned long action, void *data)
+{
+	struct samsung_emuec *pdic = container_of(nb, struct samsung_emuec, pm_nb);
+	struct device *dev = &pdic->client->dev;
+
+	switch (action) {
+	case PM_SUSPEND_PREPARE:
+		scoped_guard(mutex, &pdic->lock)
+			pdic->quiesced = true;
+		disable_irq(pdic->client->irq);	/* waits for a running handler */
+		cancel_delayed_work_sync(&pdic->work);
+		flush_work(&pdic->hpd_work);
+		dev_info(dev, "pm: quiesced (attached=%d)\n", pdic->attached);
+		break;
+	case PM_POST_SUSPEND:
+		if (!pdic->quiesced)
+			break;
+		scoped_guard(mutex, &pdic->lock)
+			pdic->quiesced = false;
+		enable_irq(pdic->client->irq);
+		mod_delayed_work(system_dfl_wq, &pdic->work, 0);
+		dev_info(dev, "pm: resumed, resync\n");
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
 static void samsung_emuec_remove(struct i2c_client *client)
 {
 	struct samsung_emuec *pdic = i2c_get_clientdata(client);
 
+	unregister_pm_notifier(&pdic->pm_nb);
+	if (pdic->quiesced)
+		enable_irq(client->irq);
+
 	devm_free_irq(&client->dev, client->irq, pdic);
 	cancel_delayed_work_sync(&pdic->work);
 
