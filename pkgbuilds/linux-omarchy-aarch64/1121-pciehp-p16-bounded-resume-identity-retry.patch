+/* Experiment: this soldered reader can initially return all ones on resume. */
+static bool pciehp_p16_resume_replaced(struct controller *ctrl)
+{
+	struct pci_dev *port = ctrl->pcie->port;
+	struct pci_dev *pdev;
+	unsigned long deadline;
+	u32 reg, expected;
+	unsigned int retries = 0;
+	bool replaced;
+
+	if (pci_dev_is_disconnected(port))
+		return false;
+	if (!dmi_match(DMI_SYS_VENDOR, "ASUS") ||
+	    !dmi_match(DMI_PRODUCT_NAME, "ProArt P16 H7607BA") ||
+	    !dmi_match(DMI_BIOS_VERSION, "H7607BA.303") ||
+	    port->vendor != 0x10de || port->device != 0x22d0 ||
+	    pci_domain_nr(port->bus) != 6 || port->bus->number != 0 ||
+	    port->devfn != PCI_DEVFN(0, 0))
+		return pciehp_device_replaced(ctrl);
+
+	pdev = pci_get_slot(port->subordinate, PCI_DEVFN(0, 0));
+	if (!pdev)
+		return pciehp_device_replaced(ctrl);
+	if (pdev->vendor != 0x17a0 || pdev->device != 0x9767 ||
+	    pci_domain_nr(pdev->bus) != 6 || pdev->bus->number != 1 ||
+	    pdev->devfn != PCI_DEVFN(0, 0)) {
+		pci_dev_put(pdev);
+		return pciehp_device_replaced(ctrl);
+	}
+
+	expected = pdev->vendor | (pdev->device << 16);
+	deadline = jiffies + msecs_to_jiffies(1000);
+	for (;;) {
+		if (pci_dev_is_disconnected(pdev) ||
+		    pci_read_config_dword(pdev, PCI_VENDOR_ID, &reg)) {
+			replaced = true;
+			break;
+		}
+		if (reg != 0xffffffff) {
+			/* A valid different identity must never be retried or hidden. */
+			replaced = reg != expected || pciehp_device_replaced(ctrl);
+			break;
+		}
+		if (retries++ == 50 || time_after_eq(jiffies, deadline)) {
+			replaced = true;
+			break;
+		}
+		msleep(20);
+		/* Do not start another config transaction after the budget. */
+		if (time_after_eq(jiffies, deadline)) {
+			replaced = true;
+			break;
+		}
+	}
+	pci_dev_put(pdev);
+	return replaced;
+}
+
