From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Thu, 5 Nov 2026 21:49:50 +0000
Subject: [PATCH] arm64: dts: qcom: x126100-asus-vivobook-16: Build on
 purwa.dtsi

The X1-26-100 is a Purwa part like the X1P-42-100. The tree's
x126100.dtsi includes purwa.dtsi and only puts qcom,x126100 compatibles
in front of those of the clock controllers and the PCIe PHYs, which no
binding or driver knows. Include purwa.dtsi directly and drop the file,
and drop the same kind of compatible from the pmic-glink and sound
nodes. Add qcom,x1p42100 to the board compatibles after qcom,x126100,
as the IdeaPad Slim 3x has them, since the PD mapper, the UBWC table
and FastRPC find the SoC by that compatible.

The tree was written for USB controllers with a dwc3 child node, so
its host mode overrides were commented out. Set dr_mode on usb_1_ss0,
usb_1_ss1 and usb_2 themselves, as the Vivobook S 15's tree does. Move
PERST# and WAKE# from the PCIe controllers to their root ports, where
the binding wants them and the PCI core looks for WAKE#.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 .../dts/qcom/x126100-asus-vivobook-16.dts     |  4 +-
 .../dts/qcom/x126100-asus-vivobook-16.dtsi    | 42 ++++++++-----------
 arch/arm64/boot/dts/qcom/x126100.dtsi         | 24 -----------
 3 files changed, 19 insertions(+), 51 deletions(-)
 delete mode 100644 arch/arm64/boot/dts/qcom/x126100.dtsi

diff --git a/arch/arm64/boot/dts/qcom/x126100-asus-vivobook-16.dts b/arch/arm64/boot/dts/qcom/x126100-asus-vivobook-16.dts
index 2296aa2..964e505 100644
--- a/arch/arm64/boot/dts/qcom/x126100-asus-vivobook-16.dts
+++ b/arch/arm64/boot/dts/qcom/x126100-asus-vivobook-16.dts
@@ -6,8 +6,8 @@
 
 /dts-v1/;
 
-#include "x126100.dtsi"
+#include "purwa.dtsi"
 #include "x126100-asus-vivobook-16.dtsi"
 
 /delete-node/ &pmc8380_6;
-/delete-node/ &pmc8380_6_thermal;
\ No newline at end of file
+/delete-node/ &pmc8380_6_thermal;
diff --git a/arch/arm64/boot/dts/qcom/x126100-asus-vivobook-16.dtsi b/arch/arm64/boot/dts/qcom/x126100-asus-vivobook-16.dtsi
index b80707a..c26fa68 100644
--- a/arch/arm64/boot/dts/qcom/x126100-asus-vivobook-16.dtsi
+++ b/arch/arm64/boot/dts/qcom/x126100-asus-vivobook-16.dtsi
@@ -16,7 +16,7 @@
 
 / {
 	model = "ASUS Vivobook 16 (F1607QA)";
-	compatible = "asus,vivobook-x16", "qcom,x126100";
+	compatible = "asus,vivobook-x16", "qcom,x126100", "qcom,x1p42100";
 	chassis-type = "laptop";
 
 	aliases {
@@ -123,8 +123,7 @@ hdmi_con: endpoint {
 	};
 
 	pmic-glink {
-		compatible = "qcom,x126100-pmic-glink",
-					 "qcom,x1e80100-pmic-glink",
+		compatible = "qcom,x1e80100-pmic-glink",
 					 "qcom,sm8550-pmic-glink",
 					 "qcom,pmic-glink";
 		orientation-gpios = <&tlmm 121 GPIO_ACTIVE_HIGH>,
@@ -411,7 +410,7 @@ vreg_wcn_3p3: regulator-wcn-3p3 {
 	};
 
 	sound {
-		compatible = "qcom,x126100-sndcard", "qcom,x1e80100-sndcard";
+		compatible = "qcom,x1e80100-sndcard";
 		model = "X126100-ASUS-Vivobook-16";
 		audio-routing = "SpkrLeft IN", "WSA WSA_SPK1 OUT",
 						"SpkrRight IN", "WSA WSA_SPK2 OUT",
@@ -1204,9 +1203,6 @@ &mdss_dp3_phy {
 };
 
 &pcie4 {
-	perst-gpios = <&tlmm 146 GPIO_ACTIVE_LOW>;
-	wake-gpios = <&tlmm 148 GPIO_ACTIVE_LOW>;
-
 	pinctrl-0 = <&pcie4_default>;
 	pinctrl-names = "default";
 
@@ -1221,6 +1217,9 @@ &pcie4_phy {
 };
 
 &pcie4_port0 {
+	reset-gpios = <&tlmm 146 GPIO_ACTIVE_LOW>;
+	wake-gpios = <&tlmm 148 GPIO_ACTIVE_LOW>;
+
 	wifi@0 {
 		compatible = "pci17cb,1103";
 		reg = <0x10000 0x0 0x0 0x0 0x0>;
@@ -1240,9 +1239,6 @@ wifi@0 {
 };
 
 &pcie6a {
-	perst-gpios = <&tlmm 152 GPIO_ACTIVE_LOW>;
-	wake-gpios = <&tlmm 154 GPIO_ACTIVE_LOW>;
-
 	vddpe-3v3-supply = <&vreg_nvme>;
 
 	pinctrl-0 = <&pcie6a_default>;
@@ -1258,6 +1254,11 @@ &pcie6a_phy {
 	status = "okay";
 };
 
+&pcie6a_port0 {
+	reset-gpios = <&tlmm 152 GPIO_ACTIVE_LOW>;
+	wake-gpios = <&tlmm 154 GPIO_ACTIVE_LOW>;
+};
+
 &pm8550_gpios {
 	rtmr0_default: rtmr0-reset-n-active-state {
 		pins = "gpio10";
@@ -1662,14 +1663,11 @@ &usb_1_ss0_qmpphy {
 };
 
 &usb_1_ss0 {
+	dr_mode = "host";
+
 	status = "okay";
 };
 
-/*
-&usb_1_ss0_dwc3 {
-	dr_mode = "host";
-};
-*/
 &usb_1_ss0_dwc3_hs {
 	remote-endpoint = <&pmic_glink_ss0_hs_in>;
 };
@@ -1695,13 +1693,10 @@ &usb_1_ss1_qmpphy {
 };
 
 &usb_1_ss1 {
-	status = "okay";
-};
-/*
-&usb_1_ss1_dwc3 {
 	dr_mode = "host";
+
+	status = "okay";
 };
-*/
 
 &usb_1_ss1_dwc3_hs {
 	remote-endpoint = <&pmic_glink_ss1_hs_in>;
@@ -1741,14 +1736,11 @@ usb_1_ss2_qmpphy_out_dp: endpoint@0 {
 
 /* Camera */
 &usb_2 {
+	dr_mode = "host";
+
 	status = "okay";
 };
 
-/*
-&usb_2_dwc3 {
-	dr_mode = "host";
-};
-*/
 &usb_2_hsphy {
 	vdd-supply = <&vreg_l2e_0p8>;
 	vdda12-supply = <&vreg_l3e_1p2>;
diff --git a/arch/arm64/boot/dts/qcom/x126100.dtsi b/arch/arm64/boot/dts/qcom/x126100.dtsi
deleted file mode 100644
index de5dc8a..0000000
--- a/arch/arm64/boot/dts/qcom/x126100.dtsi
+++ /dev/null
@@ -1,24 +0,0 @@
-// SPDX-License-Identifier: BSD-3-Clause
-/*
- * Copyright (c) 2025 Qualcomm Innovation Center, Inc. All rights reserved.
- * Copyright (c) 2025, Kellerman Rivero <krsloco@gmail.com>
- */
-
-/* X126100 is a variant of X1P42100 with minor differences */
-#include "purwa.dtsi"
-
-&gcc {
-	compatible = "qcom,x126100-gcc", "qcom,x1p42100-gcc", "qcom,x1e80100-gcc";
-};
-
-&gpucc {
-	compatible = "qcom,x126100-gpucc", "qcom,x1p42100-gpucc";
-};
-
-&pcie6a_phy {
-	compatible = "qcom,x126100-qmp-gen4x4-pcie-phy", "qcom,x1p42100-qmp-gen4x4-pcie-phy";
-};
-
-&pcie3_phy {
-	compatible = "qcom,x126100-qmp-gen4x4-pcie-phy", "qcom,x1p42100-qmp-gen4x4-pcie-phy";
-};
