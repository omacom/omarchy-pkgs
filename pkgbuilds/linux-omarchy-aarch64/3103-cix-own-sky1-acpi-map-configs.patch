From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Clay Stan <claystan97@gmail.com>
Date: Tue, 24 Nov 2026 12:03:00 +0800
Subject: [PATCH] pinctrl: cix: own Sky1 ACPI map configurations

Check both mapping allocations and reject a missing pin name. Keep
configuration arrays owned by their maps so a consumer unbind or a map
registration failure can release them independently of the controller.

Signed-off-by: Clay Stan <claystan97@gmail.com>
---
diff --git a/drivers/pinctrl/cix/pinctrl-sky1-base.c b/drivers/pinctrl/cix/pinctrl-sky1-base.c
--- a/drivers/pinctrl/cix/pinctrl-sky1-base.c
+++ b/drivers/pinctrl/cix/pinctrl-sky1-base.c
@@ -22,6 +22,7 @@
 #include "../core.h"
 #include "../pinconf.h"
 #include "../pinmux.h"
+#include "../pinctrl-utils.h"
 #include "pinctrl-sky1.h"
 #include "../pinctrl-acpi.h"
 
@@ -159,7 +160,9 @@
 	unsigned int function_selector;
 	int ret = 0;
 
-	new_map = kzalloc(sizeof(struct pinctrl_map), GFP_KERNEL);
+	new_map = kzalloc_obj(*new_map);
+	if (!new_map)
+		return -ENOMEM;
 
 	switch (info->type) {
 	case PINCTRL_ACPI_PIN_FUNCTION:
@@ -186,12 +189,18 @@
 	case PINCTRL_ACPI_PIN_CONFIG:
 		map_config = &new_map->data.configs;
 		new_map->type = PIN_MAP_TYPE_CONFIGS_PIN;
-		map_config->group_or_pin = pin_get_name(pctldev,
-							info->config.pin);
-		map_config->configs = devm_kcalloc(pctldev->dev,
-						   info->config.nconfigs,
-						   sizeof(unsigned long),
-						   GFP_KERNEL);
+		map_config->group_or_pin = pin_get_name(pctldev, info->config.pin);
+		if (!map_config->group_or_pin) {
+			ret = -EINVAL;
+			goto out_free;
+		}
+		map_config->configs = kcalloc(info->config.nconfigs,
+					      sizeof(*map_config->configs),
+					      GFP_KERNEL);
+		if (!map_config->configs) {
+			ret = -ENOMEM;
+			goto out_free;
+		}
 		map_config->num_configs = 0;
 		list_for_each_entry(config_node, info->config.configs, node)
 			map_config->configs[map_config->num_configs++] =
@@ -227,8 +236,7 @@
 
 	return ret;
 out_free:
-	if(new_map)
-		kfree(new_map);
+	pinctrl_utils_free_map(pctldev, new_map, num_maps);
 	return ret;
 }
 
@@ -243,7 +251,7 @@
 			       struct pinctrl_map *map,
 			       unsigned int num_maps)
 {
-	kfree(map);
+	pinctrl_utils_free_map(pctldev, map, num_maps);
 }
 
 static const struct pinctrl_ops sky1_pctrl_ops = {
