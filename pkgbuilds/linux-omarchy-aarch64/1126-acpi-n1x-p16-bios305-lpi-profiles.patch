Subject: [PATCH] ACPI: processor_idle: accept validated P16 BIOS305 LPI profiles

BIOS305 returns the unchanged enabled cluster and package descriptors instead
of masking their flags. Its system _LPI also uses an enabled paired U32_MAX
residency/latency sentinel while MPEL is unset. Accept only complete known
levels with uniform valid flags and the exact system sentinel pair. Retain
all tuple, GAS, topology and PSCI checks and the suspend-only entry guards.

Keep firmware timing values, including sentinels, unchanged. This preserves
finite system latency constraints and never writes MPEL, ELST or SYSRAM.

---
diff --git a/drivers/acpi/processor_idle.c b/drivers/acpi/processor_idle.c
--- a/drivers/acpi/processor_idle.c
+++ b/drivers/acpi/processor_idle.c
@@ -2022,8 +2022,11 @@
 	static const struct n1x_lpi_tuple system[] = {
 		{ "Standby-DRIPS", 0x020100f0, 1437, 6610, 0 },
 	};
+	static const struct n1x_lpi_tuple system_gated[] = {
+		{ "Standby-DRIPS", 0x020100f0, U32_MAX, U32_MAX, 0 },
+	};
 	const struct n1x_lpi_tuple *tuples = NULL;
-	unsigned int count = 0, i;
+	unsigned int count = 0, i, flags;
 	struct acpi_buffer path = { ACPI_ALLOCATE_BUFFER, NULL };
 	bool matched = false;
 
@@ -2044,9 +2047,18 @@
 	}
 	if (!tuples || array->size != count)
 		goto out;
+	/* BIOS303 masks parent flags; BIOS305 keeps the enabled descriptors. */
+	flags = array->entries[0].flags;
+	if (flags != 0 && flags != ACPI_LPI_STATE_FLAGS_ENABLED)
+		goto out;
+	/* Only SYSM advertises this exact enabled, paired timing sentinel. */
+	if (tuples == system && flags == ACPI_LPI_STATE_FLAGS_ENABLED &&
+	    array->entries[0].min_residency == U32_MAX &&
+	    array->entries[0].wake_latency == U32_MAX)
+		tuples = system_gated;
 	for (i = 0; i < count; i++)
 		if (array->entries[i].level_id != (level == 2 ? 0x2000 : 0x1000) ||
-		    !n1x_lpi_tuple_matches(&array->entries[i], &tuples[i], i + 1, 0))
+		    !n1x_lpi_tuple_matches(&array->entries[i], &tuples[i], i + 1, flags))
 			goto out;
 	for (i = 0; i < count; i++)
 		array->entries[i].flags |= ACPI_LPI_STATE_FLAGS_ENABLED;
