From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Sat, 7 Nov 2026 17:14:00 +0100
Subject: [PATCH] arm64: dts: qcom: Add the Microsoft Surface Laptop 8 15-inch

Add a device tree for the Surface Laptop 8 with the 15-inch display,
from an owner's hardware report (turbineBMW/omarchy-hardware-reports#19:
"Surface Laptop 15in 8th Ed Snapdragon", SKU 2037, X2E-78-100, LG
LP150UD2-SPA2 panel).

Its DSDT and Surface SSDT are the 13.8-inch model's, apart from firmware
version changes. They switch on a board ID, which is 3 on this laptop,
by the GPU's _SUB (CDPS28480) and Windows' panel configuration
(qcdxkmext8480_ROT_CDPS2), against 5, 8, 9 and 12 for the 13.8-inch
model. The board ID changes three things, so the tree includes the
13.8-inch tree and replaces them:

- The touchscreen is MSHW0774 at 0x34 on i2c8 (\_SB.I2C9) at 400 kHz,
  with HID descriptor register 0, interrupt TLMM 51 level low with a
  pull-up, and TLMM 31 driven high in _PS0 and low in _PS3. It replaces
  the 13.8-inch model's MSHW0776 at 0x41 (TLMM 43, reset TLMM 48, power
  TLMM 38), and Windows lists only MSHW0774 on this laptop.
- The touchscreen's power resource, TDPR, drives TLMM 49 and waits
  150 ms. The panel (GPU0.MON0) depends on it as well, so it is a fixed
  regulator that stays on.
- Windows loads another panel configuration. It differs from the
  13.8-inch one in a power timing only, with the same PMIC PWM
  backlight, so the panel stays the 13.8-inch tree's edp-panel, which
  reads the panel's EDID. linux's panel-edp has no entry for LGD 0x07cc
  and uses its conservative timings.

The touchpad (MSHW0756 on i2c10), the speakers, microphones, USB, PCIe,
Surface Aggregator Module and DSP firmware are the 13.8-inch model's:
the ADSP images Windows runs on this laptop are byte-identical to those
microsoft-surface-laptop-8-firmware installs. The drive strengths of
TLMM 31, 49 and 51 follow the 13.8-inch tree's touchscreen pins, since
ACPI does not give them.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 arch/arm64/boot/dts/qcom/Makefile             |  1 +
 .../glymur-microsoft-surface-laptop8-15.dts   | 90 +++++++++++++++++++
 2 files changed, 91 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/glymur-microsoft-surface-laptop8-15.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 1316b3c..cd81037 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -24,6 +24,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= glymur-hp-elitebook-x-g2q.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= glymur-hp-omnibook-ultra-kg0xxx.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= glymur-lenovo-yoga-slim7x.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= glymur-microsoft-surface-laptop8.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= glymur-microsoft-surface-laptop8-15.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= hamoa-iot-evk.dtb
 
 hamoa-iot-evk-el2-dtbs	:= hamoa-iot-evk.dtb x1-el2.dtbo
diff --git a/arch/arm64/boot/dts/qcom/glymur-microsoft-surface-laptop8-15.dts b/arch/arm64/boot/dts/qcom/glymur-microsoft-surface-laptop8-15.dts
new file mode 100644
index 0000000..7e05c71
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/glymur-microsoft-surface-laptop8-15.dts
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Microsoft Surface Laptop 8, 15-inch model with the 12-core Snapdragon X2
+ * Elite (Mahua).
+ *
+ * The laptop's ACPI tables are the 13.8-inch model's, with board ID 3 where
+ * the 13.8-inch reads 5, 8, 9 or 12. The board ID changes the touchscreen,
+ * the panel configuration Windows loads and a power switch the touchscreen
+ * shares with the panel, so this tree is the 13.8-inch one with those parts
+ * replaced.
+ */
+
+#include "glymur-microsoft-surface-laptop8.dts"
+
+/ {
+	compatible = "microsoft,surface-laptop-8-15", "qcom,mahua";
+	model = "Microsoft Surface Laptop 8 (15in, Snapdragon X2 Elite)";
+
+	/*
+	 * ACPI power resource TDPR: TLMM 49, then 150 ms. Both the touchscreen
+	 * (MSHW0774) and the panel (GPU0.MON0) depend on it, so it stays on.
+	 */
+	vreg_touch_display: regulator-touch-display {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VREG_TOUCH_DISPLAY";
+
+		gpio = <&tlmm 49 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <150000>;
+
+		pinctrl-0 = <&touch_display_pwr_en>;
+		pinctrl-names = "default";
+
+		regulator-always-on;
+		regulator-boot-on;
+	};
+};
+
+/* The 13.8-inch model's touchscreen, MSHW0776, and its power switch. */
+/delete-node/ &vreg_ts;
+/delete-node/ &ts_default;
+/delete-node/ &ts_pwr_en;
+/delete-node/ &ts_reset_n;
+
+&i2c8 {
+	/delete-node/ touchscreen@41;
+
+	/*
+	 * ACPI MSHW0774, "Surface Touch Screen Device": 0x34 at 400 kHz, HID
+	 * descriptor register 0 (its _DSM function 1 returns 0), interrupt
+	 * TLMM 51 level low with a pull-up. _PS0 drives TLMM 31 high and _PS3
+	 * drives it low, then waits 5 ms.
+	 */
+	touchscreen@34 {
+		compatible = "hid-over-i2c";
+		reg = <0x34>;
+		hid-descr-addr = <0x0>;
+		interrupts-extended = <&tlmm 51 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&tlmm 31 GPIO_ACTIVE_LOW>;
+
+		vdd-supply = <&vreg_touch_display>;
+
+		pinctrl-0 = <&ts_int_n>, <&ts_reset_n_15>;
+		pinctrl-names = "default";
+	};
+};
+
+&tlmm {
+	touch_display_pwr_en: touch-display-pwr-en-state {
+		pins = "gpio49";
+		function = "gpio";
+		drive-strength = <4>;
+		bias-disable;
+	};
+
+	ts_int_n: ts-int-n-state {
+		pins = "gpio51";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	ts_reset_n_15: ts-reset-n-15-state {
+		pins = "gpio31";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+	};
+};
-- 
2.47.3

