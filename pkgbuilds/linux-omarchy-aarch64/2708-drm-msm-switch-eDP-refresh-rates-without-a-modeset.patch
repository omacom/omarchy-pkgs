diff -ruN a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -773,6 +773,70 @@
 	return false;
 }
 
+static bool dpu_edp_seamless_vtotal = true;
+module_param_named(edp_seamless_vtotal, dpu_edp_seamless_vtotal, bool, 0644);
+MODULE_PARM_DESC(edp_seamless_vtotal,
+		 "switch eDP modes that differ only in vertical blanking without a modeset (default true)");
+
+static struct msm_dp *dpu_encoder_get_dp(struct dpu_encoder_virt *dpu_enc)
+{
+	struct msm_drm_private *priv = dpu_enc->base.dev->dev_private;
+
+	if (dpu_enc->disp_info.intf_type != INTF_DP)
+		return NULL;
+
+	return priv->kms->dp[dpu_enc->disp_info.h_tile_instance[0]];
+}
+
+/**
+ * dpu_encoder_can_update_vtiming - check if the running encoder can take a
+ *	mode that differs only in vertical blanking without a modeset
+ * @drm_enc: Pointer to drm encoder structure
+ *
+ * Only a single video mode interface feeding an eDP sink that ignores the
+ * MSA timing parameters qualifies.
+ */
+bool dpu_encoder_can_update_vtiming(struct drm_encoder *drm_enc)
+{
+	struct dpu_encoder_virt *dpu_enc = to_dpu_encoder_virt(drm_enc);
+	struct dpu_encoder_phys *phys;
+
+	if (!dpu_edp_seamless_vtotal)
+		return false;
+
+	if (dpu_enc->num_phys_encs != 1 || dpu_enc->dsc ||
+	    dpu_enc->disp_info.is_cmd_mode)
+		return false;
+
+	phys = dpu_enc->phys_encs[0];
+	if (!phys || !phys->ops.update_vtiming || !phys->hw_intf || !phys->hw_ctl ||
+	    phys->hw_cdm || phys->split_role != ENC_ROLE_SOLO ||
+	    phys->enable_state != DPU_ENC_ENABLED)
+		return false;
+
+	return msm_dp_vtotal_update_supported(dpu_encoder_get_dp(dpu_enc));
+}
+
+/**
+ * dpu_encoder_update_vtiming - apply a mode that differs only in vertical
+ *	blanking to the running encoder
+ * @drm_enc: Pointer to drm encoder structure
+ * @mode: the new adjusted mode
+ *
+ * The INTF flush that applies the new timing goes out with the next kickoff.
+ */
+void dpu_encoder_update_vtiming(struct drm_encoder *drm_enc,
+				const struct drm_display_mode *mode)
+{
+	struct dpu_encoder_virt *dpu_enc = to_dpu_encoder_virt(drm_enc);
+	struct dpu_encoder_phys *phys = dpu_enc->phys_encs[0];
+	struct msm_dp *dp = dpu_encoder_get_dp(dpu_enc);
+
+	phys->ops.update_vtiming(phys, mode);
+	if (dp)
+		msm_dp_update_vtotal(dp, mode);
+}
+
 static void _dpu_encoder_update_vsync_source(struct dpu_encoder_virt *dpu_enc,
 			struct msm_display_info *disp_info)
 {
