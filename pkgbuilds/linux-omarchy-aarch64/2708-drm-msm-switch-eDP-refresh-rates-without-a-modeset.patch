diff -ruN a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
@@ -766,6 +766,88 @@
 	return s.frame_count;
 }
 
+/*
+ * Wait until the running timing engine is in the active region and at least
+ * a few lines away from its end, so the new timing written next is complete
+ * well before the frame boundary at which the flushed registers latch. The
+ * same rule as the downstream SDE driver's porch-based dynamic refresh.
+ */
+static void dpu_encoder_phys_vid_wait_for_active(struct dpu_encoder_phys *phys_enc,
+						 int *line, unsigned int *polls)
+{
+	const struct drm_display_mode *mode = &phys_enc->cached_mode;
+	struct dpu_hw_intf *intf = phys_enc->hw_intf;
+	struct dpu_hw_intf_timing_params t;
+	u32 v_inactive, v_end, frame_us, poll_us, i, max_polls;
+
+	*line = -1;
+	*polls = 0;
+
+	if (!intf->ops.get_line_count || !mode->clock || !mode->htotal || !mode->vtotal)
+		return;
+
+	/* the interface counts lines from the start of vsync */
+	drm_mode_to_intf_timing_params(phys_enc, mode, &t);
+	v_inactive = t.vsync_pulse_width + t.v_back_porch;
+	v_end = v_inactive + t.height;
+	if (v_end > v_inactive + 16)
+		v_end -= 16;
+
+	frame_us = div_u64((u64)mode->htotal * mode->vtotal * 1000, mode->clock);
+	poll_us = clamp_t(u32, frame_us / 64, 100, 1000);
+	max_polls = 2 * frame_us / poll_us + 1;
+
+	for (i = 0; i < max_polls; i++) {
+		*line = intf->ops.get_line_count(intf);
+		*polls = i;
+		if (*line >= v_inactive && *line < v_end)
+			return;
+		usleep_range(poll_us, poll_us + 50);
+	}
+}
+
+/*
+ * dpu_encoder_phys_vid_update_vtiming - reprogram the running timing engine
+ *	for a mode that differs from the current one only in vertical
+ *	blanking. The new timing is applied by the INTF flush of the next
+ *	kickoff, at a frame boundary; the timing engine keeps running.
+ */
+static void dpu_encoder_phys_vid_update_vtiming(struct dpu_encoder_phys *phys_enc,
+						const struct drm_display_mode *mode)
+{
+	struct dpu_hw_intf_timing_params timing_params = { 0 };
+	struct dpu_hw_ctl *ctl = phys_enc->hw_ctl;
+	const struct msm_format *fmt;
+	unsigned long lock_flags;
+	int old_vtotal = phys_enc->cached_mode.vtotal;
+	unsigned int polls;
+	int line;
+
+	if (!phys_enc->hw_intf->ops.setup_timing_gen ||
+	    !ctl->ops.update_pending_flush_intf)
+		return;
+
+	dpu_encoder_phys_vid_wait_for_active(phys_enc, &line, &polls);
+
+	phys_enc->cached_mode = *mode;
+	drm_mode_to_intf_timing_params(phys_enc, &phys_enc->cached_mode, &timing_params);
+
+	fmt = mdp_get_format(&phys_enc->dpu_kms->base,
+			     dpu_encoder_get_drm_fmt(phys_enc), 0);
+
+	spin_lock_irqsave(phys_enc->enc_spinlock, lock_flags);
+	phys_enc->hw_intf->ops.setup_timing_gen(phys_enc->hw_intf,
+						&timing_params, fmt);
+	spin_unlock_irqrestore(phys_enc->enc_spinlock, lock_flags);
+
+	programmable_fetch_config(phys_enc, &timing_params);
+
+	ctl->ops.update_pending_flush_intf(ctl, phys_enc->hw_intf->idx);
+
+	DPU_DEBUG_VIDENC(phys_enc, "vtotal %d -> %d at line %d after %u polls\n",
+			 old_vtotal, mode->vtotal, line, polls);
+}
+
 static void dpu_encoder_phys_vid_init_ops(struct dpu_encoder_phys_ops *ops)
 {
 	ops->is_master = dpu_encoder_phys_vid_is_master;
@@ -782,6 +864,7 @@
 	ops->needs_single_flush = dpu_encoder_phys_vid_needs_single_flush;
 	ops->get_line_count = dpu_encoder_phys_vid_get_line_count;
 	ops->get_frame_count = dpu_encoder_phys_vid_get_frame_count;
+	ops->update_vtiming = dpu_encoder_phys_vid_update_vtiming;
 }
 
