From: "Caleb E." <158400752+FoxesRCool1@users.noreply.github.com>
Date: Mon, 23 Nov 2026 15:10:00 +0800
Subject: [PATCH] drm/msm: switch eDP refresh rates without a modeset

Some eDP panels list two modes that differ only in vertical blanking. The
Surface Laptop 7 13.8" (X1E80100, Sharp LQ138P1JX61) has 2304x1536 at 120 Hz
(vtotal 1579) and at 60 Hz (vtotal 3158), with the same 466.88 MHz pixel clock
and horizontal timing. The panel sets MSA_TIMING_PAR_IGNORED. Every switch
between the two modes used to be a full modeset: the DP bridge chain was torn
down, the link retrained and the backlight cycled, so the panel went black
each time the desktop dropped to 60 Hz on battery.

Treat such a change as a timing update instead:

- dp: set MSA_TIMING_PAR_IGNORE_EN (DPCD 0x107 bit 7) at link training on eDP
  sinks that report MSA_TIMING_PAR_IGNORED, and remember it.
- dp: add msm_dp_vtotal_update_supported() and msm_dp_update_vtotal(), which
  keep the stored mode and the MSA timing in step without touching the link.
- dpu: in the CRTC atomic_check, when a lit CRTC driving one video-mode INTF to
  such a sink gets a mode that differs only in vertical blanking, clear
  mode_changed and flag a vertical timing update. The CRTC flush waits until
  the interface is in its active region, rewrites the INTF timing engine and
  sets the INTF flush bit, so the new vertical total latches at the next frame
  boundary while the timing engine keeps running.

msm.edp_seamless_vtotal=0 restores the old full modeset. msm.edp_msa_ignore=0
leaves DPCD 0x107 bit 7 clear.

Tested on the Surface Laptop 7 13.8": DPCD 0x107 reads 0x90 after training
(0x10 before), switches between 120 and 60 Hz in both directions show no blank
or glitch, with no underrun or vblank timeout.

---
diff -ruN a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
@@ -1007,6 +1007,15 @@
 		dpu_plane_flush(plane);
 	}
 
+	/* a vertical blanking change: retime the running interface */
+	if (cstate->vtiming_update) {
+		struct drm_encoder *encoder;
+
+		drm_for_each_encoder_mask(encoder, crtc->dev,
+					  crtc->state->encoder_mask)
+			dpu_encoder_update_vtiming(encoder, &crtc->state->adjusted_mode);
+	}
+
 	/* Kickoff will be scheduled by outer layer */
 }
 
@@ -1182,6 +1191,8 @@
 	/* duplicate base helper */
 	__drm_atomic_helper_crtc_duplicate_state(crtc, &cstate->base);
 
+	cstate->vtiming_update = false;
+
 	return &cstate->base;
 }
 
@@ -1575,6 +1586,62 @@
 	return 0;
 }
 
+/*
+ * Two modes that differ only in vertical blanking: same pixel clock, same
+ * horizontal timing, same active height and vsync width.
+ */
+static bool dpu_crtc_modes_differ_in_vblank_only(const struct drm_display_mode *a,
+						 const struct drm_display_mode *b)
+{
+	return a->clock == b->clock &&
+	       a->hdisplay == b->hdisplay &&
+	       a->hsync_start == b->hsync_start &&
+	       a->hsync_end == b->hsync_end &&
+	       a->htotal == b->htotal &&
+	       a->hskew == b->hskew &&
+	       a->vdisplay == b->vdisplay &&
+	       a->vsync_end - a->vsync_start == b->vsync_end - b->vsync_start &&
+	       a->vscan == b->vscan &&
+	       a->flags == b->flags &&
+	       a->vtotal != b->vtotal;
+}
+
+/*
+ * A mode change that only stretches or shrinks the vertical blanking of a
+ * lit eDP panel that ignores the MSA timing does not need a modeset: the
+ * pixel clock, the link and the horizontal timing stay, and the interface
+ * timing engine takes the new vertical total at a frame boundary. The DRM
+ * helpers flag every mode change as a modeset, so undo that here, before
+ * resources are reassigned. Same idea as amdgpu's FreeSync video modes.
+ */
+static bool dpu_crtc_vtiming_only_change(struct drm_crtc *crtc,
+					 struct drm_atomic_commit *state,
+					 struct drm_crtc_state *new_state)
+{
+	struct drm_crtc_state *old_state = drm_atomic_get_old_crtc_state(state, crtc);
+	struct drm_encoder *drm_enc;
+
+	if (!old_state || !new_state->mode_changed ||
+	    new_state->active_changed || new_state->connectors_changed ||
+	    !old_state->enable || !old_state->active ||
+	    !new_state->enable || !new_state->active ||
+	    old_state->self_refresh_active || new_state->self_refresh_active ||
+	    old_state->encoder_mask != new_state->encoder_mask ||
+	    hweight32(new_state->encoder_mask) != 1 ||
+	    drm_crtc_in_clone_mode(new_state))
+		return false;
+
+	if (!dpu_crtc_modes_differ_in_vblank_only(&old_state->adjusted_mode,
+						  &new_state->adjusted_mode))
+		return false;
+
+	drm_for_each_encoder_mask(drm_enc, crtc->dev, new_state->encoder_mask)
+		if (!dpu_encoder_can_update_vtiming(drm_enc))
+			return false;
+
+	return true;
+}
+
 static int dpu_crtc_atomic_check(struct drm_crtc *crtc,
 		struct drm_atomic_commit *state)
 {
@@ -1590,6 +1657,15 @@
 
 	bool needs_dirtyfb = dpu_crtc_needs_dirtyfb(crtc_state);
 
+	if (dpu_crtc_vtiming_only_change(crtc, state, crtc_state)) {
+		DRM_DEBUG_ATOMIC("crtc%d: vtotal %d -> %d without a modeset\n",
+				 crtc->base.id,
+				 drm_atomic_get_old_crtc_state(state, crtc)->adjusted_mode.vtotal,
+				 crtc_state->adjusted_mode.vtotal);
+		crtc_state->mode_changed = false;
+		cstate->vtiming_update = true;
+	}
+
 	/* don't reallocate resources if only ACTIVE has beeen changed */
 	if (crtc_state->mode_changed || crtc_state->connectors_changed ||
 	    crtc_state->color_mgmt_changed) {
diff -ruN a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
@@ -232,6 +232,9 @@
 
 	enum dpu_crtc_crc_source crc_source;
 	int crc_frame_skip_count;
+
+	/* the mode changed only in vertical blanking, applied without a modeset */
+	bool vtiming_update;
 };
 
