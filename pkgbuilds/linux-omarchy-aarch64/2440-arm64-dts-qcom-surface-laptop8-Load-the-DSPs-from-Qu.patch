From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Thu, 5 Nov 2026 19:03:56 +0000
Subject: [PATCH] arm64: dts: qcom: surface-laptop8: Load the DSPs from
 Qualcomm's firmware folder

Qualcomm's posted device tree for this laptop names
qcom/glymur/microsoft/mahua/ for the ADSP and CDSP images. Use the same
folder, so the firmware is found where Omarchy's
microsoft-surface-laptop-8-firmware installs it and where linux-firmware
will put it. The SoCCP images keep their names, since the board's own
firmware starts the SoCCP before Linux.

Link: https://lore.kernel.org/r/20261027-mahua-surface-laptop-v2-0-7dd903a12d22@oss.qualcomm.com
Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 .../boot/dts/qcom/glymur-microsoft-surface-laptop8.dts    | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/glymur-microsoft-surface-laptop8.dts b/arch/arm64/boot/dts/qcom/glymur-microsoft-surface-laptop8.dts
index 1150fc3..331b61d 100644
--- a/arch/arm64/boot/dts/qcom/glymur-microsoft-surface-laptop8.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-microsoft-surface-laptop8.dts
@@ -772,15 +772,15 @@ &pmk8850_rtc {
 };
 
 &remoteproc_adsp {
-	firmware-name = "qcom/glymur/microsoft/surface-laptop8/qcadsp8480.mbn",
-			"qcom/glymur/microsoft/surface-laptop8/adsp_dtbs.elf";
+	firmware-name = "qcom/glymur/microsoft/mahua/qcadsp8480.mbn",
+			"qcom/glymur/microsoft/mahua/adsp_dtbs.elf";
 
 	status = "okay";
 };
 
 &remoteproc_cdsp {
-	firmware-name = "qcom/glymur/microsoft/surface-laptop8/qccdsp8480.mbn",
-			"qcom/glymur/microsoft/surface-laptop8/cdsp_dtbs.elf";
+	firmware-name = "qcom/glymur/microsoft/mahua/qccdsp8480.mbn",
+			"qcom/glymur/microsoft/mahua/cdsp_dtbs.elf";
 
 	status = "okay";
 };
-- 
