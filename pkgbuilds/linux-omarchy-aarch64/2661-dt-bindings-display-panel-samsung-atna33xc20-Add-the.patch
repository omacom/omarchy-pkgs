From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Thu, 5 Nov 2026 08:52:50 +0000
Subject: [PATCH] dt-bindings: display: panel: samsung,atna33xc20: Add the
 ATNA60KJ01

The ATNA60KJ01 is the 16.0 inch 1920x1200 AMOLED panel of the ASUS
Vivobook S16 (S3607QA). Document it with the samsung,atna33xc20
fallback, like the other ATNA panels.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 .../devicetree/bindings/display/panel/samsung,atna33xc20.yaml   | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Documentation/devicetree/bindings/display/panel/samsung,atna33xc20.yaml b/Documentation/devicetree/bindings/display/panel/samsung,atna33xc20.yaml
index 27536ee..82c30c5 100644
--- a/Documentation/devicetree/bindings/display/panel/samsung,atna33xc20.yaml
+++ b/Documentation/devicetree/bindings/display/panel/samsung,atna33xc20.yaml
@@ -37,6 +37,8 @@ properties:
               - samsung,atna56ac03
               # Samsung 16.0" 3K (2880x1800 pixels) eDP AMOLED panel
               - samsung,atna60cl08
+              # Samsung 16.0" FHD+ (1920x1200 pixels) eDP AMOLED panel
+              - samsung,atna60kj01
           - const: samsung,atna33xc20
 
   enable-gpios: true
-- 
2.56.0

