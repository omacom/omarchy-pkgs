diff --git a/drivers/platform/arm64/asus-proart-pz13-ec.c b/drivers/platform/arm64/asus-proart-pz13-ec.c
new file mode 100644
index 0000000..64bd075
--- /dev/null
+++ b/drivers/platform/arm64/asus-proart-pz13-ec.c
@@ -0,0 +1,482 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ASUS ProArt PZ13 embedded controller
+ *
+ * The EC sits on I2C and is reached through a two-step register protocol:
+ * a block write at command 0x10 selects {page, register}, a byte read or
+ * write at command 0x11 moves the data. The fan page (0xc6) holds the EC's
+ * own sensors (0x0a, 0x0b), the fan control/status byte (0x10) and the fan
+ * tachometer (0x18/0x19). The command page (0xc4) carries a small command
+ * interface: argument registers 0x31/0x32 and a command register 0x30 that
+ * the EC clears when it has consumed the command.
+ *
+ * The EC runs its fan curve on a SoC temperature the OS has to feed it:
+ * command 4 writes a byte into the EC's RAM, the ASUS platform software
+ * writes the temperature to RAM offset 0x83 (high byte 0x82) and then sets
+ * bit 0 of fan-page register 0x84. Without that the fan never starts. This
+ * driver does the same: once a second it reads the thermal zones listed in
+ * the device tree and reports the hottest one to the EC, which runs the fan
+ * at a speed following that temperature (as on the original OS, the fan
+ * does not stop while the system is running). The EC's curve is tame (about
+ * 4500 rpm at 90 degrees, the fan does 9500), and the SoC's thermal zones
+ * carry no passive trip, so above a threshold the driver sets the EC's
+ * full-speed bit (the "CPU fan control" switch of the ASUS WMI interface)
+ * and clears it again with hysteresis. The fan speed, the EC's two sensors
+ * and the reported temperature are exposed via hwmon.
+ *
+ * Copyright (c) 2026 Alex Grucza
+ */
+
+#include <linux/bits.h>
+#include <linux/devm-helpers.h>
+#include <linux/hwmon.h>
+#include <linux/i2c.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/pm.h>
+#include <linux/thermal.h>
+#include <linux/workqueue.h>
+
+#define PZ13_EC_CMD_ADDR	0x10	/* block write: page, register */
+#define PZ13_EC_CMD_DATA	0x11	/* byte read/write of the selected register */
+
+#define PZ13_EC_PAGE_CMD	0xc4
+#define PZ13_EC_CMD_REG		0x30	/* command; 0 when the EC has taken it */
+#define PZ13_EC_CMD_ARG1	0x31
+#define PZ13_EC_CMD_ARG2	0x32
+#define PZ13_EC_CMD_SELECT	0x01	/* firmware sends it before a temperature push */
+#define PZ13_EC_CMD_WRITE_RAM	0x04	/* arg1: RAM offset, arg2: value */
+#define PZ13_EC_SELECT_TEMP	0x8c
+#define PZ13_EC_RAM_TEMP_LO	0x83	/* SoC temperature, degrees Celsius */
+#define PZ13_EC_RAM_TEMP_HI	0x82
+
+#define PZ13_EC_PAGE_FAN	0xc6
+#define PZ13_EC_FAN_TEMP1	0x0a	/* EC sensor, degrees Celsius */
+#define PZ13_EC_FAN_TEMP2	0x0b
+#define PZ13_EC_FAN_CTRL	0x10	/* bit 7: fan running */
+#define PZ13_EC_FAN_CTRL_FULL	BIT(6)	/* full speed regardless of the curve */
+#define PZ13_EC_FAN_RPM_LSB	0x18
+#define PZ13_EC_FAN_RPM_MSB	0x19
+#define PZ13_EC_FAN_FLAGS	0x84
+#define PZ13_EC_FAN_FLAG_TEMP_VALID	BIT(0)
+
+#define PZ13_EC_CMD_TIMEOUT_US	50000
+#define PZ13_EC_POLL_MS		1000
+
+/*
+ * The EC runs the fan at a speed that follows the reported temperature and
+ * never stops it while a temperature is reported; 0 means "no reading" and
+ * stops the fan. The floor is reported while the zones cannot be read: a
+ * slowly running fan is the safer failure mode.
+ */
+#define PZ13_EC_NO_TEMP		0
+#define PZ13_EC_FLOOR_TEMP	25
+#define PZ13_EC_MAX_TEMP	127
+
+/* Full speed from this temperature on, back to the curve below the other */
+#define PZ13_EC_FULL_ON_TEMP	85
+#define PZ13_EC_FULL_OFF_TEMP	75
+
+struct pz13_ec_zone {
+	const char *name;
+	struct thermal_zone_device *tzd;
+};
+
+struct pz13_ec {
+	struct i2c_client *client;
+	struct mutex lock;	/* one select + data transfer at a time */
+	struct delayed_work work;
+	struct pz13_ec_zone *zones;
+	int num_zones;
+	int reported;		/* degrees Celsius last written to the EC */
+	bool full_speed;	/* the full-speed bit is set */
+};
+
+static int pz13_ec_select(struct pz13_ec *ec, u8 page, u8 reg)
+{
+	u8 addr[2] = { page, reg };
+
+	return i2c_smbus_write_i2c_block_data(ec->client, PZ13_EC_CMD_ADDR,
+					      sizeof(addr), addr);
+}
+
+static int pz13_ec_read(struct pz13_ec *ec, u8 page, u8 reg, u8 *val)
+{
+	int ret;
+
+	guard(mutex)(&ec->lock);
+
+	ret = pz13_ec_select(ec, page, reg);
+	if (ret)
+		return ret;
+
+	ret = i2c_smbus_read_byte_data(ec->client, PZ13_EC_CMD_DATA);
+	if (ret < 0)
+		return ret;
+
+	*val = ret;
+	return 0;
+}
+
+static int pz13_ec_write(struct pz13_ec *ec, u8 page, u8 reg, u8 val)
+{
+	int ret;
+
+	guard(mutex)(&ec->lock);
+
+	ret = pz13_ec_select(ec, page, reg);
+	if (ret)
+		return ret;
+
+	return i2c_smbus_write_byte_data(ec->client, PZ13_EC_CMD_DATA, val);
+}
+
+static int pz13_ec_cmd_busy(struct pz13_ec *ec)
+{
+	u8 val;
+	int ret;
+
+	ret = pz13_ec_read(ec, PZ13_EC_PAGE_CMD, PZ13_EC_CMD_REG, &val);
+	if (ret)
+		return ret;
+	return val;
+}
+
+static int pz13_ec_cmd_wait(struct pz13_ec *ec)
+{
+	int busy;
+
+	return read_poll_timeout(pz13_ec_cmd_busy, busy, busy <= 0, 1000,
+				 PZ13_EC_CMD_TIMEOUT_US, false, ec) ?: busy;
+}
+
+static int pz13_ec_command(struct pz13_ec *ec, u8 cmd, u8 arg1, u8 arg2)
+{
+	int ret;
+
+	ret = pz13_ec_cmd_wait(ec);
+	if (ret)
+		return ret;
+	ret = pz13_ec_write(ec, PZ13_EC_PAGE_CMD, PZ13_EC_CMD_ARG1, arg1);
+	if (ret)
+		return ret;
+	ret = pz13_ec_write(ec, PZ13_EC_PAGE_CMD, PZ13_EC_CMD_ARG2, arg2);
+	if (ret)
+		return ret;
+	ret = pz13_ec_write(ec, PZ13_EC_PAGE_CMD, PZ13_EC_CMD_REG, cmd);
+	if (ret)
+		return ret;
+	return pz13_ec_cmd_wait(ec);
+}
+
+/* Report a SoC temperature to the EC the way the ASUS platform software does */
+static int pz13_ec_report_temp(struct pz13_ec *ec, int temp)
+{
+	u8 flags;
+	int ret;
+
+	if (temp != PZ13_EC_NO_TEMP)
+		temp = clamp(temp, PZ13_EC_FLOOR_TEMP, PZ13_EC_MAX_TEMP);
+
+	ret = pz13_ec_command(ec, PZ13_EC_CMD_SELECT, PZ13_EC_SELECT_TEMP, 0);
+	if (ret)
+		return ret;
+	ret = pz13_ec_command(ec, PZ13_EC_CMD_WRITE_RAM, PZ13_EC_RAM_TEMP_LO, temp);
+	if (ret)
+		return ret;
+	ret = pz13_ec_command(ec, PZ13_EC_CMD_WRITE_RAM, PZ13_EC_RAM_TEMP_HI, 0);
+	if (ret)
+		return ret;
+
+	ret = pz13_ec_read(ec, PZ13_EC_PAGE_FAN, PZ13_EC_FAN_FLAGS, &flags);
+	if (ret)
+		return ret;
+	if (!(flags & PZ13_EC_FAN_FLAG_TEMP_VALID)) {
+		ret = pz13_ec_write(ec, PZ13_EC_PAGE_FAN, PZ13_EC_FAN_FLAGS,
+				    flags | PZ13_EC_FAN_FLAG_TEMP_VALID);
+		if (ret)
+			return ret;
+	}
+
+	ec->reported = temp;
+	return 0;
+}
+
+static int pz13_ec_set_full_speed(struct pz13_ec *ec, bool on)
+{
+	u8 ctrl, want;
+	int ret;
+
+	ret = pz13_ec_read(ec, PZ13_EC_PAGE_FAN, PZ13_EC_FAN_CTRL, &ctrl);
+	if (ret)
+		return ret;
+	want = on ? ctrl | PZ13_EC_FAN_CTRL_FULL : ctrl & ~PZ13_EC_FAN_CTRL_FULL;
+	if (want != ctrl) {
+		ret = pz13_ec_write(ec, PZ13_EC_PAGE_FAN, PZ13_EC_FAN_CTRL, want);
+		if (ret)
+			return ret;
+	}
+	ec->full_speed = on;
+	return 0;
+}
+
+/* The hottest of the zones, in degrees Celsius; the floor when none can be read */
+static int pz13_ec_soc_temp(struct pz13_ec *ec)
+{
+	int hottest = INT_MIN;
+	int i, temp, ret;
+
+	for (i = 0; i < ec->num_zones; i++) {
+		struct pz13_ec_zone *zone = &ec->zones[i];
+
+		if (!zone->tzd) {
+			/* Zones can register after this driver probed */
+			zone->tzd = thermal_zone_get_zone_by_name(zone->name);
+			if (IS_ERR(zone->tzd)) {
+				zone->tzd = NULL;
+				continue;
+			}
+		}
+
+		ret = thermal_zone_get_temp(zone->tzd, &temp);
+		if (ret)
+			continue;
+		hottest = max(hottest, temp);
+	}
+
+	if (hottest == INT_MIN)
+		return PZ13_EC_FLOOR_TEMP;
+	return DIV_ROUND_CLOSEST(hottest, 1000);
+}
+
+static void pz13_ec_poll(struct work_struct *work)
+{
+	struct pz13_ec *ec = container_of(work, struct pz13_ec, work.work);
+	int temp = pz13_ec_soc_temp(ec);
+
+	if (temp != ec->reported) {
+		int ret = pz13_ec_report_temp(ec, temp);
+
+		if (ret)
+			dev_warn_ratelimited(&ec->client->dev,
+					     "cannot report the temperature: %d\n", ret);
+	}
+
+	if (ec->full_speed ? temp < PZ13_EC_FULL_OFF_TEMP : temp >= PZ13_EC_FULL_ON_TEMP) {
+		int ret = pz13_ec_set_full_speed(ec, !ec->full_speed);
+
+		if (ret)
+			dev_warn_ratelimited(&ec->client->dev,
+					     "cannot switch full speed: %d\n", ret);
+	}
+
+	schedule_delayed_work(&ec->work, msecs_to_jiffies(PZ13_EC_POLL_MS));
+}
+
+static int pz13_ec_parse_zones(struct pz13_ec *ec)
+{
+	struct device *dev = &ec->client->dev;
+	int i, n;
+
+	n = of_count_phandle_with_args(dev->of_node, "asus,thermal-zones", NULL);
+	if (n <= 0)
+		return dev_err_probe(dev, n ?: -EINVAL, "no thermal zones listed\n");
+
+	ec->zones = devm_kcalloc(dev, n, sizeof(*ec->zones), GFP_KERNEL);
+	if (!ec->zones)
+		return -ENOMEM;
+
+	for (i = 0; i < n; i++) {
+		struct device_node *np __free(device_node) =
+			of_parse_phandle(dev->of_node, "asus,thermal-zones", i);
+
+		if (!np)
+			return -EINVAL;
+		/* A thermal zone is registered under its node name */
+		ec->zones[i].name = devm_kstrdup(dev, np->name, GFP_KERNEL);
+		if (!ec->zones[i].name)
+			return -ENOMEM;
+	}
+	ec->num_zones = n;
+	return 0;
+}
+
+/* hwmon: fan speed, the EC's own sensors and the reported temperature */
+
+static const char * const pz13_ec_temp_labels[] = {
+	"ec_temp1", "ec_temp2", "soc_reported",
+};
+static const u8 pz13_ec_temp_regs[] = { PZ13_EC_FAN_TEMP1, PZ13_EC_FAN_TEMP2 };
+
+static umode_t pz13_ec_hwmon_is_visible(const void *drvdata,
+					enum hwmon_sensor_types type,
+					u32 attr, int channel)
+{
+	switch (type) {
+	case hwmon_temp:
+	case hwmon_fan:
+		return 0444;
+	default:
+		return 0;
+	}
+}
+
+static int pz13_ec_hwmon_read(struct device *dev, enum hwmon_sensor_types type,
+			      u32 attr, int channel, long *val)
+{
+	struct pz13_ec *ec = dev_get_drvdata(dev);
+	u8 lsb, msb;
+	int ret;
+
+	switch (type) {
+	case hwmon_temp:
+		if (attr != hwmon_temp_input)
+			return -EOPNOTSUPP;
+		if (channel == ARRAY_SIZE(pz13_ec_temp_regs)) {
+			*val = ec->reported * 1000;
+			return 0;
+		}
+		ret = pz13_ec_read(ec, PZ13_EC_PAGE_FAN, pz13_ec_temp_regs[channel], &lsb);
+		if (ret)
+			return ret;
+		*val = lsb * 1000;
+		return 0;
+	case hwmon_fan:
+		if (attr != hwmon_fan_input)
+			return -EOPNOTSUPP;
+		ret = pz13_ec_read(ec, PZ13_EC_PAGE_FAN, PZ13_EC_FAN_RPM_LSB, &lsb);
+		if (ret)
+			return ret;
+		ret = pz13_ec_read(ec, PZ13_EC_PAGE_FAN, PZ13_EC_FAN_RPM_MSB, &msb);
+		if (ret)
+			return ret;
+		*val = (msb << 8) | lsb;
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+static int pz13_ec_hwmon_read_string(struct device *dev,
+				     enum hwmon_sensor_types type,
+				     u32 attr, int channel, const char **str)
+{
+	if (type == hwmon_temp && attr == hwmon_temp_label) {
+		*str = pz13_ec_temp_labels[channel];
+		return 0;
+	}
+	if (type == hwmon_fan && attr == hwmon_fan_label) {
+		*str = "fan";
+		return 0;
+	}
+	return -EOPNOTSUPP;
+}
+
+static const struct hwmon_ops pz13_ec_hwmon_ops = {
+	.is_visible = pz13_ec_hwmon_is_visible,
+	.read = pz13_ec_hwmon_read,
+	.read_string = pz13_ec_hwmon_read_string,
+};
+
+static const struct hwmon_channel_info * const pz13_ec_hwmon_info[] = {
+	HWMON_CHANNEL_INFO(temp,
+			   HWMON_T_INPUT | HWMON_T_LABEL,
+			   HWMON_T_INPUT | HWMON_T_LABEL,
+			   HWMON_T_INPUT | HWMON_T_LABEL),
+	HWMON_CHANNEL_INFO(fan, HWMON_F_INPUT | HWMON_F_LABEL),
+	NULL
+};
+
+static const struct hwmon_chip_info pz13_ec_hwmon_chip_info = {
+	.ops = &pz13_ec_hwmon_ops,
+	.info = pz13_ec_hwmon_info,
+};
+
+static int pz13_ec_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct device *hwmon;
+	struct pz13_ec *ec;
+	u8 val;
+	int ret;
+
+	ec = devm_kzalloc(dev, sizeof(*ec), GFP_KERNEL);
+	if (!ec)
+		return -ENOMEM;
+
+	ec->client = client;
+	ret = devm_mutex_init(dev, &ec->lock);
+	if (ret)
+		return ret;
+	i2c_set_clientdata(client, ec);
+
+	ret = pz13_ec_parse_zones(ec);
+	if (ret)
+		return ret;
+
+	ret = pz13_ec_read(ec, PZ13_EC_PAGE_FAN, PZ13_EC_FAN_CTRL, &val);
+	if (ret)
+		return dev_err_probe(dev, ret, "EC does not answer\n");
+	/* Left over from an earlier instance; the poll clears it with hysteresis */
+	ec->full_speed = val & PZ13_EC_FAN_CTRL_FULL;
+
+	ret = pz13_ec_report_temp(ec, PZ13_EC_FLOOR_TEMP);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot talk to the EC\n");
+
+	hwmon = devm_hwmon_device_register_with_info(dev, "pz13_ec", ec,
+						     &pz13_ec_hwmon_chip_info, NULL);
+	if (IS_ERR(hwmon))
+		return dev_err_probe(dev, PTR_ERR(hwmon), "cannot register hwmon\n");
+
+	ret = devm_delayed_work_autocancel(dev, &ec->work, pz13_ec_poll);
+	if (ret)
+		return ret;
+	schedule_delayed_work(&ec->work, 0);
+
+	return 0;
+}
+
+static int pz13_ec_suspend(struct device *dev)
+{
+	struct pz13_ec *ec = dev_get_drvdata(dev);
+	int ret;
+
+	cancel_delayed_work_sync(&ec->work);
+	/* The fan must not run through suspend */
+	ret = pz13_ec_set_full_speed(ec, false);
+	if (ret)
+		return ret;
+	return pz13_ec_report_temp(ec, PZ13_EC_NO_TEMP);
+}
+
+static int pz13_ec_resume(struct device *dev)
+{
+	struct pz13_ec *ec = dev_get_drvdata(dev);
+
+	schedule_delayed_work(&ec->work, 0);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(pz13_ec_pm_ops, pz13_ec_suspend, pz13_ec_resume);
+
+static const struct of_device_id pz13_ec_of_match[] = {
+	{ .compatible = "asus,proart-pz13-ec" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, pz13_ec_of_match);
+
+static struct i2c_driver pz13_ec_driver = {
+	.driver = {
+		.name = "asus-proart-pz13-ec",
+		.of_match_table = pz13_ec_of_match,
+		.pm = pm_sleep_ptr(&pz13_ec_pm_ops),
+	},
+	.probe = pz13_ec_probe,
+};
+module_i2c_driver(pz13_ec_driver);
+
+MODULE_DESCRIPTION("ASUS ProArt PZ13 embedded controller driver");
+MODULE_LICENSE("GPL");
