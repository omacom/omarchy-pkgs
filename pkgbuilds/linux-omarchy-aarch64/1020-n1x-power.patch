+{
+	genpd_switch_state(dev, true, true);
+}
+EXPORT_SYMBOL_GPL(dev_pm_genpd_suspend_s2idle);
+
 /**
  * dev_pm_genpd_resume - Synchronously try to resume the genpd for @dev
  * @dev: The device that is attached to the genpd, which needs to be resumed.
@@ -1793,7 +1802,7 @@ EXPORT_SYMBOL_GPL(dev_pm_genpd_suspend);
  */
 void dev_pm_genpd_resume(struct device *dev)
 {
-	genpd_switch_state(dev, false);
+	genpd_switch_state(dev, false, false);
 }
 EXPORT_SYMBOL_GPL(dev_pm_genpd_resume);
 
diff --git a/include/linux/pm_domain.h b/include/linux/pm_domain.h
index 0208d6c85d..4ac6005610 100644
--- a/include/linux/pm_domain.h
+++ b/include/linux/pm_domain.h
@@ -434,9 +434,11 @@ static inline bool dev_pm_genpd_is_on(struct device *dev)
 
 #ifdef CONFIG_PM_GENERIC_DOMAINS_SLEEP
