From 3c63503ce65b63d31001a13d9fd460182b635a7d Mon Sep 17 00:00:00 2001
From: Bharat Dintakurti <bdintakurti@nvidia.com>
Date: Tue, 1 Sep 2026 22:49:24 +0000
Subject: [PATCH] NVIDIA: SAUCE: ACPI: processor_idle: Clear freed cpuidle
 device pointers

BugLink: https://bugs.launchpad.net/bugs/2167301

acpi_processor_power_init() publishes each allocated cpuidle device through
the per-CPU acpi_cpuidle_device pointer. The normal processor power-exit
path and the global power-state refresh path unregister and free that
device without clearing the published pointer.

If reinitialization fails before installing a replacement, the per-CPU slot
continues to reference freed memory. A repeated or adjacent lifecycle
operation can then consume the dangling pointer.

Clear the owner slot immediately after unregistering the device and before
freeing it in both paths.

Fixes: e18afcb7b2a12 ("ACPI: processor_idle: Fix memory leak in acpi_processor_power_exit()")
Fixes: 07cba0de5598 ("ACPI: processor: idle: Reset cpuidle on C-state list changes")
Signed-off-by: Bharat Dintakurti <bdintakurti@nvidia.com>
Signed-off-by: Ishan Shah <ishah@nvidia.com>
Reviewed-by: Ishan Shah <ishah@nvidia.com>
Assisted-by: OpenAI-Codex:gpt-5.6
Acked-by: Jamie Nguyen <jamien@nvidia.com>
Acked-by: Carol L Soto <csoto@nvidia.com>
Acked-by: Nirmoy Das <nirmoyd@nvidia.com>
Signed-off-by: Brad Figg <bfigg@nvidia.com>
---
 drivers/acpi/processor_idle.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/acpi/processor_idle.c b/drivers/acpi/processor_idle.c
index 4482cf28f5..49c9f51e84 100644
--- a/drivers/acpi/processor_idle.c
+++ b/drivers/acpi/processor_idle.c
@@ -1319,6 +1319,7 @@ int acpi_processor_power_state_has_changed(struct acpi_processor *pr)
 				continue;
 
 			cpuidle_unregister_device_no_lock(dev);
+			per_cpu(acpi_cpuidle_device, cpu) = NULL;
 			kfree(dev);
 			_pr->flags.power = 0;
 		}
@@ -1461,6 +1462,7 @@ void acpi_processor_power_exit(struct acpi_processor *pr)
 
 	if (pr->flags.power) {
 		cpuidle_unregister_device(dev);
+		per_cpu(acpi_cpuidle_device, pr->id) = NULL;
 		kfree(dev);
 	}
 
From 8fb13cd71cb76faab1332bafebc3eb4152d2ede3 Mon Sep 17 00:00:00 2001
From: Ishan Shah <ishah@nvidia.com>
Date: Mon, 14 Sep 2026 22:53:27 +0000
Subject: [PATCH] NVIDIA: SAUCE: ACPI: processor_idle: Serialize idle-state
 rebuilds

BugLink: https://bugs.launchpad.net/bugs/2167301

A power-state notification rebuilds the shared ACPI idle driver and every
cpuidle device.  The cpuidle lock protects individual registration
operations, but it is released between device teardown, driver replacement,
and device recreation.

Concurrent CPU0 notifications can therefore interleave complete rebuild
transactions and lose or free each other's objects.  Serialize the
system-wide transaction with a dedicated mutex.  Recheck the processor
state after taking the mutex because another rebuild may have completed
while the notification waited.

Signed-off-by: Ishan Shah <ishah@nvidia.com>
Assisted-by: OpenAI-Codex:gpt-5.6
Acked-by: Jamie Nguyen <jamien@nvidia.com>
Acked-by: Carol L Soto <csoto@nvidia.com>
Acked-by: Nirmoy Das <nirmoyd@nvidia.com>
Signed-off-by: Brad Figg <bfigg@nvidia.com>
---
 drivers/acpi/processor_idle.c | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/drivers/acpi/processor_idle.c b/drivers/acpi/processor_idle.c
index 49c9f51e84..42e0e08372 100644
--- a/drivers/acpi/processor_idle.c
+++ b/drivers/acpi/processor_idle.c
@@ -50,6 +50,7 @@ static unsigned int latency_factor __read_mostly = 2;
 module_param(latency_factor, uint, 0644);
 
 static DEFINE_PER_CPU(struct cpuidle_device *, acpi_cpuidle_device);
+static DEFINE_MUTEX(acpi_idle_rebuild_lock);
 
 static struct cpuidle_driver acpi_idle_driver = {
 	.name =		"acpi_idle",
@@ -1291,14 +1292,20 @@ int acpi_processor_hotplug(struct acpi_processor *pr)
 int acpi_processor_power_state_has_changed(struct acpi_processor *pr)
 {
 	int cpu;
+	int ret = 0;
 	struct acpi_processor *_pr;
 	struct cpuidle_device *dev;
 
 	if (disabled_by_idle_boot_param())
 		return 0;
+	if (pr->id != 0)
+		return 0;
 
-	if (!pr->flags.power_setup_done)
-		return -ENODEV;
+	mutex_lock(&acpi_idle_rebuild_lock);
+	if (!pr->flags.power_setup_done) {
+		ret = -ENODEV;
+		goto out;
+	}
 
 	/*
 	 * FIXME:  Design the ACPI notification to make it once per
@@ -1306,7 +1313,7 @@ int acpi_processor_power_state_has_changed(struct acpi_processor *pr)
 	 * to make the code that updates C-States be called once.
 	 */
 
-	if (pr->id == 0 && cpuidle_get_driver() == &acpi_idle_driver) {
+	if (cpuidle_get_driver() == &acpi_idle_driver) {
 		/* Protect against cpu-hotplug */
 		cpus_read_lock();
 
@@ -1347,7 +1354,9 @@ int acpi_processor_power_state_has_changed(struct acpi_processor *pr)
 		cpus_read_unlock();
 	}
 
-	return 0;
+out:
+	mutex_unlock(&acpi_idle_rebuild_lock);
+	return ret;
 }
 
 void acpi_processor_register_idle_driver(void)
