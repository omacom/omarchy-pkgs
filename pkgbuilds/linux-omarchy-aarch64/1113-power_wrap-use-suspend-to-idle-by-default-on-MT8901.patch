From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Hughes <ryan@heyoodle.com>
Date: Mon, 26 Oct 2026 22:11:16 -0400
Subject: [PATCH] soc: mediatek: power_wrap: use suspend-to-idle by default on
 MT8901

The MT8901 firmware advertises PSCI SYSTEM_SUSPEND, so the kernel
defaults to "deep" sleep, but the call returns at once and the system
wakes straight back up. Every N1x install has had to boot with
mem_sleep_default=s2idle.

Do what x86 does for LPS0 systems: when the FADT sets the low-power S0
idle flag, use suspend-to-idle by default unless mem_sleep_default= was
given on the command line.
---
 drivers/soc/mediatek/power_wrap/power_wrap.c | 22 ++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/drivers/soc/mediatek/power_wrap/power_wrap.c b/drivers/soc/mediatek/power_wrap/power_wrap.c
index d9fdef87f..2b5df8e4e 100644
--- a/drivers/soc/mediatek/power_wrap/power_wrap.c
+++ b/drivers/soc/mediatek/power_wrap/power_wrap.c
@@ -13,6 +13,7 @@
 #include <linux/platform_device.h>
 #include <linux/printk.h>
 #include <linux/slab.h>
+#include <linux/suspend.h>
 
 #include "power_wrap.h"
 
@@ -913,6 +914,25 @@ static int __init pwrap_usb4_report_pending(void)
 }
 late_initcall(pwrap_usb4_report_pending);
 
+/*
+ * The MT8901 firmware advertises PSCI SYSTEM_SUSPEND, so the kernel defaults
+ * to "deep" sleep, but the call returns at once and the system wakes straight
+ * back up. Like x86, use suspend-to-idle by default when the FADT says the
+ * platform is low-power S0 idle capable, unless mem_sleep_default= was given.
+ */
+static void pwrap_default_s2idle(struct pwrap_driver_data *priv)
+{
+#ifdef CONFIG_SUSPEND
+	if (priv->plid != PWRAP_PLID_MT8901 ||
+	    !(acpi_gbl_FADT.flags & ACPI_FADT_LOW_POWER_S0) ||
+	    mem_sleep_default <= PM_SUSPEND_MEM)
+		return;
+
+	mem_sleep_current = PM_SUSPEND_TO_IDLE;
+	dev_info(priv->dev, "suspend-to-idle used by default for system suspend\n");
+#endif
+}
+
 static int mtk_pwrap_probe(struct platform_device *pdev)
 {
 	const struct acpi_device_id	*id;
@@ -996,6 +1016,8 @@ static int mtk_pwrap_probe(struct platform_device *pdev)
 	if (ret)
 		dev_warn(dev, "failed to initialize sleep notifications: %d\n", ret);
 
+	pwrap_default_s2idle(priv);
+
 	return 0;
 }
 
