From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Fri, 13 Nov 2026 20:16:54 -0600
Subject: [PATCH] arm64: dts: qcom: surface-laptop8: Describe the PCIe root
 complexes of the USB4 routers

Add the root complex each USB4 host router tunnels PCIe into, as a
child of the router, and let the routers provide its resets. Router 0
gets the root complex's power domain as well, as router 1 has it.

The register blocks, the memory windows and the interrupts are those
of PCI0 and PCI1 in the laptop's ACPI tables; the IOMMU streams and the
MSI device IDs follow the IORT mapping of PCI segments 0 and 1, the
same rule the other root complexes use.

Each root complex has its root port described: it is external facing
and names the router it belongs to, as RP1 does in the ACPI tables, so
that what is plugged in is untrusted and confined by the IOMMU.

Assisted-by: Claude Fable 5.2
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 .../qcom/glymur-microsoft-surface-laptop8.dts | 209 +++++++++++++++++-
 1 file changed, 208 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/glymur-microsoft-surface-laptop8.dts b/arch/arm64/boot/dts/qcom/glymur-microsoft-surface-laptop8.dts
index ee562c014..4368b1c2f 100644
--- a/arch/arm64/boot/dts/qcom/glymur-microsoft-surface-laptop8.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-microsoft-surface-laptop8.dts
@@ -22,6 +22,7 @@
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/leds/common.h>
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/reset/qcom,glymur-usb4.h>
 
 /* As mahua-crd.dts: one pmcx0102 die on SPMI0. */
 /delete-node/ &pmcx0102_d_e0;
@@ -875,7 +876,9 @@ usb4_0: usb4@15600000 {
 			 <&gcc GCC_USB4_0_DP0_PHY_PRIM_BCR>;
 		reset-names = "router", "phy", "dp";
 
-		power-domains = <&gcc GCC_USB4_0_GDSC>;
+		power-domains = <&gcc GCC_USB4_0_GDSC>,
+				<&gcc GCC_PCIE_0_TUNNEL_GDSC>;
+		power-domain-names = "usb4", "pcie-tunnel";
 		required-opps = <&rpmhpd_opp_nom>;
 
 		interconnects = <&aggre4_noc MASTER_USB4_0 QCOM_ICC_TAG_ALWAYS
@@ -905,11 +908,113 @@ &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
 		mode-switch;
 		orientation-switch;
 
+		#reset-cells = <1>;
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		dma-ranges;
+
 		port {
 			usb4_0_typec_out: endpoint {
 				remote-endpoint = <&pmic_glink_usb4_in>;
 			};
 		};
+
+		/*
+		 * The root complex this router tunnels PCIe into. It is a
+		 * device only while a tunnel exists: the router's driver
+		 * creates it then. Addresses, windows and interrupts are
+		 * those of the ACPI tables' PCI0 (segment 0).
+		 */
+		usb4_0_pcie: pcie@1c28000 {
+			device_type = "pci";
+			compatible = "qcom,glymur-pcie-usb4";
+			reg = <0x0 0x01c28000 0x0 0x3000>,
+			      <0x4 0x00000000 0x0 0xf20>,
+			      <0x4 0x00000f40 0x0 0xa8>,
+			      <0x4 0x10000000 0x0 0x10000>,
+			      <0x0 0x40000000 0x0 0x100000>;
+			reg-names = "parf",
+				    "dbi",
+				    "elbi",
+				    "atu",
+				    "config";
+			#address-cells = <3>;
+			#size-cells = <2>;
+			ranges = <0x02000000 0x0 0x40100000 0x0 0x40100000 0x0 0x0ff00000>,
+				 <0x03000000 0x40 0x00000000 0x40 0x00000000 0x10 0x00000000>;
+			bus-range = <0x00 0xff>;
+
+			dma-coherent;
+
+			linux,pci-domain = <0>;
+
+			msi-map = <0x0 &gic_its 0x80000 0x10000>;
+			iommu-map = <0x0 &pcie_smmu 0x0 0x10000>;
+
+			interrupts = <GIC_SPI 152 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "global";
+
+			#interrupt-cells = <1>;
+			interrupt-map-mask = <0 0 0 0x7>;
+			interrupt-map = <0 0 0 1 &intc 0 0 GIC_SPI 148 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 2 &intc 0 0 GIC_SPI 149 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 3 &intc 0 0 GIC_SPI 150 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 4 &intc 0 0 GIC_SPI 151 IRQ_TYPE_LEVEL_HIGH>;
+
+			clocks = <&gcc GCC_PCIE_0_AUX_CLK>,
+				 <&gcc GCC_PCIE_0_CFG_AHB_CLK>,
+				 <&gcc GCC_PCIE_0_MSTR_AXI_CLK>,
+				 <&gcc GCC_PCIE_0_SLV_AXI_CLK>,
+				 <&gcc GCC_PCIE_0_SLV_Q2A_AXI_CLK>,
+				 <&gcc GCC_PCIE_0_PIPE_CLK>;
+			clock-names = "aux",
+				      "cfg",
+				      "bus_master",
+				      "bus_slave",
+				      "slave_q2a",
+				      "pipe";
+
+			assigned-clocks = <&gcc GCC_PCIE_0_AUX_CLK>;
+			assigned-clock-rates = <19200000>;
+
+			interconnects = <&pcie_east_anoc MASTER_PCIE_0 QCOM_ICC_TAG_ALWAYS
+					 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
+					<&hsc_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ALWAYS
+					 &pcie_east_slv_noc SLAVE_PCIE_0 QCOM_ICC_TAG_ALWAYS>;
+			interconnect-names = "pcie-mem",
+					     "cpu-pcie";
+
+			resets = <&gcc GCC_PCIE_0_TUNNEL_BCR>,
+				 <&usb4_0 QCOM_GLYMUR_USB4_PCIE_PIPE>,
+				 <&usb4_0 QCOM_GLYMUR_USB4_PCIE_PERST>;
+			reset-names = "pci",
+				      "pipe",
+				      "perst";
+
+			power-domains = <&gcc GCC_PCIE_0_TUNNEL_GDSC>;
+			required-opps = <&rpmhpd_opp_nom>;
+
+			/*
+			 * The root port: what is plugged into the USB4
+			 * port appears below it, so it is external facing
+			 * and its devices are untrusted (ACPI: RP1 with
+			 * ExternalFacingPort and the same reference to the
+			 * router).
+			 */
+			pcie@0 {
+				device_type = "pci";
+				reg = <0x0 0x0 0x0 0x0 0x0>;
+				bus-range = <0x01 0xff>;
+
+				#address-cells = <3>;
+				#size-cells = <2>;
+				ranges;
+
+				external-facing;
+				usb4-host-interface = <&usb4_0>;
+			};
+		};
 	};
 
 	/*
@@ -994,11 +1099,113 @@ &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
 		mode-switch;
 		orientation-switch;
 
+		#reset-cells = <1>;
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		dma-ranges;
+
 		port {
 			usb4_1_typec_out: endpoint {
 				remote-endpoint = <&pmic_glink_usb4_in1>;
 			};
 		};
+
+		/*
+		 * The root complex this router tunnels PCIe into. It is a
+		 * device only while a tunnel exists: the router's driver
+		 * creates it then. Addresses, windows and interrupts are
+		 * those of the ACPI tables' PCI1 (segment 1).
+		 */
+		usb4_1_pcie: pcie@1c20000 {
+			device_type = "pci";
+			compatible = "qcom,glymur-pcie-usb4";
+			reg = <0x0 0x01c20000 0x0 0x3000>,
+			      <0x5 0x00000000 0x0 0xf20>,
+			      <0x5 0x00000f40 0x0 0xa8>,
+			      <0x5 0x10000000 0x0 0x10000>,
+			      <0x0 0x50000000 0x0 0x100000>;
+			reg-names = "parf",
+				    "dbi",
+				    "elbi",
+				    "atu",
+				    "config";
+			#address-cells = <3>;
+			#size-cells = <2>;
+			ranges = <0x02000000 0x0 0x50100000 0x0 0x50100000 0x0 0x0ff00000>,
+				 <0x03000000 0x50 0x00000000 0x50 0x00000000 0x10 0x00000000>;
+			bus-range = <0x00 0xff>;
+
+			dma-coherent;
+
+			linux,pci-domain = <1>;
+
+			msi-map = <0x0 &gic_its 0x90000 0x10000>;
+			iommu-map = <0x0 &pcie_smmu 0x10000 0x10000>;
+
+			interrupts = <GIC_SPI 939 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "global";
+
+			#interrupt-cells = <1>;
+			interrupt-map-mask = <0 0 0 0x7>;
+			interrupt-map = <0 0 0 1 &intc 0 0 GIC_SPI 918 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 2 &intc 0 0 GIC_SPI 919 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 3 &intc 0 0 GIC_SPI 920 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 4 &intc 0 0 GIC_SPI 921 IRQ_TYPE_LEVEL_HIGH>;
+
+			clocks = <&gcc GCC_PCIE_1_AUX_CLK>,
+				 <&gcc GCC_PCIE_1_CFG_AHB_CLK>,
+				 <&gcc GCC_PCIE_1_MSTR_AXI_CLK>,
+				 <&gcc GCC_PCIE_1_SLV_AXI_CLK>,
+				 <&gcc GCC_PCIE_1_SLV_Q2A_AXI_CLK>,
+				 <&gcc GCC_PCIE_1_PIPE_CLK>;
+			clock-names = "aux",
+				      "cfg",
+				      "bus_master",
+				      "bus_slave",
+				      "slave_q2a",
+				      "pipe";
+
+			assigned-clocks = <&gcc GCC_PCIE_1_AUX_CLK>;
+			assigned-clock-rates = <19200000>;
+
+			interconnects = <&pcie_east_anoc MASTER_PCIE_1 QCOM_ICC_TAG_ALWAYS
+					 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
+					<&hsc_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ALWAYS
+					 &pcie_east_slv_noc SLAVE_PCIE_1 QCOM_ICC_TAG_ALWAYS>;
+			interconnect-names = "pcie-mem",
+					     "cpu-pcie";
+
+			resets = <&gcc GCC_PCIE_1_TUNNEL_BCR>,
+				 <&usb4_1 QCOM_GLYMUR_USB4_PCIE_PIPE>,
+				 <&usb4_1 QCOM_GLYMUR_USB4_PCIE_PERST>;
+			reset-names = "pci",
+				      "pipe",
+				      "perst";
+
+			power-domains = <&gcc GCC_PCIE_1_TUNNEL_GDSC>;
+			required-opps = <&rpmhpd_opp_nom>;
+
+			/*
+			 * The root port: what is plugged into the USB4
+			 * port appears below it, so it is external facing
+			 * and its devices are untrusted (ACPI: RP1 with
+			 * ExternalFacingPort and the same reference to the
+			 * router).
+			 */
+			pcie@0 {
+				device_type = "pci";
+				reg = <0x0 0x0 0x0 0x0 0x0>;
+				bus-range = <0x01 0xff>;
+
+				#address-cells = <3>;
+				#size-cells = <2>;
+				ranges;
+
+				external-facing;
+				usb4-host-interface = <&usb4_1>;
+			};
+		};
 	};
 };
 
