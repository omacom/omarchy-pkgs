From fba134c5de07e1a8875fb4ac31ddedab8f780727 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Sun, 8 Nov 2026 14:00:00 +0100
Subject: [PATCH] arm64: dts: qcom: x1p42100-asus-vivobook-s14: Name the sound
 card after its topology

The AudioReach driver loads qcom/x1e80100/<model>-tplg.bin, and no
firmware package has X1P42100-ASUS-Vivobook-S14-tplg.bin, so the sound
card would never register. linux-firmware ships Qualcomm's ThinkPad
T14s topology under the Vivobook S 15's name, which this tree is
derived from, and the card's WCD, WSA and VA links are the ones that
topology has. Use that name.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 arch/arm64/boot/dts/qcom/x1p42100-asus-vivobook-s14.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/x1p42100-asus-vivobook-s14.dts b/arch/arm64/boot/dts/qcom/x1p42100-asus-vivobook-s14.dts
index 41db161..4b5c369 100644
--- a/arch/arm64/boot/dts/qcom/x1p42100-asus-vivobook-s14.dts
+++ b/arch/arm64/boot/dts/qcom/x1p42100-asus-vivobook-s14.dts
@@ -53,7 +53,7 @@
 
 	sound {
 		compatible = "qcom,x1e80100-sndcard";
-		model = "X1P42100-ASUS-Vivobook-S14";
+		model = "X1E80100-ASUS-Vivobook-S15";
 
 		audio-routing = "SpkrLeft IN", "WSA WSA_SPK1 OUT",
 				"SpkrRight IN", "WSA WSA_SPK2 OUT",
-- 
