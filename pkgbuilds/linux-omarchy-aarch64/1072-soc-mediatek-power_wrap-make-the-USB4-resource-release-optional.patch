From 2bc8e8fe5ed2dfb21b8993c427f326bcb0cdeadf Mon Sep 17 00:00:00 2001
From: Ryan Hughes <ryan@heyoodle.com>
Date: Fri, 2 Oct 2026 19:29:03 -0400
Subject: [PATCH 1072/1072] soc: mediatek: power_wrap: make the USB4 resource
 release optional

Once every xHCI has bound, power_wrap tells the SSPM to release the USB4
resources the bootloader left powered, for systems that do not use USB4.
After that the SSPM no longer answers device requests for the USB4 host
routers (\_SB.UBFn): probe and D0 both time out. A system that runs a
USB4 connection manager needs those requests.

Add power_wrap_drv.usb4_release to keep the resources. It defaults to
releasing them, as before.
---
 drivers/soc/mediatek/power_wrap/power_wrap.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/drivers/soc/mediatek/power_wrap/power_wrap.c b/drivers/soc/mediatek/power_wrap/power_wrap.c
index 5db9077b56..50b1858aad 100644
--- a/drivers/soc/mediatek/power_wrap/power_wrap.c
+++ b/drivers/soc/mediatek/power_wrap/power_wrap.c
@@ -127,6 +127,15 @@ static struct device *pwrap_usb4_early_bound[PWRAP_USB4_MAX_XHCI];
 static unsigned int pwrap_usb4_nearly;
 static bool pwrap_usb4_tracking;
 static bool pwrap_usb4_done;
+
+/*
+ * The release suits systems that leave USB4 unused. A system running a USB4
+ * connection manager needs the host routers kept, so it can turn this off.
+ */
+static bool usb4_release = true;
+module_param(usb4_release, bool, 0444);
+MODULE_PARM_DESC(usb4_release,
+		 "Release the USB4 resources left powered by the bootloader once xHCI has bound (default: true)");
 static struct notifier_block pwrap_usb4_nb;
 
 /* Controllers found unbound by the collection pass, before commit. */
@@ -772,6 +781,11 @@ static void pwrap_usb4_arm_release(struct device *dev)
 	unsigned int i;
 	int ret;
 
+	if (!usb4_release) {
+		dev_info(dev, "USB4: release disabled, keeping usb4 resources\n");
+		return;
+	}
+
 	status = acpi_evaluate_integer(ACPI_HANDLE(dev), "PLID", NULL, &plid);
 	if (ACPI_FAILURE(status)) {
 		dev_info(dev, "USB4: PLID unavailable (%s), skipping release\n",
-- 
