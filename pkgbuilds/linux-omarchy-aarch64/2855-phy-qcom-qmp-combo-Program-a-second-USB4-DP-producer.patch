From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 12 Nov 2026 22:18:22 -0600
Subject: [PATCH 2855/2856] phy: qcom: qmp-combo: Program a second USB4 DP producer/AUX
 block

The USB4 set-up of the PHY writes two registers of a small DP
producer/AUX block that sits outside the PHY, described by the optional
"usb4-dp-aux" region. For USB4 host router 1 the platform's Windows
driver writes the same two registers in a second block of the same
kind, at 0x088f0000, before the shared one.

Take an optional "usb4-dp-aux2" region and program it first.

DisplayPort through router 1 works on a Surface Laptop 8 with this
block programmed. Whether it works without it was not tested.

Assisted-by: Claude Fable 5.2
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/phy/qualcomm/phy-qcom-qmp-combo.c | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
index 702dbaeeb..19522682b 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
@@ -2665,6 +2665,7 @@ struct qmp_combo {
 	void __iomem *usb4_pcs;
 	/* Optional shared USB4 DP producer/AUX block programmed before USB4 tables. */
 	void __iomem *usb4_dp_aux;
+	void __iomem *usb4_dp_aux2;
 
 	struct clk *pipe_clk;
 	struct clk_bulk_data *clks;
@@ -4665,9 +4666,14 @@ static int qmp_v8_configure_usb4_phy(struct qmp_combo *qmp)
 	}
 
 	/*
-	 * Program the shared DP producer/AUX block after the common setup and
-	 * before the common and PCS resets and the selected table.
+	 * Program the DP producer/AUX blocks after the common setup and
+	 * before the common and PCS resets and the selected table: the one
+	 * only some routers have, then the shared one.
 	 */
+	if (qmp->usb4_dp_aux2) {
+		writel(0, qmp->usb4_dp_aux2 + QMP_USB4_DP_AUX_MODE);
+		writel(QMP_USB4_DP_AUX_CFG1_VAL, qmp->usb4_dp_aux2 + QMP_USB4_DP_AUX_CFG1);
+	}
 	if (qmp->usb4_dp_aux) {
 		writel(0, qmp->usb4_dp_aux + QMP_USB4_DP_AUX_MODE);
 		writel(QMP_USB4_DP_AUX_CFG1_VAL, qmp->usb4_dp_aux + QMP_USB4_DP_AUX_CFG1);
@@ -5896,6 +5902,13 @@ static int qmp_combo_parse_dt(struct qmp_combo *qmp)
 		if (!qmp->usb4_dp_aux)
 			return -ENOMEM;
 	}
+	/* A second block of the same kind, written first where it exists. */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "usb4-dp-aux2");
+	if (res) {
+		qmp->usb4_dp_aux2 = devm_ioremap(dev, res->start, resource_size(res));
+		if (!qmp->usb4_dp_aux2)
+			return -ENOMEM;
+	}
 
 	ret = qmp_combo_clk_init(qmp);
 	if (ret)
-- 
