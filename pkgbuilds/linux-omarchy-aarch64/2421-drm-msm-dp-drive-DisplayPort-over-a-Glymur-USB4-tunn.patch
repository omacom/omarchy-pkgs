+static int msm_dp_usb4_hpd_locked(struct device *dev, bool connected, bool irq)
+{
+	struct msm_dp_display_private *dp;
+	int ret = 0;
+
+	if (!dev || !dev_get_drvdata(dev))
+		return -ENODEV;
+	dp = dev_get_dp_display_private(dev);
+	mutex_lock(&dp->usb4_lock);
+	if (!dp->usb4_bound || !dp->usb4_attached) {
+		ret = -ENODEV;
+	} else {
+		dp->usb4_connected = connected;
+		dp->usb4_irq |= irq;
+		schedule_work(&dp->usb4_hpd_work);
+	}
+	mutex_unlock(&dp->usb4_lock);
+	return ret;
+}
+
+int msm_dp_usb4_hpd(struct device *dev, bool connected, bool irq)
+{
+	int ret;
+
+	if (!dev)
+		return -ENODEV;
+	device_lock(dev);
+	ret = msm_dp_usb4_hpd_locked(dev, connected, irq);
+	device_unlock(dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(msm_dp_usb4_hpd);
