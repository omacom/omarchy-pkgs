From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 8 Oct 2026 13:54:51 -0500
Subject: [PATCH] drm/msm/dp: drive DisplayPort over a Glymur USB4 tunnel

On Glymur, DP controller 0 can feed the USB4 host router's DP IN
adapter instead of the combo PHY. The router then owns the sink: it
carries AUX, reports HPD, and trains the DP OUT link at the far end of
the tunnel. The DP controller has no way to work in that arrangement.

Add an experimental interface, include/linux/soc/qcom/usb4-dp.h, through
which the Qualcomm Glymur USB4 host router driver attaches its tunnel to
the controller, and use it:

- AUX: while a tunnel is attached, transfers go to the router's AUX
  channel and the controller's own AUX and HPD blocks are left alone.
  The tunnel's no_zero_sized setting is used, so segmented (E-DDC) EDID
  reads keep MOT set between messages. Runtime PM is now taken before
  the AUX lock for every transfer, including address-only ones.
- HPD: the router reports HPD through msm_dp_usb4_hpd() and
  msm_dp_usb4_hpd_sync(), handled in a separate worker so the router's
  mailbox worker never waits for AUX or a modeset; native HPD
  notifications are ignored while the tunnel is attached. A synchronous
  disconnect waits up to one second for the atomic disable, then shuts
  the PHY down.
- Link: the link clocks are switched to the tunnel source, the DP IN
  clock divider follows the link rate, and the USB4 link interface
  clock is enabled. The producer is held in reset while the router
  configures and trains the receiver, then the main link starts without
  a reset pulse. Mode bits, the post-training flag and the second
  transfer unit bank are set for the producer and restored when the
  link clocks stop. Native training, its retries and the native FEC
  setup are skipped; FEC readiness goes through the router, and the
  producer takes its FEC symbol sequence from registers. Video and idle
  readiness are polled from MAINLINK_READY, which is all the tunnelled
  producer reports.
- Interrupts: link status interrupts are masked while the tunnel's link
  clocks are off, under a lock shared with the interrupt handler, which
  now writes back the current mask instead of re-enabling all of them.
  Stale status is drained each time the link clocks start.
- Routing: msm_dp_usb4_route() asks the DPU to route the DP stream into
  the USB4 DP IN adapter.

The register values and sequences match what the platform's Windows
driver programs on this laptop.

Experimental; exercised only on the Surface Laptop 8 with its USB4 host
router driver.

Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/gpu/drm/msm/dp/dp_aux.c     | 178 ++++++++++-
 drivers/gpu/drm/msm/dp/dp_aux.h     |  11 +
 drivers/gpu/drm/msm/dp/dp_ctrl.c    | 445 +++++++++++++++++++++++++++-
 drivers/gpu/drm/msm/dp/dp_display.c | 293 +++++++++++++++++-
 include/linux/soc/qcom/usb4-dp.h    |  52 ++++
 5 files changed, 958 insertions(+), 21 deletions(-)
 create mode 100644 include/linux/soc/qcom/usb4-dp.h

diff --git a/drivers/gpu/drm/msm/dp/dp_aux.c b/drivers/gpu/drm/msm/dp/dp_aux.c
index f39ea58b9f2..3a1ee098c8a 100644
--- a/drivers/gpu/drm/msm/dp/dp_aux.c
+++ b/drivers/gpu/drm/msm/dp/dp_aux.c
@@ -6,6 +6,7 @@
 #include <linux/delay.h>
 #include <linux/iopoll.h>
 #include <linux/phy/phy.h>
+#include <linux/soc/qcom/usb4-dp.h>
 #include <drm/drm_print.h>
 
 #include "dp_reg.h"
@@ -43,6 +44,11 @@ struct msm_dp_aux_private {
 	u32 offset;
 	u32 segment;
 
+	bool external_connected;
+	bool saved_no_zero_sized;
+	struct drm_dp_aux *external_aux;
+	const struct msm_dp_usb4_ops *usb4_ops;
+	void *usb4_data;
 	struct drm_dp_aux msm_dp_aux;
 };
 
@@ -369,13 +375,29 @@ static ssize_t msm_dp_aux_transfer(struct drm_dp_aux *msm_dp_aux,
 
 	aux = container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
 
+	/* Runtime resume may initialise AUX, so acquire the transfer lock after it. */
+	ret = pm_runtime_resume_and_get(msm_dp_aux->dev);
+	if (ret)
+		return ret;
+
+	/* Preserve this AUX object: panel, link and controller retain its address. */
+	mutex_lock(&aux->mutex);
+	if (aux->external_aux) {
+		if (!aux->enable_xfers || !aux->external_connected)
+			ret = -ENXIO;
+		else
+			ret = aux->external_aux->transfer(aux->external_aux, msg);
+		goto exit;
+	}
+
 	aux->native = msg->request & (DP_AUX_NATIVE_WRITE & DP_AUX_NATIVE_READ);
 
 	/* Ignore address only message */
 	if (msg->size == 0 || !msg->buffer) {
 		msg->reply = aux->native ?
 			DP_AUX_NATIVE_REPLY_ACK : DP_AUX_I2C_REPLY_ACK;
-		return msg->size;
+		ret = msg->size;
+		goto exit;
 	}
 
 	/* msg sanity check */
@@ -383,14 +405,10 @@ static ssize_t msm_dp_aux_transfer(struct drm_dp_aux *msm_dp_aux,
 	    msg->size > aux_cmd_i2c_max) {
 		DRM_ERROR("%s: invalid msg: size(%zu), request(%x)\n",
 			__func__, msg->size, msg->request);
-		return -EINVAL;
+		ret = -EINVAL;
+		goto exit;
 	}
 
-	ret = pm_runtime_resume_and_get(msm_dp_aux->dev);
-	if (ret)
-		return  ret;
-
-	mutex_lock(&aux->mutex);
 	if (!aux->initted) {
 		ret = -EIO;
 		goto exit;
@@ -529,6 +547,9 @@ bool msm_dp_aux_link_plugged(struct drm_dp_aux *msm_dp_aux)
 
 	aux = container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
 
+	if (READ_ONCE(aux->external_aux))
+		return READ_ONCE(aux->external_connected);
+
 	if (msm_dp_aux_is_link_connected(msm_dp_aux))
 		return true;
 
@@ -549,8 +570,10 @@ void msm_dp_aux_reconfig(struct drm_dp_aux *msm_dp_aux)
 
 	aux = container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
 
-	phy_calibrate(aux->phy);
-	msm_dp_aux_reset(aux);
+	if (!READ_ONCE(aux->external_aux)) {
+		phy_calibrate(aux->phy);
+		msm_dp_aux_reset(aux);
+	}
 }
 
 void msm_dp_aux_init(struct drm_dp_aux *msm_dp_aux)
@@ -566,7 +589,8 @@ void msm_dp_aux_init(struct drm_dp_aux *msm_dp_aux)
 
 	mutex_lock(&aux->mutex);
 
-	msm_dp_aux_enable(aux);
+	if (!aux->external_aux)
+		msm_dp_aux_enable(aux);
 	aux->retry_cnt = 0;
 	aux->initted = true;
 
@@ -582,7 +606,8 @@ void msm_dp_aux_deinit(struct drm_dp_aux *msm_dp_aux)
 	mutex_lock(&aux->mutex);
 
 	aux->initted = false;
-	msm_dp_aux_disable(aux);
+	if (!aux->external_aux)
+		msm_dp_aux_disable(aux);
 
 	mutex_unlock(&aux->mutex);
 }
@@ -619,6 +644,9 @@ static int msm_dp_wait_hpd_asserted(struct drm_dp_aux *msm_dp_aux,
 
 	aux = container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
 
+	if (READ_ONCE(aux->external_aux))
+		return READ_ONCE(aux->external_connected) ? 0 : -ENXIO;
+
 	ret = pm_runtime_resume_and_get(aux->dev);
 	if (ret)
 		return ret;
@@ -635,6 +663,9 @@ void msm_dp_aux_hpd_enable(struct drm_dp_aux *msm_dp_aux)
 		container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
 	u32 reg;
 
+	if (READ_ONCE(aux->external_aux))
+		return;
+
 	/* Configure REFTIMER and enable it */
 	reg = msm_dp_read_aux(aux, REG_DP_DP_HPD_REFTIMER);
 	reg |= DP_DP_HPD_REFTIMER_ENABLE;
@@ -650,6 +681,9 @@ void msm_dp_aux_hpd_disable(struct drm_dp_aux *msm_dp_aux)
 		container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
 	u32 reg;
 
+	if (READ_ONCE(aux->external_aux))
+		return;
+
 	reg = msm_dp_read_aux(aux, REG_DP_DP_HPD_REFTIMER);
 	reg &= ~DP_DP_HPD_REFTIMER_ENABLE;
 	msm_dp_write_aux(aux, REG_DP_DP_HPD_REFTIMER, reg);
@@ -663,6 +697,9 @@ void msm_dp_aux_hpd_intr_enable(struct drm_dp_aux *msm_dp_aux)
 		container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
 	u32 reg;
 
+	if (READ_ONCE(aux->external_aux))
+		return;
+
 	reg = msm_dp_read_aux(aux, REG_DP_DP_HPD_INT_MASK);
 	reg |= DP_DP_HPD_INT_MASK;
 	msm_dp_write_aux(aux, REG_DP_DP_HPD_INT_MASK,
@@ -675,6 +712,9 @@ void msm_dp_aux_hpd_intr_disable(struct drm_dp_aux *msm_dp_aux)
 		container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
 	u32 reg;
 
+	if (READ_ONCE(aux->external_aux))
+		return;
+
 	reg = msm_dp_read_aux(aux, REG_DP_DP_HPD_INT_MASK);
 	reg &= ~DP_DP_HPD_INT_MASK;
 	msm_dp_write_aux(aux, REG_DP_DP_HPD_INT_MASK,
@@ -687,6 +727,9 @@ u32 msm_dp_aux_get_hpd_intr_status(struct drm_dp_aux *msm_dp_aux)
 		container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
 	int isr, mask;
 
+	if (READ_ONCE(aux->external_aux))
+		return 0;
+
 	isr = msm_dp_read_aux(aux, REG_DP_DP_HPD_INT_STATUS);
 	msm_dp_write_aux(aux, REG_DP_DP_HPD_INT_ACK,
 				 (isr & DP_DP_HPD_INT_MASK));
@@ -708,6 +751,9 @@ u32 msm_dp_aux_is_link_connected(struct drm_dp_aux *msm_dp_aux)
 		container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
 	u32 status;
 
+	if (READ_ONCE(aux->external_aux))
+		return READ_ONCE(aux->external_connected) ? 2 : 0;
+
 	status = msm_dp_read_aux(aux, REG_DP_DP_HPD_INT_STATUS);
 	status >>= DP_DP_HPD_STATE_STATUS_BITS_SHIFT;
 	status &= DP_DP_HPD_STATE_STATUS_BITS_MASK;
@@ -763,3 +809,113 @@ void msm_dp_aux_put(struct drm_dp_aux *msm_dp_aux)
 
 	devm_kfree(aux->dev, aux);
 }
+
+/* Serialized against both AUX transactions and provider teardown. */
+int msm_dp_aux_usb4_set(struct drm_dp_aux *msm_dp_aux,
+		      struct drm_dp_aux *external,
+		      const struct msm_dp_usb4_ops *ops, void *data)
+{
+	struct msm_dp_aux_private *aux =
+		container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
+	int ret = 0;
+
+	mutex_lock(&aux->mutex);
+	if (external && (aux->is_edp || aux->external_aux || aux->enable_xfers)) {
+		ret = -EBUSY;
+	} else {
+		aux->enable_xfers = false;
+		aux->external_connected = false;
+		if (external) {
+			aux->saved_no_zero_sized = msm_dp_aux->no_zero_sized;
+			msm_dp_aux->no_zero_sized = external->no_zero_sized;
+		} else if (aux->external_aux) {
+			msm_dp_aux->no_zero_sized = aux->saved_no_zero_sized;
+		}
+		aux->usb4_ops = ops;
+		aux->usb4_data = data;
+		WRITE_ONCE(aux->external_aux, external);
+	}
+	mutex_unlock(&aux->mutex);
+	return ret;
+}
+
+bool msm_dp_aux_usb4_attached(struct drm_dp_aux *msm_dp_aux)
+{
+	struct msm_dp_aux_private *aux =
+		container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
+
+	return READ_ONCE(aux->external_aux) != NULL;
+}
+
+int msm_dp_aux_usb4_configure_link(struct drm_dp_aux *msm_dp_aux, u32 rate, u32 lanes)
+{
+	struct msm_dp_aux_private *aux =
+		container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
+	int ret = 0;
+
+	mutex_lock(&aux->mutex);
+	if (aux->external_aux && aux->usb4_ops && aux->usb4_ops->configure_link)
+		ret = aux->usb4_ops->configure_link(aux->usb4_data, rate, lanes);
+	mutex_unlock(&aux->mutex);
+	return ret;
+}
+
+int msm_dp_aux_usb4_train_link(struct drm_dp_aux *msm_dp_aux, u32 rate, u32 lanes)
+{
+	struct msm_dp_aux_private *aux =
+		container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
+	int ret = -ENODEV;
+
+	mutex_lock(&aux->mutex);
+	if (aux->external_aux && aux->usb4_ops && aux->usb4_ops->train_link)
+		ret = aux->usb4_ops->train_link(aux->usb4_data, rate, lanes);
+	mutex_unlock(&aux->mutex);
+	return ret;
+}
+
+bool msm_dp_aux_usb4_fec_supported(struct drm_dp_aux *msm_dp_aux)
+{
+	struct msm_dp_aux_private *aux =
+		container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
+	bool supported;
+
+	mutex_lock(&aux->mutex);
+	supported = aux->external_aux && aux->usb4_ops &&
+		    aux->usb4_ops->set_fec_ready;
+	mutex_unlock(&aux->mutex);
+	return supported;
+}
+
+int msm_dp_aux_usb4_set_fec_ready(struct drm_dp_aux *msm_dp_aux, bool ready)
+{
+	struct msm_dp_aux_private *aux =
+		container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
+	int ret = -EOPNOTSUPP;
+
+	mutex_lock(&aux->mutex);
+	if (aux->external_aux && aux->usb4_ops && aux->usb4_ops->set_fec_ready)
+		ret = aux->usb4_ops->set_fec_ready(aux->usb4_data, ready);
+	mutex_unlock(&aux->mutex);
+	return ret;
+}
+
+void msm_dp_aux_usb4_unconfigure_link(struct drm_dp_aux *msm_dp_aux)
+{
+	struct msm_dp_aux_private *aux =
+		container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
+
+	mutex_lock(&aux->mutex);
+	if (aux->external_aux && aux->usb4_ops && aux->usb4_ops->unconfigure_link)
+		aux->usb4_ops->unconfigure_link(aux->usb4_data);
+	mutex_unlock(&aux->mutex);
+}
+
+void msm_dp_aux_usb4_set_hpd(struct drm_dp_aux *msm_dp_aux, bool connected)
+{
+	struct msm_dp_aux_private *aux =
+		container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
+
+	mutex_lock(&aux->mutex);
+	aux->external_connected = connected;
+	mutex_unlock(&aux->mutex);
+}
diff --git a/drivers/gpu/drm/msm/dp/dp_aux.h b/drivers/gpu/drm/msm/dp/dp_aux.h
index 98625c9b9a0..a1ee7cca536 100644
--- a/drivers/gpu/drm/msm/dp/dp_aux.h
+++ b/drivers/gpu/drm/msm/dp/dp_aux.h
@@ -24,6 +24,17 @@ u32 msm_dp_aux_get_hpd_intr_status(struct drm_dp_aux *msm_dp_aux);
 u32 msm_dp_aux_is_link_connected(struct drm_dp_aux *msm_dp_aux);
 bool msm_dp_aux_link_plugged(struct drm_dp_aux *msm_dp_aux);
 
+struct msm_dp_usb4_ops;
+int msm_dp_aux_usb4_set(struct drm_dp_aux *aux, struct drm_dp_aux *external,
+		      const struct msm_dp_usb4_ops *ops, void *data);
+bool msm_dp_aux_usb4_attached(struct drm_dp_aux *aux);
+void msm_dp_aux_usb4_set_hpd(struct drm_dp_aux *aux, bool connected);
+int msm_dp_aux_usb4_configure_link(struct drm_dp_aux *aux, u32 rate, u32 lanes);
+int msm_dp_aux_usb4_train_link(struct drm_dp_aux *aux, u32 rate, u32 lanes);
+bool msm_dp_aux_usb4_fec_supported(struct drm_dp_aux *aux);
+int msm_dp_aux_usb4_set_fec_ready(struct drm_dp_aux *aux, bool ready);
+void msm_dp_aux_usb4_unconfigure_link(struct drm_dp_aux *aux);
+
 struct phy;
 struct drm_dp_aux *msm_dp_aux_get(struct device *dev,
 			      struct phy *phy,
diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 1797138c0f7..a2f29975a18 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -14,6 +14,7 @@
 #include <linux/phy/phy-dp.h>
 #include <linux/pm_opp.h>
 #include <linux/rational.h>
+#include <linux/spinlock.h>
 #include <linux/string_choices.h>
 
 #include <drm/display/drm_dp_helper.h>
@@ -28,6 +29,23 @@
 #define POLLING_SLEEP_US			1000
 #define POLLING_TIMEOUT_US			10000
 
+/* Glymur: link clock source, 0 for a USB4 tunnel, 1 for the native PHY. */
+#define REG_DP_USB4_CLK_SEL		0x0f8
+#define DP_USB4_CLK_SEL_NATIVE		BIT(0)
+
+/* Glymur: cleared before USB4 training, set once the router clock is in sync. */
+#define REG_DP_USB4_POST_TRAIN		0x072c
+#define DP_USB4_POST_TRAIN_ENABLE	BIT(0)
+
+/* Glymur: second SST transfer unit bank, used by the USB4 producer. */
+#define REG_DP_TU_BANK2			0x07e0
+#define REG_DP_VALID_BOUNDARY_BANK2	0x07e4
+#define REG_DP_VALID_BOUNDARY_2_BANK2	0x07e8
+
+/* Glymur: FEC symbol sequence of the USB4 producer, eight registers. */
+#define REG_DP_USB4_FEC_SEQ(n)		(0x073c + 4 * (n))
+#define DP_CONFIGURATION_CTRL_USB4_FEC	BIT(16)
+
 #define DP_KHZ_TO_HZ 1000
 #define IDLE_PATTERN_COMPLETION_TIMEOUT_JIFFIES	(30 * HZ / 1000) /* 30 ms */
 #define PSR_OPERATION_COMPLETION_TIMEOUT_JIFFIES       (300 * HZ / 1000) /* 300 ms */
@@ -68,6 +86,14 @@
 #define DP_CTRL_INTR_READY_FOR_VIDEO     BIT(0)
 #define DP_CTRL_INTR_IDLE_PATTERN_SENT  BIT(3)
 
+/* Main link mode bits the USB4 producer needs set. */
+#define DP_USB4_MAINLINK_MODE_MASK (BIT(3) | BIT(4) | BIT(5) | BIT(30))
+
+static const u32 msm_dp_usb4_fec_seq[] = {
+	0x0100fefd, 0x55555555, 0x55555555, 0x55555555,
+	0xffffff55, 0xffffffff, 0xffffffff, 0x009cffff,
+};
+
 #define MR_LINK_TRAINING1  0x8
 #define MR_LINK_SYMBOL_ERM 0x80
 #define MR_LINK_PRBS7 0x100
@@ -127,9 +153,27 @@ struct msm_dp_ctrl_private {
 	struct clk_bulk_data *link_clks;
 
 	struct clk *pixel_clk;
+	/* USB4 DisplayPort tunneling: link clock branch feeding the router's DP IN adapter. */
+	struct clk *dpin_clk;
+	struct clk *usb4_link_clk;
+	bool usb4_link_clk_on;
+	bool dpin_clk_on;
+	bool usb4_clk_sel_saved;
+	u32 usb4_clk_sel_native;
+	bool usb4_reset_held;
+	bool usb4_mainlink_saved;
+	u32 usb4_mainlink_original;
+	u32 usb4_scrambler_reset_original;
+	bool usb4_post_train_saved;
+	u32 usb4_post_train_original;
+	bool usb4_tu_bank2_saved;
+	u32 usb4_tu_bank2_original;
+	u32 usb4_boundary_bank2_original;
+	u32 usb4_boundary2_bank2_original;
 
 	union phy_configure_opts phy_opts;
 
+	spinlock_t link_irq_lock;
 	struct completion idle_comp;
 	struct completion psr_op_comp;
 	struct completion video_comp;
@@ -255,16 +299,32 @@ static u32 msm_dp_ctrl_get_aux_interrupt(struct msm_dp_ctrl_private *ctrl)
 
 }
 
+/* Serialize the ISR acknowledgment with link-clock interrupt ownership. */
+static void msm_dp_ctrl_link_irq_mask(struct msm_dp_ctrl_private *ctrl,
+				     u32 mask, bool clear)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&ctrl->link_irq_lock, flags);
+	msm_dp_write_ahb(ctrl, REG_DP_INTR_STATUS2,
+			 mask | (clear ? DP_INTERRUPT_STATUS2_ACK : 0));
+	spin_unlock_irqrestore(&ctrl->link_irq_lock, flags);
+}
+
 static u32 msm_dp_ctrl_get_interrupt(struct msm_dp_ctrl_private *ctrl)
 {
-	u32 intr, intr_ack;
+	unsigned long flags;
+	u32 intr, intr_ack, mask;
 
+	spin_lock_irqsave(&ctrl->link_irq_lock, flags);
 	intr = msm_dp_read_ahb(ctrl, REG_DP_INTR_STATUS2);
+	mask = intr & DP_INTERRUPT_STATUS2_MASK;
 	intr &= ~DP_INTERRUPT_STATUS2_MASK;
 	intr_ack = (intr & DP_INTERRUPT_STATUS2)
 			<< DP_INTERRUPT_STATUS_ACK_SHIFT;
-	msm_dp_write_ahb(ctrl, REG_DP_INTR_STATUS2,
-		     intr_ack | DP_INTERRUPT_STATUS2_MASK);
+	/* An in-flight ISR must not re-enable a clock-stopped link. */
+	msm_dp_write_ahb(ctrl, REG_DP_INTR_STATUS2, intr_ack | mask);
+	spin_unlock_irqrestore(&ctrl->link_irq_lock, flags);
 
 	return intr;
 }
@@ -276,8 +336,9 @@ void msm_dp_ctrl_enable_irq(struct msm_dp_ctrl *msm_dp_ctrl)
 
 	msm_dp_write_ahb(ctrl, REG_DP_INTR_STATUS,
 			DP_INTERRUPT_STATUS1_MASK);
-	msm_dp_write_ahb(ctrl, REG_DP_INTR_STATUS2,
-			DP_INTERRUPT_STATUS2_MASK);
+	msm_dp_ctrl_link_irq_mask(ctrl,
+		msm_dp_aux_usb4_attached(ctrl->aux) && !ctrl->link_clks_on ?
+		0 : DP_INTERRUPT_STATUS2_MASK, false);
 }
 
 void msm_dp_ctrl_disable_irq(struct msm_dp_ctrl *msm_dp_ctrl)
@@ -286,7 +347,7 @@ void msm_dp_ctrl_disable_irq(struct msm_dp_ctrl *msm_dp_ctrl)
 		container_of(msm_dp_ctrl, struct msm_dp_ctrl_private, msm_dp_ctrl);
 
 	msm_dp_write_ahb(ctrl, REG_DP_INTR_STATUS, 0x00);
-	msm_dp_write_ahb(ctrl, REG_DP_INTR_STATUS2, 0x00);
+	msm_dp_ctrl_link_irq_mask(ctrl, 0, false);
 }
 
 static u32 msm_dp_ctrl_get_psr_interrupt(struct msm_dp_ctrl_private *ctrl)
@@ -389,12 +450,32 @@ static bool msm_dp_ctrl_mainlink_ready(struct msm_dp_ctrl_private *ctrl)
