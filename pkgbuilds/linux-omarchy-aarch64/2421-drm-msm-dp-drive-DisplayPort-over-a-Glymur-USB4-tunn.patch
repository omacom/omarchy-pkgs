+static void msm_dp_usb4_detach_locked(struct device *dev)
+{
+	struct msm_dp_display_private *dp;
+
+	if (!dev || !dev_get_drvdata(dev))
+		return;
+	dp = dev_get_dp_display_private(dev);
+	mutex_lock(&dp->usb4_lock);
+	dp->usb4_attached = false;
+	mutex_unlock(&dp->usb4_lock);
+	cancel_work_sync(&dp->usb4_hpd_work);
+	mutex_lock(&dp->usb4_lock);
+	if (msm_dp_aux_usb4_attached(dp->aux)) {
