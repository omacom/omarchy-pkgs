+/*
+ * Experimental interface between the Qualcomm Glymur USB4 host router
+ * driver, which owns a DisplayPort tunnel, and the msm DisplayPort
+ * controller that feeds it. Not a stable interface.
+ *
+ * Callbacks may sleep. They must not re-enter the MSM AUX wrapper.
+ * The caller retains aux, ops and data until detach has returned.
+ * Exported calls acquire the display device lock; callers must not hold it.
+ */
+struct msm_dp_usb4_ops {
+	int (*configure_link)(void *data, unsigned int rate, unsigned int lanes);
+	int (*train_link)(void *data, unsigned int rate, unsigned int lanes);
+	/* Prepare the sink and both tunnel adapters for FEC before training.
+	 * Must write DPCD FEC_READY and complete any required SET_FEC_READY
+	 * acknowledgment. Return an error if this is unsupported or uncertain.
+	 * Runs with the MSM AUX mutex held; must not re-enter its wrapper.
+	 */
+	int (*set_fec_ready)(void *data, bool ready);
+	void (*unconfigure_link)(void *data);
+};
