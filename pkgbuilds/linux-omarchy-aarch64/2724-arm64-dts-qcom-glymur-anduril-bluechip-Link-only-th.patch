From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: David Heinemeier Hansson <david@hey.com>
Date: Sat, 7 Nov 2026 11:30:00 +0100
Subject: [PATCH 2724] arm64: dts: qcom: glymur-anduril-bluechip: Link only the
 left speakers

The right WSA8845 pair never attaches to swr3 on this board: the bus
status register stays at 0 with gpio13 released, the bus clocked and the
amplifiers held out of runtime suspend, and their enumeration slots stay
empty. The left pair on swr0 enumerates and plays.

The CRD's playback link programs all four amplifiers as one, so every
stream fails while the absent pair can't be programmed:

  soundwire sdw-master-4-0: Program params failed: -5
  WSA Playback: ASoC error (-5): at snd_soc_link_prepare() on WSA Playback

Link the left pair alone, drop the right pair's routes and leave swr3
off until the right amplifiers' wiring is known.
---
 .../boot/dts/qcom/glymur-anduril-bluechip.dts | 28 +++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/glymur-anduril-bluechip.dts b/arch/arm64/boot/dts/qcom/glymur-anduril-bluechip.dts
--- a/arch/arm64/boot/dts/qcom/glymur-anduril-bluechip.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-anduril-bluechip.dts
@@ -17,6 +17,30 @@
 / {
 	model = "Anduril BlueChip";
 	compatible = "anduril,bluechip", "qcom,glymur";
+
+	sound {
+		/*
+		 * Only the left woofer and tweeter answer on this board. The
+		 * right pair never attaches to swr3, with its reset line
+		 * released and the bus clocked, and a link that includes it
+		 * fails every stream when the absent amplifiers can't be
+		 * programmed. Link the left pair alone until the right pair's
+		 * wiring is known.
+		 */
+		audio-routing = "WooferLeft IN", "WSA WSA_SPK1 OUT",
+				"TweeterLeft IN", "WSA WSA_SPK2 OUT",
+				"VA DMIC0", "vdd-micb",
+				"VA DMIC1", "vdd-micb",
+				"VA DMIC2", "vdd-micb",
+				"VA DMIC3", "vdd-micb";
+
+		wsa-dai-link {
+			codec {
+				sound-dai = <&left_woofer>, <&left_tweeter>,
+					    <&swr0 0>, <&lpass_wsamacro 0>;
+			};
+		};
+	};
 };
 
 &i2c8 {
@@ -80,6 +104,10 @@
 	status = "disabled";
 };
 
+&swr3 {
+	status = "disabled";
+};
+
 &tcsr {
 	vdda-qrefrpt0-0p9-supply = <&vreg_l2f_e1_0p83>;
 	vdda-qrefrpt1-0p9-supply = <&vreg_l2f_e1_0p83>;
