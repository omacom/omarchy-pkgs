From a6535f6c549fa06a26fd998b20827edce5342102 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Fri, 16 Oct 2026 16:43:06 -0500
Subject: [PATCH] soc: mediatek: power_wrap: keep DGX Spark DVFSRC policy
 unchanged

The DGX Spark exposes NVDA6210 and PLID 2, so the MT8901 check also
selects it for the N1x DVFSRC SYSRAM write. Setting that flag causes
repeatable idle resets on the Spark. With only this write omitted, the
same kernel configuration and BestPerf write remain stable.

Leave the firmware's DVFSRC policy untouched on the NVIDIA DGX Spark.
Match both DMI vendor and product exactly, so the N1x path and other
MT8901 systems retain their existing behavior. Keep the remaining
power_wrap functionality enabled.

The underlying firmware reset mechanism is not yet known.

Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/soc/mediatek/power_wrap/power_wrap.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/drivers/soc/mediatek/power_wrap/power_wrap.c b/drivers/soc/mediatek/power_wrap/power_wrap.c
index 5ee74a0..b1342be 100644
--- a/drivers/soc/mediatek/power_wrap/power_wrap.c
+++ b/drivers/soc/mediatek/power_wrap/power_wrap.c
@@ -3,6 +3,7 @@
  * Copyright (c) 2026 MediaTek Inc.
  */
 #include <linux/acpi.h>
+#include <linux/dmi.h>
 #include <linux/init.h>
 #include <linux/io.h>
 #include <linux/miscdevice.h>
@@ -600,6 +601,13 @@ static void pwrap_write_dvfsrc_flag(struct device *dev)
 {
 	void __iomem *vaddr;
 
+	/* The DGX Spark resets at idle when this firmware flag is set. */
+	if (dmi_match(DMI_SYS_VENDOR, "NVIDIA") &&
+	    dmi_match(DMI_PRODUCT_NAME, "NVIDIA_DGX_Spark")) {
+		dev_info(dev, "DVFSRC: leaving firmware policy unchanged on DGX Spark\n");
+		return;
+	}
+
 	vaddr = ioremap(PWRAP_DVFSRC_FLAG_ADDR, PWRAP_DVFSRC_FLAG_LEN);
 	if (!vaddr) {
 		dev_warn(dev,
-- 
2.56.0

