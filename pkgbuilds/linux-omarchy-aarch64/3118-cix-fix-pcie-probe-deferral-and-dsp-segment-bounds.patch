From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Clay Stan <claystan97@gmail.com>
Date: Wed, 25 Nov 2026 17:50:16 +0800
Subject: [PATCH] cix: preserve Sky1 PCIe probe deferral and bounds-check DSP
 ELF segments

Fix two driver bugs in the vendor Sky1 PCIe and DSP remoteproc drivers:

- pci-sky1-cix: return errors (including -EPROBE_DEFER) directly from
  sky1_pcie_parse_clocks(), sky1_pcie_parse_ep_pwr_supply(),
  devm_phy_ref_get(), sky1_pcie_parse_property(), and sky1_pcie_en_ep_power()
  instead of overwriting them with -EINVAL or 0, release fwnode/devres handles
  when the PCIe PHY provider has not bound yet, and initialize debugfs only
  after property/supplier lookup succeeds (with an err_debugfs unwind label)
  so deferred probes do not leave dangling debugfs entries.
- cix_dsp_rproc: check ELF segment offsets and lengths against the remaining
  region size using subtraction in cix_dsp_rproc_da_to_sa(),
  cix_dsp_rproc_da_to_va(), and cix_dsp_rproc_elf_load_segments() so large
  64-bit segment sizes cannot wrap around da + len or offset + filesz.

Signed-off-by: Clay Stan <claystan97@gmail.com>
---
 drivers/pci/controller/cadence/pci-sky1-cix.c | 86 ++++++++++++-------
 drivers/remoteproc/cix_dsp_rproc.c            | 36 ++++----
 2 files changed, 77 insertions(+), 45 deletions(-)

diff --git a/drivers/pci/controller/cadence/pci-sky1-cix.c b/drivers/pci/controller/cadence/pci-sky1-cix.c
index cb54ee9..9c02fdf 100644
--- a/drivers/pci/controller/cadence/pci-sky1-cix.c
+++ b/drivers/pci/controller/cadence/pci-sky1-cix.c
@@ -1262,26 +1262,24 @@ static int sky1_pcie_parse_clocks(struct sky1_pcie *pcie)
 
 			axi_clk = clk_get_sys(adev_id, "axi_clk");
 			if (IS_ERR(axi_clk)) {
-				ret = PTR_ERR(axi_clk);
 				dev_err(dev, "Failed to get axi_clk\n");
-			} else {
-				ret = devm_add_action_or_reset(dev, sky1_pcie_clk_release,
-							       axi_clk);
-				if (ret)
-					return ret;
+				return PTR_ERR(axi_clk);
 			}
+			ret = devm_add_action_or_reset(dev, sky1_pcie_clk_release,
+						       axi_clk);
+			if (ret)
+				return ret;
 			pcie->pcie_axi_clk = axi_clk;
 
 			apb_clk = clk_get_sys(adev_id, "apb_clk");
 			if (IS_ERR(apb_clk)) {
-				ret = PTR_ERR(apb_clk);
 				dev_err(dev, "Failed to get apb_clk\n");
-			} else {
-				ret = devm_add_action_or_reset(dev, sky1_pcie_clk_release,
-							       apb_clk);
-				if (ret)
-					return ret;
+				return PTR_ERR(apb_clk);
 			}
+			ret = devm_add_action_or_reset(dev, sky1_pcie_clk_release,
+						       apb_clk);
+			if (ret)
+				return ret;
 			pcie->pcie_apb_clk = apb_clk;
 
 			refclk = clk_get_sys(adev_id, "refclk_b");
@@ -1289,8 +1287,8 @@ static int sky1_pcie_parse_clocks(struct sky1_pcie *pcie)
 				if (PTR_ERR(refclk) == -ENOENT) {
 					refclk = NULL;
 				} else {
-					ret = PTR_ERR(refclk);
 					dev_err(dev, "failed to get refclk_b\n");
+					return PTR_ERR(refclk);
 				}
 			} else {
 				ret = devm_add_action_or_reset(dev, sky1_pcie_clk_release,
@@ -1307,15 +1305,15 @@ static int sky1_pcie_parse_clocks(struct sky1_pcie *pcie)
 
 	axi_clk = devm_clk_get(dev, "axi_clk");
 	if (IS_ERR(axi_clk)) {
-		ret = PTR_ERR(axi_clk);
 		dev_err(dev, "Failed to get axi_clk\n");
+		return PTR_ERR(axi_clk);
 	}
 	pcie->pcie_axi_clk = axi_clk;
 
 	apb_clk = devm_clk_get(dev, "apb_clk");
 	if (IS_ERR(apb_clk)) {
-		ret = PTR_ERR(apb_clk);
 		dev_err(dev, "Failed to get apb_clk\n");
+		return PTR_ERR(apb_clk);
 	}
 	pcie->pcie_apb_clk = apb_clk;
 
@@ -1339,8 +1337,8 @@ static int sky1_pcie_parse_clocks(struct sky1_pcie *pcie)
 				if (PTR_ERR(refclk) == -ENOENT) {
 					refclk = NULL;
 				} else {
-					ret = PTR_ERR(refclk);
 					dev_err(dev, "failed to get refclk_b\n");
+					return PTR_ERR(refclk);
 				}
 			} else {
 				ret = devm_add_action_or_reset(dev, sky1_pcie_clk_release,
@@ -1351,16 +1349,16 @@ static int sky1_pcie_parse_clocks(struct sky1_pcie *pcie)
 		} else {
 			refclk = devm_clk_get_optional(dev, "refclk_b");
 			if (IS_ERR(refclk)) {
-				ret = PTR_ERR(refclk);
 				dev_err(dev, "failed to get refclk_b\n");
+				return PTR_ERR(refclk);
 			}
 		}
 	}
 #else
 	refclk = devm_clk_get_optional(dev, "refclk_b");
 	if (IS_ERR(refclk)) {
-		ret = PTR_ERR(refclk);
 		dev_err(dev, "failed to get refclk_b\n");
+		return PTR_ERR(refclk);
 	}
 #endif
 	pcie->pcie_refclk_b = refclk;
@@ -1382,7 +1380,7 @@ static int sky1_pcie_parse_plat(struct sky1_pcie *pcie)
 	return ret;
 }
 
-static void sky1_pcie_parse_ep_pwr_supply(struct sky1_pcie *pcie)
+static int sky1_pcie_parse_ep_pwr_supply(struct sky1_pcie *pcie)
 {
 	struct device *dev = pcie->dev;
 
@@ -1392,15 +1390,21 @@ static void sky1_pcie_parse_ep_pwr_supply(struct sky1_pcie *pcie)
 	/* optional power control for device */
 	pcie->vsupply = devm_regulator_get_optional(dev, "vcc-pcie");
 	if (IS_ERR(pcie->vsupply)) {
+		if (PTR_ERR(pcie->vsupply) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
 		dev_info(dev, "no vcc-pcie regulator found\n");
 		pcie->vsupply = NULL;
 	}
 
 	pcie->epsupply = devm_regulator_get_optional(dev, "wlan-en");
 	if (IS_ERR(pcie->epsupply)) {
+		if (PTR_ERR(pcie->epsupply) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
 		dev_info(dev, "no wlan-en regulator found\n");
 		pcie->epsupply = NULL;
 	}
+
+	return 0;
 }
 
 static int sky1_pcie_parse_reset_gpio(struct sky1_pcie *pcie)
@@ -1580,21 +1584,39 @@ static void devm_phy_release(struct device *dev, void *res)
 static struct phy *devm_phy_ref_get(struct device *dev,
 			const char *string)
 {
+	struct fwnode_handle *fwnode, *parent;
 	struct phy **ptr, *phy;
-	struct fwnode_handle *fwnode;
 	struct device *rdev;
 
 	fwnode = fwnode_find_reference(dev_fwnode(dev), string, 0);
 	if (IS_ERR_OR_NULL(fwnode))
 		return NULL;
 
+	parent = fwnode_get_parent(fwnode);
+	if (!parent) {
+		fwnode_handle_put(fwnode);
+		return ERR_PTR(-ENODEV);
+	}
+	if (!fwnode_device_is_available(parent)) {
+		fwnode_handle_put(parent);
+		fwnode_handle_put(fwnode);
+		return ERR_PTR(-ENODEV);
+	}
+
+	rdev = get_dev_from_fwnode(parent);
+	fwnode_handle_put(parent);
+	if (IS_ERR_OR_NULL(rdev)) {
+		fwnode_handle_put(fwnode);
+		return ERR_PTR(-EPROBE_DEFER);
+	}
+
 	ptr = devres_alloc(devm_phy_release, sizeof(*ptr), GFP_KERNEL);
-	if (!ptr)
+	if (!ptr) {
+		put_device(rdev);
+		fwnode_handle_put(fwnode);
 		return ERR_PTR(-ENOMEM);
+	}
 
-	rdev = get_dev_from_fwnode(fwnode_get_parent(fwnode));
-	if (IS_ERR_OR_NULL(rdev))
-		return NULL;
 	phy = phy_get(rdev, fwnode_get_name(fwnode));
 	if (!IS_ERR(phy)) {
 		*ptr = phy;
@@ -1603,6 +1625,7 @@ static struct phy *devm_phy_ref_get(struct device *dev,
 		devres_free(ptr);
 	}
 	put_device(rdev);
+	fwnode_handle_put(fwnode);
 
 	return phy;
 }
@@ -1612,7 +1635,9 @@ static int sky1_pcie_parse_property(struct platform_device *pdev,
 {
 	int ret = 0;
 
-	sky1_pcie_parse_ep_pwr_supply(pcie);
+	ret = sky1_pcie_parse_ep_pwr_supply(pcie);
+	if (ret < 0)
+		return ret;
 	ret = sky1_pcie_parse_plat(pcie);
 	if (ret < 0)
 		return ret;
@@ -1655,7 +1680,7 @@ static int sky1_pcie_parse_property(struct platform_device *pdev,
 		return ret;
 
 	pcie->pcie_phy = devm_phy_get(pcie->dev, "cdns,pcie-phy");
-	if (IS_ERR(pcie->pcie_phy))
+	if (IS_ERR(pcie->pcie_phy) && PTR_ERR(pcie->pcie_phy) != -EPROBE_DEFER)
 		pcie->pcie_phy = devm_phy_ref_get(pcie->dev, "cdns,pcie-phy");
 
 	if (IS_ERR(pcie->pcie_phy)) {
@@ -2434,8 +2459,6 @@ static int sky1_pcie_probe(struct platform_device *pdev)
 		}
 	}
 
-	sky1_pcie_debugfs_init(pcie);
-
 	if (!ACPI_COMPANION(dev))
 		bridge = devm_pci_alloc_host_bridge(dev, sizeof(*rc));
 	else
@@ -2449,11 +2472,13 @@ static int sky1_pcie_probe(struct platform_device *pdev)
 
 	ret = sky1_pcie_parse_property(pdev, pcie);
 	if (ret < 0)
-		return -EINVAL;
+		return ret;
+
+	sky1_pcie_debugfs_init(pcie);
 
 	ret = sky1_pcie_en_ep_power(pcie, true);
 	if (ret < 0)
-		return -EINVAL;
+		goto err_debugfs;
 
 	ret = sky1_pcie_en_ep_on(pcie, true);
 	if (ret < 0)
@@ -2536,6 +2561,7 @@ err_epsupply:
 	sky1_pcie_reset_ep_assert(pcie);
 err_vsupply_3v3:
 	sky1_pcie_en_ep_power(pcie, false);
+err_debugfs:
 	sky1_pcie_debugfs_exit(pcie);
 	return ret;
 }
diff --git a/drivers/remoteproc/cix_dsp_rproc.c b/drivers/remoteproc/cix_dsp_rproc.c
index bcc7770..22808db 100644
--- a/drivers/remoteproc/cix_dsp_rproc.c
+++ b/drivers/remoteproc/cix_dsp_rproc.c
@@ -178,13 +178,16 @@ static int cix_dsp_rproc_da_to_sa(struct cix_dsp_rproc *rproc_priv, u64 da, size
 	int i;
 
 	for (i = 0; i < CIX_MEM_REG_NUM; i++) {
-		if (da >= mem_reg[i].da
-		    && da + len <= mem_reg[i].da + mem_reg[i].len) {
-			unsigned int offset = da - mem_reg[i].da;
+		u64 offset;
 
-			*sa = mem_reg[i].sa + offset;
-			return 0;
-		}
+		if (da < mem_reg[i].da)
+			continue;
+		offset = da - mem_reg[i].da;
+		if (offset > mem_reg[i].len || len > mem_reg[i].len - offset)
+			continue;
+
+		*sa = mem_reg[i].sa + offset;
+		return 0;
 	}
 
 	return -ENOENT;
@@ -501,13 +504,16 @@ static void *cix_dsp_rproc_da_to_va(struct rproc *rproc, u64 da, size_t len, boo
 		return NULL;
 
 	for (i = 0; i < priv->num_mem; i++) {
-		if (pa >= priv->mem[i].bus_addr
-		    && pa + len <= priv->mem[i].bus_addr +  priv->mem[i].size) {
-			unsigned int offset = pa - priv->mem[i].bus_addr;
+		u64 offset;
 
-			va = priv->mem[i].cpu_addr + offset;
-			break;
-		}
+		if (pa < priv->mem[i].bus_addr)
+			continue;
+		offset = pa - priv->mem[i].bus_addr;
+		if (offset > priv->mem[i].size || len > priv->mem[i].size - offset)
+			continue;
+
+		va = priv->mem[i].cpu_addr + offset;
+		break;
 	}
 
 	dev_dbg(priv->dev, "da = 0x%llx len = 0x%zx va = 0x%px\n",
@@ -564,9 +570,9 @@ static int cix_dsp_rproc_elf_load_segments(struct rproc *rproc, const struct fir
 			break;
 		}
 
-		if (offset + filesz > fw->size) {
-			dev_err(dev, "truncated fw: need 0x%llx avail 0x%zx\n",
-				offset + filesz, fw->size);
+		if (offset > fw->size || filesz > fw->size - offset) {
+			dev_err(dev, "truncated fw: offset 0x%llx filesz 0x%llx avail 0x%zx\n",
+				offset, filesz, fw->size);
 			ret = -EINVAL;
 			break;
 		}
