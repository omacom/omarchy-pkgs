 drivers/thunderbolt/qcom-usb4-irq.h |  76 ++++++++
 drivers/thunderbolt/qcom-usb4-nhi.c | 269 ++++++++++++++++++++++++++++
 drivers/thunderbolt/qcom-usb4-nhi.h |  78 ++++++++
 4 files changed, 554 insertions(+)
