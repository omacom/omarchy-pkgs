From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Sat, 7 Nov 2026 10:22:55 +0100
Subject: [PATCH] dt-bindings: arm: qcom: Add the HP OmniBook 3 14 and 16

The HP OmniBook 3 Laptop 14-hz0xxx and 16-bz0xxx are built on the
Snapdragon X X1-26-100. Add their compatibles to the X1-26-100 boards.

Signed-off-by: Birk Skyum <birk.skyum@pm.me>
---
 Documentation/devicetree/bindings/arm/qcom.yaml | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Documentation/devicetree/bindings/arm/qcom.yaml b/Documentation/devicetree/bindings/arm/qcom.yaml
index fe85174..8bd45e0 100644
--- a/Documentation/devicetree/bindings/arm/qcom.yaml
+++ b/Documentation/devicetree/bindings/arm/qcom.yaml
@@ -1285,6 +1285,8 @@ properties:
       - items:
           - enum:
               - asus,vivobook-x16
+              - hp,omnibook-3-16-bz0
+              - hp,omnibook-3-oled
               - lenovo,ideapad-slim3
           - const: qcom,x126100
           - const: qcom,x1p42100
-- 
2.56.0

