From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 8 Oct 2026 13:46:58 -0500
Subject: [PATCH] drm/msm/dp: keep retrying link training while a Type-C sink
 is plugged

When link training fails, msm_dp_ctrl_on_link() lowers the link rate or
lane count and tries again, but first gives up if
msm_dp_aux_is_link_connected() reports the sink gone. That reads the
controller's own HPD block. On USB-C ports HPD arrives through the
aux-hpd-bridge (drm_aux_hpd_bridge_notify()) instead, and the
controller's HPD status stays at zero for as long as the sink is
attached. The check therefore ends the retry loop after the first
failure on every Type-C DP port, and the rate and lane fallback never
runs.

Add msm_dp_aux_link_plugged(), which also accepts the software plug
state that the display code keeps in enable_xfers on external DP ports.
That state is set when the HPD source reports the sink and cleared when
it reports it gone, so a real unplug still ends the loop. eDP keeps the
hardware HPD check.

Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/gpu/drm/msm/dp/dp_aux.c  | 19 +++++++++++++++++++
 drivers/gpu/drm/msm/dp/dp_aux.h  |  1 +
 drivers/gpu/drm/msm/dp/dp_ctrl.c |  4 ++--
 3 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_aux.c b/drivers/gpu/drm/msm/dp/dp_aux.c
index 914c1f15926..f39ea58b9f2 100644
--- a/drivers/gpu/drm/msm/dp/dp_aux.c
+++ b/drivers/gpu/drm/msm/dp/dp_aux.c
@@ -516,6 +516,25 @@ irqreturn_t msm_dp_aux_isr(struct drm_dp_aux *msm_dp_aux, u32 isr)
 	return IRQ_HANDLED;
 }
 
+/*
+ * Whether the sink is still plugged for the purpose of retrying link
+ * training.  On ports where hot-plug arrives through a Type-C bridge rather
+ * than the controller's HPD pin the hardware HPD status stays at zero, so
+ * also honour the software plug state the display code keeps in
+ * enable_xfers.
+ */
+bool msm_dp_aux_link_plugged(struct drm_dp_aux *msm_dp_aux)
+{
+	struct msm_dp_aux_private *aux;
+
+	aux = container_of(msm_dp_aux, struct msm_dp_aux_private, msm_dp_aux);
+
+	if (msm_dp_aux_is_link_connected(msm_dp_aux))
+		return true;
+
+	return !aux->is_edp && aux->enable_xfers;
+}
+
 void msm_dp_aux_enable_xfers(struct drm_dp_aux *msm_dp_aux, bool enabled)
 {
 	struct msm_dp_aux_private *aux;
diff --git a/drivers/gpu/drm/msm/dp/dp_aux.h b/drivers/gpu/drm/msm/dp/dp_aux.h
index 4be02e8b4d0..98625c9b9a0 100644
--- a/drivers/gpu/drm/msm/dp/dp_aux.h
+++ b/drivers/gpu/drm/msm/dp/dp_aux.h
@@ -22,6 +22,7 @@ void msm_dp_aux_hpd_intr_enable(struct drm_dp_aux *msm_dp_aux);
 void msm_dp_aux_hpd_intr_disable(struct drm_dp_aux *msm_dp_aux);
 u32 msm_dp_aux_get_hpd_intr_status(struct drm_dp_aux *msm_dp_aux);
 u32 msm_dp_aux_is_link_connected(struct drm_dp_aux *msm_dp_aux);
+bool msm_dp_aux_link_plugged(struct drm_dp_aux *msm_dp_aux);
 
 struct phy;
 struct drm_dp_aux *msm_dp_aux_get(struct device *dev,
diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 92e395ac686..8e984c62027 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -2409,7 +2409,7 @@ int msm_dp_ctrl_on_link(struct msm_dp_ctrl *msm_dp_ctrl,
 			break;
 		} else if (training_step == DP_TRAINING_1) {
 			/* link train_1 failed */
-			if (!msm_dp_aux_is_link_connected(ctrl->aux))
+			if (!msm_dp_aux_link_plugged(ctrl->aux))
 				break;
 
 			drm_dp_dpcd_read_link_status(ctrl->aux, link_status);
@@ -2434,7 +2434,7 @@ int msm_dp_ctrl_on_link(struct msm_dp_ctrl *msm_dp_ctrl,
 			}
 		} else if (training_step == DP_TRAINING_2) {
 			/* link train_2 failed */
-			if (!msm_dp_aux_is_link_connected(ctrl->aux))
+			if (!msm_dp_aux_link_plugged(ctrl->aux))
 				break;
 
 			drm_dp_dpcd_read_link_status(ctrl->aux, link_status);
-- 
