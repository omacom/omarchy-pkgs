+/*
+ * glymur.dtsi enables the Adreno GPU, its GMU, clock controllers and SMMU
+ * by default. msm binds an available GPU into the same DRM device as the
+ * display, so a GPU that fails to come up would also take the panel down.
+ * The GPU block stays off here; the daily .dts turns it on (proven from
+ * kernel -5, which builds CLK_GLYMUR_GPUCC: gpucc-glymur, gxclkctl) and
+ * the -minimal fallback turns it off again.
+ */
+&gpu {
+	status = "disabled";
+};
+
+&gmu {
+	status = "disabled";
+};
+
+&gpucc {
+	status = "disabled";
+};
+
+&gxclkctl {
+	status = "disabled";
+};
+
+&adreno_smmu {
+	status = "disabled";
+};
