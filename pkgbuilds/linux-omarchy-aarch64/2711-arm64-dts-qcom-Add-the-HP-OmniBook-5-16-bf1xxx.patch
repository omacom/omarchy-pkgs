+/*
+ * HP UR15 (QUP_1_SE_6, 4-wire; UART pins 56-59 per HP's
+ * BSRC_UART_4Wire_1.bin): QCC2072 Bluetooth (BTH0, QCOM0F6B). Windows runs
+ * it at 3.2 Mbaud (qcbluetooth8480.inf BaudRate). BTH0's GpioIo is GPIO
+ * 116, the Bluetooth enable (bt-enable on the Glymur/Mahua CRD too). With
+ * enable-gpios, hci_qca drives BT_EN itself and needs no regulators for
+ * QCC2072.
+ */
+&uart14 {
+	status = "okay";
+
+	bluetooth {
+		compatible = "qcom,qcc2072-bt";
+		enable-gpios = <&tlmm 116 GPIO_ACTIVE_HIGH>;
+		max-speed = <3200000>;
+	};
+};
