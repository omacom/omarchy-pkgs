From 38a5ab0d26e68b601181b47633e4d23ba1895da6 Mon Sep 17 00:00:00 2001
From: Ryan Hughes <ryan@heyoodle.com>
Date: Tue, 6 Oct 2026 21:16:45 -0400
Subject: [PATCH] displayport: retrain the link after the sink was unplugged

When a DisplayPort sink comes back after an unplug while its head is still
attached, trainLinkOptimized() skips link training if the active link
configuration matches and the link status still reads as trained
("Skipping redundant LT from RM"). The sink lost the link when it was
unplugged, so it then gets no usable stream and stays black.

On the NVIDIA N1x this happens with every monitor behind a USB4 dock: when
the dock is replugged, or a monitor drops HPD while it wakes, the
connection manager tears the DisplayPort tunnel down and builds a new one.
The link status reads as trained through the new tunnel, nvkms skips link
training, and the monitor stays black while the desktop still treats it
as connected.

Remember that the sink was unplugged, and do not skip link training until
the link has been trained again.
---
 src/common/displayport/inc/dp_connectorimpl.h   | 7 +++++++
 src/common/displayport/src/dp_connectorimpl.cpp | 4 ++++
 2 files changed, 11 insertions(+)

diff --git a/src/common/displayport/inc/dp_connectorimpl.h b/src/common/displayport/inc/dp_connectorimpl.h
index e2b741c..0232e56 100644
--- a/src/common/displayport/inc/dp_connectorimpl.h
+++ b/src/common/displayport/inc/dp_connectorimpl.h
@@ -331,6 +331,13 @@ namespace DisplayPort
 
         bool        bSwAutoReadWarActive;
 
+        //
+        // The sink was unplugged since the link was last trained. Its receiver
+        // lost the link, although the link status can still read as trained,
+        // e.g. through a USB4 DP tunnel that was rebuilt in the meantime.
+        //
+        bool        bRetrainAfterUnplug;
+
         // Force max link config during mode-set for DP compliance testing devices
         bool        bForceMaxLinkConfig;
 
diff --git a/src/common/displayport/src/dp_connectorimpl.cpp b/src/common/displayport/src/dp_connectorimpl.cpp
index 62eb0f7..5f10a91 100644
--- a/src/common/displayport/src/dp_connectorimpl.cpp
+++ b/src/common/displayport/src/dp_connectorimpl.cpp
@@ -125,6 +125,7 @@ ConnectorImpl::ConnectorImpl(MainLink * main, AuxBus * auxBus, Timer * timer, Co
       bDelayAfterD3(false),
       bKeepOptLinkAlive(false),
       bSwAutoReadWarActive(false),
+      bRetrainAfterUnplug(false),
       bForceMaxLinkConfig(false),
       bNoFallbackInPostLQA(false),
       bIsEncryptionQseValid(true),
@@ -6622,6 +6623,7 @@ bool ConnectorImpl::trainLinkOptimized(LinkConfiguration lConfig)
             //
             hal->setDirtyLinkStatus(true);
             if ((activeLinkConfig == lowestSelected) &&
+                (!bRetrainAfterUnplug) &&
                 (!isLinkInD3()) &&
                 (!isLinkLost()) &&
                 (this->bFECEnable == activeLinkConfig.bEnableFEC) &&
@@ -6730,6 +6732,7 @@ bool ConnectorImpl::trainLinkOptimized(LinkConfiguration lConfig)
 
         // In case this was set, we should reset it to prevent skipping LT next time.
         bSkipLt = false;
+        bRetrainAfterUnplug = false;
     }
     else
     {
@@ -8992,6 +8995,7 @@ void ConnectorImpl::notifyLongPulseUnplug()
 
     main->setDpWarFlag(NV0073_CTRL_DP_WAR_SW_AUTO_READ_ENABLE, false);
     bSwAutoReadWarActive = false;
+    bRetrainAfterUnplug = true;
 
     LinkConfiguration linkConfig = getActiveLinkConfig();
     cancelHdcpCallbacks();
