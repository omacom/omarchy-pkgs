From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Wed, 28 Oct 2026 01:00:00 -0500
Subject: [PATCH] thunderbolt: qcom: Build the Glymur USB4 drivers as their own
 module

The Qualcomm USB4 host router and DP IN drivers were linked into
thunderbolt.ko and registered from its module init. That gave
thunderbolt.ko hard dependencies on msm, gcc-glymur and qcom_smem, so
every machine that loads thunderbolt for its own host interface, such
as the NVIDIA N1x laptops through thunderbolt_platform, also loaded the
Qualcomm display and SoC drivers. It also required the Type-C core to
be built in, because the Type-C port mapper calls into thunderbolt.ko
and thunderbolt.ko then called into typec.ko.

Build the drivers as thunderbolt_qcom.ko, as thunderbolt_platform.ko
is built for the ACPI host interfaces, and register them from its own
module init. Export nhi_handle_interrupt() in the THUNDERBOLT_NHI
namespace for it. thunderbolt.ko no longer depends on any Qualcomm
module, and USB4_QCOM depends on the Type-C core as a module.

Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/thunderbolt/Kconfig          | 15 +++++++-------
 drivers/thunderbolt/Makefile         |  3 ++-
 drivers/thunderbolt/nhi.c            |  1 +
 drivers/thunderbolt/nhi.h            |  6 ------
 drivers/thunderbolt/pci.c            | 21 --------------------
 drivers/thunderbolt/qcom-usb4-host.c | 29 +++++++++++++++++++++++++++-
 6 files changed, 38 insertions(+), 37 deletions(-)

diff --git a/drivers/thunderbolt/Kconfig b/drivers/thunderbolt/Kconfig
index ffa567c7e58..f515be29b3a 100644
--- a/drivers/thunderbolt/Kconfig
+++ b/drivers/thunderbolt/Kconfig
@@ -87,13 +87,13 @@ config USB4_STREAM
 	  called thunderbolt_stream.
 
 config USB4_QCOM
-	bool "Qualcomm Glymur USB4 host router (experimental)"
+	tristate "Qualcomm Glymur USB4 host router (experimental)"
 	depends on OF && PINCTRL && MFD_SYSCON
 	depends on ARCH_QCOM || COMPILE_TEST
-	depends on QCOM_SMEM=y || QCOM_SMEM=USB4
-	depends on CLK_GLYMUR_GCC=y || CLK_GLYMUR_GCC=USB4
-	depends on DRM_MSM=y || DRM_MSM=USB4
-	depends on TYPEC=y
+	depends on QCOM_SMEM
+	depends on CLK_GLYMUR_GCC
+	depends on DRM_MSM
+	depends on TYPEC
 	select DRM_DISPLAY_HELPER
 	help
 	  Platform driver for the USB4 host router of Qualcomm Glymur
@@ -106,8 +106,7 @@ config USB4_QCOM
 	  (retimer, preset) are those of the Surface Laptop 8, and it has
 	  been tested only on that machine.
 
-	  The Type-C core must be built in: its port mapper calls into
-	  thunderbolt.ko, so with both as modules each would depend on the
-	  other.
+	  To compile this driver a module, choose M here. The module will be
+	  called thunderbolt_qcom.
 
 endif # USB4
diff --git a/drivers/thunderbolt/Makefile b/drivers/thunderbolt/Makefile
index ffc3c358cb0..bd3312cb1fe 100644
--- a/drivers/thunderbolt/Makefile
+++ b/drivers/thunderbolt/Makefile
@@ -20,6 +20,7 @@ obj-$(CONFIG_USB4_DMA_TEST) += thunderbolt_dma_test.o
 thunderbolt_stream-${CONFIG_USB4_STREAM} += stream.o
 obj-$(CONFIG_USB4_STREAM) += thunderbolt_stream.o
 
-thunderbolt-$(CONFIG_USB4_QCOM) += qcom-usb4-fw.o qcom-usb4-drom.o qcom-usb4-mcu.o \
+thunderbolt_qcom-y := qcom-usb4-fw.o qcom-usb4-drom.o qcom-usb4-mcu.o \
 	qcom-usb4-typec.o qcom-usb4-irq.o qcom-usb4-nhi.o qcom-usb4-startup.o \
 	qcom-usb4-events.o qcom-usb4-host.o qcom-usb4-dp.o qcom-usb4-dp-link.o
+obj-$(CONFIG_USB4_QCOM) += thunderbolt_qcom.o
diff --git a/drivers/thunderbolt/nhi.c b/drivers/thunderbolt/nhi.c
index 38a16134e9a..4164b2c61d1 100644
--- a/drivers/thunderbolt/nhi.c
+++ b/drivers/thunderbolt/nhi.c
@@ -1002,6 +1002,7 @@ bool nhi_handle_interrupt(struct tb_nhi *nhi, unsigned int cause)
 
 	return rearm;
 }
+EXPORT_SYMBOL_NS_GPL(nhi_handle_interrupt, "THUNDERBOLT_NHI");
 
 /**
  * nhi_handle_interrupts() - Service pending standard ring notifications
diff --git a/drivers/thunderbolt/nhi.h b/drivers/thunderbolt/nhi.h
index 682612c0c69..d083d0487ed 100644
--- a/drivers/thunderbolt/nhi.h
+++ b/drivers/thunderbolt/nhi.h
@@ -46,12 +46,6 @@ void nhi_remove(struct tb_nhi *nhi);
 void nhi_shutdown(struct tb_nhi *nhi);
 extern const struct dev_pm_ops nhi_pm_ops;
 
-#if IS_ENABLED(CONFIG_USB4_QCOM)
-struct platform_driver;
-extern struct platform_driver qcom_usb4_host_driver;
-extern struct platform_driver qcom_usb4_dp_driver;
-#endif
-
 /**
  * struct tb_nhi_ops - NHI specific optional operations
  * @init: NHI specific initialization
diff --git a/drivers/thunderbolt/pci.c b/drivers/thunderbolt/pci.c
index 73e08223cbe..3a462bdf9ac 100644
--- a/drivers/thunderbolt/pci.c
+++ b/drivers/thunderbolt/pci.c
@@ -14,7 +14,6 @@
 #include <linux/interrupt.h>
 #include <linux/iommu.h>
 #include <linux/module.h>
-#include <linux/platform_device.h>
 #include <linux/delay.h>
 #include <linux/property.h>
 #include <linux/string_helpers.h>
@@ -626,31 +625,11 @@ static int __init nhi_init(void)
 		return ret;
 	}
 
-#if IS_ENABLED(CONFIG_USB4_QCOM)
-	ret = platform_driver_register(&qcom_usb4_dp_driver);
-	if (ret) {
-		pci_unregister_driver(&nhi_driver);
-		tb_domain_exit();
-		return ret;
-	}
-	ret = platform_driver_register(&qcom_usb4_host_driver);
-	if (ret) {
-		platform_driver_unregister(&qcom_usb4_dp_driver);
-		pci_unregister_driver(&nhi_driver);
-		tb_domain_exit();
-		return ret;
-	}
-#endif
-
 	return 0;
 }
 
 static void __exit nhi_unload(void)
 {
-#if IS_ENABLED(CONFIG_USB4_QCOM)
-	platform_driver_unregister(&qcom_usb4_host_driver);
-	platform_driver_unregister(&qcom_usb4_dp_driver);
-#endif
 	pci_unregister_driver(&nhi_driver);
 	tb_domain_exit();
 }
diff --git a/drivers/thunderbolt/qcom-usb4-host.c b/drivers/thunderbolt/qcom-usb4-host.c
index 69ad6de975b..8eb4c32120c 100644
--- a/drivers/thunderbolt/qcom-usb4-host.c
+++ b/drivers/thunderbolt/qcom-usb4-host.c
@@ -1703,7 +1703,7 @@ MODULE_DEVICE_TABLE(of, qcom_usb4_host_of_match);
 /* Router image named by the Surface Laptop 8 device tree, for initramfs tools. */
 MODULE_FIRMWARE("qcom/glymur/surface-laptop8/usb4-router-legacy.bin");
 
-struct platform_driver qcom_usb4_host_driver = {
+static struct platform_driver qcom_usb4_host_driver = {
 	.probe = qcom_usb4_host_probe,
 	.remove = qcom_usb4_host_remove,
 	.shutdown = qcom_usb4_host_shutdown,
@@ -1719,3 +1719,30 @@ struct platform_driver qcom_usb4_host_driver = {
 		/* Type-C requests may arrive before startup; do not probe asynchronously. */
 	},
 };
+
+static int __init qcom_usb4_init(void)
+{
+	int ret;
+
+	ret = platform_driver_register(&qcom_usb4_dp_driver);
+	if (ret)
+		return ret;
+
+	ret = platform_driver_register(&qcom_usb4_host_driver);
+	if (ret)
+		platform_driver_unregister(&qcom_usb4_dp_driver);
+
+	return ret;
+}
+module_init(qcom_usb4_init);
+
+static void __exit qcom_usb4_exit(void)
+{
+	platform_driver_unregister(&qcom_usb4_host_driver);
+	platform_driver_unregister(&qcom_usb4_dp_driver);
+}
+module_exit(qcom_usb4_exit);
+
+MODULE_IMPORT_NS("THUNDERBOLT_NHI");
+MODULE_DESCRIPTION("Qualcomm Glymur USB4 host router");
+MODULE_LICENSE("GPL");
-- 
2.56.0

