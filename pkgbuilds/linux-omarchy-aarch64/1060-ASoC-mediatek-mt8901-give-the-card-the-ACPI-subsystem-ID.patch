From 5e6a8e19f42f542767f2e4c58490e0829adadb81 Mon Sep 17 00:00:00 2001
From: Ryan Hughes <ryan@heyoodle.com>
Date: Fri, 2 Oct 2026 14:11:18 -0400
Subject: [PATCH] ASoC: mediatek: mt8901: give the card the ACPI subsystem ID

Cirrus CS35L56 amplifiers name their DSP firmware and speaker tuning
after the sound card's PCI subsystem ID. Intel and AMD SoundWire machine
drivers take it from the audio controller's PCI device; the MT8901 card
has none, so the amplifiers never looked for their tuning and ran on ROM
defaults: quiet, and without the speaker voicing.

The N1x firmware gives the ID as the SoundWire controller's _SUB,
written like Windows' SUBSYS value (device ID, then vendor ID:
"33A11043" on the ASUS ProArt P14). Read it when the machine is
selected and pass it to the card, as AMD's SoundWire driver does, so
the amplifiers request cs35l56-b0-dsp1-misc-104333a1*.
---
 drivers/soundwire/mediatek/mtk-sdw-mach.c     | 26 +++++++++++++++++++
 .../mt8901/mt8901-acp-sdw-legacy-mach.c       |  4 +++
 2 files changed, 30 insertions(+)

diff --git a/drivers/soundwire/mediatek/mtk-sdw-mach.c b/drivers/soundwire/mediatek/mtk-sdw-mach.c
index 2d7c240344..00054b2af7 100644
--- a/drivers/soundwire/mediatek/mtk-sdw-mach.c
+++ b/drivers/soundwire/mediatek/mtk-sdw-mach.c
@@ -5,6 +5,8 @@
  * Copyright (c) 2026 MediaTek Inc.
  * Author: Trevor Wu <trevor.wu@mediatek.com>
  */
+#include <linux/acpi.h>
+#include <linux/kernel.h>
 #include <linux/slab.h>
 #include <linux/soundwire/sdw.h>
 #include <sound/soc-acpi.h>
@@ -463,6 +465,29 @@ static struct sdw_peripherals *mtk_sdw_get_peripherals(struct mtk_sdw *mst)
 	return peripherals;
 }
 
+/*
+ * Codec drivers name their per-system firmware after the sound card's PCI
+ * subsystem ID, which this ACPI-enumerated controller does not have. The
+ * firmware gives it as the controller's _SUB instead, written like Windows'
+ * SUBSYS value: subsystem device ID, then vendor ID ("33A11043" on the ASUS
+ * ProArt P14).
+ */
+static void mtk_sdw_set_subsystem_id(struct mtk_sdw *mst,
+				     struct snd_soc_acpi_mach *mach)
+{
+	const char *sub __free(kfree) = acpi_get_subsystem_id(ACPI_HANDLE(mst->dev));
+	u32 ssid;
+
+	if (IS_ERR(sub) || strlen(sub) != 8 || kstrtou32(sub, 16, &ssid))
+		return;
+
+	mach->mach_params.subsystem_device = ssid >> 16;
+	mach->mach_params.subsystem_vendor = ssid & 0xffff;
+	mach->mach_params.subsystem_id_set = true;
+	dev_dbg(mst->dev, "SSID %04x:%04x\n", mach->mach_params.subsystem_vendor,
+		mach->mach_params.subsystem_device);
+}
+
 struct snd_soc_acpi_mach *mtk_sdw_machine_select(struct mtk_sdw *mst)
 {
 	struct sdw_peripherals *peripherals;
@@ -488,6 +513,7 @@ struct snd_soc_acpi_mach *mtk_sdw_machine_select(struct mtk_sdw *mst)
 		if (link && !link->num_adr) {
 			mach->mach_params.links     = mach->links;
 			mach->mach_params.link_mask = mach->link_mask;
+			mtk_sdw_set_subsystem_id(mst, mach);
 			kfree(peripherals);
 			return mach;
 		}
diff --git a/sound/soc/mediatek/mt8901/mt8901-acp-sdw-legacy-mach.c b/sound/soc/mediatek/mt8901/mt8901-acp-sdw-legacy-mach.c
index 94143829be..4b989273df 100644
--- a/sound/soc/mediatek/mt8901/mt8901-acp-sdw-legacy-mach.c
+++ b/sound/soc/mediatek/mt8901/mt8901-acp-sdw-legacy-mach.c
@@ -574,6 +574,10 @@ static int mt8901_card_probe(struct platform_device *pdev)
 	card->num_dapm_routes = ARRAY_SIZE(mt8901_card_routes);
 
 	snd_soc_card_set_drvdata(card, ctx);
+	if (mach && mach->mach_params.subsystem_id_set)
+		snd_soc_card_set_pci_ssid(card,
+					  mach->mach_params.subsystem_vendor,
+					  mach->mach_params.subsystem_device);
 
 	if (quirk_override != -1) {
 		dev_info(card->dev, "Overriding quirk 0x%lx => 0x%x\n",
-- 
2.56.0

