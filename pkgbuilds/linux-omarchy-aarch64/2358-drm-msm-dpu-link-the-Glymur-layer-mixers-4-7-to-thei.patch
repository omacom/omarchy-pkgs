From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 8 Oct 2026 13:42:35 -0500
Subject: [PATCH] drm/msm/dpu: link the Glymur layer mixers 4-7 to their DSPP
 blocks

The Glymur catalog describes eight DSPP blocks, but only layer mixers 0-3
name a DSPP. The resource manager can only give a CRTC that needs colour
management (a CTM or gamma LUT) layer mixers that have a DSPP, so
mixers 4-7 can never serve such a CRTC and DSPP 4-7 are never used. Once
mixers 0-3 are taken, for example by the internal panel and one external
display, a third display, or a topology that needs more than four mixers,
fails the atomic check as soon as userspace sets a CTM or gamma LUT.

Give each of mixers 4-7 the DSPP with the same index, as for mixers 0-3.

Fixes: e2aeb8deddae ("drm/msm/dpu: Add support for Glymur")
Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/gpu/drm/msm/disp/dpu1/catalog/dpu_12_2_glymur.h | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/catalog/dpu_12_2_glymur.h b/drivers/gpu/drm/msm/disp/dpu1/catalog/dpu_12_2_glymur.h
index 4eb4a0e9803..280df25e0a4 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/catalog/dpu_12_2_glymur.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/catalog/dpu_12_2_glymur.h
@@ -175,6 +175,7 @@ static const struct dpu_lm_cfg glymur_lm[] = {
 		.sblk = &sm8750_lm_sblk,
 		.lm_pair = LM_5,
 		.pingpong = PINGPONG_4,
+		.dspp = DSPP_4,
 	}, {
 		.name = "lm_5", .id = LM_5,
 		.base = 0x49000, .len = 0x400,
@@ -182,6 +183,7 @@ static const struct dpu_lm_cfg glymur_lm[] = {
 		.sblk = &sm8750_lm_sblk,
 		.lm_pair = LM_4,
 		.pingpong = PINGPONG_5,
+		.dspp = DSPP_5,
 	}, {
 		.name = "lm_6", .id = LM_6,
 		.base = 0x4a000, .len = 0x400,
@@ -189,6 +191,7 @@ static const struct dpu_lm_cfg glymur_lm[] = {
 		.sblk = &sm8750_lm_sblk,
 		.lm_pair = LM_7,
 		.pingpong = PINGPONG_6,
+		.dspp = DSPP_6,
 	}, {
 		.name = "lm_7", .id = LM_7,
 		.base = 0x4b000, .len = 0x400,
@@ -196,6 +199,7 @@ static const struct dpu_lm_cfg glymur_lm[] = {
 		.sblk = &sm8750_lm_sblk,
 		.lm_pair = LM_6,
 		.pingpong = PINGPONG_7,
+		.dspp = DSPP_7,
 	},
 };
 
