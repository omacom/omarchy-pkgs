+/*
+ * ACPI: \_SB.I2C6 = QUP_0_SE_5 @ 0x00b94000 = Linux i2c5. This is the ASUS EC
+ * bus (EC @0x5b, second device @0x76, both answer on i2cdetect). The Zenbook's
+ * PTN3222 eUSB repeater @0x4f is not present here (not in ACPI, usb_mp port 1
+ * is unconnected on the PZ13).
+ * PZ13-TODO: EC driver (protocol documented in README.md).
+ */
+/*
+ * ACPI: \_SB.USB3 (QCOM0D08, the multiport host at 0x0a400000) lists two I2C
+ * devices on \_SB.I2C6 (= i2c5) at 0x43 and 0x4f and GpioIo 6 and 184: the two
+ * eUSB2 repeaters of usb_mp with their reset lines, as on the other X1 laptops
+ * (nxp,ptn3222). They probe. The cover's behaviour across suspend is governed
+ * by the missing USB wakeup (see &usb_mp), not by the repeaters. Which repeater
+ * serves which port follows the Zenbook A14 (0x4f/tlmm 184 on hsphy1 = cover);
+ * PZ13-TODO: confirm.
+ */
+&i2c5 {
+	clock-frequency = <400000>;
+
+	status = "okay";
+
+	eusb_repeater_a: redriver@43 {
+		compatible = "nxp,ptn3222";
+		reg = <0x43>;
+		#phy-cells = <0>;
+
+		vdd3v3-supply = <&vreg_l13b_3p0>;
+		vdd1v8-supply = <&vreg_l4b_1p8>;
+
+		reset-gpios = <&tlmm 6 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&eusb_a_reset_n>;
+		pinctrl-names = "default";
+	};
+
+	eusb_repeater_b: redriver@4f {
+		compatible = "nxp,ptn3222";
+		reg = <0x4f>;
+		#phy-cells = <0>;
+
+		vdd3v3-supply = <&vreg_l13b_3p0>;
+		vdd1v8-supply = <&vreg_l4b_1p8>;
+
+		reset-gpios = <&tlmm 184 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&eusb_b_reset_n>;
+		pinctrl-names = "default";
+	};
+
+	/*
+	 * ASUS embedded controller (ACPI \_SB.I2C6, "Asus_plat_ec.asl"): fan,
+	 * EC temperature sensors, battery charge mode. It runs the fan from a
+	 * SoC temperature the OS reports to it.
+	 */
+	ec: embedded-controller@5b {
+		compatible = "asus,proart-pz13-ec";
+		reg = <0x5b>;
+		/* The SoC sensors whose hottest reading the EC runs the fan on */
+		asus,thermal-zones = <&cpu0_0_top>, <&cpu0_1_top>, <&cpu0_2_top>, <&cpu0_3_top>,
+				     <&cpu0_0_btm>, <&cpu0_1_btm>, <&cpu0_2_btm>, <&cpu0_3_btm>,
+				     <&cpu1_0_top>, <&cpu1_1_top>, <&cpu1_2_top>, <&cpu1_3_top>,
+				     <&cpu1_0_btm>, <&cpu1_1_btm>, <&cpu1_2_btm>, <&cpu1_3_btm>,
+				     <&thermal_gpuss_0>, <&thermal_gpuss_1>,
+				     <&thermal_gpuss_2>, <&thermal_gpuss_3>;
+	};
+};
+
+/*
+ * ACPI: \_SB.I2C8 = QUP_0_SE_7 @ 0x00b9c000 = Linux i2c7. PS8833 retimer for
+ * USB-C port 1 @0x08, same wiring as the Zenbook A14; probes and works.
