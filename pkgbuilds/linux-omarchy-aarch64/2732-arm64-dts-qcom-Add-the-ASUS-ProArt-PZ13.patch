+&i2c0 {
+	/* ACPI: \_SB.I2C1 = QUP_0_SE_0 @ 0x00b80000 = Linux i2c0, 400 kHz */
+	clock-frequency = <400000>;
+
+	status = "okay";
+
+	/*
+	 * ACPI: \_SB.ECKB, _HID QTEC0001, _CID PNP0C50, _UID 3, slave 0x17,
+	 * HID descriptor register 0x0001, GpioInt edge-low shared.
+	 * This is the ASUS EC HID channel (hotkeys, tablet mode), the same
+	 * kind of device the Zenbook A14 exposes as hdtl@17 (0B05:4543).
+	 * The detachable keyboard cover is a plain USB device (0B05:1B6E)
+	 * and needs nothing here.
+	 * Interrupt on tlmm 67 (ACPI handle 0x0180 is a PEP handle, not a TLMM
+	 * number); the device binds and answers, whether the IRQ fires on
+	 * hotkeys is still unverified (PZ13-TODO).
+	 */
+	ec-hid@17 {
+		compatible = "hid-over-i2c";
+		reg = <0x17>;
+
+		hid-descr-addr = <0x1>;
+		interrupts-extended = <&tlmm 67 IRQ_TYPE_LEVEL_LOW>;
+
+		pinctrl-0 = <&echid_default>;
+		pinctrl-names = "default";
+
+		wakeup-source;
+	};
+};
