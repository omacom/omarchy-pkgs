+
+&gpu {
+	status = "okay";
+};
+
+/* Windows DriverStore name: qcdxkmsucpurwa.mbn */
+&gpu_zap_shader {
+	firmware-name = "qcom/x1p42100/ASUSTeK/proart-pz13/qcdxkmsucpurwa.mbn";
+};
+
+/*
+ * Panel: EDID manufacturer SDC (Samsung Display), product 0x41B0,
+ * 2880x1800 OLED, DisplayPort/eDP, 10 bpc. The generic Samsung ATNA eDP
+ * OLED driver matches on EDID; the Zenbook A14 uses the same driver with
+ * its own panel id. Enable GPIO pmc8380_3 gpio 4 as on the Zenbook A14;
+ * verified working (panel comes up through the driver, backlight via AUX).
+ */
+&panel {
+	compatible = "samsung,atna33xc20";
+	enable-gpios = <&pmc8380_3_gpios 4 GPIO_ACTIVE_HIGH>;
+
+	pinctrl-0 = <&edp_bl_en>;
+	pinctrl-names = "default";
+};
+
+&pcie4_port0 {
+	wifi@0 {
+		compatible = "pci17cb,1107";
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+
+		vddaon-supply = <&vreg_pmu_aon_0p59>;
+		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
+		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
+		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
+
+		/*
+		 * No board-2.bin entry exists for this variant yet; ath12k falls
+		 * back to the generic WCN7850 board data, which works. PZ13-TODO:
+		 * extract the ASUS board file from the Windows bdwlan.elf and get
+		 * it into linux-firmware.
+		 */
+		qcom,calibration-variant = "HT5306QA";
+	};
+};
+
+/* Windows DriverStore names: qcadsp8380.mbn + adsp_dtbs.elf */
+&remoteproc_adsp {
+	firmware-name = "qcom/x1p42100/ASUSTeK/proart-pz13/qcadsp8380.mbn",
+			"qcom/x1p42100/ASUSTeK/proart-pz13/adsp_dtbs.elf";
+
+	status = "okay";
+};
+
+/* Windows DriverStore names: qccdsp8380.mbn + cdsp_dtbs.elf */
+&remoteproc_cdsp {
+	firmware-name = "qcom/x1p42100/ASUSTeK/proart-pz13/qccdsp8380.mbn",
+			"qcom/x1p42100/ASUSTeK/proart-pz13/cdsp_dtbs.elf";
+
+	status = "okay";
+};
