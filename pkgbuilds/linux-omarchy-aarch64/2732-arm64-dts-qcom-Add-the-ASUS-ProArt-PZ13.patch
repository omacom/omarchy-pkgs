+&usb_mp {
+	/*
+	 * PZ13: the keyboard cover's pogo connector (USB 2.0 only, "Z13 Soft
+	 * Keyboard" 0b05:1b6e) enumerates on the second port (xhci 1-2, hsphy1);
+	 * port 0 has no external connector. The SuperSpeed QMP PHYs have no link
+	 * partner and their initialisation times out at random ("88e3000.phy: phy
+	 * initialization timed-out"), which takes the whole controller down with
+	 * it. Run the controller on the high-speed PHYs only.
+	 */
+	phys = <&usb_mp_hsphy0>, <&usb_mp_hsphy1>;
+	phy-names = "usb2-0", "usb2-1";
+	maximum-speed = "high-speed";
+
+	/*
+	 * No USB wakeup from this controller: the keyboard cover cannot wake the
+	 * tablet at all (a held key only triggers the keyboard's firmware reset;
+	 * the tablet is woken with the power button). With wakeup enabled dwc3
+	 * keeps the port in U3 across suspend, the cover's reset leaves the port
+	 * stuck in link state Resume
+	 * ("Port resume timed out, port 1-2", "Cannot enable") and only a
+	 * re-initialisation of the controller recovers it. Without wakeup the
+	 * core is shut down at suspend and rebuilt at resume; the cover is
+	 * reset-resumed as the same device and works again once it has received
+	 * its backlight feature report (install/pz13-cover-usb-resume).
+	 */
+	/delete-property/ wakeup-source;
+
+	status = "okay";
+};
