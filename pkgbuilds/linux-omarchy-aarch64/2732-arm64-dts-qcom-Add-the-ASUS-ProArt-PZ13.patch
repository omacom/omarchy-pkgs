+&i2c8 {
+	/* ACPI: \_SB.I2C9 = QUP_1_SE_0 @ 0x00a80000 = Linux i2c8, 400 kHz */
+	clock-frequency = <400000>;
+
+	status = "okay";
+
+	/*
+	 * ACPI: \_SB.TSC1, _HID ELAN9008, _CID PNP0C50, slave 0x10,
+	 * HID descriptor register 0x0001, GpioInt level-low shared.
+	 * The ACPI GpioInt pin (0x0400) is a Windows PEP handle, not a TLMM
+	 * number. Verified on hardware: tlmm 51 counts in /proc/interrupts on
+	 * touch; the controller enumerates as ELAN 04F3:430A with multitouch
+	 * and a stylus collection (MPP pen).
+	 */
+	touchscreen@10 {
+		compatible = "hid-over-i2c";
+		reg = <0x10>;
+
+		hid-descr-addr = <0x1>;
+		interrupts-extended = <&tlmm 51 IRQ_TYPE_LEVEL_LOW>;
+
+		pinctrl-0 = <&ts0_default>;
+		pinctrl-names = "default";
+
+		wakeup-source;
+	};
+};
