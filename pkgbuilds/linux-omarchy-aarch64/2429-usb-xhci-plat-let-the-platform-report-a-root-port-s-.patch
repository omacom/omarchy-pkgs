From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Martin <jimmartin@gmail.com>
Date: Thu, 8 Oct 2026 13:46:31 -0500
Subject: [PATCH] usb: xhci: plat: let the platform report a root port's tunnel
 state

xhci_update_device() asks xhci_port_is_tunneled() whether a USB3 device
on a root port is connected natively or tunnelled over USB4. Only Intel
PCI hosts can answer, through their vendor-specific capability; every
other host reports USB_LINK_UNKNOWN.

Some platform xHCIs sit next to a USB4 host router and have their own
way to tell, such as a DWC3 dual-role core with converged I/O registers.
Add an optional tunnel_mode() callback to struct xhci_plat_priv and use
it in xhci_port_is_tunneled() when the glue provides one. Hosts without
the callback are unchanged.

Assisted-by: Opus 5.5
Signed-off-by: Jim Martin <jimmartin@gmail.com>
---
 drivers/usb/host/xhci-hub.c  | 5 ++++-
 drivers/usb/host/xhci-plat.c | 1 +
 drivers/usb/host/xhci-plat.h | 2 ++
 drivers/usb/host/xhci.h      | 2 ++
 4 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/drivers/usb/host/xhci-hub.c b/drivers/usb/host/xhci-hub.c
index eaa94735248..3cdb60bd8a6 100644
--- a/drivers/usb/host/xhci-hub.c
+++ b/drivers/usb/host/xhci-hub.c
@@ -770,8 +770,11 @@ enum usb_link_tunnel_mode xhci_port_is_tunneled(struct xhci_hcd *xhci,
 	void __iomem *base;
 	u32 offset;
 
-	/* Don't try and probe this capability for non-Intel hosts */
 	hcd = xhci_to_hcd(xhci);
+	if (xhci->port_tunnel_mode)
+		return xhci->port_tunnel_mode(hcd, port->hcd_portnum);
+
+	/* Don't try and probe this capability for non-Intel hosts */
 	if (!dev_is_pci(hcd->self.controller) ||
 	    to_pci_dev(hcd->self.controller)->vendor != PCI_VENDOR_ID_INTEL)
 		return USB_LINK_UNKNOWN;
diff --git a/drivers/usb/host/xhci-plat.c b/drivers/usb/host/xhci-plat.c
index c8e10d2338c..e5ca61c96ae 100644
--- a/drivers/usb/host/xhci-plat.c
+++ b/drivers/usb/host/xhci-plat.c
@@ -93,6 +93,7 @@ static void xhci_plat_quirks(struct device *dev, struct xhci_hcd *xhci)
 	struct xhci_plat_priv *priv = xhci_to_priv(xhci);
 
 	xhci->quirks |= priv->quirks;
+	xhci->port_tunnel_mode = priv->tunnel_mode;
 }
 
 /* called during probe() after chip reset completes */
diff --git a/drivers/usb/host/xhci-plat.h b/drivers/usb/host/xhci-plat.h
index b04308c3e2c..ce2dc405220 100644
--- a/drivers/usb/host/xhci-plat.h
+++ b/drivers/usb/host/xhci-plat.h
@@ -35,6 +35,8 @@ struct xhci_plat_priv {
 	u32 u2port_cnt;
 	u32 u3port_cnt;
 	u32 u3port_disable_mask;
+	/* Platform report of a root port's USB4 tunnel state (optional). */
+	enum usb_link_tunnel_mode (*tunnel_mode)(struct usb_hcd *hcd, unsigned int port);
 };
 
 #define hcd_to_xhci_priv(h) ((struct xhci_plat_priv *)hcd_to_xhci(h)->priv)
diff --git a/drivers/usb/host/xhci.h b/drivers/usb/host/xhci.h
index 6e76dd9d162..5a420bf781c 100644
--- a/drivers/usb/host/xhci.h
+++ b/drivers/usb/host/xhci.h
@@ -1655,6 +1655,8 @@ struct xhci_hcd {
 	struct xhci_port	*hw_ports;
 	struct xhci_hub		usb2_rhub;
 	struct xhci_hub		usb3_rhub;
+	/* Platform-specific USB4 tunnel state report for a root port */
+	enum usb_link_tunnel_mode (*port_tunnel_mode)(struct usb_hcd *hcd, unsigned int port);
 	/* support xHCI 1.0 spec USB2 hardware LPM */
 	unsigned		hw_lpm_support:1;
 	/* Broken Suspend flag for SNPS Suspend resume issue */
-- 
2.56.0

