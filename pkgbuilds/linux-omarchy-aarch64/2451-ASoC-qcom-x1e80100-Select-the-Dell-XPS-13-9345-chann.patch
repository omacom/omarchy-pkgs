From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Gassner <42lizard@42lizard.dev>
Date: Thu, 12 Nov 2026 18:47:19 +0100
Subject: [PATCH] ASoC: qcom: x1e80100: Select the Dell XPS 13 9345 channel
 map

The Dell speaker wiring needs FR,RB,FL,LB rather than the generic
FL,LB,FR,RB four-channel map. Adapt Abel Vesa's October 2025 RFC:
select the mapping with dell,xps13-9345-sndcard.

Apply the alternate map only to the four-channel case. Keep the
existing count-dependent behavior for mono, stereo and three-channel
streams, addressing the concern raised in review of the RFC.

A clean boot on an XPS 13 9345 with Linux 7.3.0-3.1-omarchy and this
machine driver passed all four isolated channel speech checks with
no userspace channel swap and no new kernel messages during playback.
The system retained an upstream wsa884x codec override; this is not
a full packaged-kernel test or speaker-protection validation.

Based on work by Abel Vesa (Linaro).
Link: https://lkml.iu.edu/2510.2/09944.html
Link: https://lkml.iu.edu/2510.2/08506.html
Link: https://github.com/omacom/omarchy-pkgs/issues/2293
Signed-off-by: Oliver Gassner <42lizard@42lizard.dev>
---
 sound/soc/qcom/x1e80100.c | 48 +++++++++++++++++++++++++++++++--------
 1 file changed, 39 insertions(+), 9 deletions(-)

diff --git a/sound/soc/qcom/x1e80100.c b/sound/soc/qcom/x1e80100.c
index c81df41..364ed7a 100644
--- a/sound/soc/qcom/x1e80100.c
+++ b/sound/soc/qcom/x1e80100.c
@@ -15,9 +15,15 @@
 #include "qdsp6/q6dsp-common.h"
 #include "sdw.h"
 
+struct x1e80100_snd_cfg {
+	const char *driver_name;
+	bool right_left_4ch;
+};
+
 struct x1e80100_snd_data {
 	bool stream_prepared[AFE_PORT_MAX];
 	struct snd_soc_card *card;
+	const struct x1e80100_snd_cfg *cfg;
 	struct snd_soc_jack jack;
 	struct snd_soc_jack dp_jack[8];
 	bool jack_setup;
@@ -92,7 +98,8 @@ static int x1e80100_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 	return 0;
 }
 
-static int x1e80100_snd_hw_map_channels(unsigned int *ch_map, int num)
+static int x1e80100_snd_hw_map_channels(struct x1e80100_snd_data *data,
+					unsigned int *ch_map, int num)
 {
 	switch (num) {
 	case 1:
@@ -108,10 +115,18 @@ static int x1e80100_snd_hw_map_channels(unsigned int *ch_map, int num)
 		ch_map[2] = PCM_CHANNEL_FC;
 		break;
 	case 4:
-		ch_map[0] = PCM_CHANNEL_FL;
-		ch_map[1] = PCM_CHANNEL_LB;
-		ch_map[2] = PCM_CHANNEL_FR;
-		ch_map[3] = PCM_CHANNEL_RB;
+		if (data->cfg->right_left_4ch) {
+			/* The XPS 13 9345 wires the right speaker pair first. */
+			ch_map[0] = PCM_CHANNEL_FR;
+			ch_map[1] = PCM_CHANNEL_RB;
+			ch_map[2] = PCM_CHANNEL_FL;
+			ch_map[3] = PCM_CHANNEL_LB;
+		} else {
+			ch_map[0] = PCM_CHANNEL_FL;
+			ch_map[1] = PCM_CHANNEL_LB;
+			ch_map[2] = PCM_CHANNEL_FR;
+			ch_map[3] = PCM_CHANNEL_RB;
+		}
 		break;
 	default:
 		return -EINVAL;
@@ -132,7 +147,7 @@ static int x1e80100_snd_prepare(struct snd_pcm_substream *substream)
 	switch (cpu_dai->id) {
 	case WSA_CODEC_DMA_RX_0:
 	case WSA_CODEC_DMA_RX_1:
-		ret = x1e80100_snd_hw_map_channels(rx_slot, channels);
+		ret = x1e80100_snd_hw_map_channels(data, rx_slot, channels);
 		if (ret)
 			return ret;
 
@@ -202,15 +217,30 @@ static int x1e80100_platform_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
-	card->driver_name = of_device_get_match_data(dev);
+	data->cfg = of_device_get_match_data(dev);
+	card->driver_name = data->cfg->driver_name;
 	x1e80100_add_be_ops(card);
 
 	return devm_snd_soc_register_card(dev, card);
 }
 
+static const struct x1e80100_snd_cfg x1e80100_cfg = {
+	.driver_name = "x1e80100",
+};
+
+static const struct x1e80100_snd_cfg glymur_cfg = {
+	.driver_name = "glymur",
+};
+
+static const struct x1e80100_snd_cfg dell_xps13_9345_cfg = {
+	.driver_name = "x1e80100",
+	.right_left_4ch = true,
+};
+
 static const struct of_device_id snd_x1e80100_dt_match[] = {
-	{ .compatible = "qcom,x1e80100-sndcard", .data = "x1e80100" },
-	{ .compatible = "qcom,glymur-sndcard", .data = "glymur" },
+	{ .compatible = "dell,xps13-9345-sndcard", .data = &dell_xps13_9345_cfg },
+	{ .compatible = "qcom,x1e80100-sndcard", .data = &x1e80100_cfg },
+	{ .compatible = "qcom,glymur-sndcard", .data = &glymur_cfg },
 	{}
 };
 MODULE_DEVICE_TABLE(of, snd_x1e80100_dt_match);
-- 
2.56.0


