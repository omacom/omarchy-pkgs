From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: David Heinemeier Hansson <david@hey.com>
Date: Sat, 31 Oct 2026 07:00:00 -0500
Subject: [PATCH] arm64: dts: qcom: zenbook-a16: Describe the USB4 host router

Without a USB4 host router, USB-C port 0 (left, display-adjacent) only
offers DisplayPort alternate mode. A Thunderbolt display such as the Pro
Display XDR then needs all four lanes for 6K, and its USB hub is lost:
it enumerates over USB3 until the port moves to four-lane DisplayPort,
then the controller is removed and fails to come back ("Host halt
failed, -110").

Describe USB4 host router 0 the way the Surface Laptop 8 does, and
connect it to the rest of the board:

- the router node with its clocks, resets, power domain, interconnects,
  IOMMU stream, USB4 PHY, TCSR and router firmware
- the sideband pad states; GPIOs 163-165 are the SoC's fixed usb0_sbrx
  and usb0_sbtx pins, so the Surface states carry over unchanged
- a second endpoint on port 0's SuperSpeed port in pmic-glink, so that
  the router receives the port's USB4 and tunnelling requests
- the router as the USB4 host interface of port 0's DWC3, which also
  gets snps,dis-del-phy-power-chg-quirk for U2/U3 exit across a tunnel
- the DP IN and USB router link clocks on DP0, for DisplayPort tunnelled
  through the router
- the P2RR2P pipe clock, the shared USB4 DP producer/AUX block and the
  USB4 receiver equalisation on port 0's combo PHY

Port 0 keeps its host-only dr_mode and its own PHY supplies.

The receiver equalisation (0x6f) is the Surface Laptop 8's: this laptop
boots without its ACPI tables, where Windows reads the value from. The
router driver also still assumes the Surface's board retimer and preset.
Both boards use the same SoC router, the same router image and a 40 Gbps
port, but these are untested on the Zenbook A16; a link that fails to
train in USB4 or Thunderbolt 3 mode should look here first.

This is experimental and depends on the Glymur USB4 host router driver
and the USB4 additions to the QMP combo PHY, msm DP and DWC3 drivers
carried with it.

Assisted-by: Opus 5.5
---
 .../dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts  | 180 +++++++++++++++++-
 1 file changed, 179 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts b/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
--- a/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
@@ -177,10 +177,19 @@
 
 				port@1 {
 					reg = <1>;
+					#address-cells = <1>;
+					#size-cells = <0>;
 
-					pmic_glink_ss_in: endpoint {
+					pmic_glink_ss_in: endpoint@0 {
+						reg = <0>;
 						remote-endpoint = <&usb_0_qmpphy_out>;
 					};
+
+					/* USB4 host router 0 serves this port */
+					pmic_glink_usb4_in: endpoint@1 {
+						reg = <1>;
+						remote-endpoint = <&usb4_0_typec_out>;
+					};
 				};
 			};
 		};
@@ -826,6 +835,24 @@
 
 &mdss_dp0 {
 	status = "okay";
+
+	/* DP IN and USB router link clocks for DisplayPort tunnelled by USB4 router 0 */
+	clocks = <&dispcc DISP_CC_MDSS_AHB_CLK>,
+		 <&dispcc DISP_CC_MDSS_DPTX0_AUX_CLK>,
+		 <&dispcc DISP_CC_MDSS_DPTX0_LINK_CLK>,
+		 <&dispcc DISP_CC_MDSS_DPTX0_LINK_INTF_CLK>,
+		 <&dispcc DISP_CC_MDSS_DPTX0_PIXEL0_CLK>,
+		 <&dispcc DISP_CC_MDSS_DPTX0_PIXEL1_CLK>,
+		 <&dispcc DISP_CC_MDSS_DPTX0_LINK_DPIN_CLK>,
+		 <&dispcc DISP_CC_MDSS_DPTX0_USB_ROUTER_LINK_INTF_CLK>;
+	clock-names = "core_iface",
+		      "core_aux",
+		      "ctrl_link",
+		      "ctrl_link_iface",
+		      "stream_pixel",
+		      "stream_1_pixel",
+		      "ctrl_link_dpin",
+		      "ctrl_usb4_link_iface";
 };
 
 &mdss_dp0_out {
@@ -1010,6 +1037,89 @@
 	vdd3-supply = <&vreg_l7b_e0>;
 };
 
+&soc {
+	/* USB4 host router 0, for USB-C port 0 (left, display-adjacent) */
+	usb4_0: usb4@15600000 {
+		compatible = "qcom,glymur-usb4";
+		reg = <0x0 0x15600000 0x0 0x100000>;
+
+		interrupts = <GIC_SPI 70 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 121 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "nhi", "mcu";
+
+		clocks = <&gcc GCC_CFG_NOC_USB_ANOC_AHB_CLK>,
+			 <&gcc GCC_CFG_NOC_USB_ANOC_SOUTH_AHB_CLK>,
+			 <&gcc GCC_AGGRE_USB4_0_AXI_CLK>,
+			 <&gcc GCC_USB4_0_CFG_AHB_CLK>,
+			 <&gcc GCC_USB4_0_MASTER_CLK>,
+			 <&gcc GCC_USB4_0_SB_IF_CLK>,
+			 <&gcc GCC_USB4_0_TMU_CLK>,
+			 <&gcc GCC_USB4_0_SYS_CLK>,
+			 <&gcc GCC_USB4_0_UC_HRR_CLK>,
+			 <&gcc GCC_USB4_0_DP0_CLK>,
+			 <&gcc GCC_USB4_0_DP1_CLK>,
+			 <&gcc GCC_USB4_0_PHY_PCIE_PIPE_CLK>,
+			 <&gcc GCC_USB4_0_PHY_USB_PIPE_CLK>;
+		clock-names = "anoc_ahb",
+			      "anoc_south_ahb",
+			      "aggre_axi",
+			      "cfg_ahb",
+			      "master",
+			      "sb_if",
+			      "tmu",
+			      "sys",
+			      "uc_hrr",
+			      "dp0",
+			      "dp1",
+			      "pcie_pipe",
+			      "usb_pipe";
+		assigned-clocks = <&gcc GCC_USB4_0_MASTER_CLK_SRC>,
+				  <&gcc GCC_USB4_0_TMU_CLK_SRC>;
+		assigned-clock-rates = <355333500>, <250000000>;
+
+		resets = <&gcc GCC_USB4_0_BCR>,
+			 <&gcc GCC_USB4PHY_0_PHY_PRIM_BCR>,
+			 <&gcc GCC_USB4_0_DP0_PHY_PRIM_BCR>;
+		reset-names = "router", "phy", "dp";
+
+		power-domains = <&gcc GCC_USB4_0_GDSC>;
+		required-opps = <&rpmhpd_opp_nom>;
+
+		interconnects = <&aggre4_noc MASTER_USB4_0 QCOM_ICC_TAG_ALWAYS
+				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
+				<&hsc_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
+				 &config_noc SLAVE_USB4_0 QCOM_ICC_TAG_ACTIVE_ONLY>;
+		interconnect-names = "usb4-ddr", "apps-usb4";
+
+		iommus = <&apps_smmu 0x1440 0x0>;
+
+		phys = <&usb_0_qmpphy QMP_USB43DP_USB4_PHY>;
+		phy-names = "usb4";
+
+		pinctrl-names = "rx-prepare", "txb-prepare", "txa-prepare",
+				"rx-active", "txb-active", "txa-active";
+		pinctrl-0 = <&usb4_0_sbrx_prepare>;
+		pinctrl-1 = <&usb4_0_sbtx_b_prepare>;
+		pinctrl-2 = <&usb4_0_sbtx_a_prepare>;
+		pinctrl-3 = <&usb4_0_sbrx_active>;
+		pinctrl-4 = <&usb4_0_sbtx_b_active>;
+		pinctrl-5 = <&usb4_0_sbtx_a_active>;
+
+		qcom,tcsr = <&tcsr>;
+		qcom,router-index = <0>;
+		firmware-name = "qcom/glymur/ASUSTeK/UX3607OA/usb4-router-legacy.bin";
+
+		mode-switch;
+		orientation-switch;
+
+		port {
+			usb4_0_typec_out: endpoint {
+				remote-endpoint = <&pmic_glink_usb4_in>;
+			};
+		};
+	};
+};
+
 &swr0 {
 	status = "okay";
 
@@ -1093,6 +1203,52 @@
 			       <65 1>, /* EC reset */
 			       <90 1>; /* TPM */
 
+	/*
+	 * USB4 router 0 sideband pads, in the order the router start-up sets
+	 * them: prepare states before the router reset, active states after it.
+	 */
+	usb4_0_sbrx_prepare: usb4-0-sbrx-prepare-state {
+		pins = "gpio163";
+		function = "gpio";
+		bias-pull-down;
+		output-disable;
+	};
+
+	usb4_0_sbtx_b_prepare: usb4-0-sbtx-b-prepare-state {
+		pins = "gpio165";
+		drive-strength = <10>;
+		output-high;
+	};
+
+	usb4_0_sbtx_a_prepare: usb4-0-sbtx-a-prepare-state {
+		pins = "gpio164";
+		function = "gpio";
+		drive-strength = <10>;
+		bias-pull-down;
+		output-low;
+	};
+
+	usb4_0_sbrx_active: usb4-0-sbrx-active-state {
+		pins = "gpio163";
+		function = "usb0_sbrx";
+		bias-disable;
+		output-disable;
+	};
+
+	usb4_0_sbtx_b_active: usb4-0-sbtx-b-active-state {
+		pins = "gpio165";
+		function = "usb0_sbtx";
+		drive-strength = <10>;
+	};
+
+	usb4_0_sbtx_a_active: usb4-0-sbtx-a-active-state {
+		pins = "gpio164";
+		function = "usb0_sbtx";
+		drive-strength = <10>;
+		bias-pull-up;
+		output-disable;
+	};
+
 	tpad_default: tpad-default-state {
 		pins = "gpio3";
 		function = "gpio";
@@ -1279,6 +1435,10 @@
 	 * and the controller pinned to host (our test68 finding). */
 	/delete-property/ usb-role-switch;
 	dr_mode = "host";
+	/* U2/U3 exit across a USB4 tunnel needs GUSB3PIPECTL.DEPOCHANGE clear. */
+	snps,dis-del-phy-power-chg-quirk;
+	/* The SuperSpeed port can be tunnelled through USB4 router 0 */
+	usb4-host-interface = <&usb4_0>;
 
 	status = "okay";
 };
@@ -1297,10 +1457,28 @@
 };
 
 &usb_0_qmpphy {
+	/* Shared USB4 DP producer/AUX block written during USB4 PHY setup. */
+	reg = <0x0 0x00fd5000 0x0 0x8000>,
+	      <0x0 0x00fe6000 0x0 0xcc>;
+	reg-names = "phy", "usb4-dp-aux";
+	/* Not read from this laptop's ACPI; the Surface Laptop 8's value. */
+	qcom,usb4-rx-eq = <0x6f>;
 	vdda-phy-supply = <&vreg_l3f_e0>;
 	vdda-pll-supply = <&vreg_l4c_e0>;
 	refgen-supply = <&vreg_l2f_e0>;
 
+	/* USB4 mode also needs the P2RR2P pipe clock. */
+	clocks = <&gcc GCC_USB3_PRIM_PHY_AUX_CLK>,
+		 <&rpmhcc RPMH_CXO_CLK>,
+		 <&gcc GCC_USB3_PRIM_PHY_COM_AUX_CLK>,
+		 <&gcc GCC_USB3_PRIM_PHY_PIPE_CLK>,
+		 <&gcc GCC_USB4_0_PHY_P2RR2P_PIPE_CLK>;
+	clock-names = "aux",
+		      "ref",
+		      "com_aux",
+		      "usb3_pipe",
+		      "p2rr2p_pipe";
+
 	status = "okay";
 };
 
