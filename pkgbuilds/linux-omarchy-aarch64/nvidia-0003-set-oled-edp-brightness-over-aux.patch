diff --git a/src/nvidia-modeset/src/nvkms.c b/src/nvidia-modeset/src/nvkms.c
index 4f9b65b..2e493c7 100644
--- a/src/nvidia-modeset/src/nvkms.c
+++ b/src/nvidia-modeset/src/nvkms.c
@@ -7147,12 +7147,199 @@ void nvKmsServiceNonStallInterrupt(void *dataPtr, NvU32 dataU32)
     nvHsProcessPendingViewportFlips(pDevEvo);
 }
 
+/* eDP backlight registers (VESA eDP 1.5, as in the kernel's drm_dp.h). */
+#define NV_EDP_DPCD_REV                         0x700
+#define NV_EDP_15                               0x06
+#define NV_EDP_GENERAL_CAP_1                    0x701
+#define NV_EDP_TCON_BACKLIGHT_ADJUSTMENT_CAP    (1 << 0)
+#define NV_EDP_BACKLIGHT_ADJUSTMENT_CAP         0x702
+#define NV_EDP_BACKLIGHT_BRIGHTNESS_PWM_PIN_CAP (1 << 0)
+#define NV_EDP_BACKLIGHT_BRIGHTNESS_AUX_SET_CAP (1 << 1)
+#define NV_EDP_GENERAL_CAP_2                    0x703
+#define NV_EDP_PANEL_LUMINANCE_CONTROL_CAPABLE  (1 << 4)
+#define NV_EDP_BACKLIGHT_MODE_SET_REGISTER      0x721
+#define NV_EDP_BACKLIGHT_CONTROL_MODE_PWM       (0 << 0)
+#define NV_EDP_BACKLIGHT_CONTROL_MODE_DPCD      (2 << 0)
+#define NV_EDP_PANEL_LUMINANCE_CONTROL_ENABLE   (1 << 7)
+#define NV_EDP_PANEL_TARGET_LUMINANCE_VALUE     0x734
+
+/*
+ * Luminance range for panels set in nits: the SDR range of common OLED panels
+ * (the Dell XPS 16 DX16263's LG panel declares 20 to 400 nits).
+ */
+#define NV_EDP_LUMINANCE_MIN_NITS               20
+#define NV_EDP_LUMINANCE_MAX_NITS               400
+#define NV_EDP_LUMINANCE_RANGE_NITS \
+    (NV_EDP_LUMINANCE_MAX_NITS - NV_EDP_LUMINANCE_MIN_NITS)
+
+/*
+ * RM leaves the brightness to the GPU firmware, which sets an internal eDP
+ * panel's brightness as a PWM signal or a level in the VESA eDP backlight
+ * registers. An eDP 1.5 OLED panel that takes a target luminance can ignore
+ * that level: on the NVIDIA N1x in the Dell XPS 16 the firmware writes it and
+ * the panel stays as it is. Return the internal panel's connector when it is
+ * such a panel, with no PWM input, so nvkms sets its brightness as a target
+ * luminance, as the kernel's drm_edp_backlight helpers do for i915 and amdgpu.
+ */
+static NVConnectorEvoPtr GetLuminanceBacklightConnector(NVDispEvoRec *pDispEvo,
+                                                        NvU32 display_id,
+                                                        NvU8 *pCap2)
+{
+    NVConnectorEvoPtr pConnectorEvo, pFound = NULL;
+    NvU8 rev = 0, cap1 = 0, gcap2 = 0;
+
+    FOR_ALL_EVO_CONNECTORS(pConnectorEvo, pDispEvo) {
+        if (nvDpyIdToNvU32(pConnectorEvo->displayId) == display_id) {
+            pFound = pConnectorEvo;
+            break;
+        }
+    }
+
+    if (pFound == NULL || !nvConnectorIsInternal(pFound) ||
+        pFound->signalFormat != NVKMS_CONNECTOR_SIGNAL_FORMAT_DP) {
+        return NULL;
+    }
+
+    if (!nvReadDPCDReg(pFound, NV_EDP_DPCD_REV, &rev) ||
+        !nvReadDPCDReg(pFound, NV_EDP_GENERAL_CAP_1, &cap1) ||
+        !nvReadDPCDReg(pFound, NV_EDP_BACKLIGHT_ADJUSTMENT_CAP, pCap2) ||
+        !nvReadDPCDReg(pFound, NV_EDP_GENERAL_CAP_2, &gcap2)) {
+        return NULL;
+    }
+
+    if (rev < NV_EDP_15 ||
+        !(cap1 & NV_EDP_TCON_BACKLIGHT_ADJUSTMENT_CAP) ||
+        (*pCap2 & NV_EDP_BACKLIGHT_BRIGHTNESS_PWM_PIN_CAP) ||
+        !(gcap2 & NV_EDP_PANEL_LUMINANCE_CONTROL_CAPABLE)) {
+        return NULL;
+    }
+
+    return pFound;
+}
+
+static NvBool WriteLuminanceBacklight(NVConnectorEvoPtr pConnectorEvo,
+                                      NvU8 cap2,
+                                      NvU32 brightness)
+{
+    const NvU8 mode = (cap2 & NV_EDP_BACKLIGHT_BRIGHTNESS_AUX_SET_CAP) ?
+        NV_EDP_BACKLIGHT_CONTROL_MODE_DPCD : NV_EDP_BACKLIGHT_CONTROL_MODE_PWM;
+    const NvU32 millinits = 1000 * (NV_EDP_LUMINANCE_MIN_NITS +
+        brightness * NV_EDP_LUMINANCE_RANGE_NITS / 100);
+    NvU32 i;
+
+    if (!nvWriteDPCDReg(pConnectorEvo, NV_EDP_BACKLIGHT_MODE_SET_REGISTER,
+                        mode | NV_EDP_PANEL_LUMINANCE_CONTROL_ENABLE)) {
+        return FALSE;
+    }
+
+    for (i = 0; i < 3; i++) {
+        if (!nvWriteDPCDReg(pConnectorEvo,
+                            NV_EDP_PANEL_TARGET_LUMINANCE_VALUE + i,
+                            (millinits >> (8 * i)) & 0xff)) {
+            return FALSE;
+        }
+    }
+
+    return TRUE;
+}
+
+/* Read the brightness back from the panel, while it is in luminance mode. */
+static NvBool ReadLuminanceBacklight(NVConnectorEvoPtr pConnectorEvo,
+                                     NvU32 *pBrightness)
+{
+    NvU8 mode = 0, b[3] = { 0 };
+    NvU32 i, nits;
+
+    if (!nvReadDPCDReg(pConnectorEvo, NV_EDP_BACKLIGHT_MODE_SET_REGISTER, &mode) ||
+        !(mode & NV_EDP_PANEL_LUMINANCE_CONTROL_ENABLE)) {
+        return FALSE;
+    }
+
+    for (i = 0; i < 3; i++) {
+        if (!nvReadDPCDReg(pConnectorEvo,
+                           NV_EDP_PANEL_TARGET_LUMINANCE_VALUE + i, &b[i])) {
+            return FALSE;
+        }
+    }
+
+    nits = (b[0] | (b[1] << 8) | (b[2] << 16)) / 1000;
+    nits = NV_MAX(nits, NV_EDP_LUMINANCE_MIN_NITS);
+    nits = NV_MIN(nits, NV_EDP_LUMINANCE_MAX_NITS);
+    *pBrightness = ((nits - NV_EDP_LUMINANCE_MIN_NITS) * 100 +
+                    NV_EDP_LUMINANCE_RANGE_NITS / 2) /
+                   NV_EDP_LUMINANCE_RANGE_NITS;
+    return TRUE;
+}
+
+static NvBool SetLuminanceBacklight(NVDispEvoRec *pDispEvo,
+                                    NvU32 display_id,
+                                    NvU32 brightness)
+{
+    NvU8 cap2 = 0;
+    NVConnectorEvoPtr pConnectorEvo =
+        GetLuminanceBacklightConnector(pDispEvo, display_id, &cap2);
+    static NvBool logged = FALSE;
+    NvU32 readBack = 0;
+    NvBool ok;
+
+    if (pConnectorEvo == NULL) {
+        return FALSE;
+    }
+
+    brightness = NV_MIN(brightness, 100);
+    ok = WriteLuminanceBacklight(pConnectorEvo, cap2, brightness);
+
+    if (ok) {
+        pDispEvo->auxBacklight.set = TRUE;
+        pDispEvo->auxBacklight.displayId = display_id;
+        pDispEvo->auxBacklight.brightness = brightness;
+    }
+
+    if (!logged) {
+        nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                     "Setting the eDP panel's brightness as a target luminance: %u%% %s",
+                     brightness,
+                     !ok ? "failed" :
+                     ReadLuminanceBacklight(pConnectorEvo, &readBack) &&
+                     readBack == brightness ? "read back" : "not read back");
+        logged = TRUE;
+    }
+
+    return ok;
+}
+
+/*
+ * The panel forgets a brightness set over AUX when it is powered off; set it
+ * again once a modeset has brought the panel back up.
+ */
+void nvKmsRestoreBacklightOverAux(NVDispEvoRec *pDispEvo,
+                                  const NVConnectorEvoRec *pConnectorEvo)
+{
+    NVConnectorEvoPtr pPanel;
+    NvU8 cap2 = 0;
+
+    if (!pDispEvo->auxBacklight.set ||
+        nvDpyIdToNvU32(pConnectorEvo->displayId) !=
+        pDispEvo->auxBacklight.displayId) {
+        return;
+    }
+
+    pPanel = GetLuminanceBacklightConnector(pDispEvo,
+                                            pDispEvo->auxBacklight.displayId,
+                                            &cap2);
+    if (pPanel != NULL) {
+        WriteLuminanceBacklight(pPanel, cap2, pDispEvo->auxBacklight.brightness);
+    }
+}
+
 NvBool nvKmsGetBacklight(NvU32 display_id, void *drv_priv, NvU32 *brightness)
 {
     NV0073_CTRL_SPECIFIC_BACKLIGHT_BRIGHTNESS_PARAMS params = { 0 };
     NV_STATUS status = NV_ERR_INVALID_STATE;
     NVDispEvoRec *pDispEvo = drv_priv;
     NVDevEvoRec *pDevEvo = pDispEvo->pDevEvo;
+    NVConnectorEvoPtr pConnectorEvo;
+    NvU8 cap2 = 0;
 
     params.displayId = display_id;
     params.brightnessType = NV0073_CTRL_SPECIFIC_BACKLIGHT_BRIGHTNESS_TYPE_PERCENT100;
@@ -7166,6 +7353,12 @@ NvBool nvKmsGetBacklight(NvU32 display_id, void *drv_priv, NvU32 *brightness)
         *brightness = params.brightness;
     }
 
+    pConnectorEvo = GetLuminanceBacklightConnector(pDispEvo, display_id, &cap2);
+    if (pConnectorEvo != NULL &&
+        ReadLuminanceBacklight(pConnectorEvo, brightness)) {
+        return TRUE;
+    }
+
     return status == NV_OK;
 }
 
@@ -7175,6 +7368,7 @@ NvBool nvKmsSetBacklight(NvU32 display_id, void *drv_priv, NvU32 brightness)
     NV_STATUS status = NV_ERR_INVALID_STATE;
     NVDispEvoRec *pDispEvo = drv_priv;
     NVDevEvoRec *pDevEvo = pDispEvo->pDevEvo;
+    NvBool luminance;
 
     params.displayId  = display_id;
     params.brightness = brightness;
@@ -7185,7 +7379,10 @@ NvBool nvKmsSetBacklight(NvU32 display_id, void *drv_priv, NvU32 brightness)
                             NV0073_CTRL_CMD_SPECIFIC_SET_BACKLIGHT_BRIGHTNESS,
                             &params, sizeof(params));
 
-    return status == NV_OK;
+    /* After RM, which may have written a level the panel ignores. */
+    luminance = SetLuminanceBacklight(pDispEvo, display_id, brightness);
+
+    return status == NV_OK || luminance;
 }
 
 NvBool nvKmsOpenDevHasSubOwnerPermissionOrBetter(const struct NvKmsPerOpenDev *pOpenDev)
