 src/nvidia-modeset/src/nvkms-modeset.c     |   3 +
 src/nvidia-modeset/src/nvkms-rm.c          |   7 +
 src/nvidia-modeset/src/nvkms.c             | 199 ++++++++++++++++++++-
 6 files changed, 224 insertions(+), 1 deletion(-)

