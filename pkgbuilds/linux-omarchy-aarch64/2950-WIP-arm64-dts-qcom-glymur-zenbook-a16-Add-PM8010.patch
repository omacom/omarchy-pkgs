From a68ba8531372b41628b947bc30ea864d906f0f1d Mon Sep 17 00:00:00 2001
From: Konrad Dybcio <konrad.dybcio@oss.qualcomm.com>
Date: Wed, 22 Jul 2026 14:31:42 +0200
Subject: [PATCH] [WIP] arm64: dts: qcom: glymur-zenbook-a16: Add PM8010

The PM8010 supplies the 2 camera modules present on the device.
Add a node for it and Configure the regulators in line with their
expectations.
---
 .../qcom/glymur-asus-zenbook-a16-ux3607oa.dts | 44 +++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts b/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
index 223f100549c484..10061b275c8ae3 100644
--- a/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
@@ -621,6 +621,50 @@
 
 	status = "okay";
 
+	pm8010: pmic@8 {
+		status = "disabled";
+		compatible = "qcom,pm8010-i2c";
+		reg = <0x8>;
+
+		reset-gpios = <&tlmm 106 GPIO_ACTIVE_LOW>;
+
+		// vdd-l3-l4-supply = <&vreg_bob>;
+		// vdd-l5-supply = <&vreg_bob>;
+		// vdd-l6-supply = <&vreg_bob>;
+		// vdd-l7-supply = <&vreg_bob>;
+
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-ranges = <&pm8010 0 0 2>;
+
+		#thermal-sensor-cells = <0>;
+
+		regulators {
+			/* L1/L2 are unused */
+
+			vreg_l3m: ldo3 {
+				regulator-name = "vreg_l3m";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			vreg_l4m: ldo4 {
+				regulator-name = "vreg_l4m";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+
+			/* L5/L6 are unused */
+
+			vreg_l7m: ldo7 {
+				regulator-name = "vreg_l7m";
+				// TODO: 2.9?
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+		};
+	};
+
 	ptn3222_1: redriver@43 {
 		compatible = "nxp,ptn3222";
 		reg = <0x43>;
