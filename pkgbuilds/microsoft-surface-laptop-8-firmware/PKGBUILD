# Maintainer: Birk Skyum <birk.skyum@pm.me>
#
# Audio DSP and compute DSP firmware for the Microsoft Surface Laptop 8. The firmware only runs if
# it is signed for this board by Microsoft, so linux-firmware cannot carry it until the OEM
# submits it. The OEM ships it in its Windows driver download, which this recipe unpacks without
# running. The files are installed unmodified, under the names the device tree requests, and
# checked against the SHA-256 each was matched to.

pkgname=microsoft-surface-laptop-8-firmware
pkgver=20261102
pkgrel=1
pkgdesc='Audio DSP and compute DSP firmware for the Microsoft Surface Laptop 8'
arch=('aarch64')
url='https://www.microsoft.com/en-us/download/details.aspx?id=108705'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-glymur-microsoft-mahua')
makedepends=('7zip' 'msitools')
options=('!strip' '!debug')
source=(
  'microsoft-surfacelaptop8withsnapdragon.msi::https://download.microsoft.com/download/912431b4-2920-4990-8b62-50b573263fda/SurfaceLaptop8withSnapdragon_Win11_28000_26.091.10521.0.msi'
)
noextract=('microsoft-surfacelaptop8withsnapdragon.msi')
sha256sums=('e888288deb0e5f25322a118d2b36522df06b25bd56be952cd6fb7b6ffb4f20a0')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'microsoft-surfacelaptop8withsnapdragon.msi' 'microsoft-surfacelaptop8withsnapdragon' msi
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'microsoft-surfacelaptop8withsnapdragon/SurfaceUpdate/proextadsp8480/adsp_dtbs.elf' "$fw"/'qcom/glymur/microsoft/mahua/adsp_dtbs.elf'
  install -Dm644 'microsoft-surfacelaptop8withsnapdragon/SurfaceUpdate/proextadsp8480/adspr.jsn' "$fw"/'qcom/glymur/microsoft/mahua/adspr.jsn'
  install -Dm644 'microsoft-surfacelaptop8withsnapdragon/SurfaceUpdate/proextadsp8480/adsps.jsn' "$fw"/'qcom/glymur/microsoft/mahua/adsps.jsn'
  install -Dm644 'microsoft-surfacelaptop8withsnapdragon/SurfaceUpdate/proextadsp8480/adspua.jsn' "$fw"/'qcom/glymur/microsoft/mahua/adspua.jsn'
  install -Dm644 'microsoft-surfacelaptop8withsnapdragon/SurfaceUpdate/qcnspmcdm8480/cdsp_dtbs.elf' "$fw"/'qcom/glymur/microsoft/mahua/cdsp_dtbs.elf'
  install -Dm644 'microsoft-surfacelaptop8withsnapdragon/SurfaceUpdate/proextadsp8480/qcadsp8480.mbn' "$fw"/'qcom/glymur/microsoft/mahua/qcadsp8480.mbn'
  install -Dm644 'microsoft-surfacelaptop8withsnapdragon/SurfaceUpdate/qcnspmcdm8480/qccdsp8480.mbn' "$fw"/'qcom/glymur/microsoft/mahua/qccdsp8480.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
0e311aa8ce32f182a9401a1dbcab81a22a1db21106f1660aa5797fe2c590f24c  qcom/glymur/microsoft/mahua/adsp_dtbs.elf
e9ba7199626b0c03f2ec02822d744f678ad567fe0625a28fe5f5908b7281e9db  qcom/glymur/microsoft/mahua/adspr.jsn
19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e  qcom/glymur/microsoft/mahua/adsps.jsn
d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d  qcom/glymur/microsoft/mahua/adspua.jsn
dfd345ab5ee9dba7fc7d717a35a3b9bb96f195a1d2cde18af41be1945d8599db  qcom/glymur/microsoft/mahua/cdsp_dtbs.elf
617a7a8ec5cd27f09cb6b5d7b7e07dff38e4c6f0869851f55e62aa257802aa26  qcom/glymur/microsoft/mahua/qcadsp8480.mbn
2798125b8458d47b4e1adbd3ae2451fdb20ee6add9ea4dc6211c96d96210a2b9  qcom/glymur/microsoft/mahua/qccdsp8480.mbn
SUMS
  )
}
