# Arch's bitwarden-cli depends on nodejs-lts-jod, which conflicts with nodejs.
# Omarchy already has current nodejs, and pacman --noconfirm will not replace
# it, so Install > Service > Bitwarden fails. The published CLI runs on
# node >= 22, including that current package.

pkgname=bitwarden-cli
pkgver=2026.10.1
pkgrel=1
pkgdesc='The command line vault'
arch=(x86_64 aarch64)
url=https://github.com/bitwarden/clients
license=(GPL-3.0-only)
depends=('nodejs>=22')
makedepends=(npm)
source=(
  $pkgname-$pkgver.tgz::https://registry.npmjs.org/@bitwarden/cli/-/cli-$pkgver.tgz
  LICENSE.txt::https://raw.githubusercontent.com/bitwarden/clients/cli-v$pkgver/LICENSE.txt
)
sha256sums=('79607f1362efca6fe1951dce7fee79bbfa7bb8f08a0d91715dece80bc1896168'
            '01fe7fd5a624e6a81557ff4b76c4a7b9a3d89c6a1b58083b74aff7bce843bb41')
options=(!debug !strip)
noextract=($pkgname-$pkgver.tgz)

package() {
  mkdir -p "$srcdir"/home
  env HOME="$srcdir"/home \
    npm install --silent --global --cache "$srcdir"/npm-cache \
    --prefix "$pkgdir"/usr "$srcdir"/$pkgname-$pkgver.tgz

  install -Dm644 LICENSE.txt "$pkgdir"/usr/share/licenses/$pkgname/LICENSE.txt
}
