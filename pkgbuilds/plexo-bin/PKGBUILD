# Maintainer: ujo4eva <92157639+ujo4eva@users.noreply.github.com>

pkgname=plexo-bin
_name=plexo
pkgver=1.0.0_rc.15
_upstream_version=${pkgver/_/-}
pkgrel=1
pkgdesc="Speed up downloads by combining multiple network connections in parallel"
arch=('x86_64' 'aarch64')
url="https://github.com/anmolkapil/plexo"
license=('MIT')

depends=(
  'alsa-lib'
  'at-spi2-core'
  'gcc-libs'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libdrm'
  'libnotify'
  'libsecret'
  'libxss'
  'libxtst'
  'mesa'
  'nss'
  'util-linux-libs'
  'xdg-utils'
)

provides=("$_name")
conflicts=("$_name")
options=('!debug' '!strip')

makedepends=('libarchive')

source=('LICENSE')
_deb_x86_64="plexo_${_upstream_version}_amd64.deb"
_deb_aarch64="plexo_${_upstream_version}_arm64.deb"
source_x86_64=("https://github.com/anmolkapil/plexo/releases/download/v${_upstream_version}/${_deb_x86_64}")
source_aarch64=("https://github.com/anmolkapil/plexo/releases/download/v${_upstream_version}/${_deb_aarch64}")
noextract=("${_deb_x86_64}" "${_deb_aarch64}")
sha256sums=('74b29d4a3d81cd1ab735dcc9f19399cde428d6587562aceb0b5c5bd8363806f4')
sha256sums_x86_64=('7ab2e0a5ec57c26bb4a6b4a7dcd2b43c3a367cca2e0351ef0de116808bb39057')
sha256sums_aarch64=('6cae1d2478f427403f443dd45d3fc2b9d812ef01cf046f7a073812c677699cf8')

# The Electron tree is 390 MiB installed; maximum zstd keeps the package at
# 97 MiB (409 MB uncompressed). Same treatment as claude-desktop: users
# re-download it on every release.
COMPRESSZST=(zstd -c -z -q --ultra -22 --threads=0 -)

package() {
  local deb_var="_deb_${CARCH}"
  local deb="${!deb_var}"

  bsdtar -xOf "${srcdir}/${deb}" data.tar.xz |
    bsdtar --no-same-owner -xf - -C "${pkgdir}"

  # The deb registers no /usr/bin entry; the desktop file runs the Electron
  # binary by absolute path only.
  install -dm755 "${pkgdir}/usr/bin"
  ln -s "/opt/Plexo/plexo" "${pkgdir}/usr/bin/plexo"

  # Upstream ships the sandbox helper mode 0755; it needs the setuid bit to
  # keep Chromium's sandbox up on kernels that deny unprivileged user
  # namespaces.
  chmod 4755 "${pkgdir}/opt/Plexo/chrome-sandbox"

  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  local license
  for license in LICENSE.electron.txt LICENSES.chromium.html; do
    install -Dm644 "${pkgdir}/opt/Plexo/${license}" \
      "${pkgdir}/usr/share/licenses/${pkgname}/${license}"
  done

  # Debian package-policy files are not used on Arch Linux.
  rm -rf "${pkgdir}/usr/share/doc"
}