# Maintainer: The Omarchy Authors
pkgname=amp-cli
pkgver=0.0.1795464043
pkgrel=1
# Amp versions are 0.0.<build time>-g<commit>. pkgver keeps the build time,
# which orders releases; the commit only names the download.
_hash=gc7cddb
pkgdesc="Amp, the frontier coding agent, in your terminal"
arch=('x86_64' 'aarch64')
url="https://ampcode.com"
license=('LicenseRef-Amp')
depends=('glibc')
# The binary is a Bun executable with its JavaScript appended; stripping breaks it.
options=('!strip' '!debug')
_dl="https://static.ampcode.com/cli/${pkgver}-${_hash}"
# TERMS is https://ampcode.com/terms, which the npm package's LICENSE.md points to.
source=('TERMS')
source_x86_64=("amp-${pkgver}-x86_64::${_dl}/amp-linux-x64")
source_aarch64=("amp-${pkgver}-aarch64::${_dl}/amp-linux-arm64")
sha256sums=('a5bae9130f30271361735d96f731733f3fe0a5a666df72f1456e4ab823c4de66')
sha256sums_x86_64=('170dba591a842066f5207aa73e68c11fea3cc26a59f4e9538f244f0ab07f9119')
sha256sums_aarch64=('ce3393efa1cfa727352d77a1916a1d6acc629c7de0feb0b240b1f74936d0538d')

package() {
  install -Dm755 "${srcdir}/amp-${pkgver}-${CARCH}" "${pkgdir}/usr/lib/amp-cli/amp"
  install -Dm644 "${srcdir}/TERMS" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # pacman updates this install, so Amp's own update check would only offer
  # an `amp update` that cannot replace it.
  install -dm755 "${pkgdir}/usr/bin"
  cat >"${pkgdir}/usr/bin/amp" <<'WRAPPER'
#!/bin/sh
export AMP_SKIP_UPDATE_CHECK=1
exec /usr/lib/amp-cli/amp "$@"
WRAPPER
  chmod 755 "${pkgdir}/usr/bin/amp"
}
