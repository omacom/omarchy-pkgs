{
  "source": "local",
  "auto_merge": true,
  "release_ring": "fast",
  "upstream": {
    "watch": {
      "regex": "https://static.ampcode.com/cli/cli-version.txt",
      "pattern": "^0\\.0\\.(?P<version>[0-9]+)-(?P<hash>g[0-9a-f]+)\\s*$",
      "version": "0.0.{version}",
      "variables": {
        "_hash": "{hash}"
      }
    }
  }
}
