#!/bin/bash

# facetimehd deadlocks hibernation inside the kernel's device freeze, hanging at "PM: hibernation: hibernation entry"
# before the image is written, so it is unloaded for the freeze and loaded again on resume. Suspend is unaffected.

marker=/run/facetimehd-unloaded-for-hibernate

case "$1" in
  pre)
    rm -f "$marker"
    if [[ $2 == hibernate || $2 == hybrid-sleep || $2 == suspend-then-hibernate ]] && [[ -d /sys/module/facetimehd ]]; then
      # Refused while an app has the camera open; unbinding instead could leave that app holding a freed device.
      if modprobe -r facetimehd; then
        touch "$marker"
      else
        echo "facetimehd: could not unload the camera driver before $2; close the app using the camera" >&2
      fi
    fi
    ;;
  post)
    # Only what pre unloaded comes back, so a driver the user removed stays removed.
    if [[ -e $marker ]]; then
      rm -f "$marker"
      modprobe facetimehd || echo "facetimehd: could not load the camera driver again after $2" >&2
    fi
    ;;
esac

exit 0
