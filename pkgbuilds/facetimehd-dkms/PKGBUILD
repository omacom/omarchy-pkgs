pkgname=facetimehd-dkms
# Upstream's master, which carries the suspend teardown fix (6e56ed8) and the calibration selection for sensor 0x248
# and the MacBook Air (06d4eea, 4506ac6) that the 0.7.2 tag lacks.
pkgver=0.7.2.r61.g4159eef
_commit=4159eef064e4170cbd94fd6c633cbd04bf589c4d
pkgrel=1
pkgdesc='Reverse engineered Linux driver for the FaceTime HD (Broadcom 1570) PCIe webcam'
url='https://github.com/patjak/facetimehd'
license=('GPL-2.0-only')
arch=('x86_64')
makedepends=('git')
provides=('bcwc-pcie' 'bcwc-pcie-dkms')
conflicts=('bcwc-pcie' 'bcwc-pcie-dkms')
# A resume whose reprobe fails otherwise leaves the PCI driver data pointing at freed memory.
source=("facetimehd::git+https://github.com/patjak/facetimehd.git#commit=${_commit}"
        '0001-Clear-the-PCI-driver-data-when-a-probe-fails-after-s.patch')
sha256sums=('ba4f1e2700374c16a5801a452dd7c9b0072922620feeaab9e37beb9424d36ea1'
            'cb212b0eaa440a325fbb39d21cb861f9f25603a44ccdcd6095327546da012172')

prepare() {
  patch -d facetimehd -Np1 -i "$srcdir/0001-Clear-the-PCI-driver-data-when-a-probe-fails-after-s.patch"

  # dkms no longer reads these keys, and the source directory must match the version dkms.conf names.
  sed -E -e '/^(CLEAN|MODULES_CONF)/d' -e "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"$pkgver\"/" -i facetimehd/dkms.conf
}

package() {
  # Declared here, so the build needs neither: the fetcher that provides facetimehd-firmware may not be published yet.
  depends=('dkms' 'facetimehd-firmware')

  cd facetimehd
  for file in dkms.conf Makefile *.[ch]; do
    install -Dm644 "$file" "$pkgdir/usr/src/facetimehd-$pkgver/$file"
  done
}
