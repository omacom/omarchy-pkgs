pkgname=facetimehd-dkms
pkgver=0.7.2
pkgrel=1
pkgdesc='Reverse engineered Linux driver for the FaceTime HD (Broadcom 1570) PCIe webcam'
url='https://github.com/patjak/facetimehd'
license=('GPL-2.0-only')
arch=('x86_64')
depends=('dkms' 'facetimehd-firmware')
makedepends=('git')
provides=('bcwc-pcie' 'bcwc-pcie-dkms')
conflicts=('bcwc-pcie' 'bcwc-pcie-dkms')
source=("facetimehd::git+https://github.com/patjak/facetimehd.git#tag=$pkgver"
        'facetimehd.sleep')
sha256sums=('43344654bcdaa7de115f5393bc737117e8fda6665eef9cdcabd1dceaa1687366'
            '28a14e157085e8d3f59b0f0a4c856f75d724ed4af97ea26918537b2d6d949ab3')

prepare() {
  # dkms no longer reads these keys, and the source directory must match the version dkms.conf names.
  sed -E -e '/^(CLEAN|MODULES_CONF)/d' -e "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"$pkgver\"/" -i facetimehd/dkms.conf
}

package() {
  cd facetimehd
  for file in dkms.conf Makefile *.[ch]; do
    install -Dm644 "$file" "$pkgdir/usr/src/facetimehd-$pkgver/$file"
  done
  install -Dm755 "$srcdir/facetimehd.sleep" "$pkgdir/usr/lib/systemd/system-sleep/facetimehd"
}
