From 31ee2208f82f669974255b2fa8b52745d28e7c04 Mon Sep 17 00:00:00 2001
From: omarchybot <omarchybot@users.noreply.github.com>
Date: Sat, 21 Nov 2026 23:13:50 +0100
Subject: [PATCH] Clear the PCI driver data when a probe fails after setting it

fthd_pci_init() publishes dev_priv as PCI driver data, and the probe's failure path frees dev_priv without clearing it. Resume calls the probe directly, so a resume that fails after that point leaves the driver data pointing at freed memory: the next suspend reads dev_priv->users from it and remove frees it again. Clear it on that path, and let remove return when nothing is bound rather than disabling a device the failed probe already disabled.
---
 fthd_drv.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/fthd_drv.c b/fthd_drv.c
index b85b44d..ad2a73e 100644
--- a/fthd_drv.c
+++ b/fthd_drv.c
@@ -323,8 +323,10 @@ static void fthd_pci_remove(struct pci_dev *pdev)
 	struct fthd_private *dev_priv;
 
 	dev_priv = pci_get_drvdata(pdev);
+	/* Nothing is bound after a probe failed, and that failure already
+	 * disabled the device. */
 	if (!dev_priv)
-		goto out;
+		return;
 	pci_set_drvdata(pdev, NULL);
 
 	fthd_debugfs_exit(dev_priv);
@@ -356,7 +358,6 @@ static void fthd_pci_remove(struct pci_dev *pdev)
 	pci_release_region(pdev, FTHD_PCI_S2_MEM);
 	pci_release_region(pdev, FTHD_PCI_ISP_IO);
 	kfree(dev_priv);
-out:
 	pci_disable_device(pdev);
 }
 
@@ -512,6 +513,9 @@ fail_hw:
 fail_buffer:
 	fthd_buffer_exit(dev_priv);
 fail_pci:
+	/* Resume probes again, so a failure here must not leave the PCI driver
+	 * data pointing at the state freed below for suspend and remove to use. */
+	pci_set_drvdata(pdev, NULL);
 	fthd_irq_uninstall(dev_priv);
 	pci_disable_msi(pdev);
 	pci_release_region(pdev, FTHD_PCI_S2_IO);
-- 
