# Audio DSP, GPU, video and modem firmware for the Lenovo 10w. The firmware only runs if it is
# signed for this board by Lenovo, so linux-firmware cannot carry it until the OEM submits it. The
# OEM ships it in its Windows driver download, which this recipe unpacks without running. Each
# file is checked against the SHA-256 it was matched to and installed under the name the device
# tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so once
# linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=lenovo-10w-firmware
pkgver=20261116
pkgrel=1
pkgdesc='Audio DSP, GPU, video and modem firmware for the Lenovo 10w'
arch=('aarch64')
url='https://download.lenovo.com/catalog/82ST_Win11.xml'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-sc7180-lenovo-82st')
makedepends=('7zip' 'innoextract')
options=('!strip' '!debug')
source=(
  'lenovo-jsqwh05.exe::https://download.lenovo.com/pccbbs/mobiles/jsqwh05.exe'
  'lenovo-jsvqh05.exe::https://download.lenovo.com/pccbbs/mobiles/jsvqh05.exe'
  'lenovo-jswqh04.exe::https://download.lenovo.com/pccbbs/mobiles/jswqh04.exe'
)
source+=('README.package.md')
noextract=('lenovo-jsqwh05.exe' 'lenovo-jsvqh05.exe' 'lenovo-jswqh04.exe')
sha256sums=('01bcfd3b5b7d478f577a9690f98f82baf8ee10e6cceaa4a4eaa4dca77752ec42' '8c1de7d469d84b56e1334be59b097abf0c65898fabbbee2b7528d9a22b094fbd' '2e0e133285ef6fb0350170255ccf8c0594ed83faccda38b5f8e04de201ab6ae1')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'lenovo-jsqwh05.exe' 'lenovo-jsqwh05' inno
  _unpack 'lenovo-jsvqh05.exe' 'lenovo-jsvqh05' inno
  _unpack 'lenovo-jswqh04.exe' 'lenovo-jswqh04' inno
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'lenovo-jsqwh05/code$GetExtractPath$/qcsubsys_ext_adsp7180/adspr.jsn' "$fw"/'qcom/sc7180/LENOVO/82ST/adspr.jsn'
  install -Dm644 'lenovo-jsqwh05/code$GetExtractPath$/qcsubsys_ext_adsp7180/adspua.jsn' "$fw"/'qcom/sc7180/LENOVO/82ST/adspua.jsn'
  install -Dm644 'lenovo-jsqwh05/code$GetExtractPath$/qcsubsys_ext_mpss7180/modemr.jsn' "$fw"/'qcom/sc7180/LENOVO/82ST/modemr.jsn'
  install -Dm644 'lenovo-jsqwh05/code$GetExtractPath$/qcsubsys_ext_mpss7180/modemuw.jsn' "$fw"/'qcom/sc7180/LENOVO/82ST/modemuw.jsn'
  install -Dm644 'lenovo-jsqwh05/code$GetExtractPath$/qcsubsys_ext_adsp7180/qcadsp7180.mbn' "$fw"/'qcom/sc7180/LENOVO/82ST/qcadsp7180.mbn'
  install -Dm644 'lenovo-jsvqh05/code$GetExtractPath$/qcdx7180/qcdxkmsuc7180.mbn' "$fw"/'qcom/sc7180/LENOVO/82ST/qcdxkmsuc7180.mbn'
  install -Dm644 'lenovo-jsqwh05/code$GetExtractPath$/qcsubsys_ext_mpss7180/qcmpss7180_nm.mbn' "$fw"/'qcom/sc7180/LENOVO/82ST/qcmpss7180_nm.mbn'
  install -Dm644 'lenovo-jsvqh05/code$GetExtractPath$/qcdx7180/qcvss7180.mbn' "$fw"/'qcom/sc7180/LENOVO/82ST/qcvss7180.mbn'
  install -Dm644 'lenovo-jswqh04/code$GetExtractPath$/qcwlan7180/WLANMDSP.MBN' "$fw"/'qcom/sc7180/LENOVO/82ST/wlanmdsp.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
2886c96e03e61c05dfed0de59451854a2aa0bc353c2a4a468ec339af70e3e8f0  qcom/sc7180/LENOVO/82ST/adspr.jsn
c75d16fc0805e5a0f51c6d0e0fcc315c09d5d2174d655fa038e9d9eb4217df2b  qcom/sc7180/LENOVO/82ST/adspua.jsn
68d946cbc26fecd262e042d03dca02fd42a3d10110327621ea7c17c73b53aed8  qcom/sc7180/LENOVO/82ST/modemr.jsn
b7e32e64c7f323dddbe8c687861c1f9d312191d306fbfee49ce404f80ce46807  qcom/sc7180/LENOVO/82ST/modemuw.jsn
f18245756a32b80fa3eced9f67501694f52c1910f7027486505442fc5c5b498a  qcom/sc7180/LENOVO/82ST/qcadsp7180.mbn
459c2ff362bf8dcc6ce8cefd31da1d521dfcbab0f4c5908c472df314438fdc0e  qcom/sc7180/LENOVO/82ST/qcdxkmsuc7180.mbn
a239f72b6c048a39684af204ffd19e90219817a803507758b9aa354c6fa692e7  qcom/sc7180/LENOVO/82ST/qcmpss7180_nm.mbn
2d518f86cf1a3bc76921e7e25c8cbd279786edda577a93fbed13771ed4bad89f  qcom/sc7180/LENOVO/82ST/qcvss7180.mbn
01cc452dac91ee13126fa49b8359f08c19cba13ff2e390c7ab34cd96042632c8  qcom/sc7180/LENOVO/82ST/wlanmdsp.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
