# Maintainer: Jethro Jones <jethro@jethrojones.com>

pkgname=quill-linux
pkgver=0.1.0
pkgrel=1
pkgdesc='Local two-track meeting recorder and transcriber'
arch=('x86_64')
url='https://github.com/jethrojones/quill-linux'
license=('MIT')
# ffmpeg records. libpulse provides pactl, which names the sink monitor.
# pipewire-pulse is the Pulse source ffmpeg records from. libnotify is
# notify-send. The binary links gcc-libs and glibc. sherpa-onnx is linked
# statically from the archive below.
depends=(
  'ffmpeg'
  'libpulse'
  'pipewire-pulse'
  'libnotify'
  'hicolor-icon-theme'
  'gcc-libs'
  'glibc'
)
# The rust package depends on cargo. A second makedepend is redundant.
makedepends=('rust')
provides=('quill')
conflicts=('quill')
# makepkg.conf enables debug and lto. Cargo strips the release binary and
# does its own codegen, and an empty -debug package trips namcap.
options=('!debug' '!lto')

# sherpa-onnx-sys 1.13.8 would download this during build() with no checksum.
# Ship it as a source and point build.rs at $srcdir. Do not extract it here:
# the crate copies and unpacks the archive itself.
_sherpa=sherpa-onnx-v1.13.8-linux-x64-static-lib.tar.bz2
# GitHub tag v0.1.0 extracts to quill-linux-0.1.0.
source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
  "https://github.com/k2-fsa/sherpa-onnx/releases/download/v1.13.8/$_sherpa"
)
noextract=("$_sherpa")
# The sherpa archive checksum is the file downloaded from the release above.
sha256sums=(
  '01da4631b097726d56fdf4af7c24f7ad5567dc1fcc8b9eb5d2e54bef4c63b656'
  'e1fdc5b67530e15741ef897fa5ffff297056f3bf0c6d829a27af9225a4c4b5a6'
)

prepare() {
  cd "$pkgname-$pkgver"

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"

  export RUSTUP_TOOLCHAIN=stable
  export SHERPA_ONNX_ARCHIVE_DIR="$srcdir"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/quill "$pkgdir/usr/bin/quill"

  install -Dm644 packaging/quill.desktop \
    "$pkgdir/usr/share/applications/quill.desktop"
  install -Dm644 packaging/quill.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/quill.png"
  install -Dm644 packaging/quill.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/quill.svg"
  install -Dm644 packaging/quill.service \
    "$pkgdir/usr/lib/systemd/user/quill.service"
  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
