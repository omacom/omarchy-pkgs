# Maintainer: ujo4eva <92157639+ujo4eva@users.noreply.github.com>

pkgname=artcraft-launcher-bin
_name=artcraft-launcher
pkgver=0.3.2
pkgrel=1
pkgdesc="Install, update and launch the Craft App Suite"
arch=('x86_64' 'aarch64')
url="https://github.com/storytold/craft-launcher"
license=('MIT OR Apache-2.0')
depends=('glibc' 'libgcc' 'hicolor-icon-theme' 'wayland' 'libxkbcommon' 'libxkbcommon-x11'
         'libx11' 'libxcursor' 'libxi' 'libglvnd')
optdepends=('flatpak: install Craft apps shipped as Flatpak bundles')
provides=("$_name")
conflicts=("$_name")
options=('!debug')
source_x86_64=("$url/releases/download/v$pkgver/$_name-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/$_name-$pkgver-linux-aarch64.tar.gz")
sha256sums_x86_64=('41c75725d93a1aac15d591fe441b814150ddc571180bba44871c5156993edda3')
sha256sums_aarch64=('4fdf460bf4b2685c1c15bad4b298989be078cd841700862c6207ab9f40247ef1')

package() {
  cd "$_name-$pkgver-linux-$CARCH"
  install -Dm755 "bin/$_name" "$pkgdir/usr/bin/$_name"
  cp -r --no-preserve=ownership share "$pkgdir/usr/"
  install -dm755 "$pkgdir/usr/share/licenses/$pkgname"
  mv "$pkgdir/usr/share/doc/$_name/LICENSE-"{APACHE,MIT} "$pkgdir/usr/share/licenses/$pkgname/"
}
