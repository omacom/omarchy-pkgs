# Apple-specific defaults, selected by the Apple installation profile.
pkgname=omarchy-settings-asahi
pkgver=1
pkgrel=1
pkgdesc='Omarchy Apple Silicon NetworkManager defaults'
arch=('aarch64')
url='https://github.com/omacom/omarchy'
license=('MIT')
depends=('omarchy-settings' 'networkmanager' 'iwd')
source=('wifi_backend.conf')
sha256sums=('654d07fff7855a7c51cf5c55478df12491e64dda5c87fbb14f1d44faf93419eb')

package() {
  # Vendor defaults allow /etc overrides without overwriting administrator files.
  install -Dm644 "$srcdir/wifi_backend.conf" "$pkgdir/usr/lib/NetworkManager/conf.d/wifi_backend.conf"
}
