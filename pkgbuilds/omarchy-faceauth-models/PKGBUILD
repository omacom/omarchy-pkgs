# Maintainer: Michael Ellis <mej2200@gmail.com>

# Payload package for omarchy-faceauth: the three ONNX models the daemon loads,
# taken as-is from the project's models-N GitHub release, where they sit with
# their licence texts and a NOTICE of the one conversion (the face mesh was
# converted from Google's TFLite file; the detector and the recogniser are the
# upstream files unmodified). pacman owns, verifies and removes them; nothing
# is downloaded at setup. The daemon's manifest, /usr/share/faceauth/models.toml
# in omarchy-faceauth, carries the same checksums, and `faceauth doctor`
# verifies the installed files against it.
#
# pkgver is the release number: models-1 is pkgver 1. A new release means a
# new set of files under a new number, never a changed file under the old one.

pkgname=omarchy-faceauth-models
pkgver=1
pkgrel=1
pkgdesc='Model weights for omarchy-faceauth: YuNet face detector, AuraFace recogniser and the MediaPipe face mesh, as ONNX'
arch=('any')
url='https://github.com/mellismas/omarchy-faceauth'
# YuNet is MIT; AuraFace-v1 and the MediaPipe face mesh are Apache-2.0.
license=('MIT' 'Apache-2.0')
options=('!strip' '!debug')
_release="$url/releases/download/models-$pkgver"
source=(
  "$_release/face_detection_yunet_2023mar.onnx"
  "$_release/glintr100.onnx"
  "$_release/face_landmark.onnx"
  "$_release/LICENSE.yunet"
  "$_release/LICENSE.auraface"
  "$_release/LICENSE.mediapipe"
  "$_release/NOTICE"
)
noextract=(
  'face_detection_yunet_2023mar.onnx'
  'glintr100.onnx'
  'face_landmark.onnx'
)
sha256sums=('8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4'
            'a7933ea5330113b01c9b60351d8f4c33003f145d8470ac5f0e52ee2effe25c60'
            '628e17ded45708571b8c6cb9da2438c32844cba8c3a9ed25e929fa9e318c5357'
            'c83b8120c50ccbd4c4f96edf53141bdd566ebb8f8e9227e415326aa1b1aba958'
            '609e2cb599f84aaa41d8ef29d8fdb04d164fab22e8d9292ca34a599d0f56a338'
            '8707eef0533987efc5b155d64761eeb6e20793f50b9bd1a68dad1cf4719d0ed8'
            '0b7de8851ff9962e09fe50de22d08db5c1cc6d91384091f6061e2c2884c970fe')

package() {
  # The daemon's default models_dir; the path is also the config.toml default
  # in omarchy-faceauth, so the two packages agree without either reading the other.
  install -Dm644 -t "$pkgdir/usr/share/faceauth/models" \
    face_detection_yunet_2023mar.onnx glintr100.onnx face_landmark.onnx

  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    LICENSE.yunet LICENSE.auraface LICENSE.mediapipe NOTICE
}
