# Maintainer: Jaycee Appi <appi.jaycee@gmail.com>
#
# Builds from the tagged source tarball rather than a prebuilt artifact, so the
# real-time audio module (a compiled QML plugin) is built for whatever
# architecture is being packaged - which is what makes 'aarch64' honest here.
#
# The build needs the npm registry: the TypeScript core is compiled by tsc and the
# QML app is assembled from it. The compiled JavaScript is deliberately NOT checked
# in, so the shipped JavaScript always corresponds to the TypeScript in the tag.
pkgname=exochronometer
pkgver=0.1.0
pkgrel=1
pkgdesc='Nested cycles of time as circles, inscribed geometry and just-intonation tones'
arch=('x86_64' 'aarch64')
url='https://github.com/alchemicAV/exochronometer-linux'
license=('MIT')
# qt6-multimedia carries both the buffer player and the QAudioSink the real-time
# module is built on.
depends=('qt6-declarative' 'qt6-multimedia' 'hicolor-icon-theme')
makedepends=('nodejs' 'npm' 'pkgconf' 'qt6-base' 'qt6-multimedia')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('4fb796365e9ad0eefe2e07de0e02ed1fb61a4cdfea1d80daa4f8d6a11b79f747')
# A single shared object, no debug symbols worth splitting.
options=('!debug')

build() {
  cd "exochronometer-linux-${pkgver}"

  npm ci --no-audit --no-fund
  ./node_modules/.bin/tsc
  node scripts/build-app.mjs
  bash scripts/build-audio.sh
}

package() {
  cd "exochronometer-linux-${pkgver}"

  install -dm755 "$pkgdir/usr/share/exochronometer"
  cp -r build/app/. "$pkgdir/usr/share/exochronometer/"

  # The real-time audio kernel, as a QML module. Qt finds it on the default import
  # path, so neither host needs an environment variable.
  install -dm755 "$pkgdir/usr/lib/qt6/qml/ExoAudio"
  install -Dm755 build/audio/ExoAudio/libexoaudio.so \
    "$pkgdir/usr/lib/qt6/qml/ExoAudio/libexoaudio.so"
  install -Dm644 build/audio/ExoAudio/qmldir \
    "$pkgdir/usr/lib/qt6/qml/ExoAudio/qmldir"

  install -Dm755 packaging/exochronometer.sh "$pkgdir/usr/bin/exochronometer"
  install -Dm644 packaging/exochronometer.desktop \
    "$pkgdir/usr/share/applications/exochronometer.desktop"
  install -Dm644 packaging/exochronometer.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/exochronometer.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/exochronometer/LICENSE"
}