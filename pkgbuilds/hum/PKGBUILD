# Maintainer: Mark Moore <markuz83@users.noreply.github.com>

pkgname=hum
pkgver=0.1.1
pkgrel=1
pkgdesc='Music player with a live spectrum visualizer, for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/markuz83/hum'
license=('MIT')
install='hum.install'
options=('!debug')
depends=(
  'ffmpeg'
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-multimedia'
  'qt6-wayland'
  'xdg-desktop-portal'
)
makedepends=(
  'gcc'
  'make'
)
optdepends=('qt6-imageformats: WebP and other cover image formats')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ca17ca484cda8bbf63c26c407737a8f60c5910aedbbe2fc5d86bdc58cca286cb')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/hum "$pkgdir/usr/bin/hum"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/hum.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/hum.svg"
  install -Dm644 pkgbuild/hum.desktop "$pkgdir/usr/share/applications/hum.desktop"

  # The Omarchy bar widget, which `hum plugin install` copies into place.
  for file in manifest.json BarWidget.qml Protocol.js README.md LICENSE; do
    install -Dm644 "omarchy-plugin/$file" "$pkgdir/usr/share/hum/omarchy-plugin/$file"
  done
}
