# Audio DSP, compute DSP, GPU and video firmware for the Dell Latitude 7455. The firmware only
# runs if it is signed for this board by Dell, so linux-firmware cannot carry it until the OEM
# submits it. The OEM ships it in its Windows driver download, which this recipe unpacks without
# running. Each file is checked against the SHA-256 it was matched to and installed under the name
# the device tree requests, compressed with xz. The kernel tries a plain name, then .zst, then
# .xz, so once linux-firmware ships the same file, its copy is the one loaded, and the two
# packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=dell-latitude-7455-firmware
pkgver=20261102
pkgrel=2
pkgdesc='Audio DSP, compute DSP, GPU and video firmware for the Dell Latitude 7455'
arch=('aarch64')
url='https://dl.dell.com/FOLDER15092611M/1/Qualcomm-Chipset-Driver_10WKV_WINARM64_2.1.0.26_A14.EXE'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1e80100-dell-latitude-7455')
makedepends=('7zip')
options=('!strip' '!debug')
# dl.dell.com turns away clients that do not name a browser.
DLAGENTS=('https::/usr/bin/curl -qgb "" -A Mozilla/5.0 -fLC - --retry 3 --retry-delay 3 -o %o %u')
source=(
  'dell-10wkv.exe::https://dl.dell.com/FOLDER15092611M/1/Qualcomm-Chipset-Driver_10WKV_WINARM64_2.1.0.26_A14.EXE'
  'dell-2chk7.exe::https://dl.dell.com/FOLDER14982355M/1/Qualcomm-Adreno-X1-85-X1-45-Graphics-Driver_2CHK7_WINARM64_31.0.170.0_A11.EXE'
)
noextract=('dell-10wkv.exe' 'dell-2chk7.exe')
sha256sums=('660911449915890acc94cfb49e23361ab7842f465d8eb94ce7fbaae8647bcfd2' 'c6daba34013c69cc7331dfd3d1be7eb10e8765f0d082ed1091e9dad8d46f4191')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'dell-10wkv.exe' 'dell-10wkv' 7z
  _unpack 'dell-2chk7.exe' 'dell-2chk7' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'dell-10wkv/16299/Drivers/arm64/qcsubsys_ext_adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1e80100/dell/latitude-7455/adsp_dtbs.elf'
  install -Dm644 'dell-10wkv/16299/Drivers/arm64/qcsubsys_ext_adsp8380/adspr.jsn' "$fw"/'qcom/x1e80100/dell/latitude-7455/adspr.jsn'
  install -Dm644 'dell-10wkv/16299/Drivers/arm64/qcsubsys_ext_adsp8380/adsps.jsn' "$fw"/'qcom/x1e80100/dell/latitude-7455/adsps.jsn'
  install -Dm644 'dell-10wkv/16299/Drivers/arm64/qcsubsys_ext_adsp8380/adspua.jsn' "$fw"/'qcom/x1e80100/dell/latitude-7455/adspua.jsn'
  install -Dm644 'dell-10wkv/16299/Drivers/arm64/qcsubsys_ext_adsp8380/battmgr.jsn' "$fw"/'qcom/x1e80100/dell/latitude-7455/battmgr.jsn'
  install -Dm644 'dell-10wkv/16299/Drivers/arm64/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1e80100/dell/latitude-7455/cdsp_dtbs.elf'
  install -Dm644 'dell-10wkv/16299/Drivers/arm64/qcnspmcdm_ext_cdsp8380/cdspr.jsn' "$fw"/'qcom/x1e80100/dell/latitude-7455/cdspr.jsn'
  install -Dm644 'dell-10wkv/16299/Drivers/arm64/qcsubsys_ext_adsp8380/qcadsp8380.mbn' "$fw"/'qcom/x1e80100/dell/latitude-7455/qcadsp8380.mbn'
  install -Dm644 'dell-10wkv/16299/Drivers/arm64/qcnspmcdm_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1e80100/dell/latitude-7455/qccdsp8380.mbn'
  install -Dm644 'dell-2chk7/16299/Drivers/MUP/qcdx8380/qcdxkmsuc8380.mbn' "$fw"/'qcom/x1e80100/dell/latitude-7455/qcdxkmsuc8380.mbn'
  install -Dm644 'dell-2chk7/16299/Drivers/MUP/qcdx8380/qcvss8380.mbn' "$fw"/'qcom/x1e80100/dell/latitude-7455/qcvss8380.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
a619c578fd609e29ed6c2bee324e7a2a99d447cd526718e59e09bdeed4047cff  qcom/x1e80100/dell/latitude-7455/adsp_dtbs.elf
549bb9c8e32dc6253d0d0ddde2ce5c26f75f8333d3e55861f297e169a9f3e5c0  qcom/x1e80100/dell/latitude-7455/adspr.jsn
12ac2f3ae8ced12aa4b06b3ab3a01bc4d8efe1c92ebea503c002f209a6ec176f  qcom/x1e80100/dell/latitude-7455/adsps.jsn
982a99853495e34726b8e44697fdfad303334de0a67cbf6cde306c8f1731000b  qcom/x1e80100/dell/latitude-7455/adspua.jsn
be8c6fba330908e4683fb6282761cb08485a302d6a66e09721e102e342f27236  qcom/x1e80100/dell/latitude-7455/battmgr.jsn
8eaa1bae6e3b4df0f2d42aa7fcaab324269e6ba7e83de32ce453e239d8acfe2d  qcom/x1e80100/dell/latitude-7455/cdsp_dtbs.elf
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x1e80100/dell/latitude-7455/cdspr.jsn
b8be5ec108ce2552df82730ea94f507eb84845f925a427b78cda85916ea2eb28  qcom/x1e80100/dell/latitude-7455/qcadsp8380.mbn
352fb65e5578995919b782716de3ff033a1e8c97ebe65d795506d2347ab8b9c7  qcom/x1e80100/dell/latitude-7455/qccdsp8380.mbn
f42fd3c7581650dacae1682db1a2b0c9e07b0237d17cdcc27efb85767b319e2c  qcom/x1e80100/dell/latitude-7455/qcdxkmsuc8380.mbn
38b88f6050459e03e6c3b8c160bb3b3b09312c9e30ce9edca5103b943f928f71  qcom/x1e80100/dell/latitude-7455/qcvss8380.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +
}
