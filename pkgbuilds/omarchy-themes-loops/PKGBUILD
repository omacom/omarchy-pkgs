# Maintainer: David Heinemeier Hansson <david@hey.com>
pkgname='omarchy-themes-loops'
pkgver=2026.11.09
pkgrel=1
# The live background loops are videos like the theme intros, and ship the
# same way: on their own, so omarchy-dev rebuilds each quattro tip without
# them. Pinned by hand to the last commit that touched a loop and versioned by
# that commit's date: bump both when a loop is added or changed. Until then a
# new loop is simply not played, since a background without one stays on its
# still.
_commit=0000000000000000000000000000000000000000
pkgdesc='Live background loop videos for the Omarchy themes'
arch=('any')
url='https://github.com/omacom/omarchy'
license=('MIT')
makedepends=('git')
source=("omarchy::git+https://github.com/omacom/omarchy.git#commit=${_commit}")
sha256sums=('SKIP')

package() {
  cd "$srcdir/omarchy"

  local loops
  for loops in themes/*/backgrounds/loops; do
    install -d "$pkgdir/usr/share/omarchy/$loops"
    cp -a "$loops/." "$pkgdir/usr/share/omarchy/$loops/"
  done
}
