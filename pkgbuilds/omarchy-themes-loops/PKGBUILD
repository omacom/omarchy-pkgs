# Maintainer: David Heinemeier Hansson <david@hey.com>
pkgname='omarchy-themes-loops'
pkgver=2026.11.18
pkgrel=1
# The live background loops live in their own repository, as the intros do, so
# omarchy and each omarchy-dev rebuild of a quattro tip stay small. Pinned by
# hand to a commit there and versioned by its date: bump both when a loop is
# added or changed. Until then a new loop is simply not played, since a
# background without one stays on its still.
_commit=9957bd73e0687fed1e5b6b577756f5ade4dd7ff0
pkgdesc='Live background loops for the Omarchy themes'
arch=('any')
url='https://github.com/omacom/omarchy-themes-loops'
license=('MIT')
makedepends=('git')
source=("loops::git+https://github.com/omacom/omarchy-themes-loops.git#commit=${_commit}")
sha256sums=('741882512c79fea86e13c28c6169efdc9583264d675ef906a38b0b96ae230511')

package() {
  cd "$srcdir/loops"

  local loop theme
  for loop in */*.mp4; do
    theme=${loop%%/*}
    install -Dm644 "$loop" "$pkgdir/usr/share/omarchy/themes/$theme/backgrounds/loops/${loop#*/}"
  done
}
