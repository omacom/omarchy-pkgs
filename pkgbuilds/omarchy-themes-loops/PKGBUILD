# Maintainer: David Heinemeier Hansson <david@hey.com>
pkgname='omarchy-themes-loops'
pkgver=2026.11.22
pkgrel=1
pkgdesc='Live background loops for the Omarchy themes'
arch=('any')
url='https://github.com/omacom/omarchy-themes-loops'
license=('MIT')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('9d21165c0bb5921db036ca2c3f707815ff4fa2c5d82141bd25cef741a49d74c2')

package() {
  cd "$srcdir/$pkgname-$pkgver"

  local loop theme
  for loop in */*.mp4; do
    theme=${loop%%/*}
    install -Dm644 "$loop" "$pkgdir/usr/share/omarchy/themes/$theme/backgrounds/loops/${loop#*/}"
  done
}
