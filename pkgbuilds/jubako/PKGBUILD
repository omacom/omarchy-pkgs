# Maintainer: Tim Apple <179739321+ninepointlabs@users.noreply.github.com>

# Pure Python on top of the system PySide6, so the package is arch-independent.
# Upstream tags releases on GitHub without a checksum manifest; the git_tags
# provider in .omarchy/package.json follows those tags and hashes this tarball.
# Jubako was published here as omarchy-db before the upstream rename, so it
# replaces that package and existing installs upgrade to jubako.

pkgname=jubako
pkgver=0.4.7
pkgrel=1
pkgdesc='Simple desktop database for Omarchy, in the spirit of Microsoft Access (GUI, CLI and MCP server)'
arch=('any')
url='https://github.com/ninepointlabs/jubako'
license=('MIT')
depends=('python' 'pyside6' 'qt6-declarative' 'hicolor-icon-theme')
optdepends=('python-openpyxl: Excel (.xlsx) import and export'
            'python-psycopg: PostgreSQL connections'
            'python-pymysql: MySQL and MariaDB connections')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-hatchling')
checkdepends=('desktop-file-utils')
replaces=('omarchy-db')
conflicts=('omarchy-db')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('1325b60405ccbeb3cd24593be1f424774d6dd0d9078a2975eacbe48a3d119a68')

build() {
  cd "jubako-${pkgver}"
  python -m build --wheel --no-isolation
}

check() {
  cd "jubako-${pkgver}"
  desktop-file-validate packaging/jubako.desktop
}

package() {
  cd "jubako-${pkgver}"
  python -m installer --destdir="${pkgdir}" dist/*.whl

  # The desktop entry, icon, MIME type and AppStream metadata live in the
  # upstream tree; the wheel does not carry them, so install them beside the
  # console scripts it provides.
  install -Dm644 packaging/jubako.desktop "${pkgdir}/usr/share/applications/jubako.desktop"
  install -Dm644 packaging/jubako.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/jubako.svg"
  install -Dm644 packaging/jubako-mime.xml "${pkgdir}/usr/share/mime/packages/jubako.xml"
  install -Dm644 packaging/jubako.appdata.xml "${pkgdir}/usr/share/metainfo/jubako.appdata.xml"

  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
