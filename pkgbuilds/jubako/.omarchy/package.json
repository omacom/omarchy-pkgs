{
  "source": "local",
  "upstream": {
    "git_tags": "https://github.com/ninepointlabs/jubako.git",
    "tag_pattern": "v{pkgver}",
    "sources": {
      "any": [
        "https://github.com/ninepointlabs/jubako/archive/refs/tags/{tag}.tar.gz"
      ]
    }
  },
  "rebuild_on": [
    "python"
  ],
  "rebuilt_against": {
    "x86_64": {
      "python": "3.14.10-1"
    },
    "aarch64": {
      "python": "3.14.10-1"
    }
  }
}
