# Maintainer: Omarchy <packages@omarchy.org>
#
# Kernel drivers for the Intel IPU7 imaging unit, as DKMS. Split out of
# intel-ipu7-camera so that machines which cannot use Intel's CamHAL can still
# get the ISYS pipeline without dragging in the HAL, icamerasrc, the camera
# bins and v4l2-relayd.
#
# The IPU7 has no in-tree driver: mainline drivers/media/pci/intel/ carries
# ipu3, ipu6 and ivsc only. Anything that wants frames off this hardware needs
# these modules.

pkgname=intel-ipu7-drivers
pkgver=1.0.5
pkgrel=1
pkgdesc="Intel IPU7 ISYS/PSYS and CVS kernel drivers (DKMS)"
arch=('x86_64')
url="https://github.com/intel/ipu7-drivers"
license=('GPL-2.0-or-later')
depends=('dkms' 'linux-headers')
makedepends=('git')
options=('!strip')
# Any other packaging of ipu7-drivers writes the same intel-ipu7.ko into
# /updates, and DKMS lets the last install win with no warning. That is not
# theoretical: on this hardware the AUR intel-ipu7-dkms-git and this tree were
# both registered, a kernel upgrade reinstalled them in the opposite order to
# the previous boot, and the AUR build -- compiled without
# CONFIG_INTEL_IPU_ACPI, which gates the whole v4l2-async notifier in
# ipu7-isys.c -- silently won. The camera went black with no error anywhere:
# the sensor probed cleanly, the bridge created its endpoints, and nothing was
# left to bind them together.
#
# Declaring the conflict makes pacman refuse the combination instead.
conflicts=('intel-ipu7-dkms-git')

# Pinned to the same commits intel-ipu7-camera used before the split, so the
# DKMS trees and their build output are unchanged.
_ipu7_drivers_commit="a88b19096a738d0708742a78d6540d6d4a3021ff"
_vision_drivers_commit="a8d772f261bc90376944956b7bfd49b325ffa2f2"

source=(
  "ipu7-drivers::git+https://github.com/intel/ipu7-drivers.git#commit=${_ipu7_drivers_commit}"
  "vision-drivers::git+https://github.com/intel/vision-drivers.git#commit=${_vision_drivers_commit}"
  "0003-icvs-set-rgbcamera_pwrup_host-0-for-Panther-Lake.patch"
  "0004-ipu7-psys-register-device-bus.patch"
  "dkms-ipu7-drivers.conf"
  "dkms-vision-drivers.conf"
  "71-ipu7-hide-isys.rules"
  "90-ipu7-psys.rules"
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

prepare() {
  cd "${srcdir}/ipu7-drivers"
  patch -Np1 -i "${srcdir}/0004-ipu7-psys-register-device-bus.patch"

  cd "${srcdir}/vision-drivers"
  git config user.email "build@localhost"
  git config user.name "Build"
  if ! git log --oneline -1 | grep -q "rgbcamera_pwrup_host"; then
    git am "${srcdir}/0003-icvs-set-rgbcamera_pwrup_host-0-for-Panther-Lake.patch"
  fi
}

package() {
  # DKMS: IPU7 drivers (ISYS + PSYS + ACPI)
  local ipu7_dkms_dir="${pkgdir}/usr/src/ipu7-drivers-${pkgver}"
  install -dm755 "${ipu7_dkms_dir}"
  cp -r "${srcdir}/ipu7-drivers/"* "${ipu7_dkms_dir}/"
  rm -rf "${ipu7_dkms_dir}/.git"
  install -Dm644 "${srcdir}/dkms-ipu7-drivers.conf" "${ipu7_dkms_dir}/dkms.conf"
  sed -i "s/@PKGVER@/${pkgver}/" "${ipu7_dkms_dir}/dkms.conf"

  # DKMS: Vision drivers (CVS)
  local cvs_dkms_dir="${pkgdir}/usr/src/vision-drivers-${pkgver}"
  install -dm755 "${cvs_dkms_dir}"
  cp -r "${srcdir}/vision-drivers/"* "${cvs_dkms_dir}/"
  rm -rf "${cvs_dkms_dir}/.git"
  install -Dm644 "${srcdir}/dkms-vision-drivers.conf" "${cvs_dkms_dir}/dkms.conf"
  sed -i "s/@PKGVER@/${pkgver}/" "${cvs_dkms_dir}/dkms.conf"

  # udev rules. Both belong to the driver rather than to any one camera stack:
  # the raw ISYS nodes and the psys character device exist as soon as these
  # modules load, whatever consumes them afterwards.
  install -Dm644 "${srcdir}/71-ipu7-hide-isys.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/71-ipu7-hide-isys.rules"
  install -Dm644 "${srcdir}/90-ipu7-psys.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/90-ipu7-psys.rules"
}
