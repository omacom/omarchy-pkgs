{
  "source": "local",
  "release_ring": "fast",
  "min_release_age": "24h",
  "upstream": {
    "github": "terraphim/terraphim-clients",
    "digests": true,
    "latest_only": true,
    "assets": {
      "x86_64": [
        "terraphim-agent-{pkgver}-x86_64-unknown-linux-musl.tar.gz",
        "terraphim-grep-{pkgver}-x86_64-unknown-linux-musl.tar.gz"
      ],
      "aarch64": [
        "terraphim-agent-{pkgver}-aarch64-unknown-linux-musl.tar.gz",
        "terraphim-grep-{pkgver}-aarch64-unknown-linux-musl.tar.gz"
      ]
    }
  }
}
