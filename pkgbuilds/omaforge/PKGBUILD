# Maintainer: Tim Apple <179739321+ninepointlabs@users.noreply.github.com>
pkgname=omaforge
pkgver=0.2.4
pkgrel=1
pkgdesc='World of Warcraft addon manager for Omarchy (CurseForge, WoWInterface, GitHub)'
arch=('any')
url='https://github.com/ninepointlabs/omaforge'
license=('MIT')
depends=(
  'hicolor-icon-theme'
  'python>=3.11'
  'pyside6'
  'qt6-declarative'
  'qt6-svg'
  'xdg-utils'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
checkdepends=('python-pytest')
optdepends=(
  'libnotify: desktop notifications from `omaforge update --notify`'
  'xdg-desktop-portal: native file and folder pickers'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('7f17941e14e2843305d1a0a35c394a58711b6d674c1c1477dec65ef640eb337c')

build() {
  cd "$pkgname-$pkgver"
  # Built without omaforge's own CurseForge API key (upstream's release
  # packages embed it). Users add a key under Settings or in
  # ~/.config/omaforge/config.toml; WoWInterface and GitHub need none.
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  QT_QPA_PLATFORM=offscreen python -m pytest -q
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/omaforge.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 omaforge/ui/icons/omaforge.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaforge.svg"
  install -Dm644 packaging/omaforge-update.service packaging/omaforge-update.timer -t "$pkgdir/usr/lib/systemd/user/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
