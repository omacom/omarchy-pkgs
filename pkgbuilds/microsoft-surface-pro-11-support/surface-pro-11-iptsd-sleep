#!/bin/bash

# The touch controller resets its firmware during resume ("Spontaneous FW
# reset!") and a running iptsd never recovers, so stop iptsd before sleep and
# start a fresh one after.

compatible=${SP11_IPTSD_COMPATIBLE:-/proc/device-tree/compatible}
state=${SP11_IPTSD_STATE:-/run/surface-pro-11-iptsd.units}

[[ -r $compatible ]] && tr '\0' '\n' <"$compatible" | grep -qx 'microsoft,denali-oled' || exit 0

case ${1:-} in
  pre)
    mapfile -t units < <(systemctl list-units --state=active --plain --no-legend 'iptsd@*.service' | awk '{print $1}')
    (( ${#units[@]} )) || exit 0
    printf '%s\n' "${units[@]}" >"$state"
    systemctl stop "${units[@]}"
    ;;
  post)
    [[ -f $state ]] || exit 0
    mapfile -t units <"$state"
    rm -f "$state"
    sleep "${SP11_IPTSD_SETTLE:-1}"
    systemctl start "${units[@]}"
    ;;
esac
