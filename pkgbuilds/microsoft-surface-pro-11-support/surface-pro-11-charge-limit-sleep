#!/bin/bash

# The Surface Pro 11's battery firmware can drop its charge window across
# suspend while the kernel driver still reports the thresholds that were set.
# After resume, write those same thresholds back. This never chooses a limit:
# UPower or Omarchy's power settings do. With no limit set, it does nothing.
# (The kernel driver restores the window itself when the battery-manager
# service restarts; it cannot see a loss across suspend.)

[[ ${1:-} == post ]] || exit 0

compatible=${SP11_CHARGE_LIMIT_COMPATIBLE:-/proc/device-tree/compatible}
battery=${SP11_CHARGE_LIMIT_SYSFS:-/sys/class/power_supply/qcom-battmgr-bat}
start_path=$battery/charge_control_start_threshold
end_path=$battery/charge_control_end_threshold

[[ -r $compatible ]] && tr '\0' '\n' <"$compatible" | grep -qx 'microsoft,denali-oled' || exit 0
[[ -w $start_path && -w $end_path ]] || exit 0

start=$(<"$start_path")
end=$(<"$end_path")
[[ $start =~ ^[0-9]+$ && $end =~ ^[0-9]+$ ]] || exit 0
(( end > 0 && end < 100 && start < end )) || exit 0

# End first: the driver derives the window from the end threshold.
if printf '%s\n' "$end" >"$end_path" && printf '%s\n' "$start" >"$start_path"; then
  echo "surface-pro-11-charge-limit: restored start=$start end=$end"
else
  echo "surface-pro-11-charge-limit: could not restore start=$start end=$end" >&2
fi
