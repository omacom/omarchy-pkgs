# Surface Pro 11 Flex Keyboard touchpad over Bluetooth (keyboard detached).
# udev tags it external, and libinput turns off all palm detection on external
# touchpads unless they sit below the keys of a keyboard combo, which this one
# does. Attached, the same touchpad is internal and already has it. Like the
# attached one (30-vendor-microsoft.quirks, 0x0C8D), it is a clickpad that also
# advertises a right button.
[Microsoft Surface Flex Keyboard Touchpad (Bluetooth)]
MatchBus=bluetooth
MatchVendor=0x045E
MatchProduct=0x0C7A
MatchUdevType=touchpad
AttrTPKComboLayout=below
AttrEventCode=-BTN_RIGHT
