# VA-API driver with Apple Video Decoder fixes from the maintained iconidentify fork.
# The asahi alias lets libva discover it on Apple Silicon.

_fork=iconidentify
_commit=5b5046cbda6892f4a63df0015857a80bd42c17cf
pkgname=libva-v4l2_request-avd
pkgver=1.3.r11.r164.g5b5046c
pkgrel=1
pkgdesc='VA-API driver for V4L2 stateless decoders, with Apple Video Decoder (AVD) support'
arch=('aarch64')
url="https://github.com/$_fork/libva-v4l2_request"
license=('GPL-3.0-or-later')
# The plugin links libva and libc; rebuild when libva's driver ABI changes.
# libdrm supplies compile-time format constants.
depends=('glibc' 'libva>=2.24' 'libva<3')
makedepends=('meson' 'libdrm')
checkdepends=('python')
provides=('libva-v4l2_request')
conflicts=('libva-v4l2_request')
install="$pkgname.install"
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('27cfdede20222c8808396b09369011c5fe092960591b736c4128d7c78c510462')

build() {
  # driverdir is left unset so meson takes it from libva's pkg-config
  # (/usr/lib/dri); the codec set is decided by configure-time checks against
  # the kernel uapi headers, so linux-api-headers governs what gets built in.
  # Plain meson rather than arch-meson: the latter lives in devtools, which is
  # not a safe assumption outside a clean chroot. buildtype=plain hands the
  # compiler makepkg's own CFLAGS/LDFLAGS, which is what arch-meson does too.
  meson setup \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode=nodownload \
    "libva-v4l2_request-$_commit" build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"

  # libva picks its driver from the DRM driver name of the render node, which
  # on Apple Silicon is "asahi", so it looks for asahi_drv_video.so. Nothing
  # else ships that name (mesa provides no VA driver for asahi), so aliasing it
  # here makes every VA-API application find the decoder with no environment
  # variable at all. If mesa ever ships its own asahi_drv_video.so this will
  # collide and pacman will say so at install time.
  ln -sf v4l2_request_drv_video.so "$pkgdir/usr/lib/dri/asahi_drv_video.so"

  install -Dm644 "libva-v4l2_request-$_commit/COPYING" \
    "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 "libva-v4l2_request-$_commit/README" \
    "$pkgdir/usr/share/doc/$pkgname/README"
}
