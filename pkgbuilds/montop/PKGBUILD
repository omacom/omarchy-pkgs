# Maintainer: Christophe Vanlancker <carroarmato0@gmail.com>

pkgname=montop
pkgver=0.5.2
pkgrel=1
pkgdesc='A system monitor for Omarchy that shows apps, not just processes'
arch=('x86_64' 'aarch64')
url='https://github.com/carroarmato0/montop'
license=('MIT')
install='montop.install'
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'hwdata'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
  'systemd'
)
makedepends=(
  'gcc'
  'make'
  'qt6-base'
  'qt6-declarative'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('8cdf7eac60c9f638286cd0b836ffa798b127169f661ab21808e61ba01bd63802')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/test
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/montop "$pkgdir/usr/bin/montop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/montop.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/montop.svg"
  install -Dm644 pkgbuild/montop.desktop "$pkgdir/usr/share/applications/montop.desktop"
  install -Dm644 src/skill.md "$pkgdir/usr/share/montop/skills/montop/SKILL.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
