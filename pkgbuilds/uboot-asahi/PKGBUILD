prepare() {
  cd "${srcdir}/$_srcname"

  cat ../disable-VBE-by-default.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../enable-bootmenu-by-default.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../uefi-distro-load-FDT-from-any-partition-on-boot-device.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../uefi-Add-all-options-for-EFI-System-Partitions.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../uefi-initial-find_fdt_location-for-finding-the-DT-on-disk.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../uefi-enable-SetVariableRT-with-volotile-storage.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../uefi-enable-https-boot-by-default.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../pylibfdt-Replace-removed-SWIG-Python-2-compatibility-macros.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../USB-PD-TCPM-improvements.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../rockchip-Enable-preboot-start-for-pci-usb.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../rockchip-rk3568-nanopi-r5-Drop-duplicated-extra-sdhc.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../rockchip-rk356x-Stop-overriding-sdhci-mmc-aliases.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../p3450-fix-board.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../JetsonTX2-Fix-upstream-device-tree-naming.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../Allwinner-fix-booting-on-a-number-of-devices.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../Fix-NVMe-not-only-on-Raspberry-Pi-5.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../raspberrypi-Add-quirk-for-RPi5-2Gb-rev-1.0.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../openssl-no-engine.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../quiet-console.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f

  make apple_m1_defconfig
  scripts/config --file .config \
    -e OF_UPSTREAM_BUILD_VENDOR \
    --set-str OF_UPSTREAM_VENDOR apple
  # Silent console: nothing on the panel or the serial port from U-Boot
  # itself (the banner, the environment load, the bootflow scan). The
  # environment's silent=1 applies from relocation on; the console stays
  # muted until that environment is read. The kernel's console is not
  # touched, and the U-Boot logo is not drawn. No boot delay: with nothing
  # shown there is nothing to interrupt.
  scripts/config --file .config \
    -e SILENT_CONSOLE \
    -e SILENT_CONSOLE_UPDATE_ON_SET \
    -e SILENT_CONSOLE_UPDATE_ON_RELOC \
    -e SILENT_CONSOLE_UNTIL_ENV \
    -e SILENT_U_BOOT_ONLY \
    -d VIDEO_LOGO \
    --set-val BOOTDELAY 0
  make olddefconfig
}

build() {
  cd "${srcdir}/$_srcname"
  make
}

package() {
  cd "${srcdir}"

  tgtdir="$pkgdir/usr/lib/asahi-boot"
  dtbdir="$_srcname/dts/upstream/src/arm64/apple"

  install -Dt "$tgtdir" -m644 "$_srcname/u-boot-nodtb.bin"
  install -d "$tgtdir/dtb"

  # Exclude known non-Apple-Silicon DT families:
  # t7000: A8-based iPhone 6 / 6 Plus
  # t7001: A8X-based iPad Air 2
  # t8010: A10-based iPhone 7 / 7 Plus, iPad 6 / 7, iPod touch 7
  # t8011: A10X-based Apple TV 4K (1st gen), iPad Pro 10.5 / 12.9 (2nd gen)
  # t8012: T2-based Intel Macs
  # t8015: A11-based iPhone 8 / 8 Plus / X
  find "$dtbdir" -maxdepth 1 -type f -name 't*.dtb' \
    ! -name 't7000-*.dtb' \
    ! -name 't7001-*.dtb' \
    ! -name 't8010-*.dtb' \
    ! -name 't8011-*.dtb' \
    ! -name 't8012-*.dtb' \
    ! -name 't8015-*.dtb' \
    -exec install -m644 -t "$tgtdir/dtb" {} +
}
