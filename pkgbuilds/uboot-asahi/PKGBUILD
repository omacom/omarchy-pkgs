# Omarchy's uboot-asahi: asahi-alarm's uboot-asahi (asahi-alarm/PKGBUILDs)
# with a silent console, no banner, no logo and no boot delay, so the Mac
# boots straight to the boot menu and the splash without U-Boot's text.
#
# Same name as asahi-alarm's, and nothing generic depends on it: it is only
# installed when named, or as an upgrade of an installed uboot-asahi.
# pacman takes a package from the first repository that carries its name:
# with [omarchy] ahead of [asahi-alarm] this build is installed and kept even
# after asahi-alarm moves on; with [asahi-alarm] ahead it is installed only as
# omarchy/uboot-asahi, kept over their build at the same pkgver, and replaced
# by a newer one. Keep pkgver and the patch set in step with asahi-alarm's and
# pkgrel above theirs. No epoch, which would outrank every future asahi-alarm
# release.

pkgname=uboot-asahi
_ver=2026.07
_asahirel=2

pkgver=${_ver}.asahi${_asahirel}
pkgrel=5
pkgdesc='U-Boot for Apple Silicon Macs (Omarchy build: silent console)'
_commit_id=asahi-v${_ver}-${_asahirel}
_srcname=u-boot-${_commit_id}
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='http://asahilinux.org'
license=('MIT' 'GPL2')
makedepends=( bc imagemagick )
source=(
  "u-boot-${_commit_id}.tar.gz::https://github.com/AsahiLinux/u-boot/archive/${_commit_id}.tar.gz"
  'disable-VBE-by-default.patch'
  'enable-bootmenu-by-default.patch'
  'uefi-distro-load-FDT-from-any-partition-on-boot-device.patch'
  'uefi-Add-all-options-for-EFI-System-Partitions.patch'
  'uefi-initial-find_fdt_location-for-finding-the-DT-on-disk.patch'
  'uefi-enable-SetVariableRT-with-volotile-storage.patch'
  'uefi-enable-https-boot-by-default.patch'
  'pylibfdt-Replace-removed-SWIG-Python-2-compatibility-macros.patch'
  'USB-PD-TCPM-improvements.patch'
  'rockchip-Enable-preboot-start-for-pci-usb.patch'
  'rockchip-rk3568-nanopi-r5-Drop-duplicated-extra-sdhc.patch'
  'rockchip-rk356x-Stop-overriding-sdhci-mmc-aliases.patch'
  'p3450-fix-board.patch'
  'JetsonTX2-Fix-upstream-device-tree-naming.patch'
  'Allwinner-fix-booting-on-a-number-of-devices.patch'
  'Fix-NVMe-not-only-on-Raspberry-Pi-5.patch'
  'raspberrypi-Add-quirk-for-RPi5-2Gb-rev-1.0.patch'
  'openssl-no-engine.patch'
  'quiet-console.patch'
)
