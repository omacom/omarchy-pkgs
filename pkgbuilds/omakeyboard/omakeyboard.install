post_install() {
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor >/dev/null 2>&1 || true
  update-desktop-database -q >/dev/null 2>&1 || true
}

post_upgrade() {
  post_install
}

post_remove() {
  post_install

  cat <<'MESSAGE'
OmaKeyboard has been removed, but the configuration it generated is still in place:

  ~/.config/omakeyboard/          your rules and the generated data
  ~/.config/hypr/omakeyboard.lua  the loader
  ~/.local/state/omakeyboard/     generated keymaps and backups

and hyprland.lua still requires the loader. To undo all of that, run
"Restore defaults" in the app before uninstalling, or remove the block
marked OmaKeyboard from ~/.config/hypr/hyprland.lua by hand.
MESSAGE
}
