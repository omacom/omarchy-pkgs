pkgname=tql-bin
pkgver=0.5.0
pkgrel=1
pkgdesc='A database client for the terminal'
arch=('x86_64' 'aarch64')
url='https://github.com/VheissuLabs/tql'
license=('MIT')
depends=()
provides=('tql')
conflicts=('tql')
options=('!strip' '!debug')

source_x86_64=("${pkgname}_${pkgver}_x86_64::${url}/releases/download/v${pkgver}/tql-linux-x86_64")
sha256sums_x86_64=('c9f99355cf9eca99c10b7b65d402355d980c51133ed5f21ee3ef93c188b88ce9')

source_aarch64=("${pkgname}_${pkgver}_aarch64::${url}/releases/download/v${pkgver}/tql-linux-aarch64")
sha256sums_aarch64=('bf603bb03699c7183f05372f8ee8f85a955f05d9efe79df9ec3b46c3d230c1cc')

package() {
  install -Dm755 "${srcdir}/${pkgname}_${pkgver}_${CARCH}" "${pkgdir}/usr/bin/tql"
}
