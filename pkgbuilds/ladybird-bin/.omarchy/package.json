{
  "source": "local",
  "auto_merge": true,
  "release_ring": "fast",
  "upstream": {
    "watch": {
      "debian": "https://apt.ladybird.org/dists/noble/main/binary-amd64/Packages",
      "package": "ladybird",
      "pattern": "(?P<version>[0-9]+(?:\\.[0-9]+)*)-(?P<revision>[0-9]+)~ubuntu24\\.04",
      "variables": {
        "_debrev": "{revision}"
      },
      "revision": "{revision}",
      "revision_variable": "_debrev"
    }
  }
}
