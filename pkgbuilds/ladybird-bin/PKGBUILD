# Maintainer: Ryan Hughes <ryan@omarchy.org>

# Ladybird's own Linux build, from the Ubuntu 24.04 .debs on
# https://ladybird.org/download/. It bundles Qt, FFmpeg, ICU and its other
# libraries in /opt/ladybird/lib and asks only for glibc 2.39, so the same
# files run on Arch. .omarchy/package.json watches the apt index and rewrites
# pkgver, _debrev and the checksums below.

pkgname=ladybird-bin
pkgver=2026.47.7
pkgrel=1
_debrev=1
pkgdesc='Truly independent web browser (alpha)'
arch=('x86_64' 'aarch64')
url='https://ladybird.org'
# Ladybird itself, and the libraries it bundles: Qt and libidn2/libunistring
# (LGPL), FFmpeg (LGPL), ICU (Unicode).
license=('BSD-2-Clause' 'LGPL-3.0-only' 'LGPL-2.1-or-later' 'Unicode-3.0')
# What the binaries link outside /opt/ladybird/lib, and the fonts the deb
# asks for. Fontconfig is built in, but reads /etc/fonts/fonts.conf.
depends=(
  'fontconfig'
  'glib2'
  'glibc'
  'libatomic'
  'libdrm'
  'libgcc'
  'libglvnd'
  'libpulse'
  'libstdc++'
  'libx11'
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'ttf-liberation'
  'vulkan-icd-loader'
  'wayland'
  'xcb-util'
  'xcb-util-cursor'
  'xcb-util-image'
  'xcb-util-keysyms'
  'xcb-util-renderutil'
  'xcb-util-wm'
)
# The bundled FFmpeg is built for Ladybird's own codecs. Like the deb's
# Recommends, a system libavcodec adds the rest.
optdepends=('ffmpeg: more video and audio codecs')
makedepends=('libarchive')
provides=('ladybird')
conflicts=('ladybird')
options=('!strip' '!debug')

_deb="ladybird_${pkgver}-${_debrev}~ubuntu24.04"
_pool='https://apt.ladybird.org/pool/main/l/ladybird'
source=("ladybird-${pkgver}-LICENSE::https://raw.githubusercontent.com/LadybirdBrowser/ladybird/${pkgver}/LICENSE")
source_x86_64=("ladybird-${pkgver}-${_debrev}-x86_64.deb::${_pool}/${_deb}_amd64.deb")
source_aarch64=("ladybird-${pkgver}-${_debrev}-aarch64.deb::${_pool}/${_deb}_arm64.deb")
noextract=("ladybird-${pkgver}-${_debrev}-x86_64.deb" "ladybird-${pkgver}-${_debrev}-aarch64.deb")
sha256sums=('275f18944ac7ba41acabbb468387c1c9e8e2f81f7d49e6442dafe37c25ffeea7')
sha256sums_x86_64=('67e33f0a234b672734b8965ea7dd5c63c8f0b616313b91d43522c53ad686b1d4')
sha256sums_aarch64=('7550a3a13f6a5455a00422017423f3a8c6e995fd6843806bb841fc5c5bd4949c')

package() {
  bsdtar -xOf "${srcdir}/ladybird-${pkgver}-${_debrev}-${CARCH}.deb" 'data.tar.*' |
    bsdtar --no-same-owner -xf - -C "${pkgdir}"

  # share/Lagom/package-format stays. It tells Ladybird's update check that
  # a package manager installed it. That check looks for the Ubuntu or
  # Fedora repository matching /etc/os-release, finds none on Arch, and so
  # never offers a download; pacman brings the update instead.

  install -Dm644 "${srcdir}/ladybird-${pkgver}-LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
