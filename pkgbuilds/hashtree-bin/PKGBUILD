pkgname=hashtree-bin
pkgver=0.2.150
pkgrel=1
pkgdesc='Peer-to-peer storage CLI, Cashu wallet and Git remote helper'
arch=('x86_64' 'aarch64')
url='https://github.com/mmalmi/hashtree'
license=('MIT')
depends=('git')
provides=("hashtree=${pkgver}" "hashtree-cli=${pkgver}" 'git-remote-htree' 'hashtree-cashu-cli')
conflicts=('hashtree' 'hashtree-cli' 'git-remote-htree' 'hashtree-cashu-cli')
options=('!strip' '!debug')

_commit=f433a855d44c86cd75937d6dc21e8008a5f96c80
source=("hashtree-${pkgver}-LICENSE::https://raw.githubusercontent.com/mmalmi/hashtree/${_commit}/rust/LICENSE")
sha256sums=('d43b5e99d9d0e73f69edac17b4167b5f973bb4920edc77f344c1091c4ec1b86c')
source_x86_64=("hashtree-${pkgver}-x86_64.tar.gz::https://github.com/mmalmi/hashtree/releases/download/v${pkgver}/hashtree-x86_64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('d309f938ead838fabaf1c072c89d9b844bfdfb7d3a3549f90804109a26f536de')
source_aarch64=("hashtree-${pkgver}-aarch64.tar.gz::https://github.com/mmalmi/hashtree/releases/download/v${pkgver}/hashtree-aarch64-unknown-linux-musl.tar.gz")
sha256sums_aarch64=('9ea661e38039fb876b52a6cda240da6a4ddae6166cf6548b8eb0ae7ecae98b0b')

package() {
  local binary
  for binary in htree git-remote-htree htree-cashu; do
    install -Dm755 "${srcdir}/hashtree/${binary}" "${pkgdir}/usr/bin/${binary}"
  done
  install -Dm644 "${srcdir}/hashtree-${pkgver}-LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${srcdir}/hashtree/README.txt" "${pkgdir}/usr/share/doc/${pkgname}/README.txt"
}
