# Maintainer: LM Studio <team@lmstudio.ai>

pkgname=lmstudio-bionic
pkgver=1.1.2+11
pkgrel=1
pkgdesc="LM Studio Bionic - AI agent for working with open models"
arch=('x86_64' 'aarch64')
url="https://lmstudio.ai"
license=('EULA')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'gtk3'
  'hicolor-icon-theme'
  'libnotify'
  'libsecret'
  'libxcrypt-compat'
  'libxss'
  'libxtst'
  'nss'
  'util-linux-libs'
  'xdg-utils'
  'zlib'
)
options=('!debug' '!strip')

_release=${pkgver/+/-}
_appimage_x86_64="Bionic-${_release}-x64.AppImage"
_appimage_aarch64="Bionic-${_release}-arm64.AppImage"

source=(
  'bionic-launcher.sh'
  'ai.elementlabs.bionic.desktop'
  'bionic.png'
)
source_x86_64=("${_appimage_x86_64}::https://bionic-installers.lmstudio.ai/linux/x64/${_release}/${_appimage_x86_64}")
source_aarch64=("${_appimage_aarch64}::https://bionic-installers.lmstudio.ai/linux/arm64/${_release}/${_appimage_aarch64}")
sha256sums=(
  '757b2b53f62aaae89d02ee5bcf89a4ba5985b712c88c6a6274cf0dd072308414'
  '99c06c472c5155635ebea1e770b56eede0c6eef2e216406684582e11e38ea750'
  '099f025c7e7ef8f53e4741e3438f83b05b46b6e6a8e7677a09295467edfb3bb1'
)
sha512sums_x86_64=('41a83ab8419d13957f64e7d705aef577db19949a24b5b67cad59ded668b4011bf265678ae57412ee1396156bdd8691c99f85689ec8fed3146c82ace701c5c55d')
sha512sums_aarch64=('e542ab5518f88d2b49fe23583711ebfefd5a0edbe2245684f41db0ce2db5c2c83a176657480b5fbc61cdd854a678528ca3ffb73e0f4909301ee364da2a31b121')

package() {
  local appimage_variable="_appimage_${CARCH}"
  local appimage="${!appimage_variable}"

  install -Dm755 "${srcdir}/${appimage}" \
    "${pkgdir}/opt/lm-studio-bionic/Bionic.AppImage"
  install -Dm755 "${srcdir}/bionic-launcher.sh" \
    "${pkgdir}/usr/bin/bionic"

  install -Dm644 "${srcdir}/bionic.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/bionic.png"
  install -Dm644 "${srcdir}/bionic.png" \
    "${pkgdir}/usr/share/pixmaps/bionic.png"
  install -Dm644 "${srcdir}/ai.elementlabs.bionic.desktop" \
    "${pkgdir}/usr/share/applications/ai.elementlabs.bionic.desktop"
}
