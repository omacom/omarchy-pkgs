# Maintainer: Scramble Tools <https://github.com/scrambletools>

pkgname=prev-bin
_name=prev
pkgver=2.4.2
pkgrel=1
pkgdesc='View, mark up and sign PDFs and images'
arch=('x86_64' 'aarch64')
url='https://prev.run'
license=('AGPL-3.0-or-later')
# prev loads libxkbcommon, Vulkan and Wayland at run time.
depends=('fontconfig' 'glibc' 'hicolor-icon-theme' 'libgcc' 'libxkbcommon'
         'vulkan-icd-loader' 'wayland')
optdepends=('wl-clipboard: copy and paste images'
            'libheif: HEIC and AVIF images'
            'curl: pictures dropped from a browser as a web address'
            'cups: printing to a printer'
            'xdg-desktop-portal-gtk: the print dialog, where the desktop portal has none')
provides=("$_name")
conflicts=("$_name")
# The release binary is already stripped; ship it as released.
options=('!debug' '!strip')
_release="https://github.com/scrambletoolsllc/prev/releases/download/v$pkgver"
source_x86_64=("$_release/$_name-$pkgver-x86_64-linux.tar.gz")
source_aarch64=("$_release/$_name-$pkgver-aarch64-linux.tar.gz")
noextract=("$_name-$pkgver-x86_64-linux.tar.gz" "$_name-$pkgver-aarch64-linux.tar.gz")
sha256sums_x86_64=('5ab89224fd629ca357104172d203a1c4cb15e75414d0a9f2b895691aef3a99b7')
sha256sums_aarch64=('498359646dfcbdcf61b2502c0534ed67bd2386cd2c6e83a8920bc41331a752bd')

package() {
  # The release tarball is a /usr tree: the binary, desktop entry, icons,
  # AppStream metadata, man page and licenses.
  bsdtar --no-same-owner -xf "$_name-$pkgver-$CARCH-linux.tar.gz" -C "$pkgdir"
  mv "$pkgdir/usr/share/licenses/$_name" "$pkgdir/usr/share/licenses/$pkgname"
}
