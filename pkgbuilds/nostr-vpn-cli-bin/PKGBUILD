# Maintainer: mmalmi
# Contributor: Gino O. <aur@1337.io> (original AUR recipe)
pkgname=nostr-vpn-cli-bin
pkgver=4.1.18
pkgrel=1
pkgdesc='Mesh VPN with a Bitcoin-paid exit bandwidth marketplace (CLI and daemon)'
arch=('x86_64' 'aarch64')
url='https://github.com/mmalmi/nostr-vpn'
license=('MIT')
depends=('iproute2' 'iptables' 'nftables')
optdepends=('systemd: persistent service and split DNS integration')
provides=("nvpn=$pkgver" "nostr-vpn-cli=$pkgver")
conflicts=('nvpn' 'nostr-vpn-cli' 'nostr-vpn-cli-git')
# Preserve the published executable byte-for-byte.
options=('!strip' '!debug' '!zipman')
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/mmalmi/nostr-vpn/v$pkgver/LICENSE")
source_x86_64=("$url/releases/download/v$pkgver/nvpn-v$pkgver-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/nvpn-v$pkgver-aarch64-unknown-linux-musl.tar.gz")
sha256sums=('0db560024163fbcc5ee5cff1971684ca448da90088f341db083a38548846c3d5')
sha256sums_x86_64=('f9e23245d85eab979716f2b1cc71716ed15f79f05551e27ede9449ffb45d8b6f')
sha256sums_aarch64=('e63d29220b62374d5aca9daa285d1e01eb78bd44c95a0fecd4e0ec709da181fa')

package() {
  install -Dm755 "$srcdir/nvpn/nvpn" "$pkgdir/usr/bin/nvpn"
  install -Dm644 "$srcdir/nvpn/README.txt" "$pkgdir/usr/share/doc/$pkgname/README.txt"
  install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
