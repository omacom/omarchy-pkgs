# Maintainer: The Omarchy Authors

# The udev rules and group of OpenRazer, without the DKMS sources: the modules
# themselves ship prebuilt and signed as $kernel-openrazer, built in every
# x86_64 linux-omarchy recipe. Keep this version in step with their
# _openrazerver (checked by tests/openrazer-lockstep.sh).
pkgname=openrazer-driver
pkgver=3.12.4
pkgrel=1
pkgdesc="OpenRazer udev rules and group for kernels that ship the Razer modules prebuilt"
arch=('x86_64')
url="https://openrazer.github.io"
license=('GPL-2.0-or-later')
# Stands in for Arch's DKMS package, which ships the same udev files, so
# openrazer-daemon installs on top of the prebuilt modules.
provides=("openrazer-driver-dkms=$pkgver")
conflicts=('openrazer-driver-dkms')
source=("openrazer-$pkgver.tar.gz::https://github.com/openrazer/openrazer/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('99a79465f0501102be47c9ad46ae2df3588f642b4394aef79f96176d74239d1c')

prepare() {
  cd "openrazer-$pkgver"
  # Arch has no plugdev group; its own package uses openrazer too.
  sed -i 's/plugdev/openrazer/' install_files/udev/99-razer.rules install_files/udev/razer_mount
}

package() {
  # Declared here, not globally, so the build does not try to install modules
  # for a kernel the builder is not running.
  depends=('OPENRAZER-MODULE')

  cd "openrazer-$pkgver"
  install -Dm644 install_files/udev/99-razer.rules "$pkgdir/usr/lib/udev/rules.d/99-razer.rules"
  install -Dm755 install_files/udev/razer_mount "$pkgdir/usr/lib/udev/razer_mount"
  echo "g openrazer -" | install -Dm644 /dev/stdin "$pkgdir/usr/lib/sysusers.d/openrazer.conf"
}
