_apple_silicon() {
  [[ $(uname -m) == aarch64 ]] && grep -aq 'apple,' /proc/device-tree/compatible 2>/dev/null
}

_etc_overrides_apply() {
  echo "Applying Omarchy etc-overrides..."

  # The hardened CUPS authorization applies on every platform. It waits for the
  # file the cups package owns: an ISO bootstrap without cups installed is left
  # alone and picks it up once cups lands.
  if [[ -f /etc/cups/cups-files.conf && -f /usr/share/omarchy/etc-overrides/cups-cups-files.conf ]]; then
    systemd-sysusers /etc/sysusers.d/omarchy-cups-browsed.conf
    install -m 0640 -o root -g cups /usr/share/omarchy/etc-overrides/cups-cups-files.conf /etc/cups/cups-files.conf
  fi

  # Apple Silicon installs run on Arch Linux ARM's base with the Asahi
  # packages, and keep that system identity: /etc/os-release stays the
  # symlink to the distribution's /usr/lib/os-release, and the PAM, NSS,
  # plymouth and skel overrides below are not applied there.
  if _apple_silicon; then
    echo "Preserving Arch Linux ARM system configuration on Apple Silicon..."
    if [[ -f /usr/lib/os-release ]]; then
      rm -f /etc/os-release
      ln -s ../usr/lib/os-release /etc/os-release
    fi
    return 0
  fi

  # Ensure parent dirs exist. cups-browsed may not be installed yet during ISO
  # bootstrap; do not create /etc/cups/cups-browsed.conf before the package is
  # installed or pacman will preserve its packaged file as a noisy .pacnew.
  install -d /etc/plymouth /etc/security /etc/skel

  # NOTE: these cp -f's are intentionally destructive on every install/upgrade.
  # Users who customize /etc/os-release, /etc/plymouth/plymouthd.conf (theme
  # switch), /etc/cups/cups-browsed.conf, /etc/cups/cups-files.conf, /etc/nsswitch.conf,
  # /etc/security/faillock.conf, or /etc/skel/.bashrc WILL have their changes
  # reset to Omarchy defaults each time omarchy-settings-dev is upgraded. This is
  # the trade-off of routing upstream-owned paths through etc-overrides instead
  # of pacman backup=().
  rm -f /etc/os-release
  cp -f /usr/share/omarchy/etc-overrides/os-release              /etc/os-release
  cp -f /usr/share/omarchy/etc-overrides/security-faillock.conf  /etc/security/faillock.conf
  cp -f /usr/share/omarchy/etc-overrides/nsswitch.conf           /etc/nsswitch.conf
  if [[ -f /etc/cups/cups-browsed.conf ]]; then
    install -d /etc/cups
    cp -f /usr/share/omarchy/etc-overrides/cups-cups-browsed.conf /etc/cups/cups-browsed.conf
  fi
  cp -f /usr/share/omarchy/etc-overrides/plymouth-plymouthd.conf /etc/plymouth/plymouthd.conf
  cp -f /usr/share/omarchy/etc-overrides/dot.bashrc              /etc/skel/.bashrc
  chmod 0644 /etc/os-release /etc/security/faillock.conf /etc/nsswitch.conf \
             /etc/plymouth/plymouthd.conf /etc/skel/.bashrc
  if [[ -f /etc/cups/cups-browsed.conf ]]; then
    chmod 0644 /etc/cups/cups-browsed.conf
  fi
}

# Keep this fallback in the package scriptlet: older settings releases have
# neither the fixed internal helper actions nor the installed ALPM hook, and
# post_remove must work after the helper itself is gone. The hook remains the
# AbortOnFail boundary; pacman does not abort on a failed scriptlet alone.
_omarchy_sudo_grants_trusted_path() {
  local path=$1 kind=$2 owner mode canonical
  [[ ! -L $path ]] || return 1
  if [[ $kind == directory ]]; then
    [[ -d $path ]] || return 1
  else
    [[ -f $path ]] || return 1
  fi
  canonical=$(/usr/bin/realpath -e -- "$path") || return 1
  [[ $canonical == "$path" ]] || return 1
  read -r owner mode < <(/usr/bin/stat -Lc '%u %a' -- "$path") || return 1
  [[ $owner == 0 && $mode =~ ^[0-7]+$ ]] && ! ((8#$mode & 022))
}

_omarchy_sudo_grants_reconcile() (
  local action=$1 fd file boot_rule
  local blocker=/run/omarchy-sudo-passwordless-package-removing
  local lock=/run/lock/omarchy-sudo-passwordless.lock
  local files=()

  # A scriptlet can inherit glob settings from pacman's shell. Never let them
  # turn a successful sweep into a literal wildcard or an omitted policy.
  set +f
  unset GLOBIGNORE
  shopt -u failglob
  shopt -s nullglob

  _omarchy_sudo_grants_trusted_path /run directory || return 1
  if [[ -e $blocker || -L $blocker ]]; then
    _omarchy_sudo_grants_trusted_path "$blocker" file || return 1
  fi
  # Announce before waiting on the publisher's lock. A publisher already inside
  # its critical section rechecks this marker before reporting success.
  (umask 077; : >"$blocker") || return 1
  # Image/bootstrap roots have not run systemd-tmpfiles yet. The validated
  # parent is private to root, so establish a missing lock directory there.
  if [[ ! -e /run/lock && ! -L /run/lock ]]; then
    /usr/bin/install -d -m 0755 -- /run/lock || return 1
  fi
  _omarchy_sudo_grants_trusted_path /run/lock directory || return 1
  if [[ -e $lock || -L $lock ]]; then
    _omarchy_sudo_grants_trusted_path "$lock" file || return 1
  fi
  umask 077
  exec {fd}>"$lock" || return 1
  /usr/bin/flock -x -w 60 "$fd" || return 1

  _omarchy_sudo_grants_trusted_path /etc directory || return 1
  if [[ -e /etc/sudoers.d || -L /etc/sudoers.d ]]; then
    _omarchy_sudo_grants_trusted_path /etc/sudoers.d directory || return 1
    # This temporary/legacy namespace is also removed by the boot rule and
    # pre-transaction hook. Permanent grants have a separate prefix and stay.
    files=(/etc/sudoers.d/99-omarchy-nopasswd-*)
    if (( ${#files[@]} )); then
      /usr/bin/rm -f -- "${files[@]}" || return 1
    fi
    for file in /etc/sudoers.d/99-omarchy-nopasswd-*; do
      [[ ! -e $file && ! -L $file ]] || return 1
    done
  fi

  if [[ $action == complete ]]; then
    # A completed installation may enable publication again only with the
    # boot cleanup installed. This rule exists in stable 4.0.4 as well; do not
    # invoke a newer helper action against that release's older command.
    _omarchy_sudo_grants_trusted_path /etc/tmpfiles.d directory || return 1
    _omarchy_sudo_grants_trusted_path /etc/tmpfiles.d/omarchy-nopasswd-sudo.conf file || return 1
    boot_rule=$(/usr/bin/awk '!/^[[:space:]]*(#|$)/ { print }' /etc/tmpfiles.d/omarchy-nopasswd-sudo.conf) || return 1
    [[ $boot_rule == 'r! /etc/sudoers.d/99-omarchy-nopasswd-*' ]] || return 1
    /usr/bin/rm -f -- "$blocker" || return 1
    [[ ! -e $blocker && ! -L $blocker ]] || return 1
  fi
)

pre_remove() {
  _omarchy_sudo_grants_reconcile revoke
}

post_remove() {
  _omarchy_sudo_grants_reconcile revoke
}

pre_upgrade() {
  _omarchy_sudo_grants_reconcile revoke
}

post_install() {
  _omarchy_sudo_grants_reconcile revoke || return 1
  _etc_overrides_apply || return 1
  _omarchy_sudo_grants_reconcile complete
}

post_upgrade() {
  post_install
}
