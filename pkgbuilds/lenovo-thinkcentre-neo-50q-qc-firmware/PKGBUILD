# Audio DSP, compute DSP, GPU and video firmware for the Lenovo ThinkCentre neo 50q QC. The
# firmware only runs if it is signed for this board by Lenovo, so linux-firmware cannot carry it
# until the OEM submits it. The OEM ships it in its Windows driver download, which this recipe
# unpacks without running. Each file is checked against the SHA-256 it was matched to and
# installed under the name the device tree requests, compressed with xz. The kernel tries a plain
# name, then .zst, then .xz, so once linux-firmware ships the same file, its copy is the one
# loaded, and the two packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=lenovo-thinkcentre-neo-50q-qc-firmware
pkgver=20261109
pkgrel=1
pkgdesc='Audio DSP, compute DSP, GPU and video firmware for the Lenovo ThinkCentre neo 50q QC'
arch=('aarch64')
url='https://download.lenovo.com/pccbbs/desktop/u9corggus14lcfc.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1p42100-lenovo-13c8')
makedepends=('7zip' 'innoextract')
options=('!strip' '!debug')
source=(
  'lenovo-u9corggus14lcfc.exe::https://download.lenovo.com/pccbbs/desktop/u9corggus14lcfc.exe'
)
noextract=('lenovo-u9corggus14lcfc.exe')
sha256sums=('aceac7ac986381be2dc68b234575ad2d6757669e3dcee28254d7cbe980fd4e0a')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'lenovo-u9corggus14lcfc.exe' 'lenovo-u9corggus14lcfc' inno
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'lenovo-u9corggus14lcfc/code$GetExtractPath$/Drivers/Neo8800_adsp/adsp_dtbs.elf' "$fw"/'qcom/x1p42100/LENOVO/13C8/adsp_dtbs.elf'
  install -Dm644 'lenovo-u9corggus14lcfc/code$GetExtractPath$/Drivers/Neo8800_adsp/adspr.jsn' "$fw"/'qcom/x1p42100/LENOVO/13C8/adspr.jsn'
  install -Dm644 'lenovo-u9corggus14lcfc/code$GetExtractPath$/Drivers/Neo8800_adsp/adsps.jsn' "$fw"/'qcom/x1p42100/LENOVO/13C8/adsps.jsn'
  install -Dm644 'lenovo-u9corggus14lcfc/code$GetExtractPath$/Drivers/Neo8800_adsp/adspua.jsn' "$fw"/'qcom/x1p42100/LENOVO/13C8/adspua.jsn'
  install -Dm644 'lenovo-u9corggus14lcfc/code$GetExtractPath$/Drivers/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1p42100/LENOVO/13C8/cdsp_dtbs.elf'
  install -Dm644 'lenovo-u9corggus14lcfc/code$GetExtractPath$/Drivers/qcnspmcdm_ext_cdsp8380/cdspr.jsn' "$fw"/'qcom/x1p42100/LENOVO/13C8/cdspr.jsn'
  install -Dm644 'lenovo-u9corggus14lcfc/code$GetExtractPath$/Drivers/Neo8800_adsp/qcadsp8380.mbn' "$fw"/'qcom/x1p42100/LENOVO/13C8/qcadsp8380.mbn'
  install -Dm644 'lenovo-u9corggus14lcfc/code$GetExtractPath$/Drivers/qcnspmcdm_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1p42100/LENOVO/13C8/qccdsp8380.mbn'
  install -Dm644 'lenovo-u9corggus14lcfc/code$GetExtractPath$/Drivers/qcdx8380/qcdxkmsucpurwa.mbn' "$fw"/'qcom/x1p42100/LENOVO/13C8/qcdxkmsucpurwa.mbn'
  install -Dm644 'lenovo-u9corggus14lcfc/code$GetExtractPath$/Drivers/qcdx8380/qcvss8380_pa.mbn' "$fw"/'qcom/x1p42100/LENOVO/13C8/qcvss8380_pa.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
21948b2dca8f534b22c27a69310815337c45dce07c8c27746d0fe968363b551a  qcom/x1p42100/LENOVO/13C8/adsp_dtbs.elf
4b9566fcfdc1656c38d8158d79db6964e9c4b57a6e42b46241e8d63aabc42d8d  qcom/x1p42100/LENOVO/13C8/adspr.jsn
19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e  qcom/x1p42100/LENOVO/13C8/adsps.jsn
d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d  qcom/x1p42100/LENOVO/13C8/adspua.jsn
8880a7a2252e7951b1bc7c14869c8c37062583ba26b21fee6194c593e3447a7e  qcom/x1p42100/LENOVO/13C8/cdsp_dtbs.elf
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x1p42100/LENOVO/13C8/cdspr.jsn
23a6abb07bdbf910b478dff323b4489125da1205cbd8ba6e459afc12466fefe7  qcom/x1p42100/LENOVO/13C8/qcadsp8380.mbn
8a4465f747dbf43441fdba7d5c0312057d2cd1bb1e42cb4833d9ebdb7253388e  qcom/x1p42100/LENOVO/13C8/qccdsp8380.mbn
08cedef477485c11dd0b2eccd9f01f2528e319e3b2d9b00fb0fa469904abad70  qcom/x1p42100/LENOVO/13C8/qcdxkmsucpurwa.mbn
21e2dc5b977009c716daa7ece02dc7136acc40b9349954809a8a4a2e034bd1b0  qcom/x1p42100/LENOVO/13C8/qcvss8380_pa.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +
}
