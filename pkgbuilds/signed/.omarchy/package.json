  "auto_merge": true,
  "upstream": {
    "watch": {
      "github": "omacom/signed",
      "pattern": "v(?P<version>[0-9]+(?:\\.[0-9]+)*)"
    }
  },
  "rebuilt_against": {
    "x86_64": {
      "poppler-qt6": "26.10.0-2",
      "qpdf": "12.4.2-2"
    },
    "aarch64": {
      "poppler-qt6": "26.10.0-2",
      "qpdf": "12.4.2-2"
    }
  }
}
