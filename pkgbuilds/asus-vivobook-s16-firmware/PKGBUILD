# Audio DSP, compute DSP, GPU and video firmware for the ASUS Vivobook S 16. The firmware only
# runs if it is signed for this board by ASUS, so linux-firmware cannot carry it until the OEM
# submits it. The OEM ships it in its Windows driver download, which this recipe unpacks without
# running. The files are installed unmodified, under the names the device tree requests, and
# checked against the SHA-256 each was matched to.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=asus-vivobook-s16-firmware
pkgver=20261102
pkgrel=1
pkgdesc='Audio DSP, compute DSP, GPU and video firmware for the ASUS Vivobook S 16'
arch=('aarch64')
url='https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/50069/SOCPackage_forWebSite_Qualcomm_Z_V1.311.8800.0_50069.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1p42100-asustek-vivobook-s16')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'asus-socpackage-50069.exe::https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/50069/SOCPackage_forWebSite_Qualcomm_Z_V1.311.8800.0_50069.exe'
)
noextract=('asus-socpackage-50069.exe')
sha256sums=('ebb9d7094af88def949eeca8ba6ca8e7bf49c8d2f73e11f40079b13c2c298842')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'asus-socpackage-50069.exe' 'asus-socpackage-50069' 7z-appended
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'asus-socpackage-50069/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1p42100/ASUSTeK/vivobook-s16/adsp_dtbs.elf'
  install -Dm644 'asus-socpackage-50069/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adspr.jsn' "$fw"/'qcom/x1p42100/ASUSTeK/vivobook-s16/adspr.jsn'
  install -Dm644 'asus-socpackage-50069/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adsps.jsn' "$fw"/'qcom/x1p42100/ASUSTeK/vivobook-s16/adsps.jsn'
  install -Dm644 'asus-socpackage-50069/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adspua.jsn' "$fw"/'qcom/x1p42100/ASUSTeK/vivobook-s16/adspua.jsn'
  install -Dm644 'asus-socpackage-50069/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/battmgr.jsn' "$fw"/'qcom/x1p42100/ASUSTeK/vivobook-s16/battmgr.jsn'
  install -Dm644 'asus-socpackage-50069/QualcommBSP/NPU/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1p42100/ASUSTeK/vivobook-s16/cdsp_dtbs.elf'
