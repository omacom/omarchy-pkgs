  install -Dm644 'asus-socpackage-50069/QualcommBSP/NPU/qcnspmcdm_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1p42100/ASUSTeK/vivobook-s16/qccdsp8380.mbn'
