# omaseed.install -- the package's messages about the agent skill (DECISIONS C48 AS8, AS10).
# It only speaks: no link is made or removed here, nothing is written. `omaseed skill link`,
# run by the person, is the only thing that links the skill into an agent's folder.

skill_hint() {
    echo "Coding agents: omaseed skill link lets Claude Code, Codex and others find omaseed's guide (omaseed skill to read it)."
}

post_install() {
    skill_hint
}

# Only on the upgrade that crosses 0.16.0, the first version with the skill.
post_upgrade() {
    if [ "$(vercmp "$2" 0.16.0)" -lt 0 ]; then
        skill_hint
    fi
}

pre_remove() {
    echo "Links made by omaseed skill link (~/.agents/skills/omaseed, ~/.claude/skills/omaseed...) now point nowhere; agents skip them. omaseed skill unlink before removing takes them out; installing again brings them back."
}
