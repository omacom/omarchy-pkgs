# Maintainer: Diogo Chaves <diogochaves@me.com>
#
# Builds from GitHub's archive of the release tag. scripts/release.sh --publish tags the
# release with sha256sums=('SKIP') below (the tagged tree cannot hold its own checksum), then
# commits the archive's checksum here on main right after the tag; that version of this file
# is the one for omarchy-pkgs. `--bump` keeps pkgver in step with CMakeLists.txt. For a local
# build before any tag exists, or while iterating on packaging itself, use PKGBUILD.local
# next to this file instead -- it builds from the working tree.
pkgname=omaseed
pkgver=0.17.4
pkgrel=1
pkgdesc="Torrents for Omarchy, powered by qBittorrent, Transmission or Deluge"
arch=('x86_64')
url="https://github.com/diogochaves/omaseed"
license=('MIT')
# qtkeychain-qt6 talks to the freedesktop Secret Service directly over D-Bus (see its own
# `Depends On: ... org.freedesktop.secrets ...`, `ldd libqt6keychain.so.1` has no libsecret)
# rather than linking libsecret, so libsecret itself is not a real dependency here --
# omitted after checking (namcap flagged 'included, but may not be needed' when this list
# had it). A Secret Service provider (gnome-keyring, kwallet, keepassxc, ...) is what's
# actually required at runtime; qtkeychain-qt6 already depends on the virtual
# org.freedesktop.secrets package for that, so it does not need restating here either.
depends=(
    'qt6-base'
    'qt6-declarative'
    'qt6-svg'
    'qt6-wayland'
    'qtkeychain-qt6'
    'hicolor-icon-theme'
)
makedepends=('cmake' 'ninja' 'librsvg' 'qt6-tools')
optdepends=(
    'qbittorrent-nox: local engine, if you want omaseed to manage one for you on first run'
    'xdg-desktop-portal: native file picker for choosing .torrent files and download folders'
    'ttf-chakra-petch: labels in the Console skin (AUR)'
    'ttf-share-gf: Share Tech Mono, figures in the Console skin (AUR)'
    'noto-fonts-cjk: kana in the Console skin'
    'ttf-material-symbols-variable: icons in the Console skin'
    'omabox: check a skin in every theme, in a desktop of its own'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/diogochaves/omaseed/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('cd4646baad3741431c1c025b0c8c3e9ca90611dc3d2089807ae8c8371c0e816e')

# omaseed.install only speaks (DECISIONS C48 AS8, AS10): on install, and on the upgrade that
# crosses 0.16.0, it says how to link the agent skill (omaseed skill link); before removal, that
# the links made by it now point nowhere. It makes, removes and writes nothing. The caches
# (desktop-database, mime-database, icon-cache) are still left to the libalpm hooks shipped by
# desktop-file-utils, shared-mime-info and gtk-update-icon-cache, current Arch convention:
# Omarchy's base install pulls them in, and a system missing them runs without a refreshed
# cache until something else triggers one, like any other hicolor/.desktop-shipping package.
install=omaseed.install

build() {
    cmake -S "$pkgname-$pkgver" -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    # data/CMakeLists.txt already installs LICENSE to share/licenses/omaseed/ (T5.1), so
    # there is nothing else to stage here.
    DESTDIR="$pkgdir" cmake --install build
}
