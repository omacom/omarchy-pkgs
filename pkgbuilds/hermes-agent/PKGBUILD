# Maintainer: David Heinemeier Hansson <david@hey.com>

# Ships upstream's installer and the release it pins, so Omarchy can set up the
# self-updating Hermes runtime under ~/.hermes without the desktop app.
# hermes-desktop seeds its Electron build into that same runtime.

pkgname=hermes-agent
pkgver=2026.9.7
pkgrel=1
pkgdesc='Installer for the self-updating Hermes Agent runtime'
arch=('any')
url='https://github.com/NousResearch/hermes-agent'
license=('MIT')

# What install.sh looks for on the machine, so it never reaches for sudo: git
# for the checkout, curl for uv, a C++ compiler (it installs base-devel without
# one), a Node the release accepts (it downloads a private one otherwise), and
# the libraries the Chromium it installs for browser tools links against.
# Python comes from uv, managed inside ~/.hermes.
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'curl'
  'gcc'
  'git'
  'libcups'
  'libdrm'
  'libxkbcommon'
  'make'
  'mesa'
  'nodejs'
  'npm'
  'nss'
  'pango'
)

optdepends=(
  'ffmpeg: voice messages'
  'ripgrep: file search without the grep fallback'
  'omarchy: sets up the user installation for in-app updates'
)

# The tag's commit. The runtime starts here and hermes-desktop builds its app
# from it, so tests/hermes-release-pin.sh keeps the two PKGBUILDs equal.
_commit=2237be355906fbe6065ce1815711eee52b2d646e

_srcdir="hermes-agent-${pkgver}"
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        'runtime.patch')
sha256sums=('907c2a72db1c5dd637ea8eeae97f4cb5b32cef615c17258f6b190924ec5bf688'
            '9d5015d1be762a901f8f64319981ae862e9852fa5cb9a22a2ba1e691f90430a2')

check() {
  cd "${srcdir}/${_srcdir}"

  # Omarchy applies the patch to a fresh checkout or accepts it already
  # applied, so one of the two has to hold for the release being packaged.
  git apply --check "${srcdir}/runtime.patch" 2>/dev/null ||
    git apply --reverse --check "${srcdir}/runtime.patch"
}

package() {
  install -Dm644 "${srcdir}/${_srcdir}/scripts/install.sh" \
    "${pkgdir}/usr/share/${pkgname}/install.sh"
  install -Dm644 "${srcdir}/runtime.patch" \
    "${pkgdir}/usr/share/${pkgname}/runtime.patch"

  # The same shape as the desktop app's install-stamp.json, so Omarchy reads
  # the pinned commit from either package the same way.
  printf '{"branch":"main","commit":"%s"}\n' "${_commit}" >"${srcdir}/release.json"
  install -Dm644 "${srcdir}/release.json" "${pkgdir}/usr/share/${pkgname}/release.json"

  install -Dm644 "${srcdir}/${_srcdir}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
