[Unit]
Description=NVIDIA AI Workbench native Arch backend for %i
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/home/%i/.nvwb/config.yaml

[Service]
User=%i
# network-online.target is reached immediately when NetworkManager-wait-online
# is masked (Omarchy does that), so wait for connectivity here; the backend's
# resolver otherwise falls back to localhost for the life of the process.
ExecStartPre=-/usr/bin/nm-online -q --timeout=30
WorkingDirectory=/home/%i
Environment=HOME=/home/%i
Environment=PATH=/usr/lib/nvwb-spark/compat:/usr/local/sbin:/usr/local/bin:/usr/bin
BindReadOnlyPaths=/usr/lib/nvwb-spark/compat/os-release:/etc/os-release
ExecStart="/opt/NVIDIA AI Workbench/resources/bin/wb-svc" -service-dir /home/%i/.nvwb -port 10001 serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
