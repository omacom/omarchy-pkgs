#!/usr/bin/python3
"""Read-only translation of Workbench's toolkit queries to Arch's package DB."""
import subprocess
import sys

args = sys.argv[1:]
if len(args) != 3 or args[0] != '-Wf' or args[2] != 'nvidia-container-toolkit':
    sys.exit('Unsupported Workbench compatibility query: ' + repr(args))
result = subprocess.run(['/usr/bin/pacman', '-Q', 'nvidia-container-toolkit'], capture_output=True, text=True)
if result.returncode:
    sys.exit(result.returncode)
version = result.stdout.strip().split(maxsplit=1)[1]
formats = {'${db:Status-Status}': 'installed', '${Version}': version}
output = args[1]
for key, value in formats.items():
    output = output.replace(key, value)
if '${' in output:
    sys.exit('Unsupported Workbench query format')
sys.stdout.write(output.replace('\\n', '\n'))
