#!/bin/bash
# Launch the vendor desktop app inside a private view of a few files, through
# bubblewrap; everything else is the real filesystem, as for the system service.
#  - /etc/os-release: the app runs `cat /etc/*-release` and stops at "Cannot
#    install on your operating system" unless it sees Ubuntu's DISTRIB_* lines.
#  - resources/app-update.yml: the vendor self-updater would download a .deb and
#    run apt through pkexec; the feed is pointed at nothing, so the app never
#    offers it. Update this package with pacman.
#  - ~/.nvwb/bin, read-only: the app's install/repair pass would replace the
#    helper links with vendor binaries and lose the service adapter.
# Package-owned helpers retain their installed ownership and modes.
set -e
if [[ ! -f $HOME/.nvwb/spark-ready ]]; then
  exec xdg-terminal-exec --title="NVIDIA AI Workbench setup" -e /usr/lib/nvwb-spark/first-run
fi
export OMARCHY_NVWB_MANAGED=1
compat=/usr/lib/nvwb-spark/compat
app="/opt/NVIDIA AI Workbench"
args=(--dev-bind / /
      --ro-bind "$compat/desktop-os-release" /etc/os-release
      --ro-bind "$compat/app-update.yml" "$app/resources/app-update.yml")
[[ -d $HOME/.nvwb/bin ]] && args+=(--ro-bind "$HOME/.nvwb/bin" "$HOME/.nvwb/bin")
exec /usr/bin/bwrap "${args[@]}" --die-with-parent -- "$app/nvidia-ai-workbench" "$@"
