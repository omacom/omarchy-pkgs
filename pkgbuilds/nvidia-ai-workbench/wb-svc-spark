#!/usr/bin/python3
"""Verify the configured Docker Engine instead of starting Docker Desktop on Arch."""
import os
import json
import subprocess
from pathlib import Path
import sys
import yaml

def native_ready(info):
    host = info.get('hostState', {})
    container = info.get('configuration', {}).get('container', {})
    return (container.get('runtime') == 'docker' and container.get('buildtime') == 'docker'
            and bool(host.get('gitVersion')) and bool(host.get('gitLFSVersion'))
            and bool(host.get('dockerClientVersion')) and bool(host.get('dockerServerVersion'))
            and host.get('dockerIsRunning') is True
            and host.get('needDockerGroupAddition') is False
            and host.get('nvidiaRuntimeIsConfigured') is True
            and bool(host.get('containerToolkitVersion')) and bool(host.get('gpuDevices'))
            and host.get('gpuDriverMissing') is False)


def main():
    args = sys.argv[1:]
    service_dir = Path.home() / '.nvwb'
    for i, arg in enumerate(args):
        if arg in ('-service-dir', '--service-dir') and i + 1 < len(args):
            service_dir = Path(args[i + 1]).expanduser()
        elif arg.startswith(('-service-dir=', '--service-dir=')):
            service_dir = Path(arg.split('=', 1)[1]).expanduser()
    if args and args[-1] == 'start-container-tool':
        try:
            config = yaml.safe_load((service_dir / 'config.yaml').read_text()) or {}
        except (OSError, yaml.YAMLError):
            config = {}
        if config.get('container', {}).get('runtime') == 'docker':
            os.execv('/usr/bin/newgrp', ['newgrp', 'docker', '-c', 'exec /usr/bin/docker info --format "{{.ServerVersion}}"'])
    vendor = '/opt/NVIDIA AI Workbench/resources/bin/wb-svc'
    # Desktop probes must see the same package queries and OS view as the service.
    compat = '/usr/lib/nvwb-spark/compat'
    os.environ['PATH'] = compat + ':/usr/local/sbin:/usr/local/bin:/usr/bin'
    command = ['bwrap', '--dev-bind', '/', '/', '--ro-bind',
               compat + '/os-release', '/etc/os-release', '--', vendor, *args]
    if args == ['info'] and service_dir == Path.home() / '.nvwb':
        result = subprocess.run(['/usr/bin/bwrap', *command[1:]], capture_output=True, text=True)
        sys.stderr.write(result.stderr)
        if result.returncode:
            sys.stdout.write(result.stdout)
            return result.returncode
        info = json.loads(result.stdout)
        active = subprocess.run(['systemctl', 'is-active', '--quiet',
                                 'nvwb-spark@' + Path.home().name + '.service']).returncode == 0
        if native_ready(info) and active:
            # Report the native installation's completion, not the unused Debian
            # installer's ledger. Preserve all measured host capability fields.
            info['installState'].update(hasCompleted=True, reconcileRequired=False, workflowsToReconcile=[])
        print(json.dumps(info))
        return 0
    os.execv('/usr/bin/bwrap', command)


if __name__ == "__main__":
    sys.exit(main())
