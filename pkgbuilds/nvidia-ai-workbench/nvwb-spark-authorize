#!/usr/bin/python3
"""Authorize the invoking desktop user for the packaged Workbench service."""
import os
from pathlib import Path
import pwd
import re
import subprocess
import sys
import tempfile


def account(environ):
    user = environ.get('SUDO_USER', '')
    if not re.fullmatch(r'[a-z_][a-z0-9_-]*', user):
        raise ValueError('run this helper through sudo as your desktop user')
    entry = pwd.getpwnam(user)
    if entry.pw_uid == 0 or str(entry.pw_uid) != environ.get('SUDO_UID'):
        raise ValueError('invalid invoking user')
    if entry.pw_dir != '/home/' + user:
        raise ValueError('Workbench requires a /home/<username> home directory')
    return entry


def policy(user):
    unit = f'nvwb-spark@{user}.service'
    commands = ', '.join(f'/usr/bin/systemctl {verb} {unit}' for verb in ('enable', 'start', 'stop'))
    return f'{user} ALL=(root) NOPASSWD: {commands}\n'


def main():
    if os.geteuid() != 0 or len(sys.argv) != 1:
        raise SystemExit('Run sudo /usr/lib/nvwb-spark/authorize without arguments.')
    try:
        entry = account(os.environ)
    except (ValueError, KeyError) as error:
        raise SystemExit(str(error))
    user = entry.pw_name
    directory = Path('/etc/sudoers.d')
    fd, temporary = tempfile.mkstemp(prefix='.nvwb-', dir=directory)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(policy(user))
        os.chmod(temporary, 0o440)
        subprocess.run(['/usr/bin/visudo', '-cf', temporary], check=True)
        subprocess.run(['/usr/bin/usermod', '-aG', 'docker', user], check=True)
        os.replace(temporary, directory / ('nvwb-spark-' + user))
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


if __name__ == '__main__':
    main()
