pkgname=nvidia-ai-workbench
pkgver=0.169.2.16
pkgrel=16
pkgdesc='NVIDIA AI Workbench desktop and backend with Arch Linux ARM adapters'
arch=('aarch64')
url='https://www.nvidia.com/en-us/deep-learning-ai/solutions/data-science/workbench/'
license=('LicenseRef-NVIDIA')
depends=('glibc' 'gcc-libs' 'gtk3' 'libnotify' 'nss' 'libxss' 'libxtst' 'xdg-utils'
         'at-spi2-core' 'util-linux-libs' 'libsecret' 'alsa-lib' 'python' 'python-yaml' 'bubblewrap'
         'git' 'git-lfs' 'docker' 'nvidia-container-toolkit' 'networkmanager'
         'pciutils' 'sudo' 'shadow' 'gum' 'xdg-terminal-exec')
options=('!strip' '!debug')
_deb=NVIDIA-AI-Workbench-0.169.2-16-arm64.deb
source=(
  "https://workbench.download.nvidia.com/stable/linux/debian/pool/proprietary/n/nvidia-ai-workbench/$_deb"
  nvwb-cli-spark
  wb-svc-spark
  nvwb-spark-setup
  nvwb-spark-authorize
  nvwb-spark-first-run
  nvwb-spark@.service
  dpkg-query
  workbench-os-release
  nvidia-smi
  workbench-desktop-os-release
  nvidia-ai-workbench-spark
  workbench-app-update.yml
  patch-desktop.py
  README.md
)
