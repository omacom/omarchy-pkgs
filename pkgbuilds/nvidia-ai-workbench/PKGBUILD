            '1410ac10c5e01d82f0fe8142055929c370828be40980a05dabff5d6335a416f5'
            'ea0e6f58b89755d152e6048f5370ee860773dd92e13da74e308697a9ea3bbd0b'
            'ea72240c0941b5ecf77db60ce5dc720923c0c6c9f584cec57c6f5a0cca2f7898')
noextract=("$_deb")

package() {
  set -o pipefail
  bsdtar -xOf "${srcdir}/${_deb}" data.tar.xz | bsdtar -xf - -C "${pkgdir}"
  python "${srcdir}/patch-desktop.py" "${pkgdir}/opt/NVIDIA AI Workbench/resources/app.asar"
  # Vendor archives contain world-writable assets; keep installed code root-owned.
  chmod -R go-w "${pkgdir}"
  # The desktop app runs `cat /etc/*-release` and refuses non-Ubuntu hosts before
  # contacting the backend; the launcher gives it a private view of os-release
  # through bubblewrap, like the service's namespace, and the desktop entry uses it.
  install -Dm755 "${srcdir}/nvidia-ai-workbench-spark" "${pkgdir}/usr/bin/nvidia-ai-workbench"
  install -Dm644 "${srcdir}/workbench-desktop-os-release" "${pkgdir}/usr/lib/nvwb-spark/compat/desktop-os-release"
  install -Dm644 "${srcdir}/workbench-app-update.yml" "${pkgdir}/usr/lib/nvwb-spark/compat/app-update.yml"
  sed -i 's#^Exec=.*#Exec=/usr/bin/nvidia-ai-workbench %U#' "${pkgdir}/usr/share/applications/nvidia-ai-workbench.desktop"
  # The Spark kernel supports user namespaces. Keep the normal Electron
  # namespace sandbox; do not add the vendor postinst's setuid fallback.
  chmod 0755 "${pkgdir}/opt/NVIDIA AI Workbench/chrome-sandbox"
  install -Dm755 "${srcdir}/nvwb-cli-spark" "${pkgdir}/usr/lib/nvwb-spark/nvwb-cli"
  install -Dm755 "${srcdir}/wb-svc-spark" "${pkgdir}/usr/lib/nvwb-spark/wb-svc"
  install -Dm755 "${srcdir}/nvwb-spark-setup" "${pkgdir}/usr/bin/nvwb-spark-setup"
  install -Dm755 "${srcdir}/nvwb-spark-authorize" "${pkgdir}/usr/lib/nvwb-spark/authorize"
  install -Dm755 "${srcdir}/nvwb-spark-first-run" "${pkgdir}/usr/lib/nvwb-spark/first-run"
  install -Dm644 "${srcdir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "${srcdir}/nvwb-spark@.service" "${pkgdir}/usr/lib/systemd/system/nvwb-spark@.service"
  install -Dm755 "${srcdir}/dpkg-query" "${pkgdir}/usr/lib/nvwb-spark/compat/dpkg-query"
  install -Dm644 "${srcdir}/workbench-os-release" "${pkgdir}/usr/lib/nvwb-spark/compat/os-release"
  install -Dm755 "${srcdir}/nvidia-smi" "${pkgdir}/usr/lib/nvwb-spark/compat/nvidia-smi"
}
