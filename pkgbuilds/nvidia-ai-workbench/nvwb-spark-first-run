#!/bin/bash
set -euo pipefail
trap 'status=$?; if (( status != 0 )); then echo "Workbench setup did not finish. Review the error above, then launch it again to retry."; read -r -p "Press Enter to close."; fi' EXIT

echo "NVIDIA AI Workbench setup"
echo
# The privileged helper refuses other machines too; say so before asking.
for device in /sys/bus/pci/devices/*; do
  [[ $(<"$device/vendor") == 0x10de && $(<"$device/device") == 0x2e12 ]] && gb10=1
done
if [[ -z ${gb10:-} ]]; then
  echo "This Workbench package supports only NVIDIA GB10 systems such as the DGX Spark."
  read -r -p "Press Enter to close."
  exit 0
fi
echo "Workbench needs direct Docker access to build and run GPU projects."
echo "This adds your account to the docker group. Programs running as you will"
echo "then have access equivalent to root through Docker."
echo
echo "Setup registers NVIDIA's container runtime with Docker. If Docker is"
echo "running without it, Docker restarts and running containers stop."
echo
echo "Setup also permits starting and stopping only your Workbench service"
echo "without another password prompt. App updates are managed by Omarchy."
echo
if ! gum confirm "Set up Workbench for this account?"; then
  exit 0
fi
sudo /usr/lib/nvwb-spark/authorize
# Pick up Docker membership for this process tree without changing the session.
# The app runs in its own session so closing this terminal does not end it.
newgrp docker -c '/usr/bin/nvwb-spark-setup && setsid -f /usr/bin/nvidia-ai-workbench </dev/null >/dev/null 2>&1'
