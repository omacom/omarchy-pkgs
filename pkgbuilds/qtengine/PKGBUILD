# Split like kvantum and kvantum-qt5, so the Qt6 platform theme does not drag
# in Qt5 and KDE Frameworks 5. Both halves read the same config.json.

pkgbase=qtengine
pkgname=(qtengine qtengine-qt5)
pkgver=0.2.4
pkgrel=6
pkgdesc='Easily configurable Qt platform theme using KDE color schemes'
arch=(x86_64 aarch64)
url='https://github.com/kossLAN/qtengine'
license=(BSD-2-Clause)
makedepends=(
  cmake
  extra-cmake-modules
  kcolorscheme
  kconfig
  kconfig5
  kconfigwidgets5
  kiconthemes
  kiconthemes5
  qt5-base
  qt5-quickcontrols2
  qt6-base
  qt6-declarative
)
_archive="$pkgbase-$pkgver"
source=("$url/archive/$pkgver/$_archive.tar.gz")
sha256sums=('8f70dd48c7c2d6d897a1cc023a5436574cfdc288be4f5c0648c6474dd0b4ce87')

build() {
  # QtQuick Controls support (the theme.quickStyle option) is optional
  # upstream and silently dropped when the module is missing; require it.
  # Every library lands in /usr/lib, so no install RPATH is needed, and the
  # Qt5 targets would otherwise carry the relative RPATH "lib".
  cmake -B build-qt6 -S "$_archive" \
    -D CMAKE_BUILD_TYPE=None \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_SKIP_INSTALL_RPATH=ON \
    -D CMAKE_REQUIRE_FIND_PACKAGE_Qt6QuickControls2=ON \
    -D BUILD_QT5=OFF \
    -D QT6_PLUGINDIR=lib/qt6/plugins
  cmake --build build-qt6

  # Arch's Qt5 loads plugins from /usr/lib/qt/plugins, not upstream's default
  # lib/qt5/plugins.
  cmake -B build-qt5 -S "$_archive" \
    -D CMAKE_BUILD_TYPE=None \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_SKIP_INSTALL_RPATH=ON \
    -D CMAKE_REQUIRE_FIND_PACKAGE_Qt5QuickControls2=ON \
    -D BUILD_QT6=OFF \
    -D QT5_PLUGINDIR=lib/qt/plugins
  cmake --build build-qt5
}

package_qtengine() {
  pkgdesc='Easily configurable Qt6 platform theme using KDE color schemes'
  depends=(
    glibc
    kcolorscheme
    kconfig
    kiconthemes
    libgcc
    libstdc++
    qt6-base
    qt6-declarative
  )

  DESTDIR="$pkgdir" cmake --install build-qt6
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname" "$_archive/LICENSE"
}

package_qtengine-qt5() {
  pkgdesc='Easily configurable Qt5 platform theme using KDE color schemes'
  depends=(
    glibc
    kconfig5
    kconfigwidgets5
    kiconthemes5
    libgcc
    libstdc++
    qt5-base
    qt5-quickcontrols2
  )

  DESTDIR="$pkgdir" cmake --install build-qt5
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname" "$_archive/LICENSE"
}
