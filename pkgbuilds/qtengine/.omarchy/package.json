{
  "source": "local",
  "upstream": {
    "watch": {
      "github": "kossLAN/qtengine",
      "pattern": "(?P<version>[0-9]+(?:\\.[0-9]+)*)"
    }
  },
  "rebuild_on": [
    "qt5-base",
    "qt6-base"
  ],
  "rebuilt_against": {
    "x86_64": {
      "qt5-base": "5.15.19+kde+r96-1",
      "qt6-base": "6.12.0-3"
    },
    "aarch64": {
      "qt5-base": "5.15.19+kde+r96-1",
      "qt6-base": "6.12.0-3"
    }
  }
}
