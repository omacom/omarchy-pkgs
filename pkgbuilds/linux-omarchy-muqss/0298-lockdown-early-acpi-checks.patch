diff --git a/drivers/acpi/osl.c b/drivers/acpi/osl.c
--- a/drivers/acpi/osl.c
+++ b/drivers/acpi/osl.c
@@ -203,7 +203,7 @@ acpi_physical_address __init acpi_os_get_root_pointer(void)
 	 * specific location (if appropriate) so it can be carried
 	 * over further kexec()s.
 	 */
-	if (acpi_rsdp && !security_locked_down(LOCKDOWN_ACPI_TABLES)) {
+	if (acpi_rsdp && !security_locked_down_early(LOCKDOWN_ACPI_TABLES)) {
 		acpi_arch_set_root_pointer(acpi_rsdp);
 		return acpi_rsdp;
 	}
diff --git a/drivers/acpi/tables.c b/drivers/acpi/tables.c
--- a/drivers/acpi/tables.c
+++ b/drivers/acpi/tables.c
@@ -487,7 +487,7 @@ void __init acpi_table_upgrade(void)
 	if (table_nr == 0)
 		return;
 
-	if (security_locked_down(LOCKDOWN_ACPI_TABLES)) {
+	if (security_locked_down_early(LOCKDOWN_ACPI_TABLES)) {
 		pr_notice("kernel is locked down, ignoring table override\n");
 		return;
 	}
diff --git a/include/linux/security.h b/include/linux/security.h
--- a/include/linux/security.h
+++ b/include/linux/security.h
@@ -2448,4 +2448,13 @@ static inline int security_lock_kernel_down(const char *where, enum lockdown_rea
 }
 #endif /* CONFIG_SECURITY_LOCKDOWN_LSM */
 
+#ifdef CONFIG_SECURITY_LOCKDOWN_LSM_EARLY
+int security_locked_down_early(enum lockdown_reason what);
+#else
+static inline int security_locked_down_early(enum lockdown_reason what)
+{
+	return security_locked_down(what);
+}
+#endif /* CONFIG_SECURITY_LOCKDOWN_LSM_EARLY */
+
 #endif /* ! __LINUX_SECURITY_H */
diff --git a/security/lockdown/lockdown.c b/security/lockdown/lockdown.c
--- a/security/lockdown/lockdown.c
+++ b/security/lockdown/lockdown.c
@@ -83,6 +83,13 @@ int security_lock_kernel_down(const char *where, enum lockdown_reason level)
 	return lock_kernel_down(where, level);
 }
 
+#ifdef CONFIG_SECURITY_LOCKDOWN_LSM_EARLY
+int security_locked_down_early(enum lockdown_reason what)
+{
+	return lockdown_is_locked_down(what);
+}
+#endif
+
 static struct security_hook_list lockdown_hooks[] __ro_after_init = {
 	LSM_HOOK_INIT(locked_down, lockdown_is_locked_down),
 };
