diff --git a/drivers/gpu/drm/amd/pm/swsmu/amdgpu_smu.c b/drivers/gpu/drm/amd/pm/swsmu/amdgpu_smu.c
--- a/drivers/gpu/drm/amd/pm/swsmu/amdgpu_smu.c
+++ b/drivers/gpu/drm/amd/pm/swsmu/amdgpu_smu.c
@@ -2239,6 +2239,9 @@ static int smu_suspend(struct amdgpu_ip_block *ip_block)
 
 	adev->pm.dpm_enabled = false;
 
+	if (adev->in_s0ix)
+		smu->s0ix_seen = true;
+
 	ret = smu_smc_hw_cleanup(smu);
 	if (ret)
 		return ret;
diff --git a/drivers/gpu/drm/amd/pm/swsmu/inc/amdgpu_smu.h b/drivers/gpu/drm/amd/pm/swsmu/inc/amdgpu_smu.h
--- a/drivers/gpu/drm/amd/pm/swsmu/inc/amdgpu_smu.h
+++ b/drivers/gpu/drm/amd/pm/swsmu/inc/amdgpu_smu.h
@@ -748,6 +748,8 @@ struct smu_context {
 	long *custom_profile_params;
 	bool pm_enabled;
 	bool is_apu;
+	/* PMFW has been through S0i3 since it was last unloaded */
+	bool s0ix_seen;
 
 	/* Power dependency link from an integrated xHCI controller to the GPU */
 	struct device_link		*usb_power_link;
diff --git a/drivers/gpu/drm/amd/pm/swsmu/smu13/smu_v13_0_4_ppt.c b/drivers/gpu/drm/amd/pm/swsmu/smu13/smu_v13_0_4_ppt.c
--- a/drivers/gpu/drm/amd/pm/swsmu/smu13/smu_v13_0_4_ppt.c
+++ b/drivers/gpu/drm/amd/pm/swsmu/smu13/smu_v13_0_4_ppt.c
@@ -230,6 +230,17 @@ static int smu_v13_0_4_system_features_control(struct smu_context *smu, bool en)
 	int ret = 0;
 
 	if (!en && !adev->in_s0ix) {
+		/*
+		 * After an S0i3 cycle PMFW does not answer GfxDeviceDriverReset
+		 * and the whole SoC stops. Leave PMFW running, as is already done
+		 * for S0i3 on GFX11 APUs; the platform powers off after the
+		 * image is written and PMFW cold-boots before restore.
+		 */
+		if (adev->in_s4 && smu->s0ix_seen) {
+			dev_info(adev->dev, "Skipping MP1 unload for S4 after S0i3\n");
+			return 0;
+		}
+
 		if (adev->in_s4) {
 			/* Adds a GFX reset as workaround just before sending the
 			 * MP1_UNLOAD message to prevent GC/RLC/PMFW from entering
@@ -242,6 +253,8 @@ static int smu_v13_0_4_system_features_control(struct smu_context *smu, bool en)
 		}
 
 		ret = smu_cmn_send_smc_msg(smu, SMU_MSG_PrepareMp1ForUnload, NULL);
+		if (!ret)
+			smu->s0ix_seen = false;
 	}
 
 	return ret;
