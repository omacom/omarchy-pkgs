diff --git a/include/linux/mmzone.h b/include/linux/mmzone.h
--- a/include/linux/mmzone.h
+++ b/include/linux/mmzone.h
@@ -1715,6 +1715,8 @@ void kswapd_try_clear_hopeless(struct pglist_data *pgdat,
 			       unsigned int order, int highest_zoneidx);
 void kswapd_clear_hopeless(pg_data_t *pgdat, enum kswapd_clear_hopeless_reason reason);
 bool kswapd_test_hopeless(pg_data_t *pgdat);
+void kswapd_reset_on_recovery_get(void);
+void kswapd_reset_on_recovery_put(void);
 
 /*
  * Memory initialization context, use to differentiate memory added by
diff --git a/mm/page_alloc.c b/mm/page_alloc.c
--- a/mm/page_alloc.c
+++ b/mm/page_alloc.c
@@ -2823,6 +2823,20 @@ static int nr_pcp_high(struct per_cpu_pages *pcp, struct zone *zone,
 	return high;
 }
 
+static DEFINE_STATIC_KEY_FALSE(kswapd_reset_on_recovery);
+
+void kswapd_reset_on_recovery_get(void)
+{
+	static_branch_inc(&kswapd_reset_on_recovery);
+}
+EXPORT_SYMBOL_GPL(kswapd_reset_on_recovery_get);
+
+void kswapd_reset_on_recovery_put(void)
+{
+	static_branch_dec(&kswapd_reset_on_recovery);
+}
+EXPORT_SYMBOL_GPL(kswapd_reset_on_recovery_put);
+
 /*
  * Tune pcp alloc factor and adjust count & free_count. Free pages to bring the
  * pcp's watermarks below high.
@@ -2925,8 +2939,10 @@ static bool free_frozen_page_commit(struct zone *zone,
 		 * 'hopeless node' to stay in that state for a while.  Let
 		 * kswapd work again by resetting kswapd_failures.
 		 */
-		if (kswapd_test_hopeless(pgdat) &&
-		    next_memory_node(pgdat->node_id) < MAX_NUMNODES)
+		if (static_branch_unlikely(&kswapd_reset_on_recovery) ?
+		    atomic_read(&pgdat->kswapd_failures) :
+		    (kswapd_test_hopeless(pgdat) &&
+		     next_memory_node(pgdat->node_id) < MAX_NUMNODES))
 			kswapd_clear_hopeless(pgdat, KSWAPD_CLEAR_HOPELESS_PCP);
 	}
 	return ret;
