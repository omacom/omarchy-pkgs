diff --git a/drivers/gpu/drm/xe/xe_shrinker.c b/drivers/gpu/drm/xe/xe_shrinker.c
--- a/drivers/gpu/drm/xe/xe_shrinker.c
+++ b/drivers/gpu/drm/xe/xe_shrinker.c
@@ -374,3 +374,18 @@ int xe_shrinker_create(struct xe_device *xe)
 
 	return drmm_add_action_or_reset(&xe->drm, xe_shrinker_fini, shrinker);
 }
+
+static void xe_shrinker_kswapd_reset_fini(struct drm_device *drm, void *arg)
+{
+	kswapd_reset_on_recovery_put();
+}
+
+int xe_shrinker_kswapd_reset_init(struct xe_device *xe)
+{
+	if (IS_DGFX(xe))
+		return 0;
+
+	kswapd_reset_on_recovery_get();
+
+	return drmm_add_action_or_reset(&xe->drm, xe_shrinker_kswapd_reset_fini, NULL);
+}
