diff --git a/drivers/acpi/ec.c b/drivers/acpi/ec.c
--- a/drivers/acpi/ec.c
+++ b/drivers/acpi/ec.c
@@ -2366,6 +2366,25 @@
 	{ },
 };
 
+/*
+ * MacBookPro14,3 has an ECDT and no PNP0D80 device, so lps0_device_attach()
+ * never marks the EC GPE wake-capable. Lid open arrives as an EC query that
+ * notifies LID0. In s2idle, acpi_set_gpe_wake_mask() then returns AE_TYPE and
+ * the EC wrapper ignores it, so the lid event is processed only after another
+ * wakeup. The same helper LPS0 uses is enough; it only sets ACPI_GPE_CAN_WAKE.
+ *
+ * https://github.com/omacom/omarchy/pull/14692
+ */
+static const struct dmi_system_id acpi_ec_mbp143_gpe_wake[] __initconst = {
+	{
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "Apple Inc."),
+			DMI_MATCH(DMI_PRODUCT_NAME, "MacBookPro14,3"),
+		},
+	},
+	{ },
+};
+
 void __init acpi_ec_init(void)
 {
 	int result;
@@ -2387,4 +2406,13 @@
 	platform_driver_register(&acpi_ec_driver);
 
 	acpi_ec_ecdt_start();
+
+	/*
+	 * After the boot EC exists. The helper no-ops when ec_no_wakeup is set.
+	 */
+	if (dmi_check_system(acpi_ec_mbp143_gpe_wake) && first_ec &&
+	    !ec_no_wakeup && first_ec->gpe >= 0) {
+		acpi_ec_mark_gpe_for_wake();
+		pr_info("GPE=0x%x marked wake-capable\n", first_ec->gpe);
+	}
 }
