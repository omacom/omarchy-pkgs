diff --git a/kernel/sched/MuQSS.c b/kernel/sched/MuQSS.c
--- a/kernel/sched/MuQSS.c
+++ b/kernel/sched/MuQSS.c
@@ -4586,6 +4586,8 @@ void sched_tick(void)
 	rq->last_scheduler_tick = rq->last_jiffy;
 	rq->last_tick = rq->clock;
 	perf_event_task_tick();
+	if (rq->curr->flags & PF_WQ_WORKER)
+		wq_worker_tick(rq->curr);
 	sched_stop_tick(rq, cpu);
 }
 
diff --git a/kernel/workqueue.c b/kernel/workqueue.c
--- a/kernel/workqueue.c
+++ b/kernel/workqueue.c
@@ -1439,7 +1439,7 @@ void wq_worker_running(struct task_struct *task)
 	 * CPU intensive auto-detection cares about how long a work item hogged
 	 * CPU without sleeping. Reset the starting timestamp on wakeup.
 	 */
-	worker->current_at = tsk_seruntime(worker->task);
+	worker->current_at = READ_ONCE(tsk_seruntime(worker->task));
 
 	WRITE_ONCE(worker->sleeping, 0);
 }
@@ -1524,7 +1524,7 @@ void wq_worker_tick(struct task_struct *task)
 	 * We probably want to make this prettier in the future.
 	 */
 	if ((worker->flags & WORKER_NOT_RUNNING) || READ_ONCE(worker->sleeping) ||
-	    tsk_seruntime(worker->task) - worker->current_at <
+	    READ_ONCE(tsk_seruntime(worker->task)) - worker->current_at <
 	    wq_cpu_intensive_thresh_us * NSEC_PER_USEC)
 		return;
 
@@ -3267,7 +3267,7 @@ __acquires(&pool->lock)
 	worker->current_func = work->func;
 	worker->current_pwq = pwq;
 	if (worker->task)
-		worker->current_at = tsk_seruntime(worker->task);
+		worker->current_at = READ_ONCE(tsk_seruntime(worker->task));
 	worker->current_start = jiffies;
 	work_data = *work_data_bits(work);
 	worker->current_color = get_work_color(work_data);
