diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -14113,6 +14113,40 @@ static int get_amd_vsdb(struct amdgpu_dm_connector *aconnector,
 	return connector->display_info.amd_vsdb.version != 0;
 }
 
+/*
+ * The DMCU EDID parser never reports the FreeSync MCCS VCP code, and DMUB
+ * firmware may leave it at 0 too. Read it from the EDID's AMD VSDB instead,
+ * using the layout mainline parses in drm_edid (struct amd_vsdb_v1_payload):
+ * OUI (3 bytes), version, feature caps, min vfreq, max vfreq, MCCS VCP code.
+ */
+static u8 amdgpu_dm_cea_amd_vsdb_vcp_code(const u8 *cea_ext)
+{
+	int end = cea_ext[2];
+	int i = 4;
+
+	/* Data blocks occupy bytes 4 .. end-1 of the CTA extension. */
+	if (end < 4 || end > EDID_LENGTH - 1)
+		return 0;
+
+	while (i < end) {
+		int tag = cea_ext[i] >> 5;
+		int len = cea_ext[i] & 0x1f;
+		const u8 *p = &cea_ext[i + 1];
+
+		if (i + 1 + len > end)
+			break;
+
+		/* Vendor-specific data block, AMD OUI 00-00-1A, version >= 1 */
+		if (tag == 3 && len >= 8 &&
+		    p[0] == 0x1a && p[1] == 0x00 && p[2] == 0x00 && p[3] >= 1)
+			return p[7];
+
+		i += 1 + len;
+	}
+
+	return 0;
+}
+
 static int parse_hdmi_amd_vsdb(struct amdgpu_dm_connector *aconnector,
 			       const struct edid *edid,
 			       struct amdgpu_hdmi_vsdb_info *vsdb_info)
@@ -14142,6 +14176,15 @@ static int parse_hdmi_amd_vsdb(struct amdgpu_dm_connector *aconnector,
 
 	valid_vsdb_found = parse_edid_cea(aconnector, edid_ext, EDID_LENGTH, vsdb_info);
 
+	if (valid_vsdb_found && !vsdb_info->freesync_mccs_vcp_code) {
+		vsdb_info->freesync_mccs_vcp_code =
+			amdgpu_dm_cea_amd_vsdb_vcp_code(edid_ext);
+		if (vsdb_info->freesync_mccs_vcp_code)
+			drm_dbg_driver(aconnector->base.dev,
+				       "VRR: FreeSync MCCS VCP code 0x%02x taken from EDID AMD VSDB\n",
+				       vsdb_info->freesync_mccs_vcp_code);
+	}
+
 	return valid_vsdb_found ? i : -ENODEV;
 }
 
