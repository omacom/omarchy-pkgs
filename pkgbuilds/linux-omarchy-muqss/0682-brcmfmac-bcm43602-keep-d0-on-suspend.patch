diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
@@ -2659,6 +2659,17 @@ static int brcmf_pcie_pm_enter_D3(struct device *dev)
 
 	devinfo->state = BRCMFMAC_PCIE_STATE_DOWN;
 
+	/*
+	 * MacBookPro14,3 BCM43602 only (14e4:43ba subsystem 106b:0173).
+	 * pci_save_state() sets state_saved so pci_prepare_to_sleep is
+	 * skipped and this device stays in D0. Other chips are unchanged.
+	 */
+	if (devinfo->pdev->vendor == 0x14e4 &&
+	    devinfo->pdev->device == 0x43ba &&
+	    devinfo->pdev->subsystem_vendor == 0x106b &&
+	    devinfo->pdev->subsystem_device == 0x0173)
+		pci_save_state(devinfo->pdev);
+
 	return 0;
 }
 
