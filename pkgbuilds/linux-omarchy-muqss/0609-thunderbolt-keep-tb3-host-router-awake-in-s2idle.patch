diff --git a/drivers/thunderbolt/switch.c b/drivers/thunderbolt/switch.c
--- a/drivers/thunderbolt/switch.c
+++ b/drivers/thunderbolt/switch.c
@@ -16,6 +16,7 @@
 #include <linux/sizes.h>
 #include <linux/slab.h>
 #include <linux/string_helpers.h>
+#include <linux/suspend.h>
 
 #include "tb.h"
 
@@ -3673,10 +3674,27 @@ void tb_switch_suspend(struct tb_switch *sw, bool runtime)
 
 	tb_switch_set_wake(sw, flags, runtime);
 
-	if (tb_switch_is_usb4(sw))
+	if (tb_switch_is_usb4(sw)) {
 		usb4_switch_set_sleep(sw);
-	else
-		tb_lc_set_sleep(sw);
+		return;
+	}
+
+	/*
+	 * The LC sleep bit prepares a Thunderbolt 3 router for power
+	 * removal. In suspend-to-idle the host router stays powered. On
+	 * Alpine Ridge hosts (MacBookPro14,3) setting the bit there
+	 * makes the router stop answering: its PCIe downstream ports are
+	 * already inaccessible before they reach D3hot, and every
+	 * tb_cfg access on resume fails with -ESHUTDOWN. Leave the host
+	 * router awake for suspend-to-idle only.
+	 */
+	if (!runtime && !tb_route(sw) &&
+	    pm_suspend_target_state == PM_SUSPEND_TO_IDLE) {
+		tb_sw_dbg(sw, "suspend-to-idle, not setting LC sleep\n");
+		return;
+	}
+
+	tb_lc_set_sleep(sw);
 }
 
 /**
