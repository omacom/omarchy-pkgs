pkgname=perftest
pkgver=26.04.17
pkgrel=1
pkgdesc='InfiniBand and RoCE verbs performance tests (ib_write_bw, ib_send_lat, ...)'
arch=('aarch64')
url='https://github.com/linux-rdma/perftest'
license=('GPL-2.0-only OR BSD-2-Clause')
depends=('rdma-core' 'pciutils')
makedepends=('autoconf' 'automake' 'libtool' 'pkgconf')
source=("perftest-${pkgver}.tar.gz::https://github.com/linux-rdma/perftest/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('18446f0390dbb097e623ab5f100ba163de6867bc5ad4e42669701e3ca3c4a4bf')
prepare() {
  cd "${srcdir}/perftest-${pkgver}"
  ./autogen.sh
}
build() {
  cd "${srcdir}/perftest-${pkgver}"
  ./configure --prefix=/usr
  make
}
package() {
  cd "${srcdir}/perftest-${pkgver}"
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
