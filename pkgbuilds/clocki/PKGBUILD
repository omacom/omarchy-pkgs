pkgname=clocki
pkgver=1.1.0
pkgrel=1
pkgdesc='Minimal floating work timer overlay'
arch=('any')
url='https://github.com/MasihMoafi/clocki'
license=('MIT')
depends=('electron')
makedepends=('npm')

_commit=7261748e48c46c36ccee73ef249ea451773c9566
_srcdir="${pkgname}-${_commit}"
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/${_commit}.tar.gz"
        'LICENSE'
        'clocki.sh'
        'io.github.masihmoafi.clocki.desktop')
sha256sums=('74c66613cce27860a7aaf12df0ac30dad3217de701daf8698f26e267cc34933e'
            '7a88436a1c6d817040efc292a1f03de0538cbea9ebad0c89068abeca6d8b04e9'
            '7275cb55f0018191511844f8fbe9f3d5be89a4101fdf1d423283471158ffee1f'
            '2325aa2faa1a97f22ee335ab724feda7fa4d2e9e518ba2764ce84e080a58cb68')

prepare() {
  cd "${srcdir}/${_srcdir}"
  sed -i '/"main": "dist\/main.js",/a\
  "desktopName": "io.github.masihmoafi.clocki.desktop",' package.json
}

build() {
  cd "${srcdir}/${_srcdir}"
  npm ci --ignore-scripts
  npm run build
}

package() {
  cd "${srcdir}/${_srcdir}"

  install -Dm644 dist/main.js "${pkgdir}/usr/lib/${pkgname}/dist/main.js"
  install -Dm644 dist/preload.js "${pkgdir}/usr/lib/${pkgname}/dist/preload.js"
  install -Dm644 src/overlay.html "${pkgdir}/usr/lib/${pkgname}/src/overlay.html"
  install -Dm644 assets/icon.png "${pkgdir}/usr/lib/${pkgname}/assets/icon.png"
  install -Dm644 package.json "${pkgdir}/usr/lib/${pkgname}/package.json"
  install -Dm644 assets/icon.png \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/${pkgname}.png"
  install -Dm755 "${srcdir}/clocki.sh" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 "${srcdir}/io.github.masihmoafi.clocki.desktop" \
    "${pkgdir}/usr/share/applications/io.github.masihmoafi.clocki.desktop"
  install -Dm644 "${srcdir}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
