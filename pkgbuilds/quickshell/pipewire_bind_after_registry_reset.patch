Don't bind PipeWire objects after the registry is reset.

PwRegistry::reset() destroys the registry proxy before the objects it owns.
Destroying each object can re-enter QML (Pipewire.nodes changes, and a
PwObjectTracker binding re-evaluates), which may ref() an object that is not
bound yet. ref() then binds it through pw_registry_bind() on the null registry
proxy and segfaults. This crashes the shell whenever PipeWire reports a fatal
error while the audio panel tracks nodes, e.g. a failed Bluetooth transport.

https://github.com/omacom/omarchy/issues/15838

diff --git a/src/services/pipewire/registry.cpp b/src/services/pipewire/registry.cpp
index 4b670b1..d4b9a42 100644
--- a/src/services/pipewire/registry.cpp
+++ b/src/services/pipewire/registry.cpp
@@ -65,6 +65,13 @@ void PwBindableObject::unref() {
 }
 
 void PwBindableObject::registryBind(const char* interface, quint32 version) {
+	// PwRegistry::reset() destroys the registry proxy before the objects it owns. Destroying each
+	// object can re-enter QML, which may ref (and so bind) an object that has not been destroyed yet.
+	if (this->registry == nullptr || this->registry->object == nullptr) {
+		qCDebug(logRegistry) << "Not binding object" << this << "as its registry is gone";
+		return;
+	}
+
 	// NOLINTNEXTLINE
 	auto* object = pw_registry_bind(this->registry->object, this->id, interface, version, 0);
 	this->object = static_cast<pw_proxy*>(object);
diff --git a/src/services/pipewire/registry.hpp b/src/services/pipewire/registry.hpp
index ec0a9ea..7b6063d 100644
--- a/src/services/pipewire/registry.hpp
+++ b/src/services/pipewire/registry.hpp
@@ -74,6 +74,7 @@ protected:
 	void bind() override {
 		if (this->object != nullptr) return;
 		this->registryBind(INTERFACE, VERSION);
+		if (this->object == nullptr) return;
 		this->PwBindableObject::bind();
 	}
 
