{
  "source": "local",
  "upstream": {
    "watch": {
      "github": "quickshell-mirror/quickshell",
      "pattern": "v(?P<version>[0-9]+(?:\\.[0-9]+)*)",
      "variables": {
        "_commit": "{commit}"
      }
    }
  },
  "rebuild_on": [
    "qt6-base",
    "qt6-declarative",
    "qt6-wayland"
  ],
  "rebuilt_against": {
    "x86_64": {
      "qt6-base": "6.12.0-3",
      "qt6-declarative": "6.12.0-1",
      "qt6-wayland": "6.12.0-1"
    },
    "aarch64": {
      "qt6-base": "6.12.0-3",
      "qt6-declarative": "6.12.0-1",
      "qt6-wayland": "6.12.0-1"
    }
  }
}
