+++ qs-cursor/src/wayland/wlr_layershell/wlr_layershell.cpp	2026-11-16 21:27:17.106815395 -0700
@@ -79,6 +79,7 @@
 	);
 
 	this->updateAutoExclusion();
+	this->applyCursorShape();
 }
 
 ProxiedWindow* WlrLayershell::disownWindow(bool keepItemOwnership) {
@@ -133,6 +134,15 @@
 
 void WlrLayershell::onStateChanged() { this->schedulePolish(); }
 
+// Qt's wayland backend keeps a window's cursor as the one to send when the pointer enters,
+// so setting it before the window is shown covers the first enter as well.
+void WlrLayershell::applyCursorShape() {
+	if (this->window == nullptr) return;
+
+	if (this->bCursorShape == Qt::ArrowCursor) this->window->unsetCursor();
+	else this->window->setCursor(this->bCursorShape.value());
+}
+
 bool WlrLayershell::aboveWindows() const { return this->layer() > WlrLayer::Bottom; }
 
 void WlrLayershell::setAboveWindows(bool aboveWindows) {
