From 0c3d4d50dd8849f8ccef2170bf81758ab0807b0e Mon Sep 17 00:00:00 2001
From: Marius Lifvergren <192463151+Lifferado@users.noreply.github.com>
Date: Mon, 19 Oct 2026 21:41:03 +0200
Subject: [PATCH] io/socket: don't touch a socket deleted by an error handler

onSocketError emits error() before cleaning up. If a handler responds by
setting connected = false, disconnectFromServer() emits disconnected()
synchronously and onSocketDisconnected() deletes the socket and nulls the
pointer. onSocketError then sees !connected and calls deleteLater() on
nullptr, which segfaults.

This happens whenever the peer of a QML Socket with
`onError: connected = false` goes away, e.g. restarting the daemon on the
other end.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/io/socket.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/io/socket.cpp b/src/io/socket.cpp
index d790e7b51..c2dfba402 100644
--- a/src/io/socket.cpp
+++ b/src/io/socket.cpp
@@ -74,7 +74,7 @@ void Socket::onSocketError(QLocalSocket::LocalSocketError error) {
 	qCWarning(logSocket) << "Socket error for" << this << error;
 	emit this->error(error);
 
-	if (!this->connected) {
+	if (!this->connected && this->socket != nullptr) {
 		QObject::disconnect(this->socket, nullptr, this, nullptr);
 		this->socket->deleteLater();
 		this->socket = nullptr;
