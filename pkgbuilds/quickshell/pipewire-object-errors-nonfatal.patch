--- a/src/services/pipewire/core.cpp
+++ b/src/services/pipewire/core.cpp
@@ -152,6 +152,17 @@ void PwCore::onError(void* data, quint32 id, qint32 /*seq*/, qint32 res, const c
 		return;
 	}
 
+	// An error on an object other than the core concerns that object only, e.g. a
+	// bluetooth node whose transport failed (EFAULT) when the headset drops or the
+	// machine suspends. The connection itself is still healthy. Treating it as fatal
+	// tears down and rebuilds every tracked object, and the shell has been seen to
+	// segfault during that teardown.
+	if (id != PW_ID_CORE) {
+		qCWarning(logLoop) << "Pipewire error on object" << id << "with code" << res << message
+		                   << "(not fatal, ignoring)";
+		return;
+	}
+
 	qCWarning(logLoop) << "Pipewire error on object" << id << "with code" << res << message;
 
 	emit self->fatalError();
