+#pragma once
+
+#include <qdir.h>
+#include <qhash.h>
+#include <qmutex.h>
+#include <qstring.h>
+
+namespace qs::qmlcache {
+
+// Serializes the URL interceptor's on-demand scans across the GUI and loader threads.
+QRecursiveMutex& scanMutex();
+
+// Guards the scanner's file intercepts, which the loader thread reads while a
+// scan can still add to them. Held only around the map itself, never while
+// calling out, since the cache hook takes it under Qt's metatype lock.
+QMutex& interceptMutex();
+
+// Serves QML from a compiled cache in `cacheDir`, so a later start skips
+// parsing and compiling every file it loads. Units are keyed by the exact text
+// the engine would load, so any change to a file, an intercept or a Qt update
+// misses and compiles again.
+void install(const QDir& cacheDir);
+
+// The config root `qs:@/qs/` maps to and the scanner's intercepted texts.
+void setGeneration(const QDir& configRoot, const QHash<QString, QString>* fileIntercepts);
+void clearGeneration(const QHash<QString, QString>* fileIntercepts);
+
+} // namespace qs::qmlcache
