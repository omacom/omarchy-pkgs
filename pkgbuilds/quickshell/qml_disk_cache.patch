diff --git c/src/core/qmlcache.cpp i/src/core/qmlcache.cpp
new file mode 100644
index 0000000..3b2cc18
--- /dev/null
+++ i/src/core/qmlcache.cpp
@@ -0,0 +1,299 @@
+#include "qmlcache.hpp"
+
+#include <cstddef>
+#include <cstring>
+#include <limits>
+
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <private/qqmljscompiler_p.h>
+#include <private/qv4compileddata_p.h>
+#include <qcryptographichash.h>
+#include <qdatetime.h>
+#include <qdiriterator.h>
+#include <qfile.h>
+#include <qhash.h>
+#include <qlogging.h>
+#include <qloggingcategory.h>
+#include <qmutex.h>
+#include <qqmlprivate.h>
+#include <qsavefile.h>
+#include <qset.h>
+#include <qthread.h>
+#include <qthreadpool.h>
+#include <qurl.h>
+
+#include "logcat.hpp"
+
+namespace qs::qmlcache {
+
+namespace {
+QS_LOGGING_CATEGORY(logQmlCache, "quickshell.qmlcache", QtWarningMsg);
+
+// Entries not loaded for this long are removed when the cache is installed.
+constexpr qint64 PRUNE_AFTER_DAYS = 30;
+
+struct Generation {
+	QDir configRoot;
+	const QHash<QString, QString>* fileIntercepts = nullptr;
+};
+
+struct State {
+	QMutex mutex;
+	QDir cacheDir;
+	// Live generations; the cache serves only while there is one.
+	QList<Generation> generations;
+	QHash<QByteArray, QQmlPrivate::CachedQmlUnit*> units;
+	QSet<QByteArray> pending;
+};
+
+State* state = nullptr; // NOLINT
+
+// The local file a qs: URL is served from (see QsInterceptNetworkAccessManager).
+QString localPath(const Generation& generation, const QUrl& url) {
+	auto path = url.path();
+	if (path.startsWith(QStringLiteral("@/qs/"))) return generation.configRoot.filePath(path.sliced(5));
+	if (path.startsWith('/')) return path;
+	return QString();
+}
+
+// Exactly what the engine would load: the scanner's rewrite of the file, or the file.
+bool servedText(const Generation& generation, const QString& path, QString& text) {
+	{
+		auto lock = QMutexLocker(&interceptMutex());
+		if (auto it = generation.fileIntercepts->constFind(path);
+		    it != generation.fileIntercepts->constEnd() && !it->isEmpty())
+		{
+			text = *it;
+			return true;
+		}
+	}
+
+	auto file = QFile(path);
+	if (!file.open(QFile::ReadOnly)) return false;
+	text = QString::fromUtf8(file.readAll());
+	return file.error() == QFile::NoError;
+}
+
+// The engine trusts a cached unit's offsets, so a damaged file must not reach
+// it. The checksum covers the flags, which saving sets after it was computed.
+bool checksumMatches(const QV4::CompiledData::Unit* unit) {
+	using Unit = QV4::CompiledData::Unit;
+	const auto* bytes = reinterpret_cast<const char*>(unit);
+	const auto start = offsetof(Unit, md5Checksum) + sizeof(unit->md5Checksum);
+	const auto flagsAt = offsetof(Unit, flags);
+	static_assert(offsetof(Unit, flags) > offsetof(Unit, md5Checksum));
+
+	const quint32_le flags(unit->flags & ~quint32(Unit::StaticData | Unit::PendingTypeCompilation));
+	auto hash = QCryptographicHash(QCryptographicHash::Md5);
+	hash.addData(QByteArrayView(bytes + start, flagsAt - start));
+	hash.addData(QByteArrayView(reinterpret_cast<const char*>(&flags), sizeof(flags)));
+	hash.addData(QByteArrayView(bytes + flagsAt + sizeof(flags), unit->unitSize - flagsAt - sizeof(flags)));
+	return std::memcmp(hash.result().constData(), unit->md5Checksum, sizeof(unit->md5Checksum)) == 0;
+}
+
+// Maps a compiled unit for the life of the process, as the engine expects of
+// a cached unit. A truncated, damaged or foreign file is rejected.
+const QV4::CompiledData::Unit* mapUnit(const QString& path, qint64* mtime) {
+	auto fd = ::open(path.toLocal8Bit().constData(), O_RDONLY | O_CLOEXEC);
+	if (fd == -1) return nullptr;
+
+	struct stat info {};
+	void* data = MAP_FAILED;
+	if (::fstat(fd, &info) == 0 && info.st_size >= static_cast<off_t>(sizeof(QV4::CompiledData::Unit))
+	    && info.st_size <= static_cast<off_t>(std::numeric_limits<quint32>::max()))
+	{
+		data = ::mmap(nullptr, info.st_size, PROT_READ, MAP_PRIVATE, fd, 0);
+	}
+	::close(fd);
+	if (data == MAP_FAILED) return nullptr;
+
+	// The engine checks the header again (Unit::verifyHeader is not exported);
+	// a unit from another Qt is recompiled here rather than refused there.
+	const auto* unit = static_cast<const QV4::CompiledData::Unit*>(data);
+	if (unit->unitSize != static_cast<quint32>(info.st_size)
+	    || std::memcmp(unit->magic, QV4::CompiledData::magic_str, sizeof(unit->magic)) != 0
+	    || unit->version != static_cast<quint32>(QV4_DATA_STRUCTURE_VERSION)
+	    // Without StaticData the engine would free the mapping.
+	    || (unit->flags & QV4::CompiledData::Unit::StaticData) == 0
+	    || (unit->flags & QV4::CompiledData::Unit::PendingTypeCompilation) == 0 || !checksumMatches(unit))
+	{
+		qCDebug(logQmlCache) << "Discarding" << path;
+		::munmap(data, info.st_size);
+		return nullptr;
+	}
+
+	*mtime = info.st_mtim.tv_sec;
+	return unit;
+}
+
+bool compile(const QUrl& url, const QString& text, const QString& out) {
+	auto file = QSaveFile(out);
+	if (!file.open(QIODevice::WriteOnly)) return false;
+
+	auto save = [&](const QV4::CompiledData::SaveableUnitPointer& unit,
+	                const QQmlJSAotFunctionMap& /*aot*/,
+	                const LookupSignatures& /*signatures*/,
+	                QString* /*error*/) {
+		return unit.saveToDisk<char>([&](const char* data, quint32 size) {
+			return file.write(data, size) == size;
+		});
+	};
+
+	// The unit records the URL it was compiled for, which the engine resolves
+	// relative URLs against, so it is the URL the engine asked for.
+	QmlIR::Document document(QString(), QString(), false);
+	QQmlJSCompileError error;
+	if (!qCompileQmlFile(
+	        document,
+	        url.toString(),
+	        save,
+	        nullptr,
+	        &error,
+	        false,
+	        QV4::Compiler::defaultCodegenWarningInterface(),
+	        &text
+	    ))
+	{
+		// The engine compiles the source itself and reports the error.
+		qCDebug(logQmlCache) << "Not caching" << url << error.message;
+		file.cancelWriting();
+		return false;
+	}
+
+	return file.commit();
+}
+
+// Compiles in the background, at idle priority, for the next start; this one
+// loads the source as it would have without a cache.
+QThreadPool* compilePool() {
+	static auto* pool = []() {
+		auto* pool = new QThreadPool();
+		pool->setMaxThreadCount(1);
+		pool->setThreadPriority(QThread::IdlePriority);
+		return pool;
+	}();
+	return pool;
+}
+
+void scheduleCompile(const QByteArray& key, const QUrl& url, const QString& text, const QString& file) {
+	compilePool()->start([key, url, text, file]() {
+		if (compile(url, text, file)) qCDebug(logQmlCache) << "Compiled" << url;
+		auto lock = QMutexLocker(&state->mutex);
+		state->pending.remove(key);
+	});
+}
+
+void schedulePrune() {
+	auto dir = state->cacheDir.path();
+	compilePool()->start([dir]() {
+		auto cutoff = QDateTime::currentDateTime().addDays(-PRUNE_AFTER_DAYS);
+		// With the temporary files a compile killed midway leaves.
+		auto it = QDirIterator(dir, {QStringLiteral("*.qmlc*")}, QDir::Files);
+		while (it.hasNext()) {
+			auto entry = it.nextFileInfo();
+			if (entry.lastModified() < cutoff) QFile::remove(entry.filePath());
+		}
+	});
+}
+
+const QQmlPrivate::CachedQmlUnit* lookup(const QUrl& url) {
+	if (state == nullptr || url.scheme() != QStringLiteral("qs")) return nullptr;
+	if (!url.path().endsWith(QStringLiteral(".qml"))) return nullptr;
+
+	// Held throughout, so the generation cannot be destroyed under the lookup.
+	// While a reload overlaps two generations, a lookup cannot tell which
+	// engine asks, and each is served its own scanner's text, so both compile.
+	auto lock = QMutexLocker(&state->mutex);
+	if (state->generations.size() != 1) return nullptr;
+	const auto& generation = state->generations.first();
+
+	auto path = localPath(generation, url);
+	if (path.isEmpty()) return nullptr;
+
+	QString text;
+	if (!servedText(generation, path, text)) return nullptr;
+
+	auto hash = QCryptographicHash(QCryptographicHash::Sha256);
+	hash.addData(QByteArrayView("quickshell-qmlcache-1\n"));
+	hash.addData(QByteArrayView(qVersion()));
+	hash.addData(QByteArray::number(QV4_DATA_STRUCTURE_VERSION));
+	hash.addData(url.toEncoded());
+	hash.addData(text.toUtf8());
+	auto key = hash.result().toHex();
+
+	if (auto it = state->units.constFind(key); it != state->units.constEnd()) return *it;
+
+	auto file = state->cacheDir.filePath(QString::fromLatin1(key) + QStringLiteral(".qmlc"));
+	qint64 mtime = 0;
+	const auto* unit = mapUnit(file, &mtime);
+
+	if (unit == nullptr) {
+		if (!state->pending.contains(key)) {
+			state->pending.insert(key);
+			scheduleCompile(key, url, text, file);
+		}
+		return nullptr;
+	}
+
+	// Loading an entry keeps it from being pruned.
+	if (QDateTime::currentSecsSinceEpoch() - mtime > 86400) {
+		auto handle = QFile(file);
+		if (handle.open(QFile::ReadWrite)) {
+			handle.setFileTime(QDateTime::currentDateTime(), QFile::FileModificationTime);
+		}
+	}
+
+	qCDebug(logQmlCache) << "Loaded" << url;
+	auto* cached = new QQmlPrivate::CachedQmlUnit {unit, nullptr, nullptr};
+	state->units.insert(key, cached);
+	return cached;
+}
+
+} // namespace
+
+QRecursiveMutex& scanMutex() {
+	static QRecursiveMutex mutex;
+	return mutex;
+}
+
+QMutex& interceptMutex() {
+	static QMutex mutex;
+	return mutex;
+}
+
+void install(const QDir& cacheDir) {
+	if (state != nullptr) return;
+	if (qEnvironmentVariableIntValue("QS_DISABLE_QML_CACHE") == 1) return;
+
+	if (!cacheDir.mkpath(QStringLiteral("."))) {
+		qCWarning(logQmlCache) << "Could not create QML cache directory" << cacheDir.path();
+		return;
+	}
+
+	state = new State();
+	state->cacheDir = cacheDir;
+	schedulePrune();
+
+	static QQmlPrivate::RegisterQmlUnitCacheHook hook {0, &lookup};
+	QQmlPrivate::qmlregister(QQmlPrivate::QmlUnitCacheHookRegistration, &hook);
+}
+
+void setGeneration(const QDir& configRoot, const QHash<QString, QString>* fileIntercepts) {
+	if (state == nullptr) return;
+	auto lock = QMutexLocker(&state->mutex);
+	state->generations.append({.configRoot = configRoot, .fileIntercepts = fileIntercepts});
+}
+
+void clearGeneration(const QHash<QString, QString>* fileIntercepts) {
+	if (state == nullptr) return;
+	auto lock = QMutexLocker(&state->mutex);
+	state->generations.removeIf([&](const Generation& generation) {
+		return generation.fileIntercepts == fileIntercepts;
+	});
+}
+
+} // namespace qs::qmlcache
