pkgname=quickshell
pkgver=0.3.2.r7.g2b4501a
pkgrel=11
pkgdesc='Flexible toolkit for making desktop shells with QtQuick'
arch=(x86_64 aarch64)
url='https://github.com/quickshell-mirror/quickshell'
license=(LGPL-3.0-only)
depends=(
  cpptrace
  glibc
  hicolor-icon-theme
  jemalloc
  libdrm
  libgcc
  libglvnd
  libpipewire
  libstdc++
  libxcb
  mesa
  pam
  polkit
  qt6-base
  qt6-declarative
  qt6-svg
  qt6-wayland
  wayland
)
makedepends=(
  cli11
  cmake
  git
  ninja
  qt6-shadertools
  spirv-tools
  vulkan-headers
  wayland-protocols
)
provides=("$pkgname")
conflicts=(quickshell-git)
# master past v0.3.2; the upstream watch writes the tag's commit here when
# the next release lands.
_commit=2b4501a282689792b62e94f3fb30d8f512324fe6
_archive="$pkgname"
source=("$_archive::git+$url.git#commit=$_commit"
        load_qtquick_611.patch
        load-patch-check.sh
        quickshell-check.hook)
sha256sums=('SKIP'
            'd18cdeab7929aa3c8b291d5cc4894e403ee7f7d4a2120f9e20ca52e81e30ec01'
            '4cff49b9da018ccf92270246b61b4a105a74b72e732dca8e8cb7828c59c8247b'
            '8543e21aeaaa5441b73a679160e7601a957f16c433e8d6bd9257e80bd0e94083')

prepare() {
  cd "$_archive"
  patch -Np1 --fuzz=0 -i "$srcdir/load_qtquick_611.patch"
}

build() {
  cd "$_archive"
  cmake -G Ninja -B build -W no-dev \
    -D CMAKE_BUILD_TYPE=RelWithDebInfo \
    -D DISTRIBUTOR='Omarchy' \
    -D CRASH_REPORTER=Off \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D INSTALL_QML_PREFIX=lib/qt6/qml
  cmake --build build
}

check() {
  # load_qtquick_611.patch changes how QML files and scripts are loaded: run
  # the built binary against configs that use it before it is packaged.
  bash "$srcdir/load-patch-check.sh" "$srcdir/$_archive/build/src/quickshell"
}

package() {
  install -Dm644 quickshell-check.hook -t "$pkgdir/usr/share/libalpm/hooks"
  cd "$_archive"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
