diff --git a/src/main.cpp b/src/main.cpp
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -1,3 +1,31 @@
+#include <cstddef>
+
 #include "launch/main.hpp"
 
+// Omarchy: jemalloc defaults for a desktop shell, read by jemalloc at startup.
+// Transparent huge pages back arenas with 2 MB pages that are mostly never
+// touched, the default of four arenas per CPU leaves each thread its own pool
+// of freed pages, and an idle process only purges what it freed when the
+// background thread does it. A MALLOC_CONF in the environment still overrides
+// these, and being compiled in, they don't reach the programs Quickshell runs.
+extern "C" {
+// NOLINTNEXTLINE(cppcoreguidelines-avoid-non-const-global-variables)
+const char* malloc_conf = "thp:never,narenas:1,background_thread:true";
+
+// Weak, so a build without jemalloc still links.
+int mallctl(const char* name, void* oldp, size_t* oldlenp, void* newp, size_t newlen)
+    __attribute__((weak));
+
+// jemalloc stops its background thread in a forked child and leaves it off,
+// so the --daemonize child turns it back on, unless MALLOC_CONF turned it off.
+void qs_omarchy_restore_background_thread() {
+	if (!mallctl) return;
+	bool wanted = false;
+	size_t len = sizeof(wanted);
+	if (mallctl("opt.background_thread", &wanted, &len, nullptr, 0) != 0 || !wanted) return;
+	bool enabled = true;
+	mallctl("background_thread", nullptr, nullptr, &enabled, sizeof(enabled));
+}
+}
+
 int main(int argc, char** argv) { return qs::launch::main(argc, argv); }
