# Audio DSP and compute DSP firmware for the ASUS Vivobook S16 S3607NA. The firmware only runs if
# it is signed for this board by ASUS, so linux-firmware cannot carry it until the OEM submits it.
# The OEM ships it in its Windows driver download, which this recipe unpacks without running. Each
# file is checked against the SHA-256 it was matched to and installed under the name the device
# tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so once
# linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=asus-vivobook-s16-s3607na-firmware
pkgver=20261114
pkgrel=1
pkgdesc='Audio DSP and compute DSP firmware for the ASUS Vivobook S16 S3607NA'
arch=('aarch64')
url='https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/48976/SOCPackage_forWebSite_Qualcomm_Z_V1.309.4500.0_48976.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-glymur-asustek-s3607na')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'asus-socpackage-48976.exe::https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/48976/SOCPackage_forWebSite_Qualcomm_Z_V1.309.4500.0_48976.exe'
)
source+=('README.package.md')
noextract=('asus-socpackage-48976.exe')
sha256sums=('3be6e7b17ea332999beee48cca8bc70a40bfd1d76ba740056b404bed3adbada0')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'asus-socpackage-48976.exe' 'asus-socpackage-48976' 7z-appended
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'asus-socpackage-48976/QualcommBSP/Subsystem/qcsubsys_ext_adsp8480/adsp_dtbs.elf' "$fw"/'qcom/glymur/ASUSTeK/S3607NA/adsp_dtbs.elf'
  install -Dm644 'asus-socpackage-48976/QualcommBSP/Subsystem/qcsubsys_ext_adsp8480/adspr.jsn' "$fw"/'qcom/glymur/ASUSTeK/S3607NA/adspr.jsn'
  install -Dm644 'asus-socpackage-48976/QualcommBSP/Subsystem/qcsubsys_ext_adsp8480/adsps.jsn' "$fw"/'qcom/glymur/ASUSTeK/S3607NA/adsps.jsn'
  install -Dm644 'asus-socpackage-48976/QualcommBSP/Subsystem/qcsubsys_ext_adsp8480/adspua.jsn' "$fw"/'qcom/glymur/ASUSTeK/S3607NA/adspua.jsn'
  install -Dm644 'asus-socpackage-48976/QualcommBSP/NPU/qcnspmcdm8480/cdsp_dtbs.elf' "$fw"/'qcom/glymur/ASUSTeK/S3607NA/cdsp_dtbs.elf'
  install -Dm644 'asus-socpackage-48976/QualcommBSP/Subsystem/qcsubsys_ext_adsp8480/qcadsp8480.mbn' "$fw"/'qcom/glymur/ASUSTeK/S3607NA/qcadsp8480.mbn'
  install -Dm644 'asus-socpackage-48976/QualcommBSP/NPU/qcnspmcdm8480/qccdsp8480.mbn' "$fw"/'qcom/glymur/ASUSTeK/S3607NA/qccdsp8480.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
213b2eba8f82a387806b6e334d5fdcaf6325acdb5f03a3c1d03a9ecb9c611a18  qcom/glymur/ASUSTeK/S3607NA/adsp_dtbs.elf
66ce8531efb7979d234e0f0eabbe18d038ac97da771a8a194f613df8f0724e81  qcom/glymur/ASUSTeK/S3607NA/adspr.jsn
12ac2f3ae8ced12aa4b06b3ab3a01bc4d8efe1c92ebea503c002f209a6ec176f  qcom/glymur/ASUSTeK/S3607NA/adsps.jsn
982a99853495e34726b8e44697fdfad303334de0a67cbf6cde306c8f1731000b  qcom/glymur/ASUSTeK/S3607NA/adspua.jsn
9bee104a48d4aac647287d6c1454df170c1cff7158a2352711fd1e2163ea6d1d  qcom/glymur/ASUSTeK/S3607NA/cdsp_dtbs.elf
6e98746ddb4a4c1b8c11f13f99319a1bf2e13ea6e9911865e120dfb27972b34d  qcom/glymur/ASUSTeK/S3607NA/qcadsp8480.mbn
acf13d29288d283793f418a36650e8a261eed927d30de109a59cb2210f458794  qcom/glymur/ASUSTeK/S3607NA/qccdsp8480.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
