# Maintainer: Walter Resendes <walter@accesstopower.com>

pkgname=omaink
pkgver=0.1.0
pkgrel=1
pkgdesc='Draw over your screen from a mouse, pen tablet or iPad'
arch=('x86_64' 'aarch64')
url='https://github.com/accesstopower/omaink'
license=('MIT')
options=('!debug')
depends=(
  'grim'
  'hicolor-icon-theme'
  'layer-shell-qt'
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'qt6-wayland'
)
optdepends=(
  'qrencode: QR code for pairing a tablet'
)
makedepends=(
  'gcc'
  'make'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/accesstopower/omaink/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('391cff66bc3301371522c7a93f015f3362336b7d71c92e60bdf23869038b4d60')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/omaink "$pkgdir/usr/bin/omaink"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/omaink.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaink.svg"
  install -Dm644 pkgbuild/omaink.desktop "$pkgdir/usr/share/applications/omaink.desktop"
}
