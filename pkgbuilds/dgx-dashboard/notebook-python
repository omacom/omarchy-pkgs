#!/usr/bin/python3
"""Select the compatible interpreter for Dashboard's first notebook setup only."""
import os
from pathlib import Path
import sys

PYTHON_VERSION = '3.12.14'


def command(args, home, uid):
    target = home / 'jupyterlab' / '.venv'
    if len(args) == 3 and args[:2] == ['-m', 'venv'] and Path(args[2]).absolute() == target:
        if uid == 0:
            raise ValueError('Dashboard notebook provisioning must run as the desktop user')
        if os.path.lexists(target):
            raise ValueError(f'Refusing to replace existing notebook environment: {target}')
        return ['/usr/bin/uv', '--no-config', 'venv', '--no-project', '--managed-python',
                '--python', PYTHON_VERSION, '--seed', str(target)]
    return ['/usr/bin/python3', *args]


if __name__ == '__main__':
    try:
        argv = command(sys.argv[1:], Path.home(), os.geteuid())
    except ValueError as error:
        sys.exit(str(error))
    os.execv(argv[0], argv)
