pkgname=dgx-dashboard
pkgver=0.25.11
pkgrel=6
pkgdesc='NVIDIA DGX Dashboard (experimental Arch integration)'
arch=('aarch64')
url='https://docs.nvidia.com/dgx/dgx-spark/dgx-dashboard.html'
license=('LicenseRef-NVIDIA')
depends=('glibc' 'pam' 'python' 'python-pip' 'xdg-utils' 'desktop-file-utils'
         'hicolor-icon-theme' 'systemd' 'dbus' 'logrotate' 'pacman' 'uv')
optdepends=('nvidia-utils: GPU telemetry')
options=('!strip')
backup=('opt/nvidia/dgx-dashboard-service/ports.env' 'etc/logrotate.d/dgx-dashboard')
source=(notebook-python patch-update-ui.py arch-package-status "https://repo.download.nvidia.com/spark/ubuntu/arm64/pool/common/d/dgx-dashboard/dgx-dashboard_${pkgver}_arm64.deb")
sha256sums=('c574937d127e29a992279a335c27fc0ee82544fcfe5f38faf8000bbff4201e8e' '2ad02e657969246079afd316925dece731a5780baaaf662032201cc2049f1aa6' 'd93322649395a7c1f98f166de411df495198437c44a2e27558a2ec513601c802' '7ac2a97f7364710bff02d74837d9d117764bda9fd3032c03ac34379aea0fac96')

package() {
  mkdir -p "${srcdir}/payload"
  cd "${srcdir}/payload"
  bsdtar -xf "${srcdir}/data.tar.xz"
  # Preserve paths embedded in the vendor binaries. Package files remain
  # root-owned; only the runtime notebook port map is service-writable.
  cp -a opt usr "${pkgdir}/"
  python "${srcdir}/patch-update-ui.py" "${pkgdir}/opt/nvidia/dgx-dashboard-service/dashboard-service"
  # The vendor archive carries the browser launcher without an executable bit,
  # so the desktop entry fails with permission denied; fix it here.
  chmod 755 "${pkgdir}/usr/bin/dgx-dashboard"
  install -Dm644 etc/dbus-1/system.d/com.nvidia.dgx.dashboard.admin1.conf \
    "${pkgdir}/usr/share/dbus-1/system.d/com.nvidia.dgx.dashboard.admin1.conf"
  install -Dm644 etc/logrotate.d/dgx-dashboard "${pkgdir}/etc/logrotate.d/dgx-dashboard"
  install -Dm644 etc/systemd/system/dgx-dashboard.service \
    "${pkgdir}/usr/lib/systemd/system/dgx-dashboard.service"
  install -Dm644 etc/systemd/system/dgx-dashboard-admin.service \
    "${pkgdir}/usr/lib/systemd/system/dgx-dashboard-admin.service"
  # ports.env controls the launcher and service; EnvironmentFile should be
  # authoritative rather than an additional hard-coded Environment directive.
  local unit="${pkgdir}/usr/lib/systemd/system/dgx-dashboard.service"
  sed -i -e '/^Description=NVIDIA DGX Dashboard Service$/a After=network.target dgx-dashboard-admin.service\nRequires=dgx-dashboard-admin.service' \
    -e 's/^WantedBy=default.target$/WantedBy=multi-user.target/' \
    -e '/^Environment=DGX_DASHBOARD_PORT=/d' "${unit}"
  grep -qx 'Requires=dgx-dashboard-admin.service' "${unit}"
  grep -qx 'WantedBy=multi-user.target' "${unit}"
  if grep -q 'DGX_DASHBOARD_PORT=' "${unit}"; then
    return 1
  fi
  install -Dm755 "${srcdir}/arch-package-status" "${pkgdir}/usr/lib/dgx-dashboard-arch/package-status"
  install -Dm755 "${srcdir}/notebook-python" "${pkgdir}/usr/lib/dgx-dashboard-arch/python3"
  ln -s package-status "${pkgdir}/usr/lib/dgx-dashboard-arch/apt"
  ln -s package-status "${pkgdir}/usr/lib/dgx-dashboard-arch/apt-cache"
  ln -s /usr/lib/dgx-dashboard-arch/package-status "${pkgdir}/usr/bin/dgx-arch-package-status"
  # The vendor operation couples Ubuntu aptdaemon, firmware and reboot. Keep
  # read-only inventory available while the native transaction path is ported.
  local policy="${pkgdir}/usr/share/dbus-1/system.d/com.nvidia.dgx.dashboard.admin1.conf"
  sed -i '/<allow send_interface="com.nvidia.dgx.dashboard.admin1"\/>/a\        <deny send_destination="com.nvidia.dgx.dashboard.admin1" send_member="UpdateAndReboot"/>' \
    "${policy}"
  grep -qF '<deny send_destination="com.nvidia.dgx.dashboard.admin1" send_member="UpdateAndReboot"/>' "${policy}"

  install -dm755 "${pkgdir}/usr/lib/sysusers.d" "${pkgdir}/usr/lib/tmpfiles.d" \
    "${pkgdir}/usr/lib/systemd/system/dgx-dashboard-admin.service.d"
  cat > "${pkgdir}/usr/lib/systemd/system/dgx-dashboard-admin.service.d/arch-status.conf" <<'EOF'
[Service]
Environment=PATH=/usr/lib/dgx-dashboard-arch:/usr/local/sbin:/usr/local/bin:/usr/bin
CacheDirectory=dgx-dashboard-arch
CacheDirectoryMode=0755
EOF
  cat > "${pkgdir}/usr/lib/sysusers.d/dgx-dashboard.conf" <<'EOF'
g dgx-dashboard-service-group -
u dgx-dashboard-service-user -:dgx-dashboard-service-group "DGX Dashboard" /nonexistent /usr/bin/nologin
EOF
  cat > "${pkgdir}/usr/lib/tmpfiles.d/dgx-dashboard.conf" <<'EOF'
f /opt/nvidia/dgx-dashboard-service/jupyterlab_ports.yaml 0644 dgx-dashboard-service-user dgx-dashboard-service-group -
EOF
  install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}"
  cp usr/share/doc/dgx-dashboard/{copyright,EULA.txt,NOTICES.txt} \
    "${pkgdir}/usr/share/licenses/${pkgname}/"
}
