#!/bin/bash
# DKMS build of the M4 Neural Engine module from omarchy-ane: ane_h16.ko
# (h16 generation: apple,t6041-ane / M4 Pro J616s, apple,t8132-ane /
# M4 Air J713 and M4 mini J773g).
#
# Opt-in, experimental: ane_h16 has no MODULE_DEVICE_TABLE, so nothing
# autoloads it; bring-up loads it by hand with its opt-in key:
#   modprobe ane_h16 optin=t6041   # or optin=t8132
# (ane/h16/ane_h16_main.c refuses to probe without the exact soc key.)
#
# Chip gate: the in-tree aurora ANE driver covers these boards since
# aurora-silicon/linux#1952 (T8132, merged 2026-11-15); where the kernel
# ships CONFIG_DRM_ACCEL_ANE the kernel keeps its own modules and DKMS
# skips this build (exit 77), the same rule as omarchy-ane-dkms.
#
# Source tree: dkms.conf, ane/h16/ and ane/h17/ (ane_h16 links
# ../h17/ane_h17_soc.o). The recipe replaces @PKGVER@, which becomes
# /sys/module/ane_h16/version.
PACKAGE_NAME="omarchy-ane-h16"
PACKAGE_VERSION="@PKGVER@"
MAKE[0]="make -C ${kernel_source_dir} M=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build/ane/h16 ANE_VERSION=${PACKAGE_VERSION} modules"
BUILT_MODULE_NAME[0]="ane_h16"
BUILT_MODULE_LOCATION[0]="ane/h16/"
DEST_MODULE_LOCATION[0]="/kernel/drivers/accel"
AUTOINSTALL="yes"
BUILD_EXCLUSIVE_CONFIG="!CONFIG_DRM_ACCEL_ANE"
