# Maintainer: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>

pkgname=omarchy-ane-h16-dkms
_srcname=omarchy-ane
pkgver=0.5.13
pkgrel=1
pkgdesc='Apple Neural Engine h16 module for M4 Macs (T6041/T8132, DKMS, opt-in bring-up, never autoloaded)'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/joshuaswarren/omarchy-ane'
license=('GPL-2.0-only OR MIT')
# omarchy-ane carries the tools, the libalpm hooks and the device-tree overlays; this
# package carries only the module source that dkms builds. G416.
depends=('dkms' 'omarchy-ane>=0.5.13')
checkdepends=('fakeroot' 'linux-aurora-headers')
optdepends=('linux-aurora-headers: build the module for linux-aurora'
            'linux-asahi-headers: build the module for linux-asahi')
source=("$_srcname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "dkms.conf.in")
sha256sums=('8912e3f66b082b568ec5926f4868e48d8f9de0a0bc39c43e96293047e7d4243f'
            '09b2620c4db1c4ad8e56b59dee7f30d2be49da3bb3a38b176685f3a4b5d39e15')

prepare() {
  # The DKMS source tree: our dkms.conf (generated from dkms.conf.in; the
  # upstream tag ships h16 outside its own dkms.conf on purpose) plus
  # ane/h16 and ane/h17 - ane_h16's kbuild links ../h17/ane_h17_soc.o.
  local src="$_srcname-$pkgver" dst="dkms/omarchy-ane-h16-$pkgver"
  rm -rf dkms
  install -d "$dst/ane/h16" "$dst/ane/h17"
  cp "$src/ane/h16/Makefile" "$src/ane/h16/ane_h16.h" \
     "$src/ane/h16/ane_h16_main.c" "$src/ane/h16/ane_h16_overlay.c" \
     "$src/ane/h16/ane_h16_overlay.h" "$src/ane/h16/ane_h16_soc.c" \
     "$dst/ane/h16/"
  cp "$src/ane/h17/"*.c "$src/ane/h17/"*.h "$dst/ane/h17/"
  sed "s/@PKGVER@/$pkgver/" "$srcdir/dkms.conf.in" > "$dst/dkms.conf"
}

check() {
  local build=(/usr/lib/modules/*/build)
  local kver=${build[0]%/build}
  kver=${kver##*/}
  rm -rf "$srcdir/check"
  mkdir -p "$srcdir/check/dkms" "$srcdir/check/src"
  local dkms_options=(--dkmstree "$srcdir/check/dkms" --sourcetree "$srcdir/check/src" -k "$kver")
  fakeroot dkms "${dkms_options[@]}" add "$srcdir/dkms/omarchy-ane-h16-$pkgver"
  local rc=0
  fakeroot dkms "${dkms_options[@]}" build "omarchy-ane-h16/$pkgver" || rc=$?
  case $rc in
    0) ls "$srcdir/check/dkms/omarchy-ane-h16/$pkgver/$kver"/*/module/ane_h16.ko* ;;
    77)
      # dkms.conf BUILD_EXCLUSIVE_CONFIG="!CONFIG_DRM_ACCEL_ANE": a kernel
      # that ships the in-tree ANE driver (aurora-silicon/linux #1952 covers
      # T8132) keeps its own modules.
      grep -qs '^CONFIG_DRM_ACCEL_ANE=[ym]' "${build[0]}"/{include/config/auto.conf,.config} ||
        { echo "check: dkms skipped $kver, which has no CONFIG_DRM_ACCEL_ANE" >&2; return 1; }
      echo "check: no DKMS build: $kver ships the in-tree ANE driver (CONFIG_DRM_ACCEL_ANE)" ;;
    *) return "$rc" ;;
  esac
}

package() {
  cd "$srcdir/dkms/omarchy-ane-h16-$pkgver"
  install -d "$pkgdir/usr/src"
  cp -r --no-preserve=ownership . "$pkgdir/usr/src/omarchy-ane-h16-$pkgver/"

  install -Dm644 "$srcdir/$_srcname-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
