pkgname=keycontroller
pkgver=0.1.4
pkgrel=1
pkgdesc='KeyController for Omarchy: SSH key widget, secure prompt and OpenSSH agent'
url='https://github.com/Wolfengo/KeyController'
arch=('x86_64' 'aarch64')
options=('!debug')
license=('MIT' 'Apache-2.0')
install=keycontroller.install
depends=('openssh>=10.5p1' 'qt6-base' 'qt6-svg' 'qt6-wayland' 'layer-shell-qt>=6.6' 'systemd' 'pam' 'python' 'polkit' 'wl-clipboard')
provides=("ssh-keys=$pkgver-$pkgrel")
conflicts=('ssh-keys')
replaces=('ssh-keys')
makedepends=('rust' 'cmake' 'ninja' 'qt6-wayland' 'qt6-declarative' 'wayland' 'at-spi2-core' 'dbus' 'glib2' 'pkgconf')
optdepends=('fprintd: biometric binding and unlocking' 'omarchy: bar widget')
source=("$url/releases/download/v$pkgver/keycontroller-$pkgver.tar.gz")
# scripts/package-source replaces this with the actual release digest.
sha256sums=('5229687d411fb3c1d8c7dd231ba3538baefef50aedabb193b1ccef16854e112e')

_set_qt_runtime_dependencies() {
  # Read the versions selected by CMake, never whichever Qt happens to be on
  # PATH when packaging. SONAME libQt6Core.so.6 does not encode its minor ABI.
  local qt_versions qt_base qt_svg index
  qt_versions=$(cat "$1") || return 1
  if [[ ! $qt_versions =~ ^(6\.[0-9]+\.[0-9]+)\ (6\.[0-9]+\.[0-9]+)$ ]]; then
    printf '%s\n' 'Invalid or missing build-time Qt versions' >&2
    return 1
  fi
  qt_base=${BASH_REMATCH[1]}
  qt_svg=${BASH_REMATCH[2]}
  for index in "${!depends[@]}"; do
    case ${depends[index]} in
      qt6-base) depends[index]="qt6-base>=$qt_base" ;;
      qt6-svg) depends[index]="qt6-svg>=$qt_svg" ;;
      qt6-wayland) depends[index]="qt6-wayland>=$qt_base" ;;
    esac
  done
}

build() {
  cd "$srcdir/keycontroller-$pkgver"
  cargo build --release --locked
  cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_SKIP_RPATH=ON
  cmake --build build
}

check() {
  cd "$srcdir/keycontroller-$pkgver"
  cargo test --locked
  ctest --test-dir build --output-on-failure
  python tests/setup.py
  python tests/systemd-boot.py
  python tests/sleep.py
  python tests/sleep-systemd.py
  python tests/widget-localization.py
  python tests/dependencies.py
  python tests/clipboard.py
  python tests/clipboard-wayland.py
  python tests/package-brand.py
  python tests/package-export.py
  python tests/package-qt-dependencies.py
  python tests/reproducible-export.py
  python tests/reproducible-release.py target/release/ssh-keysd
}

package() {
  cd "$srcdir/keycontroller-$pkgver"
  _set_qt_runtime_dependencies build/qt-runtime-versions || return 1
  install -Dm755 target/release/ssh-keysd "$pkgdir/usr/lib/ssh-keys/ssh-keysd"
  install -Dm755 target/release/build/keycontroller-*/out/harden.so "$pkgdir/usr/lib/ssh-keys/harden.so"
  install -Dm755 target/release/ssh-keys-panel-client "$pkgdir/usr/lib/ssh-keys/panel-client"
  install -Dm755 target/release/kctrl "$pkgdir/usr/bin/kctrl"
  install -Dm755 build/ssh-keys-prompt "$pkgdir/usr/lib/ssh-keys/prompt"
  install -Dm755 scripts/keycontroller-setup "$pkgdir/usr/bin/keycontroller-setup"
  install -Dm755 scripts/ssh-keys-sleep "$pkgdir/usr/lib/ssh-keys/sleep-coordinator"
  install -Dm755 scripts/ssh-keys-system-setup "$pkgdir/usr/lib/ssh-keys/system-setup"
  install -Dm644 packaging/ssh-keys-fingerprint "$pkgdir/etc/pam.d/ssh-keys-fingerprint"
  for unit in packaging/*.service packaging/*.socket; do
    install -Dm644 "$unit" "$pkgdir/usr/lib/systemd/system/${unit##*/}"
  done
  install -d "$pkgdir/usr/lib/systemd/system/sleep.target.requires"
  ln -s ../ssh-keys-sleep.service "$pkgdir/usr/lib/systemd/system/sleep.target.requires/ssh-keys-sleep.service"
  install -d "$pkgdir/usr/share/keycontroller"
  install -Dm644 packaging/keycontroller-hyprland.lua "$pkgdir/usr/share/keycontroller/keycontroller-hyprland.lua"
  # Keep the old include valid until each desktop user migrates its exact
  # managed block. One symlink to our current resource, never a second copy.
  install -d "$pkgdir/usr/share/ssh-keys"
  ln -s ../keycontroller/keycontroller-hyprland.lua "$pkgdir/usr/share/ssh-keys/keycontroller-hyprland.lua"
  python scripts/package-plugin "$pkgdir/usr/share/keycontroller/plugin"
  cp -r skills "$pkgdir/usr/share/keycontroller/"
  install -d "$pkgdir/usr/share/doc/keycontroller"
  install -m644 README.md preview.png "$pkgdir/usr/share/doc/keycontroller/"
  cp -r docs "$pkgdir/usr/share/doc/keycontroller/docs"
  # Preserve the documented installed API/security paths without duplicating files.
  ln -s docs/api.md "$pkgdir/usr/share/doc/keycontroller/api.md"
  ln -s docs/security.md "$pkgdir/usr/share/doc/keycontroller/security.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 plugin/icons/LICENSE.material-icons "$pkgdir/usr/share/licenses/$pkgname/Apache-2.0"
}
