# Recipe from asahi-alarm/PKGBUILDs lzfse 1.0-1. pkgrel stays above asahi-alarm's
# so installed Macs move to this build.
pkgname=lzfse
pkgver=1.0
pkgrel=2
pkgdesc='LZFSE compression library and command line tool'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/lzfse/lzfse'
license=('BSD-3-Clause')
depends=('glibc')
makedepends=('cmake')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgname-$pkgver.tar.gz")
sha256sums=('cf85f373f09e9177c0b21dbfbb427efaedc02d035d2aade65eb58a3cbf9ad267')

build() {
  cmake -B build -S "$pkgname-$pkgname-$pkgver" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -Wno-dev
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname-$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
