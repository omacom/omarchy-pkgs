# Contributor: Echo J. <aidas957 at gmail dot com>
# Contributor: Mysti

# Omarchy tracks Proton's own Linux release feed rather than the AUR, which
# has fallen weeks behind. .omarchy/upstream.sh rewrites the version and
# checksum below from that feed.

pkgname=proton-pass-bin
pkgver=1.42.0
pkgrel=1
pkgdesc="Proton Pass desktop app: end-to-end encrypted password manager"
arch=('x86_64')
url="https://proton.me/pass"
license=('GPL-3.0-or-later' 'MIT') # Proton Pass, bundled Electron

depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'glib2'
  'glibc'
  'gtk3'
  'libcups'
  'libgcc'
  'libnotify'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'xdg-utils'
)

provides=('proton-pass' 'protonpass')
conflicts=('proton-pass' 'protonpass')
options=('!debug' '!strip')

source=("https://proton.me/download/pass/linux/proton-pass_${pkgver}_amd64.deb")
noextract=("proton-pass_${pkgver}_amd64.deb")
sha256sums=('67c05db83dd4ce5ac784d6737979a9be9254a8af4f09f10d564c97f71b955564')

package() {
  cd "${srcdir}"

  bsdtar -xOf "proton-pass_${pkgver}_amd64.deb" data.tar.xz |
    bsdtar --no-same-owner -xf - -C "${pkgdir}"

  # Proton's deb ships some assets world-writable. Nothing in a password
  # manager's install tree should be writable by other users.
  chmod -R go-w "${pkgdir}/usr/lib/proton-pass"

  # Arch kernels allow unprivileged user namespaces, which Chromium's sandbox
  # uses in preference to this setuid-root helper, so drop the setuid bit.
  chmod u-s "${pkgdir}/usr/lib/proton-pass/chrome-sandbox"

  install -Dm644 "${pkgdir}/usr/share/doc/proton-pass/copyright" \
    "${pkgdir}/usr/share/licenses/${pkgname}/copyright"

  # Debian package-policy files are not used on Arch Linux.
  rm -rf "${pkgdir}/usr/share/doc" "${pkgdir}/usr/share/lintian"
}
