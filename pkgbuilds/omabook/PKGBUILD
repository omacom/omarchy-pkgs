# Maintainer: Jelle Spijker

pkgname=omabook
pkgver=0.5.2.3
pkgrel=1
pkgdesc="An ebook library and reader for Omarchy, with a knowledge graph of what you read and AI as a first-class citizen"
arch=('x86_64' 'aarch64')
url='https://jellespijker.github.io/omabook/'
# Omabook's own source is MIT. share/omabook/calibre_bridge.py runs inside
# Calibre and is GPL-3.0-or-later; the program links Poppler (GPL).
license=('MIT' 'GPL-3.0-or-later')
# Not with link-time optimisation, which makepkg turns on: GCC 16's, across
# the whole program, took a function for one value of an argument its callers
# pass several of (GraphCut::whole always cut at 2), and failed
# tenantreaders_tests (jellespijker/omabook#112). The package is built as every build of Omabook
# is tested.
options=('!debug' '!lto')
# restic makes the snapshots, the only copies of a library that count (Omabook's ADR 0014):
# a dependency, not a suggestion, as the snapshot tests need it too (jellespijker/omabook#181).
depends=(
  'ffmpeg'
  'hicolor-icon-theme'
  'libarchive'
  'libsodium'
  'opus'
  'poppler-qt6'
  'qt6-base'
  'qt6-declarative'
  'qt6-multimedia'
  'qt6-multimedia-ffmpeg'
  'qt6-svg'
  'qt6-wayland'
  'qt6-websockets'
  'restic'
  'xdg-desktop-portal'
)
optdepends=(
  'calibre: import Calibre libraries, use its metadata plugins, and read Kindle and other converted formats'
  'gnome-keyring: keep reading-site tokens in the keyring'
  'folio: Omabook libraries, what is being read and "Add to Library" in the file manager'
  'openssh: sync a library with another computer or a hub, link this computer to its hub, and keep snapshots over sftp'
  'hyphen-en: hyphenate English books'
  'hyphen-de: hyphenate German books'
  'hyphen-nl: hyphenate Dutch books'
  'speech-dispatcher: read books aloud, with espeak-ng or another synthesiser'
  'piper-tts: read books aloud in a natural voice, with a piper-voices-* voice (both from the AUR)'
  'voxtype-bin: write out recordings on this computer, with the speech to text Omarchy ships (from the omarchy repository)'
  'tailscale: the address for phones and e-readers by the name of this computer on the tailnet'
  'rclone: keep snapshots in a place rclone reaches (an rclone: destination)'
  'upower: let automatic sync with a hub wait while this computer is on battery'
  'networkmanager: let automatic sync with a hub wait on a metered connection'
)
makedepends=('cmake' 'gcc' 'make' 'pkgconf')
# The window tests measure text, so they need a font; the CLI tests make zips;
# the hyphenation tests need the dictionaries.
checkdepends=('dbus' 'ttf-dejavu' 'zip' 'hyphen-en' 'hyphen-de' 'hyphen-nl')
source=("$pkgname-$pkgver.tar.gz::https://github.com/jellespijker/omabook/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('81f57cabea4fb1860afd4f2cc5f0d96ccc6d4d6c540fa95452d53afffdc58249')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  QT_QPA_PLATFORM=offscreen dbus-run-session -- ctest --test-dir build --output-on-failure
}

# The hub's systemd units come with it (jellespijker/omabook#179): /usr/lib/systemd/user/omabook-hub.service,
# for a person's own user, and /usr/lib/systemd/system/omabook-hub.service, for a user
# of its own named omabook; each says in its comments how it is set up.
package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build --prefix /usr
}
