# Installing or upgrading this package retires copies of firmware that was
# packaged before --retire existed. No firmware path changes then, so
# mkinitcpio's hook does not run, and the boot image is rebuilt here if a copy
# was retired. After 80-qcom-firmware-retire.hook, so a transaction that also
# changes firmware finds nothing left to do here.
[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = qcom-firmware-extract

[Action]
Description = Retiring Qualcomm firmware copies that packaged firmware now ships...
When = PostTransaction
Exec = /usr/bin/qcom-firmware-extract --retire
