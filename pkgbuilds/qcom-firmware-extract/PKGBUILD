# Maintainer: Jimmy Van Veen

# Copy vendor-signed Qualcomm firmware named by the running device tree.

pkgname=qcom-firmware-extract
pkgver=1
pkgrel=6
pkgdesc="Copy vendor-signed Qualcomm Snapdragon firmware from the machine's Windows installation"
arch=('any')
url="https://github.com/omacom/omarchy-pkgs"
license=('GPL-2.0-or-later')
depends=('bash' 'coreutils' 'diffutils' 'findutils' 'util-linux' 'xz' 'zstd')
optdepends=(
  'cryptsetup: read-only access to BitLocker Windows volumes'
  'dislocker: read-only fallback for unsupported BitLocker metadata'
  'limine-mkinitcpio-hook: rebuild the boot image after installing firmware'
  'ntfs-3g: read-only fallback when the ntfs3 kernel driver cannot mount Windows'
)
options=('!debug')
source=(
  'qcom-firmware-extract'
  'README.package.md'
  'asus-zenbook-a16-required.list'
)
sha256sums=(
  'cfac7853888e0faaea2f6ff15c2a08efa4f6a9b5fe3b26d038421314fe7cd06b'
  'dd93d7e61b13eef6b9826d466572d79815c6263138d5775e6b06bf060f4ef22c'
  '4a5417f0c64c49785f52f6c21a9baa12dd6fe9df32fc9d0c9568fed9f2ad3338'
)

package() {
  install -Dm755 qcom-firmware-extract "${pkgdir}/usr/bin/qcom-firmware-extract"
  install -Dm644 README.package.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -dm755 "${pkgdir}/usr/share/${pkgname}/provided.d"
  for compatible in asus,zenbook-a16-ux3607oa asus,ux3607oa; do
    install -Dm644 asus-zenbook-a16-required.list \
      "${pkgdir}/usr/share/${pkgname}/required.d/$compatible.list"
  done
}
