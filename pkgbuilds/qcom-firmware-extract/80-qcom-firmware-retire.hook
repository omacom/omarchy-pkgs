# Runs before 90-mkinitcpio-install.hook, which rebuilds the boot image for the
# same firmware change. Installing this package runs it too, for firmware that
# was packaged before --retire existed; the DSP images load from the root
# filesystem, so they need no rebuild.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/firmware/qcom/*

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = qcom-firmware-extract

[Action]
Description = Retiring Qualcomm firmware copies that packaged firmware now ships...
When = PostTransaction
Exec = /usr/bin/qcom-firmware-extract --retire --no-rebuild
