# Maintainer: David Heinemeier Hansson <david@hey.com>

# Notion ships its Linux app only as a Flatpak, from its own OSTree repository.
# An OSTree commit's id is the SHA-256 of its commit object, so the checksums
# below are the pinned commits: makepkg verifies the downloaded object against
# them, and ostree verifies the signed tree under it. .omarchy/upstream.sh
# rewrites the version and commits from the repository's refs.

pkgname=notion-desktop
pkgver=7.41.1
pkgrel=1
pkgdesc="Official Notion desktop app"
arch=('x86_64' 'aarch64')
url="https://www.notion.com/desktop"
# Upstream ships no license text for the app itself; its terms live at
# https://www.notion.com/terms
license=('custom')

depends=(
  'alsa-lib'
  'at-spi2-core'
  'bash'
  'cairo'
  'dbus'
  'expat'
  'gcc-libs'
  'glib2'
  'glibc'
  'gtk3'
  'gtk4'
  'hicolor-icon-theme'
  'libadwaita'
  'libcups'
  'libnotify'
  'libpipewire'
  'libsecret'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'xdg-utils'
)

makedepends=('ostree' 'patchelf')
options=('!debug' '!strip')

# Same trade as perplexity: maximum zstd takes roughly a third off a ~400 MB
# Electron tree on the fast ring for a few extra minutes of build time.
COMPRESSZST=(zstd -c -z -q --ultra -22 --threads=0 -)

_remote="https://app.linux-packages.notion.com"
_appid="com.notion.app.desktop.notion"

sha256sums=('eaee758ccd03f0c229c4fdb4a2bf9cc9e750fe31949e63ea63f5495abedaeef6'
            '897775e01f61e3803608d2d1f83d0c80fe30208bd7d6841826ed275171106209')
sha256sums_x86_64=('759349e3230fc6c3129d242500a2a281df9f5df9648f6936653a5a6583619a42')
sha256sums_aarch64=('2d4d61ae1f3993c4ee639e7f0479130f4a702b9bea4aee7a81f24ecdf36be687')

_commit_x86_64="${sha256sums_x86_64[0]}"
_commit_aarch64="${sha256sums_aarch64[0]}"
source=('notion-desktop-launcher.sh'
        'notion-desktop.pgp')
source_x86_64=("${pkgname}-${pkgver}-x86_64.commit::${_remote}/objects/${_commit_x86_64:0:2}/${_commit_x86_64:2}.commit")
source_aarch64=("${pkgname}-${pkgver}-aarch64.commit::${_remote}/objects/${_commit_aarch64:0:2}/${_commit_aarch64:2}.commit")

prepare() {
  cd "${srcdir}"

  local commit_var="_commit_${CARCH}"
  local commit="${!commit_var}"

  # Pulling by commit rather than by ref keeps the build on the pinned
  # release; the signature is still checked against Notion's key.
  rm -rf repo flatpak
  ostree init --repo=repo --mode=bare-user-only
  ostree --repo=repo remote add --gpg-import=notion-desktop.pgp notion "${_remote}"
  ostree --repo=repo pull notion "${commit}"
  ostree --repo=repo checkout --user-mode "${commit}" flatpak
}

package() {
  cd "${srcdir}/flatpak"

  # The Electron app is self-contained under lib/<app id>. The rest of the
  # Flatpak is zypak, which only works inside a Flatpak sandbox, and copies of
  # libraries the dependencies above provide.
  install -d "${pkgdir}/opt/notion-desktop"
  cp -a "files/lib/${_appid}/." "${pkgdir}/opt/notion-desktop/"

  # A Flatpak cannot ship setuid files, and Arch ships Electron's sandbox
  # helper setuid so the sandbox stays up on kernels that deny unprivileged
  # user namespaces.
  chmod 4755 "${pkgdir}/opt/notion-desktop/chrome-sandbox"

  # The PipeWire binding was linked with a RUNPATH into its builder's home and
  # Nix store, which on a machine that has Nix would load Nix's glibc into the
  # app. Resolve it against the system libraries instead.
  patchelf --remove-rpath \
    "${pkgdir}/opt/notion-desktop/resources/app.asar.unpacked/node_modules/node-pipewire/dist/binding/napi-v6/index.node"

  install -Dm755 "${srcdir}/notion-desktop-launcher.sh" "${pkgdir}/usr/bin/notion-desktop"

  install -Dm644 "export/share/applications/${_appid}.desktop" \
    "${pkgdir}/usr/share/applications/${_appid}.desktop"
  # Outside a Flatpak the window's app id is "notion", not the Flatpak id the
  # entry is named by, so the entry claims it to keep the window's icon.
  sed -i -e 's|^Exec=.*|Exec=notion-desktop %U|' \
    -e '/^\[Desktop Entry\]/a StartupWMClass=notion' \
    "${pkgdir}/usr/share/applications/${_appid}.desktop"

  local icon size
  for icon in export/share/icons/hicolor/*/apps/"${_appid}".png; do
    size="${icon#export/share/icons/hicolor/}"
    size="${size%%/*}"
    install -Dm644 "${icon}" "${pkgdir}/usr/share/icons/hicolor/${size}/apps/${_appid}.png"
  done
}
