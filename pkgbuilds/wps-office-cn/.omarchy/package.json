{
  "source": "local",
  "release_ring": "fast",
  "upstream": {
    "watch": {
      "regex": "https://linux.wps.cn/",
      "pattern": "https://wps-linux-personal\\.wpscdn\\.cn/wps/download/ep/(?P<series>Linux[0-9]+)/(?P<build>[0-9]+)/wps-office_(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+\\.(?P=build))\\.AK\\.preread\\.sw\\.Personal_(?P<channel>[0-9]+)_amd64\\.deb",
      "variables": {
        "_series": "{series}",
        "_channel": "{channel}"
      }
    }
  }
}
