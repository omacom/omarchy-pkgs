# Maintainer: Omarchy <https://omarchy.org>

# WPS Office for Linux, the China edition from linux.wps.cn, with its Chinese
# interface. The international edition from wps.com is a different build and
# would be a separate package. Kingsoft publishes the personal edition for
# x86_64 only; its ARM builds belong to the separately licensed WPS 365.

pkgname=wps-office-cn
pkgver=12.1.2.29183
pkgrel=1
_series=Linux2023
_channel=806791
pkgdesc='Kingsoft WPS Office, China edition: writer, spreadsheets, presentations and PDF'
arch=('x86_64')
url='https://linux.wps.cn'
license=('LicenseRef-WPS-EULA')
depends=(
  'bzip2'
  'expat'
  'fontconfig'
  'freetype2'
  'gcc-libs'
  'glib2'
  'glibc'
  'glu'
  'hicolor-icon-theme'
  'libcups'
  'libglvnd'
  'libice'
  'libpng'
  'libsm'
  'libx11'
  'libxcb'
  'libxext'
  'libxkbcommon'
  'libxkbcommon-x11'
  'libxrender'
  'xdg-utils'
  'zlib'
)
optdepends=(
  'cups: printing'
  'libpulse: audio and video in presentations'
)
provides=('wps-office')
conflicts=('wps-office' 'kingsoft-office')
options=('!strip' '!debug' '!emptydirs')

# The CDN refuses a download that is not signed with the key linux.wps.cn's
# own download button uses. The expiry is the UTC midnight after next, so every
# read of the recipe within a day names the same URL, valid for at least a day.
_wps_url() {
  local path="/wps/download/ep/${_series}/${pkgver##*.}/wps-office_${pkgver}.AK.preread.sw.Personal_${_channel}_amd64.deb"
  local expiry=$(( ($(date -u +%s) / 86400 + 2) * 86400 ))
  local key
  key=$(printf '%s' "7f8faaaa468174dc1c9cd62e5f218a5b${path}${expiry}" | md5sum)
  printf 'https://wps-linux-personal.wpscdn.cn%s?t=%s&k=%s' "$path" "$expiry" "${key%% *}"
}

source_x86_64=("wps-office_${pkgver}_amd64.deb::$(_wps_url)")
noextract=("wps-office_${pkgver}_amd64.deb")
sha256sums_x86_64=('77ffbdc1be76c834e1853c27ff9063e49d5d3b1f30b206d785761b5bf560c83b')

prepare() {
  rm -rf wps
  mkdir wps
  # Several file names are Chinese; under the build's C locale bsdtar skips them.
  bsdtar -O -xf "wps-office_${pkgver}_amd64.deb" 'data.tar.*' | LC_ALL=C.UTF-8 bsdtar -C wps -xf -
}

package() {
  local opt="$pkgdir/opt/kingsoft/wps-office"
  local office="$opt/office6"

  install -d "$opt"
  cp -a --no-preserve=ownership wps/opt/kingsoft/wps-office/{office6,templates} "$opt/"

  # The bundled GCC 13 libstdc++ would shadow Arch's for every system C++
  # library WPS loads (Mesa, ICU, input methods); Arch's is backward compatible.
  rm -f "$office"/libstdc++.so*

  install -Dm755 -t "$pkgdir/usr/bin" wps/usr/bin/{wps,wpp,et,wpspdf,misc}
  # Kingsoft's Qt 5.12 ships only an X11 platform plugin and crashes at startup
  # under the session's QT_QPA_PLATFORM="wayland;xcb"; it runs under xcb.
  sed -i '1a export QT_QPA_PLATFORM=xcb' "$pkgdir"/usr/bin/{wps,wpp,et,wpspdf,misc}
  install -Dm644 -t "$pkgdir/usr/share/applications" wps/usr/share/applications/*.desktop
  # A handler ranking only KDE reads; Omarchy's own defaults decide.
  sed -i '/^InitialPreference=/d' "$pkgdir"/usr/share/applications/*.desktop
  cp -a --no-preserve=ownership wps/usr/share/icons "$pkgdir/usr/share/"
  install -Dm644 -t "$pkgdir/usr/share/templates" wps/usr/share/templates/*.desktop
  install -Dm644 -t "$pkgdir/usr/share/desktop-directories" wps/usr/share/desktop-directories/wps-office.directory
  install -Dm644 -t "$pkgdir/etc/xdg/menus/applications-merged" wps/etc/xdg/menus/applications-merged/wps-office.menu

  # Kingsoft's font substitutions apply only to the wps, wpp and et processes,
  # so they leave Omarchy's fontconfig alone for every other application.
  install -Dm644 -t "$pkgdir/usr/share/fontconfig/conf.avail" wps/etc/fonts/conf.avail/40-wps-office.conf
  install -d "$pkgdir/usr/share/fontconfig/conf.default"
  ln -s ../conf.avail/40-wps-office.conf "$pkgdir/usr/share/fontconfig/conf.default/40-wps-office.conf"

  # Not installed from the .deb, deliberately:
  # - usr/share/fonts/wps-office: fonts the EULA lets users use only inside WPS
  #   (two are Hanyi's), which a system font directory offers to every app.
  # - usr/share/mime/packages/custom-wps-office.xml: it claims *.docx, *.xlsx,
  #   *.pptx and the other Office globs for WPS's own MIME types, which takes
  #   those files away from the defaults Omarchy sets.
  # - the maintainer scripts: they write mimeapps.list defaults for every
  #   user, create world-writable directories under /opt and install an
  #   updater, none of which a package should do.

  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    wps/opt/kingsoft/wps-office/office6/mui/default/{EULA_linux,Privacy_Linux}.html \
    wps/opt/kingsoft/wps-office/office6/thirdpartylegalnotices.txt
}
