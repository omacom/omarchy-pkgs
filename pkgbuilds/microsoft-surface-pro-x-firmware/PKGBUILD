provides=('qcom-firmware-sc8180x-microsoft-cambria' 'qcom-firmware-sc8180x-microsoft-carina' 'qcom-firmware-sc8180x-microsoft-caspar')
makedepends=('7zip' 'wudrivers')
options=('!strip' '!debug')
