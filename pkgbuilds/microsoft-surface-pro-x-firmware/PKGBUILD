# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'microsoft-surface-pro-x-1876-wu-200.0.61.0-surfaceprox-subextscss.cab' 'microsoft-surface-pro-x-1876-wu-200.0.61.0-surfaceprox-subextscss' 7z
  _unpack 'microsoft-surface-pro-x-1876-wu-200.0.61.0-surfaceprox-subextcdsp.cab' 'microsoft-surface-pro-x-1876-wu-200.0.61.0-surfaceprox-subextcdsp' 7z
  _unpack 'microsoft-surface-pro-x-1876-wu-200.0.61.0-surfaceprox-subextadsp.cab' 'microsoft-surface-pro-x-1876-wu-200.0.61.0-surfaceprox-subextadsp' 7z
  _unpack 'microsoft-surface-pro-x-2010-wu-200.0.33.0-surfaceprox-subextmpss.cab' 'microsoft-surface-pro-x-2010-wu-200.0.33.0-surfaceprox-subextmpss' 7z
  _unpack 'microsoft-surface-pro-x-1876-wu-200.0.61.0-qcdx8180.cab' 'microsoft-surface-pro-x-1876-wu-200.0.61.0-qcdx8180' 7z
  _unpack 'microsoft-surface-pro-x-2010-wu-200.0.33.0-qcdx8180.cab' 'microsoft-surface-pro-x-2010-wu-200.0.33.0-qcdx8180' 7z
}

