post_install() {
  echo "Omascan is installed. Run 'omascan' or open it from the app launcher."
  echo "On Omarchy, run 'omascan menu add' (as your user) to add it to the Omarchy menu."
}

post_upgrade() {
  :
}

pre_remove() {
  echo "If you added Omascan to the Omarchy menu, run 'omascan menu remove' first to take it out."
}
