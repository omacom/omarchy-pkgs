# Maintainer: Matt Wolfgang <mattwolfgang at gmail dot com>
pkgname=omascan
pkgver=0.4.0
pkgrel=1
pkgdesc="Terminal UI for scanning with the Ricoh/Fujitsu fi-8170 (USB or network), no vendor driver needed"
arch=('any')
url="https://github.com/mattwolfgang/omascan"
license=('MIT')
depends=('python' 'python-requests' 'python-pillow' 'python-numpy' 'python-opencv' 'python-textual'
         'python-sane' 'sane')
install=omascan.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('d521159b0e6095cec87406433f2d6a9e36191ed96733fdede757d39c5622b8c7')

package() {
  cd "$pkgname-$pkgver"

  local app="$pkgdir/usr/share/$pkgname"
  install -Dm644 -t "$app" *.py VERSION
  install -Dm644 -t "$app/scripts" scripts/omarchy_menu_entry.py
  install -Dm644 -t "$app/assets" assets/omascan.svg assets/omascan.png
  python -m compileall -q -d "/usr/share/$pkgname" "$app"

  install -Dm755 packaging/omascan "$pkgdir/usr/bin/omascan"
  install -Dm755 packaging/omascan-launch "$pkgdir/usr/bin/omascan-launch"
  install -Dm644 packaging/omascan.desktop "$pkgdir/usr/share/applications/omascan.desktop"
  install -Dm644 assets/omascan.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omascan.svg"

  # The fi-8170 uses a vendor-specific USB class that SANE's default udev
  # rule doesn't cover. The rule hands the device to the omascan group, which
  # sysusers creates before pacman's udev-reload hook runs. It is installed as
  # 60-, after 50-udev-default.rules, which would otherwise reset the mode to
  # 0664 and let every local user read the scanner.
  install -Dm644 packaging/50-omascan-ricoh.rules "$pkgdir/usr/lib/udev/rules.d/60-omascan-ricoh.rules"
  echo 'g omascan - -' | install -Dm644 /dev/stdin "$pkgdir/usr/lib/sysusers.d/$pkgname.conf"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
