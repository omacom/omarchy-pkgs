# Maintainer: Matt Wolfgang <mattwolfgang at gmail dot com>
pkgname=omascan
pkgver=0.3.1
pkgrel=1
pkgdesc="Terminal UI for scanning with the Ricoh/Fujitsu fi-8170 over the network, no vendor driver needed"
arch=('any')
url="https://github.com/mattwolfgang/omascan"
license=('MIT')
depends=('python' 'python-requests' 'python-pillow' 'python-numpy' 'python-opencv' 'python-textual')
install=omascan.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('430ae507d01b0d451548b4d6e7657d8f77cc5ce9faf8b55f7fd439ce3e668f27')

package() {
  cd "$pkgname-$pkgver"

  local app="$pkgdir/usr/share/$pkgname"
  install -Dm644 -t "$app" *.py VERSION
  install -Dm644 -t "$app/scripts" scripts/omarchy_menu_entry.py
  install -Dm644 -t "$app/assets" assets/omascan.svg assets/omascan.png
  python -m compileall -q -d "/usr/share/$pkgname" "$app"

  install -Dm755 packaging/omascan "$pkgdir/usr/bin/omascan"
  install -Dm755 packaging/omascan-launch "$pkgdir/usr/bin/omascan-launch"
  install -Dm644 packaging/omascan.desktop "$pkgdir/usr/share/applications/omascan.desktop"
  install -Dm644 assets/omascan.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omascan.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
