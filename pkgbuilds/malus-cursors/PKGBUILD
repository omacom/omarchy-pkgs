# Maintainer: powderluv <powderluv@powderluv.org>

# Malus is the apple genus. The cursors are ful1e5's apple_cursor, GPL-3.0,
# renamed so the theme carries no trademark, and extended with a hyprcursor
# variant generated from the XCursor files so Hyprland can keep hyprcursor
# enabled (`hyprctl setcursor Malus 24` works as-is).
pkgname=malus-cursors
pkgver=2.0.1
pkgrel=1
pkgdesc="Apple-style cursor theme in XCursor and hyprcursor formats, black and white variants"
arch=('any')
url="https://github.com/ful1e5/apple_cursor"
license=('GPL-3.0-only')
makedepends=('hyprcursor' 'xcur2png')
source=("apple_cursor-$pkgver.tar.xz::$url/releases/download/v$pkgver/macOS.tar.xz")
sha256sums=('9c6e5e13b068ce51a9e90a9abd6ce232ec7d25d4ceb05aa8ac76efbb99c76762')

_themes=('Malus' 'Malus-White')

prepare() {
  mv macOS Malus
  mv macOS-White Malus-White

  local theme
  for theme in "${_themes[@]}"; do
    sed -i \
      -e "s/^Name=.*/Name=$theme/" \
      -e "s/^Comment=.*/Comment=$theme (apple_cursor v$pkgver) XCursors/" \
      -e 's/^Inherits=.*/Inherits=hicolor/' \
      "$theme/index.theme"
    sed -i \
      -e "s/^Name=.*/Name=$theme/" \
      -e "s/^Inherits=.*/Inherits=$theme/" \
      "$theme/cursor.theme"
  done
}

build() {
  # hyprcursor-util writes extracted_<name> under --output for --extract and
  # theme_<name> for --create, where <name> is the manifest's name field. The
  # --output directory itself has to exist already.
  local theme
  for theme in "${_themes[@]}"; do
    rm -rf hypr-work hypr-out
    mkdir -p hypr-work hypr-out
    hyprcursor-util --extract "$theme" --output "$srcdir/hypr-work"
    sed -i \
      -e "s/^name = .*/name = $theme/" \
      -e "s/^description = .*/description = $theme cursors (apple_cursor v$pkgver) for hyprcursor/" \
      -e "s/^version = .*/version = $pkgver/" \
      "hypr-work/extracted_$theme/manifest.hl"
    hyprcursor-util --create "hypr-work/extracted_$theme" --output "$srcdir/hypr-out"
    mv "hypr-out/theme_$theme" "$theme.hyprcursor"
  done
}

package() {
  local theme dest
  for theme in "${_themes[@]}"; do
    dest="$pkgdir/usr/share/icons/$theme"
    install -d "$dest"
    cp -r "$theme"/. "$dest/"
    cp -r "$theme.hyprcursor"/. "$dest/"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
