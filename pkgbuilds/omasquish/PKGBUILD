# Maintainer: Austin Larson <austin@larson-llc.com>

pkgname=omasquish
pkgver=0.1.0
pkgrel=1
pkgdesc='Squish: compress and convert videos with ffmpeg, a keyboard-first HandBrake alternative'
arch=('x86_64' 'aarch64')
url='https://github.com/Dielerorn/omasquish'
license=('MIT')
install='omasquish.install'
options=('!debug')
depends=(
  'ffmpeg'
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-multimedia'
  'qt6-svg'
  'qt6-wayland'
  'xdg-desktop-portal'
)
optdepends=('libnotify: a desktop notification when each encode finishes')
makedepends=(
  'gcc'
  'make'
  'qt6-base'
  'qt6-declarative'
  'qt6-multimedia'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f5911a10d5686ad7d4686d102ebd0c6db0048f960feb3d314e70637daaa47d60')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/omasquish "$pkgdir/usr/bin/omasquish"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/omasquish.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omasquish.svg"
  install -Dm644 pkgbuild/omasquish.desktop "$pkgdir/usr/share/applications/omasquish.desktop"
}
