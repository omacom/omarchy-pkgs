# Maintainer: Jan Vandenbos <jan.vandenbos@gmail.com>

pkgname=nell
pkgver=0.3.0
pkgrel=1
pkgdesc='Read EPUB and PDF books, after Apple Books, with the best of Kindle'
arch=('x86_64' 'aarch64')
url='https://github.com/jvandenbos/nell'
license=('MIT')
options=('!debug')
depends=(
  'hicolor-icon-theme'
  # EPUBs are unpacked with bsdtar.
  'libarchive'
  'poppler-qt6'
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'qt6-wayland'
  'xdg-desktop-portal'
)
makedepends=('gcc' 'make' 'pkgconf')
# The suite writes PDFs with QPdfWriter and reads their text back; a builder
# with no fonts produces textless pages and the PDF tests fail.
checkdepends=('ttf-dejavu')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ed414ce0d09618aed46a92968caf9b1cb0d30199026633b99150491c2752393b')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/test
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/nell "$pkgdir/usr/bin/nell"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/nell.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/nell.svg"
  install -Dm644 pkgbuild/nell.desktop "$pkgdir/usr/share/applications/nell.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
