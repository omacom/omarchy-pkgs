# Audio DSP, compute DSP and GPU firmware for the Qualcomm Snapdragon Dev Kit for Windows. The
# firmware only runs if it is signed for this board by Qualcomm, so linux-firmware cannot carry it
# until the OEM submits it. The OEM ships it in its Windows driver download, which this recipe
# unpacks without running. Each file is checked against the SHA-256 it was matched to and
# installed under the name the device tree requests, compressed with xz. The kernel tries a plain
# name, then .zst, then .xz, so once linux-firmware ships the same file, its copy is the one
# loaded, and the two packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=qualcomm-snapdragon-dev-kit-firmware
pkgver=20261108
pkgrel=1
pkgdesc='Audio DSP, compute DSP and GPU firmware for the Qualcomm Snapdragon Dev Kit for Windows'
arch=('aarch64')
url='https://github.com/WOA-Project/Qualcomm-Reference-Drivers/tree/ff8328f7939081387766c6a9a10b5d44fc7db309/8380_RUN/200.0.4.0'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1e80100-thundercomm-devkit')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'qualcomm-devkit-wu-200.0.4.0-adsp.cab::https://raw.githubusercontent.com/WOA-Project/Qualcomm-Reference-Drivers/ff8328f7939081387766c6a9a10b5d44fc7db309/8380_RUN/200.0.4.0/qcsubsys_ext_adsp8380.cab'
  'qualcomm-devkit-wu-200.0.4.0-cdsp.cab::https://raw.githubusercontent.com/WOA-Project/Qualcomm-Reference-Drivers/ff8328f7939081387766c6a9a10b5d44fc7db309/8380_RUN/200.0.4.0/qcsubsys_ext_cdsp8380.cab'
  'qualcomm-devkit-wu-200.0.4.0-graphics.cab::https://raw.githubusercontent.com/WOA-Project/Qualcomm-Reference-Drivers/ff8328f7939081387766c6a9a10b5d44fc7db309/8380_RUN/200.0.4.0/qcdx8380.cab'
)
noextract=('qualcomm-devkit-wu-200.0.4.0-adsp.cab' 'qualcomm-devkit-wu-200.0.4.0-cdsp.cab' 'qualcomm-devkit-wu-200.0.4.0-graphics.cab')
sha256sums=('fb7bea878c0eeeb6c858f8af39fd10be296292e5eeea3b4bb13606c89fa9bb42' '88adb69f077e009cd16f4769d83ec036d8e26630e55fe1e572b78d846ea3df2e' 'acce08c4adf857e5be786f94cc81fd962be7e2501f3b9193e1d3732609eaf958')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'qualcomm-devkit-wu-200.0.4.0-adsp.cab' 'qualcomm-devkit-wu-200.0.4.0-adsp' 7z
  _unpack 'qualcomm-devkit-wu-200.0.4.0-cdsp.cab' 'qualcomm-devkit-wu-200.0.4.0-cdsp' 7z
  _unpack 'qualcomm-devkit-wu-200.0.4.0-graphics.cab' 'qualcomm-devkit-wu-200.0.4.0-graphics' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'qualcomm-devkit-wu-200.0.4.0-adsp/adsp_dtbs.elf' "$fw"/'qcom/x1e80100/Thundercomm/DEVKIT/adsp_dtbs.elf'
  install -Dm644 'qualcomm-devkit-wu-200.0.4.0-adsp/adspr.jsn' "$fw"/'qcom/x1e80100/Thundercomm/DEVKIT/adspr.jsn'
  install -Dm644 'qualcomm-devkit-wu-200.0.4.0-adsp/adsps.jsn' "$fw"/'qcom/x1e80100/Thundercomm/DEVKIT/adsps.jsn'
  install -Dm644 'qualcomm-devkit-wu-200.0.4.0-adsp/adspua.jsn' "$fw"/'qcom/x1e80100/Thundercomm/DEVKIT/adspua.jsn'
  install -Dm644 'qualcomm-devkit-wu-200.0.4.0-adsp/battmgr.jsn' "$fw"/'qcom/x1e80100/Thundercomm/DEVKIT/battmgr.jsn'
  install -Dm644 'qualcomm-devkit-wu-200.0.4.0-cdsp/cdsp_dtbs.elf' "$fw"/'qcom/x1e80100/Thundercomm/DEVKIT/cdsp_dtbs.elf'
  install -Dm644 'qualcomm-devkit-wu-200.0.4.0-cdsp/cdspr.jsn' "$fw"/'qcom/x1e80100/Thundercomm/DEVKIT/cdspr.jsn'
  install -Dm644 'qualcomm-devkit-wu-200.0.4.0-adsp/qcadsp8380.mbn' "$fw"/'qcom/x1e80100/Thundercomm/DEVKIT/qcadsp8380.mbn'
  install -Dm644 'qualcomm-devkit-wu-200.0.4.0-cdsp/qccdsp8380.mbn' "$fw"/'qcom/x1e80100/Thundercomm/DEVKIT/qccdsp8380.mbn'
  install -Dm644 'qualcomm-devkit-wu-200.0.4.0-graphics/qcdxkmsuc8380.mbn' "$fw"/'qcom/x1e80100/Thundercomm/DEVKIT/qcdxkmsuc8380.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
0e7411b56d45cbdcafce51019bc5c4c2fbec52663c5fbcd97280d141a7cf5cf5  qcom/x1e80100/Thundercomm/DEVKIT/adsp_dtbs.elf
e9ba7199626b0c03f2ec02822d744f678ad567fe0625a28fe5f5908b7281e9db  qcom/x1e80100/Thundercomm/DEVKIT/adspr.jsn
19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e  qcom/x1e80100/Thundercomm/DEVKIT/adsps.jsn
d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d  qcom/x1e80100/Thundercomm/DEVKIT/adspua.jsn
b8aad1d149128f414eb1fd6fcbb6e0a5b7dabcd2cba001599e1ce9a0e2e291a4  qcom/x1e80100/Thundercomm/DEVKIT/battmgr.jsn
12e589de9aeea2ae2b2b7f4295b755d7e0a673755236242936a7853a92ddbfed  qcom/x1e80100/Thundercomm/DEVKIT/cdsp_dtbs.elf
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x1e80100/Thundercomm/DEVKIT/cdspr.jsn
1453ca606d5cf25201bea30abe540e5026da974309f8ba3c3e87baf7cbd77bb9  qcom/x1e80100/Thundercomm/DEVKIT/qcadsp8380.mbn
b2f78dfe2983cb8333a07d33bea5bd3d2290dce3c7da5057ca067a23809e5535  qcom/x1e80100/Thundercomm/DEVKIT/qccdsp8380.mbn
ab17276c807c7cd4b187f4c0ec8de99ad3327dfa293622ea38f3e34df8ae3795  qcom/x1e80100/Thundercomm/DEVKIT/qcdxkmsuc8380.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +
}
