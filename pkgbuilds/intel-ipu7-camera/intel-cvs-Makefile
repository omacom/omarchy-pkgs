# Out-of-tree build of the in-tree Linux 7.2 Intel CVS driver
# (drivers/media/i2c/cvs). Sources are kernel files plus the upstream
# wake-IRQ fix carried by the PKGBUILD.
KERNELRELEASE ?= $(shell uname -r)
KERNEL_SRC ?= /lib/modules/$(KERNELRELEASE)/build

obj-m := intel_cvs.o
intel_cvs-y := core.o v4l2.o

all:
	$(MAKE) -C $(KERNEL_SRC) M=$(CURDIR) modules

clean:
	$(MAKE) -C $(KERNEL_SRC) M=$(CURDIR) clean
