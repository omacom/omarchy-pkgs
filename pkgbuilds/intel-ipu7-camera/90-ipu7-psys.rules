# The PSYS node is opened by v4l2-relayd@ipu7.service, a system unit that runs
# as root. Applications consume the camera through the v4l2loopback device
# instead, which is why 71-ipu7-hide-isys.rules hides the raw ISYS nodes from
# everyone. So leave this node at its default 0600 root:root rather than
# granting every uid on the machine access to the IPU's processing-system
# ioctls.
KERNEL=="ipu7-psys0", SYMLINK+="ipu-psys0"
