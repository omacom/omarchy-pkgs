Support the native CVS bridge without changing legacy sensor configuration.

Backport the MediaControl changes from Intel commit
f167239b3ecf242ae081767892cb0a4c54bad496 (mediactl: support Intel CVS).
The existing negotiated-format propagation must also include the native
MEDIA_ENT_F_VID_IF_BRIDGE entity and report format failures.

diff --git a/src/v4l2/MediaControl.cpp b/src/v4l2/MediaControl.cpp
index c81b19e..253c913 100644
--- a/src/v4l2/MediaControl.cpp
+++ b/src/v4l2/MediaControl.cpp
@@ -63,6 +63,7 @@ struct MediaEntity {
     char devname[32];
 };
 
+static const string icvsName = "Intel CVS";
 MediaControl* MediaControl::sInstance = nullptr;
 Mutex MediaControl::sLock;
 
@@ -763,7 +764,8 @@ int MediaControl::setFormat(int cameraId, const McFormat* format, int targetWidt
             }
 
             if ((link->source == pad) &&
-                (link->sink->entity->info.type == MEDIA_ENT_T_V4L2_SUBDEV)) {
+                (link->sink->entity->info.type == MEDIA_ENT_T_V4L2_SUBDEV ||
+                 link->sink->entity->info.type == MEDIA_ENT_F_VID_IF_BRIDGE)) {
                 auto subDev = V4l2DeviceFactory::getSubDev(cameraId, link->sink->entity->devname);
 
                 struct v4l2_subdev_format tmt = {};
@@ -773,7 +775,9 @@ int MediaControl::setFormat(int cameraId, const McFormat* format, int targetWidt
                 tmt.stream = format->stream;
                 // VIRTUAL_CHANNEL_E
                 tmt.which = V4L2_SUBDEV_FORMAT_ACTIVE;
-                subDev->SetFormat(tmt);
+                ret = subDev->SetFormat(tmt);
+                CheckAndLogError(ret < 0, BAD_VALUE, "set remote format %s failed",
+                                 link->sink->entity->info.name);
             }
         }
     }
@@ -939,12 +943,40 @@ int MediaControl::mediaCtlSetup(int cameraId, MediaCtlConf* mc, int width, int h
     /* Set format & selection in format Configuration */
     for (auto& fmt : mc->formats) {
         if (fmt.formatType == FC_FORMAT) {
-            (void)setFormat(cameraId, &fmt, width, height, field);
+            ret = setFormat(cameraId, &fmt, width, height, field);
+            CheckAndLogError(ret != OK, ret, "set MediaCtlConf format failed: ret = %d", ret);
         } else if (fmt.formatType == FC_SELECTION) {
             (void)setSelection(cameraId, &fmt, width, height);
         }
     }
 
+    MediaEntity* icvs = getEntityByName(icvsName.c_str());
+    if (icvs) {
+        for (uint32_t i = 0; i < icvs->numLinks; ++i) {
+            if (icvs->links[i].sink->entity == icvs) {
+                MediaEntity* sensor = icvs->links[i].source->entity;
+                int sensor_entity_id = sensor->info.id;
+                LOG1("@%s, found %s -> %s", __func__, sensor->info.name, icvsName.c_str());
+                for (McLink& link : mc->links) {
+                    if (link.srcEntity == sensor_entity_id && link.sinkEntity != static_cast<int>(icvs->info.id)) {
+                        LOG1("@%s, skip %s, link %s -> %s", __func__, link.srcEntityName.c_str(),
+                             icvsName.c_str(), link.sinkEntityName.c_str());
+                        link.srcEntity = icvs->info.id;
+                        link.srcEntityName = icvsName;
+                        for (uint32_t j = 0; j < icvs->info.pads; ++j) {
+                            if (icvs->pads[j].flags & MEDIA_PAD_FL_SOURCE) {
+                                link.srcPad = j;
+                                break;
+                            }
+                        }
+                        break;
+                    }
+                }
+                break;
+            }
+        }
+    }
+
     /* Set link in format Configuration */
     ret = setMediaMcLink(mc->links);
     CheckAndLogError(ret != OK, ret, "set MediaCtlConf McLink failed: ret = %d", ret);
