_add_pipewire_camera() {
    local conf="$1"
    local user="${2:-$(_target_user)}"
    [ -n "$user" ] && id -u "$user" >/dev/null 2>&1 || return 0
    /usr/bin/runuser --user "$user" -- /bin/sh -c '
        conf="$1"
        [ -f "$conf" ] && [ ! -L "$conf" ] || exit 0
        if grep -Eq "^[[:space:]]*([^#[:space:]].*[[:space:]])?--enable-features=\"?([^[:space:]\"]*,)?WebRtcPipeWireCamera(,|\"?([[:space:]]|$))" "$conf"; then
            exit 0
        fi
        if grep -Eq "^[[:space:]]*([^#[:space:]].*[[:space:]])?--enable-features=" "$conf"; then
            sed -i -E "
                /^[[:space:]]*#/b
                /(^|[[:space:]])--enable-features=/ {
                    s/((^|[[:space:]])--enable-features=\"[^[:space:]\"]+)\"/\1,WebRtcPipeWireCamera\"/
                    t done
                    s/((^|[[:space:]])--enable-features=\"\")/\2--enable-features=\"WebRtcPipeWireCamera\"/
                    t done
                    s/((^|[[:space:]])--enable-features=[^[:space:]\"]+)/\1,WebRtcPipeWireCamera/
                    t done
                    s/((^|[[:space:]])--enable-features=)([[:space:]]|$)/\1WebRtcPipeWireCamera\3/
                    :done
                    n
                    :rest
                    n
                    b rest
                }
            " "$conf"
        else
            if [ -s "$conf" ] && [ -n "$(tail -c 1 "$conf")" ]; then
                printf "\n" >> "$conf"
            fi
            printf "%s\n" "--enable-features=WebRtcPipeWireCamera" >> "$conf"
        fi
    ' sh "$conf" 2>/dev/null || true
}

_remove_pipewire_camera() {
    local conf="$1"
    local user="${2:-$(_target_user)}"
    [ -n "$user" ] && id -u "$user" >/dev/null 2>&1 || return 0
    /usr/bin/runuser --user "$user" -- /bin/sh -c '
        conf="$1"
        [ -f "$conf" ] && [ ! -L "$conf" ] || exit 0
        sed -i -E "
            /^[[:space:]]*#/b
            /(^|[[:space:]])--enable-features=/ {
                :loop
                s/((^|[[:space:]])--enable-features=\"?([^[:space:]\"]*,)?)(WebRtcPipeWireCamera|PipeWireCamera),/\1/g
                s/((^|[[:space:]])--enable-features=\"?[^[:space:]\"]*),(WebRtcPipeWireCamera|PipeWireCamera)(\"?([[:space:]]|$))/\1\4/g
                t loop
                :sole
                s/(^|[[:space:]])--enable-features=(\"(WebRtcPipeWireCamera|PipeWireCamera)\"|(WebRtcPipeWireCamera|PipeWireCamera))[[:space:]]+/\1/g
                s/[[:space:]]+--enable-features=(\"(WebRtcPipeWireCamera|PipeWireCamera)\"|(WebRtcPipeWireCamera|PipeWireCamera))([[:space:]]|$)/\4/g
                s/^[[:space:]]*--enable-features=(\"(WebRtcPipeWireCamera|PipeWireCamera)\"|(WebRtcPipeWireCamera|PipeWireCamera))[[:space:]]*$//
                t clean
                b
                :clean
                s/(^|[[:space:]])--enable-features=(\"(WebRtcPipeWireCamera|PipeWireCamera)\"|(WebRtcPipeWireCamera|PipeWireCamera))[[:space:]]+/\1/g
                s/[[:space:]]+--enable-features=(\"(WebRtcPipeWireCamera|PipeWireCamera)\"|(WebRtcPipeWireCamera|PipeWireCamera))([[:space:]]|$)/\4/g
                s/^[[:space:]]*--enable-features=(\"(WebRtcPipeWireCamera|PipeWireCamera)\"|(WebRtcPipeWireCamera|PipeWireCamera))[[:space:]]*$//
                t clean
                /^[[:space:]]*$/d
            }
        " "$conf"
    ' sh "$conf" 2>/dev/null || true
}

_install_sleep_hook() {
    cp /usr/share/intel-ipu7-camera/camera-sleep-hook /usr/lib/systemd/system-sleep/camera-sleep-hook
    chmod 755 /usr/lib/systemd/system-sleep/camera-sleep-hook
}

_in_chroot() {
    command -v systemd-detect-virt >/dev/null 2>&1 && systemd-detect-virt -r >/dev/null 2>&1
}

_target_user() {
    local candidate="${OMARCHY_INSTALL_USER:-${SUDO_USER:-}}"
    if [ -n "$candidate" ] && [ "$candidate" != "root" ]; then
        printf '%s\n' "$candidate"
    fi
}

_user_home() {
    local home
    home=$(getent passwd "$1" 2>/dev/null | cut -d: -f6)
    if [ -n "$home" ]; then
        printf '%s\n' "$home"
    else
        printf '/home/%s\n' "$1"
    fi
}

_apply_runtime_permissions() {
    if _in_chroot; then
        return 0
    fi

    if ! /usr/bin/systemd-tmpfiles --create /usr/lib/tmpfiles.d/camera.conf; then
        echo ":: WARNING: failed to restrict /run/camera; reboot before using the camera." >&2
    fi

    if [ -S /run/udev/control ]; then
        if ! /usr/bin/udevadm control --reload-rules ||
           ! /usr/bin/udevadm trigger --action=change --sysname-match=ipu7-psys0; then
            echo ":: WARNING: failed to restrict the IPU7 device; reboot before using the camera." >&2
        fi
    fi
}

_warn_if_driver_is_loaded() {
    if [ -d /sys/module/intel_ipu7_psys ]; then
        echo ":: SECURITY: reboot required to activate the updated IPU7 kernel driver." >&2
    fi
}

post_install() {
    local user home
    _install_sleep_hook
    _apply_runtime_permissions
    if ! _in_chroot; then
        systemctl daemon-reload
    fi
    systemctl disable camera-init.service v4l2-relayd@ipu7.service 2>/dev/null || true
    systemctl enable intel-ipu7-camera.service

    user=$(_target_user)
    if [ -n "$user" ]; then
        usermod -aG video "$user" 2>/dev/null || true
        home=$(_user_home "$user")

        _add_pipewire_camera "$home/.config/chromium-flags.conf"
        _add_pipewire_camera "$home/.config/brave-flags.conf"
        _add_pipewire_camera "$home/.config/chrome-flags.conf"
    fi
}

post_upgrade() {
    local user home
    _install_sleep_hook
    _apply_runtime_permissions
    _warn_if_driver_is_loaded
    if ! _in_chroot; then
        systemctl daemon-reload
    fi
    systemctl disable camera-init.service v4l2-relayd@ipu7.service 2>/dev/null || true
    systemctl enable intel-ipu7-camera.service
    # Disable old camera-feed-watch (replaced by v4l2-relayd)
    systemctl --global disable camera-feed-watch.service 2>/dev/null || true

    user=$(_target_user)
    if [ -n "$user" ]; then
        home=$(_user_home "$user")

        _add_pipewire_camera "$home/.config/chromium-flags.conf"
        _add_pipewire_camera "$home/.config/brave-flags.conf"
        _add_pipewire_camera "$home/.config/chrome-flags.conf"
    fi
}

pre_remove() {
    local user home
    systemctl disable v4l2-relayd@ipu7.service 2>/dev/null || true
    if ! _in_chroot; then
        systemctl stop v4l2-relayd@ipu7.service 2>/dev/null || true
    fi
    systemctl disable intel-ipu7-camera.service 2>/dev/null || true
    systemctl --global disable camera-feed-watch.service 2>/dev/null || true
    systemctl disable camera-init.service 2>/dev/null || true
    if ! _in_chroot; then
        systemctl stop camera-init.service 2>/dev/null || true
    fi

    user=$(_target_user)
    if [ -n "$user" ]; then
        home=$(_user_home "$user")

        _remove_pipewire_camera "$home/.config/chromium-flags.conf"
        _remove_pipewire_camera "$home/.config/brave-flags.conf"
        _remove_pipewire_camera "$home/.config/chrome-flags.conf"
    fi
}

post_remove() {
    rm -f /usr/lib/systemd/system-sleep/camera-sleep-hook
    if ! _in_chroot; then
        systemctl daemon-reload
        udevadm control --reload-rules 2>/dev/null || true
    fi
}
