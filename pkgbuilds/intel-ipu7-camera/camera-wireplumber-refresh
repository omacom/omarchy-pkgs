#!/bin/bash
# Give v4l2-relayd time to initialize, then restart active WirePlumber user
# instances so PipeWire re-probes the loopback device with the negotiated format.

set -eu

sleep "${CAMERA_WIREPLUMBER_DELAY:-2}"

# When run as ExecStartPost, skip restarting WirePlumber if v4l2-relayd has
# already exited (e.g., missing v4l2loopback device).
if [[ -n ${MAINPID:-} ]] && ! kill -0 "${MAINPID}" 2>/dev/null; then
  exit 0
fi

managers=$(systemctl list-units 'user@*.service' --state=running --no-legend --plain 2>/dev/null) || exit 0
[[ -n ${managers} ]] || exit 0

while read -r unit _; do
  [[ ${unit} =~ ^user@([0-9]+)\.service$ ]] || continue
  systemctl --user --no-block --machine="${BASH_REMATCH[1]}@.host" try-restart wireplumber.service 2>/dev/null || true
done <<< "${managers}"
