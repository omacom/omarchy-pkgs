#!/bin/bash
# Drop the relay's 180-degree rotation on boards whose sensor is mounted upright.
#
# The packaged pipeline rotates because the sensor is mounted inverted on the
# Panther Lake boards this package was first written for. On Lunar Lake it is
# not: the sensor reports camera_sensor_rotation = 0 and camera_orientation =
# Front, so the rotation turns an already-correct frame upside down. Keyed on
# the bridge ACPI id; anything not positively identified as Lunar Lake keeps
# the packaged pipeline untouched:
#
#   INTC10DE  Lunar Lake     no rotation
#   INTC10E1  Panther Lake   rotate-180, as packaged
#   INTC10CF  Meteor Lake    rotate-180, as packaged
#   INTC10E0  Arrow Lake     rotate-180, as packaged
#
# v4l2-relayd@ipu7.service reads the output through the drop-in this package
# installs: systemd applies every EnvironmentFile after every Environment=, and
# drop-in files after the unit's own, so it wins over /etc/v4l2-relayd.d/ipu7.conf.
# The drop-in marks it optional, so without it the packaged pipeline applies.

set -eu

out=/run/v4l2-relayd-ipu7-videosrc.env
rm -f "${out}"

shopt -s nullglob
lunar_lake=(/sys/bus/acpi/devices/INTC10DE:*)
shopt -u nullglob
((${#lunar_lake[@]} > 0)) || exit 0

# The packaged pipeline without its rotation, so the two cannot drift apart.
src=$(source /etc/v4l2-relayd.d/ipu7.conf && printf '%s' "${VIDEOSRC}")
printf 'VIDEOSRC=%s\n' "${src/ ! videoflip method=rotate-180/}" >"${out}"
