#!/bin/bash
# Fit the relay's configured pipeline to this board's camera.
#
# Sensor: the packaged pipeline asks icamerasrc for ov08x40-uf. Boards with
# another sensor (the ThinkPad X9 Gen 1 has a Sony IMX471) would ask for a
# camera the HAL does not have, and the relay never starts. Use the sensor the
# kernel bound instead: its V4L2 subdev is named "<chip> <bus>-<addr>", and the
# HAL names that camera "<chip>-uf" when it ships /etc/camera/*/sensors/
# <chip>-uf.json for it. Without such a sensor the configured name stays.
#
# Rotation: the packaged pipeline rotates because the sensor is mounted
# inverted on the Panther Lake boards this package was first written for. On
# Lunar Lake boards with the Intel CVS bridge it is not: the sensor reports
# camera_sensor_rotation = 0 and camera_orientation = Front, so the rotation
# turns an already-correct frame upside down. Keyed on the bridge ACPI id;
# anything not positively identified keeps the configured rotation:
#
#   INTC10DE  Lunar Lake     no rotation
#   INTC10E1  Panther Lake   rotate-180, as packaged
#   INTC10CF  Meteor Lake    rotate-180, as packaged
#   INTC10E0  Arrow Lake     rotate-180, as packaged
#
# Runs as v4l2-relayd@ipu7's ExecStartPre, after one that removes the previous
# override, so VIDEOSRC arrives parsed by systemd from the configured files.
# ExecStart re-reads the drop-in's optional EnvironmentFile, so an edited
# /etc/v4l2-relayd.d/ipu7.conf takes effect on the next start.

set -eu

sysfs=${IPU7_SYSFS:-/sys}
camera_config=${IPU7_CAMERA_CONFIG:-/etc/camera}
out=${IPU7_VIDEOSRC_ENV:-/run/v4l2-relayd-ipu7-videosrc.env}
rm -f "${out}"

src=${VIDEOSRC:-}
[[ -n ${src} ]] || exit 0
configured=${src}

bound_sensor() {
  local name_file chip addr config
  for name_file in "${sysfs}"/class/video4linux/v4l-subdev*/name; do
    read -r chip addr _ <"${name_file}" || continue
    [[ ${addr} =~ ^[0-9]+-[0-9a-f]{4}$ ]] || continue
    for config in "${camera_config}"/*/sensors/"${chip}"-uf.json; do
      if [[ -f ${config} ]]; then
        printf '%s-uf\n' "${chip}"
        return
      fi
    done
  done
}

shopt -s nullglob

sensor=$(bound_sensor)
if [[ -n ${sensor} && ${src} =~ device-name=([^[:space:]!]+) ]]; then
  src=${src/"device-name=${BASH_REMATCH[1]}"/"device-name=${sensor}"}
fi

lunar_lake=("${sysfs}"/bus/acpi/devices/INTC10DE:*)
if ((${#lunar_lake[@]} > 0)); then
  src=${src/ ! videoflip method=rotate-180/}
fi

shopt -u nullglob

[[ ${src} != "${configured}" ]] || exit 0

# Quote for systemd's EnvironmentFile parser, which unescapes these in "...".
src=${src//\\/\\\\}
src=${src//\"/\\\"}
src=${src//\$/\\\$}
src=${src//\`/\\\`}
printf 'VIDEOSRC="%s"\n' "${src}" >"${out}"
