#!/bin/bash
# Emit the v4l2-relayd VIDEOSRC line for this board.
#
# The sensor is mounted inverted on the Panther Lake boards this package was
# first written for, so the pipeline rotates the frame 180 degrees. On Lunar
# Lake it is not: the sensor reports camera_sensor_rotation = 0 and
# camera_orientation = Front, so the same rotation turns an already-correct
# frame upside down in every application that opens /dev/video50.
#
# Keyed on the bridge ACPI id, so anything not positively identified as Lunar
# Lake keeps the previous pipeline byte for byte:
#
#   INTC10DE  Lunar Lake     no rotation
#   INTC10E1  Panther Lake   rotate-180, as before
#   INTC10CF  Meteor Lake    rotate-180, as before
#   INTC10E0  Arrow Lake     rotate-180, as before
#
# Read by v4l2-relayd@ipu7.service through the drop-in this package installs.
# systemd applies every EnvironmentFile after every Environment=, and drop-in
# files are read after the unit's own, so this file wins over
# /etc/v4l2-relayd.d/ipu7.conf. The drop-in marks it optional, so a boot where
# this script did not run falls back to the packaged default.

set -eu

out=/run/v4l2-relayd-ipu7-videosrc.env
src='icamerasrc device-name=ov08x40-uf sharpness=80 ev=-1 saturation=10'

shopt -s nullglob
lunar_lake=(/sys/bus/acpi/devices/INTC10DE:*)
shopt -u nullglob

if ((${#lunar_lake[@]} == 0)); then
  src="${src} ! videoflip method=rotate-180"
fi

printf 'VIDEOSRC=%s\n' "${src}" >"${out}"
