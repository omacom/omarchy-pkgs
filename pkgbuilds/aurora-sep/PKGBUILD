# Loader and desktop integration for the Apple SEP (Touch ID) driver in
# linux-aurora. Packaged from the kernel tree's own Arch recipe,
# tools/aurora-sep/packaging/arch/aurora-sep, whose sources are links into
# tools/aurora-sep; they are fetched here from the same paths.
#
# Installing this package is the owner's opt-in. It enables no unit, but its
# fprintd drop-in requires aurora-sep.service, so the first fprintd start on a
# Mac whose kernel has apple_sep loads the driver with xART writes and keybag
# provisioning on, which writes Secure Enclave state that cannot be undone
# (README.md and XART-SAFETY.md in /usr/share/doc/aurora-sep).

pkgname=aurora-sep
# The kernel tree's recipe is version 1, release 12.
pkgver=1.12
pkgrel=1
pkgdesc='Loader and desktop integration for the Apple SEP (Touch ID) driver'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/omacom/linux-aurora/tree/integration/aurora/tools/aurora-sep'
license=('GPL-2.0-only')

# Immutable pin on omacom/linux-aurora (branch integration/aurora), the same
# tree linux-aurora builds from. Bump it with the kernel when these move.
_commit=44d5afc79da79bb3b17a3ee7494cb8d07a1f1aaa
_raw="https://raw.githubusercontent.com/omacom/linux-aurora/$_commit/tools/aurora-sep"

# The fprintd drop-in is written for the unit fprintd ships; check it at build.
makedepends=('fprintd')
source=("load-driver-$_commit::$_raw/load-driver"
        "aurora-sep.service-$_commit::$_raw/aurora-sep.service"
        "fprintd-aurora.conf-$_commit::$_raw/fprintd-aurora.conf"
        "aurora-sep-ready-$_commit::$_raw/aurora-sep-ready"
        "aurora-sep-ready.service-$_commit::$_raw/aurora-sep-ready.service"
        "fprintd-no-timeout.conf.in-$_commit::$_raw/fprintd-no-timeout.conf.in"
        "logind-aurora-sep.conf-$_commit::$_raw/logind-aurora-sep.conf"
        "aurora-sep-greeter-fingerprint-$_commit::$_raw/aurora-sep-greeter-fingerprint"
        "aurora-sep-greeter-fingerprint.service-$_commit::$_raw/aurora-sep-greeter-fingerprint.service"
        "README.md-$_commit::$_raw/README.md"
        "XART-SAFETY.md-$_commit::$_raw/XART-SAFETY.md")
sha256sums=('abea60bb264ced349f7cf671d8d26e1609a81a60ea4c34d66ec6f7f73b847dbb'
            '447f99cc3c7e683134f31b993aa825fadde24e4854954a3035c96e6631d4d4d0'
            'f8d0c4b9385e6716d5ac5dd9941a57459fbc551a8238383bcde36cd929d0523f'
            '40f0d21446a85bab3e3800b31342e94e553af0fcde2c985503147519737e011d'
            'f38421360c2f885bb102bc5076d81006d352d03d12b5fb35b4da8a5132f4ccc0'
            '8d8df0ba2a6861b2edb2110e606906d84ca4848617621ad3cb48493a1522971d'
            '0695bd9ce4c207241db13c3ea07819a032d8213417021378f5015ab9317cde12'
            '5936eb76db666496a8700dade7ac6bcb3785b517958dcea10685690f1822c86f'
            'ffab97b20bfd5f0eb1ab641179a131843349cf16890fff0cf2d893f0b5681b37'
            'dbcf59cecd62c0245cf39c3c8ee41e3088e2890da89288e91d1c53ee3f02cba4'
            '4422988e5e7f2417791957d066c501741e929705724083da76cdf1cb70d7a2fc')

# A unit and the helper it runs ($1, installed as $3), pointed at the
# packaged helper.
_unit() {
  local unit="$pkgdir/usr/lib/systemd/system/$2"

  install -Dm755 "$1-$_commit" "$pkgdir/usr/lib/aurora-sep/$3"
  install -Dm644 "$2-$_commit" "$unit"
  sed -i "s|^\(Exec[A-Za-z]*=\)/usr/local/sbin/$3|\1/usr/lib/aurora-sep/$3|" "$unit"
  if grep -q /usr/local "$unit"; then
    return 1
  fi
}

package() {
  depends=('coreutils' 'fprintd' 'keyutils' 'kmod' 'sh')
  optdepends=('linux-aurora: the apple_sep driver'
              'libfprint-git: the Touch ID reader driver (aarch64 build)'
              'glib2-devel: fingerprint at the GNOME login screen')
  # aurora-touchid (the kernel tree's earlier package) loads the same driver
  # through its own apple-sep.service and fprintd drop-in.
  conflicts=('aurora-touchid')

  _unit load-driver aurora-sep.service aurora-sep-load
  _unit aurora-sep-ready aurora-sep-ready.service aurora-sep-ready
  _unit aurora-sep-greeter-fingerprint aurora-sep-greeter-fingerprint.service \
    aurora-sep-greeter-fingerprint

  install -Dm644 "fprintd-aurora.conf-$_commit" \
    "$pkgdir/usr/lib/systemd/system/fprintd.service.d/aurora-sep.conf"
  grep -qx 'ExecStart=/usr/lib/fprintd' /usr/lib/systemd/system/fprintd.service
  sed 's|@FPRINTD@|/usr/lib/fprintd|' "fprintd-no-timeout.conf.in-$_commit" \
    >"$pkgdir/usr/lib/systemd/system/fprintd.service.d/50-aurora-sep-no-timeout.conf"
  install -Dm644 "logind-aurora-sep.conf-$_commit" \
    "$pkgdir/usr/lib/systemd/logind.conf.d/50-aurora-sep.conf"
  install -Dm644 "README.md-$_commit" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "XART-SAFETY.md-$_commit" "$pkgdir/usr/share/doc/$pkgname/XART-SAFETY.md"
}
