# Monstar for x86_64 and aarch64, repackaged from the prebuilt release tarballs
# that the upstream release workflow builds natively on each architecture.

pkgname=monstar
pkgver=1.1.1
pkgrel=1
pkgdesc='Linux-native Wayland terminal built on Ghostty terminal core'
arch=(x86_64 aarch64)
url='https://github.com/rockorager/monstar'
license=(MIT)
depends=(
  dbus
  fontconfig
  freetype2
  glibc
  harfbuzz
  libxkbcommon
  wayland
)
optdepends=(
  'noto-fonts-emoji: emoji support'
  'noto-fonts-cjk: CJK font support'
  'systemd: launch additional terminal windows as user services'
  'vulkan-icd-loader: GPU rendering with renderer = vulkan'
  'xdg-desktop-portal: open links and files through a desktop portal'
  'xdg-utils: open links when a desktop portal is unavailable'
)
options=(!debug !strip)
_release="$url/releases/download/v$pkgver"
source=("monstar-$pkgver-LICENSE::https://raw.githubusercontent.com/rockorager/monstar/v$pkgver/LICENSE")
sha256sums=('ea426cf1551287bc67be687653cfcc050fc159b9b2471512c7ef77c754ccf908')
source_x86_64=("$_release/monstar-$pkgver-x86_64-linux.tar.gz")
sha256sums_x86_64=('05235ac07dac915155481c81a52eedc0831829e9583835bbd59ee1715f4a914a')
source_aarch64=("$_release/monstar-$pkgver-aarch64-linux.tar.gz")
sha256sums_aarch64=('17c31195bede33f78b75fb70ab79490de1e488477681b51ad58e16d45467999a')

package() {
  cd "monstar-$pkgver-$CARCH-linux"
  install -d "$pkgdir/usr"
  cp -r --no-preserve=ownership bin share "$pkgdir/usr/"
  install -Dm0644 "$srcdir/monstar-$pkgver-LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
