# Monstar for x86_64 and aarch64, built from the upstream release source tarball.
#
# Monstar 1.0.x targets Zig 0.16.x. Use the upstream Zig toolchain at
# package-build time, as the ghostty recipe does, so a newer distribution Zig
# cannot break the build.
#
# Monstar sets TERM=xterm-ghostty for its child. ncurses only ships the
# `ghostty` entry, so the xterm-ghostty entry comes from ghostty-terminfo.

pkgname=monstar
pkgver=1.0.1
pkgrel=1
pkgdesc='Linux-native Wayland terminal built on the Ghostty terminal core'
arch=(x86_64 aarch64)
url='https://github.com/rockorager/monstar'
license=(MIT)
depends=(
  dbus
  fontconfig
  freetype2
  ghostty-terminfo
  glibc
  harfbuzz
  libxkbcommon
  wayland
)
makedepends=(
  ncurses
  'wayland-protocols>=1.49'
)
optdepends=(
  'noto-fonts-emoji: emoji support'
  'noto-fonts-cjk: CJK font support'
  'xdg-desktop-portal: open links and files through a desktop portal'
  'xdg-utils: open links when a desktop portal is unavailable'
)
_zigver=0.16.0
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver-source.tar.gz")
sha256sums=('a82209aaef3534407f29d860e3174974f19b4a7c10286212fdeacdcd1cb9049d')
sha256sums_x86_64=('70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00')
sha256sums_aarch64=('ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17')
source_x86_64=("https://ziglang.org/download/$_zigver/zig-x86_64-linux-$_zigver.tar.xz")
source_aarch64=("https://ziglang.org/download/$_zigver/zig-aarch64-linux-$_zigver.tar.xz")

_zig() {
  PATH="$srcdir/zig-$CARCH-linux-$_zigver:$PATH" \
    ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-global-cache" \
    zig "$@"
}

prepare() {
  cd "$pkgname-$pkgver"
  _zig build --fetch
}

build() {
  cd "$pkgname-$pkgver"
  rm -rf build
  DESTDIR=build _zig build \
    --prefix /usr \
    --build-id=sha1 \
    -Doptimize=ReleaseFast \
    -Dcpu=baseline
}

package() {
  cd "$pkgname-$pkgver"
  cp -a build/. "$pkgdir/"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
