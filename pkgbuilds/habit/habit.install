post_install() {
  echo "==> Enable Habit for your user (run as your user, not root):"
  echo "      habit install"
  echo "==> Then open it with: omarchy-shell shell toggle io.github.dki.habit '{}'"
}

post_upgrade() {
  echo "==> Restart the shell to load the new Habit version: omarchy restart shell"
}

post_remove() {
  echo "==> Remove the leftover plugin link (as your user): omarchy plugin remove io.github.dki.habit"
  echo "==> Activity data is kept in ~/.local/share/omarchy-habit/; delete it manually to erase history."
}
