# VA-API driver for the Qualcomm Iris video decoder and encoder, from Radxa.
# It lets VA-API applications (Chrome and Chromium among them, which have no
# other route to this hardware) use the decoder on the Snapdragon laptops.
#
# It needs Iris kernel patches that mainline does not have yet: without
# decode-order output (V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY on HFI gen2) every
# decode fails at the first picture. linux-omarchy carries them as patches
# 2007 to 2011.
#
# 0001 lets it import NV12 buffers laid out the way Mesa's freedreno does from
# 26.3 (chroma on a page boundary, not a whole number of rows after luma).
# Without it Chromium's encoder cannot take 1920x1080 input. Sent upstream as
# radxa-pkg/qcom-va-driver#12; drop it when _commit includes it.

_commit=0980a1decf26d34c9aa71cd0a4a0d25703a7a17f
pkgname=qcom-va-driver
pkgver=1.1.1.r2.g0980a1d
pkgrel=1
pkgdesc='VA-API driver for the Qualcomm Iris video decoder and encoder'
arch=('aarch64')
url='https://github.com/radxa-pkg/qcom-va-driver'
license=('MIT')
# The plugin links libva's driver ABI; rebuild when it changes. EGL, GLES and
# GBM (mesa, libglvnd) are for copying surfaces on the GPU.
depends=('glibc' 'libgcc' 'libstdc++' 'libva>=2.24' 'libva<3' 'libdrm' 'mesa' 'libglvnd')
makedepends=('meson')
provides=('libva-v4l2')
conflicts=('libva-v4l2')
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_commit.tar.gz"
        '0001-accept-chroma-plane-off-the-row-grid.patch')
sha256sums=('ad1123de8e5af73e5534a5275ded6281fab485768fdd83c10c69eba6ef1c344d'
            '0413ce870babf3f507d8e30fab93c43fbeff22f29887720f0cfcf19c13639384')

prepare() {
  patch -d "$pkgname-$_commit" -Np1 -i "$srcdir/0001-accept-chroma-plane-off-the-row-grid.patch"
}

build() {
  # Video processing on the DSP needs a Hexagon toolchain and GHC to build, and
  # the Vulkan one is untested here, so both stay out; decode and encode do not
  # use them. Plain meson rather than arch-meson, which lives in devtools.
  meson setup \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode=nodownload \
    -Dgpu_copy=enabled \
    -Dcdsp_vpp=disabled \
    -Dvulkan_vpp=disabled \
    -Dv4l2_symlink=false \
    "$pkgname-$_commit" build
  meson compile -C build
}

check() {
  # Two unit tests, built on demand; neither touches the hardware.
  meson test -C build --print-errorlogs
}

package() {
  # Installs qcom_drv_video.so and msm_drv_video.so, a link to it. "msm" is
  # the DRM driver name of the render node on these machines, which is the name
  # libva looks for, so applications find the driver with no environment
  # variable. Mesa ships no VA-API driver under that name.
  meson install -C build --destdir "$pkgdir"
}
