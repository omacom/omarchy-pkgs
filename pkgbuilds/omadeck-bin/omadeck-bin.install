post_install() {
  echo ">> Enable the daemon for your user with:"
  echo ">>   systemctl --user enable --now omadeckd.service"
  echo ">> Then open \"omadeck\" from your launcher to set up your keys."
}

post_upgrade() {
  echo ">> Restart the daemon to pick up the new version:"
  echo ">>   systemctl --user restart omadeckd.service"
}
