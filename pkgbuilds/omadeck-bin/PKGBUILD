# Maintainer: Raymond Brady (github.com/thewizster)

# omadeck publishes prebuilt x86_64 binaries on its GitHub releases, with a
# SHA256SUMS manifest. The upstream watch in .omarchy/package.json rewrites
# pkgver and the checksum below when a new release is tagged.

pkgname=omadeck-bin
_appname=omadeck
pkgver=0.1.0
pkgrel=1
pkgdesc="Elgato Stream Deck for Omarchy: launch apps, run scripts, play sounds and open websites"
arch=('x86_64')
url="https://omadeck.app"
license=('MIT')
depends=('gtk4' 'libadwaita' 'systemd-libs' 'pipewire' 'fontconfig')
optdepends=('uwsm: launch apps in their own systemd scope (Omarchy default)'
            'hyprland: Hyprland dispatcher actions')
provides=("${_appname}=${pkgver}")
conflicts=("${_appname}")
# The release binaries are already stripped.
options=('!debug')
install="${pkgname}.install"
source_x86_64=("${_appname}-${pkgver}-x86_64-linux.tar.gz::https://github.com/thewizster/omadeck/releases/download/v${pkgver}/${_appname}-${pkgver}-x86_64-linux.tar.gz")
sha256sums_x86_64=('c4eff1e6e63c96e90e12cc14e39272595b852ff9cb76fbad2c2d67bacddca1ae')

package() {
  cd "${srcdir}/${_appname}-${pkgver}-x86_64-linux"

  install -Dm755 bin/omadeck "${pkgdir}/usr/bin/omadeck"
  install -Dm755 bin/omadeckd "${pkgdir}/usr/bin/omadeckd"

  install -Dm644 packaging/dev.omadeck.Omadeck.desktop \
    "${pkgdir}/usr/share/applications/dev.omadeck.Omadeck.desktop"
  install -Dm644 assets/dev.omadeck.Omadeck.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/dev.omadeck.Omadeck.svg"

  # The unit ships with a placeholder for the binary directory.
  sed 's|@BINDIR@|/usr/bin|' packaging/omadeckd.service \
    | install -Dm644 /dev/stdin "${pkgdir}/usr/lib/systemd/user/omadeckd.service"

  # Grants the logged-in user access to Stream Deck devices (uaccess).
  install -Dm644 packaging/70-omadeck.rules \
    "${pkgdir}/usr/lib/udev/rules.d/70-omadeck.rules"

  install -Dm644 examples/config.toml \
    "${pkgdir}/usr/share/doc/${_appname}/config.example.toml"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
