# Audio DSP, compute DSP, GPU and video firmware for the HP OmniBook 3 16 (16-ct0). The firmware
# only runs if it is signed for this board by HP, so linux-firmware cannot carry it until the OEM
# submits it. The OEM ships it in its Windows driver download, which this recipe unpacks without
# running. Each file is checked against the SHA-256 it was matched to and installed under the name
# the device tree requests, compressed with xz. The kernel tries a plain name, then .zst, then
# .xz, so once linux-firmware ships the same file, its copy is the one loaded, and the two
# packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=hp-omnibook-3-16-ct0-firmware
pkgver=20261115
pkgrel=1
pkgdesc='Audio DSP, compute DSP, GPU and video firmware for the HP OmniBook 3 16 (16-ct0)'
arch=('aarch64')
url='https://ftp.hp.com/pub/softpaq/sp174501-175000/sp174797.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-sc7280-hp-omnibook-3-16-ct0')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'hp-sp174797.exe::https://ftp.hp.com/pub/softpaq/sp174501-175000/sp174797.exe'
)
source+=('README.package.md')
noextract=('hp-sp174797.exe')
sha256sums=('c0b43804f921d3e74494753fe8891b77bc09fe347f949d25365e50aabc543569')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'hp-sp174797.exe' 'hp-sp174797' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'hp-sp174797/src/Driver/qcsubsys_ext_adsp8270/adspr.jsn' "$fw"/'qcom/sc7280/HP/omnibook-3-16-ct0/adspr.jsn'
  install -Dm644 'hp-sp174797/src/Driver/qcsubsys_ext_adsp8270/adsps.jsn' "$fw"/'qcom/sc7280/HP/omnibook-3-16-ct0/adsps.jsn'
  install -Dm644 'hp-sp174797/src/Driver/qcsubsys_ext_adsp8270/adspua.jsn' "$fw"/'qcom/sc7280/HP/omnibook-3-16-ct0/adspua.jsn'
  install -Dm644 'hp-sp174797/src/Driver/qcsubsys_ext_cdsp8270/cdspr.jsn' "$fw"/'qcom/sc7280/HP/omnibook-3-16-ct0/cdspr.jsn'
  install -Dm644 'hp-sp174797/src/Driver/qcsubsys_ext_adsp8270/qcadsp8270.mbn' "$fw"/'qcom/sc7280/HP/omnibook-3-16-ct0/qcadsp8270.mbn'
  install -Dm644 'hp-sp174797/src/Driver/qcsubsys_ext_cdsp8270/qccdsp8270.mbn' "$fw"/'qcom/sc7280/HP/omnibook-3-16-ct0/qccdsp8270.mbn'
  install -Dm644 'hp-sp174797/src/Driver/qcdx8270/qcdxkmsuc8270.mbn' "$fw"/'qcom/sc7280/HP/omnibook-3-16-ct0/qcdxkmsuc8270.mbn'
  install -Dm644 'hp-sp174797/src/Driver/qcdx8270/qcvss8270.mbn' "$fw"/'qcom/sc7280/HP/omnibook-3-16-ct0/qcvss8270.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
e9ba7199626b0c03f2ec02822d744f678ad567fe0625a28fe5f5908b7281e9db  qcom/sc7280/HP/omnibook-3-16-ct0/adspr.jsn
19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e  qcom/sc7280/HP/omnibook-3-16-ct0/adsps.jsn
d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d  qcom/sc7280/HP/omnibook-3-16-ct0/adspua.jsn
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/sc7280/HP/omnibook-3-16-ct0/cdspr.jsn
0c7dd9beb5d970c7d54532eddbf141fc5acd244ff86808f5abf92355a6fc35c9  qcom/sc7280/HP/omnibook-3-16-ct0/qcadsp8270.mbn
49a64694086e9979605445506e89adfc9203d18e92c610be754e76ec17432fef  qcom/sc7280/HP/omnibook-3-16-ct0/qccdsp8270.mbn
5a87622c1fe32fd024523953dd6f7028eaf0d2295538701d2dad7107cd4372e4  qcom/sc7280/HP/omnibook-3-16-ct0/qcdxkmsuc8270.mbn
f6c80b8f28bc794b75610024d51e90fcb1a6c505a51e32dd01589eb2de6ea8e0  qcom/sc7280/HP/omnibook-3-16-ct0/qcvss8270.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
