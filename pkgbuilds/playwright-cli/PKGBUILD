# Maintainer: The Omarchy Authors
# Microsoft publishes playwright-cli only to npm. It and Playwright are plain
# JavaScript, so one build serves every architecture and it can follow npm on
# the fast ring. It drives the installed Chrome or Chromium rather than a
# browser Playwright downloads.
pkgname=playwright-cli
pkgver=0.1.25
pkgrel=1
pkgdesc="Browser automation CLI for coding agents, from Microsoft's Playwright"
arch=('any')
url="https://github.com/microsoft/playwright-cli"
license=('Apache-2.0')
depends=('nodejs')
makedepends=('npm')
optdepends=('google-chrome: the default browser'
            'chromium: the browser used when Google Chrome is not installed')
source=("playwright-cli-${pkgver}.tgz::https://registry.npmjs.org/@playwright/cli/-/cli-${pkgver}.tgz")
sha256sums=('4559e4674cb5d10a03e0c15e9f5c892dcfa4f5d8703c49146594b4af322480f4')
noextract=("playwright-cli-${pkgver}.tgz")

package() {
  # --ignore-scripts keeps Playwright from downloading browsers.
  npm install --global --ignore-scripts --omit=dev --no-audit --no-fund \
    --cache "${srcdir}/npm-cache" --prefix "${pkgdir}/usr" "${srcdir}/playwright-cli-${pkgver}.tgz"

  local _mod="${pkgdir}/usr/lib/node_modules/@playwright/cli"
  local _core="${_mod}/node_modules/playwright-core"

  # With no browser chosen by --browser, a config file or the environment,
  # Playwright runs Chrome from /opt/google/chrome. Where only Chromium is
  # installed, run that instead of failing on the missing Chrome.
  local _default='browser.launchOptions.channel = "chrome";'
  local _chromium='if (browser.launchOptions.executablePath === void 0 \&\& !require("fs").existsSync("/opt/google/chrome/chrome") \&\& require("fs").existsSync("/usr/bin/chromium")) browser.launchOptions.executablePath = "/usr/bin/chromium"; else '
  if (( $(grep -cF "$_default" "${_core}/lib/coreBundle.js") != 1 )); then
    echo "Expected one default Chrome channel in playwright-core's coreBundle.js" >&2
    return 1
  fi
  sed -i "s|${_default}|${_chromium}${_default}|" "${_core}/lib/coreBundle.js"

  # pacman updates this install, so the daily npm check for a newer release
  # would only point at an `npm install -g` that cannot replace it.
  rm "${pkgdir}/usr/bin/playwright-cli"
  cat >"${pkgdir}/usr/bin/playwright-cli" <<'WRAPPER'
#!/bin/sh
export NO_UPDATE_NOTIFIER=1
exec /usr/lib/node_modules/@playwright/cli/playwright-cli.js "$@"
WRAPPER
  chmod 755 "${pkgdir}/usr/bin/playwright-cli"

  chown -R root:root "${pkgdir}/usr"
  install -Dm644 "${_mod}/LICENSE" "${_core}/NOTICE" "${_core}/ThirdPartyNotices.txt" \
    -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
