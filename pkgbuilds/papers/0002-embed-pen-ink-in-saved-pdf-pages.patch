+void
+create_input (const char *filename, bool encrypted = false)
+{
+	QPDF pdf;
+	pdf.emptyPDF ();
+	auto font = pdf.makeIndirectObject (QPDFObjectHandle::parse (
+	    "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>"));
+	auto fonts = QPDFObjectHandle::newDictionary ();
+	fonts.replaceKey ("/F1", font);
+	auto page = pdf.makeIndirectObject (QPDFObjectHandle::parse (
+	    "<< /Type /Page /MediaBox [0 0 240 200] /CropBox [12 18 230 180] /Rotate 90 /Resources <<>> >>"));
+	page.getKey ("/Resources").replaceKey ("/Font", fonts);
+	// The original page leaves a transform active. The ink must still use page coordinates.
+	page.replaceKey ("/Contents", pdf.newStream (
+					  "0 g 28 28 8 8 re f BT /F1 11 Tf 30 53 Td (Sample form) Tj ET 1 0 0 1 120 40 cm\n"));
+	auto link = pdf.makeIndirectObject (QPDFObjectHandle::parse (
+	    "<< /Type /Annot /Subtype /Link /Rect [140 120 180 140] /A << /S /URI /URI (https://example.org) >> >>"));
+	auto widget = pdf.makeIndirectObject (QPDFObjectHandle::parse (
+	    "<< /Type /Annot /Subtype /Widget /FT /Tx /T (name) /V (Sample) /Rect [173 58 199 78] >>"));
+	widget.replaceKey ("/P", page);
+	auto signature_field = pdf.makeIndirectObject (QPDFObjectHandle::parse (
+	    "<< /Type /Annot /Subtype /Widget /FT /Sig /T (sign-here) /Rect [130 50 200 70] >>"));
+	signature_field.replaceKey ("/P", page);
+
+	auto legacy_ink = pdf.makeIndirectObject (QPDFObjectHandle::parse (
+	    "<< /Type /Annot /Subtype /Ink /Rect [30 67 87 90] "
+	    "/InkList [[36 76 55 86 80 76]] /C [1 0 0] /F 0 /CA 0.5 /Border [0 0 5] >>"));
+	auto hidden_ink = pdf.makeIndirectObject (QPDFObjectHandle::parse (
+	    "<< /Type /Annot /Subtype /Ink /Rect [30 100 87 120] "
+	    "/InkList [[35 105 57 108 80 116]] /C [0 1 0] /F 2 /Border [0 0 5] >>"));
+	auto styled_ink = pdf.makeIndirectObject (QPDFObjectHandle::parse (
+	    "<< /Type /Annot /Subtype /Ink /Rect [150 80 180 100] /InkList [[153 85 177 95]] >>"));
+	auto appearance = pdf.newStream ("1 1 0 RG 4 w 3 5 m 27 15 l S\n");
+	appearance.getDict ().replaceKey ("/Subtype", QPDFObjectHandle::newName ("/Form"));
+	appearance.getDict ().replaceKey ("/BBox", QPDFObjectHandle::parse ("[0 0 30 20]"));
+	auto appearances = QPDFObjectHandle::newDictionary ();
+	appearances.replaceKey ("/N", appearance);
+	styled_ink.replaceKey ("/AP", appearances);
+
+	page.replaceKey ("/Annots", QPDFObjectHandle::newArray ({ link, widget, signature_field, legacy_ink, hidden_ink, styled_ink }));
+	QPDFPageDocumentHelper (pdf).addPage (page, false);
+	auto second_page = pdf.makeIndirectObject (QPDFObjectHandle::parse (
+	    "<< /Type /Page /MediaBox [0 0 160 140] /Resources <<>> >>"));
+	second_page.getKey ("/Resources").replaceKey ("/Font", fonts);
+	second_page.replaceKey ("/Contents", pdf.newStream ("BT /F1 11 Tf 20 110 Td (Page two) Tj ET\n"));
+	QPDFPageDocumentHelper (pdf).addPage (second_page, false);
+	auto form = QPDFObjectHandle::newDictionary ();
+	form.replaceKey ("/Fields", QPDFObjectHandle::newArray ({ widget, signature_field }));
+	form.replaceKey ("/DR", QPDFObjectHandle::parse ("<<>>"));
+	form.getKey ("/DR").replaceKey ("/Font", fonts);
+	form.replaceKey ("/DA", QPDFObjectHandle::newString ("/F1 9 Tf 0 g"));
+	pdf.getRoot ().replaceKey ("/AcroForm", form);
+	QPDFWriter writer (pdf, filename);
+	if (encrypted)
+		writer.setR6EncryptionParameters ("test-password", "test-owner", true, true, true,
+		                                  true, true, true, qpdf_r3p_full, true);
+	writer.write ();
+}
+
+PpsInkList *
+pen_ink (int index)
+{
+	const PpsPoint rotated[] = { { 28.0, 43.0 }, { 83.0, 43.0 }, { 98.0, 58.0 } };
+	const PpsPoint straight[] = { { 30.0, 48.0 }, { 80.0, 48.0 } };
+	PpsPath *path = index == 0 ? pps_path_new_for_array (rotated, G_N_ELEMENTS (rotated))
+	                           : pps_path_new_for_array (straight, G_N_ELEMENTS (straight));
+	const PpsPath *paths[] = { path };
+	PpsInkList *ink = pps_ink_list_new_for_array (paths, G_N_ELEMENTS (paths));
+	pps_path_free (path);
+	return ink;
+}
+
+void
+draw_pen_stroke (PpsDocument *document, int index = 0)
+{
+	g_autoptr (PpsPage) page = pps_document_get_page (document, index);
+	g_autoptr (PpsAnnotation) annot = pps_annotation_ink_new (page);
+	const GdkRGBA color{ index == 0 ? 0.0f : 1.0f, 0, 1, index == 0 ? 1.0f : 0.5f };
+
+	pps_annotation_set_rgba (annot, &color);
+	pps_annotation_set_border_width (annot, index == 0 ? 4.0 : 6.0);
+	pps_annotation_ink_set_ink_list (PPS_ANNOTATION_INK (annot), pen_ink (index));
+	pps_document_annotations_add_annotation (PPS_DOCUMENT_ANNOTATIONS (document), annot);
+}
+
+PpsDocument *
+load_document (const char *uri, const char *password = nullptr)
+{
+	g_autoptr (GError) error = nullptr;
+	PpsDocument *document = pps_document_factory_get_document (uri, &error);
+	g_assert_no_error (error);
+	g_assert_nonnull (document);
+	if (password)
+		pps_document_security_set_password (PPS_DOCUMENT_SECURITY (document), password);
+	g_assert_true (pps_document_load (document, uri, &error));
+	g_assert_no_error (error);
+	return document;
+}
+
+bool
+has_pencil_strokes (PpsDocument *document)
+{
+	gboolean has_strokes = FALSE;
+	g_object_get (document, "has-pencil-strokes", &has_strokes, nullptr);
+	return has_strokes;
+}
+
+bool
+run_save_job (PpsDocument *document, const char *target, const char *original, bool keep_editable, GError **error)
+{
+	g_autoptr (PpsJob) job = pps_job_save_new (document, target, original);
+	g_object_set (job, "keep-editable-ink", keep_editable, nullptr);
+	bool finished = false;
+	g_signal_connect (job, "finished", G_CALLBACK (+[] (PpsJob *, bool *finished) {
+				  *finished = true;
+			  }),
+	                  &finished);
+	pps_job_run (job);
+	while (!finished)
+		g_main_context_iteration (nullptr, TRUE);
+	return pps_job_is_succeeded (job, error);
+}
+
+void
+save_document (PpsDocument *document, const char *target, const char *original, bool editable = false)
+{
+	g_autoptr (GError) error = nullptr;
+	g_assert_true (run_save_job (document, target, original, editable, &error));
+	g_assert_no_error (error);
+	g_assert_false (pps_document_get_modified (document));
+}
+
+cairo_surface_t *
+render_page_content (PopplerPage *page)
+{
+	double width, height;
+	poppler_page_get_size (page, &width, &height);
+	auto surface = cairo_image_surface_create (CAIRO_FORMAT_RGB24, width * 4, height * 4);
+	auto cr = cairo_create (surface);
+	cairo_scale (cr, 4, 4);
+	cairo_set_source_rgb (cr, 1, 1, 1);
+	cairo_paint (cr);
+	G_GNUC_BEGIN_IGNORE_DEPRECATIONS
+	poppler_page_render_for_printing_with_options (page, cr, POPPLER_PRINT_DOCUMENT);
+	G_GNUC_END_IGNORE_DEPRECATIONS
+	cairo_destroy (cr);
+	cairo_surface_flush (surface);
+	return surface;
+}
+
+void
+check_pixel (cairo_surface_t *surface, double x, double y, int red, int green, int blue, int tolerance = 0)
+{
+	auto data = cairo_image_surface_get_data (surface);
+	auto stride = cairo_image_surface_get_stride (surface);
+	auto row = reinterpret_cast<const guint32 *> (data + static_cast<int> (y * 4) * stride);
+	auto pixel = row[static_cast<int> (x * 4)];
+	g_assert_cmpint (ABS (static_cast<int> ((pixel >> 16) & 255) - red), <=, tolerance);
+	g_assert_cmpint (ABS (static_cast<int> ((pixel >> 8) & 255) - green), <=, tolerance);
+	g_assert_cmpint (ABS (static_cast<int> (pixel & 255) - blue), <=, tolerance);
+}
+
+void
+check_page_contents (const char *filename, bool second_stroke = true)
+{
+	QPDF pdf;
+	pdf.processFile (filename);
+	auto pages = QPDFPageDocumentHelper (pdf).getAllPages ();
+	g_assert_cmpuint (pages.size (), ==, 2);
+	auto &page = pages.front ();
+	auto annots = page.getObjectHandle ().getKey ("/Annots");
+	g_assert_cmpint (annots.getArrayNItems (), ==, 6);
+	g_assert_true (annots.getArrayItem (0).getKey ("/Subtype").isNameAndEquals ("/Link"));
+	g_assert_true (annots.getArrayItem (1).getKey ("/Subtype").isNameAndEquals ("/Widget"));
+	g_assert_true (annots.getArrayItem (2).getKey ("/FT").isNameAndEquals ("/Sig"));
+	g_assert_true (annots.getArrayItem (3).getKey ("/Subtype").isNameAndEquals ("/Ink"));
+	g_assert_cmpint (annots.getArrayItem (3).getKey ("/F").getIntValue (), ==, 0);
+	g_assert_cmpint (annots.getArrayItem (4).getKey ("/F").getIntValue (), ==, 2);
+	g_assert_true (annots.getArrayItem (5).getKey ("/AP").getKey ("/N").isStream ());
+	auto fields = pdf.getRoot ().getKey ("/AcroForm").getKey ("/Fields");
+	g_assert_true (fields.getArrayItem (0).getKey ("/V").getStringValue () == "Sample");
+	g_assert_true (fields.getArrayItem (1).getKey ("/FT").isNameAndEquals ("/Sig"));
+	g_assert_true (fields.getArrayItem (1).getKey ("/V").isNull ());
+	g_assert_cmpuint (page.getPageContents ().size (), ==, 3);
+	g_assert_cmpuint (pages.at (1).getPageContents ().size (), ==, second_stroke ? 3 : 1);
+	g_assert_true (pages.at (1).getObjectHandle ().getKey ("/Annots").isNull ());
+
+	g_autoptr (GError) error = nullptr;
+	g_autofree char *uri = g_filename_to_uri (filename, nullptr, &error);
+	g_assert_no_error (error);
+	g_autoptr (PopplerDocument) doc = poppler_document_new_from_file (uri, nullptr, &error);
+	g_assert_no_error (error);
+	g_autoptr (PopplerPage) print_page = poppler_document_get_page (doc, 0);
+	g_autofree char *text = poppler_page_get_text (print_page);
+	g_assert_nonnull (strstr (text, "Sample form"));
+	auto surface = render_page_content (print_page);
+	// Rotated, cropped page. The four-point-wide stroke crosses the text widget at (50, 175).
+	check_pixel (surface, 50, 175, 0, 0, 255);
+	check_pixel (surface, 68, 173.5, 0, 0, 255);
+	check_pixel (surface, 68, 176.5, 0, 0, 255);
+	check_pixel (surface, 68, 172.5, 255, 255, 255);
+	check_pixel (surface, 68, 177.5, 255, 255, 255);
+	check_pixel (surface, 91, 167, 0, 0, 255);
+	check_pixel (surface, 13, 19, 0, 0, 0);
+	check_pixel (surface, 58, 24, 255, 255, 255); // The unprinted red review ink.
+	cairo_surface_destroy (surface);
+
+	GList *form_fields = poppler_page_get_form_field_mapping (print_page);
+	bool found_field = false;
+	for (auto *entry = form_fields; entry; entry = entry->next) {
+		auto *mapping = static_cast<PopplerFormFieldMapping *> (entry->data);
+		if (poppler_form_field_get_field_type (mapping->field) != POPPLER_FORM_FIELD_TEXT)
+			continue;
+		poppler_form_field_text_set_text (mapping->field, "Still editable");
+		g_autofree char *value = poppler_form_field_text_get_text (mapping->field);
+		g_assert_cmpstr (value, ==, "Still editable");
+		found_field = true;
+	}
+	poppler_page_free_form_field_mapping (form_fields);
+	g_assert_true (found_field);
+
+	g_autoptr (PopplerPage) second = poppler_document_get_page (doc, 1);
+	surface = render_page_content (second);
+	if (second_stroke) {
+		// A six-point-wide stroke at 50% opacity. Double painting would turn 127 into 63.
+		check_pixel (surface, 50, 89.5, 255, 127, 255, 2);
+		check_pixel (surface, 50, 94.5, 255, 127, 255, 2);
+	} else {
+		check_pixel (surface, 50, 92, 255, 255, 255);
+	}
+	check_pixel (surface, 50, 88.5, 255, 255, 255);
+	check_pixel (surface, 50, 95.5, 255, 255, 255);
+	cairo_surface_destroy (surface);
+}
+
+void
+check_editable_copy (const char *filename, bool with_pencil, const char *password = nullptr)
+{
+	QPDF pdf;
+	pdf.processFile (filename, password);
+	g_assert_cmpint (pdf.isEncrypted (), ==, password != nullptr);
+	auto page = QPDFPageDocumentHelper (pdf).getAllPages ().front ();
+	auto annots = page.getObjectHandle ().getKey ("/Annots");
+	g_assert_cmpint (annots.getArrayNItems (), ==, with_pencil ? 7 : 6);
+	g_assert_cmpint (annots.getArrayItem (3).getKey ("/F").getIntValue (), ==, 0);
+	g_assert_cmpuint (page.getPageContents ().size (), ==, 1);
+	if (with_pencil) {
+		auto ink = annots.getArrayItem (6);
+		g_assert_true (ink.getKey ("/Subtype").isNameAndEquals ("/Ink"));
+		g_assert_cmpint (ink.getKey ("/F").getIntValue (), ==, an_print);
+		auto contents = ink.getKey ("/Contents");
+		g_assert_true (contents.isNull () || contents.getUTF8Value ().empty ());
+	}
+}
+
+void
+test_ink_save ()
+{
+	g_autoptr (GError) error = nullptr;
+	g_autofree char *directory = g_dir_make_tmp ("papers-ink-save.XXXXXX", &error);
+	g_assert_no_error (error);
+	g_autofree char *input = g_build_filename (directory, "input.pdf", nullptr);
+	g_autofree char *output = g_build_filename (directory, "output.pdf", nullptr);
+	g_autofree char *second_output = g_build_filename (directory, "second-output.pdf", nullptr);
+	g_autofree char *input_uri = g_filename_to_uri (input, nullptr, nullptr);
+	g_autofree char *output_uri = g_filename_to_uri (output, nullptr, nullptr);
+	g_autofree char *second_output_uri = g_filename_to_uri (second_output, nullptr, nullptr);
+
+	create_input (input);
+	g_autoptr (PpsDocument) document = load_document (input_uri);
+	save_document (document, output_uri, input_uri);
+	check_editable_copy (output, false);
+
+	draw_pen_stroke (document);
+	draw_pen_stroke (document, 1);
+	g_assert_true (has_pencil_strokes (document));
+	save_document (document, output_uri, input_uri);
+	check_page_contents (output);
+	// Saving again from the same editing session must keep the strokes in both copies.
+	save_document (document, second_output_uri, input_uri);
+	check_page_contents (second_output);
+
+	// An overwrite save of the reopened PDF must not append another copy of the ink.
+	g_autoptr (PpsDocument) reopened = load_document (output_uri);
+	g_assert_false (has_pencil_strokes (reopened));
+	save_document (reopened, output_uri, output_uri);
+	check_page_contents (output);
+
+	g_unlink (input);
+	g_unlink (output);
+	g_unlink (second_output);
+	g_rmdir (directory);
+}
+
+void
+test_undo_and_editable_ink ()
+{
+	g_autoptr (GError) error = nullptr;
+	g_autofree char *directory = g_dir_make_tmp ("papers-undo-ink.XXXXXX", &error);
+	g_assert_no_error (error);
+	g_autofree char *input = g_build_filename (directory, "input.pdf", nullptr);
+	g_autofree char *output = g_build_filename (directory, "output.pdf", nullptr);
+	g_autofree char *input_uri = g_filename_to_uri (input, nullptr, nullptr);
+	g_autofree char *output_uri = g_filename_to_uri (output, nullptr, nullptr);
+
+	create_input (input);
+	g_autoptr (PpsDocument) document = load_document (input_uri);
+	g_autoptr (PpsAnnotationModel) annotation_model = pps_annotation_model_new ();
+	g_autoptr (PpsDocumentModel) model = PPS_DOCUMENT_MODEL (g_object_new (
+	    PPS_TYPE_DOCUMENT_MODEL, "annotation-model", annotation_model, "document", document, nullptr));
+	g_autoptr (PpsUndoContext) undo_context = pps_undo_context_new (model);
+	g_autoptr (PpsAnnotationsContext) annotations = pps_annotations_context_new (model, undo_context);
+	const GdkRGBA blue{ 0, 0, 1, 1 };
+	PpsAnnotationInkAddData data{ pen_ink (0), nullptr, FALSE, 4 };
+	g_autoptr (PpsAnnotation) ink = pps_annotations_context_add_annotation_sync (
+	    annotations, 0, PPS_ANNOTATION_TYPE_INK, nullptr, nullptr, &blue, &data);
+	pps_ink_list_free (data.ink_list);
+	g_assert_nonnull (ink);
+	g_assert_true (has_pencil_strokes (document));
+
+	pps_undo_context_undo (undo_context);
+	g_assert_false (has_pencil_strokes (document));
+	save_document (document, output_uri, input_uri);
+	check_editable_copy (output, false);
+
+	pps_undo_context_redo (undo_context);
+	g_assert_true (has_pencil_strokes (document));
+	save_document (document, output_uri, input_uri, true);
+	check_editable_copy (output, true);
+	save_document (document, output_uri, input_uri);
+	check_page_contents (output, false);
+
+	g_unlink (input);
+	g_unlink (output);
+	g_rmdir (directory);
+}
+
+void
+test_ink_save_failure_and_retry ()
+{
+	g_autoptr (GError) error = nullptr;
+	g_autofree char *directory = g_dir_make_tmp ("papers-ink-retry.XXXXXX", &error);
+	g_assert_no_error (error);
+	g_autofree char *input = g_build_filename (directory, "input.pdf", nullptr);
+	g_autofree char *snapshot = g_build_filename (directory, "snapshot.pdf", nullptr);
+	g_autofree char *blocked = g_build_filename (directory, "blocked.pdf", nullptr);
+	g_autofree char *sentinel = g_build_filename (blocked, "existing", nullptr);
+	g_autofree char *output = g_build_filename (directory, "output.pdf", nullptr);
+	g_autofree char *input_uri = g_filename_to_uri (input, nullptr, nullptr);
+	g_autofree char *snapshot_uri = g_filename_to_uri (snapshot, nullptr, nullptr);
+	g_autofree char *blocked_uri = g_filename_to_uri (blocked, nullptr, nullptr);
+	g_autofree char *output_uri = g_filename_to_uri (output, nullptr, nullptr);
+
+	create_input (input);
+	g_assert_cmpint (g_mkdir (blocked, 0700), ==, 0);
+	g_assert_true (g_file_set_contents (sentinel, "existing data", -1, &error));
+	g_assert_no_error (error);
+	g_autoptr (PpsDocument) document = load_document (input_uri);
+	draw_pen_stroke (document);
+	g_assert_true (pps_document_get_modified (document));
+
+	guint64 revision;
+	g_assert_false (pps_document_stage_save (document, blocked_uri, FALSE, &revision, &error));
+	g_assert_error (error, G_FILE_ERROR, G_FILE_ERROR_ISDIR);
+	g_clear_error (&error);
+	g_assert_true (pps_document_get_modified (document));
+	g_assert_false (run_save_job (document, blocked_uri, input_uri, false, &error));
+	g_assert_error (error, G_IO_ERROR, G_IO_ERROR_IS_DIRECTORY);
+	g_clear_error (&error);
+	g_assert_true (pps_document_get_modified (document));
+	g_autofree char *existing = nullptr;
+	g_assert_true (g_file_get_contents (sentinel, &existing, nullptr, &error));
+	g_assert_no_error (error);
+	g_assert_cmpstr (existing, ==, "existing data");
+	check_editable_copy (input, false);
+
+	g_autoptr (PpsJob) cancelled = pps_job_save_new (document, output_uri, input_uri);
+	pps_job_cancel (cancelled);
+	pps_job_run (cancelled);
+	g_assert_false (pps_job_is_succeeded (cancelled, &error));
+	g_assert_error (error, G_IO_ERROR, G_IO_ERROR_CANCELLED);
+	g_clear_error (&error);
+	g_assert_false (g_file_test (output, G_FILE_TEST_EXISTS));
+	g_assert_true (pps_document_get_modified (document));
+
+	g_autoptr (GDir) target_dir = g_dir_open (directory, 0, &error);
+	g_assert_no_error (error);
+	while (const char *name = g_dir_read_name (target_dir))
+		g_assert_false (g_str_has_prefix (name, ".papers-"));
+	g_autofree char *tmp_name = g_strdup_printf ("%s-%u", g_get_prgname (), getpid ());
+	g_autofree char *tmp_path = g_build_filename (g_get_tmp_dir (), tmp_name, nullptr);
+	g_autoptr (GDir) tmp_dir = g_dir_open (tmp_path, 0, &error);
+	g_assert_no_error (error);
+	g_assert_null (g_dir_read_name (tmp_dir));
+
+	g_assert_true (pps_document_stage_save (document, snapshot_uri, FALSE, &revision, &error));
+	g_assert_no_error (error);
+	check_page_contents (snapshot, false);
+	draw_pen_stroke (document, 1);
+	pps_document_save_committed (document, revision);
+	g_assert_true (pps_document_get_modified (document));
+	save_document (document, output_uri, input_uri);
+	check_page_contents (output);
+
+	g_unlink (input);
+	g_unlink (snapshot);
+	g_unlink (output);
+	g_unlink (sentinel);
+	g_rmdir (blocked);
+	g_rmdir (directory);
+}
+
+void
+test_encrypted_ink_save ()
+{
+	g_autoptr (GError) error = nullptr;
+	g_autofree char *directory = g_dir_make_tmp ("papers-encrypted-ink-save.XXXXXX", &error);
+	g_assert_no_error (error);
+	g_autofree char *input = g_build_filename (directory, "input.pdf", nullptr);
+	g_autofree char *output = g_build_filename (directory, "output.pdf", nullptr);
+	g_autofree char *input_uri = g_filename_to_uri (input, nullptr, nullptr);
+	g_autofree char *output_uri = g_filename_to_uri (output, nullptr, nullptr);
+
+	create_input (input, true);
+	g_autoptr (PpsDocument) document = load_document (input_uri, "test-password");
+	draw_pen_stroke (document);
+	save_document (document, output_uri, input_uri);
+	check_editable_copy (output, true, "test-password");
+
+	g_unlink (input);
+	g_unlink (output);
+	g_rmdir (directory);
+}
+} // namespace
+
+int
+main (int argc, char **argv)
+{
+	g_test_init (&argc, &argv, nullptr);
+	g_assert_true (pps_init ());
+	g_test_add_func ("/libview-jobs/save-pen-ink", test_ink_save);
+	g_test_add_func ("/libview-jobs/undo-and-save-editable-pen-ink", test_undo_and_editable_ink);
+	g_test_add_func ("/libview-jobs/save-pen-ink-failure-and-retry", test_ink_save_failure_and_retry);
+	g_test_add_func ("/libview-jobs/save-pen-ink-encrypted", test_encrypted_ink_save);
+	return g_test_run ();
+}
