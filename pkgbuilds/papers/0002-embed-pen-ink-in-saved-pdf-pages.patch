+static gboolean
+pps_job_save_transfer (const char *source_uri, const char *destination_uri, const char *original_uri, GCancellable *cancellable, GError **error)
+{
+	g_autoptr (GFile) source = g_file_new_for_uri (source_uri);
+	g_autoptr (GFile) destination = g_file_new_for_uri (destination_uri);
+	g_autofree char *path = g_file_get_path (destination);
+	GFileCopyFlags flags = G_FILE_COPY_TARGET_DEFAULT_PERMS | G_FILE_COPY_OVERWRITE;
+
+	if (!path) {
+		if (!g_file_copy (source, destination, flags, cancellable, NULL, NULL, error))
+			return FALSE;
+
+		pps_file_copy_metadata (original_uri, destination_uri, NULL);
+		return TRUE;
+	}
+
+	/* Finish the copy beside the local destination before replacing it. */
+	g_autofree char *directory = g_path_get_dirname (path);
+	g_autofree char *staged_path = g_build_filename (directory, ".papers-save.XXXXXX", NULL);
+	int fd = g_mkstemp (staged_path);
+	if (fd == -1) {
+		int saved_errno = errno;
+		g_set_error_literal (error, G_IO_ERROR, g_io_error_from_errno (saved_errno), g_strerror (saved_errno));
+		return FALSE;
+	}
+	close (fd);
+
+	g_autoptr (GFile) staged = g_file_new_for_path (staged_path);
+	g_autofree char *staged_uri = g_file_get_uri (staged);
+	gboolean copied = g_file_copy (source, staged, flags, cancellable, NULL, NULL, error);
+	if (copied) {
+		/* Failure to copy metadata is not a hard error. */
+		pps_file_copy_metadata (original_uri, staged_uri, NULL);
+		if (!g_cancellable_set_error_if_cancelled (cancellable, error)) {
+			if (g_rename (staged_path, path) == 0)
+				return TRUE;
+
+			int saved_errno = errno;
+			g_set_error_literal (error, G_IO_ERROR, g_io_error_from_errno (saved_errno), g_strerror (saved_errno));
+		}
+	}
+	g_unlink (staged_path);
+	return FALSE;
+}
