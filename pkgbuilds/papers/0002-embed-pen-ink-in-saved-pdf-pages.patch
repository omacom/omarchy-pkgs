                GError **error)
@@ -258,29 +291,118 @@ poppler_rect_to_pps (PpsPage *page, const PopplerRectangle *poppler_rect)
 
 /* PpsDocument */
 static gboolean
-pdf_document_save (PpsDocument *document,
-                   const char *uri,
-                   GError **error)
+pdf_document_save_editable (PdfDocument *self, const char *uri, GError **error)
 {
-	PdfDocument *self = PDF_DOCUMENT (document);
-	gboolean retval;
 	GError *poppler_error = NULL;
-
-	g_rw_lock_writer_lock (&self->rwlock);
-
-	retval = poppler_document_save (self->document,
-	                                uri, &poppler_error);
-	if (retval) {
-		self->forms_modified = FALSE;
-		self->annots_modified = FALSE;
-		pps_document_set_modified (PPS_DOCUMENT (document), FALSE);
-	} else {
+	gboolean saved = poppler_document_save (self->document, uri, &poppler_error);
+	if (!saved)
 		convert_error (poppler_error, error);
+	return saved;
+}
+
+static gboolean
+pdf_document_save_with_pencil_ink (PdfDocument *self, const char *uri, GError **error)
+{
+	g_autoptr (GPtrArray) strokes = g_ptr_array_new ();
+	GHashTableIter iter;
+	gpointer key;
+	g_hash_table_iter_init (&iter, self->pencil_strokes);
+	while (g_hash_table_iter_next (&iter, &key, NULL)) {
+		PopplerAnnot *annot = POPPLER_ANNOT (key);
+		g_autofree char *contents = poppler_annot_get_contents (annot);
+		if (poppler_annot_get_page_index (annot) >= 0 &&
+		    !(poppler_annot_get_flags (annot) & ~POPPLER_ANNOT_FLAG_PRINT) &&
+		    (!contents || !*contents) && !poppler_annot_markup_has_popup (POPPLER_ANNOT_MARKUP (annot)))
+			g_ptr_array_add (strokes, annot);
 	}
 
+	if (strokes->len == 0)
+		return pdf_document_save_editable (self, uri, error);
+
+	g_autofree char *input = NULL;
+	int fd = pps_mkstemp ("pencil-ink.XXXXXX", &input, error);
+	if (fd == -1)
+		return FALSE;
+
+	close (fd);
+	g_autofree char *input_uri = g_filename_to_uri (input, NULL, error);
+	if (!input_uri) {
+		g_unlink (input);
+		return FALSE;
+	}
+
+	/* Poppler GLib cannot expose an annotation's PDF object reference or set
+	 * its /NM field. Tag only these live Pencil objects during serialization,
+	 * then restore their empty contents before unlocking or saving an editable copy.
+	 * The tagged PDF stays in a private temporary file. */
+	g_autofree char *marker = g_uuid_string_random ();
+	for (guint i = 0; i < strokes->len; i++)
+		poppler_annot_set_contents (g_ptr_array_index (strokes, i), marker);
+	gboolean saved = pdf_document_save_editable (self, input_uri, error);
+	for (guint i = 0; i < strokes->len; i++)
+		poppler_annot_set_contents (g_ptr_array_index (strokes, i), NULL);
+
+	PpsPdfInkSaveResult result = PPS_PDF_INK_SAVE_ERROR;
+	if (saved)
+		result = pps_pdf_bake_ink (input, uri, self->password,
+		                           poppler_document_get_n_signatures (self->document),
+		                           marker, strokes->len, error);
+	g_unlink (input);
+	if (result == PPS_PDF_INK_SAVE_EDITABLE)
+		return pdf_document_save_editable (self, uri, error);
