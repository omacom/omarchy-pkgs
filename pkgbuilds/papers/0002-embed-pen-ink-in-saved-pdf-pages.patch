 }
 
+static void
+pdf_document_get_property (GObject *object, guint property_id, GValue *value, GParamSpec *pspec)
+{
+	if (property_id == PROP_HAS_PENCIL_STROKES)
+		g_value_set_boolean (value, g_atomic_int_get (&PDF_DOCUMENT (object)->has_pencil_strokes));
+	else
+		G_OBJECT_CLASS (pdf_document_parent_class)->get_property (object, property_id, value, pspec);
+}
+
+/* Update under the writer lock and notify after releasing it. */
+static gboolean
+pdf_document_update_pencil_stroke_presence (PdfDocument *self)
+{
+	gboolean has_strokes = g_hash_table_size (self->pencil_strokes) > 0;
+	return g_atomic_int_exchange (&self->has_pencil_strokes, has_strokes) != has_strokes;
+}
