new file mode 100644
index 0000000..e9a6c0b
--- /dev/null
+++ b/libdocument/backend/pdf/pps-pdf-ink.cc
@@ -0,0 +1,300 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "pps-pdf-ink.h"
+#include "config.h"
+
+#include <glib/gi18n-lib.h>
+
+#include <glib/gstdio.h>
+#include <qpdf/Constants.h>
+#include <qpdf/QPDF.hh>
+#include <qpdf/QPDFAcroFormDocumentHelper.hh>
+#include <qpdf/QPDFPageDocumentHelper.hh>
+#include <qpdf/QPDFWriter.hh>
+
+#include <cerrno>
+#include <cmath>
+#include <iomanip>
+#include <locale>
+#include <set>
+#include <sstream>
+#include <stdexcept>
+#include <vector>
+
+namespace
+{
+std::vector<double>
+read_numbers (QPDFObjectHandle array)
+{
+	if (!array.isArray ())
+		return {};
+
+	std::vector<double> values;
+	for (auto item : array.aitems ()) {
+		if (!item.isNumber () || !std::isfinite (item.getNumericValue ()))
+			return {};
+
+		values.push_back (item.getNumericValue ());
+	}
+	return values;
+}
+
+bool
+get_ink_width (QPDFObjectHandle annot, double &width)
+{
+	auto style = annot.getKey ("/BS");
+	if (style.isDictionary ()) {
+		if (style.hasKey ("/S") && !style.getKey ("/S").isNameAndEquals ("/S"))
+			return false;
+
+		auto width_obj = style.getKey ("/W");
+		return width_obj.isNull () || width_obj.getValueAsNumber (width);
+	}
+	if (!style.isNull ())
+		return false;
+
+	// Poppler writes the Draw tool's width as a legacy border array.
+	auto border = annot.getKey ("/Border");
+	if (border.isNull ())
+		return true;
+
+	auto values = read_numbers (border);
+	if (values.size () != 3)
+		return false;
+
+	width = values[2];
+	return true;
+}
+
+bool
+write_ink_path (QPDFObjectHandle annot, std::ostringstream &drawing, double &opacity)
+{
+	// A stored appearance can contain custom artwork or the highlighter's
+	// multiply blend mode. Keep it as well as ink with display or review semantics.
+	if (!annot.getKey ("/Subtype").isNameAndEquals ("/Ink") ||
+	    annot.hasKey ("/AP") || annot.hasKey ("/OC") || annot.hasKey ("/Popup") ||
+	    annot.hasKey ("/IRT") || annot.hasKey ("/StructParent") || annot.hasKey ("/AF"))
+		return false;
+
+	auto flags = annot.getKey ("/F");
+	long long value;
+	if (!flags.isNull () && (!flags.getValueAsInt (value) || (value & ~an_print)))
+		return false;
+
+	auto ink_list = annot.getKey ("/InkList");
+	if (!ink_list.isArray ())
+		return false;
+
+	double width = 1.0;
+	if (!get_ink_width (annot, width) || !std::isfinite (width) || width < 0)
+		return false;
+
+	auto alpha = annot.getKey ("/CA");
+	opacity = 1.0;
+	if ((!alpha.isNull () && !alpha.getValueAsNumber (opacity)) ||
+	    !std::isfinite (opacity) || opacity < 0 || opacity > 1)
+		return false;
+
+	auto color = annot.getKey ("/C");
+	const auto components = color.isNull () ? std::vector<double>{ 0.0 } : read_numbers (color);
+	const auto count = components.size ();
+	if (count != 1 && count != 3 && count != 4)
+		return false;
+
+	drawing.imbue (std::locale::classic ());
+	drawing << std::fixed << std::setprecision (5);
+	for (auto value : components) {
+		if (value < 0 || value > 1)
+			return false;
+
+		drawing << value << ' ';
+	}
+	const char *color_operator = "G";
+	if (count == 3)
+		color_operator = "RG";
+	else if (count == 4)
+		color_operator = "K";
+
+	drawing << color_operator << '\n';
+	drawing << width << " w\n";
+
+	bool has_stroke = false;
+	for (auto path : ink_list.aitems ()) {
+		const auto points = read_numbers (path);
+		if (points.size () < 2 || points.size () % 2 != 0)
+			return false;
+
+		for (size_t i = 0; i < points.size (); i += 2)
+			drawing << points[i] << ' ' << points[i + 1] << (i == 0 ? " m\n" : " l\n");
+		drawing << "S\n";
+		has_stroke = true;
+	}
+	return has_stroke;
+}
+
+guint
+bake_page (QPDF &pdf, QPDFPageObjectHelper &page, const char *marker, bool &has_transparency)
+{
+	auto page_obj = page.getObjectHandle ();
+	auto annots = page_obj.getKey ("/Annots");
+	if (!annots.isArray ())
+		return 0;
+
+	std::set<QPDFObjGen> targets;
+	for (auto annot : annots.aitems ()) {
+		if (!annot.isDictionary ())
+			continue;
+
+		auto in_reply_to = annot.getKey ("/IRT");
+		auto popup_parent = annot.getKey ("/Parent");
+		if (in_reply_to.isIndirect ())
+			targets.insert (in_reply_to.getObjGen ());
+		if (popup_parent.isIndirect () && annot.getKey ("/Subtype").isNameAndEquals ("/Popup"))
+			targets.insert (popup_parent.getObjGen ());
+	}
+
+	std::string overlay;
+	std::vector<QPDFObjectHandle> retained;
+	QPDFObjectHandle resources;
+	QPDFObjectHandle states;
+	int resource_id = 1;
+	guint baked = 0;
+	for (auto annot : annots.aitems ()) {
+		auto contents = annot.isDictionary () ? annot.getKey ("/Contents") : QPDFObjectHandle::newNull ();
+		if (!contents.isString () || contents.getUTF8Value () != marker) {
+			retained.push_back (annot);
+			continue;
+		}
+
+		std::ostringstream drawing;
+		double opacity;
+		if ((annot.isIndirect () && targets.contains (annot.getObjGen ())) ||
+		    !write_ink_path (annot, drawing, opacity))
+			throw std::runtime_error (_ ("A Pencil stroke could not be saved as page content. Save an editable copy to keep the stroke."));
+
+		++baked;
+		overlay += "q\n";
+		if (opacity < 1) {
+			if (!states.isInitialized ()) {
+				resources = page.getAttribute ("/Resources", true);
+				if (!resources.isDictionary ()) {
+					resources = QPDFObjectHandle::newDictionary ();
+					page_obj.replaceKey ("/Resources", resources);
+				}
+
+				states = resources.getKey ("/ExtGState");
+				states = states.isDictionary () ? states.shallowCopy () : QPDFObjectHandle::newDictionary ();
+				resources.replaceKey ("/ExtGState", states);
+			}
+
+			auto name = resources.getUniqueResourceName ("/PpsInk", resource_id);
+			auto state = QPDFObjectHandle::newDictionary ();
+			state.replaceKey ("/CA", QPDFObjectHandle::newReal (opacity, 8));
+			states.replaceKey (name, state);
+			overlay += name + " gs\n";
+			has_transparency = true;
+		}
+		overlay += drawing.str ();
+		overlay += "Q\n";
+	}
+
+	if (baked == 0)
+		return 0;
+
+	// Isolate the original page's graphics state before painting in default PDF
+	// user space. Crop boxes and page rotation then apply to the ink and page alike.
+	page.addPageContents (pdf.newStream ("q\n"), true);
+	page.addPageContents (pdf.newStream ("\nQ\nn\n" + overlay), false);
+	if (retained.empty ())
+		page_obj.removeKey ("/Annots");
+	else
+		page_obj.replaceKey ("/Annots", QPDFObjectHandle::newArray (retained));
+	return baked;
+}
+
+bool
+has_certificate_signature (QPDF &pdf, int signature_fields)
+{
+	auto permissions = pdf.getRoot ().getKey ("/Perms");
+	if (permissions.isDictionary () &&
+	    (permissions.hasKey ("/DocMDP") || permissions.hasKey ("/UR") || permissions.hasKey ("/UR3")))
+		return true;
+
+	if (signature_fields == 0)
+		return false;
+
+	int empty_fields = 0;
+	for (auto &field : QPDFAcroFormDocumentHelper (pdf).getFormFields ()) {
+		if (field.getFieldType () != "/Sig")
+			continue;
+		if (!field.getValue ().isNull ())
+			return true;
+		++empty_fields;
+	}
+
+	// Poppler also finds some orphaned signature widgets. Keep the original
+	// save path if we could not account for every field as unsigned.
+	return empty_fields < signature_fields;
+}
+
+PpsPdfInkSaveResult
+save_baked_ink (const char *input, const char *output, const char *password, int signature_fields, const char *marker, guint expected_strokes, GError **error)
+{
+	QPDF pdf;
+	pdf.setAttemptRecovery (false);
+	pdf.processFile (input, password);
+	if (pdf.isEncrypted () || has_certificate_signature (pdf, signature_fields))
+		return PPS_PDF_INK_SAVE_EDITABLE;
+
+	guint baked = 0;
+	bool has_transparency = false;
+	for (auto &page : QPDFPageDocumentHelper (pdf).getAllPages ())
+		baked += bake_page (pdf, page, marker, has_transparency);
+
+	if (baked != expected_strokes)
+		throw std::runtime_error (_ ("Papers could not identify all Pencil strokes in the saved PDF. Save an editable copy to keep the strokes."));
+
+	g_autofree char *directory = g_path_get_dirname (output);
+	g_autofree char *temporary = g_build_filename (directory, ".papers-ink.XXXXXX", nullptr);
+	int fd = g_mkstemp (temporary);
+	if (fd < 0) {
+		int saved_errno = errno;
+		g_set_error_literal (error, G_FILE_ERROR, g_file_error_from_errno (saved_errno), g_strerror (saved_errno));
+		return PPS_PDF_INK_SAVE_ERROR;
+	}
+	g_close (fd, nullptr);
+
+	try {
+		QPDFWriter writer (pdf, temporary);
+		if (has_transparency)
+			writer.setMinimumPDFVersion ("1.4");
+		writer.write ();
+	} catch (...) {
+		g_unlink (temporary);
+		throw;
+	}
+
+	if (g_rename (temporary, output) == 0)
+		return PPS_PDF_INK_SAVE_FLATTENED;
+
+	int saved_errno = errno;
+	g_unlink (temporary);
+	g_set_error_literal (error, G_FILE_ERROR, g_file_error_from_errno (saved_errno), g_strerror (saved_errno));
+	return PPS_PDF_INK_SAVE_ERROR;
+}
+} // namespace
+
+PpsPdfInkSaveResult
+pps_pdf_bake_ink (const char *input, const char *output_uri, const char *password, int signature_fields, const char *marker, guint expected_strokes, GError **error)
+{
+	g_autofree char *filename = g_filename_from_uri (output_uri, nullptr, error);
+	if (!filename)
+		return PPS_PDF_INK_SAVE_ERROR;
+
+	try {
+		return save_baked_ink (input, filename, password, signature_fields, marker, expected_strokes, error);
+	} catch (const std::exception &exception) {
+		g_set_error_literal (error, G_FILE_ERROR, G_FILE_ERROR_FAILED, exception.what ());
+		return PPS_PDF_INK_SAVE_ERROR;
+	}
+}
