# Based on the Arch Linux Papers recipe maintained by Balló György.
# Carry the upstream print fix and the pen save patch against this release.
# Recheck both patches whenever Papers is updated.

pkgbase=papers
pkgname=(papers papers-lib-docs)
pkgver=51.1
pkgrel=1.2
pkgdesc='Document viewer for PDF and other document formats aimed at the GNOME desktop'
arch=(x86_64 aarch64)
url='https://apps.gnome.org/Papers/'
license=(GPL-2.0-or-later)
depends=(
  cairo
  dconf
  djvulibre
  exempi
  gdk-pixbuf2
  glib2
  glibc
  graphene
  gtk4
  gtksourceview5
  hicolor-icon-theme
  libadwaita
  libarchive
  libgcc
  libnautilus-extension
  libspelling
  libstdc++
  libtiff
  pango
  poppler-glib
  qpdf
)
makedepends=(
  appstream
  blueprint-compiler
  gi-docgen
  glib2-devel
  gobject-introspection
  itstool
  libsysprof-capture
  meson
  rust
)
source=(
  "https://download.gnome.org/sources/papers/${pkgver%%.*}/papers-$pkgver.tar.xz"
  0001-make-new-annotations-printable.patch
  0002-embed-pen-ink-in-saved-pdf-pages.patch
)
sha256sums=(
  'ac0db229883b3d2aacbbda1700dc12aa69716664df201120926096f066e4796b'
  '270bf3b64eedbd1b30baf6b1fdeb7fc284cfab0cb571e12a2e54880a7eb2da52'
  'ea98c02f9c63e954168a51228558d7124a6237949b5e2157b3715b74391e15fb'
)

prepare() {
  cd "papers-$pkgver"
  patch -Np1 -i "$srcdir/0001-make-new-annotations-printable.patch"
  patch -Np1 -i "$srcdir/0002-embed-pen-ink-in-saved-pdf-pages.patch"

  CARGO_HOME="$srcdir/build/cargo-home" cargo fetch --locked --target host-tuple
}

build() {
  export CARGO_NET_OFFLINE=true
  arch-meson "papers-$pkgver" build
  meson compile -C build
}

check() {
  CARGO_NET_OFFLINE=true meson test -C build --print-errorlogs --no-rebuild
}

package_papers() {
  groups=(gnome)
  meson install -C build --no-rebuild --destdir "$pkgdir"
  mkdir -p "$srcdir/docs/usr/share"
  mv "$pkgdir/usr/share/doc" "$srcdir/docs/usr/share/"
}

package_papers-lib-docs() {
  pkgdesc+=' (library API documentation)'
  depends=()
  mv "$srcdir/docs/usr" "$pkgdir/"
}
