diff --git i/omarchy-mac-boot/README.md w/omarchy-mac-boot/README.md
index 5dee5f0..c1662b7 100644
--- i/omarchy-mac-boot/README.md
+++ w/omarchy-mac-boot/README.md
@@ -24,3 +24,5 @@ A package can add a device tree node that the kernel's device trees do not have
 - Refuse a snapshot restore the live boot files do not match. `omarchy-mac-snapshot-check` is limine-snapper-sync's pre hook `04-omarchy-mac-snapshot-check` and post hook `99-omarchy-mac-snapshot-check`. Before the restore, a Limine Mac must be booted into the snapshot, and that root must pass `omarchy-apple-silicon-boot-check --boot-chain`: what the next boot reads, as `update-verify` checks it, with no reboot pending. The restore's own list can still put back another snapshot, so after it the restored `@` must hold the booted root's kernel, device trees, m1n1, U-Boot and Limine, and the UKI the restore put on the ESP must carry that kernel; otherwise it says not to reboot and how to put the backup back, and the pre hook lets that one undo through while the booted root fails its check, since the ESP then holds the refused root's boot files. The restored root must also carry the Limine activation, ESP, crypttab and root mount of the booted root. A restored root that cannot be read is reported unchecked and arms no undo. The pre hook sorts before the activation gate so a GRUB Mac is told why: Omarchy's restore is limine-snapper-restore alone, with no subvolume swap for GRUB. The hooks run from the booted snapshot, so they protect snapshots taken with this package or later.
 
 Do not duplicate shared snapshot/UI/password policy here. Historical GRUB fallback remains for compatibility; this refactor qualifies fresh Limine images, not upgrades of old factory snapshots. Moving an existing Mac onto these packages is a standalone migration, outside this package.
+
+Aurora's native ARM64 Steam runs in a 4K page process tree, which needs `CONFIG_ARM64_USER4K_EXPERIMENTAL=y` and `user4k=on` at boot. The kernel builds the support in but keeps it off without the boot option. During `setup-boot`, `grub-console.sh` adds `user4k=on` to `GRUB_CMDLINE_LINUX` when the installed kernel package is `linux-aurora`, on an image's first boot as well as later runs. Asahi and unknown kernels are left alone. An explicit `user4k=` in either GRUB command-line variable is kept as it is, so the owner can opt out with `user4k=off` in `/etc/default/grub` and `sudo omarchy-mac-boot-update`. `/etc/default/grub` feeds both GRUB and Limine, and the existing pending journal retries a failed boot-file rebuild. An existing install picks the option up with `sudo omarchy-lifecycle-dispatch setup-boot` and a reboot. The native kernel page size stays 16K, and ordinary programs keep it. Omarchy's `omarchy-steam-fex` runs Steam in muvm's guest and does not need host user4k.
diff --git i/omarchy-mac-boot/setup/grub-console.sh w/omarchy-mac-boot/setup/grub-console.sh
index def934a..b24a940 100644
--- i/omarchy-mac-boot/setup/grub-console.sh
+++ w/omarchy-mac-boot/setup/grub-console.sh
@@ -90,6 +90,20 @@ omarchy-hw-apple-silicon || return 0
   cmdline=$(grub_console_get GRUB_CMDLINE_LINUX)
   read -ra words <<<"$cmdline"
   wanted_cmdline=$(grub_console_device_wait "$(omarchy-mac-initramfs-hooks 2>/dev/null || true)" "$cmdline")
+  # Aurora's native ARM64 Steam launcher requests inherited 4K user pages.
+  # The kernel keeps this support off until boot enables it. GRUB defaults
+  # also feed Limine, so set it here for both loaders. Keep an owner's
+  # explicit user4k= choice in either variable, including user4k=off.
+  if [[ $(omarchy-mac-kernel 2>/dev/null) == linux-aurora ]]; then
+    read -ra default_words <<<"$(grub_console_get GRUB_CMDLINE_LINUX_DEFAULT)"
+    has_user4k=0
+    for word in "${words[@]}" "${default_words[@]}"; do
+      [[ $word != user4k=* ]] || has_user4k=1
+    done
+    if (( ! has_user4k )); then
+      wanted_cmdline="${wanted_cmdline:+$wanted_cmdline }user4k=on"
+    fi
+  fi
   # Words unchanged: the line stays as the Mac wrote it, spacing and all.
   [[ $wanted_cmdline == "${words[*]}" ]] && wanted_cmdline=$cmdline
   grub_console_set GRUB_CMDLINE_LINUX "$wanted_cmdline" || exit 1
diff --git i/omarchy-mac-boot/test/apple-grub-console-test.sh w/omarchy-mac-boot/test/apple-grub-console-test.sh
index 9f4643b..2c0acf2 100644
--- i/omarchy-mac-boot/test/apple-grub-console-test.sh
+++ w/omarchy-mac-boot/test/apple-grub-console-test.sh
@@ -22,6 +22,12 @@ exit "${TEST_UPDATE_FAILURE:-0}"
 STUB
 done
 chmod +x "$test_tmp/bin"/*
+# Keep the existing GRUB checks independent of the host's kernel package.
+cat >"$test_tmp/bin/omarchy-mac-kernel" <<'STUB'
+#!/bin/bash
+printf '%s\n' linux-asahi
+STUB
+chmod +x "$test_tmp/bin/omarchy-mac-kernel"
 export PATH="$test_tmp/bin:$ROOT/bin:$PATH" TEST_CALLS="$test_tmp/calls"
 export OMARCHY_GRUB_DEFAULT="$test_tmp/grub" OMARCHY_GRUB_CONSOLE_PENDING="$test_tmp/state/pending"
 export OMARCHY_MKINITCPIO_CONF_DIR="$test_tmp/mkinitcpio.conf.d" OMARCHY_MKINITCPIO_PRESET_DIR="$test_tmp/presets"
@@ -118,3 +124,65 @@ MKINITCPIO_CONF="$test_tmp/missing.conf" run
 grep -Fxq 'GRUB_CMDLINE_LINUX="zswap.enabled=0 rootflags=x-systemd.device-timeout=0"' "$test_tmp/grub" ||
   fail "an unreadable configuration keeps the wait, as every image boots systemd" "$(cat "$test_tmp/grub")"
 pass "the initramfs kind comes from the preset, mkinitcpio.conf and its drop-ins in mkinitcpio's order"
+
+# Aurora uses host mixed-page support; Asahi's muvm Steam path does not.
+cat >"$test_tmp/bin/omarchy-mac-kernel" <<'STUB'
+#!/bin/bash
+printf '%s\n' "${TEST_KERNEL:-linux-aurora}"
+STUB
+chmod +x "$test_tmp/bin/omarchy-mac-kernel"
+printf 'GRUB_VIDEO_BACKEND="efi_gop"\nGRUB_CMDLINE_LINUX="rd.luks.uuid=luks-id rootflags=subvol=@"\nGRUB_CMDLINE_LINUX_DEFAULT="quiet splash"\n' >"$test_tmp/grub"
+if TEST_UPDATE_FAILURE=7 run; then fail "failed Aurora boot rebuild is reported"; fi
+[[ -e $OMARCHY_GRUB_CONSOLE_PENDING ]] || fail "Aurora rebuild failure stays pending"
+grep -Fxq 'GRUB_CMDLINE_LINUX="rd.luks.uuid=luks-id rootflags=subvol=@,x-systemd.device-timeout=0 user4k=on"' "$test_tmp/grub" ||
+  fail "Aurora enables user4k without losing root or encryption flags"
+TEST_NOT_LIMINE=0 run
+[[ ! -e $OMARCHY_GRUB_CONSOLE_PENDING ]] || fail "successful Aurora retry clears pending state"
+[[ $(tail -n 1 "$TEST_CALLS") == omarchy-mac-boot-update ]] || fail "Aurora retries the active Limine rebuild"
+cp "$test_tmp/grub" "$test_tmp/aurora-configured"
+calls=$(wc -l <"$TEST_CALLS")
+run
+cmp -s "$test_tmp/grub" "$test_tmp/aurora-configured" || fail "Aurora defaults are idempotent"
+[[ $(wc -l <"$TEST_CALLS") == "$calls" ]] || fail "Aurora does not rebuild again when configured"
+pass "Aurora enables user4k for both loaders with retry and idempotence"
+
+printf 'UUID=test-root / btrfs subvol=@ 0 0\n' >"$test_tmp/fstab"
+printf 'KERNEL_CMDLINE[default]=""\n' >"$test_tmp/limine"
+# No host limine-entry-tool drop-ins, and either assignment form the helper writes.
+mkdir -p "$test_tmp/limine-entry-tool.d"
+OMARCHY_LIMINE_DEFAULT="$test_tmp/limine" OMARCHY_FSTAB="$test_tmp/fstab" OMARCHY_LIMINE_DROPINS="$test_tmp/limine-entry-tool.d" \
+  bash "$ROOT/bin/omarchy-mac-limine-cmdline"
+grep -Exq 'KERNEL_CMDLINE\[default\]\+?="root=UUID=test-root rw rootflags=subvol=@,x-systemd.device-timeout=0 rd\.luks\.uuid=luks-id user4k=on quiet splash"' "$test_tmp/limine" ||
+  fail "Limine receives user4k and the existing root/encryption options" "$(cat "$test_tmp/limine")"
+[[ $(grep -o 'user4k=' "$test_tmp/limine" | wc -l) == 1 ]] || fail "Limine carries user4k once"
+pass "the shared GRUB defaults carry user4k into Limine"
+
+# An Omarchy Mac image's first boot: the defaults finalize-root writes.
+printf 'GRUB_VIDEO_BACKEND="efi_gop"\nGRUB_CMDLINE_LINUX="zswap.enabled=0 rootfstype=btrfs"\nGRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=0"\n' >"$test_tmp/grub"
+TEST_NOT_LIMINE=0 run
+grep -Fxq 'GRUB_CMDLINE_LINUX="zswap.enabled=0 rootfstype=btrfs rootflags=x-systemd.device-timeout=0 user4k=on"' "$test_tmp/grub" ||
+  fail "an image's first boot gets user4k with the root wait" "$(cat "$test_tmp/grub")"
+TEST_NOT_LIMINE=0 run
+[[ $(grep -o 'user4k=' "$test_tmp/grub" | wc -l) == 1 ]] || fail "a second setup-boot does not repeat user4k"
+pass "an image's first boot gets user4k once"
+
+for choice in off on 0 1; do
+  for variable in GRUB_CMDLINE_LINUX GRUB_CMDLINE_LINUX_DEFAULT; do
+    printf 'GRUB_VIDEO_BACKEND="efi_gop"\nGRUB_CMDLINE_LINUX="rootflags=subvol=@,x-systemd.device-timeout=0"\n' >"$test_tmp/grub"
+    printf '%s="quiet user4k=%s"\n' "$variable" "$choice" >>"$test_tmp/grub"
+    run
+    grep -q "user4k=$choice" "$test_tmp/grub" || fail "explicit user4k=$choice survives in $variable"
+    [[ $(grep -o 'user4k=' "$test_tmp/grub" | wc -l) == 1 ]] || fail "an explicit user4k choice is not duplicated"
+  done
+done
+pass "explicit user4k choices in either GRUB variable are preserved"
+
+printf 'GRUB_VIDEO_BACKEND="efi_gop"\nGRUB_CMDLINE_LINUX="rootflags=subvol=@,x-systemd.device-timeout=0"\n' >"$test_tmp/grub"
+TEST_KERNEL=linux-asahi run
+! grep -q 'user4k=' "$test_tmp/grub" || fail "Asahi keeps its existing host page policy"
+TEST_KERNEL=unknown run
+! grep -q 'user4k=' "$test_tmp/grub" || fail "an unknown kernel does not acquire Aurora's policy"
+printf 'GRUB_VIDEO_BACKEND="efi_gop"\nGRUB_CMDLINE_LINUX=""\n' >"$test_tmp/grub"
+MKINITCPIO_CONF=$busybox_conf run
+grep -Fxq 'GRUB_CMDLINE_LINUX="user4k=on"' "$test_tmp/grub" || fail "busybox Aurora gets user4k without the systemd root wait"
+pass "user4k is Aurora-specific and works with a busybox initramfs"
