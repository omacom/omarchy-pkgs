# Maintainer: The Omarchy Authors
# ALSA UCM profile from the t2bce driver stack (github.com/deqrocks/t2bce),
# which the t2linux kernel patches carry as the T2 audio driver.

pkgname=apple-t2-audio-config
_commit=a973d53c8278e9db5ff8314b816d6880309ed39e
pkgver=0.4.r21.ga973d53
pkgrel=2
pkgdesc='ALSA UCM configuration for the t2bce audio driver on Apple T2 Macs'
url='https://github.com/deqrocks/t2bce'
arch=(any)
license=(GPL-2.0-only)
depends=(alsa-ucm-conf)
optdepends=(
  'linux-t2: for the t2bce audio driver'
)
replaces=(apple-t2-audio-config-alt)
makedepends=(git)
source=("t2bce::git+https://github.com/deqrocks/t2bce.git#commit=$_commit")
sha256sums=('SKIP')

package() {
  cd t2bce/t2bce_audio-alsa-ucm-conf
  local conf
  for conf in ucm2/AppleT2/*.conf ucm2/conf.d/*/*.conf; do
    install -Dm644 "$conf" "$pkgdir/usr/share/alsa/$conf"
  done
}
