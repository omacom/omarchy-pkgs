# Maintainer: The Omarchy Authors
# ALSA UCM profile for the t2bce audio driver, by André Eikmeyer. These are
# the files of deqrocks/t2bce at a973d53 (archived), taken from
# kaiT2en/KaiT2en-Fedora at the commit that holds them byte-identical, which
# that repository published under MIT.

pkgname=apple-t2-audio-config
_commit=0ee536bacc82b460d2dc9e97a716cea31a652ea4
pkgver=0.4.r21.ga973d53
pkgrel=2
pkgdesc='ALSA UCM configuration for the t2bce audio driver on Apple T2 Macs'
url='https://github.com/kaiT2en/KaiT2en-Fedora'
arch=(any)
license=(MIT)
depends=(alsa-ucm-conf)
optdepends=(
  'linux-t2: for the t2bce audio driver'
)
replaces=(apple-t2-audio-config-alt)
makedepends=(git)
source=("kait2en::git+https://github.com/kaiT2en/KaiT2en-Fedora.git#commit=$_commit")
sha256sums=('SKIP')

package() {
  cd kait2en/modules/t2bce_audio-alsa-ucm-conf
  local conf
  for conf in ucm2/AppleT2/*.conf ucm2/conf.d/*/*.conf; do
    install -Dm644 "$conf" "$pkgdir/usr/share/alsa/$conf"
  done
  install -Dm644 ../../LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
