# Maintainer: Omarchy <https://omarchy.org>
# Based on Noa Himesaka's arch-mact2-PKGBUILDs recipe.
pkgname=apple-t2-audio-config
pkgver=0.4.r21.ga973d53
pkgrel=1.1
_commit=a973d53c8278e9db5ff8314b816d6880309ed39e
pkgdesc='ALSA UCM configuration for the t2bce audio driver on Apple T2 Macs'
url='https://github.com/deqrocks/t2bce'
arch=('any')
license=('GPL-2.0-only')
depends=('alsa-ucm-conf')
optdepends=('linux-t2: audio kernel module' 'pipewire: sound server' 'pulseaudio: sound server')
replaces=('apple-t2-audio-config-alt')
options=('!debug')
source=("t2bce-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('ff76afc42deca06a899675e5747bd0d27c325d98ce001f0e98b8222869161d82')

package() {
  cd "t2bce-$_commit/t2bce_audio-alsa-ucm-conf"
  for conf in ucm2/AppleT2/*.conf ucm2/conf.d/*/*.conf; do
    install -Dm644 "$conf" "$pkgdir/usr/share/alsa/$conf"
  done
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
