# Maintainer: Daniel Phillips <danphi@gmail.com>

pkgname=nodemangler-bin
_name=nodemangler
pkgver=1.0.16
pkgrel=1
pkgdesc="Node-based image editor and procedural texture generator"
arch=('x86_64')
url="https://nodemangler.com/"
license=('MIT OR Apache-2.0')
# Only libc, libm and libgcc_s are linked. winit and glutin dlopen the rest:
# EGL/GL through libglvnd, plus the Wayland and X11 client libraries.
depends=('glibc' 'libgcc' 'libglvnd' 'libxkbcommon' 'wayland' 'libx11'
         'libxcursor' 'libxrandr' 'libxi' 'hicolor-icon-theme')
provides=("$_name" 'mangle')
conflicts=("$_name")
options=('!strip' '!debug')
_archive="$_name-v$pkgver-linux-x86_64"
source_x86_64=("$_archive.tar.gz::https://github.com/dan335/nodemangler/releases/download/v$pkgver/$_archive.tar.gz")
sha256sums_x86_64=('e9317deee198156edf1269219e9dbd7e87acc773049df5f53eab98ef00442f9a')

package() {
  cd "$_archive"
  install -Dm755 mangler_gui "$pkgdir/usr/bin/$_name"
  install -Dm755 mangler_cli "$pkgdir/usr/bin/mangle"
  install -Dm644 nodemangler.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/$_name.png"
  # The archive's desktop entry launches mangler_gui; this package installs
  # the GUI as nodemangler.
  install -Dm644 nodemangler.desktop "$pkgdir/usr/share/applications/$_name.desktop"
  sed -i 's/^Exec=.*/Exec=nodemangler/' "$pkgdir/usr/share/applications/$_name.desktop"
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
