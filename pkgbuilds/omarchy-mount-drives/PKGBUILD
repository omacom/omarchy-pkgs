# Maintainer: Gerard (GKartist75)
pkgname=omarchy-mount-drives
pkgver=1.0.0
pkgrel=1
pkgdesc='Mount extra drives from /etc/fstab so they appear in the file manager'
arch=('any')
url='https://github.com/omacom/omarchy-pkgs/tree/master/pkgbuilds/omarchy-mount-drives'
license=('Unlicense')
depends=('bash' 'coreutils' 'gawk' 'hicolor-icon-theme' 'polkit' 'sudo' 'systemd' 'util-linux')
optdepends=(
  'omarchy: desktop launcher and notifications'
  'uwsm: open drives in Folio on the running desktop session'
  'xdg-utils: open drives with the default file manager outside Omarchy'
)
checkdepends=('desktop-file-utils')
source=("$pkgname" "$pkgname.desktop" LICENSE README.md)
sha256sums=('01aafa5d14d153714a48f26e2503b82e1a6750ef4e493035848414bfac7fe360'
            '83fe1d3a0f27fd7520e320cc445bb3304fe7b680289cf12a81923a5e49ee1129'
            '6b0382b16279f26ff69014300541967a356a666eb0b91b422f6862f6b7dad17e'
            '44684898d75af71e0fb09e185008eaecf848bf4353c7ee35af700d24c64fca92')

check() {
  bash -n "$pkgname"
  desktop-file-validate "$pkgname.desktop"
}

package() {
  install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
