[Desktop Entry]
Type=Application
Name=Mount Drives
GenericName=Drives
Comment=Mount the extra drives from /etc/fstab so your file manager shows them
Exec=omarchy-launch-floating-terminal-with-presentation "omarchy-mount-drives mount all"
Icon=drive-harddisk
Terminal=false
Categories=System;Filesystem;
Keywords=drive;disk;mount;fstab;ntfs;exfat;
StartupNotify=true
