# Maintainer: owe contributors
pkgname=owe-lockfeed
pkgver=0.2.7
pkgrel=1
pkgdesc="Lock screen video feed module for the OWE wallpaper engine"
arch=('x86_64' 'aarch64')
url="https://github.com/omacom/owe"
license=('MIT')
depends=('qt6-declarative')
makedepends=('cmake' 'qt6-declarative')
source=("$pkgname-$pkgver.tar.gz::https://github.com/omacom/owe/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('93c88257111e36537c43a9fb6acc9a6b8fb1f6ba5149444e828d719a02a533cd')

build() {
  cmake -S "$srcdir/owe-$pkgver/qml-plugin" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
