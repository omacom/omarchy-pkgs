# Maintainer: Spencer Bull <spencer.bull@hey.com>

pkgname=atreyu
pkgver=0.1.0
pkgrel=1
pkgdesc='AI assistant plugin for the Omarchy shell'
arch=('x86_64')
url='https://github.com/omacom/atreyu'
license=('MIT')

# What the plugin needs to load and answer at all; anything that only one
# feature executes, and that the code probes for first, is an optdepend. The
# citations for each entry are in .omarchy/README.md.
depends=(
  'cua-driver-bin>=0.27.0'
  'cua-hyprland-plugin>=0.26.1'
  'hyprland'
  'imagemagick'
  'jq'
  'nodejs>=22'
  'omarchy'
  'quickshell'
  'util-linux'
)
optdepends=(
  'grim: clip a window or region of the screen as context'
  'wl-clipboard: copy an answer to the clipboard'
  'xdg-utils: open links from answers'
  'uwsm: launch installed apps from a chat'
  'gtk3: launch installed apps from a chat (gtk-launch)'
  'voxtype: voice dictation and custom-word training'
  'herdr: continue a chat in a Herdr workspace'
  'tesseract: text extraction from captured screenshots'
  'libpulse: audio device selection for voice (pactl)'
  'pipewire-audio: spoken-answer playback and microphone routing'
  'ffmpeg: level metering while spoken answers play'
  'espeak-ng: local Kokoro text-to-speech'
  'openai-codex: Codex ACP harness'
  'opencode: OpenCode ACP harness'
  'lua: syntax check of the generated Hyprland bindings'
)

# runtime/dist/atreyu-broker and runtime/dist/adapters/codex-acp are static
# x86-64 ELF stubs that carry their JavaScript payload after the code and hand
# it to the system node. They have no section headers; strip or debug
# splitting would corrupt them.
options=('!strip' '!debug')

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Fill once the v0.1.0 tag exists; sync-upstream only updates newer versions.
sha256sums=('FILL_FROM_RELEASE_ARCHIVE')

package() {
  local plugin="$pkgdir/usr/share/omarchy/plugins/omarchy.atreyu"

  cd "$srcdir/$pkgname-$pkgver" || return 1

  jq -e --arg version "$pkgver" '
    .id == "omarchy.atreyu" and .version == $version and
    .entryPoints.barWidget == "BarWidget.qml" and .entryPoints.overlay == "Ambient.qml"
  ' manifest.json >/dev/null || {
    echo "manifest.json must declare omarchy.atreyu at $pkgver with BarWidget.qml and Ambient.qml entry points" >&2
    return 1
  }

  # Keep the tagged runtime payload; source, tests and release tooling stay out.
  local file directory
  for file in \
    manifest.json \
    BarWidget.qml \
    Ambient.qml \
    ContextCaptureOverlay.qml \
    Panel.qml \
    LICENSE \
    THIRD_PARTY_NOTICES.md \
    package.json \
    package-lock.json \
    scripts/install-hotkeys.sh \
    scripts/install-browser-companion.sh \
    scripts/manage-voice-escape.sh \
    runtime/adapters.release.json \
    runtime/system-dependencies.txt \
    runtime/bin/atreyu-broker \
    runtime/bin/codex-acp \
    runtime/dist/atreyu-broker \
    runtime/dist/atreyu-broker.LEGAL.txt \
    runtime/dist/atreyu-broker.THIRD_PARTY_LICENSES.txt \
    runtime/dist/adapters/codex-acp \
    runtime/dist/adapters/Apache-2.0.txt \
    runtime/policies/automatic.md; do
    install -Dm644 "$file" "$plugin/$file" || return 1
  done
  for directory in components assets runtime/licenses browser-companion/dist browser-companion/native-host; do
    [[ -d $directory && -n $(find "$directory" -type f -print -quit) ]] || {
      echo "release tree is missing runtime files under $directory" >&2
      return 1
    }
    install -d "$plugin/$(dirname "$directory")" || return 1
    cp -r "$directory" "$plugin/$directory" || return 1
  done
  find "$plugin" -type d -exec chmod 755 {} + || return 1
  find "$plugin" -type f -exec chmod 644 {} + || return 1

  # Only the commands invoked directly need executable bits.
  local executable
  for executable in \
    runtime/bin/atreyu-broker \
    runtime/bin/codex-acp \
    runtime/dist/atreyu-broker \
    runtime/dist/adapters/codex-acp \
    scripts/install-hotkeys.sh \
    scripts/install-browser-companion.sh \
    scripts/manage-voice-escape.sh \
    browser-companion/native-host/atreyu-browser-companion-host; do
    chmod 755 "$plugin/$executable" || return 1
  done

  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
