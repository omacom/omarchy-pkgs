# Maintainer: David Heinemeier Hansson <david@hey.com>

# The AUR builds signal-cli from source: Gradle, a JDK and a Rust build of
# libsignal-client, for a JVM app that then needs a JRE on every machine.
# Upstream also ships a GraalVM native binary that needs nothing but glibc and
# zlib, so this repackages that. It is published for x86_64 only.
# .omarchy/upstream.sh rewrites pkgver and the checksum from the release feed.

pkgname=signal-cli-bin
pkgver=0.14.7
pkgrel=1
pkgdesc="Command-line, JSON-RPC and D-Bus interface for the Signal messenger (native binary)"
arch=('x86_64')
url="https://github.com/AsamK/signal-cli"
license=('GPL-3.0-only')

depends=('glibc' 'zlib')

provides=("signal-cli=${pkgver}")
conflicts=('signal-cli')

# Upstream ships the image stripped; makepkg's strip would rewrite 370 MB for nothing.
options=('!debug' '!strip')

# The build image's default zstd leaves the 372 MB native image at 101 MB;
# maximum zstd takes it to 72 MB for a couple of extra minutes of build time.
COMPRESSZST=(zstd -c -z -q --ultra -22 --threads=0 -)

_tarball="signal-cli-${pkgver}-Linux-native.tar.gz"
_release="${url}/releases/download/v${pkgver}"

# The signature lives in the plain source array so upstream.sh can rewrite the
# x86_64 checksum array whole without touching the SKIP that belongs to it.
source=("${_tarball}.asc::${_release}/${_tarball}.asc")
source_x86_64=("${_tarball}::${_release}/${_tarball}")
sha256sums=('SKIP')
sha256sums_x86_64=('0fe065294adcf35df4c249b635d0ce57de7765d4fec660bffaa2e7f0549d4e5f')
validpgpkeys=('FA10826A74907F9EC6BBB7FC2BA2CD21B5B09570') # AsamK <asamk@gmx.de>

package() {
  install -Dm755 signal-cli "${pkgdir}/usr/bin/signal-cli"
}
