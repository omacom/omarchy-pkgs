# Apply the CPU PD hold udev rule immediately, no reboot (the hold is
# packaged with omarchy-mlx; see overlay/mlx/backend/omarchy/cpu_pd_hold.h
# in joshuaswarren/omarchy-mlx). On package removal the device node keeps the
# applied permissions until the next reboot — standard udev behavior,
# harmless (0660 root:video).
post_install() {
  command -v udevadm >/dev/null 2>&1 || return 0
  udevadm control --reload || true
  udevadm trigger --subsystem-match=misc --sysname-match=cpu_dma_latency || true
  udevadm settle || true
}

post_upgrade() {
  post_install "$@"
}
