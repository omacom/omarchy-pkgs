{
  "source": "local",
  "channels": [
    "edge"
  ],
  "min_release_age": "24h",
  "rebuild_on": [
    "llvm"
  ],
  "upstream": {
    "watch": {
      "github": "joshuaswarren/omarchy-mlx",
      "pattern": "v(?P<version>[0-9]+(?:\\.[0-9]+)*)"
    }
  },
  "rebuilt_against": {
    "aarch64": {
      "llvm": "23.1.1-1"
    }
  }
}
