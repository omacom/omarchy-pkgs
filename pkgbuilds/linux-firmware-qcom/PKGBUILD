# Maintainer: Birk Skyum <birk.skyum@pm.me>

# Arch Linux ARM's linux-firmware-qcom 20261019, with three upstream commits
# that landed after that release, carried the way Arch's own recipe carries
# firmware between releases (_backports):
#
# - f5b443a8: the Lenovo Yoga Slim 7x's compute DSP. The release has an older
#   qccdsp8380.mbn and no cdsp_dtbs.elf, so the DSP only starts with a copy
#   from Windows.
# - 362566e7: the ThinkPad T14s Gen 6's updated compute DSP.
# - 466e500d: Qualcomm's AudioReach topology sync (v1.0.5). Without it the
#   Zenbook A14 X2, ThinkPad T14s Gen 7, Acer Swift 14, Medion SPRCHRGD 14 S1
#   and IdeaCentre Mini have no topology and get no sound card. The Surface
#   Pro 11's adds DisplayPort graphs to the speaker and microphone ones
#   surface-pro-11-support builds, and the Zenbook A16's is the CRD topology
#   asus-zenbook-a16-audio linked.
#
# Between the release and these commits no other Qualcomm firmware changed.
# Only this split package is built; the others stay Arch Linux ARM's. Drop it
# once Arch Linux ARM's linux-firmware is a release from 2026-11-04 or later:
# its version is higher, so it takes over on the next update.

pkgname=linux-firmware-qcom
_tag=20261019
_commit=a2dcb924f0897368b0b4f305cbf9808cdda90ce0
pkgver=20261019
pkgrel=1.1
pkgdesc="Firmware files for Linux - Firmware for Qualcomm SoCs, with the Snapdragon X laptop firmware upstream added after $_tag"
url="https://gitlab.com/kernel-firmware/linux-firmware"
arch=('aarch64')
license=(LicenseRef-WHENCE BSD-3-Clause LicenseRef-qcom)
depends=(linux-firmware-atheros linux-firmware-whence)
makedepends=(git parallel python rdfind)
options=(!debug !strip)
source=("linux-firmware::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

_backports=(
  f5b443a84fcb2728196f7ec0f872ed5d6d416bf0 # qcom:x1e80100: Support for Lenovo Yoga Slim7 Snapdragon platform CDSP
  362566e7dce46cfc178ee12d0891ca0b78ad349a # qcom: Update the ThinkPad T14s G6 CDSP
  466e500db134efb2090d52b9b6b1104ce43e8ed2 # linux-firmware: qcom: sync audioreach firmwares from v1.0.5 build
)

prepare() {
  cd linux-firmware

  local c
  for c in "${_backports[@]}"; do
    echo "Backporting $(git log --oneline -1 "$c")"
    git cherry-pick -n "$c"
  done
}

package() {
  local fw="$srcdir/fw" dest="$pkgdir/usr/lib/firmware"

  # As Arch Linux ARM's recipe does: install everything, keep the paths its
  # qcom split takes, then turn duplicates into links.
  make -C linux-firmware FIRMWAREDIR="$fw" install
  install -d "$dest"
  mv "$fw"/qcom "$fw"/a300_* "$dest"/
  make -C linux-firmware FIRMWAREDIR="$dest" dedup

  install -Dm644 linux-firmware/LICENSES/{NOTICE.qcom,LICENSE.qcom*,LICENSE.dell} \
    -t "$pkgdir/usr/share/licenses/$pkgname"
}
