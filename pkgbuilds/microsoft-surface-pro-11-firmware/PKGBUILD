# Maintainer: Birk Skyum <birk.skyum@pm.me>
#
# Audio DSP, compute DSP and GPU firmware for the Microsoft Surface Pro 11th Edition. The firmware
# only runs if it is signed for this board by Microsoft, so linux-firmware cannot carry it until
# the OEM submits it. The OEM ships it in its Windows driver download, which this recipe unpacks
# without running. The files are installed unmodified, under the names the device tree requests,
# and checked against the SHA-256 each was matched to.

pkgname=microsoft-surface-pro-11-firmware
pkgver=20261102
pkgrel=1
pkgdesc='Audio DSP, compute DSP and GPU firmware for the Microsoft Surface Pro 11th Edition'
arch=('aarch64')
url='https://www.microsoft.com/en-us/download/details.aspx?id=106119'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1e80100-microsoft-denali' 'qcom-firmware-x1e80100-microsoft')
conflicts=('microsoft-surface-laptop-7-firmware')
makedepends=('7zip' 'msitools')
options=('!strip' '!debug')
source=(
  'microsoft-surfacepro11.msi::https://download.microsoft.com/download/92821b24-203a-4ce5-9a3a-5df3160a2fe3/SurfacePro11_ARM_Win11_26100_26.094.41119.0.msi'
)
noextract=('microsoft-surfacepro11.msi')
sha256sums=('8b299016027a4a87f50cf168f69ca1fb8dedc9a0612fcd6cff89b9bc64135ec2')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'microsoft-surfacepro11.msi' 'microsoft-surfacepro11' msi
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'microsoft-surfacepro11/SurfaceUpdate/proextadsp/adsp_dtbs.elf' "$fw"/'qcom/x1e80100/microsoft/Denali/adsp_dtb.mbn'
  install -Dm644 'microsoft-surfacepro11/SurfaceUpdate/proextadsp/adspr.jsn' "$fw"/'qcom/x1e80100/microsoft/Denali/adspr.jsn'
  install -Dm644 'microsoft-surfacepro11/SurfaceUpdate/proextadsp/adsps.jsn' "$fw"/'qcom/x1e80100/microsoft/Denali/adsps.jsn'
  install -Dm644 'microsoft-surfacepro11/SurfaceUpdate/proextadsp/adspua.jsn' "$fw"/'qcom/x1e80100/microsoft/Denali/adspua.jsn'
  install -Dm644 'microsoft-surfacepro11/SurfaceUpdate/proextadsp/battmgr.jsn' "$fw"/'qcom/x1e80100/microsoft/Denali/battmgr.jsn'
  install -Dm644 'microsoft-surfacepro11/SurfaceUpdate/qcnspmcdmextcdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1e80100/microsoft/Denali/cdsp_dtb.mbn'
  install -Dm644 'microsoft-surfacepro11/SurfaceUpdate/qcnspmcdmextcdsp8380/cdspr.jsn' "$fw"/'qcom/x1e80100/microsoft/Denali/cdspr.jsn'
  install -Dm644 'microsoft-surfacepro11/SurfaceUpdate/proextadsp/qcadsp8380.mbn' "$fw"/'qcom/x1e80100/microsoft/Denali/qcadsp8380.mbn'
  install -Dm644 'microsoft-surfacepro11/SurfaceUpdate/qcnspmcdmextcdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1e80100/microsoft/Denali/qccdsp8380.mbn'
  install -Dm644 'microsoft-surfacepro11/SurfaceUpdate/qcdx/qcdxkmsuc8380.mbn' "$fw"/'qcom/x1e80100/microsoft/qcdxkmsuc8380.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
544bd795cb06cf8dee8119ede2a667f01066b2f1b9e4348f1772d080e2026ff4  qcom/x1e80100/microsoft/Denali/adsp_dtb.mbn
e9ba7199626b0c03f2ec02822d744f678ad567fe0625a28fe5f5908b7281e9db  qcom/x1e80100/microsoft/Denali/adspr.jsn
19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e  qcom/x1e80100/microsoft/Denali/adsps.jsn
d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d  qcom/x1e80100/microsoft/Denali/adspua.jsn
b8aad1d149128f414eb1fd6fcbb6e0a5b7dabcd2cba001599e1ce9a0e2e291a4  qcom/x1e80100/microsoft/Denali/battmgr.jsn
93941f040da14b8305d39579686d886706d22954a538b03da676c1aaa191797f  qcom/x1e80100/microsoft/Denali/cdsp_dtb.mbn
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x1e80100/microsoft/Denali/cdspr.jsn
921870a839ee2aba647b04598d62ed96f3d2d5dfbb2499fc842f9a6ff0e0da13  qcom/x1e80100/microsoft/Denali/qcadsp8380.mbn
4a67a03367f2eff2f8a0e867ca25d2bf2fcd5aee3e41e2c9f436c804e257c789  qcom/x1e80100/microsoft/Denali/qccdsp8380.mbn
c89711a60240f29cb5df13f7b904642b78b7d9d6e614473751f7bf4049fab137  qcom/x1e80100/microsoft/qcdxkmsuc8380.mbn
SUMS
  )
}
