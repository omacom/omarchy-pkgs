# Maintainer: Tempest <gitchaostempest@proton.me>
pkgname=omaflow-system
pkgver=1.2.0
pkgrel=1
pkgdesc='Privileged helper and fan2go unit for the OmaFlow bar plugin'
arch=('any')
url='https://github.com/tempest-chaoscreator/OmaFlow'
license=('MIT')
depends=('python')
optdepends=(
  'fan2go: chassis fan service'
  'liquidctl: USB AIO pump and LCD'
)
install=omaflow-system.install
options=('!debug')
source=(
  'omaflow-helper.py'
  'org.omarchy.omaflow.helper.policy'
  '50-omaflow.rules'
  'fan2go.service'
  'fan2go.yaml'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 omaflow-helper.py "$pkgdir/usr/lib/omaflow/omaflow-helper"
  install -Dm644 org.omarchy.omaflow.helper.policy \
    "$pkgdir/usr/share/polkit-1/actions/org.omarchy.omaflow.helper.policy"
  install -Dm644 50-omaflow.rules \
    "$pkgdir/usr/share/polkit-1/rules.d/50-omaflow.rules"
  install -Dm644 fan2go.service "$pkgdir/usr/share/omaflow/fan2go.service"
  install -Dm644 fan2go.yaml "$pkgdir/usr/share/omaflow/fan2go.yaml"
}
