post_install() {
  install -d -m 0700 /var/lib/omaflow
  install -d -m 0755 /etc/fan2go
  if [ ! -e /etc/fan2go/fan2go.yaml ]; then
    install -m 0644 /usr/share/omaflow/fan2go.yaml /etc/fan2go/fan2go.yaml
  fi
  install -m 0644 /usr/share/omaflow/fan2go.service /etc/systemd/system/fan2go.service
  systemctl daemon-reload
  if [ -x /usr/bin/fan2go ]; then
    systemctl enable --now fan2go.service || true
  else
    systemctl disable --now fan2go.service || true
  fi
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl disable --now fan2go.service || true
  rm -f /etc/systemd/system/fan2go.service
}

post_remove() {
  systemctl daemon-reload || true
}
