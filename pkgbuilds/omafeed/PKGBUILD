# Maintainer: pch <https://github.com/pch>

pkgname=omafeed
pkgver=0.2.4
pkgrel=1
pkgdesc='A native Rust RSS reader for Linux and Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/pch/omafeed'
license=('MIT')
depends=('glib2' 'glibc' 'gtk4' 'hicolor-icon-theme' 'libadwaita' 'libgcc' 'webkitgtk-6.0')
makedepends=('cargo' 'pkgconf')
# makepkg's LTO flags turn bundled C code (SQLite, ring) into GCC bytecode rustc
# cannot link; the release profile already strips, so a debug package would be empty.
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('80b9bb98402cc8035718ed258b6154bea9318f0d1014d494d091988e4edb08cc')

prepare() {
  cd "$pkgname-$pkgver"

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"

  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"

  export CARGO_TARGET_DIR=target
  cargo test --frozen --workspace
}

package() {
  cd "$pkgname-$pkgver"

  make install DESTDIR="$pkgdir" PREFIX=/usr PKGNAME="$pkgname"
}
