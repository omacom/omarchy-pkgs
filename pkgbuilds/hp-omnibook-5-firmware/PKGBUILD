# Audio DSP, compute DSP and GPU firmware for the HP OmniBook 5 14 and 16. The firmware only runs
# if it is signed for this board by HP, so linux-firmware cannot carry it until the OEM submits
# it. The OEM ships it in its Windows driver download, which this recipe unpacks without running.
# The files are installed unmodified, under the names the device tree requests, and checked
# against the SHA-256 each was matched to.
#
# Generated from https://arewearmyet.com/firmware-sources.json by bin/snapdragon-firmware-recipes;
# change the table, not this file.

pkgname=hp-omnibook-5-firmware
pkgver=20261102
pkgrel=1
pkgdesc='Audio DSP, compute DSP and GPU firmware for the HP OmniBook 5 14 and 16'
arch=('aarch64')
url='https://ftp.hp.com/pub/softpaq/sp173501-174000/sp173598.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1p42100-hp-omnibook-5')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'hp-sp173598.exe::https://ftp.hp.com/pub/softpaq/sp173501-174000/sp173598.exe'
)
noextract=('hp-sp173598.exe')
sha256sums=('920af92f223626a568d0c66ef5c0439efb5876937a515d9acf74dba35b1a2dd8')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'hp-sp173598.exe' 'hp-sp173598' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'hp-sp173598/src/OSPart/qcsubsys_ext_adsp8380_DUA_Efuse_WHQL/adsp_dtbs.elf' "$fw"/'qcom/x1p42100/hp/omnibook-5/adsp_dtbs.elf'
  install -Dm644 'hp-sp173598/src/OSPart/qcsubsys_ext_adsp8380_DUA_Efuse_WHQL/adspr.jsn' "$fw"/'qcom/x1p42100/hp/omnibook-5/adspr.jsn'
  install -Dm644 'hp-sp173598/src/OSPart/qcsubsys_ext_adsp8380_DUA_Efuse_WHQL/adsps.jsn' "$fw"/'qcom/x1p42100/hp/omnibook-5/adsps.jsn'
  install -Dm644 'hp-sp173598/src/OSPart/qcsubsys_ext_adsp8380_DUA_Efuse_WHQL/adspua.jsn' "$fw"/'qcom/x1p42100/hp/omnibook-5/adspua.jsn'
  install -Dm644 'hp-sp173598/src/OSPart/qcsubsys_ext_adsp8380_DUA_Efuse_WHQL/battmgr.jsn' "$fw"/'qcom/x1p42100/hp/omnibook-5/battmgr.jsn'
  install -Dm644 'hp-sp173598/src/OSPart/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1p42100/hp/omnibook-5/cdsp_dtbs.elf'
