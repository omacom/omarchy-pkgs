# Maintainer: The Omarchy Authors
pkgname=kilocode-cli
pkgver=7.8.36
pkgrel=1
pkgdesc="Kilo Code CLI, an open source terminal coding agent"
arch=('x86_64' 'aarch64')
url="https://kilo.ai/cli"
license=('MIT')
depends=('glibc')
optdepends=('git: repository integration and worktrees')
# The binary is a Bun executable with its JavaScript appended; stripping breaks it.
options=('!strip' '!debug')
source=('LICENSE')
# The baseline build runs on x86_64 CPUs without AVX2.
source_x86_64=("kilo-${pkgver}-x86_64.tar.gz::https://github.com/Kilo-Org/kilocode/releases/download/v${pkgver}/kilo-linux-x64-baseline.tar.gz")
source_aarch64=("kilo-${pkgver}-aarch64.tar.gz::https://github.com/Kilo-Org/kilocode/releases/download/v${pkgver}/kilo-linux-arm64.tar.gz")
noextract=("kilo-${pkgver}-${CARCH}.tar.gz")
sha256sums=('8a088af74e19c37e62906321b1072f593113058ed9eae507d899d41e6e5e5bb4')
sha256sums_x86_64=('930a3cadc01ab7b0bb163f6f28c41cf4b12f150aca16748b086119f23e2521e0')
sha256sums_aarch64=('7946f4f77d78ee3d0b8a7d906a577f5c94798fbd1a4c3141971d77ce7683eb7e')

package() {
  # Kilo reads its sandbox helpers, console and tree-sitter grammars from
  # beside the binary.
  local root="${pkgdir}/usr/lib/${pkgname}"
  install -dm755 "${root}" "${pkgdir}/usr/bin"
  bsdtar --no-same-owner -xf "kilo-${pkgver}-${CARCH}.tar.gz" -C "${root}"

  # pacman updates this install, so Kilo's own update check would only nag.
  cat >"${pkgdir}/usr/bin/kilo" <<'WRAPPER'
#!/bin/sh
export KILO_DISABLE_AUTOUPDATE=1
exec /usr/lib/kilocode-cli/kilo "$@"
WRAPPER
  chmod 755 "${pkgdir}/usr/bin/kilo"
  ln -s kilo "${pkgdir}/usr/bin/kilocode"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
