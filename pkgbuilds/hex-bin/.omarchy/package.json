{
  "source": "local",
  "min_release_age": "24h",
  "upstream": {
    "github": "anomalyco/hex",
    "digests": true,
    "latest_only": true,
    "assets": {
      "x86_64": "hex-{pkgver}-linux-x64",
      "aarch64": "hex-{pkgver}-linux-arm64"
    },
    "sources": {
      "any": [
        "https://raw.githubusercontent.com/anomalyco/hex/{tag}/packaging/hex.desktop",
        "https://raw.githubusercontent.com/anomalyco/hex/{tag}/packaging/hex.service",
        "https://raw.githubusercontent.com/anomalyco/hex/{tag}/LICENSE"
      ]
    }
  }
}
