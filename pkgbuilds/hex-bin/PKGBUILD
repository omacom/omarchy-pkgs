# Maintainer: ujo4eva <92157639+ujo4eva@users.noreply.github.com>

# The Hex voice dictation app by Anomaly, not extra/hex (the hex dump tool,
# which installs /usr/bin/hx), so it neither provides nor conflicts with it.
pkgname=hex-bin
_name=hex
pkgver=3.0.0
pkgrel=1
pkgdesc="Local voice dictation: hold a key, speak, and Hex types it (Linux beta)"
arch=('x86_64' 'aarch64')
url="https://github.com/anomalyco/hex"
license=('MIT')
# Linked: alsa-lib, gcc-libs, glibc, libxkbcommon, vulkan-icd-loader. Loaded at runtime:
# the X11/Wayland client libraries and OpenBLAS.
depends=('alsa-lib' 'curl' 'gcc-libs' 'glibc' 'libx11' 'libxcb' 'libxcursor'
         'libxi' 'libxkbcommon' 'libxkbcommon-x11' 'openblas' 'vulkan-icd-loader'
         'wayland')
optdepends=('wl-clipboard: paste on Wayland'
            'wtype: paste on Wayland'
            'vulkan-driver: GPU transcription'
            'wireplumber: mute output while dictating'
            'xdg-utils: open links from voice commands')
options=('!strip' '!debug')
source=("$_name-$pkgver.desktop::https://raw.githubusercontent.com/anomalyco/hex/v$pkgver/packaging/hex.desktop"
        "$_name-$pkgver.service::https://raw.githubusercontent.com/anomalyco/hex/v$pkgver/packaging/hex.service"
        "LICENSE-$pkgver::https://raw.githubusercontent.com/anomalyco/hex/v$pkgver/LICENSE")
source_x86_64=("$url/releases/download/v$pkgver/$_name-$pkgver-linux-x64")
source_aarch64=("$url/releases/download/v$pkgver/$_name-$pkgver-linux-arm64")
sha256sums=('3c84dd00777c58f8f59585d801181445cbf39f69bce8e75a4204eac1c7903def'
            '7b7f3baa337f53b46574e4ea16d98f45c066ddcfc9cfd13bc255f5d4ce628652'
            '0c267f186f600c6f4d9d229d1792861361f2c433cfb23054fece61f227006344')
sha256sums_x86_64=('5541eb3fdf971813ce72a9ada04f43ea09ebb90f9545fabca648adc9b4e3349c')
sha256sums_aarch64=('f43a7a3b4c6d432599f830aceaaae957b13b57bc60b6a6655a4d88ddd6a66d4a')

package() {
  local target=x64
  [[ $CARCH == aarch64 ]] && target=arm64
  install -Dm755 "$_name-$pkgver-linux-$target" "$pkgdir/usr/bin/$_name"
  sed "s|@HEX_BIN@|/usr/bin/$_name|g" "$_name-$pkgver.desktop" > hex.desktop
  install -Dm644 hex.desktop "$pkgdir/usr/share/applications/hex.desktop"
  install -Dm644 "$_name-$pkgver.service" "$pkgdir/usr/lib/systemd/user/hex.service"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
