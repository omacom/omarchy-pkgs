pkgname=omadesktop
pkgver=0.1.1
pkgrel=1
pkgdesc='Save and restore desktop layouts on Omarchy'
url='https://github.com/acrive82/omadesktop'
arch=('x86_64' 'aarch64')
license=('MIT')
options=('!debug')
depends=('grim' 'hicolor-icon-theme' 'hyprland>=0.55' 'python' 'qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('113a8ebbfa3639f76723138194f5e22227e2d15412818038ec9074e976cce2cf')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  PYTHONDONTWRITEBYTECODE=1 OMADESKTOP_BIN="$PWD/build/omadesktop" python3 -m unittest discover -s tests -v
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 build/omadesktop "$pkgdir/usr/bin/omadesktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/omadesktop.desktop "$pkgdir/usr/share/applications/omadesktop.desktop"
  install -Dm644 pkgbuild/omadesktop.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omadesktop.svg"
}
