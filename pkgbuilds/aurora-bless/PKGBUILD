pkgname=aurora-bless
pkgver=0.4.4.aurora2
pkgrel=1
pkgdesc='Aurora Apple Silicon startup-volume selector with Neo NVRAM support'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/aurora-silicon/aurora-bless'
license=('MIT')
_commit=727b5895db67bd40aa66c41485c6a8f482d2a917
provides=("asahi-bless=$pkgver")
conflicts=('asahi-bless')
makedepends=('git' 'rust' 'cargo')
source=("aurora-bless::git+$url.git#commit=$_commit")
sha256sums=('SKIP')
build() {
  cd aurora-bless
  cargo build --locked --release -p asahi-bless ${CARGO_TARGET:+--target "$CARGO_TARGET"}
}
check() {
  cd aurora-bless
  cargo test --locked -p asahi-bless -p apple-nvram -p asahi-nvram
}
package() {
  local bin=aurora-bless/target/release/asahi-bless
  if [[ -n ${CARGO_TARGET:-} ]]; then bin=aurora-bless/target/$CARGO_TARGET/release/asahi-bless; fi
  install -Dm755 "$bin" "$pkgdir/usr/bin/aurora-bless"
  ln -s aurora-bless "$pkgdir/usr/bin/asahi-bless"
  install -Dm644 aurora-bless/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
