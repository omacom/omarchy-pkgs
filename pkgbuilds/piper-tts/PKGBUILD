# Maintainer: Matt Wolfgang <mattwolfgang@gmail.com>

pkgname=piper-tts
_pkgname=piper1-gpl
pkgver=1.8.0
pkgrel=1
# The espeak-ng commit piper1-gpl's CMakeLists.txt pins for its phonemizer.
_espeak_commit=724808c5a83f9ef95fdd0db886ba7ba537ff224a
pkgdesc='Fast and local neural text-to-speech engine'
arch=('x86_64')
url='https://github.com/OHF-Voice/piper1-gpl'
license=('GPL-3.0-or-later')
# Both install a Python module named piper; the GTK mouse tool is the other.
conflicts=('piper')
depends=('glibc' 'python' 'python-numpy' 'python-onnxruntime' 'python-pathvalidate')
optdepends=(
  'python-flask: HTTP server'
  'python-onnx: patch voices with alignment'
)
makedepends=('git' 'python-setuptools' 'python-build' 'python-installer' 'python-wheel' 'python-scikit-build' 'cmake' 'ninja')
source=("git+https://github.com/OHF-Voice/piper1-gpl.git#tag=v$pkgver"
        "git+https://github.com/espeak-ng/espeak-ng.git#commit=$_espeak_commit")
sha256sums=('70d062c1e80b0967b311f53e6036d9c78e146a6065d7444f3cec4a2fe85d2ea5'
            'SKIP')

prepare() {
  cd "$_pkgname"
  # cmake and ninja come from the system, not pip.
  sed -i 's/"cmake", "ninja"//' pyproject.toml
  # Build espeak-ng from the pinned source above instead of cloning it
  # during the build.
  sed -i "s|GIT_REPOSITORY https://github.com/espeak-ng/espeak-ng.git|GIT_REPOSITORY $srcdir/espeak-ng|" CMakeLists.txt
  grep -q "GIT_REPOSITORY $srcdir/espeak-ng" CMakeLists.txt
}

build() {
  cd "$_pkgname"
  python -m build --wheel --no-isolation
}

package() {
  cd "$_pkgname"
  python -m installer --destdir="$pkgdir" dist/*.whl

  # Arch already has a GTK application called piper.
  mv "$pkgdir/usr/bin/piper" "$pkgdir/usr/bin/piper-tts"

  rm -f "$pkgdir/usr/COPYING"
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
