# Maintainer: Cem Berke Arslan <hello@exposureai.org>
# Repackages the official Elchi .deb for Arch / Omarchy. Source of truth:
# https://github.com/0daycloud/elchi/tree/main/omarchy
pkgname=elchi
pkgver=1.0.3
pkgrel=1
pkgdesc="On-device Turkish + English speech-to-text dictation (Duyu-small, CPU)"
arch=('x86_64')
url="https://github.com/0daycloud/elchi"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'gtk-layer-shell' 'libayatana-appindicator'
         'openblas' 'vulkan-icd-loader' 'alsa-lib' 'openssl'
         'glib2' 'gdk-pixbuf2' 'cairo' 'dbus' 'libsoup3' 'gcc-libs' 'glibc'
         'hicolor-icon-theme' 'wtype' 'wl-clipboard' 'which' 'python')
optdepends=('pipewire-alsa: microphone capture on PipeWire (Omarchy default)'
            'ydotool: typing fallback when wtype is unavailable'
            'dotool: typing fallback with keyboard-layout support')
install=elchi.install
options=('!debug')
source=("Elchi_${pkgver}_amd64.deb::https://speech.patientdesk.ai/downloads/elchi/${pkgver}/Elchi_${pkgver}_amd64.deb"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/0daycloud/elchi/v${pkgver}/LICENSE"
        "elchi-omarchy-setup")
noextract=("Elchi_${pkgver}_amd64.deb")
sha256sums=('5276f454ee39502bfbd062947c76ed0bf9af414d8ec01f2e1c143fa7bbb000c6'
            'f455d16cc41bd3880a4a1b66bc8247b2cc62d7e6ba186aedbfc7ee2c64f35c7a'
            '36b402826688da3eee914c4da7507c1f4cf8bbc68ebeaeeda3ed469b258189f3')

package() {
  # The .deb already has the Arch-compatible layout: /usr/bin/elchi with
  # RUNPATH $ORIGIN/../lib/Elchi, bundled ONNX Runtime + ggml in /usr/lib/Elchi.
  bsdtar -xOf "$srcdir/Elchi_${pkgver}_amd64.deb" data.tar.gz | bsdtar -xf - -C "$pkgdir"
  sed -i 's/^Categories=$/Categories=Utility;Accessibility;/' "$pkgdir/usr/share/applications/Elchi.desktop"
  install -Dm755 "$srcdir/elchi-omarchy-setup" "$pkgdir/usr/bin/elchi-omarchy-setup"
  install -Dm644 "$srcdir/LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # pacman owns updates: switch off the in-app self-updater for every session
  # (systemd user environment.d, the same mechanism Omarchy uses for fcitx).
  echo 'HANDY_DISABLE_UPDATER=1' | install -Dm644 /dev/stdin "$pkgdir/usr/lib/environment.d/50-elchi.conf"
}
