# Maintainer: spuder <https://github.com/spuder>

pkgname=monocode-bin
_name=monocode
pkgver=0.11.0
pkgrel=1
pkgdesc="A GUI for your coding agents: Claude Code, Codex, Cursor, OpenCode and more (binary release)"
arch=('x86_64')
url="https://github.com/hardbeat920/monocode"
license=('MIT')
# The upstream .deb is a Tauri app linked against the system WebKitGTK, unlike
# the AppImage, which bundles Ubuntu 22.04 libraries (hardbeat920/monocode#274).
depends=('cairo' 'dbus' 'gdk-pixbuf2' 'glib2' 'glibc' 'gtk3' 'hicolor-icon-theme'
         'libgcc' 'libsoup3' 'webkit2gtk-4.1')
provides=("$_name")
conflicts=("$_name")
options=('!strip' '!debug')
source=("https://raw.githubusercontent.com/hardbeat920/monocode/v$pkgver/LICENSE")
source_x86_64=("$url/releases/download/v$pkgver/MonoCode_${pkgver}_amd64.deb")
noextract=("MonoCode_${pkgver}_amd64.deb")
sha256sums=('3333be61cff8f46a68a883978fff0a6a2a993c3f434396c54482413ce9f63416')
sha256sums_x86_64=('a3cb4bbbae7b78274e836061f6120152e398162aeb3ad49a7fc82415c39f5bea')

package() {
  bsdtar -xOf "MonoCode_${pkgver}_amd64.deb" data.tar.gz | bsdtar -xf - -C "$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
