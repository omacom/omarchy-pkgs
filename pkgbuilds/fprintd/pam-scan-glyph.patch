diff --git i/pam/pam_fprintd.c w/pam/pam_fprintd.c
index 95c430c..447ea63 100644
--- i/pam/pam_fprintd.c
+++ w/pam/pam_fprintd.c
@@ -131,6 +131,22 @@ send_msg (pam_handle_t *pamh, const char *msg, int style)
   return pc->conv (1, &msgp, &resp, pc->appdata_ptr) == PAM_SUCCESS;
 }
 
+/* Keep the translated instruction intact and mark requests for a scan. */
+static void
+send_scan_msg (pam_handle_t *pamh, const char *msg, int style)
+{
+  char *prompt;
+
+  if (asprintf (&prompt, "󰈷  %s", msg) < 0)
+    {
+      send_msg (pamh, msg, style);
+      return;
+    }
+
+  send_msg (pamh, prompt, style);
+  free (prompt);
+}
+
 static bool
 send_info_msg (pam_handle_t *pamh, const char *msg)
 {
@@ -286,7 +302,10 @@ verify_result (sd_bus_message *m,
       data->result = strdup ("Protocol error with fprintd!");
       return 0;
     }
-  send_err_msg (data->pamh, msg);
+  if (strcmp (result, "verify-unknown-error") == 0)
+    send_err_msg (data->pamh, msg);
+  else
+    send_scan_msg (data->pamh, msg, PAM_ERROR_MSG);
 
   return 0;
 }
@@ -321,7 +340,7 @@ verify_finger_selected (sd_bus_message *m,
     }
   if (debug)
     pam_syslog (data->pamh, LOG_DEBUG, "verify_finger_selected %s", msg);
-  send_info_msg (data->pamh, msg);
+  send_scan_msg (data->pamh, msg, PAM_TEXT_INFO);
 
   return 0;
 }
