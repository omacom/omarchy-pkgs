+/* The driver replaced its persistent data (e.g. after pairing): save it now,
+ * so it is not lost if fprintd doesn't get to shut down cleanly. */
+static void
+on_persistent_data_changed (FprintDevice *rdev,
+                            GParamSpec   *spec,
+                            FpDevice     *device)
+{
+  g_autoptr(GError) error = NULL;
+
+  if (!store.persistent_data_save (device, &error))
+    g_warning ("Failed to save persistent data: %s", error->message);
+}
+
 static void
 fprint_device_constructed (GObject *object)
 {
+  g_autoptr(GError) error = NULL;
   FprintDevice *rdev = FPRINT_DEVICE (object);
   FprintDBusDevice *dbus_dev = FPRINT_DBUS_DEVICE (rdev);
   FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
@@ -400,6 +418,15 @@ fprint_device_constructed (GObject *object)
                            rdev, G_CONNECT_SWAPPED);
   on_temperature_changed (rdev, NULL, priv->dev);
 
+  if (!store.persistent_data_load (priv->dev, &error) &&
+      !g_error_matches (error, G_FILE_ERROR, G_FILE_ERROR_NOENT))
+    g_warning ("Failed to load persistent data: %s", error->message);
+
+  /* Connected after loading, so only data the driver sets later is saved */
+  g_signal_connect_object (priv->dev, "notify::fpi-persistent-data",
+                           G_CALLBACK (on_persistent_data_changed),
+                           rdev, G_CONNECT_SWAPPED);
+
   G_OBJECT_CLASS (fprint_device_parent_class)->constructed (object);
 }
 
