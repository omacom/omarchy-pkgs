# Maintainer: Omarchy
# Based on the Arch fprintd package by Jan Alexander Steffens (heftig) and
# Nikolay Rysev.
#
# Arch's fprintd plus one patch, fprintd-persistent-data.patch, from
# https://github.com/vojtapl/synaTudorMiS (libfprint/fprintd-load-store-
# persistent-data-from-device.patch). It loads a driver's persistent data when
# a reader is found and saves it when the driver changes it and on shutdown,
# under /var/lib/fprint/0-persistent/<driver>/<device-id>.
#
# The synatlsmoc driver in libfprint-git (Synaptics Tudor match-in-sensor
# readers such as 06cb:00c9) pairs with the reader over TLS the first time it
# is used. Stock fprintd drops those keys on every restart, so the driver pairs
# again, the reader no longer knows the enrolled fingers, and fprintd deletes
# them ("Sensor is in TLS session but host is not"). Drivers without persistent
# data are unaffected.
#
# It calls fp_device_get_persistent_data(), which only this repository's
# libfprint-git provides, so it needs that package. When Arch updates fprintd,
# bump pkgver and check that the patch still applies.

pkgname=fprintd
pkgver=1.94.5
pkgrel=2
# Outranks Arch's fprintd, whatever pkgrel it reaches.
epoch=1
pkgdesc="D-Bus service to access fingerprint readers (with persistent driver data for Synaptics Tudor readers)"
url="https://fprint.freedesktop.org/"
arch=(x86_64)
license=(GPL-2.0-or-later)
depends=(
  dbus
  glib2
  glibc
  libgcc
  'libfprint-git>=1:1.94.100.r10.g6f9479c-6'
  pam
  polkit
  systemd
  systemd-libs
)
makedepends=(
  git
  glib2-devel
  meson
  python-cairo
  python-dbus
  python-packaging
)
provides=("fprintd=$pkgver")
conflicts=(fprintd)
groups=(fprint)
source=(
  "git+https://gitlab.freedesktop.org/libfprint/fprintd.git#tag=v$pkgver"
  fprintd-persistent-data.patch
)
b2sums=('SKIP'
        'SKIP')

prepare() {
  cd fprintd

  # Fix tests (as in Arch's package)
  git cherry-pick -n ec2a995c36f0757e1f5c695a80d89f41d2fa03bb

  git apply "$srcdir/fprintd-persistent-data.patch"
}

build() {
  local meson_options=(
    -D gtk_doc=false
    -D pam_modules_dir=/usr/lib/security
  )

  arch-meson fprintd build "${meson_options[@]}"
  meson compile -C build
}

# No check(): Arch's needs pam_wrapper and python-dbusmock, and the patch adds
# no test of its own.

package() {
  depends+=(libfprint-2.so)

  meson install -C build --destdir "$pkgdir"
}

