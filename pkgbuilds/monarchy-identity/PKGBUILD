# Maintainer: Monarchy contributors
pkgbase=monarchy-identity
pkgname=(monarchy-identity)
pkgver=0.1.0
pkgrel=1
pkgdesc='Directory sign-in for Omarchy'
arch=(any)
url='https://docs.monarchy.run/monarchy-identity/'
license=('MIT')
options=(!strip)

# The release tarball. Omarchy's package repo (omacom/omarchy-pkgs) carries this recipe with the real checksum; it can't
# be filled in here, because this file is inside the tarball it would checksum. Builds from a checkout:
# packaging/build-local.sh (it packs the working tree under this name, and makepkg uses that instead of downloading).
source=("$pkgbase-$pkgver.tar.gz::https://github.com/blatessa/monarchy-identity/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('faae9a08b98be2bbb2a709bf655a2c9b5f6b9dd36e0ae8dbf86f8bb20e2faf3b')

package_monarchy-identity() {
  local _root="$srcdir/$pkgbase-$pkgver"
  install=monarchy-identity.install
  depends=(bash python sssd samba krb5 hyprland foot gum)   # the last three: the change-password screen
  backup=(etc/monarchy-identity/config.toml)

  install -Dm755 "$_root/bin/monarchy-identity" "$pkgdir/usr/bin/monarchy-identity"

  install -d "$pkgdir/usr/share/monarchy-identity/providers"
  cp -a "$_root/providers/." "$pkgdir/usr/share/monarchy-identity/providers/"
  install -d "$pkgdir/usr/share/monarchy-identity/lib"
  install -m755 "$_root/lib/pamedit.py" "$pkgdir/usr/share/monarchy-identity/lib/"
  install -m644 "$_root/lib/common.sh" "$_root/lib/password-change.lua" "$pkgdir/usr/share/monarchy-identity/lib/"
  install -m755 "$_root/lib/password-expired" "$_root/lib/sddm-session" "$pkgdir/usr/share/monarchy-identity/lib/"

  install -d "$pkgdir/usr/share/monarchy-identity/hooks/post-update.d"
  install -m755 "$_root/hooks/reassert.sh" "$pkgdir/usr/share/monarchy-identity/hooks/reassert.sh"
  install -m755 "$_root/hooks/post-update.d/"* "$pkgdir/usr/share/monarchy-identity/hooks/post-update.d/"

  install -Dm644 "$_root/packaging/monarchy-identity.hook" \
    "$pkgdir/usr/share/libalpm/hooks/monarchy-identity.hook"
  install -d "$pkgdir/usr/share/sddm/themes/monarchy-identity"
  install -m644 "$_root/sddm-theme/monarchy-identity/"{Main.qml,metadata.desktop,theme.conf} "$pkgdir/usr/share/sddm/themes/monarchy-identity/"
  # assets come from Omarchy's own theme so the look stays in sync (dangling, harmlessly, on non-Omarchy systems)
  for a in logo lock lock-failed entry entry-failed bullet; do
    ln -s "../omarchy/$a.png" "$pkgdir/usr/share/sddm/themes/monarchy-identity/$a.png"
  done
  install -Dm644 "$_root/packaging/config.toml" "$pkgdir/etc/monarchy-identity/config.toml"
  install -dm755 "$pkgdir/var/lib/monarchy-identity"   # state.toml, written by enroll
  # documentation sources (the published site is built from these with mkdocs); images are referenced relatively
  install -d "$pkgdir/usr/share/doc/monarchy-identity"
  cp -a "$_root/docs/." "$pkgdir/usr/share/doc/monarchy-identity/"
  find "$pkgdir/usr/share/doc/monarchy-identity" -type d -exec chmod 755 {} + -o -type f -exec chmod 644 {} +
  install -Dm644 "$_root/LICENSE" "$pkgdir/usr/share/licenses/monarchy-identity/LICENSE"
}
