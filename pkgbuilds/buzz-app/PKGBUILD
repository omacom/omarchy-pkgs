pkgname=buzz-app
pkgver=1.0.2
pkgrel=1
pkgdesc='Buzz desktop app: workspace for humans and AI agents (block/buzz-app)'
arch=('x86_64') # upstream builds and ships Linux for x86_64 only
url='https://github.com/block/buzz-app'
license=('Apache-2.0')

depends=(
  'cairo'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gst-plugins-good'
  'gtk3'
  'hicolor-icon-theme'
  'libgcc'
  'libsoup3'
  'webkit2gtk-4.1'
)
makedepends=('cargo' 'cmake' 'nodejs' 'pnpm' 'pkgconf')
# Arch's GCC LTO objects cannot be consumed when crates compile bundled C
# libraries (secp256k1-sys among them).
options=('!lto')

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('17a02ffad4eda00bea8346dff1b06beee2d95494cd5411eecb68323ef1b4ec7c')

build() {
  cd "$pkgname-$pkgver"

  # pnpm 11 reads pnpm_config_*, no longer npm_config_*.
  export pnpm_config_store_dir="$srcdir/pnpm-store"
  # scripts/build-buzz-cli.mjs otherwise builds in the target/ of whatever git
  # checkout encloses the sources.
  export CARGO_TARGET_DIR="$PWD/target"

  # Upstream's releases pair the built-in sign-in server with this key-backup
  # service (env: in desktop-build.yml); without it the app has no backup to
  # opt into. Fail an update rather than ship values upstream has moved.
  export BUZZ_NSEC_BACKUP_SERVICE_URL='https://app.builderlab.xyz/api/goose'
  export BUZZ_NSEC_BACKUP_NAMESPACE='backup/bb-public/production'
  local name
  for name in BUZZ_NSEC_BACKUP_SERVICE_URL BUZZ_NSEC_BACKUP_NAMESPACE; do
    grep -q "^  $name: .*'${!name}'" .github/workflows/desktop-build.yml
  done

  pnpm install --frozen-lockfile

  # Upstream's own version stamping: RELEASE_VERSION takes the tag's version
  # instead of tauri.conf.json's, and the script appends to GITHUB_ENV and
  # GITHUB_OUTPUT. Leaving BUZZ_UPDATER_PUBLIC_KEY and BUZZ_UPDATER_ENDPOINT
  # unset compiles the self-updater out: pacman owns updates.
  RUNNER_TEMP="$srcdir" RELEASE_VERSION="$pkgver" \
    GITHUB_ENV="$srcdir/github-env" GITHUB_OUTPUT="$srcdir/github-output" \
    node scripts/candidate-version.mjs

  # Upstream's Linux release build, deb only. Its beforeBuildCommand stages the
  # goose-acp release pinned in runtime/goose-acp.json and builds the other
  # two bundled helpers.
  pnpm tauri build --ci --no-sign --bundles deb --config "$srcdir/candidate.json" -- --locked
}

package() {
  cd "$pkgname-$pkgver"

  # Upstream's own deb layout, which the app finds its bundled helpers in:
  # /usr/bin/Buzz and /usr/lib/Buzz Foundation/bin, with the desktop entry and
  # icons. Two steps because makepkg does not set pipefail.
  local debs=(target/release/bundle/deb/*.deb)
  (( ${#debs[@]} == 1 ))
  bsdtar -xf "${debs[0]}" -C "$srcdir" data.tar.gz
  bsdtar -xf "$srcdir/data.tar.gz" --no-same-owner -C "$pkgdir"

  install -Dm644 LICENSE NOTICE.md -t "$pkgdir/usr/share/licenses/$pkgname"
}
