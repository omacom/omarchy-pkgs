# Maintainer: Netmojo Systems <56850867+netmojo@users.noreply.github.com>
#
# Omdrop (AirDrop for Omarchy): the omdrop-plugin bar widget and its `omdrop`
# command, with omdrop-core, the Rust programs they run, in one package. The
# radio comes from a separate backend package: brcmfmac-awdl-dkms on Apple
# Silicon Macs, omdrop-owl on other Wi-Fi cards.
#
# The plugin goes to /usr/share/omdrop, and `omdrop setup` links it into each
# user's ~/.config/omarchy/plugins, as a package cannot write into a home
# directory. /usr/bin/omdrop is the plugin's bin/omdrop, never core's binary:
# that script applies CORE_MIN, OMDROP_IMPLEMENTATION and the hooks check
# before it hands a command to core at /usr/lib/omdrop-core/omdrop.

pkgname=omdrop
pkgver=0.18.7
pkgrel=1
pkgdesc="AirDrop for Omarchy: send and receive files with nearby Apple devices (bar widget, omdrop command, omdrop-core)"
arch=('aarch64' 'x86_64')
url="https://github.com/netmojo-systems/omdrop-plugin"
license=('MIT')
# Core's programs run openssl, pkexec, systemd and ip. The bash and Python
# programs, which run where the radio backend has no omdrop-core hooks, need
# Python, its archive library and libkeyutils.
depends=('glibc' 'gcc-libs' 'openssl' 'polkit' 'systemd' 'iproute2'
         'bash' 'python' 'python-libarchive-c' 'keyutils')
makedepends=('cargo')
checkdepends=('dbus')
optdepends=('brcmfmac-awdl-dkms: the radio on Apple Silicon Macs'
            'bluez: wake a nearby device over Bluetooth before sending or asking its name'
            '1password-cli: keep the Apple identity in 1Password'
            'ufw: the narrow firewall rule for the receiver'
            'wl-clipboard: copy a received link or photo'
            'libheif: put received HEIC photos on the clipboard as JPEG'
            'python-gobject: the file chooser for send --pick and dir --pick'
            'xdg-desktop-portal: the file chooser for send --pick and dir --pick')
# The package carries omdrop-core; `omdrop install-core` builds the same
# programs as a package of that name.
provides=('omdrop-core')
conflicts=('omdrop-core')
options=('!lto' '!debug')
install="${pkgname}.install"
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('f06f83f88db238607cc9361b824f137ac9a4255a236746278dff8b70dd70d042')

_src() { printf '%s/omdrop-plugin-%s' "${srcdir}" "${pkgver}"; }
_target() { rustc -vV | sed -n 's/^host: //p'; }

# Fixed prefixes for the paths rustc compiles into the binaries, so they name
# neither the builder's home nor where the build ran (see core/PKGBUILD).
_cargo_env() {
  export CARGO_HOME="${srcdir}/cargo-home" CARGO_TARGET_DIR="${srcdir}/target"
  local sysroot; sysroot=$(rustc --print sysroot)
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${sysroot}=/usr/src/rust --remap-path-prefix=${srcdir}=/usr/src/debug/${pkgname}"
}

prepare() {
  cd "$(_src)/core"
  export CARGO_HOME="${srcdir}/cargo-home"
  cargo fetch --locked --target "$(_target)"
}

build() {
  cd "$(_src)/core"
  _cargo_env
  cargo build --frozen --release --workspace
}

check() {
  cd "$(_src)/core"
  _cargo_env
  cargo test --frozen --release --workspace
}

package() {
  local src; src=$(_src)
  local share="${pkgdir}/usr/share/omdrop"

  # The plugin, as `omarchy plugin add` would clone it, minus what only
  # development needs: core's source, the tests, CI and this recipe. Without
  # core/PKGBUILD the plugin never offers to build or update core itself.
  install -Dm644 -t "${share}" "${src}"/{manifest.json,Panel.qml,Radar.qml,OmdropIcon.qml,preview.png,README.md,LICENSE}
  install -Dm755 -t "${share}/bin" "${src}/bin/omdrop"
  install -Dm644 -t "${share}/bin" "${src}"/bin/*.py
  cp -r --no-preserve=ownership "${src}/bin/apple-ca" "${share}/bin/"
  cp -r --no-preserve=ownership "${src}/share" "${src}/skills" "${src}/docs" "${share}/"
  # The two Python programs that run directly, as in the repository.
  chmod 755 "${share}/bin"/{airdrop-serve.py,pick.py}

  # The one command: the plugin's script, which decides whether core runs.
  install -d "${pkgdir}/usr/bin"
  ln -s /usr/share/omdrop/bin/omdrop "${pkgdir}/usr/bin/omdrop"

  # Core's programs, in a root-owned directory off PATH: the polkit action
  # binds to one exact path, and a helper anywhere a user can write would
  # hand that user root.
  local bin="${srcdir}/target/release" lib="${pkgdir}/usr/lib/omdrop-core" prog
  for prog in omdrop omdrop-radio omdrop-receiver omdrop-adv airdrop-send send-to-peer; do
    install -Dm755 "${bin}/${prog}" "${lib}/${prog}"
  done
  install -Dm644 "${src}/core/packaging/org.omarchy.omdrop.radio.policy" \
    "${pkgdir}/usr/share/polkit-1/actions/org.omarchy.omdrop.radio.policy"

  install -Dm644 "${src}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
