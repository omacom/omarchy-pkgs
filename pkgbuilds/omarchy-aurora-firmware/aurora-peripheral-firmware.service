[Unit]
Description=Load Apple peripherals after per-machine firmware is available
DefaultDependencies=no
Wants=omarchy-vendorfw-initrd.service
After=omarchy-vendorfw-initrd.service
Before=cryptsetup-pre.target initrd-root-device.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/omarchy/initcpio/aurora-peripheral-firmware.sh
