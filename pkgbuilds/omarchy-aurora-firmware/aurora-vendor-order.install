#!/bin/bash
# SPDX-License-Identifier: MIT
build() {
  local hook systemd_initrd=false
  for hook in "${HOOKS[@]}"; do
    [[ $hook != systemd ]] || systemd_initrd=true
  done
  if ! "$systemd_initrd"; then
    echo 'aurora-vendor-order: legacy initramfs; AOP and Neo Wi-Fi wait for the root vendor-firmware service and required firmware' >&2
    return 0
  fi
  add_binary bash
  add_binary modprobe
  add_binary grep
  add_module aop
  add_module aop_als
  add_module mt7932-fullmac
  # cfg80211 loads with the radio here and reads its regulatory database only
  # once; without it a country setting never reaches the global domain.
  add_file /usr/lib/firmware/regulatory.db
  add_file /usr/lib/firmware/regulatory.db.p7s
  # The policies come with the image, not a package; a missing one must not fail
  # the build. aurora-peripheral-firmware.sh then defers the radio instead.
  local policy
  for policy in /usr/lib/firmware/mediatek/mt7932/policy/{US,world-XZ}.bin; do
    [[ ! -e $policy ]] || add_file "$policy"
  done
  add_file /usr/lib/modprobe.d/aurora-firmware-order.conf
  add_file /usr/lib/omarchy/initcpio/aurora-peripheral-firmware.sh
  add_file /usr/lib/systemd/system/aurora-peripheral-firmware.service
  add_symlink /usr/lib/systemd/system/sysinit.target.wants/aurora-peripheral-firmware.service ../aurora-peripheral-firmware.service
  add_symlink /usr/lib/systemd/system/initrd-root-device.target.wants/aurora-peripheral-firmware.service ../aurora-peripheral-firmware.service
  add_file /usr/lib/omarchy/initcpio/aurora-vendor-order-cryptsetup.conf \
    /usr/lib/systemd/system/systemd-cryptsetup@.service.d/aurora-vendor-order.conf
}
help() {
  echo 'Load AOP and Neo Wi-Fi only after the ESP vendor firmware is extracted.'
}
