pkgname=iris-drive-bin
pkgver=0.1.39
pkgrel=1
pkgdesc='Private file sync across your devices, with the idrive CLI (official binaries)'
arch=('x86_64')
url='https://getdrive.iris.to'
license=('MIT')
depends=(
  'dbus'
  'fuse3'
  'libfuse3.so=3-64'
  'glib2'
  'glibc>=2.39'
  'gtk4>=4.12'
  'hicolor-icon-theme'
  'libadwaita>=1.5'
  'libgcc'
  'xdg-utils'
)
provides=("iris-drive=$pkgver" "idrive=$pkgver")
conflicts=('iris-drive' 'idrive')
# Preserve the published GUI and CLI binaries; no second build or stripping.
options=('!strip' '!debug')
source=(
  "https://cdn.iris.to/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/releases%2Firis-drive/v$pkgver/assets/iris-drive-v$pkgver-linux-x64.deb"
  "iris-drive-$pkgver-LICENSE::https://raw.githubusercontent.com/mmalmi/iris-drive/v$pkgver/LICENSE"
)
sha256sums=(
  'cb13734ebec14c411c738e6314d6e7df6ae3c68d3d5d63764d0fce3084b9e08d'
  '47fa2dc954a0dea5b8448c5da2e573b804d14b29d38b4d6479d8804140c8d3fa'
)

package() {
  # Includes idrive, the desktop link handler and the application icon.
  bsdtar -xf "$srcdir/data.tar.xz" -C "$pkgdir"
  install -Dm644 "$srcdir/iris-drive-$pkgver-LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
