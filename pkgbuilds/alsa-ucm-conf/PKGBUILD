# Maintainer: Birk Skyum <birk.skyum@pm.me>

# Arch Linux ARM's alsa-ucm-conf 1.2.16.1 predates upstream's Snapdragon X2
# (Glymur) profiles: the dispatcher that matches a Glymur machine by its
# firmware info (conf.d/glymur/glymur.conf) and the Zenbook A14 X2 and Yoga
# Slim 7x Gen 11 profiles. Without them those laptops get no speaker or
# microphone profile. This builds upstream's master until a release with them
# reaches Arch Linux ARM. Then drop this package, and the release, whose
# version is higher, takes over on the next update.
#
# It also carries the ASUS ProArt PZ13's profile, Alex Grucza's from
# github.com/agrucza/asus-proart-pz13-linux at 71c27d312a0e (BSD-3-Clause),
# matched by the tablet's DMI in the X1 dispatcher as on his machine. That
# profile has to reach alsa-ucm-conf before this package is dropped.
#
# The Surface Laptop 13-inch gets the Surface Pro 12-inch's profile by its DMI
# in the same dispatcher: it has that tablet's speakers and microphones, and
# its device tree names the sound card after it. That match has to reach
# alsa-ucm-conf before this package is dropped too.

pkgname=alsa-ucm-conf
_commit=d260eedd1900dbf3b477047e048d5382a5f50e24
pkgver=1.2.16.1.r45.gd260eed
pkgrel=3
pkgdesc="ALSA Use Case Manager configuration (and topologies), upstream's master for the Snapdragon X2 profiles"
arch=('aarch64')
url="https://alsa-project.org/"
license=('BSD-3-Clause')
makedepends=('git')
source=("$pkgname::git+https://github.com/alsa-project/alsa-ucm-conf.git#commit=$_commit"
        'ASUS-ProArt-PZ13.conf'
        'ProArt-PZ13-HiFi.conf'
        'x1e80100-asus-proart-pz13.conf'
        'x1e80100-microsoft-surface-laptop-13.conf')
sha256sums=('SKIP'
            'e76b18d4a41673af9b7bf867ce203e907de8ea26ae4d7cb03bf6d767e78f9b9e'
            '0e3d96499c79c1c87eb66b5cdd64d4dfc15523ecbb5c92cff12528ab34d00679'
            '99ddcb451591d14de94b5b5f88fc68a5fbae910594870b948560f3f4e30dc676'
            '2ab734400c3f3e5f527383f0eb01921daae51950647c920a4515421d03d72ad1')

package() {
  cd "$pkgname"
  install -vdm 755 "$pkgdir/usr/share/alsa/"
  cp -av ucm2 "$pkgdir/usr/share/alsa/"

  local qcom="$pkgdir/usr/share/alsa/ucm2/Qualcomm/x1e80100"
  install -vDm 644 "$srcdir"/ASUS-ProArt-PZ13.conf "$srcdir"/ProArt-PZ13-HiFi.conf -t "$qcom"
  cat "$srcdir"/x1e80100-asus-proart-pz13.conf \
    "$srcdir"/x1e80100-microsoft-surface-laptop-13.conf >>"$qcom/x1e80100.conf"
  install -vDm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -vDm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -vDm 644 ucm2/README.md -t "$pkgdir/usr/share/doc/$pkgname/ucm2"
}
