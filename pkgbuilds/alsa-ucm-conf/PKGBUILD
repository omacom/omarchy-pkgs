# Maintainer: Birk Skyum <birk.skyum@pm.me>

# Arch Linux ARM's alsa-ucm-conf 1.2.16.1 predates upstream's Snapdragon X2
# (Glymur) profiles: the dispatcher that matches a Glymur machine by its
# firmware info (conf.d/glymur/glymur.conf) and the Zenbook A14 X2 and Yoga
# Slim 7x Gen 11 profiles. Without them those laptops get no speaker or
# microphone profile. This builds upstream's master until a release with them
# reaches Arch Linux ARM. Then drop this package, and the release, whose
# version is higher, takes over on the next update.
#
# It also carries the ASUS ProArt PZ13's profile, Alex Grucza's from
# github.com/agrucza/asus-proart-pz13-linux at 71c27d312a0e (BSD-3-Clause),
# matched by the tablet's DMI in the X1 dispatcher as on his machine. That
# profile has to reach alsa-ucm-conf before this package is dropped.
#
# The Surface Laptop 13-inch gets the Surface Pro 12-inch's profile by its DMI
# in the same dispatcher: it has that tablet's speakers and microphones, and
# its device tree names the sound card after it. That match has to reach
# alsa-ucm-conf before this package is dropped too.
#
# The Acer Aspire 16 AI's profile is GenericCPU's, from omacom/omarchy#17555,
# matched by the laptop's DMI in the same dispatcher. It has to reach
# alsa-ucm-conf before this package is dropped as well.
#
# The Surface Laptop 7 gets a profile of its own in place of the ThinkPad
# T14s's, which upstream's dispatcher gives it. That one has three DisplayPort
# outputs and the laptop's sound card two, so the third, with no jack control,
# always reads as available and keeps the card on a profile without the
# headphones: plugging them in gives no headphone output. The Surface's
# profile is the T14s's without that output. It has to reach alsa-ucm-conf
# before this package is dropped as well.
#
# The ASUS Vivobook S 16 S3607QA gets the ThinkPad T14s's profile by its DMI
# in the same dispatcher, as upstream gives it to the Vivobook S 15 and the
# Zenbook A14, whose speakers, microphones and headset codec it has. That
# match has to reach alsa-ucm-conf before this package is dropped too.
#
# The Samsung Galaxy Book4 Edge 14 gets Nicola Nicodemo's profile, from
# github.com/n1c0la84/book4-edge-linux, matched by its DMI in the same
# dispatcher: the CRD's with the WSA883x two-speaker sequences, which also
# switches on the tweeters once its tree describes them. It has to reach
# alsa-ucm-conf before this package is dropped as well.
#
# The Lenovo ThinkCentre neo 50q QC gets the IdeaCentre Mini's profile by its
# DMI in the same dispatcher. Its device tree is built on the IdeaCentre
# Mini's and gives its sound card that name, with the same headset jack and
# three DisplayPort outputs, but upstream matches only the IdeaCentre Mini's
# DMI, so the card gets no profile. That match has to reach alsa-ucm-conf
# before this package is dropped too.

pkgname=alsa-ucm-conf
_commit=d260eedd1900dbf3b477047e048d5382a5f50e24
pkgver=1.2.16.1.r45.gd260eed
pkgrel=8
pkgdesc="ALSA Use Case Manager configuration (and topologies), upstream's master for the Snapdragon X2 profiles"
arch=('aarch64')
url="https://alsa-project.org/"
license=('BSD-3-Clause')
makedepends=('git')
source=("$pkgname::git+https://github.com/alsa-project/alsa-ucm-conf.git#commit=$_commit"
        'ASUS-ProArt-PZ13.conf'
        'ProArt-PZ13-HiFi.conf'
        'x1e80100-asus-proart-pz13.conf'
        'x1e80100-microsoft-surface-laptop-13.conf'
        'ACER-Aspire-16-AI.conf'
        'Aspire-16-AI-HiFi.conf'
        'x1e80100-acer-aspire-16-ai.conf'
        'MICROSOFT-Surface-Laptop-7.conf'
        'SurfaceLaptop7-HiFi.conf'
        'x1e80100-microsoft-surface-laptop-7.conf'
        'x1e80100-asus-vivobook-s16.conf'
        'Samsung-GalaxyBook4Edge.conf'
        'Samsung-GalaxyBook4Edge-HiFi.conf'
        'x1e80100-samsung-galaxy-book4-edge-14.conf'
        'x1e80100-lenovo-thinkcentre-neo-50q-qc.conf')
sha256sums=('SKIP'
            'e76b18d4a41673af9b7bf867ce203e907de8ea26ae4d7cb03bf6d767e78f9b9e'
            '0e3d96499c79c1c87eb66b5cdd64d4dfc15523ecbb5c92cff12528ab34d00679'
            '99ddcb451591d14de94b5b5f88fc68a5fbae910594870b948560f3f4e30dc676'
            '2ab734400c3f3e5f527383f0eb01921daae51950647c920a4515421d03d72ad1'
            'cde2c2f72989fd28776889acf71edace3825301929b2e20b6bce6797a693f887'
            'ff09e24bffa9cf5163a00a11836a9ea969becf56f12a4552550c203e62b696c9'
            '22e4e527ac93a0512e59b69ab95b2e62c61681ac1e098696961ed893944bd998'
            '015d63fe93e0f73a3030cbc2a419dd383394bd0eb810149571116634b7059177'
            'dcad9da32c2e87c913b00cb04cf8fa51e6107566f6e4347ddfbbbe104c4fc65f'
            'e73c12a00d3fd1e69bc8d4619cf1c7ac1fd3be94fc091de321f9baccd36b326d'
            '064b9180f99470aa1c32c766ffed7cc8532421278d05395e74332b93d1a94f01'
            '718391b52b1f1fa8c2fa954c0ddfbf0e7f36e24b47eedaa9374ad512aa549639'
            '52e8ce299618cd107b370ca25eac44a68c409618f1f0652efba88cdb5a043577'
            '6f0ec5aac5460711a134c45bb4ebe9f8ea2a8336f790b3f9ca5a2f8c6a4d0e78'
            '7eab2c698abde2de0f6becb11e850bee4da295f93a0bfb130790dfa538578ff1')

package() {
  cd "$pkgname"
  install -vdm 755 "$pkgdir/usr/share/alsa/"
  cp -av ucm2 "$pkgdir/usr/share/alsa/"

  local qcom="$pkgdir/usr/share/alsa/ucm2/Qualcomm/x1e80100"
  install -vDm 644 "$srcdir"/ASUS-ProArt-PZ13.conf "$srcdir"/ProArt-PZ13-HiFi.conf \
    "$srcdir"/ACER-Aspire-16-AI.conf "$srcdir"/Aspire-16-AI-HiFi.conf \
    "$srcdir"/MICROSOFT-Surface-Laptop-7.conf "$srcdir"/SurfaceLaptop7-HiFi.conf \
    "$srcdir"/Samsung-GalaxyBook4Edge.conf "$srcdir"/Samsung-GalaxyBook4Edge-HiFi.conf -t "$qcom"

  # Upstream's dispatcher sends the Surface Laptop 7 to the ThinkPad T14s's
  # profile. Take it out of that match, so only the block appended below
  # answers for it; two profiles for one card would not load.
  local sl7='|(Microsoft Corporation.*Surface.*Microsoft Surface Laptop, 7th Edition)'
  grep -qF "$sl7" "$qcom/x1e80100.conf"
  sed -i "s/${sl7//\*/\\*}//" "$qcom/x1e80100.conf"
  if grep -qF 'Surface Laptop, 7th Edition' "$qcom/x1e80100.conf"; then
    echo "the Surface Laptop 7 is still matched by upstream's dispatcher" >&2
    return 1
  fi

  cat "$srcdir"/x1e80100-asus-proart-pz13.conf \
    "$srcdir"/x1e80100-microsoft-surface-laptop-13.conf \
    "$srcdir"/x1e80100-acer-aspire-16-ai.conf \
    "$srcdir"/x1e80100-microsoft-surface-laptop-7.conf \
    "$srcdir"/x1e80100-asus-vivobook-s16.conf \
    "$srcdir"/x1e80100-samsung-galaxy-book4-edge-14.conf \
    "$srcdir"/x1e80100-lenovo-thinkcentre-neo-50q-qc.conf >>"$qcom/x1e80100.conf"
  install -vDm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -vDm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -vDm 644 ucm2/README.md -t "$pkgdir/usr/share/doc/$pkgname/ucm2"
}
