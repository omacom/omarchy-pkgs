# Maintainer: Ted Charles <me@tedcharles.net>
pkgname=python-wgpu
_pkgname=wgpu
pkgver=0.32.0
pkgrel=1
pkgdesc='WebGPU bindings for Python, with upstream wgpu-native binaries'
arch=('x86_64' 'aarch64')
url='https://github.com/pygfx/wgpu-py'
license=('BSD-2-Clause' 'MIT')
depends=('python' 'python-cffi' 'python-rendercanvas>=2.7' 'vulkan-icd-loader' 'libgcc' 'glibc')
makedepends=('python-installer')
options=('!strip')
source=('LICENSE-wgpu-native::https://raw.githubusercontent.com/gfx-rs/wgpu-native/6aed50955d934ac36049ba8d002034841633ae02/LICENSE.MIT')
sha256sums=('c7fea58d1cfe49634cd92e54fc10a9d871f4b275321a4cd8c09e449122caaeb4')
# Upstream's published wheels contain the matching wgpu-native shared library.
# Declare each artifact and checksum so no build hook downloads untracked code.
source_x86_64=("https://files.pythonhosted.org/packages/py3/w/${_pkgname}/${_pkgname}-${pkgver}-py3-none-manylinux_2_28_x86_64.whl")
source_aarch64=("https://files.pythonhosted.org/packages/py3/w/${_pkgname}/${_pkgname}-${pkgver}-py3-none-manylinux_2_28_aarch64.whl")
sha256sums_x86_64=('6499a31b5a29a10b4f1089fea4a0806411f42605fa86b6c0b543a07ca0de8568')
sha256sums_aarch64=('00454ba1bc794d38c8365f4ad29f381b88ce0a7f115133bfaa6f1dfad7eb2764')
noextract=("${_pkgname}-${pkgver}-py3-none-manylinux_2_28_x86_64.whl"
           "${_pkgname}-${pkgver}-py3-none-manylinux_2_28_aarch64.whl")

package() {
  install -Dm644 LICENSE-wgpu-native "$pkgdir/usr/share/licenses/$pkgname/LICENSE-wgpu-native"
  python -m installer --destdir="$pkgdir" "${_pkgname}-${pkgver}-py3-none-manylinux_2_28_${CARCH}.whl"
  install -Dm644 "$pkgdir"/usr/lib/python*/site-packages/wgpu-*.dist-info/licenses/LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
