pkgname=rwsm
pkgver=0.1.0
pkgrel=1
pkgdesc='Rust rewrite of uwsm, the Universal Wayland Session Manager (drop-in uwsm)'
arch=('x86_64' 'aarch64')
url='https://github.com/yamz8/rwsm'
license=('MIT')
_upstream=0.27.1
depends=('gcc-libs' 'glibc' 'sh' 'systemd' 'util-linux')
makedepends=('cargo' 'git' 'python' 'scdoc')
optdepends=(
  'libnewt: for "uwsm start select"'
  'libnotify: for feedback from "uwsm app" commands or the fumon service'
)
provides=("uwsm=$_upstream")
conflicts=('uwsm')
replaces=('uwsm')
options=('!lto')
source=("rwsm::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

# Same paths and extras as Arch's uwsm, so configs and unit drop-ins stay valid.
_make_args=(PREFIX=/usr LIBEXECDIR=/usr/lib UWSM_APP=1 UUCTL=1 WAIT_TRAY=1 FUMON=1 MAN_PAGES=1)

prepare() {
  cd rwsm
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd rwsm
  make build "${_make_args[@]}" CARGO="cargo --frozen"
}

check() {
  cd rwsm
  cargo test --frozen --release
}

package() {
  cd rwsm
  make install "${_make_args[@]}" CARGO="cargo --frozen" DESTDIR="$pkgdir"
}
