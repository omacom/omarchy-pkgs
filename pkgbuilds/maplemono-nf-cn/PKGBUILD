# Maintainer: Omarchy <hello@omarchy.org>

pkgname=maplemono-nf-cn
pkgver=7.9
pkgrel=1
pkgdesc="Maple Mono monospace font with Nerd Font icons and Chinese glyphs (hinted)"
arch=("any")
url="https://github.com/subframe7536/maple-font"
license=("OFL-1.1")
provides=("ttf-font" "ttf-font-nerd")
source=("MapleMono-NF-CN-${pkgver}.zip::https://github.com/subframe7536/maple-font/releases/download/v${pkgver}/MapleMono-NF-CN.zip")
sha256sums=('af913b6322905348b3f50e4397fedc35b3a880db5effcce7969003051dcd3e94')

package() {
  install -Dm644 -t "$pkgdir/usr/share/fonts/TTF" MapleMono-NF-CN-*.ttf
  install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
}
