# Maintainer: Jaycee Appi <appi.jaycee@gmail.com>
#
# The Omarchy shell integration: a bar widget and the full instrument as a panel.
# Split from the app package because the plugin's QML imports Quickshell, qs.Ui and
# qs.Commons - shipping it inside the app would make a plain Qt6 program depend on
# the shell, and would drag Quickshell onto machines that only want the window.
#
# The shell loads plugins from ~/.config/omarchy/plugins/<id>/, which omarchy's
# validator requires to be a real directory (a symlinked plugin folder is refused),
# so it cannot be a link into this package. The helper below makes that copy; see
# its --check mode, and re-run it after this package is upgraded.
pkgname=exochronometer-omarchy
pkgver=0.1.0
pkgrel=1
pkgdesc='Exochronometer as an Omarchy bar widget and panel (the shell integration)'
arch=('any')
url='https://github.com/alchemicAV/exochronometer-linux'
license=('MIT')
makedepends=('nodejs' 'npm')
makedepends=('nodejs' 'npm')
depends=('quickshell' 'omarchy' 'qt6-multimedia' 'exochronometer')
optdepends=('python: for `exochronometer-omarchy-plugin remove`')
install=exochronometer-omarchy.install
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        'exochronometer-omarchy-plugin')
sha256sums=('4fb796365e9ad0eefe2e07de0e02ed1fb61a4cdfea1d80daa4f8d6a11b79f747'
            '231866d206ac278c72621fdb62d2e530cc7834326b087827c31dc568914a6dd3')
options=('!strip')

build() {
  # The plugin is generated from the same source as the app: the TypeScript core is
  # compiled first, then the QML component tree is assembled from it.
  cd "exochronometer-linux-${pkgver}"
  npm ci --no-audit --no-fund
  ./node_modules/.bin/tsc
  # The plugin generator reads the ASSEMBLED app, not the raw source: it copies the
  # same component tree and excludes the standalone host. Hence the app assembly step
  # here too - without it the build stops with "build/app is missing".
  node scripts/build-app.mjs
  node scripts/build-omarchy-plugin.mjs
}

package() {
  cd "exochronometer-linux-${pkgver}"

  install -dm755 "$pkgdir/usr/share/exochronometer-omarchy-plugin"
  cp -r build/omarchy-plugin/. "$pkgdir/usr/share/exochronometer-omarchy-plugin/"

  install -Dm755 "$srcdir/exochronometer-omarchy-plugin" \
    "$pkgdir/usr/bin/exochronometer-omarchy-plugin"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/exochronometer-omarchy/LICENSE"
}