# The shell runs the plugin from ~/.config/omarchy/plugins/<id>/, which is a COPY of
# this package made by exochronometer-omarchy-plugin. Omarchy's validator rejects a
# symlinked plugin folder, so the copy is required - and it does NOT follow package
# upgrades.
#
# That divergence is invisible on screen: the panel keeps running the old plugin
# while the app is current. It is how the toolbar spent a whole round on the
# pre-real-time buffer player (stopping on its own) after the app had been fixed,
# with nothing anywhere saying the two hosts disagreed.
post_install() {
  echo ">>> Run 'exochronometer-omarchy-plugin install' so the panel the shell runs"
  echo ">>> matches this package, then restart the shell."
}

post_upgrade() {
  echo ">>> Run 'exochronometer-omarchy-plugin install' (or 'check' to diff) - the"
  echo ">>> shell's plugin copy does NOT update by itself."
}
