#!/usr/bin/env bash
# Install the Exochronometer into the Omarchy shell.
#
# Copies the generated plugin from the package into the user's shell plugin
# directory and restarts the shell so the bar widget loads. Run as the user who
# owns the desktop session - this touches ~/.config/omarchy, never /usr/share.
#
#   exochronometer-omarchy-plugin install
#   exochronometer-omarchy-plugin remove
set -euo pipefail

ID="alchemicav.exochronometer"
SRC="/usr/share/exochronometer-omarchy-plugin"
DST="$HOME/.config/omarchy/plugins/$ID"

usage() {
  echo "usage: $(basename "$0") {install|remove|check}" >&2
  exit 2
}

[ $# -eq 1 ] || usage

case "$1" in
  install)
    [ -d "$SRC" ] || { echo "not found: $SRC (is exochronometer installed?)" >&2; exit 1; }

    # A copy, not a symlink: omarchy's plugin validator refuses a symlinked plugin
    # folder ("symlinks are not allowed inside a plugin folder").
    #
    # The consequence is that this copy DRIFTS whenever the package is upgraded, and
    # a stale copy is not visible anywhere - the shell happily runs an old plugin
    # while the packaged one is current. That is exactly how the panel spent a whole
    # round running a pre-real-time build, stopping on its own like the buffer player
    # it still was, while the standalone app had already been fixed.
    rm -rf "$DST"
    mkdir -p "$DST"
    cp -r "$SRC"/. "$DST"/
    echo "synced  $SRC -> $DST"

    omarchy plugin validate "$DST"
    omarchy bar put "$ID" --after omarchy.clock >/dev/null 2>&1 || true

    # A failed QML compile is cached in the shell and keeps being reported after
    # the source is fixed; clear it so the next start compiles fresh.
    rm -rf "$HOME/.cache/quickshell/qmlcache"

    omarchy restart shell
    # No `omarchy plugin enable` here: the restarted shell is still booting when
    # this returns, so the registry answers "unknown plugin" and the call is a
    # race. It is also unnecessary - `omarchy bar put` is what mounts the widget,
    # verified working without it.
    echo "installed $ID - left click the bar label for the full instrument"
    ;;

  remove)
    omarchy plugin disable "$ID" >/dev/null 2>&1 || true
    rm -rf "$DST"
    # The layout entry lives in shell.json and there is no `bar remove`.
    python3 - "$ID" <<'PY' 2>/dev/null || true
import json, os, sys
pid = sys.argv[1]
path = os.path.expanduser("~/.config/omarchy/shell.json")
d = json.load(open(path))
layout = d.get("bar", {}).get("layout", {})
for section, entries in layout.items():
    if isinstance(entries, list):
        layout[section] = [e for e in entries if not (isinstance(e, dict) and e.get("id") == pid)]
json.dump(d, open(path, "w"), indent=2)
print(f"removed {pid} from the bar layout")
PY
    omarchy restart shell
    echo "removed $ID"
    ;;

  check)
    # Does the copy the shell is actually running still match the package?
    if [ ! -d "$DST" ]; then
      echo "MISSING: $DST - the shell has no plugin; run: $0 install"
      exit 1
    fi
    if diff -rq "$SRC" "$DST" >/dev/null 2>&1; then
      echo "current: $DST matches $SRC"
    else
      echo "STALE: $DST differs from $SRC - run: $0 install"
      diff -rq "$SRC" "$DST" 2>&1 | sed 's/^/  /'
      exit 1
    fi
    ;;

  *) usage ;;
esac