# speakerguardd 1.0 (the v2 branch), a new program that installs beside the
# 0.1 speakerguardd and speakersafetyd. OPT-IN: nothing in the default install
# pulls it, and its fleet gate keeps the older daemons in charge until
# aurora-speaker-upgrade switches the Mac. See README.md.
pkgbase=speakerguardd-v2
pkgname=('speakerguardd-v2')
pkgver=1.0.0alpha.1
pkgrel=1
# The pin below is the one place to move (with the first sha256sums entry).
_commit=dda9784b09bc5e1adf2af73bd79e2bdc67bdc474
_src=speakerguardd-$_commit
pkgdesc='In-graph speaker protection for Apple Silicon Macs (speakerguardd 1.0, preview: not yet a full macOS match; the legacy protection stays the default)'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/aurora-silicon/speakerguardd'
# aurora-speaker-tuning is based on aurora-audio-dsp by saku, also MIT.
license=('MIT')
makedepends=('rust' 'cargo' 'python')
source=("$pkgbase-$_commit.tar.gz::https://codeload.github.com/aurora-silicon/speakerguardd/tar.gz/$_commit"
        README.md)
sha256sums=('69604fab1b3d3642f8eac71dda27d9ccd006026ca3e15a53a539eef96f9b85f0'
            '4f8114220e567ff577cdd55d8086180b9376544acacad7087e1becedb2fb7d2c')
# The crates this package ships; the rig and benchmark crates stay out.
_crates=(-p sgv2-core -p sgv2-lv2 -p sgv2-supervisor -p aurora-speaker-tuning)

prepare() {
  cd "$_src"
  # The upstream units, under their own names, with the programs where this
  # package installs them. Provisioning and the self-check are hard
  # prerequisites of the supervisor, and every system unit carries the gate:
  # the supervisor and the sleep hooks need a qualified board (gate v2);
  # provisioning, the seat follower and the silent self-check run first, in
  # the gate's prepare mode, and produce the records that qualify the board.
  python - <<'PYUNIT'
import re
from pathlib import Path
lx = '/usr/lib/speakerguardd-v2'
units = ['speakerguardd.service', 'speakerguardd-provision.service', 'speakerguardd-selfcheck.service',
         'speakerguardd-switchtest.service', 'speakerguardd-seat.service', 'speakerguardd-seat.path', 'speakerguardd-session.service', 'speakerguardd-graph.service',
         'speakerguardd-sleep.service']
for u in units:
    s = Path('packaging/systemd', u).read_text()
    s = s.replace('/usr/libexec/speakerguardd/', lx + '/').replace('ExecStart=/usr/bin/speakerguardd ', f'ExecStart={lx}/speakerguardd ')
    s = re.sub(r'\bspeakerguardd(-[a-z]+)?\.(service|path)\b', r'speakerguardd-v2\1.\2', s)
    for line in s.splitlines():
        if line.startswith(('OnFailure=', 'OnSuccess=')) or 'speakersafetyd' in line or line.endswith('=speakerguardd.service') \
                or '/usr/libexec/' in line:
            raise SystemExit(f'{u}: a speakerguardd 1.0 unit chains to or names another daemon, or a path was not moved: {line}')
    Path(u.replace('speakerguardd', 'speakerguardd-v2', 1)).write_text(s)
def must(f, *lines):
    have = Path(f).read_text().splitlines()
    for l in lines:
        if l not in have:
            raise SystemExit(f'{f}: missing {l!r}')
must('speakerguardd-v2.service', f'ExecStart={lx}/speakerguardd $SGV2_ARGS',
     'Requires=speakerguardd-v2-provision.service speakerguardd-v2-selfcheck.service', f'ExecCondition={lx}/speakerguardd-gate v2')
must('speakerguardd-v2-selfcheck.service', 'Requires=speakerguardd-v2-provision.service', f'ExecCondition={lx}/speakerguardd-gate prepare',
     f'ExecStartPost={lx}/speakerguardd-provision activate --graph-unit speakerguardd-v2-graph.service')
# The switch test runs after login, before the supervisor (speakerguardd#102).
must('speakerguardd-v2.service', 'Requires=speakerguardd-v2-switchtest.service', 'After=speakerguardd-v2-switchtest.service')
must('speakerguardd-v2-selfcheck.service', f'ExecStart={lx}/speakerguardd-selfcheck run --defer --params ${{SGV2_PARAMS}} -- $SGV2_TUNING')
must('speakerguardd-v2-switchtest.service', 'Requires=speakerguardd-v2-selfcheck.service',
     'After=speakerguardd-v2-selfcheck.service systemd-user-sessions.service', 'Before=speakerguardd-v2.service',
     f'ExecCondition={lx}/speakerguardd-selfcheck pending',
     f'ExecStartPost={lx}/speakerguardd-provision activate --graph-unit speakerguardd-v2-graph.service',
     f'ExecStopPost={lx}/speakerguardd-selfcheck pending --clear')
must('speakerguardd-v2-provision.service', 'Before=speakerguardd-v2-selfcheck.service speakerguardd-v2.service',
     f'ExecStart={lx}/speakerguardd-provision run', f'ExecCondition={lx}/speakerguardd-gate prepare')
must('speakerguardd-v2-seat.service', f'ExecStart={lx}/speakerguardd-provision seat --unit speakerguardd-v2.service',
     f'ExecCondition={lx}/speakerguardd-gate prepare')
must('speakerguardd-v2-seat.path', 'Unit=speakerguardd-v2-seat.service')
must('speakerguardd-v2-sleep.service', 'Before=sleep.target', f'ExecCondition={lx}/speakerguardd-gate v2',
     f'ExecStart={lx}/speakerguardd-provision sleep --unit speakerguardd-v2.service',
     f'ExecStop={lx}/speakerguardd-provision wake --unit speakerguardd-v2.service')
must('speakerguardd-v2-session.service', f'ExecCondition={lx}/speakerguardd-provision is-seat')
# The kernel's "Speaker Protection" lock and lease writes need CAP_SYS_ADMIN.
if not re.search(r'^CapabilityBoundingSet=.*\bCAP_SYS_ADMIN\b', Path('speakerguardd-v2.service').read_text(), re.M):
    raise SystemExit('speakerguardd-v2.service: CapabilityBoundingSet lacks CAP_SYS_ADMIN')
Path('legacy-gate.conf').write_text(Path('packaging/systemd/legacy-gate.conf').read_text().replace('/usr/libexec/speakerguardd/', lx + '/'))
must('legacy-gate.conf', f'ExecCondition=+{lx}/speakerguardd-gate legacy')
PYUNIT
}

build() {
  cd "$_src"
  cargo build --locked --release "${_crates[@]}"
}

check() {
  cd "$_src"
  cargo test --locked --release "${_crates[@]}"
  python -I packaging/session/test_provision.py
  python -I packaging/session/test_wiring.py
  python -I packaging/session/test_verify.py
}

package_speakerguardd-v2() {
  # python, alsa-utils, pipewire (pw-link, pw-dump) and systemd (loginctl):
  # provisioning, the gate, the self-check and the session helper.
  # aurora-audio 4.1.aurora2-11 keeps a jack Mac's built-in card on HiFi with
  # nothing plugged in; the provisioning marker (speakerguardd#106) needs it.
  depends=('glibc' 'gcc-libs' 'python' 'alsa-utils' 'pipewire' 'systemd' 'aurora-audio>=4.1.aurora2-11')
  cd "$_src"
  local lx=/usr/lib/speakerguardd-v2 f u
  install -Dm755 target/release/speakerguardd "$pkgdir$lx/speakerguardd"
  install -Dm755 target/release/aurora-speaker-tuning "$pkgdir/usr/bin/aurora-speaker-tuning"
  install -d "$pkgdir/usr/lib/lv2/sgv2.lv2"
  install -m644 crates/sgv2-lv2/lv2/sgv2.lv2/*.ttl "$pkgdir/usr/lib/lv2/sgv2.lv2/"
  install -m755 target/release/libsgv2_lv2.so "$pkgdir/usr/lib/lv2/sgv2.lv2/libsgv2_lv2.so"
  # Every plugin the bundle names must be the library installed beside it.
  if grep -ho 'lv2:binary <[^>]*>' "$pkgdir"/usr/lib/lv2/sgv2.lv2/*.ttl | grep -v '<libsgv2_lv2.so>'; then
    echo 'The sgv2 bundle names a library this package does not install' >&2; return 1
  fi
  for f in speakerguardd-provision speakerguardd-gate speakerguardd-selfcheck speakerguardd-session; do
    install -Dm755 "packaging/session/$f" "$pkgdir$lx/$f"
  done
  install -Dm644 packaging/session/wiring.py packaging/session/gen.py -t "$pkgdir$lx/"
  # The fleet gate's data, unchanged from upstream. Every per-board value is
  # derived from the Mac's device tree and tuning at run time (wiring.py).
  install -Dm644 packaging/session/gate.json -t "$pkgdir/usr/share/speakerguardd/"
  # The macOS parity attestation 'speakerguardd-selfcheck verify' reads
  # (speakerguardd#114): without it verify refuses every Mac.
  install -Dm644 packaging/session/parity.json -t "$pkgdir/usr/share/speakerguardd/"
  # The per-machine graphs, as reference data: provisioning generates the
  # machine's own from the self-check's record.
  install -Dm644 packaging/pipewire/sgv2-*.conf -t "$pkgdir/usr/share/speakerguardd/pipewire/"
  install -Dm644 packaging/wireplumber/60-sgv2-*.conf -t "$pkgdir/usr/share/speakerguardd/wireplumber/"
  install -Dm644 speakerguardd-v2.service speakerguardd-v2-provision.service speakerguardd-v2-selfcheck.service \
    speakerguardd-v2-switchtest.service speakerguardd-v2-seat.service speakerguardd-v2-seat.path speakerguardd-v2-sleep.service -t "$pkgdir/usr/lib/systemd/system/"
  install -Dm644 speakerguardd-v2-session.service speakerguardd-v2-graph.service -t "$pkgdir/usr/lib/systemd/user/"
  # Enabled by the package itself (pacman applies no presets); the gate in
  # every unit decides whether anything runs.
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants" "$pkgdir/usr/lib/systemd/user/pipewire.service.wants"
  for u in speakerguardd-v2.service speakerguardd-v2-seat.path; do
    ln -s "../$u" "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/$u"
  done
  for u in speakerguardd-v2-graph.service speakerguardd-v2-session.service; do
    ln -s "../$u" "$pkgdir/usr/lib/systemd/user/pipewire.service.wants/$u"
  done
  # Before every sleep: the amps unlinked and the supervisor stopped while awake.
  install -d "$pkgdir/usr/lib/systemd/system/sleep.target.wants"
  ln -s ../speakerguardd-v2-sleep.service "$pkgdir/usr/lib/systemd/system/sleep.target.wants/speakerguardd-v2-sleep.service"
  # The older daemons start only where v2 does not run and the kernel has no
  # v2 interface: exactly one stack holds the speakers on each boot.
  for u in speakersafetyd speakerguardd; do
    install -Dm644 legacy-gate.conf "$pkgdir/usr/lib/systemd/system/$u.service.d/60-speakerguardd-v2-gate.conf"
  done
  install -Dm644 README.md docs/DESIGN.md docs/NEW-PLATFORM.md packaging/etc/speakerguardd.conf.example -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.packaging.md"
  install -Dm644 LICENSE crates/aurora-speaker-tuning/LICENSE-aurora-audio-dsp -t "$pkgdir/usr/share/licenses/$pkgname/"
}
