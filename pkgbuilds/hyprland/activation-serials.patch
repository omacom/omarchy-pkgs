diff --git a/src/protocols/XDGActivation.cpp b/src/protocols/XDGActivation.cpp
index 01ddb66..88cc7d2 100644
--- a/src/protocols/XDGActivation.cpp
+++ b/src/protocols/XDGActivation.cpp
@@ -1,4 +1,5 @@
 #include "XDGActivation.hpp"
+#include "../managers/SeatManager.hpp"
 #include "../managers/TokenManager.hpp"
 #include "../Compositor.hpp"
 #include "core/Compositor.hpp"
@@ -16,14 +17,36 @@ CXDGActivationToken::CXDGActivationToken(SP<CXdgActivationTokenV1> resource_) :
     m_resource->setSetAppId([this](CXdgActivationTokenV1* r, const char* appid) { m_appID = appid; });
 
     m_resource->setCommit([this](CXdgActivationTokenV1* r) {
+        // An empty token tells the client its request was refused.
+        auto reject = [this] { m_resource->sendDone(""); };
+
         // TODO: should we send a protocol error of already_used here
         // if it was used? the protocol spec doesn't say _when_ it should be sent...
         if UNLIKELY (m_committed) {
-            LOGM(Log::WARN, "possible protocol error, two commits from one token. Ignoring.");
+            LOGM(Log::WARN, "possible protocol error, two commits from one token, rejecting");
+            reject();
             return;
         }
 
         m_committed = true;
+
+        const auto SEAT = g_pSeatManager->seatResourceForClient(m_resource->client());
+
+        // Backport of hyprwm/Hyprland#16427: a token needs a serial of input the client got.
+        if UNLIKELY (!m_serial || !g_pSeatManager->serialValid(SEAT, m_serial)) {
+            LOGM(Log::WARN, "invalid serial {} for activation token, rejecting", m_serial);
+            reject();
+            return;
+        }
+
+        // Input the client got before it lost keyboard focus is not a request from the user
+        // now: a browser handed a URL in the background reuses it.
+        if UNLIKELY (!g_pSeatManager->serialAfterKeyboardLeave(SEAT, m_serial)) {
+            LOGM(Log::WARN, "serial {} for activation token predates the client losing focus, rejecting", m_serial);
+            reject();
+            return;
+        }
+
         // send done with a new token
         m_token = g_pTokenManager->registerNewToken({}, std::chrono::months{12});
 
