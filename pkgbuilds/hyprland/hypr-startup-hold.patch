--- /dev/null
+++ b/src/render/StartupHold.cpp
@@ -0,0 +1,79 @@
+#include "StartupHold.hpp"
+#include "Renderer.hpp"
+#include "../config/ConfigValue.hpp"
+#include "../debug/log/Logger.hpp"
+#include "../desktop/view/LayerSurface.hpp"
+#include "../managers/eventLoop/EventLoopManager.hpp"
+#include "../output/Monitor.hpp"
+#include "../state/MonitorState.hpp"
+
+#include <algorithm>
+#include <array>
+#include <aquamarine/output/Output.hpp>
+
+using namespace Render;
+
+void CStartupHold::start() {
+    static auto       PLAYER   = CConfigValue<Config::STRING>("misc:startup_hold_layer");
+    static auto       PTIMEOUT = CConfigValue<Config::INTEGER>("misc:startup_hold_timeout");
+    const std::string SPEC     = *PLAYER;
+
+    if (SPEC.empty())
+        return;
+
+    static constexpr std::array<std::string_view, 4> LEVELS = {"background", "bottom", "top", "overlay"};
+    const auto                                       COLON  = SPEC.find(':');
+    const auto                                       LEVEL  = std::ranges::find(LEVELS, std::string_view{SPEC}.substr(0, COLON));
+    if (COLON == std::string::npos || COLON + 1 == SPEC.size() || LEVEL == LEVELS.end()) {
+        LOG(Log::ERR, "misc:startup_hold_layer \"{}\" is not level:namespace with level one of background, bottom, top, overlay; not holding", SPEC);
+        return;
+    }
+
+    m_level     = LEVEL - LEVELS.begin();
+    m_namespace = SPEC.substr(COLON + 1);
+    m_timeout   = makeShared<CEventLoopTimer>(std::chrono::milliseconds(*PTIMEOUT), [this](auto, auto) { timeOut(); }, nullptr);
+    g_pEventLoopManager->addTimer(m_timeout);
+
+    LOG(Log::DEBUG, "Startup hold: monitors keep the picture from before us until the {} layer {} is mapped and opaque, {} ms at most", *LEVEL, m_namespace, *PTIMEOUT);
+}
+
+bool CStartupHold::holds(PHLMONITOR monitor) {
+    // only a picture the backend kept is worth holding: elsewhere, our unrendered first frame is on screen
+    if (!m_timeout || !monitor->m_output->showsAdoptedPicture() || std::ranges::any_of(m_released, [&](const auto& m) { return m == monitor; }))
+        return false;
+
+    for (auto const& ref : monitor->m_layerSurfaceLayers[m_level]) {
+        const auto LS = ref.lock();
+        if (!LS || !LS->mapped() || LS->m_namespace != m_namespace)
+            continue;
+
+        // a layer maps at alpha 0 and fades in; even a no_anim one is only opaque after the next animation tick
+        if (LS->alpha().getTotal() < 1.F)
+            return true;
+
+        LOG(Log::DEBUG, "Startup hold released on {}: {} is opaque", monitor->m_name, m_namespace);
+        m_released.emplace_back(monitor);
+        return false;
+    }
+
+    return true;
+}
+
+void CStartupHold::timeOut() {
+    for (auto const& m : State::monitorState()->monitors()) {
+        if (!holds(m))
+            continue;
+
+        LOG(Log::DEBUG, "Startup hold timed out on {}", m->m_name);
+        g_pHyprRenderer->damageMonitor(m);
+        m->scheduleFrame();
+    }
+
+    m_timeout.reset();
+    m_released.clear();
+}
+
+UP<CStartupHold>& Render::startupHold() {
+    static UP<CStartupHold> hold = makeUnique<CStartupHold>();
+    return hold;
+}
