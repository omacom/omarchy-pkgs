+++ b/src/render/StartupHold.hpp
@@ -0,0 +1,31 @@
+#pragma once
+
+#include "../desktop/DesktopTypes.hpp"
+#include "../helpers/memory/Memory.hpp"
+
+#include <string>
+#include <vector>
+
+class CEventLoopTimer;
+
+namespace Render {
+    // misc:startup_hold_layer: from the first frame on, a monitor that still shows a picture from before us,
+    // e.g. a boot splash's that the backend adopted, presents nothing until that layer is mapped on it and
+    // opaque. misc:startup_hold_timeout after the first frame, every monitor is released. A released
+    // monitor never holds again.
+    class CStartupHold {
+      public:
+        void start();
+        bool holds(PHLMONITOR monitor);
+
+      private:
+        void                       timeOut();
+
+        SP<CEventLoopTimer>        m_timeout;
+        std::vector<PHLMONITORREF> m_released;
+        size_t                     m_level = 0;
+        std::string                m_namespace;
+    };
+
+    UP<CStartupHold>& startupHold();
+}
