Use a stencil-only texture for the blur stencil

The monitor stencil shared by the blur and work framebuffers is only
used for its 8-bit stencil: the blur path masks with it, and depth
testing stays disabled. It was a DEPTH24_STENCIL8 texture, 4 bytes per
pixel, and drivers that keep depth and stencil apart (Mesa asahi stores
it as a 32-bit float depth plane plus an 8-bit stencil plane) pay 5.

GLES 3.2 has stencil-only textures. On a 3.2 context, allocate the
stencil as STENCIL_INDEX8 and attach it as the stencil attachment, so a
3024x1964 output holds 5.7 MiB for it instead of 22.7 to 28.3 MiB. A
3.0 context keeps the depth-stencil texture.

diff --git a/src/render/gl/GLFramebuffer.cpp b/src/render/gl/GLFramebuffer.cpp
index 94df85a5f..fdd0b7ef8 100644
--- a/src/render/gl/GLFramebuffer.cpp
+++ b/src/render/gl/GLFramebuffer.cpp
@@ -55,8 +55,16 @@ bool CGLFramebuffer::internalAlloc(int w, int h, uint32_t drmFormat) {
 
     if (m_stencilTex && m_stencilTex->ok()) {
         m_stencilTex->bind();
-        glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH24_STENCIL8, w, h, 0, GL_DEPTH_STENCIL, GL_UNSIGNED_INT_24_8, nullptr);
-        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_TEXTURE_2D, m_stencilTex->m_texID, 0);
+        // Only the stencil is ever tested (blur masks); depth stays disabled. GLES 3.2 has stencil-only
+        // textures, which keep 1 byte per pixel instead of a 4-byte (often 5-byte) depth-stencil.
+        if (g_pHyprOpenGL->m_eglContextVersion == CHyprOpenGLImpl::EGL_CONTEXT_GLES_3_2) {
+            glTexImage2D(GL_TEXTURE_2D, 0, GL_STENCIL_INDEX8, w, h, 0, GL_STENCIL_INDEX, GL_UNSIGNED_BYTE, nullptr);
+            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_TEXTURE_2D, GL_NONE, 0);
+            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_STENCIL_ATTACHMENT, GL_TEXTURE_2D, m_stencilTex->m_texID, 0);
+        } else {
+            glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH24_STENCIL8, w, h, 0, GL_DEPTH_STENCIL, GL_UNSIGNED_INT_24_8, nullptr);
+            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_TEXTURE_2D, m_stencilTex->m_texID, 0);
+        }
 
         glDisable(GL_DEPTH_TEST);
         glDepthMask(GL_FALSE);
