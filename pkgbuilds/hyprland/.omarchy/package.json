{
  "source": "local",
  "sync": false,
  "upstream": {
    "git_tags": "https://github.com/hyprwm/Hyprland.git",
    "tag_pattern": "v{pkgver}",
    "sources": {
      "any": [
        "https://github.com/hyprwm/Hyprland/releases/download/v{pkgver}/source-v{pkgver}.tar.gz"
      ]
    }
  },
  "rebuild_on": [
    "aquamarine",
    "hyprgraphics"
  ],
  "rebuilt_against": {
    "x86_64": {
      "aquamarine": "0.16.0-1",
      "hyprgraphics": "0.6.0-1"
    },
    "aarch64": {
      "aquamarine": "0.15.1-1.3",
      "hyprgraphics": "0.5.1-4"
    }
  }
}
