+++ b/src/helpers/StartupCursor.cpp
@@ -0,0 +1,31 @@
+#include "StartupCursor.hpp"
+
+#include "../config/ConfigValue.hpp"
+#include "../render/Renderer.hpp"
+
+namespace {
+    enum class eState {
+        UNREAD,
+        HIDDEN,
+        SHOWN,
+    };
+
+    eState state = eState::UNREAD;
+}
+
+bool StartupCursor::hidden() {
+    if (state == eState::UNREAD) {
+        static auto PHIDE = CConfigValue<Config::INTEGER>("cursor:hide_at_startup");
+        state             = *PHIDE ? eState::HIDDEN : eState::SHOWN;
+    }
+
+    return state == eState::HIDDEN;
+}
+
+void StartupCursor::reveal() {
+    if (!hidden())
+        return;
+
+    state = eState::SHOWN;
+    g_pHyprRenderer->ensureCursorRenderingMode();
+}
--- /dev/null
+++ b/src/helpers/StartupCursor.hpp
@@ -0,0 +1,12 @@
+#pragma once
+
+// Off unless cursor:hide_at_startup is set: from Hyprland's start, no cursor is
+// shown until the client under the pointer sets one or the pointer is moved,
+// so a client that covers the screen at startup decides the cursor from its
+// first frame. Startup only: once shown, it is never hidden this way again.
+namespace StartupCursor {
+    // whether the cursor is still hidden; the first call reads the config
+    bool hidden();
+    // the client under the pointer set a cursor, or the pointer moved
+    void reveal();
+}
