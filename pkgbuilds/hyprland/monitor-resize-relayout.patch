From ab2d313b551f004878ada2bbb30c67bb674822f5 Mon Sep 17 00:00:00 2001
From: Vaxry <43317083+vaxerski@users.noreply.github.com>
Date: Wed, 12 Aug 2026 20:57:27 +0200
Subject: [PATCH] monitor: fix layer arrangement on layout changes (#15842)

---
 src/config/shared/monitor/MonitorRuleManager.cpp | 10 ----------
 src/output/Monitor.cpp                           |  2 ++
 src/state/MonitorLayoutController.cpp            |  5 +++++
 3 files changed, 7 insertions(+), 10 deletions(-)

diff --git a/src/config/shared/monitor/MonitorRuleManager.cpp b/src/config/shared/monitor/MonitorRuleManager.cpp
index 380573911d0..86521ae638f 100644
--- a/src/config/shared/monitor/MonitorRuleManager.cpp
+++ b/src/config/shared/monitor/MonitorRuleManager.cpp
@@ -4,7 +4,6 @@
 #include "../../../protocols/OutputManagement.hpp"
 #include "../../../output/Monitor.hpp"
 #include "../../../Compositor.hpp"
-#include "../../../render/Renderer.hpp"
 #include "../../../event/EventBus.hpp"
 #include "../../../managers/eventLoop/EventLoopManager.hpp"
 #include "../../../managers/fullscreen/FullscreenController.hpp"
@@ -193,15 +192,6 @@ void CMonitorRuleManager::ensureMonitorStatus() {
 
     State::monitorLayoutController()->arrange();
     State::monitorLayoutController()->checkOverlapsAndNotify();
-
-    for (const auto& m : monsForRefresh) {
-        if (!m->m_output)
-            continue;
-
-        g_pHyprRenderer->arrangeLayersForMonitor(m->m_id);
-    }
-
-    Event::bus()->m_events.monitor.layoutChanged.emit();
 }
 
 void CMonitorRuleManager::ensureVRR(PHLMONITOR pMonitor) {
diff --git a/src/output/Monitor.cpp b/src/output/Monitor.cpp
index 4097916b247..8bf6cc8572c 100644
--- a/src/output/Monitor.cpp
+++ b/src/output/Monitor.cpp
@@ -222,6 +222,7 @@ void CMonitor::onConnect(bool noRule) {
             Log::logger->log(Log::DEBUG, "Reapplying monitor rule for {} from a state request", m_name);
             auto cpy = m_activeMonitorRule;
             applyMonitorRule(std::move(cpy));
+            State::monitorLayoutController()->scheduleRecheck();
             return;
         }
 
@@ -240,6 +241,7 @@ void CMonitor::onConnect(bool noRule) {
         rule.m_resolution = SIZE;
 
         applyMonitorRule(std::move(rule));
+        State::monitorLayoutController()->scheduleRecheck();
     });
 
     m_frameScheduler         = makeUnique<CMonitorFrameScheduler>(m_self.lock());
diff --git a/src/state/MonitorLayoutController.cpp b/src/state/MonitorLayoutController.cpp
index 49d7e00c617..a2e03957cd8 100644
--- a/src/state/MonitorLayoutController.cpp
+++ b/src/state/MonitorLayoutController.cpp
@@ -12,6 +12,7 @@
 #include "../notification/NotificationOverlay.hpp"
 #include "../output/Monitor.hpp"
 #include "../protocols/XDGOutput.hpp"
+#include "../render/Renderer.hpp"
 #include "../xwayland/XWayland.hpp"
 
 #include <vector>
@@ -66,6 +67,10 @@ void CMonitorLayoutController::arrange() const {
     Log::logger->log(Log::DEBUG, "arrangeMonitors: {} to arrange", arrangeableMonitors.size());
     State::monitorPositionController()->arrange(arrangeableMonitors, *PXWLFORCESCALEZERO);
 
+    for (const auto& m : State::monitorState()->monitors()) {
+        g_pHyprRenderer->arrangeLayersForMonitor(m->m_id);
+    }
+
     PROTO::xdgOutput->updateAllOutputs();
     Event::bus()->m_events.monitor.layoutChanged.emit();
 
