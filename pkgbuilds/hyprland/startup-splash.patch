+#pragma once
+
+#include "../helpers/math/Math.hpp"
+#include "../desktop/DesktopTypes.hpp"
+#include "../helpers/memory/Memory.hpp"
+
+#include <cairo/cairo.h>
+#include <aquamarine/output/Output.hpp>
+#include <aquamarine/backend/Backend.hpp>
+#include <vector>
+#include <optional>
+#include <string>
+
+// A boot splash drawn on the background from the first frame a monitor shows until it is
+// cleared: a centred logo and, optionally, a progress bar under it that eases out over a
+// duration from a start time. It lets the compositor take the display over from a boot splash
+// (Plymouth) without the screen changing, until a client draws over it.
+namespace Render::StartupSplash {
+    struct SLayout {
+        // physical pixels, monitor-local
+        CBox   logo, box, bar;
+        bool   hasBar = false;
+        double unit   = 1;
+    };
+
+    // Whether a splash is configured (misc:startup_splash_logo is set) and has not faded out.
+    bool                   active();
+
+    struct SState {
+        double progress  = 0;     // the bar, 0..1
+        double alpha     = 1;     // the whole splash
+        bool   barMoving = false; // the bar will look different next frame
+        bool   finishing = false; // filling or fading
+        bool   fading    = false;
+        bool   done      = false;
+    };
+
+    // Where the splash is now: the bar on its curve, then, once misc:startup_splash_finish is set
+    // (or the timeout passes), the bar filling and the splash fading out.
+    SState                 state();
+
+    // Where everything goes on a monitor of this pixel size, as Plymouth's script lays it out.
+    std::optional<SLayout> layout(const Vector2D& physicalSizeMm, const Vector2D& pixelSize);
+
+    // The bar's progress (0..1) now, and whether it is still moving.
+    double                 progress(bool* moving = nullptr);
+
+    // The images, loaded once per path; nullptr when missing.
+    cairo_surface_t*       image(const std::string& path);
+
+    // Paints background and splash into a mapped XRGB/ARGB8888 buffer.
+    void                   paint(uint8_t* data, int width, int height, int stride, const Vector2D& physicalSizeMm, uint32_t background);
+
+    // Paints a CPU-drawn buffer into an aquamarine buffer, when its format allows.
+    bool                   paintBuffer(SP<Aquamarine::IBuffer> buffer, const Vector2D& physicalSizeMm);
+
+    // Lights an output up with the splash as soon as the backend reports it, long before
+    // the compositor has finished starting and draws its first frame.
+    void                   lightUp(SP<Aquamarine::IOutput> output);
+
+    // While the compositor is still starting, flips the outputs lit early to a freshly painted splash,
+    // at most every 30 ms, so the bar keeps moving through startup. Hyprland calls it between its
+    // startup steps; it does nothing once a monitor has taken an output over.
+    void                   tick(SP<Aquamarine::CBackend> backend);
+
+    // A monitor now drives this output: the early frames are over.
+    void                   handOver(SP<Aquamarine::IOutput> output);
+}
