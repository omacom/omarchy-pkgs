--- /dev/null
+++ b/src/render/StartupSplash.cpp
@@ -0,0 +1,313 @@
+#include "StartupSplash.hpp"
+#include "../config/ConfigValue.hpp"
+#include "../output/Monitor.hpp"
+#include "../debug/log/Logger.hpp"
+#include "../macros.hpp"
+#include "../ipc/s2/S2.hpp"
+#include "../managers/eventLoop/EventLoopManager.hpp"
+
+#include <aquamarine/output/Output.hpp>
+#include <aquamarine/buffer/Buffer.hpp>
+#include <aquamarine/allocator/Swapchain.hpp>
+#include <drm_fourcc.h>
+#include <chrono>
+#include <cmath>
+#include <ctime>
+#include <unordered_map>
+#include <poll.h>
+
+using namespace Render;
+
+static std::string cleaned(const std::string& s) {
+    return s == STRVAL_EMPTY ? "" : s;
+}
+
+static double nowMs() {
+    timespec now{};
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return now.tv_sec * 1000.0 + now.tv_nsec / 1000000.0;
+}
+
+static double g_finishMs = 0;    // when the splash started finishing: the bar fills, then it fades
+static double g_finishFrom = 0;  // the bar's progress then
+static bool   g_done = false;
+static double g_startMs = nowMs();
+static double g_lastTickMs = 0;
+struct SEarlyOutput {
+    WP<Aquamarine::IOutput> output;
+    bool                    flipPending = false; // lightUp's modeset blocks; a tick's flip does not
+};
+static std::vector<SEarlyOutput> g_litEarly;
+
+static double easeOutCubic(double x) {
+    x = std::clamp(x, 0.0, 1.0);
+    return 1 - std::pow(1 - x, 3);
+}
+
+bool StartupSplash::active() {
+    static auto PLOGO = CConfigValue<Config::STRING>("misc:startup_splash_logo");
+    // a logo that can't be loaded draws nothing, and must not hide the pointer meanwhile
+    return !g_done && image(cleaned(*PLOGO)) != nullptr;
+}
+
+StartupSplash::SState StartupSplash::state() {
+    static auto PFINISH  = CConfigValue<Config::INTEGER>("misc:startup_splash_finish");
+    static auto PFILL    = CConfigValue<Config::INTEGER>("misc:startup_splash_fill_duration");
+    static auto PFADE    = CConfigValue<Config::INTEGER>("misc:startup_splash_fade_duration");
+    static auto PTIMEOUT = CConfigValue<Config::INTEGER>("misc:startup_splash_timeout");
+
+    SState      st;
+    if (!active()) {
+        st.done = true;
+        return st;
+    }
+
+    const double NOW = nowMs();
+    // asked to finish, or nobody did in time: a splash must never keep the desktop hidden
+    if (!g_finishMs && (*PFINISH || (*PTIMEOUT > 0 && NOW - g_startMs > *PTIMEOUT * 1000.0))) {
+        g_finishMs   = NOW;
+        g_finishFrom = progress();
+    }
+
+    st.progress = progress(&st.barMoving);
+    if (!g_finishMs)
+        return st;
+
+    const double SINCE = NOW - g_finishMs;
+    st.finishing       = true;
+    st.barMoving       = true;
+    if (SINCE < *PFILL) {
+        st.progress = g_finishFrom + (1 - g_finishFrom) * easeOutCubic(SINCE / std::max<double>(1, *PFILL));
+        return st;
+    }
+
+    st.progress = 1;
+    st.fading   = true;
+    // announce the fade as it starts, so whatever waits on the splash (an intro) can begin with it
+    static bool announced = false;
+    if (!announced) {
+        announced = true;
+        g_pEventLoopManager->doLater([] { IPC::Socket2::sock()->postEvent({.event = "startupsplash", .data = "fade"}); });
+    }
+    st.alpha    = 1 - easeOutCubic((SINCE - *PFILL) / std::max<double>(1, *PFADE));
+    if (SINCE >= *PFILL + *PFADE) {
+        g_done  = true;
+        st.done = true;
+    }
+    return st;
+}
+
+cairo_surface_t* StartupSplash::image(const std::string& path) {
+    static std::unordered_map<std::string, cairo_surface_t*> cache;
+
+    if (path.empty())
+        return nullptr;
+
+    if (const auto it = cache.find(path); it != cache.end())
+        return it->second;
+
+    cairo_surface_t* surface = cairo_image_surface_create_from_png(path.c_str());
+    if (cairo_surface_status(surface) != CAIRO_STATUS_SUCCESS) {
+        LOG(Log::ERR, "startup splash: couldn't load {}", path);
+        cairo_surface_destroy(surface);
+        surface = nullptr;
+    }
+
+    cache[path] = surface;
+    return surface;
+}
+
+// Plymouth's device scale for a display with a native driver: 2 above 1.625 times the target
+// density, and 1 when the panel's size is unknown or is really an aspect ratio.
+static double deviceScale(const Vector2D& size, const Vector2D& mm) {
+    if ((mm.x == 160 && (mm.y == 90 || mm.y == 100)) || (mm.x == 16 && (mm.y == 9 || mm.y == 10)))
+        return 1;
+    if (mm.x <= 0 || mm.y <= 0)
+        return 1;
+
+    const double inches = std::sqrt(mm.x * mm.x + mm.y * mm.y) / 25.4;
+    const double dpi    = std::sqrt(size.x * size.x + size.y * size.y) / inches;
+    return dpi / (inches >= 20 ? 110 : 135) > 1.625 ? 2 : 1;
+}
+
+std::optional<StartupSplash::SLayout> StartupSplash::layout(const Vector2D& physicalSizeMm, const Vector2D& pixelSize) {
+    static auto PLOGO   = CConfigValue<Config::STRING>("misc:startup_splash_logo");
+    static auto PBAR    = CConfigValue<Config::STRING>("misc:startup_splash_bar");
+    static auto PBOX    = CConfigValue<Config::STRING>("misc:startup_splash_bar_box");
+    static auto POFFSET = CConfigValue<Config::FLOAT>("misc:startup_splash_bar_offset");
+    static auto PSTART  = CConfigValue<Config::INTEGER>("misc:startup_splash_bar_start");
+
+    const auto  LOGO = image(cleaned(*PLOGO));
+    if (!LOGO || pixelSize.x <= 0 || pixelSize.y <= 0)
+        return std::nullopt;
+
+    SLayout l;
+    static auto PSCALE = CConfigValue<Config::FLOAT>("misc:startup_splash_scale");
+    l.unit             = *PSCALE > 0 ? *PSCALE : deviceScale(pixelSize, physicalSizeMm);
+
+    // Plymouth works in device-independent pixels and places sprites at whole ones.
+    const double W  = pixelSize.x / l.unit, H = pixelSize.y / l.unit;
+    const double LW = cairo_image_surface_get_width(LOGO), LH = cairo_image_surface_get_height(LOGO);
+    const double LX = std::floor(W / 2 - LW / 2), LY = std::floor(H / 2 - LH / 2);
+    l.logo          = CBox{LX, LY, LW, LH}.scale(l.unit);
+
+    const auto BAR = image(cleaned(*PBAR));
+    const auto BOX = image(cleaned(*PBOX));
+    if (*PSTART > 0 && BAR && BOX) {
+        const double BW = cairo_image_surface_get_width(BOX), BH = cairo_image_surface_get_height(BOX);
+        const double PW = cairo_image_surface_get_width(BAR), PH = cairo_image_surface_get_height(BAR);
+        const double BY = std::floor(LY + LH + *POFFSET);
+        l.box           = CBox{std::floor(W / 2 - BW / 2), BY, BW, BH}.scale(l.unit);
+        l.bar           = CBox{std::floor(W / 2 - PW / 2), std::floor(BY + (BH - PH) / 2), PW, PH}.scale(l.unit);
+        l.hasBar        = true;
+    }
+
+    return l;
+}
+
+double StartupSplash::progress(bool* moving) {
+    static auto PSTART    = CConfigValue<Config::INTEGER>("misc:startup_splash_bar_start");
+    static auto PLIMIT    = CConfigValue<Config::FLOAT>("misc:startup_splash_bar_limit");
+    static auto PDURATION = CConfigValue<Config::FLOAT>("misc:startup_splash_bar_duration");
+
+    timespec    now{};
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    const double NOWMS   = now.tv_sec * 1000.0 + now.tv_nsec / 1000000.0;
+    const double ELAPSED = (NOWMS - *PSTART) / 1000.0;
+    const double RATIO   = std::clamp(*PDURATION > 0 ? ELAPSED / *PDURATION : 1.0, 0.0, 1.0);
+
+    if (moving)
+        *moving = RATIO < 1;
+
+    // Plymouth's ease-out quadratic towards the limit
+    return *PLIMIT * (1 - (1 - RATIO) * (1 - RATIO));
+}
+
+void StartupSplash::paint(uint8_t* data, int width, int height, int stride, const Vector2D& physicalSizeMm, uint32_t background) {
+    auto surface = cairo_image_surface_create_for_data(data, CAIRO_FORMAT_RGB24, width, height, stride);
+    auto cr      = cairo_create(surface);
+
+    cairo_set_source_rgb(cr, ((background >> 16) & 0xff) / 255.0, ((background >> 8) & 0xff) / 255.0, (background & 0xff) / 255.0);
+    cairo_set_operator(cr, CAIRO_OPERATOR_SOURCE);
+    cairo_paint(cr);
+    cairo_set_operator(cr, CAIRO_OPERATOR_OVER);
+
+    const auto L = active() ? layout(physicalSizeMm, {width, height}) : std::nullopt;
+    if (L) {
+        static auto PLOGO = CConfigValue<Config::STRING>("misc:startup_splash_logo");
+        static auto PBAR  = CConfigValue<Config::STRING>("misc:startup_splash_bar");
+        static auto PBOX  = CConfigValue<Config::STRING>("misc:startup_splash_bar_box");
+
+        auto        draw = [&](cairo_surface_t* img, const CBox& box) {
+            cairo_save(cr);
+            cairo_translate(cr, box.x, box.y);
+            cairo_scale(cr, box.w / cairo_image_surface_get_width(img), box.h / cairo_image_surface_get_height(img));
+            cairo_set_source_surface(cr, img, 0, 0);
+            cairo_pattern_set_filter(cairo_get_source(cr), CAIRO_FILTER_BILINEAR);
+            cairo_paint(cr);
+            cairo_restore(cr);
+        };
+
+        draw(image(cleaned(*PLOGO)), L->logo);
+        if (L->hasBar) {
+            draw(image(cleaned(*PBOX)), L->box);
+            const double PW   = cairo_image_surface_get_width(image(cleaned(*PBAR)));
+            const double FILL = std::max(1.0, std::floor(PW * state().progress));
+            draw(image(cleaned(*PBAR)), CBox{L->bar.x, L->bar.y, FILL * L->unit, L->bar.h});
+        }
+    }
+
+    cairo_destroy(cr);
+    cairo_surface_flush(surface);
+    cairo_surface_destroy(surface);
+}
+
+bool StartupSplash::paintBuffer(SP<Aquamarine::IBuffer> buffer, const Vector2D& physicalSizeMm) {
+    static auto PBACKGROUNDCOLOR = CConfigValue<Config::INTEGER>("misc:background_color");
+
+    const auto  ATTRS = buffer->dmabuf();
+    if (!ATTRS.success || (ATTRS.format != DRM_FORMAT_XRGB8888 && ATTRS.format != DRM_FORMAT_ARGB8888))
+        return false;
+
+    auto [data, format, size] = buffer->beginDataPtr(1 << 1 /* GBM_BO_TRANSFER_WRITE */);
+    const int HEIGHT          = sc<int>(buffer->size.y);
+    const bool OK             = data && HEIGHT > 0 && size > 0;
+    if (OK)
+        paint(data, sc<int>(buffer->size.x), HEIGHT, sc<int>(size / HEIGHT), physicalSizeMm, sc<uint32_t>(*PBACKGROUNDCOLOR));
+    buffer->endDataPtr();
+    return OK;
+}
+
+void StartupSplash::lightUp(SP<Aquamarine::IOutput> output) {
+    if (!active() || !output || output->nonDesktop || !output->swapchain)
+        return;
+
+    const auto MODE = output->preferredMode();
+    if (!MODE)
+        return;
+
+    output->state->setEnabled(true);
+    output->state->setMode(MODE);
+    output->state->setFormat(DRM_FORMAT_XRGB8888);
+
+    auto options    = output->swapchain->currentOptions();
+    options.format  = DRM_FORMAT_XRGB8888;
+    options.scanout = true;
+    options.length  = 3;
+    options.size    = MODE->pixelSize;
+    if (!output->swapchain->reconfigure(options))
+        return;
+
+    const auto BUFFER = output->swapchain->next(nullptr);
+    if (!BUFFER || !paintBuffer(BUFFER, output->physicalSize))
+        return;
+
+    output->state->setBuffer(BUFFER);
+    if (!output->commit()) {
+        LOG(Log::WARN, "startup splash: couldn't light up {} early", output->name);
+        return;
+    }
+    LOG(Log::DEBUG, "startup splash: lit up {} early", output->name);
+    g_litEarly.emplace_back(SEarlyOutput{.output = output});
+    g_lastTickMs = nowMs();
+}
+
+void StartupSplash::tick(SP<Aquamarine::CBackend> backend) {
+    if (g_litEarly.empty() || !active() || !backend || nowMs() - g_lastTickMs < 30)
+        return;
+
+    const auto POLLFDS = backend->getPollFDs();
+    for (auto& early : g_litEarly) {
+        const auto OUTPUT = early.output.lock();
+        if (!OUTPUT || !OUTPUT->swapchain || !OUTPUT->getBackend())
+            continue;
+
+        // the previous flip completes on this GPU's DRM fd, which nothing else reads before the event loop runs;
+        // until it has, the buffer it flipped to may still be on screen, so leave the output alone
+        if (early.flipPending) {
+            const int FD = OUTPUT->getBackend()->drmFD();
+            for (auto const& pfd : POLLFDS) {
+                if (!pfd || pfd->fd != FD || !pfd->onSignal)
+                    continue;
+                pollfd p{.fd = pfd->fd, .events = POLLIN, .revents = 0};
+                if (poll(&p, 1, 16) > 0) {
+                    pfd->onSignal();
+                    early.flipPending = false;
+                }
+            }
+            if (early.flipPending)
+                continue;
+        }
+
+        const auto BUFFER = OUTPUT->swapchain->next(nullptr);
+        if (!BUFFER || !paintBuffer(BUFFER, OUTPUT->physicalSize))
+            continue;
+        OUTPUT->state->setBuffer(BUFFER);
+        early.flipPending = OUTPUT->commit();
+    }
+    g_lastTickMs = nowMs();
+}
+
+void StartupSplash::handOver(SP<Aquamarine::IOutput> output) {
+    std::erase_if(g_litEarly, [&output](const auto& early) { return !early.output || early.output.lock() == output; });
+}
