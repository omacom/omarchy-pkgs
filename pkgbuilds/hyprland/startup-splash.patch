+void IHyprRenderer::renderStartupSplash(CRenderContext& ctx, PHLMONITOR pMonitor) {
+    static auto PLOGO            = CConfigValue<Config::STRING>("misc:startup_splash_logo");
+    static auto PBAR             = CConfigValue<Config::STRING>("misc:startup_splash_bar");
+    static auto PBOX             = CConfigValue<Config::STRING>("misc:startup_splash_bar_box");
+    static auto PBACKGROUNDCOLOR = CConfigValue<Config::INTEGER>("misc:background_color");
+
+    const auto  STATE = StartupSplash::state();
+    if (STATE.done) {
+        // the pointer comes back with the desktop
+        g_pEventLoopManager->doLater([] { g_pHyprRenderer->ensureCursorRenderingMode(); });
+        return;
+    }
+
+    const auto LAYOUT = StartupSplash::layout(pMonitor->m_output ? pMonitor->m_output->physicalSize : Vector2D{}, pMonitor->m_transformedSize);
+    if (!LAYOUT)
+        return;
+
+    // kept here rather than as a member, so the renderer's layout (which plugins build against) stays put
+    static std::unordered_map<std::string, SP<ITexture>> textures;
+    auto                                                 texture = [this](const std::string& path) -> SP<ITexture> {
+        auto& tex = textures[path];
+        if (!tex) {
+            if (const auto IMG = StartupSplash::image(path))
+                tex = createTexture(IMG);
+        }
+        return tex;
+    };
+
+    auto draw = [&](const std::string& path, const CBox& box) {
+        const auto TEX = texture(path);
+        if (!TEX)
+            return;
+        CTexPassElement::SRenderData data;
+        data.tex = TEX;
+        data.box = box;
+        data.a   = STATE.alpha;
+        addPassElement(ctx, makeUnique<CTexPassElement>(std::move(data)));
+    };
+
+    // over everything, until the session underneath is ready to be shown
+    CRectPassElement::SRectData bg;
+    bg.box   = {0, 0, pMonitor->m_transformedSize.x, pMonitor->m_transformedSize.y};
+    // never quite opaque, so the render pass doesn't cull what is underneath: clients keep getting their
+    // frames presented, and a video under the splash keeps playing rather than queueing up
+    bg.color = CHyprColor(*PBACKGROUNDCOLOR).modifyA(std::min(STATE.alpha, 0.9999));
+    addPassElement(ctx, makeUnique<CRectPassElement>(bg));
+
+    draw(*PLOGO, LAYOUT->logo);
+
+    if (LAYOUT->hasBar) {
+        draw(*PBOX, LAYOUT->box);
+        const double FILL = std::max(1.0, std::floor(LAYOUT->bar.w / LAYOUT->unit * STATE.progress));
+        draw(*PBAR, CBox{LAYOUT->bar.x, LAYOUT->bar.y, FILL * LAYOUT->unit, LAYOUT->bar.h});
+    }
+
+    // a splash nobody finishes finishes itself: wake up for it even if nothing else draws
+    static SP<CEventLoopTimer> timeout;
+    if (!timeout) {
+        static auto PTIMEOUT = CConfigValue<Config::INTEGER>("misc:startup_splash_timeout");
+        if (*PTIMEOUT > 0) {
+            timeout = makeShared<CEventLoopTimer>(std::chrono::seconds(*PTIMEOUT) + std::chrono::milliseconds(50), [](SP<CEventLoopTimer>, void*) {
+                for (auto const& m : State::monitorState()->monitors()) {
+                    g_pHyprRenderer->damageMonitor(m);
+                }
+            }, nullptr);
+            g_pEventLoopManager->addTimer(timeout);
+        }
+    }
+
+    // keep it moving: everything while it fills and fades, the bar while it eases out
+    if (STATE.finishing)
+        g_pEventLoopManager->doLater([mon = PHLMONITORREF{pMonitor}] {
+            if (mon)
+                g_pHyprRenderer->damageMonitor(mon.lock());
+        });
+    else if (STATE.barMoving && LAYOUT->hasBar) {
+        CBox damage = LAYOUT->bar;
+        damage.scale(1.0 / pMonitor->m_scale).translate(pMonitor->m_position).expand(2);
+        g_pEventLoopManager->doLater([damage] { g_pHyprRenderer->damageBox(damage); });
+    }
+
+    if (STATE.fading)
+        g_pEventLoopManager->doLater([] { g_pHyprRenderer->ensureCursorRenderingMode(); });
+}
