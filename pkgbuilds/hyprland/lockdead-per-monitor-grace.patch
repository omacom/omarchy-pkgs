+
+// The lock-wide delay alone shows lockdead on the first frame of a monitor that comes back
+// mid-lock, before a live client has had any chance to put a surface on it.
+bool CSessionLockManager::shallConsiderLockMissingOnMonitor(PHLMONITOR pMonitor) {
+    if (!m_sessionLock || !pMonitor)
+        return shallConsiderLockMissing();
+
+    static auto LOCKDEAD_SCREEN_DELAY = CConfigValue<Config::INTEGER>("misc:lockdead_screen_delay");
+
+    const auto [it, inserted] = m_sessionLock->surfaceMissing.try_emplace(pMonitor->m_id);
+    if (inserted) {
+        it->second.since = Time::steadyNow();
+        // A display waking from DPMS is a returning monitor too. Restart rather than
+        // erase: this listener is the one being emitted.
+        it->second.dpms = pMonitor->m_events.dpmsChanged.listen([this, id = pMonitor->m_id] {
+            if (!m_sessionLock || !m_sessionLock->surfaceMissing.contains(id))
+                return;
+            m_sessionLock->surfaceMissing.at(id).since = Time::steadyNow();
+            armLockMissingTimer();
+        });
+        armLockMissingTimer();
+    }
+
+    return shallConsiderLockMissing() &&
+        std::chrono::duration_cast<std::chrono::milliseconds>(Time::steadyNow() - it->second.since).count() > *LOCKDEAD_SCREEN_DELAY;
+}
+
+// Nothing else may damage a monitor whose grace runs out, so redraw it then.
+void CSessionLockManager::armLockMissingTimer() {
+    if (!m_sessionLock)
+        return;
+
+    static auto LOCKDEAD_SCREEN_DELAY = CConfigValue<Config::INTEGER>("misc:lockdead_screen_delay");
+
+    const auto                     NOW   = Time::steadyNow();
+    const auto                     DELAY = std::chrono::milliseconds(*LOCKDEAD_SCREEN_DELAY + 1);
+    std::optional<Time::steady_tp> next;
+
+    // The lock-wide delay must have passed too, and is never later than a monitor's own.
+    for (auto const& [id, missing] : m_sessionLock->surfaceMissing) {
+        const auto DUE = std::max(missing.since, m_sessionLock->lockStart) + DELAY;
+        if (DUE > NOW && (!next || DUE < *next))
+            next = DUE;
+    }
+
+    if (!next)
+        return;
+
+    if (!m_sessionLock->lockMissingTimer) {
+        m_sessionLock->lockMissingTimer = makeShared<CEventLoopTimer>(
+            std::nullopt,
+            [](auto, auto) {
+                if (!g_pSessionLockManager || !g_pSessionLockManager->m_sessionLock)
+                    return;
+
+                for (auto const& m : State::monitorState()->monitors()) {
+                    if (g_pSessionLockManager->m_sessionLock->surfaceMissing.contains(m->m_id))
+                        g_pHyprRenderer->damageMonitor(m);
+                }
+
+                g_pSessionLockManager->armLockMissingTimer();
+            },
+            nullptr);
+        g_pEventLoopManager->addTimer(m_sessionLock->lockMissingTimer);
+    }
+
+    m_sessionLock->lockMissingTimer->updateTimeout(*next - NOW);
+}
+
+SSessionLock::~SSessionLock() {
+    if (lockMissingTimer && g_pEventLoopManager)
+        g_pEventLoopManager->removeTimer(lockMissingTimer);
+}
