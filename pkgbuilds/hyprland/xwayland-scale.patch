+bool CX11Backend::unscaled() const {
+    // An X11 app that draws at 1x whatever it is told (Steam's updater, an old Xlib or SDL program)
+    // would come out at 1 / scale of its size: it is shown at its X11 size in logical pixels
+    // instead, its pixels enlarged, as a HiDPI desktop shows an app that was never made for it.
+    static auto PUNSCALED = CConfigValue<Config::BOOL>("xwayland:unscaled_windows");
+    const auto  WINDOW    = m_window.lock();
+    if (!*PUNSCALED || !WINDOW)
+        return false;
+
+    return (WINDOW->m_ruleApplicator && WINDOW->m_ruleApplicator->xwaylandUnscaled().valueOrDefault()) || unscaledOwner();
+}
+
+double CX11Backend::x11Scale(PHLMONITOR monitor) const {
+    // X11 pixels to a logical pixel: the monitor's X11 scale (1, its own with force_zero_scaling, or
+    // xwayland:scale's for every monitor), or 1 for a window that draws unscaled and is enlarged instead
+    const auto MONITOR = preferredMonitor(monitor);
+    if (!MONITOR || unscaled())
+        return 1.0;
+
+    return MONITOR->m_xwaylandScale;
+}
+
+PHLWINDOW CX11Backend::unscaledOwner() const {
+    static auto PUNSCALED = CConfigValue<Config::BOOL>("xwayland:unscaled_windows");
+    const auto  SURFACE   = m_xwaylandSurface.lock();
+    if (!*PUNSCALED || !SURFACE || !SURFACE->m_overrideRedirect || m_pid <= 0)
+        return nullptr;
+
+    // the window this menu or tooltip belongs to: the one it is transient for, through the menus it
+    // was opened from, or else the one of the app's windows it lies in or nearest to
+    auto parent = SURFACE->m_parent.lock();
+    for (size_t depth = 0; parent && parent->m_overrideRedirect && depth < 16; ++depth)
+        parent = parent->m_parent.lock();
+    if (parent && parent->m_overrideRedirect)
+        parent.reset();
+
+    const auto POS     = SURFACE->m_geometry.pos();
+    double     nearest = std::numeric_limits<double>::max();
+    PHLWINDOW  owner;
+    for (auto const& w : Desktop::windowState()->windows()) {
+        const auto X11   = w ? dc<const CX11Backend*>(&w->backend()) : nullptr;
+        const auto OTHER = X11 ? X11->m_xwaylandSurface.lock() : nullptr;
+        if (!OTHER || X11 == this || !w->mapped() || OTHER->m_overrideRedirect)
+            continue;
+        if (parent) {
+            if (OTHER == parent) {
+                owner = w;
+                break;
+            }
+            continue;
+        }
+        if (X11->m_pid != m_pid)
+            continue;
+        if (const auto DISTANCE = OTHER->m_geometry.closestPoint(POS).distance(POS); DISTANCE < nearest) {
+            nearest = DISTANCE;
+            owner   = w;
+        }
+    }
+
+    if (!owner || !owner->m_ruleApplicator || !owner->m_ruleApplicator->xwaylandUnscaled().valueOrDefault())
+        return nullptr;
+    return owner;
+}
+
+Vector2D CX11Backend::clientToLogicalPos(const Vector2D& pos, PHLMONITOR monitor) const {
+    // a menu or tooltip of an app that draws unscaled lies in its window's pixels, enlarged with them
+    if (const auto OWNER = unscaledOwner(); OWNER) {
+        if (const auto OWNERSURFACE = dc<const CX11Backend*>(&OWNER->backend())->m_xwaylandSurface.lock(); OWNERSURFACE)
+            return OWNER->position(IGeometric::GEOMETRIC_GOAL) + (pos - OWNERSURFACE->m_geometry.pos());
+    }
+
+    return g_pXWaylandManager->xwaylandToWaylandCoords(pos, monitor);
+}
+
+Vector2D CX11Backend::logicalToClientPos(const Vector2D& pos, PHLMONITOR monitor) const {
+    if (const auto OWNER = unscaledOwner(); OWNER) {
+        if (const auto OWNERSURFACE = dc<const CX11Backend*>(&OWNER->backend())->m_xwaylandSurface.lock(); OWNERSURFACE)
+            return OWNERSURFACE->m_geometry.pos() + (pos - OWNER->position(IGeometric::GEOMETRIC_GOAL));
+    }
+
+    return g_pXWaylandManager->waylandToXWaylandCoords(pos, monitor);
 }
 
