+// as before.
+static float x11CursorScale(SP<Desktop::View::CWLSurface> surf) {
+    if (!surf || !surf->resource() || !g_pXWayland || !g_pXWayland->m_server || surf->resource()->client() != g_pXWayland->m_server->m_xwaylandClient)
