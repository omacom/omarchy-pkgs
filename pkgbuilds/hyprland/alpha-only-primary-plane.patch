+// Whether the output's primary plane can scan out drmFormat. An output that lists no formats is
+// taken to accept any.
+static bool outputOffersFormat(const SP<Aquamarine::IOutput>& output, uint32_t drmFormat) {
+    const auto FORMATS = output->getRenderFormats();
+    return FORMATS.empty() || std::ranges::any_of(FORMATS, [drmFormat](const auto& f) { return f.drmFormat == drmFormat; });
+}
+
+// Some display engines blend the X byte of an XRGB surface as alpha, and their drivers offer only
+// formats with alpha on the primary plane (Apple M5, appledrm). Such a plane offers no format
+// without alpha at any depth; a plane that lacks only the 10-bit ones is not one of them.
+static bool outputIsAlphaOnly(const SP<Aquamarine::IOutput>& output) {
+    static constexpr auto OPAQUE = std::to_array<uint32_t>({DRM_FORMAT_XRGB8888, DRM_FORMAT_XBGR8888, DRM_FORMAT_XRGB2101010, DRM_FORMAT_XBGR2101010});
+    return std::ranges::none_of(OPAQUE, [&output](uint32_t f) { return outputOffersFormat(output, f); });
+}
+
+// The formats to try at one depth: the ones without alpha, then, on an alpha-only plane, their
+// alpha variants. Everywhere else nothing changes.
+static std::vector<uint32_t> outputFormatsToTry(const SP<Aquamarine::IOutput>& output, std::initializer_list<uint32_t> opaque, std::initializer_list<uint32_t> alpha) {
+    std::vector<uint32_t> formats{opaque};
+    if (outputIsAlphaOnly(output))
+        formats.insert(formats.end(), alpha);
+    return formats;
+}
