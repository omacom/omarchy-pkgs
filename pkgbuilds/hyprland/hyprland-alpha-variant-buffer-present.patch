+// A scanout plane that offers only the alpha variant of a format (the T6041 internal panel on
+// macOS 27 firmware) gets alpha-variant buffers from aquamarine's fallback while the monitor keeps
+// the opaque format. Treat the two as the same, or every commit swaps the frame just rendered for
+// a stale swapchain buffer.
+static uint32_t opaqueScanoutFormat(uint32_t format) {
+    switch (format) {
+        case DRM_FORMAT_ARGB8888: return DRM_FORMAT_XRGB8888;
+        case DRM_FORMAT_ABGR8888: return DRM_FORMAT_XBGR8888;
+        case DRM_FORMAT_ARGB2101010: return DRM_FORMAT_XRGB2101010;
+        case DRM_FORMAT_ABGR2101010: return DRM_FORMAT_XBGR2101010;
+        default: return format;
+    }
+}
+
 void CMonitorState::ensureBufferPresent() {
     const auto& STATE = m_owner->m_output->state->state();
     if (!STATE.enabled) {
@@ -2590,7 +2604,7 @@
     }
 
     if (STATE.buffer) {
-        if (const auto params = STATE.buffer->dmabuf(); params.success && params.format == m_owner->m_drmFormat)
+        if (const auto params = STATE.buffer->dmabuf(); params.success && opaqueScanoutFormat(params.format) == opaqueScanoutFormat(m_owner->m_drmFormat))
             return;
     }
 
