+TEST_F(CDMABUFFeedbackTest, ScanoutFeedbackIncludesLinearFallbackTrancheAfterNonLinear) {
+    SDMABUFTranche renderer{
+        .device = 1,
+        .formats =
+            {
+                {DRM_FORMAT_XRGB8888, {I915_FORMAT_MOD_Y_TILED, DRM_FORMAT_MOD_LINEAR}},
+                {DRM_FORMAT_NV12, {DRM_FORMAT_MOD_LINEAR}},
+            },
+    };
+    std::vector<std::pair<PHLMONITORREF, SDMABUFTranche>> monitors;
+    monitors.emplace_back(m_monitor,
+                          SDMABUFTranche{
+                              .device = 1,
+                              .flags  = ZWP_LINUX_DMABUF_FEEDBACK_V1_TRANCHE_FLAGS_SCANOUT,
+                              .formats =
+                                  {
+                                      {DRM_FORMAT_XRGB8888, {I915_FORMAT_MOD_X_TILED, DRM_FORMAT_MOD_LINEAR}},
+                                      {DRM_FORMAT_ARGB8888, {DRM_FORMAT_MOD_LINEAR}},
+                                      {DRM_FORMAT_NV12, {DRM_FORMAT_MOD_LINEAR}},
+                                  },
+                          });
+    setFormatTable(makeUnique<CDMABUFFormatTable>(renderer, monitors));
+
+    makeWindow();
+    uint32_t id = 0;
+    bindFeedback(id, true);
+    PROTO::linuxDma->updateScanoutTranche(m_surface, m_monitor);
+    readFeedback();
+
+    const std::vector<SFeedbackTranche> expected = {
+        {ZWP_LINUX_DMABUF_FEEDBACK_V1_TRANCHE_FLAGS_SCANOUT, {{DRM_FORMAT_XRGB8888, I915_FORMAT_MOD_X_TILED}}},
+        {ZWP_LINUX_DMABUF_FEEDBACK_V1_TRANCHE_FLAGS_SCANOUT, {{DRM_FORMAT_XRGB8888, DRM_FORMAT_MOD_LINEAR}}},
+        {0, {{DRM_FORMAT_XRGB8888, I915_FORMAT_MOD_Y_TILED}, {DRM_FORMAT_XRGB8888, DRM_FORMAT_MOD_LINEAR}, {DRM_FORMAT_NV12, DRM_FORMAT_MOD_LINEAR}}},
+    };
+    EXPECT_EQ(m_feedback.at(id).tranches, expected);
+}
