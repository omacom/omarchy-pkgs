+static SDMABUFTranche buildLinearScanoutTranche(const CDMABUFFormatTable& table, const SDMABUFTranche& monitorTranche) {
+    SDMABUFTranche linearTranche{
+        .device = monitorTranche.device,
+        .flags  = monitorTranche.flags,
+    };
+
+    if (!table.m_tableFD.isValid() || table.m_tableSize < sizeof(SDMABUFFormatTableEntry))
+        return linearTranche;
+
+    std::vector<SDMABUFFormatTableEntry> entries(table.m_tableSize / sizeof(SDMABUFFormatTableEntry));
+    if (pread(table.m_tableFD.get(), entries.data(), table.m_tableSize, 0) != sc<ssize_t>(table.m_tableSize))
+        return linearTranche;
+
+    std::set<uint16_t> seen;
+    for (auto const& fmt : monitorTranche.formats) {
+        if (NFormatUtils::isFormatYUV(fmt.drmFormat))
+            continue;
+
+        if (std::ranges::none_of(fmt.modifiers, [](uint64_t mod) { return mod == DRM_FORMAT_MOD_LINEAR; }))
+            continue;
+
+        for (const auto idx : table.m_rendererTranche.indices) {
+            if (idx >= entries.size())
+                continue;
+            if (entries[idx].fmt == fmt.drmFormat && entries[idx].modifier == DRM_FORMAT_MOD_LINEAR) {
+                if (seen.insert(idx).second)
+                    linearTranche.indices.push_back(idx);
+                break;
+            }
+        }
+    }
+
+    return linearTranche;
+}
