# Maintainer: David Pietrzak <https://github.com/dtpietrzak>

pkgname=yeptes
pkgver=0.3.0
pkgrel=1
# The repository is omarchy-yeptes; the app and package are yeptes.
_srcname=omarchy-yeptes
pkgdesc='A plain text notepad with Markdown, JSON, HTML, table, code, and diff views'
arch=('x86_64' 'aarch64')
url='https://github.com/dtpietrzak/omarchy-yeptes'
license=('MIT')
install='yeptes.install'
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
  'xdg-desktop-portal'
)
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ae15eb0ab42b73e749fe9ded2574ebfc9bd0bb562f91ad1f3524e034bb7d406a')

build() {
  cd "$srcdir/$_srcname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$_srcname-$pkgver"
  ./bin/test
}

package() {
  cd "$srcdir/$_srcname-$pkgver"

  install -Dm755 build/yeptes "$pkgdir/usr/bin/yeptes"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/yeptes.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/yeptes.svg"
  install -Dm644 pkgbuild/yeptes.desktop "$pkgdir/usr/share/applications/yeptes.desktop"
  # Teaches the desktop that .ypts files are Yeptes notes.
  install -Dm644 pkgbuild/yeptes.xml "$pkgdir/usr/share/mime/packages/yeptes.xml"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
