# Active/idle power management for the ASUS Zenbook A16 (UX3607OA, Glymur).

# Positive DMI guard so machines without DMI or with another board name skip all rules.
ATTR{[dmi/id]board_name}=="UX3607OA", GOTO="zenbook_a16_power_start"
GOTO="zenbook_a16_power_end"
LABEL="zenbook_a16_power_start"

# Stop the 500 Hz x 3 SCMI mailbox polling storm on CPUCP DDR/LLCC devfreq
# devices on kernels before 7.3.6-6. Hardware DVFS runs autonomously on CPUCP.
ACTION=="add|change", SUBSYSTEM=="devfreq", KERNEL=="ddr|ddr-qos|llcc", \
  ATTR{polling_interval}="0"

# Enable runtime PM auto-suspend on idle Qualcomm USB controllers and PHYs so
# unused USB GDSCs (gcc_usb30_prim_gdsc, gcc_usb30_mp_gdsc, ss0/ss1 PHY GDSCs)
# power down instead of staying active at idle.
ACTION=="add|bind|change", SUBSYSTEM=="platform", DRIVER=="dwc3-qcom", \
  ATTR{power/control}="auto", ATTR{power/autosuspend_delay_ms}="200"
ACTION=="add|bind|change", SUBSYSTEM=="platform", DRIVER=="xhci-hcd", \
  ATTR{power/control}="auto"
ACTION=="add|bind|change", SUBSYSTEM=="platform", DRIVER=="qcom-qmp-combo-phy|qcom-qmp-usb-phy", \
  ATTR{power/control}="auto"

# Let the internal Realtek USB3 SD card reader (0bda:0329) autosuspend and slow
# empty-slot media polling from 2 s to 15 s so a400000.usb stays suspended ~96%
# of the time while preserving SD card hot-insert detection.
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="0329", \
  ATTR{power/control}="auto", ATTR{power/autosuspend_delay_ms}="200"
ACTION=="add|bind|change", SUBSYSTEM=="scsi", ENV{DEVTYPE}=="scsi_device", \
  ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="0329", \
  ATTR{power/control}="auto", ATTR{power/autosuspend_delay_ms}="200"
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", \
  ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="0329", \
  ATTR{events_poll_msecs}="15000"

LABEL="zenbook_a16_power_end"
