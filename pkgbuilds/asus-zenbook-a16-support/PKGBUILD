# Maintainer: The Omarchy Authors

# Hardware support for the ASUS Zenbook A16 (UX3607OA, Snapdragon X2 Elite)
# that no upstream package carries yet.

pkgname=asus-zenbook-a16-support
pkgver=1
pkgrel=7
pkgdesc="Hardware support for the ASUS Zenbook A16 (UX3607OA) not yet carried upstream"
arch=('aarch64')
# Qualcomm-only: the pacman platform guard keeps it off other hardware.
groups=('omarchy-platform-qualcomm')
url="https://github.com/omacom/omarchy-pkgs"
license=('MIT')
depends=('bash' 'systemd' 'util-linux' 'wireplumber'
         'libcamera' 'gst-plugin-libcamera' 'gst-plugins-base' 'gst-plugins-good'
         'V4L2LOOPBACK-MODULE' 'v4l2-relayd' 'v4l-utils')
backup=('etc/v4l2-relayd.d/zenbook-a16.conf')
_libdir=/usr/lib/$pkgname
source=(
  '50-zenbook-a16-cameras.conf'
  '60-zenbook-a16-sleep.conf'
  '90-asus-zenbook-a16-power.rules'
  '99-zenbook-a16-camera.rules'
  'zenbook-a16-sleep'
  'zenbook-a16-camera-gain'
  'zenbook-a16-camera-guard'
  'zenbook-a16-camera-guard.service'
  'zenbook-a16-camera-modprobe.conf'
  'v4l2-relayd-zenbook-a16.conf'
  'v4l2-relayd-zenbook-a16.service.conf'
  'ov02c10.yaml'
  'hm1092.yaml'
  'README.package.md'
  'LICENSE'
)
sha256sums=('2f2474420d092219d263ea368ab8e65d83ec01fdb0aae1c009355c2757a4643f'
            '0e903528d092952ee43a5eff69214a992a0a9107afd07c5395db1318f8bde9ca'
            'c6ed09aabf2822b68c1e6c0f19e146e019b2f0f5765b30a22317661501478dc5'
            'b4ec7c7635a88342226005180b50bdf15a5babea3335d262efca17c0e9f9dc83'
            '5e45bf2304b19bad0a5d1db100f7065cd1845a7c6c9427bd0202e85b68627794'
            'b78a70b71aca81063b21690217a0c9ebdf816fb350ba95ea160d28557f46ae70'
            'dd387aa852baa92f1be131926a9ece87932eb44648792a9dba96ea9a8387a632'
            '15042a4296d5309f2b433865e70838aa7ff1a30ca0a06cabfb4dc90b7b1c5469'
            'e15c5434adabffe29ebcf802a6db33f114c96adf196810f840ebb85270c3d3b8'
            'de6c726e920c73d510f3be7e7d06e4a98cdd752bb5045285c1f7ff6540b97b3c'
            '73d20951b40874adb47eed724177287c2c4305a9a68f673cd2e34b00855bdadd'
            '021c94128c3897064fc1f909a1a492521297829d537b06e522c5e032546bceda'
            '05364eb67ee6fe8852f5ba4492ea5af30118ed56448dcc5f2d4b85927397a1e5'
            '7f4595de5f6b56eadf0b8e87b1effb1aff295807a258080a9a161df4358475ed'
            'c05ddb9629d77776afcea9c4203ea8d4acfa599ab6a475898fe129a4f7ce5321')

package() {
  install -Dm644 50-zenbook-a16-cameras.conf \
    "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/50-zenbook-a16-cameras.conf"
  install -Dm644 60-zenbook-a16-sleep.conf \
    "$pkgdir/usr/lib/systemd/sleep.conf.d/60-zenbook-a16.conf"
  install -Dm644 90-asus-zenbook-a16-power.rules \
    "$pkgdir/usr/lib/udev/rules.d/90-asus-zenbook-a16-power.rules"
  install -Dm644 99-zenbook-a16-camera.rules \
    "$pkgdir/usr/lib/udev/rules.d/99-zenbook-a16-camera.rules"
  install -Dm755 zenbook-a16-sleep \
    "$pkgdir/usr/lib/systemd/system-sleep/zenbook-a16-sleep"

  # Front camera as a V4L2 webcam: v4l2loopback's "Front Camera", filled from
  # libcamera by v4l2-relayd while an app has it open. Enabled by the package;
  # the relay's drop-in checks for this laptop's device tree.
  install -Dm755 zenbook-a16-camera-gain "$pkgdir$_libdir/zenbook-a16-camera-gain"
  install -Dm644 zenbook-a16-camera-modprobe.conf \
    "$pkgdir/usr/lib/modprobe.d/zenbook-a16-camera.conf"
  install -Dm644 v4l2-relayd-zenbook-a16.conf \
    "$pkgdir/etc/v4l2-relayd.d/zenbook-a16.conf"
  install -Dm644 v4l2-relayd-zenbook-a16.service.conf \
    "$pkgdir/usr/lib/systemd/system/v4l2-relayd@zenbook-a16.service.d/zenbook-a16.conf"
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../v4l2-relayd@.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/v4l2-relayd@zenbook-a16.service"

  install -Dm644 ov02c10.yaml "$pkgdir/usr/share/$pkgname/libcamera/ipa/simple/ov02c10.yaml"
  install -Dm644 hm1092.yaml "$pkgdir/usr/share/$pkgname/libcamera/ipa/simple/hm1092.yaml"

  # Restarts the relay when libcamera 0.7.2 leaks its buffers or deadlocks, so
  # the camera doesn't stop mid-call. Enabled by the package; it checks for this
  # laptop's device tree.
  install -Dm755 zenbook-a16-camera-guard "$pkgdir$_libdir/zenbook-a16-camera-guard"
  install -Dm644 zenbook-a16-camera-guard.service \
    "$pkgdir/usr/lib/systemd/system/zenbook-a16-camera-guard.service"
  ln -s ../zenbook-a16-camera-guard.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/zenbook-a16-camera-guard.service"

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
