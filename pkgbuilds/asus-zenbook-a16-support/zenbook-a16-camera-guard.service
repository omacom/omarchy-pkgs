# Restarts the front camera relay when libcamera 0.7.2 leaks its buffers or
# deadlocks, so the camera keeps working through a call. See the script.
[Unit]
Description=Keep the ASUS Zenbook A16 front camera relay working
ConditionFirmware=|device-tree-compatible(asus,zenbook-a16-ux3607oa)
After=v4l2-relayd@zenbook-a16.service
Wants=v4l2-relayd@zenbook-a16.service
StartLimitIntervalSec=0

[Service]
# Stands down once libcamera 0.8.0, which fixes both faults, is installed: the
# unit is then skipped, neither failed nor restarted.
ExecCondition=/usr/lib/asus-zenbook-a16-support/zenbook-a16-camera-guard --needed
ExecStart=/usr/lib/asus-zenbook-a16-support/zenbook-a16-camera-guard
Restart=always
RestartSec=2
