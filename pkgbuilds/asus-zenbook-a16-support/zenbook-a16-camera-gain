#!/bin/sh
# Give the Zenbook A16 front camera's sensor (OV02C10) a fixed digital gain.
# Indoors, auto-exposure on libcamera's software ISP runs out of exposure
# (33 ms at 30 fps) and analogue gain (15.5x) and never uses digital gain, so
# the picture stays dark. In bright light auto-exposure lowers analogue gain to
# match. Run by v4l2-relayd@zenbook-a16 before it starts.
gain=${1:-2048}
for name in "${ZA16_CAMERA_SYSFS:-/sys/class/video4linux}"/v4l-subdev*/name; do
	if grep -qs '^ov02c10 ' "$name"; then
		dev=$(basename "$(dirname "$name")")
		${ZA16_CAMERA_V4L2_CTL:-/usr/bin/v4l2-ctl} -d "/dev/$dev" -c "digital_gain=$gain"
	fi
done
exit 0
