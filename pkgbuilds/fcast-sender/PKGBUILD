# Maintainer: Omarchy Package Repository <https://github.com/omacom/omarchy-pkgs>
# Upstream: https://github.com/futo-org/fcast (senders/desktop)
# Version and checksums are managed by `bin/sync-upstream` via the
# `upstream.git_tags` declaration in .omarchy/package.json.
# NOTE: sender releases are currently betas (sender-X.Y.Z-beta tags);
# the tag pattern consumes the -beta suffix so pkgver stays valid.
pkgname=fcast-sender
pkgver=0.0.3
pkgrel=1
pkgdesc="Sender for playing multimedia content on FCast receivers"
arch=('x86_64' 'aarch64')
url="https://fcast.org/"
license=('GPL-3.0-only')
depends=('libglvnd' 'libxkbcommon' 'wayland' 'libx11' 'libxcursor' 'libxi'
         'libxrandr' 'libxcb' 'fontconfig' 'alsa-lib' 'libpulse' 'gstreamer'
         'gst-plugins-base' 'gst-plugins-good' 'gst-plugins-bad' 'gst-libav'
         'glib2' 'openssl' 'libnice' 'freetype2' 'vulkan-icd-loader'
         'pipewire')
makedepends=('rust' 'clang' 'pkgconf' 'git' 'protobuf')
optdepends=('yt-dlp: playing URLs that need extracting')
# No LTO on the C side: tikv-jemalloc-sys builds jemalloc through
# autotools, and objects carrying LTO bytecode lose their symbols at
# the final Rust link (undefined _rjem_malloc). Rust-side thin LTO
# from the workspace profile is unaffected.
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz"::"https://github.com/futo-org/fcast/archive/refs/tags/sender-${pkgver}-beta.tar.gz")
sha256sums=('50e52219fda1ed6d473619e904e82ae3fe17ee8c1c250474b0b773eecdb01b97')

build() {
  cd "${srcdir}/fcast-sender-${pkgver}-beta"

  # The repo pins the `wild` linker, which is not packaged for Arch.
  # Two more overrides are needed for a working link:
  # - explicit linker + bfd: cargo merges RUSTFLAGS with the repo config
  #   instead of replacing it, so pin everything to be deterministic;
  # - --no-gc-sections: tikv-jemallocator's symbols get garbage-collected
  #   under makepkg's --gc-sections (undefined _rjem_malloc at link);
  # - --no-as-needed: the workspace builds with thin LTO, under which
  #   makepkg's --as-needed drops the jemalloc archive before LTO
  #   resolution (same undefined symbols with any linker).
  export RUSTFLAGS="-C linker=x86_64-linux-gnu-gcc -C link-arg=-fuse-ld=bfd -C link-arg=-Wl,--no-gc-sections -C link-arg=-Wl,--no-as-needed"

  cargo build --locked --release -p desktop-sender
}

package() {
  cd "${srcdir}/fcast-sender-${pkgver}-beta"

  install -Dm755 "target/release/desktop-sender" "${pkgdir}/usr/bin/fcast-sender"

  install -Dm644 ".flatpak/org.fcast.Sender.desktop" "${pkgdir}/usr/share/applications/org.fcast.Sender.desktop"
  install -Dm644 ".flatpak/org.fcast.Sender.metainfo.xml" "${pkgdir}/usr/share/metainfo/org.fcast.Sender.metainfo.xml"

  install -Dm644 "senders/extra/fcast_128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/org.fcast.Sender.png"
  install -Dm644 "senders/extra/fcast_256.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/org.fcast.Sender.png"
  install -Dm644 "senders/extra/fcast_512.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/org.fcast.Sender.png"

  install -Dm644 "senders/extra/LICENSE-GPL" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
