From bfd74e1e0dc969d41698722bccd82c6d58cea5ce Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9s=20Villagr=C3=A1n?= <andres@villagranquiroz.cl>
Date: Tue, 10 Nov 2026 13:18:24 -0300
Subject: [PATCH] menu: Add quiet_wallpaper option

---
 CONFIG.md          |  5 +++++
 common/lib/gterm.c | 28 ++++++++++++++++++++++------
 common/lib/misc.c  |  1 +
 common/lib/misc.h  |  2 +-
 common/menu.c      |  8 +++++++-
 5 files changed, 36 insertions(+), 8 deletions(-)

diff --git i/CONFIG.md w/CONFIG.md
index 46a3b20..6e6db60 100644
--- i/CONFIG.md
+++ w/CONFIG.md
@@ -102,6 +102,11 @@ Miscellaneous:
   `no`, the `timeout` still occurs, and pressing any key during the timeout
   will reveal the menu and disable quiet mode. Where automatic boot is
   disabled, the menu is shown regardless.
+* `quiet_wallpaper` - URI of an image, in the formats `wallpaper` takes, which
+  quiet mode shows on its own during the `timeout`, laid out as per
+  `wallpaper_style` and `backdrop`, and leaves on screen when the default entry
+  is booted. Pressing a key reveals the menu over the regular `wallpaper`.
+  Ignored if the image cannot be loaded or no graphical terminal is available.
 * `serial` - If set to `yes`, enable serial I/O for the bootloader.
 * `serial_baudrate` - If `serial` is set to `yes`, this specifies the baudrate
   to use for serial I/O. Defaults to `115200`, which is also the maximum. The
diff --git i/common/lib/gterm.c w/common/lib/gterm.c
index 74072bd..0eeca10 100644
--- i/common/lib/gterm.c
+++ w/common/lib/gterm.c
@@ -607,16 +607,19 @@ static void gterm_parse_config(char *config, struct gterm_config *cfg) {
         default_fg_bright = strtoui(theme_foreground_bright, NULL, 16);
     }
 
+    // A quiet terminal shows its own image rather than one of the wallpapers.
+    const char *wallpaper_key = quiet ? "QUIET_WALLPAPER" : "WALLPAPER";
+
     size_t wallpaper_count = 0;
-    while (config_get_value(config, wallpaper_count, "WALLPAPER") != NULL)
+    while (config_get_value(config, wallpaper_count, wallpaper_key) != NULL)
         wallpaper_count++;
 
     background = NULL;
     if (wallpaper_count > 0) {
-        if (wallpaper_index >= wallpaper_count) {
+        if (!quiet && wallpaper_index >= wallpaper_count) {
             wallpaper_index = rand32() % wallpaper_count;
         }
-        char *background_path = config_get_value(config, wallpaper_index, "WALLPAPER");
+        char *background_path = config_get_value(config, quiet ? 0 : wallpaper_index, wallpaper_key);
         if (background_path != NULL) {
             if (secure_boot_active && strchr(background_path, '#') == NULL) {
                 print("Wallpaper skipped: Secure Boot is active and no hash is associated.\n");
@@ -824,7 +827,7 @@ bool gterm_init(struct fb_info **_fbs, size_t *_fbs_count,
 
     prev_valid = false;
 
-    if (quiet) {
+    if (quiet && !quiet_wallpaper) {
         term_notready();
         return false;
     }
@@ -854,6 +857,17 @@ bool gterm_init(struct fb_info **_fbs, size_t *_fbs_count,
     struct gterm_config cfg;
     gterm_parse_config(config, &cfg);
 
+    // A quiet terminal only shows its image, so it needs one.
+    if (quiet) {
+        if (background == NULL) {
+            pmm_free(cfg.font, FONT_MAX);
+            return false;
+        }
+        default_bg = 0xff000000;
+        margin = 0;
+        margin_gradient = 0;
+    }
+
     terms_i = 0;
     terms = ext_mem_alloc_counted(fbs_count, sizeof(void *));
 
@@ -870,6 +884,7 @@ bool gterm_init(struct fb_info **_fbs, size_t *_fbs_count,
         size_t font_scale_x, font_scale_y;
         gterm_fb_setup(fb, config, &cfg, &font_scale_x, &font_scale_y);
 
+        // Quiet mode defers drawing to the first flush, once the cursor is off.
         terms[terms_i] = flanterm_fb_init(ext_mem_alloc_size_t,
                             pmm_free_size_t,
                             (void *)(uintptr_t)fb->framebuffer_addr,
@@ -883,7 +898,7 @@ bool gterm_init(struct fb_info **_fbs, size_t *_fbs_count,
                             &default_bg_bright, &default_fg_bright,
                             cfg.font, cfg.font_width, cfg.font_height, cfg.font_spacing,
                             font_scale_x, font_scale_y,
-                            margin, cfg.fb_rotation, true);
+                            margin, cfg.fb_rotation, !quiet);
 
         if (terms[terms_i] != NULL) {
             terms_i++;
@@ -947,7 +962,8 @@ bool gterm_init(struct fb_info **_fbs, size_t *_fbs_count,
     prev_config = config;
     prev_height = height;
     prev_width = width;
-    prev_valid = true;
+    // Revealing the menu needs a regular terminal, not this one.
+    prev_valid = !quiet;
 
     return true;
 }
diff --git i/common/lib/misc.c w/common/lib/misc.c
index c87447a..a50cef3 100644
--- i/common/lib/misc.c
+++ w/common/lib/misc.c
@@ -121,6 +121,7 @@ void *spinup_tramp_low(void *hi) {
 bool editor_enabled = true;
 bool help_hidden = false;
 bool secure_boot_active = false;
+bool quiet_wallpaper = false;
 
 uint64_t usec_at_bootloader_entry;
 
diff --git i/common/lib/misc.h w/common/lib/misc.h
index ec1c6c0..8b38e83 100644
--- i/common/lib/misc.h
+++ w/common/lib/misc.h
@@ -43,7 +43,7 @@ extern bool stage3_loaded;
 extern uintptr_t __stack_chk_guard;
 void reseed_stack_guard(void);
 
-extern bool quiet, terse, serial, editor_enabled, help_hidden, hash_mismatch_panic, secure_boot_active, measured_boot, firmware_logo;
+extern bool quiet, terse, serial, editor_enabled, help_hidden, hash_mismatch_panic, secure_boot_active, measured_boot, firmware_logo, quiet_wallpaper;
 
 // What is drawn rather than where it goes: a COM_OUTPUT build sets this on
 // every port and transmits on BIOS alone.
diff --git i/common/menu.c w/common/menu.c
index f186bbd..b69e60c 100644
--- i/common/menu.c
+++ w/common/menu.c
@@ -1419,7 +1419,11 @@ static void menu_init_term(void) {
         if (menu_resolution != NULL)
             parse_resolution(&req_width, &req_height, &req_bpp, menu_resolution);
 
-        if (!quiet && !gterm_init(NULL, NULL, NULL, req_width, req_height)) {
+        if (quiet) {
+            if (quiet_wallpaper && !gterm_init(NULL, NULL, NULL, req_width, req_height)) {
+                term_fallback();
+            }
+        } else if (!gterm_init(NULL, NULL, NULL, req_width, req_height)) {
 #if defined (BIOS)
             vga_textmode_init(true);
 #elif defined (UEFI)
@@ -1660,6 +1664,8 @@ noreturn void _menu(bool first_run) {
     char *quiet_str = config_get_value(NULL, 0, "QUIET");
     quiet = quiet_str != NULL && strcmp(quiet_str, "yes") == 0;
 
+    quiet_wallpaper = config_get_value(NULL, 0, "QUIET_WALLPAPER") != NULL;
+
     char *firmware_logo_str = config_get_value(NULL, 0, "FIRMWARE_LOGO");
     firmware_logo = firmware_logo_str != NULL && strcmp(firmware_logo_str, "yes") == 0;
 
-- 
2.56.0

