# Maintainer: Braden Roth <bradenr402@gmail.com>

pkgname=omaword
pkgver=0.1.0
pkgrel=1
pkgdesc="Keyboard-first offline Bible reader for Omarchy"
arch=('x86_64' 'aarch64')
url="https://github.com/bradenr402/omaword"
license=('MIT' 'CC-BY-4.0')
options=('!debug')
depends=('fontconfig' 'hicolor-icon-theme' 'libpipewire' 'qt6-base' 'qt6-declarative' 'qt6-wayland')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c3cb49de1673f2bf399da70ff4a8122ad96e0b0cdbb012107324a727ff57825e')

build() {
  mkdir -p build
  cd build
  qmake6 "../$pkgname-$pkgver/omaword.pro" PREFIX=/usr \
    QMAKE_CFLAGS_RELEASE="$CFLAGS" QMAKE_CXXFLAGS_RELEASE="$CXXFLAGS" QMAKE_LFLAGS_RELEASE="$LDFLAGS"
  make
}

package() {
  make -C build INSTALL_ROOT="$pkgdir" install
  install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
