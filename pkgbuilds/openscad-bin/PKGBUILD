# Maintainer: Eric Citaire <eric.citaire@gmail.com>
#
# Upstream ships OpenSCAD for Linux only as an x86_64 AppImage, and the newest
# GitHub release is the 2026.11 release candidate: 2021.01, the build on
# openscad.org and in Arch's extra, is the last stable. This repackages that
# AppImage, signature included, so the two live side by side.
#
# The candidate is tagged openscad-2026.11-RC0. pacman orders the attached
# form below the final release (2026.11RC0 < 2026.11), so the watch can move
# to 2026.11 with no epoch when upstream cuts it.
pkgname=openscad-bin
_tag='openscad-2026.11-RC0'
_release="${_tag#openscad-}"
_appimage="OpenSCAD-${_release}-x86_64.AppImage"
# The tag carries the candidate in uppercase; pkgver follows it so the watch's
# version template and this line agree.
pkgver=2026.11RC0
pkgrel=1
pkgdesc='The Programmers Solid 3D CAD Modeller'
arch=('x86_64')
url='https://openscad.org'
license=('GPL-2.0-or-later')
depends=(
  # The bundle carries Qt, Boost, Python and the CAD libraries. These are the
  # system libraries it still links, plus the packages its bundled libs pull
  # in at load time (krb5 needs libcom_err, libgcrypt libgpg-error).
  'brotli'
  'bzip2'
  'e2fsprogs'
  'expat'
  'fontconfig'
  'freetype2'
  'gcc-libs'
  'glibc'
  'gmp'
  'graphite'
  'harfbuzz'
  'libdrm'
  'libglvnd'
  'libgpg-error'
  'libice'
  'libsm'
  'libx11'
  'libxau'
  'libxcb'
  'libxdmcp'
  'mesa'
  'util-linux-libs'
  'wayland'
  'zlib'
)
makedepends=('7zip')
provides=('openscad')
conflicts=('openscad')
options=('!strip' '!debug')
source=("${_appimage}::https://github.com/openscad/openscad/releases/download/${_tag}/${_appimage}"
        "${_appimage}.asc::https://github.com/openscad/openscad/releases/download/${_tag}/${_appimage}.asc")
validpgpkeys=('E2EBDADD336FF516ADD51A78F3E12CCC22164A0F')
noextract=("${_appimage}")
sha256sums=('78c2050aedcf52cca0186151cdcda1118a771491e3bec934b3172d0b03a9de96'
            '837c4cd7a777acbcffaf68f7fe63420f707423491fd71b1f184ea3ff5b1dc5d9')

prepare() {
  # Read the embedded SquashFS without executing the AppImage.
  rm -rf "$srcdir/squashfs-root"
  7z x "$srcdir/${_appimage}" -o"$srcdir/squashfs-root" >/dev/null
}

package() {
  # The AppImage's RUNPATH is $ORIGIN/../lib and qt.conf sits beside the
  # binary, so the tree has to keep its shape under /opt.
  install -dm755 "$pkgdir/opt/${pkgname}"
  cp -a "$srcdir/squashfs-root/usr" "$pkgdir/opt/${pkgname}/"

  install -dm755 "$pkgdir/usr/bin"
  ln -s "/opt/${pkgname}/usr/bin/openscad" "$pkgdir/usr/bin/openscad"

  install -Dm644 "$srcdir/squashfs-root/openscad.desktop" \
    "$pkgdir/usr/share/applications/openscad.desktop"
  install -Dm644 "$srcdir/squashfs-root/usr/share/mime/packages/openscad.xml" \
    "$pkgdir/usr/share/mime/packages/openscad.xml"

  # Pacman installs the icons under /opt with the rest of the bundle; the
  # launcher needs them in the hicolor theme it searches.
  local icon
  for icon in "$srcdir/squashfs-root"/usr/share/icons/hicolor/*/apps/openscad.png; do
    install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/${icon#"$srcdir/squashfs-root"/usr/share/icons/hicolor/}"
  done
}
