# Audio DSP, compute DSP, GPU and video firmware for the ASUS Vivobook S16 S5608QA. The firmware
# only runs if it is signed for this board by ASUS, so linux-firmware cannot carry it until the
# OEM submits it. The OEM ships it in its Windows driver download, which this recipe unpacks
# without running. Each file is checked against the SHA-256 it was matched to and installed under
# the name the device tree requests, compressed with xz. The kernel tries a plain name, then .zst,
# then .xz, so once linux-firmware ships the same file, its copy is the one loaded, and the two
# packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=asus-vivobook-s16-s5608qa-firmware
pkgver=20261114
pkgrel=1
pkgdesc='Audio DSP, compute DSP, GPU and video firmware for the ASUS Vivobook S16 S5608QA'
arch=('aarch64')
url='https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/51016/SOCPackage_forWebSite_Qualcomm_Z_V1.304.9300.0_51016.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x126100-asustek-vivobook-s16-s5608qa')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'asus-socpackage-51016.exe::https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/51016/SOCPackage_forWebSite_Qualcomm_Z_V1.304.9300.0_51016.exe'
)
source+=('README.package.md')
noextract=('asus-socpackage-51016.exe')
sha256sums=('969e1eecb2c32576a02f0d90805e569f5e8958d54ba559c303e3b36f93750fb1')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'asus-socpackage-51016.exe' 'asus-socpackage-51016' 7z-appended
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'asus-socpackage-51016/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/adsp_dtbs.elf'
  install -Dm644 'asus-socpackage-51016/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adspr.jsn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/adspr.jsn'
  install -Dm644 'asus-socpackage-51016/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adsps.jsn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/adsps.jsn'
  install -Dm644 'asus-socpackage-51016/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adspua.jsn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/adspua.jsn'
  install -Dm644 'asus-socpackage-51016/QualcommBSP/NPU/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/cdsp_dtbs.elf'
  install -Dm644 'asus-socpackage-51016/QualcommBSP/NPU/qcnspmcdm_ext_cdsp8380/cdspr.jsn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/cdspr.jsn'
  install -Dm644 'asus-socpackage-51016/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/qcadsp8380.mbn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/qcadsp8380.mbn'
  install -Dm644 'asus-socpackage-51016/QualcommBSP/NPU/qcnspmcdm_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/qccdsp8380.mbn'
  install -Dm644 'asus-socpackage-51016/QualcommBSP/GFX/qcdx8380/qcdxkmsucpurwa.mbn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/qcdxkmsucpurwa.mbn'
  install -Dm644 'asus-socpackage-51016/QualcommBSP/GFX/qcdx8380/qcvss8380.mbn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/qcvss8380.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
c92e8f7b0208a4093d4d84d495c97851a14aadbd3de141d61da9a656fe3cc613  qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/adsp_dtbs.elf
549bb9c8e32dc6253d0d0ddde2ce5c26f75f8333d3e55861f297e169a9f3e5c0  qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/adspr.jsn
12ac2f3ae8ced12aa4b06b3ab3a01bc4d8efe1c92ebea503c002f209a6ec176f  qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/adsps.jsn
982a99853495e34726b8e44697fdfad303334de0a67cbf6cde306c8f1731000b  qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/adspua.jsn
c1e3cdeee17e61ee5f9426fef78e5e35eaf9fdd49d3d39b9bd82dcad04c71647  qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/cdsp_dtbs.elf
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/cdspr.jsn
5439f9585d12b1329394a12b8c2be24e2e27144a41add82c95185a0cb68ba3a7  qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/qcadsp8380.mbn
4d2aa10aa60245177ca253d4a8f7ee15c0a0390e877efec29fa25c7d4b725568  qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/qccdsp8380.mbn
848341997c48213d818168ed0ec48ee722c30738e5ffede40550d38252e3ac71  qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/qcdxkmsucpurwa.mbn
fa5e78c9743c5ca3439baadfe7f1e118591f8a1ad976e9f87b75937945d42e8b  qcom/x126100/ASUSTeK/vivobook-s16-s5608qa/qcvss8380.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
