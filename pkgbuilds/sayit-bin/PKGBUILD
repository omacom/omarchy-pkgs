# Maintainer: Daniele Dellafiore <daniele@nucube.com>
# Re-wraps the upstream sayit .deb (which already ships the desktop binary,
# the sidecar, the sayit CLI + sayit-clipboard wrappers, the agent skill and
# the licence). See packaging/omarchy/README.md.
pkgname=sayit-bin
pkgver=0.2.4
pkgrel=1
pkgdesc="Private, local text-to-speech (Kokoro-82M, offline)"
arch=('x86_64')
url="https://github.com/ildella/sayit"
license=('MIT')
depends=('gtk3' 'webkit2gtk-4.1' 'libayatana-appindicator' 'nodejs' 'mpv' 'hicolor-icon-theme')
optdepends=('wl-clipboard: sayit-clipboard on Wayland' 'xclip: X11 clipboard' 'xsel: X11 clipboard' 'alsa-utils: aplay fallback')
provides=("sayit=${pkgver}")
conflicts=('sayit')
options=('!strip' '!debug')
source_x86_64=("SayIt_${pkgver}_amd64.deb::${url}/releases/download/v${pkgver}/SayIt_${pkgver}_amd64.deb")
sha256sums_x86_64=('79c22d18df11b55205637e27c3dbefe865b85f1c5845ed788192dea0ac805972')

package() {
  # makepkg unpacks the .deb; install its payload with the /usr layout intact
  # (/usr/lib/SayIt/{sidecar,cli,skills}, /usr/bin/sayit{,-clipboard}).
  bsdtar -xf data.tar.* -C "$pkgdir"
  # The .deb keeps the licence at /usr/share/doc/say-it; Arch wants /licenses.
  install -Dm644 "$pkgdir/usr/share/doc/say-it/copyright" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
