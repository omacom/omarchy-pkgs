# Maintainer: Carmine Paolino <carmine@paolino.me>

pkgname=op-cache
pkgver=0.0.0.r4.g6219481
pkgrel=1
pkgdesc='A fast caching proxy for 1Password CLI op read commands'
arch=('x86_64' 'aarch64')
url='https://github.com/crmne/op-cache'
license=('MIT')
depends=('1password-cli' 'gcc-libs' 'glibc')
makedepends=('cargo' 'git')
# The AUR's development package installs the same files.
conflicts=('op-cache-git')
options=('!debug' '!lto')

# Upstream has no release tags. This pins crmne/op-cache's
# fix/socket-auth-hardening branch, which hardens the daemon's socket and
# files (SamSaffron/op-cache#1).
_commit=6219481a9e4dfaa9e3368021e0b1bac1447f1da3
source=("$pkgname::git+$url.git#commit=$_commit")
sha256sums=('792b90bc3d938768c05f1df0a4f797cb918c59393b9814eac2b1e83ee82d430b')

prepare() {
  cd "$pkgname"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/op-cache "$pkgdir/usr/bin/op-cache"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
