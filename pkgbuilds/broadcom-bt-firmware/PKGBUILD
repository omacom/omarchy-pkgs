# Maintainer: Macho0x <Macho0x@users.noreply.github.com>
#
# Broadcom Bluetooth firmware, imported from the AUR recipe of the same name
# (maintained there by Brittany Figueroa).
#
# linux-firmware carries none of Broadcom's Bluetooth firmware, in any of its
# split packages: the HCD files Broadcom's controllers need were only ever
# shipped inside its Windows driver, which this recipe unpacks without running.
# The controller that made this necessary is the BCM20702A1 in the Dell XPS 13
# 9343 (USB 0a5c:216f): btusb finds no brcm/BCM20702A1-0a5c-216f.hcd for it, the
# patchram never uploads, and BlueZ reports no adapter at all. Omarchy installs
# this package for that controller (install/hardware/fix-bcm20702a1-bluetooth.sh
# in the main repository) and caches it in the ISO, so an offline installation
# gets working Bluetooth.
#
# The deb is a data-only archive of the HCD files (its control file says
# Architecture: all), so this package is arch-independent and both the x86_64
# and the aarch64 ISO can cache it.
#
# The files are Broadcom's, installed unmodified under the names btusb asks
# for. The upstream project is dormant, so this recipe is deliberately outside
# the automatic updates.
#
# Retire this package if Broadcom's Bluetooth firmware ever lands in
# linux-firmware, where the files would conflict with it.

pkgname=broadcom-bt-firmware
pkgver=12.0.1.1105
_pkgver='12.0.1.1105_p4'
pkgrel=1
pkgdesc='Firmware for Broadcom Bluetooth controllers, including the BCM20702A1 (0a5c:216f)'
arch=('any')
url="https://github.com/winterheart/${pkgname}"
license=('MIT' 'LicenseRef-Broadcom')
conflicts=("${pkgname}-git")
source=("${url}/releases/download/v${_pkgver}/${pkgname}-${pkgver}.deb")
b2sums=('13dc60bfa9514afe711261f242d617d65329fcf7a0cc5b17208963d18511703ef7ec7575e75ee0bb3b2b5c5755e14ecb408dabe1c6a7cf6786bfd1a3e403ea01')

package() {
  tar --extract --file data.tar.gz --directory "${pkgdir}"

  mv "${pkgdir}/lib" "${pkgdir}/usr"

  # Arch keeps licence files under /usr/share/licenses; the deb puts them in a
  # documentation directory named after its own version.
  local doc="${pkgdir}/usr/share/doc/${pkgname}-${pkgver}"

  install -Dm644 "$doc/LICENSE.broadcom_bcm20702" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.broadcom_bcm20702"
  install -Dm644 "$doc/LICENSE.MIT.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.MIT.txt"

  rm -rf "$doc"
}
