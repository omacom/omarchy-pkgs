# Maintainer: Luxore <luxore@users.noreply.github.com>

pkgname=omarchy-razer-blade
pkgver=0.4.0
pkgrel=2
pkgdesc="Razer Blade firmware power, cooling, charge, and display controls"
arch=('x86_64')
url="https://github.com/luxore/omarchy-razer-blade"
license=('GPL-2.0-only')
depends=('gcc-libs' 'glibc' 'systemd')
makedepends=('cargo')
install=omarchy-razer-blade.install
options=('!debug')

_commit=c31bc3ded4540169b9091ed7e22382efce4fbfe4
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('872d05f50684b8c37691c79fb0cc96d2a979342e4590960da65aca15925c2ab3')

prepare() {
  cd "$srcdir/$pkgname-$_commit"

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$srcdir/$pkgname-$_commit"

  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$srcdir/$pkgname-$_commit"

  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$srcdir/$pkgname-$_commit"

  install -Dm755 target/release/omarchy-razer-blade \
    "$pkgdir/usr/bin/omarchy-razer-blade"
  install -Dm644 packaging/udev/70-omarchy-razer-blade.rules \
    "$pkgdir/usr/lib/udev/rules.d/70-omarchy-razer-blade.rules"
  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
