# Maintainer: Brandon Williams <turbine.bmw@gmail.com>

# Ambient light sensor support for the Surface Pro 11 (Snapdragon X Elite and X Plus).

pkgname=microsoft-surface-pro-11-sensors
pkgver=1
pkgrel=2
pkgdesc="Ambient light sensor service for the Microsoft Surface Pro 11 (Snapdragon X Elite and X Plus)"
arch=('aarch64')
# Qualcomm-only: the pacman platform guard keeps it off other hardware.
groups=('omarchy-platform-qualcomm')
url="https://github.com/omacom/omarchy-pkgs"
license=('GPL-3.0-or-later' 'MIT')
depends=('glib2' 'iio-sensor-proxy' 'libqmi' 'libqrtr-glib' 'protobuf-c' 'util-linux')
# libssc builds GObject introspection whenever glib's .pc files are present.
makedepends=('git' 'gobject-introspection' 'meson' 'ninja')
# Renamed from surface-pro-11-sensors: provides and replaces it, so installed machines move to
# this name on the next update.
provides=('surface-pro-11-sensors')
conflicts=('surface-pro-11-sensors')
replaces=('surface-pro-11-sensors')
options=('!debug')
_hexagonrpc_commit=dd9ac70c026e1bad93e8cffa3801255b8ceb551e
# Includes 54dd13e, which stops iio-sensor-proxy spinning when the sensor
# server never appears.
_libssc_commit=54dd13e36d65c21263cf5b0f4a70c230a77b26bc
source=(
  "hexagonrpc::git+https://github.com/linux-msm/hexagonrpc.git#commit=${_hexagonrpc_commit}"
  "libssc::git+https://codeberg.org/DylanVanAssche/libssc.git#commit=${_libssc_commit}"
  '0001-apps-std-support-writable-sensor-registry.patch'
  '0001-light-use-surface-color-sensor.patch'
  'surface-pro-11-sensors.service'
  '10-surface-pro-11-sensors.conf'
  'surface-pro-11-sensors-sleep'
  'surface-pro-11-sensors-extract'
  'README.package.md'
)
sha256sums=('b612196e6a0069467cdccf0b663e620bfaab27c7d1659c240ae22c9614301cd8'
            'b044b855e29fd76deb22f922356a7924e4c4bcf4fc1b8f0b242cd13925c6897c'
            '6c61e5978d443a151928c7a1519b14d56f39bd216915008a0b026eb6ef35baf2'
            'c657bda4f4d45c83c0db948d1f0c25931421e644c1629a0ba26e7a97f7169611'
            '0c6f5474e3116d3540db6f4dd4e379360a0a596887c4c47f2ac3552305a5df56'
            'b4f6a0fb2b11e6a2999c355d11d68ee5e8807976d6ea0cbd68d7d56fe7688a61'
            '7f7a664d703265c31eda92c66cf709ad610593a6084c3faca4f7e633132a4a84'
            '5883d3140a1ec3e65a5666e806e484f2cc793cdbcd3a1b01f3bb009daceec588'
            'feec8b7ef86e3fcbfa583dc46c70d9a86e0ec7f674819281bc0fc6640fbf169d')

_libdir=/usr/lib/surface-pro-11-sensors

prepare() {
  # Let the daemon write the sensor registry the DSP generates.
  git -C hexagonrpc apply ../0001-apps-std-support-writable-sensor-registry.patch
  # Read ambient light from the Surface's "color" sensor; "ambient_light" reports zero.
  git -C libssc apply ../0001-light-use-surface-color-sensor.patch
}

build() {
  local project
  for project in hexagonrpc libssc; do
    arch-meson "$project" "build-$project" -D b_lto=false
    meson compile -C "build-$project"
  done
}

check() {
  meson test -C build-hexagonrpc --print-errorlogs
}

package() {
  local project
  for project in hexagonrpc libssc; do
    meson install -C "build-$project" --destdir "$srcdir/stage-$project" --no-rebuild
  done

  # Private copies, loaded only by this package's service and by
  # iio-sensor-proxy through its drop-in; other programs keep Arch's libssc.
  install -Dm755 "$srcdir/stage-hexagonrpc/usr/bin/hexagonrpcd" "$pkgdir$_libdir/hexagonrpcd"
  cp -P "$srcdir"/stage-hexagonrpc/usr/lib/libhexagonrpc.so* "$pkgdir$_libdir/"
  cp -P "$srcdir"/stage-libssc/usr/lib/libssc.so* "$pkgdir$_libdir/"

  install -Dm644 surface-pro-11-sensors.service "$pkgdir/usr/lib/systemd/system/surface-pro-11-sensors.service"
  install -Dm644 10-surface-pro-11-sensors.conf \
    "$pkgdir/usr/lib/systemd/system/iio-sensor-proxy.service.d/10-surface-pro-11-sensors.conf"
  install -Dm755 surface-pro-11-sensors-sleep "$pkgdir/usr/lib/systemd/system-sleep/surface-pro-11-sensors"
  install -Dm755 surface-pro-11-sensors-extract "$pkgdir/usr/bin/surface-pro-11-sensors-extract"
  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.package.md"
  install -Dm644 hexagonrpc/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING.hexagonrpc"
  install -Dm644 libssc/LICENSE "$pkgdir/usr/share/licenses/$pkgname/COPYING.libssc"
}
