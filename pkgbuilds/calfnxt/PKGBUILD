# Maintainer: Daniella Anokwu <anokwudaniella@gmail.com>

pkgname=calfnxt
pkgver=2.13.2
pkgrel=1
pkgdesc="Successor of Calf Studio Gear: VST3 plugin suite with a WebKit UI (GTK3 embed + floating GTK4 helpers)"
arch=(x86_64 aarch64)
url="https://calfnxt.org"
license=(GPL-3.0-or-later)
depends=(
  gcc-libs
  glib2
  glibc
  gtk3
  gtk4
  libx11
  webkit2gtk-4.1
  webkitgtk-6.0
)
makedepends=(
  cmake
  python
  vst3sdk
)
optdepends=(
  'ardour: VST3 host'
  'carla: VST3 host'
)
source=(
  "https://github.com/boomshop/calfnxt/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
  "https://github.com/boomshop/calfnxt/releases/download/v$pkgver/$pkgname-$pkgver-ui-dist.tar.xz"
)
noextract=("$pkgname-$pkgver-ui-dist.tar.xz")
sha256sums=('64459ea6b1b337cf6233d7e155c765a0864afcdc3dee17aa5f3695fa0128913a'
            'e9df15cfcc433cc00ebcde5199a1fc4c196c5014056588cd972831cd7a2e6dc4')

prepare() {
  cd $pkgname-$pkgver

  # prebuilt SPA (ui/dist incl. .stamp) so the build needs no npm/network
  bsdtar -xf "$srcdir/$pkgname-$pkgver-ui-dist.tar.xz"

  # upstream expects the SDK tree at external/vst3sdk; copy the system one
  # (Arch's vst3sdk ships full sources in /usr/src). Build type must be Release:
  # with None the SDK's fdebug.h errors out (no NDEBUG/RELEASE defined)
  rm -rf external/vst3sdk
  mkdir -p external
  cp -r /usr/src/vst3sdk external/vst3sdk
}

build() {
  cmake -B build -S $pkgname-$pkgver \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCALFNXT_USE_PREBUILT_UI=ON \
    -DCALFNXT_WEB_HOST_GTK4=ON \
    -DCALFNXT_USER_VST3_DIR="$srcdir/user-vst3-unused" \
    -Wno-dev
  cmake --build build --target calfnxt-plugins
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  # both helpers must land in every bundle
  local bundle
  for bundle in "$pkgdir"/usr/lib/vst3/calfNXT*.vst3; do
    test -x "$bundle/Contents/$CARCH-linux/calfnxt-web-host" || {
      echo "missing GTK3 helper in $bundle" >&2; return 1; }
    test -x "$bundle/Contents/$CARCH-linux/calfnxt-web-host-gtk4" || {
      echo "missing GTK4 helper in $bundle" >&2; return 1; }
  done

  install -vDm 644 $pkgname-$pkgver/COPYRIGHT -t "$pkgdir/usr/share/licenses/$pkgname/"
}
