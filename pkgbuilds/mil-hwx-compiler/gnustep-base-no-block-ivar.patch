From 4a61eee44f000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GNUstep upstream (gnustep/libs-base#809)
Date: Mon, 5 Oct 2026 08:52:09 +0000
Subject: [PATCH] GSScheduledBlock _block instead of BLOCK_SCOPE GSScheduledBlock _block

Clang rejects __block (__attribute__((__blocks__(byref)))) on Objective-C
instance variables. Backport upstream gnustep/libs-base PR #809 (4a61eee44f)
onto the pinned libs-base commit.

--- a/Headers/Foundation/NSBackgroundActivityScheduler.h
+++ b/Headers/Foundation/NSBackgroundActivityScheduler.h
@@ -79,3 +79,3 @@ GS_EXPORT_CLASS
   NSString *_reason;
-  BLOCK_SCOPE GSScheduledBlock _block;
+  GSScheduledBlock _block;
 }
