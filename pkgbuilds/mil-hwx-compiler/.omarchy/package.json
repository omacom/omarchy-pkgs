{
  "source": "local",
  "min_release_age": "24h",
  "upstream": {
    "watch": {
      "github": "joshuaswarren/mil-hwx-compiler",
      "pattern": "v(?P<version>[0-9]+(?:\\.[0-9]+)*)"
    }
  },
  "rebuild_on": [
    "icu",
    "libxml2"
  ],
  "rebuilt_against": {
    "aarch64": {
      "icu": "78.3-1",
      "libxml2": "2.15.4-1"
    }
  }
}
