12ac2f3ae8ced12aa4b06b3ab3a01bc4d8efe1c92ebea503c002f209a6ec176f  qcom/x1p42100/LENOVO/83HL/adsps.jsn
982a99853495e34726b8e44697fdfad303334de0a67cbf6cde306c8f1731000b  qcom/x1p42100/LENOVO/83HL/adspua.jsn
be8c6fba330908e4683fb6282761cb08485a302d6a66e09721e102e342f27236  qcom/x1p42100/LENOVO/83HL/battmgr.jsn
1e0535bd2a8adcd14d6079ffa99f6fce5c6561d4759a60f6076dcfbaa4437f8a  qcom/x1p42100/LENOVO/83HL/cdsp_dtbs.elf
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x1p42100/LENOVO/83HL/cdspr.jsn
fd71bd1a2d8224ca58c9f5aee6ad14f151a093dfbee792169b64745c86e51a29  qcom/x1p42100/LENOVO/83HL/qcadsp8380.mbn
