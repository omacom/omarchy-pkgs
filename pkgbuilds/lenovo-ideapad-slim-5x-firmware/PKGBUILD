  install -Dm644 'lenovo-83hl-wu-200.0.20.0-qcdx8380/qcvss8380_pa.mbn' "$fw"/'qcom/x1p42100/LENOVO/83HL/qcvss8380_pa.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
