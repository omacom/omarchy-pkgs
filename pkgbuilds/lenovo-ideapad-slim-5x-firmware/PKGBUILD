# Audio DSP, compute DSP, GPU and video firmware for the Lenovo IdeaPad Slim 5x 14Q8X9. The
# firmware only runs if it is signed for this board by Lenovo, so linux-firmware cannot carry it
# until the OEM submits it. The OEM ships it in the driver bundle it publishes for the machine on
# Windows Update, whose cabinets this recipe fetches with wudrivers and unpacks without running
# anything. Each file is checked against the SHA-256 it was matched to and installed under the
# name the device tree requests, compressed with xz. The kernel tries a plain name, then .zst,
# then .xz, so once linux-firmware ships the same file, its copy is the one loaded, and the two
# packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=lenovo-ideapad-slim-5x-firmware
pkgver=20261115
pkgrel=2
pkgdesc='Audio DSP, compute DSP, GPU and video firmware for the Lenovo IdeaPad Slim 5x 14Q8X9'
arch=('aarch64')
url='https://github.com/birkskyum/wudrivers'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1p42100-lenovo-83hl')
makedepends=('7zip' 'wudrivers')
options=('!strip' '!debug')
# Windows Update's links are short-lived, so wudrivers fetches a fresh one by update ID, revision and SHA-1.
DLAGENTS+=('wu::/usr/bin/wudrivers fetch %u -o %o')
source=(
  'lenovo-83hl-wu-200.0.20.0-qcsubsys-ext-adsp8380.cab::wu://96d7ff14-22cd-4939-a225-706d86c26a7e/1/5c9d4b84b92ca212f76cfb0614ada8f5ad955e1f'
  'lenovo-83hl-wu-200.0.20.0-qcnspmcdm-ext-cdsp8380.cab::wu://96d7ff14-22cd-4939-a225-706d86c26a7e/1/747466cde047783a391760230cbca3195a2df7b3'
  'lenovo-83hl-wu-200.0.20.0-qcdx8380.cab::wu://96d7ff14-22cd-4939-a225-706d86c26a7e/1/4b62ce39ab5c4fc4494918680e4be1a83b71cea8'
)
source+=('README.package.md')
noextract=('lenovo-83hl-wu-200.0.20.0-qcsubsys-ext-adsp8380.cab' 'lenovo-83hl-wu-200.0.20.0-qcnspmcdm-ext-cdsp8380.cab' 'lenovo-83hl-wu-200.0.20.0-qcdx8380.cab')
sha256sums=('d2678c170b1403d604acffb244ccfe4b4c661ddbc60010692dc9abaa9f406bc5' 'd6e5f7c9affca5d3aa93f384841676bf93750e285acc2e26461081c3857cf00a' '20c61a5de20d33d359b1c0848710098c2c82169af686dca68090f9efdee15db2')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'lenovo-83hl-wu-200.0.20.0-qcsubsys-ext-adsp8380.cab' 'lenovo-83hl-wu-200.0.20.0-qcsubsys-ext-adsp8380' 7z
  _unpack 'lenovo-83hl-wu-200.0.20.0-qcnspmcdm-ext-cdsp8380.cab' 'lenovo-83hl-wu-200.0.20.0-qcnspmcdm-ext-cdsp8380' 7z
  _unpack 'lenovo-83hl-wu-200.0.20.0-qcdx8380.cab' 'lenovo-83hl-wu-200.0.20.0-qcdx8380' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'lenovo-83hl-wu-200.0.20.0-qcsubsys-ext-adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1p42100/LENOVO/83HL/adsp_dtbs.elf'
  install -Dm644 'lenovo-83hl-wu-200.0.20.0-qcsubsys-ext-adsp8380/adspr.jsn' "$fw"/'qcom/x1p42100/LENOVO/83HL/adspr.jsn'
  install -Dm644 'lenovo-83hl-wu-200.0.20.0-qcsubsys-ext-adsp8380/adsps.jsn' "$fw"/'qcom/x1p42100/LENOVO/83HL/adsps.jsn'
  install -Dm644 'lenovo-83hl-wu-200.0.20.0-qcsubsys-ext-adsp8380/adspua.jsn' "$fw"/'qcom/x1p42100/LENOVO/83HL/adspua.jsn'
  install -Dm644 'lenovo-83hl-wu-200.0.20.0-qcsubsys-ext-adsp8380/battmgr.jsn' "$fw"/'qcom/x1p42100/LENOVO/83HL/battmgr.jsn'
  install -Dm644 'lenovo-83hl-wu-200.0.20.0-qcnspmcdm-ext-cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1p42100/LENOVO/83HL/cdsp_dtbs.elf'
  install -Dm644 'lenovo-83hl-wu-200.0.20.0-qcnspmcdm-ext-cdsp8380/cdspr.jsn' "$fw"/'qcom/x1p42100/LENOVO/83HL/cdspr.jsn'
  install -Dm644 'lenovo-83hl-wu-200.0.20.0-qcsubsys-ext-adsp8380/qcadsp8380.mbn' "$fw"/'qcom/x1p42100/LENOVO/83HL/qcadsp8380.mbn'
  install -Dm644 'lenovo-83hl-wu-200.0.20.0-qcnspmcdm-ext-cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1p42100/LENOVO/83HL/qccdsp8380.mbn'
  install -Dm644 'lenovo-83hl-wu-200.0.20.0-qcdx8380/qcdxkmsucpurwa.mbn' "$fw"/'qcom/x1p42100/LENOVO/83HL/qcdxkmsucpurwa.mbn'
