post_install() {
  cat <<'MSG'
Set your Entra ID domain in /etc/himmelblau/himmelblau.conf, configure PAM and NSS
(aad-tool configure-pam, and add himmelblau to /etc/nsswitch.conf), then:
    systemctl enable --now himmelblaud himmelblaud-tasks
Optional sshd, display manager and browser files: /usr/share/doc/himmelblau/examples
MSG
}
