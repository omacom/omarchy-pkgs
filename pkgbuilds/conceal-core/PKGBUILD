# Maintainer: Conceal Network <ccx@conceal.network>

pkgname=conceal-core
pkgver=6.7.6
pkgrel=2
_commit=7c2be9e27e4684979212cacfdf00a2f0cdb9366c
pkgdesc='Conceal Network command-line node and wallets (conceal-daemon, conceal-wallet, conceal-walletd, conceal-optimizer)'
arch=('x86_64')
url='https://github.com/ConcealNetwork/conceal-core'
license=('MIT' 'LGPL-3.0-or-later' 'BSD-3-Clause' 'Apache-2.0')
depends=('boost-libs' 'glibc' 'libgcc' 'libstdc++')
makedepends=('boost' 'cmake' 'git')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('9db0ad378dfb9f61a4a6a8c599d11bc37282b57dfea685fa171e42a27119952a')

prepare() {
  # Release archives have no Git history. Stamp the verified release commit
  # directly into the template instead of relying on CMake's git log call.
  sed -i "s/@COMMIT@/${_commit:0:7}/g" \
    "$pkgname-$pkgver/src/version.h.in"
}

build() {
  # Preserve the upstream generic x86-64 + AES-NI CPU baseline.
  CFLAGS=$(sed -E 's/(^| )-march=[^ ]+//g' <<< "$CFLAGS")
  CXXFLAGS=$(sed -E 's/(^| )-march=[^ ]+//g' <<< "$CXXFLAGS")
  export CFLAGS CXXFLAGS

  cmake -S "$pkgname-$pkgver" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DSTATIC=OFF \
    -DARCH=x86-64 \
    -DBUILD_TESTS=OFF \
    -Wno-dev
  cmake --build build --parallel "${CCX_BUILD_JOBS:-2}"
}

package() {
  local bin
  for bin in conceal-daemon conceal-wallet conceal-walletd conceal-optimizer; do
    install -Dm755 "build/src/$bin" "$pkgdir/usr/bin/$bin"
  done

  install -Dm644 "$pkgname-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$pkgname-$pkgver/external/miniupnpc/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.miniupnpc"
  install -Dm644 "$pkgname-$pkgver/external/parallel_hashmap/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.parallel_hashmap"
}
