pkgname=widevine
pkgver=4.10.2891.0
pkgrel=2
pkgdesc='Google DRM content decryption module for Chromium and Firefox, fetched on the device'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://www.widevine.com/'
license=('MIT')
# The CDM itself is Google's and is never in this package: widevine-fetch
# downloads this image on the Mac, checks it and patches the library there.
_lacros_version=120.0.6098.0
_lacros_url="https://commondatastorage.googleapis.com/chromeos-localmirror/distfiles/chromeos-lacros-arm64-squash-zstd-$_lacros_version"
_lacros_sha256=38a57cc3975af68675a1219b00354f08890ff58d0c54b690dcf5d2dd904b1576
depends=('glibc' 'gcc-libs' 'glib2' 'nspr' 'nss'
         'bash' 'coreutils' 'curl' 'python' 'squashfs-tools' 'systemd')
provides=('chromium-widevine')
conflicts=('chromium-widevine')
install=widevine.install
source=(widevine-fetch widevine-fetch.service widevine-fetch.timer widevine_fixup.py LICENSE)
sha256sums=('59e60d50143e8e17bb0835306f0ed56bbc428eb60b29a1b388255b1d0915415b'
            '751753344375b4620b8a423ed738f3f95d13e5bfe250e217378e14b89799a8f6'
            '6c6d685c79b235cf4539dbe6c184e262417775fef5f526f72bd232e6b7e0624b'
            '6e886755201f1ba9dab1ead5f11846bae321cbf343da1112f06c08c8a8012182'
            'b1ffbe2d8f0c6363b2dd7cfc9cee62ee63c7e2e4a343ad882fa94cf1357b3052')

package() {
  local cdm=/opt/WidevineCdm/chromium major=${pkgver%%.*} minor
  minor=${pkgver#*.}; minor=${minor%%.*}

  install -Dm755 "$srcdir/widevine-fetch" "$pkgdir/usr/bin/widevine-fetch"
  install -Dm644 "$srcdir/widevine_fixup.py" "$pkgdir/usr/lib/widevine/widevine_fixup.py"
  printf 'WIDEVINE_VERSION=%s\nLACROS_VERSION=%s\nLACROS_URL=%s\nLACROS_SHA256=%s\n' \
    "$pkgver" "$_lacros_version" "$_lacros_url" "$_lacros_sha256" > "$srcdir/source"
  install -Dm644 "$srcdir/source" "$pkgdir/usr/lib/widevine/source"
  install -Dm644 "$srcdir/widevine-fetch.service" -t "$pkgdir/usr/lib/systemd/system/"
  install -Dm644 "$srcdir/widevine-fetch.timer" -t "$pkgdir/usr/lib/systemd/system/"
  # Enabled by the package, not a preset: image presets only cover omarchy-mac's units.
  install -d "$pkgdir/usr/lib/systemd/system/timers.target.wants"
  ln -s ../widevine-fetch.timer "$pkgdir/usr/lib/systemd/system/timers.target.wants/widevine-fetch.timer"

  # Chromium: the CDM directory, its manifest, and the link Chromium looks for.
  install -d "$pkgdir$cdm/_platform_specific/linux_arm64" "$pkgdir$cdm/_platform_specific/linux_x64"
  cat > "$srcdir/manifest.json" <<JSON
{
   "name": "WidevineCdm",
   "description": "Widevine Content Decryption Module",
   "version": "$pkgver",
   "x-cdm-codecs": "vp8,vp9.0,avc1,av01",
   "x-cdm-host-versions": "$minor",
   "x-cdm-interface-versions": "$minor",
   "x-cdm-module-versions": "$major",
   "x-cdm-persistent-license-support": true
}
JSON
  install -Dm644 "$srcdir/manifest.json" "$pkgdir$cdm/manifest.json"
  install -d "$pkgdir/usr/lib/chromium"
  ln -s "$cdm" "$pkgdir/usr/lib/chromium/WidevineCdm"

  # Firefox: a system GMP directory, and prefs. widevine-fetch adds the library's link.
  local gmp=/opt/WidevineCdm/firefox/gmp-widevinecdm/system-installed
  install -d "$pkgdir$gmp"
  ln -s ../../../chromium/manifest.json "$pkgdir$gmp/manifest.json"
  cat > "$srcdir/widevine.js" <<JS
// Set preferences related to widevine loading
pref("media.gmp-widevinecdm.version", "$pkgver");
pref("media.gmp-widevinecdm.visible", true);
pref("media.gmp-widevinecdm.enabled", true);
pref("media.gmp-widevinecdm.autoupdate", false);
pref("media.eme.enabled", true);
pref("media.eme.encrypted-media-encryption-scheme.enabled", true);
JS
  install -Dm644 "$srcdir/widevine.js" -t "$pkgdir/usr/lib/firefox/browser/defaults/preferences/"
  printf '%s\n' "MOZ_GMP_PATH=\"\$MOZ_GMP_PATH\${MOZ_GMP_PATH:+:}$gmp\"" 'export MOZ_GMP_PATH' > "$srcdir/firefox_widevine.sh"
  install -Dm644 "$srcdir/firefox_widevine.sh" -t "$pkgdir/etc/profile.d/"

  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
