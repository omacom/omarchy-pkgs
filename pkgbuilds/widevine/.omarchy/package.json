{
  "source": "local",
  "review": true,
  "upstream": {
    "watch": {
      "regex": "https://raw.githubusercontent.com/asahi-alarm/PKGBUILDs/main/widevine/PKGBUILD",
      "pattern": "(?ms)^_lacros_version=(?P<lmajor>[0-9]+)\\.(?P<lminor>[0-9]+)\\.(?P<lbuild>[0-9]+)\\.(?P<lpatch>[0-9]+)$.*?^pkgver=(?P<version>[0-9.]+)$.*?^sha256sums_aarch64=\\('(?P<sha>[0-9a-f]{64})'",
      "variables": {
        "_lacros_version": "{lmajor}.{lminor}.{lbuild}.{lpatch}",
        "_lacros_sha256": "{sha}",
        "_lacros_revision": "{lmajor}{lbuild:0>6}{lpatch:0>4}"
      },
      "revision": "{lmajor}{lbuild:0>6}{lpatch:0>4}",
      "revision_variable": "_lacros_revision"
    }
  }
}
