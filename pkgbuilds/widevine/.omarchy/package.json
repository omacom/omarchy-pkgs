{
  "source": "local",
  "review": true,
  "upstream": {
    "watch": {
      "regex": "https://raw.githubusercontent.com/asahi-alarm/PKGBUILDs/main/widevine/PKGBUILD",
      "pattern": "(?ms)^_lacros_version=(?P<lacros>[0-9.]+)$.*?^pkgver=(?P<version>[0-9.]+)$.*?^sha256sums_aarch64=\\('(?P<sha>[0-9a-f]{64})'",
      "variables": {
        "_lacros_version": "{lacros}",
        "_lacros_sha256": "{sha}"
      }
    }
  }
}
