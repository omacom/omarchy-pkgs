[Unit]
Description=Fetch the Widevine CDM from Google
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/widevine-fetch
StateDirectory=widevine
CacheDirectory=widevine
ProtectSystem=strict
ReadWritePaths=/opt/WidevineCdm
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
Nice=10
IOSchedulingClass=idle
