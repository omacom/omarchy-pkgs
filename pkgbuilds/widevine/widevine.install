# Never fetch here: Google's licence has to be accepted by the user, in a
# terminal, so only 'sudo widevine-fetch' downloads and installs the library.
_widevine_notice() {
  echo ":: Widevine (DRM video in Chromium and Firefox) is not installed yet."
  echo "   Run 'sudo widevine-fetch' to download it from Google, read and accept"
  echo "   Google's licence, and install it. Then restart the browser."
}

post_install() {
  _widevine_notice
}

post_upgrade() {
  # 4.10.2891.0-2 enabled a timer that fetched the library without asking.
  if [ -d /run/systemd/system ] && ! systemd-detect-virt --quiet --chroot; then
    systemctl stop widevine-fetch.timer widevine-fetch.service >/dev/null 2>&1 || true
  fi
  # A library installed before the licence was shown goes until it is accepted.
  if [ ! -f /var/lib/widevine/accepted ]; then
    mkdir -p /run/widevine
    (flock -w 600 9 || true; _widevine_cleanup) 9>/run/widevine/fetch.lock
    _widevine_notice
  fi
}

_widevine_cleanup() {
  rm -f /opt/WidevineCdm/chromium/_platform_specific/linux_arm64/libwidevinecdm.so \
    /opt/WidevineCdm/chromium/_platform_specific/linux_arm64/libwidevinecdm.so.new \
    /opt/WidevineCdm/chromium/_platform_specific/linux_x64/libwidevinecdm.so \
    /opt/WidevineCdm/firefox/gmp-widevinecdm/system-installed/libwidevinecdm.so
  rm -rf /var/lib/widevine /var/cache/widevine
}

# Take widevine-fetch's lock so no fetch is mid-install while the fetched
# files are deleted.
pre_remove() {
  mkdir -p /run/widevine
  (flock -w 600 9 || true; _widevine_cleanup) 9>/run/widevine/fetch.lock
}

# A fetch that started before removal stops once the package is gone, but
# clean up after it anyway, along with the directories it leaves.
post_remove() {
  _widevine_cleanup
  rmdir /opt/WidevineCdm/chromium/_platform_specific/linux_arm64 \
    /opt/WidevineCdm/chromium/_platform_specific/linux_x64 \
    /opt/WidevineCdm/chromium/_platform_specific /opt/WidevineCdm/chromium \
    /opt/WidevineCdm/firefox/gmp-widevinecdm/system-installed \
    /opt/WidevineCdm/firefox/gmp-widevinecdm /opt/WidevineCdm/firefox /opt/WidevineCdm 2>/dev/null || true
  rm -rf /run/widevine
}
