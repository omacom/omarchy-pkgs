# The library is installed into the CDM directory here rather than owned by
# the package: 4.10.2891.0-2 and -3 fetched it to that path on the Mac, and an
# unowned file there would make pacman refuse the upgrade.
_widevine_lib=/opt/WidevineCdm/chromium/_platform_specific/linux_arm64/libwidevinecdm.so
# Chromium finds the arm64 library only when the x64 directory has one too.
_widevine_placeholder=/opt/WidevineCdm/chromium/_platform_specific/linux_x64/libwidevinecdm.so
_widevine_gmp_link=/opt/WidevineCdm/firefox/gmp-widevinecdm/system-installed/libwidevinecdm.so

_widevine_install() {
  install -Dm755 /usr/lib/widevine/libwidevinecdm.so "$_widevine_lib.new"
  mv -f "$_widevine_lib.new" "$_widevine_lib"
  [ -e "$_widevine_placeholder" ] || install -Dm644 /dev/null "$_widevine_placeholder"
  ln -sfn ../../../chromium/_platform_specific/linux_arm64/libwidevinecdm.so "$_widevine_gmp_link"
}

post_install() {
  _widevine_install
  echo ":: IMPORTANT: It might be needed to log out and back in for the changes"
  echo "   to take effect."
  echo "   Proper installation can be tested by browsing to"
  echo "   https://bitmovin.com/demos/drm"
}

post_upgrade() {
  _widevine_install
  # Left by 4.10.2891.0-2 and -3, which fetched the library on the Mac.
  if [ -d /run/systemd/system ] && ! systemd-detect-virt --quiet --chroot; then
    systemctl stop widevine-fetch.timer widevine-fetch.service >/dev/null 2>&1 || true
  fi
  rm -rf /var/lib/widevine /var/cache/widevine /run/widevine
}

post_remove() {
  rm -f "$_widevine_lib" "$_widevine_lib.new" "$_widevine_placeholder" "$_widevine_gmp_link"
  rm -rf /var/lib/widevine /var/cache/widevine /run/widevine
  rmdir /opt/WidevineCdm/chromium/_platform_specific/linux_arm64 \
    /opt/WidevineCdm/chromium/_platform_specific/linux_x64 \
    /opt/WidevineCdm/chromium/_platform_specific /opt/WidevineCdm/chromium \
    /opt/WidevineCdm/firefox/gmp-widevinecdm/system-installed \
    /opt/WidevineCdm/firefox/gmp-widevinecdm /opt/WidevineCdm/firefox /opt/WidevineCdm 2>/dev/null || true
}
