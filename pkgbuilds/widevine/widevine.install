# Never fetch here: an image build installs this package in a chroot.
# Outside one, start the timer so widevine-fetch.service runs on its own.
_widevine_schedule() {
  if [ -d /run/systemd/system ] && ! systemd-detect-virt --quiet --chroot; then
    systemctl --no-block start widevine-fetch.timer >/dev/null 2>&1 || true
  fi
  echo ":: Widevine is downloaded from Google once the network is up."
  echo "   Run 'sudo widevine-fetch' to fetch it now, then restart the browser."
}

post_install() {
  _widevine_schedule
}

post_upgrade() {
  _widevine_schedule
}

pre_remove() {
  rm -f /opt/WidevineCdm/chromium/_platform_specific/linux_arm64/libwidevinecdm.so \
    /opt/WidevineCdm/chromium/_platform_specific/linux_x64/libwidevinecdm.so \
    /opt/WidevineCdm/firefox/gmp-widevinecdm/system-installed/libwidevinecdm.so
  rm -rf /var/lib/widevine /var/cache/widevine
}
