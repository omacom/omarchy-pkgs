#!/bin/bash
# Download Google's Widevine CDM on this Mac and install it for Chromium and
# Firefox, once the user has read and accepted Google's licence for it. The
# package ships no Google code: this fetches the pinned ChromeOS Lacros image
# from Google, checks its sha256, shows the licence the image carries, and only
# after acceptance extracts libwidevinecdm.so and patches it for Asahi kernels
# (16K pages, missing glibc symbols).
#
#   sudo widevine-fetch            install unless already installed
#   sudo widevine-fetch --force    download and install again
#
# Nothing runs it on its own: it needs a terminal to ask for acceptance, and it
# never runs in a chroot, so an image build cannot fetch the blob.
set -euo pipefail

say() { echo "widevine-fetch: $*"; }

if [[ ! -d /run/systemd/system ]] || systemd-detect-virt --quiet --chroot; then
  say "not on a booted system; run it on the Mac itself"
  exit 0
fi

source /usr/lib/widevine/source

CDM_DIR=/opt/WidevineCdm/chromium/_platform_specific
LIB=$CDM_DIR/linux_arm64/libwidevinecdm.so
# Chromium finds the arm64 library only when the x64 directory has one too.
PLACEHOLDER=$CDM_DIR/linux_x64/libwidevinecdm.so
GMP_LINK=/opt/WidevineCdm/firefox/gmp-widevinecdm/system-installed/libwidevinecdm.so
STATE=/var/lib/widevine
CACHE=/var/cache/widevine
STAMP=$STATE/installed
# The licence text as accepted, and who accepted it when.
ACCEPTED_LICENSE=$STATE/LICENSE
ACCEPTED=$STATE/accepted
CHROME_TERMS=https://www.google.com/chrome/terms/
# Shared with the package's pre_remove, so removal and fetches never overlap.
LOCK=/run/widevine/fetch.lock

force=false
case ${1:-} in
--force) force=true ;;
"") ;;
*) echo "usage: widevine-fetch [--force]" >&2; exit 2 ;;
esac

stamp="$WIDEVINE_VERSION $LACROS_SHA256"
if [[ $force == false && -f $LIB && -L $GMP_LINK && -f $STAMP && -f $ACCEPTED && $(head -n1 "$STAMP") == "$stamp" ]] &&
  [[ $(sed -n 2p "$STAMP") == "$(sha256sum "$LIB" | cut -d' ' -f1)" ]]; then
  say "Widevine $WIDEVINE_VERSION is installed"
  exit 0
fi

if [[ ! -t 0 || ! -t 1 ]]; then
  say "Google's licence must be accepted in a terminal: run 'sudo widevine-fetch' there" >&2
  exit 1
fi
(( EUID == 0 )) || { echo "widevine-fetch: run it as root (sudo widevine-fetch)" >&2; exit 1; }

mkdir -p "${LOCK%/*}"
exec 9>"$LOCK"
flock 9
# The package may have been removed while this run waited for the lock.
[[ -f /usr/lib/widevine/source ]] || exit 0

mkdir -p "$STATE" "$CACHE"
image=$CACHE/lacros-$LACROS_VERSION.squashfs
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

if [[ ! -f $image ]] || ! sha256sum --quiet -c - <<<"$LACROS_SHA256  $image" 2>/dev/null; then
  say "downloading ChromeOS Lacros $LACROS_VERSION from Google (about 150 MB)"
  status=0
  curl --fail --location --show-error --progress-bar --continue-at - --retry 3 --retry-delay 10 \
    --connect-timeout 30 --output "$image.part" "$LACROS_URL" || status=$?
  if (( status != 0 )); then
    say "download failed (curl exit $status); nothing installed, run it again once online" >&2
    exit 1
  fi
  if ! sha256sum --quiet -c - <<<"$LACROS_SHA256  $image.part"; then
    rm -f "$image.part"
    say "the download does not match its pinned sha256; nothing installed" >&2
    exit 1
  fi
  mv -f "$image.part" "$image"
fi

cdm=WidevineCdm/_platform_specific/cros_arm64/libwidevinecdm.so
listing=$(unsquashfs -q -n -l "$image")
if ! grep -qxF "squashfs-root/$cdm" <<<"$listing"; then
  say "the image has no arm64 Widevine library; nothing installed" >&2
  exit 1
fi
# The licence is optional: an image without one gets Google's Chrome terms instead.
if grep -qxF squashfs-root/WidevineCdm/LICENSE <<<"$listing"; then
  unsquashfs -q -cat "$image" WidevineCdm/LICENSE > "$work/LICENSE"
  [[ -s $work/LICENSE ]] || { say "the image's licence is empty; nothing installed" >&2; exit 1; }
else
  printf 'Widevine is Google software, covered by the Google Chrome and ChromeOS\nAdditional Terms of Service: %s\n' "$CHROME_TERMS" > "$work/LICENSE"
fi

echo
echo "Widevine is Google's software, not Omarchy's. Its licence, from the image:"
echo "------------------------------------------------------------------------"
cat "$work/LICENSE"
echo "------------------------------------------------------------------------"
echo "Installing it patches Google's library on this Mac so it runs on Asahi kernels."
read -r -p "Type 'accept' to accept these terms and install Widevine: " answer
if [[ $answer != accept ]]; then
  say "not accepted; nothing installed"
  exit 1
fi

unsquashfs -q -n -d "$work/root" "$image" "$cdm"
install -m644 "$work/LICENSE" "$ACCEPTED_LICENSE"
printf 'accepted %s by %s\nlicence sha256 %s\nimage %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  "${SUDO_USER:-root}" "$(sha256sum "$ACCEPTED_LICENSE" | cut -d' ' -f1)" "$LACROS_VERSION" "$LACROS_SHA256" > "$ACCEPTED"

python3 -I /usr/lib/widevine/widevine_fixup.py "$work/root/$cdm" "$work/libwidevinecdm.so" >/dev/null

install -Dm755 "$work/libwidevinecdm.so" "$LIB.new"
mv -f "$LIB.new" "$LIB"
[[ -e $PLACEHOLDER ]] || install -Dm644 /dev/null "$PLACEHOLDER"
ln -sfn ../../../chromium/_platform_specific/linux_arm64/libwidevinecdm.so "$GMP_LINK"
printf '%s\n%s\n' "$stamp" "$(sha256sum "$LIB" | cut -d' ' -f1)" > "$STAMP"
rm -f "$CACHE"/lacros-*.squashfs "$CACHE"/lacros-*.part
say "installed Widevine $WIDEVINE_VERSION; the accepted licence is in $ACCEPTED_LICENSE"
say "restart Chromium or Firefox to use it"
