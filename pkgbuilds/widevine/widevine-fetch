#!/bin/bash
# Download Google's Widevine CDM on this Mac and install it for Chromium and
# Firefox. The package ships no Google code: this fetches the pinned ChromeOS
# Lacros image from Google, checks its sha256, extracts libwidevinecdm.so and
# patches it for Asahi kernels (16K pages, missing glibc symbols).
#
#   widevine-fetch            fetch and install unless already installed
#   widevine-fetch --force    fetch and install again
#
# Being offline is not an error: it exits 0 and widevine-fetch.timer tries
# again. It never runs in a chroot, so an image build cannot fetch the blob.
set -euo pipefail

say() { echo "widevine-fetch: $*"; }

if [[ ! -d /run/systemd/system ]] || systemd-detect-virt --quiet --chroot; then
  say "not on a booted system; Widevine is fetched on the Mac itself"
  exit 0
fi

source /usr/lib/widevine/source

CDM_DIR=/opt/WidevineCdm/chromium/_platform_specific
LIB=$CDM_DIR/linux_arm64/libwidevinecdm.so
# Chromium finds the arm64 library only when the x64 directory has one too.
PLACEHOLDER=$CDM_DIR/linux_x64/libwidevinecdm.so
GMP_LINK=/opt/WidevineCdm/firefox/gmp-widevinecdm/system-installed/libwidevinecdm.so
STATE=${STATE_DIRECTORY:-/var/lib/widevine}
CACHE=${CACHE_DIRECTORY:-/var/cache/widevine}
STAMP=$STATE/installed
# Shared with the package's pre_remove, so removal and fetches never overlap.
LOCK=/run/widevine/fetch.lock

force=false
case ${1:-} in
--force) force=true ;;
"") ;;
*) echo "usage: widevine-fetch [--force]" >&2; exit 2 ;;
esac

(( EUID == 0 )) || { echo "widevine-fetch: run it as root (sudo widevine-fetch)" >&2; exit 1; }

mkdir -p "${LOCK%/*}"
exec 9>"$LOCK"
flock 9
# The package may have been removed while this run waited for the lock.
[[ -f /usr/lib/widevine/source ]] || exit 0

stamp="$WIDEVINE_VERSION $LACROS_SHA256"
if [[ $force == false && -f $LIB && -L $GMP_LINK && -f $STAMP && $(head -n1 "$STAMP") == "$stamp" ]] &&
  [[ $(sed -n 2p "$STAMP") == "$(sha256sum "$LIB" | cut -d' ' -f1)" ]]; then
  say "Widevine $WIDEVINE_VERSION is installed"
  exit 0
fi

mkdir -p "$STATE" "$CACHE"
image=$CACHE/lacros-$LACROS_VERSION.squashfs
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

if [[ ! -f $image ]] || ! sha256sum --quiet -c - <<<"$LACROS_SHA256  $image" 2>/dev/null; then
  say "downloading ChromeOS Lacros $LACROS_VERSION from Google"
  status=0
  curl --fail --location --silent --show-error --continue-at - --retry 3 --retry-delay 10 \
    --connect-timeout 30 --output "$image.part" "$LACROS_URL" || status=$?
  case $status in
  0) ;;
  5 | 6 | 7 | 28 | 35 | 52 | 55 | 56)
    say "no network (curl exit $status); widevine-fetch.timer will try again"
    exit 0 ;;
  *) rm -f "$image.part"; say "download failed (curl exit $status)" >&2; exit 1 ;;
  esac
  if ! sha256sum --quiet -c - <<<"$LACROS_SHA256  $image.part"; then
    rm -f "$image.part"
    say "the download does not match its pinned sha256; nothing installed" >&2
    exit 1
  fi
  mv -f "$image.part" "$image"
fi

unsquashfs -q -n -d "$work/root" "$image" 'WidevineCdm/_platform_specific/cros_arm64/libwidevinecdm.so'
python3 -I /usr/lib/widevine/widevine_fixup.py \
  "$work/root/WidevineCdm/_platform_specific/cros_arm64/libwidevinecdm.so" "$work/libwidevinecdm.so" >/dev/null

install -Dm755 "$work/libwidevinecdm.so" "$LIB.new"
mv -f "$LIB.new" "$LIB"
[[ -e $PLACEHOLDER ]] || install -Dm644 /dev/null "$PLACEHOLDER"
ln -sfn ../../../chromium/_platform_specific/linux_arm64/libwidevinecdm.so "$GMP_LINK"
printf '%s\n%s\n' "$stamp" "$(sha256sum "$LIB" | cut -d' ' -f1)" > "$STAMP"
rm -f "$CACHE"/lacros-*.squashfs "$CACHE"/lacros-*.part
say "installed Widevine $WIDEVINE_VERSION; restart Chromium or Firefox to use it"
