# Maintainer: David Heinemeier Hansson <david@hey.com>

pkgname=flowtunes
pkgver=0.1.0
pkgrel=1
pkgdesc='Endless music in the genre you pick, made with Omarchy local music models'
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/flowtunes'
license=('MIT')
install='flowtunes.install'
options=('!debug')
depends=(
  'ffmpeg'
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-multimedia'
  'qt6-multimedia-ffmpeg'
  'qt6-svg'
  'qt6-wayland'
)
optdepends=(
  'omarchy-local-ai: runs the music model Flowtunes plays with'
)
makedepends=(
  'cmake'
  'gcc'
  'make'
  'qt6-shadertools'
)
checkdepends=(
  'noto-fonts'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('43813be282ae2a9c2b0ae0cce9183cf5a2fd44086de10b185477ca34aa20fdb5')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build --prefix /usr
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
