{
  "source": "local",
  "rebuild_on": [
    "libwebp"
  ],
  "auto_merge": true,
  "upstream": {
    "watch": {
      "github": "omacom/hype",
      "pattern": "v(?P<version>[0-9]+(?:\\.[0-9]+)*)"
    }
  },
  "rebuilt_against": {
    "x86_64": {
      "libwebp": "1.6.0-2"
    },
    "aarch64": {
      "libwebp": "1.6.0-2"
    }
  }
}
