# Maintainer: Adrian Rangel <adrian.rangel@gmail.com>
pkgname=omarchy-polkit
pkgver=1.0.0
pkgrel=1
pkgdesc='Lock-aware presence authentication for Omarchy Polkit'
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/omarchy'
license=('MIT')
depends=('pam' 'python')
_commit=107d67f9c4c0ce8c610ff9593443e467c707ca90

# Pin reviewed security code independently of the stable/dev desktop source.
# This dependency must survive supported channel switches.
if [[ -n ${OMARCHY_SRC:-} ]]; then
  source=()
  sha256sums=()
else
  source=(
    "polkit-lock-guard.c::https://raw.githubusercontent.com/omacom/omarchy/${_commit}/default/pam/polkit-lock-guard.c"
    "polkit-lock-guard.py::https://raw.githubusercontent.com/omacom/omarchy/${_commit}/default/pam/polkit-lock-guard.py"
    "LICENSE::https://raw.githubusercontent.com/omacom/omarchy/${_commit}/LICENSE"
  )
  sha256sums=('726db17aa485c612ad33605fc3adb19483494436b345d02c84944b1e6d6d0bc3' 'e5c1d9692dd460dafeb4da0ec790b264d42cb5e6a6e2da36f0663cc1ca47d0c9' '717ba1949502290f8e47688ae2e323acd06c8ca47aec9f7596b15f678c1af4a2')
fi

prepare() {
  if [[ -n ${OMARCHY_SRC:-} ]]; then
    cp "$OMARCHY_SRC/default/pam/polkit-lock-guard.c" "$srcdir/"
    cp "$OMARCHY_SRC/default/pam/polkit-lock-guard.py" "$srcdir/"
    cp "$OMARCHY_SRC/LICENSE" "$srcdir/"
  fi
}

build() {
  cc $CFLAGS -fPIC -shared $LDFLAGS -Wl,-z,relro,-z,now \
    -o pam_omarchy_lock.so polkit-lock-guard.c -lpam
}

package() {
  install -Dm644 pam_omarchy_lock.so "$pkgdir/usr/lib/security/pam_omarchy_lock.so"
  install -Dm644 polkit-lock-guard.py "$pkgdir/usr/lib/omarchy/polkit-lock-guard"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/omarchy-polkit/LICENSE"
}
