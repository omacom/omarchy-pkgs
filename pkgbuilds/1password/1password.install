# Do not add your user, or any others, to this group.
GROUP_NAME="onepassword"
POLICY_TPL="/opt/1Password/com.1password.1Password.policy.tpl"
POLICY_DEST="/usr/share/polkit-1/actions/com.1password.1Password.policy"

# First 10 human accounts (UID 1000-9999), same rule as the vendor template.
policy_owners_from_passwd() {
    local passwd="${1:-/etc/passwd}"
    cut -d: -f1,3 "$passwd" | grep -E ':[0-9]{4}$' | cut -d: -f1 | head -n 10 | sed 's/^/unix-user:/' | tr '\n' ' '
}

render_1password_polkit_policy() {
    local tpl="${1:-$POLICY_TPL}"
    local dest="${2:-$POLICY_DEST}"
    local passwd="${3:-/etc/passwd}"
    export POLICY_OWNERS
    POLICY_OWNERS="$(policy_owners_from_passwd "$passwd")"
    eval "cat <<EOF
$(cat "$tpl")
EOF" > "$dest"
}

app_group_exists() {
    if [ $(getent group "${GROUP_NAME}") ]; then
        true
    else
        false
    fi
}

setup_browser_helper() {
    # Setup the Core App Integration helper binary with the correct permissions and group
    BROWSER_SUPPORT_PATH="/opt/1Password/1Password-BrowserSupport"

    chgrp "${GROUP_NAME}" $BROWSER_SUPPORT_PATH
    chmod g+s $BROWSER_SUPPORT_PATH
}

pre_install() {
    if app_group_exists; then
        : # Do nothing
    else
        groupadd "${GROUP_NAME}"
    fi
}

pre_upgrade() {
    if app_group_exists; then
        : # Do nothing
    else
        groupadd "${GROUP_NAME}"
    fi
}

post_install() {
    setup_browser_helper
    render_1password_polkit_policy
}

post_upgrade() {
    setup_browser_helper
    render_1password_polkit_policy
}

post_remove() {
    if app_group_exists; then
        groupdel "${GROUP_NAME}"
    fi
}
