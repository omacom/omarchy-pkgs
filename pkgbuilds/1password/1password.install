# Do not add your user, or any others, to this group.
GROUP_NAME="onepassword"

POLICY_FILE="/usr/share/polkit-1/actions/com.1password.1Password.policy"

# Polkit matches an action owner against the caller's user, never a group, so
# the owners are this machine's first ten human accounts, as the vendor's own
# installer chooses them. A user added later is picked up at the next upgrade.
set_policy_owners() {
    local policy="${1:-$POLICY_FILE}" passwd="${2:-/etc/passwd}" owners
    owners=$(awk -F: '$3 >= 1000 && $3 <= 9999 && $1 ~ /^[a-z_][a-z0-9_-]*$/ { print "unix-user:" $1 }' "$passwd" | head -n 10 | tr '\n' ' ')
    owners=${owners% }
    [ -n "$owners" ] || return 0
    sed -i "s|\(<annotate key=\"org.freedesktop.policykit.owner\">\)[^<]*\(</annotate>\)|\1${owners}\2|" "$policy"
}

app_group_exists() {
    if [ $(getent group "${GROUP_NAME}") ]; then
        true
    else
        false
    fi
}

setup_browser_helper() {
    # Setup the Core App Integration helper binary with the correct permissions and group
    BROWSER_SUPPORT_PATH="/opt/1Password/1Password-BrowserSupport"

    chgrp "${GROUP_NAME}" $BROWSER_SUPPORT_PATH
    chmod g+s $BROWSER_SUPPORT_PATH
}

pre_install() {
    if app_group_exists; then
        : # Do nothing
    else
        groupadd "${GROUP_NAME}"
    fi
}

pre_upgrade() {
    if app_group_exists; then
        : # Do nothing
    else
        groupadd "${GROUP_NAME}"
    fi
}

post_install() {
    setup_browser_helper
    set_policy_owners
}

post_upgrade() {
    setup_browser_helper
    set_policy_owners
}

post_remove() {
    if app_group_exists; then
        groupdel "${GROUP_NAME}"
    fi
}
