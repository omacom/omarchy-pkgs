# Do not add your user, or any others, to this group.
GROUP_NAME="onepassword"
MCP_GROUP_NAME="onepassword-mcp"

app_group_exists() {
    if [ $(getent group "${GROUP_NAME}") ]; then
        true
    else
        false
    fi
}

setup_browser_helper() {
    # Setup the Core App Integration helper binary with the correct permissions and group
    BROWSER_SUPPORT_PATH="/opt/1Password/1Password-BrowserSupport"

    chgrp "${GROUP_NAME}" $BROWSER_SUPPORT_PATH
    chmod g+s $BROWSER_SUPPORT_PATH
}

setup_mcp_helper() {
    # The desktop app verifies MCP peers using this dedicated effective GID.
    # Do not add users to this group.
    if ! getent group "${MCP_GROUP_NAME}" >/dev/null; then
        groupadd "${MCP_GROUP_NAME}" || return
    fi

    chgrp "${MCP_GROUP_NAME}" /opt/1Password/1password-mcp &&
        chmod g+s /opt/1Password/1password-mcp
}

pre_install() {
    if app_group_exists; then
        : # Do nothing
    else
        groupadd "${GROUP_NAME}"
    fi
}

pre_upgrade() {
    if app_group_exists; then
        : # Do nothing
    else
        groupadd "${GROUP_NAME}"
    fi
}

post_install() {
    setup_browser_helper && setup_mcp_helper
}

post_upgrade() {
    setup_browser_helper && setup_mcp_helper
}

post_remove() {
    if app_group_exists; then
        groupdel "${GROUP_NAME}"
    fi
    if getent group "${MCP_GROUP_NAME}" >/dev/null; then
        groupdel "${MCP_GROUP_NAME}"
    fi
}
