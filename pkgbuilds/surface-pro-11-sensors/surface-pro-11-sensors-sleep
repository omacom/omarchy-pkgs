#!/bin/bash

# Stop iio-sensor-proxy across suspend and restart it afterwards. Once a client
# claims the light sensor, the ADSP stream stays open, and its indications wake
# the SoC shortly into every deep suspend. The stream only ends when the
# daemon's QMI client exits; clients reconnect after resume.

compatible=${SP11_SENSORS_COMPATIBLE:-/proc/device-tree/compatible}
unit=iio-sensor-proxy.service
flag=${SP11_SENSORS_SLEEP_FLAG:-/run/surface-pro-11-sensors-sleep.stopped}

[[ -r $compatible ]] && tr '\0' '\n' <"$compatible" | grep -qx 'microsoft,denali-oled' || exit 0

case ${1:-} in
  pre)
    rm -f "$flag"
    if systemctl is-active --quiet "$unit"; then
      systemctl stop "$unit" && touch "$flag"
    fi
    ;;
  post)
    if [[ -e $flag ]]; then
      rm -f "$flag"
      systemctl start "$unit"
    fi
    ;;
esac
exit 0
