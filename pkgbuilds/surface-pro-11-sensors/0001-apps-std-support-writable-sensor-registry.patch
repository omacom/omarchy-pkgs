+static uint32_t apps_std_fremove(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const char *path = inbufs[1].p;
+	int ret;
+
+	if (inbufs[1].s == 0 ||
+	    ((const char *) inbufs[1].p)[inbufs[1].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	if (!apps_std_is_registry_path(path)) {
+		fprintf(stderr, "Tried to remove %s\n", path);
+		return AEE_EUNSUPPORTED;
+	}
+
+	ret = hexagonfs_unlinkat(ctx->fds, ctx->rootfd, ctx->rootfd, path, 0);
+	if (ret && ret != -ENOENT) {
+		fprintf(stderr, "Could not remove %s: %s\n",
+			path, strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("remove(%s)\n", path);
+#endif
+
+	return 0;
+}
