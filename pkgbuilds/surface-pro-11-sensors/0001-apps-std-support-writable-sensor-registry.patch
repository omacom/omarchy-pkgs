+static uint32_t apps_std_frename(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const char *old_path = inbufs[1].p;
+	const char *new_path = inbufs[2].p;
+	int ret;
+
+	if (inbufs[1].s == 0 || inbufs[2].s == 0 ||
+	    old_path[inbufs[1].s - 1] != '\0' ||
+	    new_path[inbufs[2].s - 1] != '\0')
+		return AEE_EBADPARM;
+
+	if (!apps_std_is_registry_path(old_path) ||
+	    !apps_std_is_registry_path(new_path)) {
+		fprintf(stderr, "Tried to rename %s to %s\n",
+			old_path, new_path);
+		return AEE_EUNSUPPORTED;
+	}
+
+	ret = hexagonfs_renameat(ctx->fds, ctx->rootfd, ctx->rootfd,
+				 old_path, ctx->rootfd, new_path);
+	if (ret) {
+		fprintf(stderr, "Could not rename %s to %s: %s\n",
+			old_path, new_path, strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+	return 0;
+}
