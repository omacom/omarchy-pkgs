 	return fd->ops->read(fd, size, ptr);
 }
 
+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size,
+			const void *ptr)
+{
+	struct hexagonfs_fd *fd;
+
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return -EBADF;
+
+	fd = fds[fileno];
+	if (fd == NULL)
+		return -EBADF;
+
+	if (fd->ops->write == NULL)
+		return -ENOSYS;
+
+	return fd->ops->write(fd, size, ptr);
+}
+
+int hexagonfs_fsync(struct hexagonfs_fd **fds, int fileno)
+{
+	struct hexagonfs_fd *fd;
+
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return -EBADF;
+
+	fd = fds[fileno];
+	if (fd == NULL)
+		return -EBADF;
+
+	if (fd->ops->fsync == NULL)
+		return -ENOSYS;
+
+	return fd->ops->fsync(fd);
+}
+
+int hexagonfs_unlinkat(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+		       const char *name, int flags)
+{
+	struct hexagonfs_fd *dir;
+	char *path;
+	char *base;
+	int parentfd;
+	bool close_parent = false;
+	int ret;
+
+	path = strdup(name);
+	if (path == NULL)
+		return -ENOMEM;
+
+	base = strrchr(path, '/');
+	if (base != NULL) {
+		*base++ = '\0';
+		if (path[0] == '\0') {
+			parentfd = rootfd;
+		} else {
+			parentfd = hexagonfs_openat(fds, rootfd, dirfd, path);
+			close_parent = parentfd >= 0;
+		}
+	} else {
+		base = path;
+		parentfd = dirfd;
+	}
+
+	if (parentfd < 0) {
+		ret = parentfd;
+		goto out;
+	}
+
+	dir = fds[parentfd];
+	if (base[0] == '\0' || !strcmp(base, ".") || !strcmp(base, ".."))
+		ret = -EINVAL;
+	else if (dir->ops->unlinkat == NULL)
+		ret = -ENOSYS;
+	else
+		ret = dir->ops->unlinkat(dir, base, flags);
+
+	if (close_parent)
+		hexagonfs_close(fds, parentfd);
+out:
+	free(path);
+	return ret;
+}
+
+struct parent_path {
+	char *path;
+	char *base;
+	int fd;
+	bool close_fd;
+};
+
+static int hexagonfs_open_parent(struct hexagonfs_fd **fds, int rootfd,
+				 int dirfd, const char *name,
+				 struct parent_path *parent)
+{
+	char *slash;
+
+	parent->path = strdup(name);
+	if (parent->path == NULL)
+		return -ENOMEM;
+
+	slash = strrchr(parent->path, '/');
+	if (slash != NULL) {
+		*slash++ = '\0';
+		parent->base = slash;
+		if (parent->path[0] == '\0') {
+			parent->fd = rootfd;
+			parent->close_fd = false;
+		} else {
+			parent->fd = hexagonfs_openat(fds, rootfd, dirfd,
+						      parent->path);
+			parent->close_fd = parent->fd >= 0;
+		}
+	} else {
+		parent->base = parent->path;
+		parent->fd = dirfd;
+		parent->close_fd = false;
+	}
+
+	if (parent->fd < 0)
+		return parent->fd;
+
+	if (parent->base[0] == '\0' || !strcmp(parent->base, ".") ||
+	    !strcmp(parent->base, ".."))
+		return -EINVAL;
+
+	return 0;
+}
+
+static void hexagonfs_close_parent(struct hexagonfs_fd **fds,
+				   struct parent_path *parent)
+{
+	if (parent->close_fd)
+		hexagonfs_close(fds, parent->fd);
+	free(parent->path);
+}
+
+int hexagonfs_renameat(struct hexagonfs_fd **fds, int rootfd, int olddirfd,
+		       const char *oldname, int newdirfd, const char *newname)
+{
+	struct parent_path old_parent = { 0 };
+	struct parent_path new_parent = { 0 };
+	struct hexagonfs_fd *old_dir;
+	struct hexagonfs_fd *new_dir;
+	int ret;
+
+	ret = hexagonfs_open_parent(fds, rootfd, olddirfd, oldname,
+				    &old_parent);
+	if (ret)
+		goto out_old;
+
+	ret = hexagonfs_open_parent(fds, rootfd, newdirfd, newname,
+				    &new_parent);
+	if (ret)
+		goto out_new;
+
+	old_dir = fds[old_parent.fd];
+	new_dir = fds[new_parent.fd];
+	if (old_dir->ops->renameat == NULL ||
+	    old_dir->ops->renameat != new_dir->ops->renameat)
+		ret = -ENOSYS;
+	else
+		ret = old_dir->ops->renameat(old_dir, old_parent.base,
+					     new_dir, new_parent.base);
+
+out_new:
+	hexagonfs_close_parent(fds, &new_parent);
+out_old:
+	hexagonfs_close_parent(fds, &old_parent);
+	return ret;
+}
+
 int hexagonfs_readdir(struct hexagonfs_fd **fds, int fileno, size_t ent_size, char *ent)
 {
 	struct hexagonfs_fd *fd;
