+static int test_mapped_write_remove(void)
+{
+	struct hexagonfs_fd *fds[HEXAGONFS_MAX_FD] = { 0 };
+	char dir_template[] = "/tmp/hexagonrpc-test-XXXXXX";
+	char file_path[sizeof(dir_template) + sizeof("/registry")];
+	char renamed_path[sizeof(dir_template) + sizeof("/registry-renamed")];
+	struct hexagonfs_dirent root = {
+		.name = "/",
+		.ops = &hexagonfs_mapped_ops,
+	};
+	const char contents[] = "persistent registry";
+	char readback[sizeof(contents)] = { 0 };
+	char *dir;
+	int rootfd;
+	int fd;
+	int ret = 1;
+
+	dir = mkdtemp(dir_template);
+	if (dir == NULL)
+		return 1;
+	snprintf(file_path, sizeof(file_path), "%s/registry", dir);
+	snprintf(renamed_path, sizeof(renamed_path), "%s/registry-renamed", dir);
+
+	root.u.phys = dir;
+	rootfd = hexagonfs_open_root(fds, &root);
+	if (rootfd < 0)
+		goto out_dir;
+
+	fd = hexagonfs_openat_flags(fds, rootfd, rootfd, "registry",
+				    O_WRONLY | O_CREAT | O_TRUNC, 0600);
+	if (fd < 0)
+		goto out_root;
+
+	if (hexagonfs_write(fds, fd, sizeof(contents), contents) != sizeof(contents))
+		goto out_file;
+	if (hexagonfs_fsync(fds, fd))
+		goto out_file;
+	if (hexagonfs_close(fds, fd))
+		goto out_root;
+
+	fd = hexagonfs_openat(fds, rootfd, rootfd, "registry");
+	if (fd < 0)
+		goto out_root;
+	if (hexagonfs_read(fds, fd, sizeof(readback), readback) != sizeof(readback))
+		goto out_file;
+	if (memcmp(contents, readback, sizeof(contents)))
+		goto out_file;
+	if (hexagonfs_close(fds, fd))
+		goto out_root;
+
+	if (hexagonfs_renameat(fds, rootfd, rootfd, "/registry",
+			      rootfd, "/registry-renamed"))
+		goto out_root;
+	if (access(file_path, F_OK) == 0 || access(renamed_path, F_OK) != 0)
+		goto out_root;
+	if (hexagonfs_unlinkat(fds, rootfd, rootfd, "/registry-renamed", 0))
+		goto out_root;
+	if (access(renamed_path, F_OK) == 0)
+		goto out_root;
+
+	ret = 0;
+	goto out_root;
+
+out_file:
+	hexagonfs_close(fds, fd);
+out_root:
+	hexagonfs_close(fds, rootfd);
+out_dir:
+	unlink(file_path);
+	unlink(renamed_path);
+	rmdir(dir_template);
+	return ret;
+}
