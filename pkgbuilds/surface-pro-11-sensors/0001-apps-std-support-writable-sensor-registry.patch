+static bool apps_std_is_registry_path(const char *path)
+{
+	static const char *const prefixes[] = {
+		"/persist/sensors/registry/",
+		"/mnt/vendor/persist/sensors/registry/",
+	};
+	size_t i;
+
+	for (i = 0; i < sizeof(prefixes) / sizeof(prefixes[0]); i++) {
+		const char *relative;
+		const char *name;
+
+		if (strncmp(path, prefixes[i], strlen(prefixes[i])))
+			continue;
+
+		relative = path + strlen(prefixes[i]);
+		if (!strcmp(relative, "sns_reg_version") ||
+		    !strcmp(relative, "parsed_file_list.csv") ||
+		    !strcmp(relative, "fstempfile"))
+			return true;
+
+		if (strncmp(relative, "registry/", strlen("registry/")))
+			continue;
+
+		name = relative + strlen("registry/");
+		if (name[0] != '\0' && strcmp(name, ".") &&
+		    strcmp(name, "..") && strchr(name, '/') == NULL)
+			return true;
+	}
+
+	return false;
+}
