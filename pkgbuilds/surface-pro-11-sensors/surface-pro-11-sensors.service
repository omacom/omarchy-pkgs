[Unit]
Description=Surface Pro 11 Qualcomm sensor service
Documentation=file:///usr/share/doc/surface-pro-11-sensors/README.package.md
ConditionFirmware=device-tree-compatible(microsoft,denali-oled)
BindsTo=dev-fastrpc\x2dadsp.device
After=systemd-modules-load.service dev-fastrpc\x2dadsp.device
Before=iio-sensor-proxy.service
ConditionPathExists=/dev/fastrpc-adsp
ConditionPathExists=/var/lib/surface-pro-11-sensors/root/sensors/sns_reg.conf
ConditionPathExists=/var/lib/surface-pro-11-sensors/root/sensors/config/json.lst

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/usr/lib/surface-pro-11-sensors
ExecStart=/usr/lib/surface-pro-11-sensors/hexagonrpcd -f /dev/fastrpc-adsp -d adsp -s -R /var/lib/surface-pro-11-sensors/root
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
MemoryDenyWriteExecute=true
ReadOnlyPaths=/var/lib/surface-pro-11-sensors/root
ReadWritePaths=/var/lib/surface-pro-11-sensors/root/sensors/persist

[Install]
# Start when the ADSP appears, so a missing DSP never holds up boot.
WantedBy=dev-fastrpc\x2dadsp.device
