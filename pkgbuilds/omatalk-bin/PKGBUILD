# Maintainer: zerobearing2

pkgname=omatalk-bin
_pkgname=${pkgname%-bin}
pkgver=0.12.2
pkgrel=1
pkgdesc='Local text-to-speech for Omarchy: a hotkey speaks the selected text (pre-built binary)'
arch=('x86_64')
url='https://github.com/zerobearing2/omatalk'
license=('MIT')
depends=(
    'glibc'
    'gcc-libs'
    'bzip2'
    'onnxruntime-cpu'
    'espeak-ng'
    'pipewire-audio'
    'libpulse'
    'wl-clipboard'
    'libnotify'
    'curl'
)
install="${pkgname}.install"
options=('!strip' '!debug')
noextract=("${_pkgname}-${pkgver}-x86_64.tar.gz")

source=("${_pkgname}-${pkgver}-x86_64.tar.gz::${url}/releases/download/v${pkgver}/${_pkgname}-x86_64.tar.gz"
        'package-remove'
        'package-restart'
        'remove-user-services.hook'
        'restart-user-services.hook')
sha256sums=('1a0795115a61b07303a42afc1a0f3acf162ad4095c46a967ce1b67d8c5eed344'
            '66524e5151ab453c25a9618c526f39e586d70d1269eb71c5938594d148c3392d'
            '53616c5a55bc8604b5184f9ee7c5d26753fc422498e189842f10aa0587f43bb2'
            'f10b3de7711f67291de747f59f3f53d37887607b0fd43bd26ae7891bbecc4e78'
            'bcfead668fa0b13886698cf3a2247a9d7364abf58bc31c777b18c301d6c0720c')

package() {
    local root="${srcdir}/release"
    install -d "${root}"
    bsdtar --no-same-owner -xf "${srcdir}/${_pkgname}-${pkgver}-x86_64.tar.gz" \
        -C "${root}" --strip-components 1

    install -Dm755 "${root}/omatalk" "${pkgdir}/usr/bin/omatalk"
    install -Dm644 "${root}/omatalk.service" \
        "${pkgdir}/usr/lib/systemd/user/omatalk.service"
    install -Dm644 "${root}/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    local plugin=usr/share/omatalk/omarchy-plugin/zerobearing.omatalk
    install -d "${pkgdir}/${plugin}"
    local file
    for file in "${root}/omarchy-plugin/zerobearing.omatalk/"*; do
        install -m644 "${file}" "${pkgdir}/${plugin}/"
    done

    install -Dm755 "${srcdir}/package-remove" "${pkgdir}/usr/lib/omatalk/package-remove"
    install -Dm755 "${srcdir}/package-restart" "${pkgdir}/usr/lib/omatalk/package-restart"
    install -Dm644 "${srcdir}/remove-user-services.hook" \
        "${pkgdir}/usr/share/libalpm/hooks/30-omatalk-remove-user-services.hook"
    install -Dm644 "${srcdir}/restart-user-services.hook" \
        "${pkgdir}/usr/share/libalpm/hooks/35-omatalk-restart-user-services.hook"
}
