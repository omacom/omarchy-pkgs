# Maintainer: Douglas Moura <doug@douglasmoura.com>

pkgname=winkel
pkgver=0.1.0
pkgrel=1
pkgdesc='A metronome for Omarchy that follows the live theme'
arch=('x86_64' 'aarch64')
url='https://github.com/DouglasdeMoura/winkel'
license=('MIT')

depends=(
  'alsa-lib'
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
  'quickshell'
)
makedepends=('cargo')
optdepends=(
  'ttf-jetbrains-mono-nerd: the default interface font'
)
conflicts=('winkel-bin' 'winkel-git')

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('3f5418ed458f1513a23235e38497fc0ae471986f32d1856072599bc3884aacae')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  WINKEL_SILENT=1 cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  make install PREFIX=/usr DESTDIR="$pkgdir"
}
