# Aurora bootloader; ordinary updates refresh ESP Stage 2, never enroll Stage 1.
# TEST PIN for the 7.3 qualification builds, not for release as is.
# scottjones/aura test/aurora-7.3 at aa37bc76: aurora-silicon/aura main
# at 3351432d (2026-11-13, version 1.0.0b13) plus the omacom/m1n1 fixes it
# lacks (#25, #31, #32, #42, #44, #48's dptx fix), and two M3 fixes: the
# boot loop (aura 18ba01e2's RVBAR store) and the silent speakers (no
# amp-tx-zd-config on T8122). Not in aurora-silicon/aura.
# The boot logo is Omarchy's, from m1n1-aurora's art, instead of Aurora's.
# This source has no monitor: it needs a kernel built with
# CONFIG_ARM64_CTXR_EXECMEM, which the 7.3 linux-aurora test pin has.
# m1n1-aurora replaces this package, so a tester installs it by name and
# holds m1n1-aurora back; see the pull request for the steps.
pkgname=aura
pkgver=1.0.0b13.r20261113
pkgrel=3
pkgdesc='Aurora Silicon bootloader for Apple Silicon'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/aurora-silicon/aura'
license=('MIT' 'GPL-2.0-only')
_commit=aa37bc764be9204c2ac2e26ac7ba9671383644bb
# Matches the m1n1-aurora it stands in for.
_compat=1.6.1.aurora23
provides=("m1n1=$_compat" "m1n1-aurora=$_compat" "m1n1-neo=$_compat")
conflicts=('m1n1' 'm1n1-aurora' 'm1n1-neo')
replaces=('m1n1-neo')
makedepends=('git' 'clang' 'lld' 'llvm' 'rustup' 'make' 'python')
options=('!strip' '!debug')
# The pinned commit lives only in the fork.
_source=https://github.com/scottjones/aura
# The Omarchy boot logo, the same raw RGBA art m1n1-aurora ships.
source=("aura::git+$_source.git#commit=$_commit" build-qualification.json validate-qualification.py
        bootlogo_48.bin bootlogo_128.bin bootlogo_256.bin)
sha256sums=('SKIP' 'fe11557af2bc5060c3651c4b731815b52ed0f74f20d17e32ee516af51a6d5594' 'd89f89a68105e4663bdf14bf9d4d70f3fad79538a4c566e8fae73c0b40a9be26'
            '6668050653645711ad7523fe2abeb4cbe85a92c875f3eec754b6db23cea2191c'
            'b19cb017645c7a9068ea0be9b6bb394131d7ca11b28093cf6caa1ffca74b0a4e'
            '9c659b392aacfa31c62c638003d2257abfdbe17919b5c90cde4c4e62f87addab')
prepare() {
  rustup toolchain install 1.99.0 --profile minimal --target aarch64-unknown-none-softfloat
  [[ $(git -C aura rev-parse HEAD) == "$_commit" ]]
  # aura links <name>_{48,128,256}.bin from LOGO_DIR as its built-in logo.
  local size
  for size in 48 128 256; do
    install -Dm644 "$srcdir/bootlogo_$size.bin" "$srcdir/logo/omarchy_$size.bin"
  done
}
build() {
  cd aura
  export RUSTUP_TOOLCHAIN=1.99.0
  # The pin is not a release tag: label the build <VERSION>-g<commit>.
  export AURA_VERSION_TAG="$(cat VERSION)-g${_commit:0:8}"
  make clean
  make -j"${OMARCHY_BUILD_JOBS:-10}" RELEASE=1 CHAINLOADING=1 USE_CLANG=1 LOGO_DIR="$srcdir/logo" BUILTIN_LOGO=omarchy
  install -Dm644 build/aura.bin "$srcdir/stage1/aura-raw.bin"
  install -Dm644 build/aura.macho "$srcdir/stage1/aura.macho"
  make clean
  make -j"${OMARCHY_BUILD_JOBS:-10}" RELEASE=1 CHAINLOADING=1 ESP_STAGE2=1 USE_CLANG=1 LOGO_DIR="$srcdir/logo" BUILTIN_LOGO=omarchy
}
package() {
  # Required on the installed system, not to build the bootloader.
  depends=('asahi-scripts>=20260127.1' 'uboot-aurora')
  # Building a PR candidate does not assert release/hardware qualification.
  python "$srcdir/validate-qualification.py" --build-only "$srcdir/build-qualification.json" "$_commit"
  install -Dm644 aura/build/aura.bin "$pkgdir/usr/lib/asahi-boot/m1n1.bin"
  install -d "$pkgdir/usr/lib/m1n1-neo"
  ln -s ../asahi-boot/m1n1.bin "$pkgdir/usr/lib/m1n1-neo/m1n1.bin"
  install -Dm644 stage1/aura-raw.bin "$pkgdir/usr/share/aura/stage1/aura-raw.bin"
  install -Dm644 stage1/aura.macho "$pkgdir/usr/share/aura/stage1/aura.macho"
  install -Dm644 aura/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -m644 aura/3rdparty_licenses/* "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 "$srcdir/build-qualification.json" "$pkgdir/usr/share/doc/aura/build-qualification.json"
}
