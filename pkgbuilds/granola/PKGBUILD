# Maintainer: Shawn Yeager <shawn@shawnyeager.com>
#
# Repackages the official Granola macOS .dmg as a native Linux app.
# Conversion follows https://github.com/tirtha4/Granola-for-Linux.
# x86_64 only: the native module is built for linux-x64.
#
# Source is the versioned CloudFront URL that api.granola.ai/v1/download-latest
# redirects to. There is no GitHub release. Version discovery uses
# api.granola.ai/v1/get-versions (production).
#
# Granola 7.821.0 bundles Electron 45. Arch extra has no electron45, so this
# recipe vendors the official Electron linux-x64 zip at the version in the
# .dmg. _elver must match that CFBundleVersion. A newer Granola that ships a
# different Electron fails prepare until _elver and its checksums are updated.
#
# Format: shfmt -ln bash -i 2 -d PKGBUILD

pkgname=granola
pkgver=7.821.0
pkgrel=2
pkgdesc="AI notepad for meetings, repackaged from the official macOS build"
arch=('x86_64')
url="https://www.granola.ai"
license=('LicenseRef-proprietary')
# Electron version bundled in the .dmg, and the linux-x64 zip we ship.
_elver=45.2.3
# Must match the fork version inside the .dmg.
_bs3ver=12.9.0
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'desktop-file-utils'
  'expat'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libpulse'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'xdg-utils'
)
conflicts=('granola-wine')
makedepends=(
  '7zip'
  'gcc'
  'make'
  'nodejs'
  'node-gyp'
  'python'
)
# Electron ships prebuilt binaries that stripping corrupts.
options=('!strip' '!debug')
source=(
  "granola-$pkgver.dmg::https://dr2v7l5emb758.cloudfront.net/$pkgver/Granola-$pkgver-mac-universal.dmg"
  "https://registry.npmjs.org/better-sqlite3-multiple-ciphers/-/better-sqlite3-multiple-ciphers-$_bs3ver.tgz"
  "https://electronjs.org/headers/v$_elver/node-v$_elver-headers.tar.gz"
  "https://github.com/electron/electron/releases/download/v$_elver/electron-v$_elver-linux-x64.zip"
  "granola.desktop"
  "nub-drag.js"
  "update-hook.patch"
  "v8-15.patch"
)
noextract=(
  "granola-$pkgver.dmg"
  "node-v$_elver-headers.tar.gz"
  "electron-v$_elver-linux-x64.zip"
)
sha256sums=('a01fba01d5f3bc15d3e40c50aaa8dbbaf76ac8b640220b6f926625aac5c7fb4d'
            'ad8ceb2cfe687e0c106547fdd281f0d20b40688200d04f40bb163afd1f102609'
            '5300f8e7965734f7cc1aec0c89ce8c0b68644129b858fb0a530ebbd9cd4a4284'
            'a87fe741f6d121285117e574da6c9a2e65210d410123bbc04713b099add0263b'
            '20c443a00fcba28a00292aab36eda376af28e2b6d2f63e083221edc1af7e3f18'
            '31436c2e54cd5a08e7da346f629137571218006a4c674224853aac2bc51d6c1a'
            'e31b449d5a1b1f3e92372c7e3816095f79bdc1cf1d58efb8d04137091dcd943c'
            '4aae7c6a2c6668d08d172e86de01cd2c1e887b168d1f95bec6b4aea9382eef0a')

_res="Granola/Granola.app/Contents/Resources"
_bs3rel="app.asar.unpacked/node_modules/better-sqlite3-multiple-ciphers"

_7z() {
  if command -v 7zz >/dev/null; then
    7zz "$@"
  else
    7z "$@"
  fi
}

prepare() {
  local dmg="$srcdir/granola-$pkgver.dmg"

  rm -rf electron-dist
  mkdir -p electron-dist
  bsdtar -C electron-dist -xf "$srcdir/electron-v$_elver-linux-x64.zip"

  _7z e "$dmg" \
    "Granola/Granola.app/Contents/Frameworks/Electron Framework.framework/Versions/A/Resources/Info.plist" \
    -ofw -y >/dev/null || { echo "cannot read the .dmg" >&2; return 1; }
  local dmgel zipver
  dmgel="$(grep -A1 CFBundleVersion fw/Info.plist | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
  zipver="$(<electron-dist/version)"
  if [[ "$dmgel" != "$_elver" || "$zipver" != "$_elver" ]]; then
    echo "Granola $pkgver bundles Electron $dmgel; electron zip is $zipver; set _elver and run updpkgsums" >&2
    return 1
  fi

  _7z x "$dmg" "$_res/app.asar" "$_res/app.asar.unpacked" "$_res/icons" \
    -opayload -y >/dev/null

  local bs3="payload/$_res/$_bs3rel"
  local realver
  realver="$(node -p "require('$srcdir/$bs3/package.json').version")"
  if [[ "$realver" != "$_bs3ver" ]]; then
    echo "bundled better-sqlite3-multiple-ciphers is $realver, set _bs3ver=$realver and run updpkgsums" >&2
    return 1
  fi
  # The .dmg ships the JS wrapper, including updateHook, but not the C++
  # source. Build that from the matching npm tarball, then add the native
  # updateHook Granola calls when a note changes.
  cp -a package/src package/deps package/binding.gyp "$bs3/"
  # database.hpp is CRLF in the npm tarball. patch compares line endings.
  sed -i 's/\r$//' "$bs3/src/objects/database.hpp"
  patch -d "$bs3" -p1 <"$srcdir/update-hook.patch"
  # better-sqlite3 12.9.0 still speaks the V8 13-14 names. Electron 45 is V8 15.
  patch -d "$bs3" -p1 <"$srcdir/v8-15.patch"

  # api.granola.ai answers 500 to any request carrying platform=linux,
  # including the sign-in URL. The app maps darwin->macOS and win32->Windows
  # and passes anything else through verbatim; rewrite that fallback so Linux
  # reports Windows. The replacement is padded to the same byte length
  # because the asar header records file offsets.
  python - "payload/$_res/app.asar" <<'PYEOF'
import sys, pathlib
p = pathlib.Path(sys.argv[1]); data = p.read_bytes(); total = 0
for pat in (b'?`Windows`:window.electron.platform', b'?`Windows`:process.platform'):
    rep = b'?`Windows`:`Windows`'.ljust(len(pat))
    total += data.count(pat)
    data = data.replace(pat, rep)
if total == 0:
    sys.exit("no platform fallback found; Granola's bundler output changed")
p.write_bytes(data)
print(f"patched {total} platform fallback(s)")
PYEOF
}

build() {
  cd "payload/$_res/$_bs3rel" || exit 1
  node-gyp rebuild --release --runtime=electron --target="$_elver" --arch=x64 \
    --dist-url=https://electronjs.org/headers \
    --tarball="$srcdir/node-v$_elver-headers.tar.gz" \
    --devdir="$srcdir/gyp-devdir"
}

check() {
  local bs3="$srcdir/payload/$_res/$_bs3rel"
  local db="$srcdir/smoke.db"
  rm -f "$db"
  ELECTRON_RUN_AS_NODE=1 NODE_PATH="$srcdir/payload/$_res/app.asar/node_modules" \
    "$srcdir/electron-dist/electron" -e "
      const Database = require('$bs3/lib/index.js');
      const db = new Database('$db');
      db.pragma(\"cipher='sqlcipher'\");
      db.pragma(\"key='smoketest'\");
      db.exec('CREATE TABLE t(a)');
      let fired = false;
      db.updateHook(() => { fired = true; });
      db.prepare('INSERT INTO t VALUES (1)').run();
      if (db.prepare('SELECT count(*) c FROM t').get().c !== 1) throw new Error('insert failed');
      if (!fired) throw new Error('updateHook did not fire');
      db.close();

      // Same connection cannot show that the file needs the key. Reopen it.
      const again = new Database('$db');
      again.pragma(\"cipher='sqlcipher'\");
      again.pragma(\"key='smoketest'\");
      if (again.prepare('SELECT count(*) c FROM t').get().c !== 1) throw new Error('reopen with key failed');
      again.close();

      function readFails(key) {
        let opened;
        try {
          opened = new Database('$db');
          opened.pragma(\"cipher='sqlcipher'\");
          if (key !== null) opened.pragma(\"key='\" + key + \"'\");
          opened.prepare('SELECT count(*) c FROM t').get();
          return false;
        } catch (err) {
          return true;
        } finally {
          if (opened) {
            try { opened.close(); } catch (err) {}
          }
        }
      }
      if (!readFails('wrong-key')) throw new Error('wrong key read the notes');
      if (!readFails(null)) throw new Error('unkeyed read of the notes succeeded');
    "
  rm -f "$db"
}

package() {
  mkdir -p "$pkgdir/usr/lib/granola"
  cp -a --no-preserve=ownership electron-dist/. "$pkgdir/usr/lib/granola/"
  rm -f "$pkgdir/usr/lib/granola/resources/default_app.asar"
  # Namespaces, not a setuid helper. A setuid bit baked in CI says nothing
  # about the machine that installs the package.
  chmod 755 "$pkgdir/usr/lib/granola/electron" "$pkgdir/usr/lib/granola/chrome-sandbox"

  install -Dm644 "payload/$_res/app.asar" "$pkgdir/usr/lib/granola/resources/app.asar"
  cp -a --no-preserve=ownership "payload/$_res/app.asar.unpacked" "$pkgdir/usr/lib/granola/resources/app.asar.unpacked"

  # Keep only the built binaries from the module tree; drop the C++ source,
  # sqlite amalgamation, and node-gyp intermediates.
  local bs3="$pkgdir/usr/lib/granola/resources/$_bs3rel"
  install -Dm755 "$bs3"/build/Release/*.node -t "$srcdir/keep"
  rm -rf "$bs3/build" "$bs3/deps" "$bs3/src" "$bs3/binding.gyp"
  install -Dm755 "$srcdir/keep"/*.node -t "$bs3/build/Release"

  # icon.png and iconTemplate.png are the menu-bar template, a different glyph
  # from the app icon. The tray loads iconTemplate.png. mac-icon.png is the
  # lime squircle Granola ships as the app icon.
  mkdir -p "$pkgdir/usr/lib/granola/resources/icons"
  cp -a --no-preserve=ownership "payload/$_res/icons/." "$pkgdir/usr/lib/granola/resources/icons/"
  install -Dm644 "payload/$_res/icons/mac-icon.png" "$pkgdir/usr/lib/granola/resources/icons/iconTemplate.png"
  install -Dm644 "payload/$_res/icons/mac-icon.png" "$pkgdir/usr/lib/granola/granola-icon.png"
  install -Dm644 "payload/$_res/icons/mac-icon.png" "$pkgdir/usr/share/pixmaps/granola.png"

  install -Dm644 granola.desktop "$pkgdir/usr/share/applications/granola.desktop"
  # Wayland nub drag, the tray glyph, and hiding the main window after launch.
  install -Dm644 nub-drag.js "$pkgdir/usr/lib/granola/nub-drag.js"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/granola" <<EOF
#!/bin/sh
exec /usr/lib/granola/electron --require /usr/lib/granola/nub-drag.js --ozone-platform-hint=auto --enable-features=WebRTCPipeWireCapturer --disable-setuid-sandbox "\$@"
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/share/licenses/$pkgname/LICENSE" <<EOF
Granola is proprietary software. Copyright (c) Granola.
This package repackages the official binary distribution; no license text
is shipped inside it. Terms: https://www.granola.ai/terms
EOF
}
