# Maintainer: The Omarchy Authors
pkgname=github-copilot-cli
pkgver=1.0.114
pkgrel=2
pkgdesc="GitHub Copilot CLI, the Copilot coding agent in your terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/github/copilot-cli"
license=('LicenseRef-GitHub-Copilot')
depends=('gcc-libs' 'glibc')
provides=('copilot')
conflicts=('github-copilot' 'github-copilot-cli-legacy')
replaces=('github-copilot')
# @github/copilot on npm is only a loader; the program is the native executable
# in its platform packages. It carries its JavaScript inside; stripping breaks it.
options=('!strip' '!debug')
source=("CHANGELOG-${pkgver}.md::https://raw.githubusercontent.com/github/copilot-cli/v${pkgver}/changelog.md")
source_x86_64=("copilot-linux-x64-${pkgver}.tgz::https://registry.npmjs.org/@github/copilot-linux-x64/-/copilot-linux-x64-${pkgver}.tgz")
source_aarch64=("copilot-linux-arm64-${pkgver}.tgz::https://registry.npmjs.org/@github/copilot-linux-arm64/-/copilot-linux-arm64-${pkgver}.tgz")
sha256sums=('f08211a84066a59bca69e7da717f188d30b467214868f1cb38fc635202055b48')
sha256sums_x86_64=('be114c2321035197bb1d239d459e4ab326b1178c3cf68bd9637a1ffae25c8b6a')
sha256sums_aarch64=('8c3550c422f56a043442b38177afc9981ada9f2c36c6eb0769ca240dbf4c1fbf')

build() {
  # Keep the binary off the network and out of the builder's home while it
  # writes its completions.
  export HOME="${srcdir}/home" COPILOT_AUTO_UPDATE=false
  local shell
  for shell in bash zsh fish; do
    "${srcdir}/package/copilot" completion "$shell" >"completion.${shell}"
  done
}

package() {
  install -Dm755 package/copilot "${pkgdir}/usr/lib/${pkgname}/copilot"

  # pacman updates this install. With auto-update on, Copilot downloads newer
  # releases into ~/.cache/copilot/pkg and runs those instead of this one.
  install -dm755 "${pkgdir}/usr/bin"
  cat >"${pkgdir}/usr/bin/copilot" <<'WRAPPER'
#!/bin/bash
export COPILOT_AUTO_UPDATE=false
exec /usr/lib/github-copilot-cli/copilot "$@"
WRAPPER
  chmod 755 "${pkgdir}/usr/bin/copilot"

  install -Dm644 completion.bash "${pkgdir}/usr/share/bash-completion/completions/copilot"
  install -Dm644 completion.zsh "${pkgdir}/usr/share/zsh/site-functions/_copilot"
  install -Dm644 completion.fish "${pkgdir}/usr/share/fish/vendor_completions.d/copilot.fish"

  install -Dm644 "CHANGELOG-${pkgver}.md" "${pkgdir}/usr/share/doc/${pkgname}/CHANGELOG.md"
  install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" \
    package/LICENSE.md package/QuickJS.LICENSE.txt package/rquickjs.LICENSE.txt
}
