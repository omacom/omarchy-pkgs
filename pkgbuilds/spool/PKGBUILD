# Maintainer: Scott Adair
pkgname=spool
pkgver=0.1.0
pkgrel=1
pkgdesc='Printer settings for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/scottadair/omarchy-spool'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'libcups' 'cups' 'cups-pk-helper' 'cups-filters')
makedepends=('gcc' 'make')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        'spool.desktop'
        'spool.svg')
sha256sums=('b7763fe73494459c3ed455c5af4f0d47934396fa1c5569ee7b0d7c472de11eb3'
            'fbaf189f95d5e040951bf597a2cc7f74372161f0d66d92cd0685e18a4cebf5d6'
            '93ea777f896e62ae670e9e4a431f47e37274103f9a4dcc19651c030c56cca60d')

build() {
  cd "omarchy-spool-$pkgver"
  mkdir -p build
  cd build
  qmake6 ../spool.pro
  make -j"$(nproc)"
}

package() {
  cd "omarchy-spool-$pkgver"
  install -Dm755 build/spool "$pkgdir/usr/bin/spool"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/spool.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/spool.svg"
  install -Dm644 "$srcdir/spool.desktop" "$pkgdir/usr/share/applications/spool.desktop"
}
