pkgname=bankstown
pkgver=1.1.0
pkgrel=3
pkgdesc='A barebones bass enhancer LV2 plugin'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/chadmed/bankstown'
license=('MIT')
depends=('glibc' 'gcc-libs' 'lv2')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('e877508b73fe90774d74526d838f75e8ea278bdbcee0a1f92e3eca67ed734675')

prepare() {
  cd $pkgname-$pkgver
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $pkgname-$pkgver
  cargo build --frozen --release
}

package() {
  cd $pkgname-$pkgver
  make LIBDIR=/usr/lib DESTDIR="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
