# Maintainer: David Heinemeier Hansson <david@hey.com>
pkgname=cards
pkgver=0.1.0
pkgrel=4
pkgdesc='Klondike solitaire in four card series, one drawn in the Omarchy theme'
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/cards'
license=('MIT')
options=('!debug')
depends=('hicolor-icon-theme' 'qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland')
makedepends=('cmake' 'gcc' 'make')
checkdepends=('ttf-dejavu')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a8cb68c99c2701a59a37622d4d27e07ba7880fb24aa0036795b9f3da31ef84b0')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ctest --test-dir build --output-on-failure
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build --prefix /usr
}
