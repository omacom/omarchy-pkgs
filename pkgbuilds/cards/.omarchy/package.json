{
  "source": "local",
  "auto_merge": true,
  "rebuild_on": [
    "qt6-base",
    "qt6-declarative"
  ],
  "upstream": {
    "watch": {
      "github": "omacom/cards",
      "pattern": "v(?P<version>[0-9]+(?:\\.[0-9]+)*)"
    }
  },
  "rebuilt_against": {
    "x86_64": {
      "qt6-base": "6.12.1-1",
      "qt6-declarative": "6.12.1-1"
    },
    "aarch64": {
      "qt6-base": "6.12.1-1",
      "qt6-declarative": "6.12.1-1"
    }
  }
}
