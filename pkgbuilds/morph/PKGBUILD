# Maintainer: Gaurav Salandri <salangau000@gmail.com>

pkgname=morph
pkgver=0.1.0
pkgrel=1
pkgdesc='Convert videos, audio, images, documents, and archives locally'
arch=('x86_64' 'aarch64')
url='https://github.com/Gaurav-021/morph'
license=('MIT')
install='morph.install'
options=('!debug')
depends=(
  '7zip'
  'ffmpeg'
  'ghostscript'
  'hicolor-icon-theme'
  'imagemagick'
  'libreoffice-fresh'
  'poppler'
  'qpdf'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
  'xdg-desktop-portal'
)
makedepends=(
  'gcc'
  'make'
  'qt6-base'
  'qt6-declarative'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/Gaurav-021/morph/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('cfea51bcb0bc581b1859e5ce274ce17a0cdf55e279e82e13fbd4cc920d633b2c')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/morph "$pkgdir/usr/bin/morph"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/morph.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/morph.svg"
  install -Dm644 pkgbuild/morph.desktop "$pkgdir/usr/share/applications/morph.desktop"
}
