# Maintainer: Dan Wahlin <dwahlin@gmail.com>

# Agent Arcade is a Tauri app. Upstream ships a .deb built on Ubuntu 22.04 via
# tauri-action, so this repackages its usr/ tree. .omarchy/package.json points
# the upstream sync at the GitHub release feed; it rewrites pkgver and the
# x86_64 checksum below from the digest GitHub reports for the asset.

pkgname=agent-arcade-bin
_pkgname=agent-arcade
pkgver=0.6.1
pkgrel=1
pkgdesc="Retro arcade games in a transparent desktop overlay to play while your AI coding agent works"
arch=('x86_64')
url="https://github.com/DanWahlin/agent-arcade"
license=('MIT')
# webkit2gtk-4.1 and gtk3 are linked directly. The tray icon goes through
# libayatana-appindicator, which Tauri dlopens by name. Game audio plays via
# WebKitGTK's GStreamer backend, so the plugin sets are needed at runtime even
# though only the core GStreamer libraries show up in ldd.
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'gst-plugins-base'
  'gst-plugins-good'
  'gst-plugins-bad'
  'gst-libav'
  'hicolor-icon-theme'
)
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")
# Prebuilt release binary; leave it byte-exact.
options=('!strip' '!debug')
source=('LICENSE')
source_x86_64=("${pkgname}-${pkgver}.deb::${url}/releases/download/v${pkgver}/Agent.Arcade_${pkgver}_amd64.deb")
sha256sums=('2ea28538d4f8e3af863fd3f0a0db93fd98cca9cc6372dccc95fea52233729527')
sha256sums_x86_64=('3ac2619bbd7c057c03f55c8a0853bdbeb9701c67015e54fbfdc0dc477ff6bfab')

prepare() {
  bsdtar -xf "${pkgname}-${pkgver}.deb" data.tar.gz
}

package() {
  bsdtar -xf data.tar.gz -C "$pkgdir"

  # Upstream names the desktop file "Agent Arcade.desktop"; keep it unspaced.
  mv "$pkgdir/usr/share/applications/Agent Arcade.desktop" \
     "$pkgdir/usr/share/applications/${_pkgname}.desktop"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
