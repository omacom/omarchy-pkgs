# Maintainer: Omarchy <https://omarchy.org>
# Firmware collected/renamed by Aditya Garg and the t2linux/Asahi contributors.
# These are Apple/Broadcom firmware blobs, not firmware compiled from source.
pkgname=apple-bcm-firmware
pkgver=14.4.1
pkgrel=1.1
_commit=dc061b535d53e293cdd5793c1255faaca197574b
pkgdesc='Apple/Broadcom Wi-Fi and Bluetooth firmware data for Intel T2 Macs'
url='https://github.com/omacom/apple-bcm-firmware'
arch=('any')
# No separate redistribution grant was found. See the packaged provenance note.
license=('LicenseRef-unknown')
options=('!debug' '!strip')
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
        'intel-firmware.sha256'
        'PROVENANCE.md')
sha256sums=('c66b9c37a73fdd2fa7a11ea7b177edfca9b85fd33f87557c9fb5e3640398671d'
            '3b32c3b0909de116e4d94b89b38eb65bfef189e597935e8bde5f1bdadbd50eab'
            '9d70ec967f4bc2e647c3fda533d7f7a36b76b0736736b4fec9f5b99c0a64e364')

check() {
  cd "$pkgname-$_commit/lib/firmware/brcm"
  sha256sum --strict --check "$srcdir/intel-firmware.sha256"
}

package() {
  cd "$pkgname-$_commit/lib/firmware/brcm"
  local digest name
  # Explicit manifest preserves board calibration names and excludes ARM files.
  while read -r digest name; do
    [[ "$name" != */* && -f "$name" && ! -L "$name" && -s "$name" ]] || return 1
    install -Dm644 "$name" "$pkgdir/usr/lib/firmware/brcm/$name"
  done < "$srcdir/intel-firmware.sha256"
  install -Dm644 "$srcdir/intel-firmware.sha256" "$pkgdir/usr/share/doc/$pkgname/intel-firmware.sha256"
  install -Dm644 "$srcdir/PROVENANCE.md" "$pkgdir/usr/share/doc/$pkgname/PROVENANCE.md"
  install -Dm644 "$srcdir/$pkgname-$_commit/README.md" "$pkgdir/usr/share/doc/$pkgname/UPSTREAM-README.md"
}
