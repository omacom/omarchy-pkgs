# Maintainer: Ferdous Bhai <https://github.com/ferdousbhai>
pkgname=recall-for-omarchy
pkgver=0.6.0
pkgrel=1
pkgdesc='Local semantic file search for Omarchy, with a CLI and bundled agent skill'
arch=('x86_64' 'aarch64')
url='https://github.com/ferdousbhai/recall-for-omarchy'
license=('MIT')
# What the service and its workers run: extraction tools, system OCR, the Vulkan loader (CPU fallback without a
# driver), file opening and the D-Bus/systemd helpers.
depends=('bash' 'coreutils' 'curl' 'ffmpeg' 'gcc-libs' 'glib2' 'glibc' 'libvips' 'poppler' 'systemd'
  'tesseract' 'tesseract-data-eng' 'vulkan-icd-loader' 'xdg-terminal-exec' 'xdg-utils')
optdepends=('omarchy: the search panel, keybinding and `recall setup`'
  'git: skip ignored files in code folders'
  'catdoc: legacy Word documents'
  'antiword: legacy Word documents (when catdoc is missing)'
  'neovim: open code results at the matching line'
  'mpv: open media at the matching interval')
# Other ARM machines bring their own Vulkan driver, or use the CPU.
optdepends_aarch64=('vulkan-asahi: GPU acceleration on Apple Silicon')
makedepends=('rust' 'cargo' 'git' 'clang' 'cmake' 'ninja' 'vulkan-headers' 'vulkan-icd-loader' 'shaderc' 'spirv-headers')
options=('!debug' '!lto')
install=recall-for-omarchy.install
# llama.cpp at the tag scripts/build-llama.sh pins; the script builds this checkout instead of cloning.
_llama=b11461
source=("$pkgname::git+$url.git#tag=v$pkgver"
  "llama.cpp::git+https://github.com/ggml-org/llama.cpp.git#tag=$_llama")
sha256sums=('SKIP' 'SKIP')

prepare() {
  cd "$srcdir/recall-for-omarchy"
  grep -q "^TAG=$_llama[[:space:]]" scripts/build-llama.sh \
    || { echo "scripts/build-llama.sh pins another llama.cpp tag than $_llama" >&2; return 1; }
  mkdir -p "$srcdir/vendor"
  rm -rf "$srcdir/vendor/llama.cpp"
  git clone --quiet --no-local "$srcdir/llama.cpp" "$srcdir/vendor/llama.cpp"
  git -C "$srcdir/vendor/llama.cpp" checkout --quiet "tags/$_llama"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

_env() {
  # The compiler the released vectors were checked with; Vulkan is required, not detected.
  export CC=clang CXX=clang++ RECALL_BUILD_VULKAN=1 RECALL_RELOCATABLE=1
  export RECALL_VENDOR="$srcdir/vendor"
  export RECALL_LLAMA_DIR="$RECALL_VENDOR/llama"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/recall-for-omarchy/target}"
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir/recall-for-omarchy=/build --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo"
}

build() {
  cd "$srcdir/recall-for-omarchy"
  _env
  scripts/build-llama.sh
  cargo build --frozen --release
}

check() {
  cd "$srcdir/recall-for-omarchy"
  _env
  # The build has only relative library paths (next to the binary, as installed); point the tests at the build.
  LD_LIBRARY_PATH="$RECALL_LLAMA_DIR/lib" cargo test --frozen --release
}

package() {
  cd "$srcdir/recall-for-omarchy"
  _env
  # The layout `recall setup` expects: executables and llama.cpp next to each other, the panel two levels up.
  local lib="$pkgdir/usr/lib/$pkgname"
  install -Dm755 -t "$lib/target/release" "$CARGO_TARGET_DIR/release/recall" "$CARGO_TARGET_DIR/release/recall-engine"
  cp -P "$RECALL_LLAMA_DIR"/lib/*.so* "$lib/target/release/"
  install -dm755 "$lib/omarchy"
  cp -r omarchy/plugin omarchy/assets omarchy/skills "$lib/omarchy/"
  install -dm755 "$pkgdir/usr/bin"
  ln -s "/usr/lib/$pkgname/target/release/recall" "$pkgdir/usr/bin/recall"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 omarchy/README.md "$pkgdir/usr/share/doc/$pkgname/USAGE.md"
}
