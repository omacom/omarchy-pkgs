# Maintainer: Ferdous Bhai <https://github.com/ferdousbhai>
pkgname=recall-for-omarchy
pkgver=0.4.2
pkgrel=1
pkgdesc='Local semantic file search for Omarchy, with a CLI and bundled agent skill'
arch=('x86_64' 'aarch64')
url='https://github.com/ferdousbhai/recall-for-omarchy'
license=('MIT')
depends=('tesseract' 'tesseract-data-eng' 'coreutils' 'bash' 'curl' 'git' 'unzip' 'glib2' 'ffmpeg' 'poppler' 'libvips' 'gcc-libs' 'glibc' 'vulkan-icd-loader' 'xdg-utils' 'xdg-terminal-exec' 'systemd')
optdepends_aarch64=('vulkan-asahi: Apple Silicon GPU acceleration on Linux')
optdepends_x86_64=('vulkan-radeon: AMD GPU acceleration' 'vulkan-intel: Intel GPU acceleration' 'nvidia-utils: NVIDIA Vulkan userspace driver')
optdepends=('catdoc: legacy Word/Excel extraction' 'antiword: alternative legacy Word extraction' 'omarchy: native search panel and desktop setup' 'neovim: open source results at the matching line' 'mpv: open media at its matching interval')
options=('!debug' '!strip')
install=recall-for-omarchy.install
_release="https://github.com/ferdousbhai/recall-for-omarchy/releases/download/v${pkgver}"
source_x86_64=("${pkgname}-${pkgver}-x86_64.tar.gz::${_release}/recall-for-omarchy-x86_64.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64.tar.gz::${_release}/recall-for-omarchy-aarch64.tar.gz")
sha256sums_x86_64=('9ee66b51694ebfca4adcb1f84eabbef7ecab961d264e12eca6320450fcdb674e')
sha256sums_aarch64=('07736dda0ca70657ab75a863c0f034bbcd3a448430c336bdf4e5e83a91ddfd3b')

check() {
  cd "$srcdir/recall-for-omarchy"
  test -f target/release/libggml-vulkan.so
  test -L target/release/libllama.so
  target/release/recall-engine --help >/dev/null
  target/release/recall --help >/dev/null
  target/release/recall doctor >/dev/null
  target/release/recall skill | cmp - omarchy/skills/recall/SKILL.md
}

package() {
  cd "$srcdir/recall-for-omarchy"
  install -dm755 "$pkgdir/usr/lib/$pkgname" "$pkgdir/usr/bin"
  cp -a omarchy target "$pkgdir/usr/lib/$pkgname/"
  ln -s "/usr/lib/$pkgname/target/release/recall" "$pkgdir/usr/bin/recall"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 omarchy/skills/recall/SKILL.md "$pkgdir/usr/share/$pkgname/skills/recall/SKILL.md"
}
