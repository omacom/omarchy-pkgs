post_install() {
  printf '%s\n' \
    'Recall is installed. Set up the search panel, service, keybinding and agent skill as your desktop user:' \
    '  recall setup' \
    '(install.sh does this for you.) Models download once you pick folders; files and indexes stay local.'
}

# The binaries changed under the running service. Restart it for each logged-in user who runs it; the restarted
# service brings that user's panel and skill up to date. Nothing is written to home folders from here.
post_upgrade() {
  local user
  command -v loginctl >/dev/null || return 0
  for user in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
    systemctl --user --machine="$user@" try-restart recall-for-omarchy.service >/dev/null 2>&1 || true
  done
}

post_remove() {
  printf '%s\n' \
    'Per-user files remain. As your desktop user: systemctl --user disable --now recall-for-omarchy.service' \
    'and see "Remove integration" in https://github.com/ferdousbhai/recall-for-omarchy/blob/main/omarchy/README.md' \
    'Settings, indexes and models stay until you delete ~/.config/recall and ~/.local/share/recall.'
}
