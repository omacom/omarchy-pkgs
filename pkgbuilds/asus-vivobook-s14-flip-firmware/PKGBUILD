549bb9c8e32dc6253d0d0ddde2ce5c26f75f8333d3e55861f297e169a9f3e5c0  qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/adspr.jsn
12ac2f3ae8ced12aa4b06b3ab3a01bc4d8efe1c92ebea503c002f209a6ec176f  qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/adsps.jsn
982a99853495e34726b8e44697fdfad303334de0a67cbf6cde306c8f1731000b  qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/adspua.jsn
c1e3cdeee17e61ee5f9426fef78e5e35eaf9fdd49d3d39b9bd82dcad04c71647  qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/cdsp_dtbs.elf
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/cdspr.jsn
83bf4d7a5ca5d4607d90af6625b90d6b05e190a44c37f0932e1c2af72945ede5  qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/qcadsp8380.mbn
4d2aa10aa60245177ca253d4a8f7ee15c0a0390e877efec29fa25c7d4b725568  qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/qccdsp8380.mbn
848341997c48213d818168ed0ec48ee722c30738e5ffede40550d38252e3ac71  qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/qcdxkmsucpurwa.mbn
fa5e78c9743c5ca3439baadfe7f1e118591f8a1ad976e9f87b75937945d42e8b  qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/qcvss8380.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
