# Audio DSP, compute DSP, GPU and video firmware for the ASUS Vivobook S14 Flip TP5408QA. The
# firmware only runs if it is signed for this board by ASUS, so linux-firmware cannot carry it
# until the OEM submits it. The OEM ships it in its Windows driver download, which this recipe
# unpacks without running. Each file is checked against the SHA-256 it was matched to and
# installed under the name the device tree requests, compressed with xz. The kernel tries a plain
# name, then .zst, then .xz, so once linux-firmware ships the same file, its copy is the one
# loaded, and the two packages never install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=asus-vivobook-s14-flip-firmware
pkgver=20261114
pkgrel=1
pkgdesc='Audio DSP, compute DSP, GPU and video firmware for the ASUS Vivobook S14 Flip TP5408QA'
arch=('aarch64')
url='https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/51031/SOCPackage_forWebSite_Qualcomm_Z_V1.305.9300.0_51031.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x126100-asustek-vivobook-s14-flip-tp5408qa')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'asus-socpackage-51031.exe::https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/51031/SOCPackage_forWebSite_Qualcomm_Z_V1.305.9300.0_51031.exe'
)
source+=('README.package.md')
noextract=('asus-socpackage-51031.exe')
sha256sums=('a2b5dbd232923eed04949904da3281b43f1cea1a0b17c9887e041bcafe300035')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'asus-socpackage-51031.exe' 'asus-socpackage-51031' 7z-appended
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'asus-socpackage-51031/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/adsp_dtbs.elf'
  install -Dm644 'asus-socpackage-51031/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adspr.jsn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/adspr.jsn'
  install -Dm644 'asus-socpackage-51031/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adsps.jsn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/adsps.jsn'
  install -Dm644 'asus-socpackage-51031/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adspua.jsn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/adspua.jsn'
  install -Dm644 'asus-socpackage-51031/QualcommBSP/NPU/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/cdsp_dtbs.elf'
  install -Dm644 'asus-socpackage-51031/QualcommBSP/NPU/qcnspmcdm_ext_cdsp8380/cdspr.jsn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/cdspr.jsn'
  install -Dm644 'asus-socpackage-51031/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/qcadsp8380.mbn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/qcadsp8380.mbn'
  install -Dm644 'asus-socpackage-51031/QualcommBSP/NPU/qcnspmcdm_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/qccdsp8380.mbn'
  install -Dm644 'asus-socpackage-51031/QualcommBSP/GFX/qcdx8380/qcdxkmsucpurwa.mbn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/qcdxkmsucpurwa.mbn'
  install -Dm644 'asus-socpackage-51031/QualcommBSP/GFX/qcdx8380/qcvss8380.mbn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-s14-flip-tp5408qa/qcvss8380.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
