pkgname=gb10-cx7-hotplug-dkms
pkgver=0.1.0
pkgrel=1
pkgdesc='Experimental, opt-in GB10 ConnectX-7 hotplug driver sources (unqualified)'
arch=(aarch64)
url='https://github.com/NVIDIA/NV-Kernels'
license=(GPL-2.0-only)
depends=(dkms)
makedepends=(patch)
optdepends=('linux-omarchy-n1x-headers: matching kernel headers for experimental builds')
_commit=dd99802c8b0c384169bb36293c9517fa67238e47
source=(
  "mtk-pcie-hotplug.c::https://raw.githubusercontent.com/NVIDIA/NV-Kernels/${_commit}/drivers/platform/arm64/nvidia/mtk-pcie-hotplug.c"
  0001-gate-and-harden-experimental-hotplug.patch
  Makefile
  dkms.conf
  gb10-cx7-hotplug.conf
  README.md
)
sha256sums=(
  '0e1e12b9cc0f50236050edbf114ba2d9d80607c2a9efe1219b19fc21ddc582fe'
  'd72d08770ad4570bad04b2b9c267451220309d6f6b50de33ae6ef0b4874fa515'
  '60e024ce05d46d75e5be65e99f66166c60e278e294b0d0c350d6843b5069216b'
  'c713f9d28adc46fcd83e0449d9f115621675cc5aa9ad0e5adc93c5d6020a05c5'
  '289f9c936883aa2a9b213c5da1b2df4e581d9c5a97b17afe0bba730f4afc58e1'
  '85ce4a87d7353d77d5e4fa9c0fbf345521cf728e0a379244a13e7852ade77937'
)

prepare() {
  cp --dereference mtk-pcie-hotplug.c mtk-pcie-hotplug.c.tmp
  mv mtk-pcie-hotplug.c.tmp mtk-pcie-hotplug.c
  patch -Np1 --fuzz=0 < 0001-gate-and-harden-experimental-hotplug.patch
}

package() {
  local source_dir="$pkgdir/usr/src/gb10-cx7-hotplug-$pkgver"

  install -Dm644 mtk-pcie-hotplug.c "$source_dir/mtk-pcie-hotplug.c"
  install -m644 Makefile "$source_dir/Makefile"
  sed "s/@VERSION@/$pkgver/" dkms.conf > "$source_dir/dkms.conf"
  install -Dm644 gb10-cx7-hotplug.conf "$pkgdir/usr/lib/modprobe.d/gb10-cx7-hotplug.conf"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
