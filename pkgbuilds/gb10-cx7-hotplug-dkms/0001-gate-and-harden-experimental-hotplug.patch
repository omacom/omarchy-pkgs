+static irqreturn_t cx7_hp_irq_thread(int irq, void *data)
+{
+	struct cx7_hp_gpio_ctx *pin = data;
+	struct cx7_hp_dev *hp_dev = pin->hp_dev;
+	irqreturn_t ret = IRQ_HANDLED;
+
+	mutex_lock(&hp_dev->transition_lock);
+	if (hp_dev->hotplug_enabled) {
+		pci_lock_rescan_remove();
+		ret = hotplug_irq_handler(irq, data);
+		if (ret == IRQ_WAKE_THREAD)
+			ret = cx7_hp_work(irq, data);
+		pci_unlock_rescan_remove();
+	}
+	mutex_unlock(&hp_dev->transition_lock);
+	return ret;
+}
