# Maintainer: Ferdous Bhai <23114244+ferdousbhai@users.noreply.github.com>
pkgname=cloud-contacts
pkgver=0.3.0
pkgrel=1
pkgdesc='Unified iCloud and Google contacts with a native GTK app'
arch=('x86_64' 'aarch64')
url='https://github.com/ferdousbhai/cloud-contacts'
license=('MIT')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita')
makedepends=('cargo' 'git')
options=('!debug' '!lto')  # makepkg's C LTO breaks ring's assembly objects
optdepends=('icloud-session: shared Apple sign-in' 'xdg-terminal-exec: sign-in from the app')
replaces=('icloud-contacts')
conflicts=('icloud-contacts')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('cf2ad3faea344fbc9a5fbc2791d68c07ba4af0370726a7bc68675098fbbe8dc7')

_srcdir() { echo "$srcdir/cloud-contacts-$pkgver"; }

prepare() {
  cd "$(_srcdir)"
  cargo fetch --locked --manifest-path icloud/Cargo.toml --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$(_srcdir)"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-icloud/target}"
  cargo build --frozen --release --manifest-path icloud/Cargo.toml
}

check() {
  cd "$(_srcdir)"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-icloud/target}"
  cargo test --frozen --manifest-path icloud/Cargo.toml
  python -m unittest discover -s tests
}

package() {
  cd "$(_srcdir)"
  install -d "$pkgdir/usr/lib/cloud-contacts" "$pkgdir/usr/bin"
  install -Dm755 "${CARGO_TARGET_DIR:-icloud/target}/release/cloud-contacts-icloud" "$pkgdir/usr/lib/cloud-contacts/libexec/cloud-contacts-icloud"
  cp -r cloud_contacts bin skills "$pkgdir/usr/lib/cloud-contacts/"
  find "$pkgdir/usr/lib/cloud-contacts" -name __pycache__ -type d -exec rm -r {} +
  printf '%s\n' '#!/bin/sh' 'exec python /usr/lib/cloud-contacts/bin/cloud-contacts "$@"' > "$pkgdir/usr/bin/cloud-contacts"
  chmod 755 "$pkgdir/usr/bin/cloud-contacts"
  install -Dm644 data/com.ferdousbhai.cloudcontacts.desktop "$pkgdir/usr/share/applications/com.ferdousbhai.cloudcontacts.desktop"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/cloud-contacts/NOTICE"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/cloud-contacts/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/cloud-contacts/README.md"
}
