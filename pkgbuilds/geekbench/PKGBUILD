pkgname=geekbench
pkgver=7.1.0
pkgrel=1
pkgdesc="A cross-platform benchmark that measures processor and memory performance"
arch=('x86_64' 'aarch64')
url="https://www.geekbench.com/"
license=('LicenseRef-Geekbench')
depends=('gcc-libs' 'glibc' 'zlib')
conflicts=('geekbench227')
options=('!strip' '!debug')

_x86_64_dir="Geekbench-${pkgver}-Linux"
_aarch64_dir="Geekbench-${pkgver}-LinuxARMPreview"

source_x86_64=("https://cdn.geekbench.com/${_x86_64_dir}.tar.gz")
source_aarch64=("https://cdn.geekbench.com/${_aarch64_dir}.tar.gz")

sha256sums_x86_64=('411b72a9c851b69e6f91d390649d419e2e625f475e3983880169651ca27a8672')
sha256sums_aarch64=('bb6abc61a68a9b33fecf1f3c0b800050dd76e93666a13eaabfa52cbd26ad3319')

package() {
  local _dir="_${CARCH}_dir"
  local dest="$pkgdir/opt/$pkgname"

  install -d "$dest" "$pkgdir/usr/bin"
  cp -a "$srcdir/${!_dir}/." "$dest/"
  ln -s "/opt/$pkgname/${pkgname}7" "$pkgdir/usr/bin/${pkgname}7"
  ln -s "${pkgname}7" "$pkgdir/usr/bin/$pkgname"
}
