[Unit]
Description=Dell XPS 13 9345 Qualcomm sensor service
Documentation=file:///usr/share/doc/dell-xps-13-9345-sensors/README.package.md
ConditionFirmware=device-tree-compatible(dell,xps13-9345)
BindsTo=dev-fastrpc\x2dadsp.device
After=systemd-modules-load.service dev-fastrpc\x2dadsp.device
Before=iio-sensor-proxy.service
ConditionPathExists=/dev/fastrpc-adsp
ConditionPathExists=/var/lib/dell-xps-13-9345-sensors/root/sensors/sns_reg.conf
ConditionPathExists=/var/lib/dell-xps-13-9345-sensors/root/sensors/config/json.lst

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/usr/lib/dell-xps-13-9345-sensors
# The DSP deletes a registry it judges stale and cannot always rebuild it, so
# every start puts the copy parsed by Windows back.
ExecStartPre=-/usr/bin/cp -r --no-preserve=all /var/lib/dell-xps-13-9345-sensors/root/windows-registry/. /var/lib/dell-xps-13-9345-sensors/root/sensors/persist/
ExecStart=/usr/lib/dell-xps-13-9345-sensors/hexagonrpcd -f /dev/fastrpc-adsp -d adsp -s -R /var/lib/dell-xps-13-9345-sensors/root
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
MemoryDenyWriteExecute=true
ReadOnlyPaths=/var/lib/dell-xps-13-9345-sensors/root
ReadWritePaths=/var/lib/dell-xps-13-9345-sensors/root/sensors/persist

[Install]
# Start when the ADSP appears, so a missing DSP never holds up boot.
WantedBy=dev-fastrpc\x2dadsp.device
