# ath12k reports a placeholder as a Snapdragon Surface's Wi-Fi address; set
# the real one on each WCN7850 interface while udev adds it, before
# NetworkManager takes the interface. The script does nothing on machines
# that are not Microsoft's or lack the firmware address variable.
# After 80-net-setup-link, so $name is the interface's new name (wlan0 becomes
# wlP4p1s0 on the Surface Laptop 8); %k is still the old one.
ACTION=="add", SUBSYSTEM=="net", ENV{DEVTYPE}=="wlan", DRIVERS=="ath12k_pci|ath12k_wifi7_pci", \
  RUN+="/usr/lib/surface-snapdragon-addresses/surface-wifi-address $name"
