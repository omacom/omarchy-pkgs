# A Snapdragon Surface's WCN7850 registers as an unconfigured controller
# until it is given a public address; configure each one as it appears. The
# service runs only on Microsoft machines with the firmware address variable.
SUBSYSTEM=="bluetooth", ENV{DEVTYPE}=="host", SUBSYSTEMS=="serial", DRIVERS=="hci_uart_qca", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}+="surface-bluetooth-address@%k.service"
