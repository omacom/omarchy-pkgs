# Audio DSP, compute DSP and GPU firmware for the Microsoft Surface Laptop 7. The firmware only
# runs if it is signed for this board by Microsoft, so linux-firmware cannot carry it until the
# OEM submits it. The OEM ships it in its Windows driver download, which this recipe unpacks
# without running. The files are installed unmodified, under the names the device tree requests,
# and checked against the SHA-256 each was matched to.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=microsoft-surface-laptop-7-firmware
pkgver=20261102
pkgrel=1
pkgdesc='Audio DSP, compute DSP and GPU firmware for the Microsoft Surface Laptop 7'
arch=('aarch64')
url='https://www.microsoft.com/en-us/download/details.aspx?id=106120'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1e80100-microsoft-romulus' 'qcom-firmware-x1e80100-microsoft')
conflicts=('microsoft-surface-pro-11-firmware')
makedepends=('7zip' 'msitools')
options=('!strip' '!debug')
source=(
  'microsoft-surfacelaptop7.msi::https://download.microsoft.com/download/b7ca2c3f-d320-4795-be0f-529a0117abb4/SurfaceLaptop7_ARM_Win11_26100_26.091.9400.0.msi'
  'microsoft-surfacepro11.msi::https://download.microsoft.com/download/92821b24-203a-4ce5-9a3a-5df3160a2fe3/SurfacePro11_ARM_Win11_26100_26.094.41119.0.msi'
)
noextract=('microsoft-surfacelaptop7.msi' 'microsoft-surfacepro11.msi')
sha256sums=('0917d206fb35278b4df4be980240318475300f3a130a86edac836519059a453d' '8b299016027a4a87f50cf168f69ca1fb8dedc9a0612fcd6cff89b9bc64135ec2')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'microsoft-surfacelaptop7.msi' 'microsoft-surfacelaptop7' msi
  _unpack 'microsoft-surfacepro11.msi' 'microsoft-surfacepro11' msi
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'microsoft-surfacelaptop7/SurfaceUpdate/proextadsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1e80100/microsoft/Romulus/adsp_dtbs.elf'
  install -Dm644 'microsoft-surfacelaptop7/SurfaceUpdate/proextadsp8380/adspr.jsn' "$fw"/'qcom/x1e80100/microsoft/Romulus/adspr.jsn'
  install -Dm644 'microsoft-surfacelaptop7/SurfaceUpdate/proextadsp8380/adsps.jsn' "$fw"/'qcom/x1e80100/microsoft/Romulus/adsps.jsn'
  install -Dm644 'microsoft-surfacelaptop7/SurfaceUpdate/proextadsp8380/adspua.jsn' "$fw"/'qcom/x1e80100/microsoft/Romulus/adspua.jsn'
  install -Dm644 'microsoft-surfacelaptop7/SurfaceUpdate/proextadsp8380/battmgr.jsn' "$fw"/'qcom/x1e80100/microsoft/Romulus/battmgr.jsn'
  install -Dm644 'microsoft-surfacelaptop7/SurfaceUpdate/qcnspmcdmextcdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1e80100/microsoft/Romulus/cdsp_dtbs.elf'
  install -Dm644 'microsoft-surfacelaptop7/SurfaceUpdate/qcnspmcdmextcdsp8380/cdspr.jsn' "$fw"/'qcom/x1e80100/microsoft/Romulus/cdspr.jsn'
  install -Dm644 'microsoft-surfacelaptop7/SurfaceUpdate/proextadsp8380/qcadsp8380.mbn' "$fw"/'qcom/x1e80100/microsoft/Romulus/qcadsp8380.mbn'
  install -Dm644 'microsoft-surfacelaptop7/SurfaceUpdate/qcnspmcdmextcdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1e80100/microsoft/Romulus/qccdsp8380.mbn'
  install -Dm644 'microsoft-surfacepro11/SurfaceUpdate/qcdx/qcdxkmsuc8380.mbn' "$fw"/'qcom/x1e80100/microsoft/qcdxkmsuc8380.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
b03f066e2645dbe35a33a08a91312842f5cee3676cac3e111f1f3dabd1cf4e9e  qcom/x1e80100/microsoft/Romulus/adsp_dtbs.elf
e9ba7199626b0c03f2ec02822d744f678ad567fe0625a28fe5f5908b7281e9db  qcom/x1e80100/microsoft/Romulus/adspr.jsn
19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e  qcom/x1e80100/microsoft/Romulus/adsps.jsn
d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d  qcom/x1e80100/microsoft/Romulus/adspua.jsn
b8aad1d149128f414eb1fd6fcbb6e0a5b7dabcd2cba001599e1ce9a0e2e291a4  qcom/x1e80100/microsoft/Romulus/battmgr.jsn
93941f040da14b8305d39579686d886706d22954a538b03da676c1aaa191797f  qcom/x1e80100/microsoft/Romulus/cdsp_dtbs.elf
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x1e80100/microsoft/Romulus/cdspr.jsn
3a0240f9a1c0c43b657959b1bf10433a1a9793eb5c4af9f6beff8644c174f5a0  qcom/x1e80100/microsoft/Romulus/qcadsp8380.mbn
