# Maintainer: Ferdous Bhai <23114244+ferdousbhai@users.noreply.github.com>
pkgname=omacloud
pkgver=0.0.36
pkgrel=1
pkgdesc="Your files and settings on every Omarchy computer, end to end encrypted, in storage of your own (CLI, daemon, GTK app)"
arch=('x86_64' 'aarch64')
url="https://github.com/ferdousbhai/omacloud"
license=('MIT' 'ISC')  # ISC: the Lucide icons compiled into omacloud-app (THIRD_PARTY_NOTICES.md)
depends=('glibc' 'libgcc' 'gtk4')
makedepends=('cargo')
options=('!debug' '!lto')
optdepends=('restic: restore without omacloud (see `omacloud export`)'
            'fuse3: every file in a folder you name, each fetched when opened (`omacloud mount`)')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('73ea10c5af00ed4279056e4c2ecff74fa79e3273a6c9ea24a6ef0b9a6f9d5494')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
  # no builder paths in the binaries, so rebuilds match
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo"
  cargo build --frozen --release -p omacloud -p omacloud-app
}

check() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
  cargo test --frozen --release -p omacloud-core --lib
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/omacloud" "$pkgdir/usr/bin/omacloud"
  # The window is a program of its own, out of PATH: `omacloud open` (the
  # desktop entry's Exec) runs it, so the one command is omacloud. The old
  # omacloud-app command, which notifications and launchers may still run,
  # opens it too.
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/omacloud-app" "$pkgdir/usr/lib/omacloud/omacloud-app"
  ln -s ../lib/omacloud/omacloud-app "$pkgdir/usr/bin/omacloud-app"
  # Omarchy's one name: the entry, its icon and the window's Wayland app id
  install -Dm644 contrib/omacloud.desktop "$pkgdir/usr/share/applications/omacloud.desktop"
  install -Dm644 contrib/omacloud.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omacloud.svg"
  install -Dm644 contrib/omacloud.service "$pkgdir/usr/lib/systemd/user/omacloud.service"
  # the cloud in Omarchy's bar; `omacloud bar on` links it among the shell's plugins
  install -Dm644 contrib/omarchy-plugin/manifest.json contrib/omarchy-plugin/Widget.qml \
    -t "$pkgdir/usr/share/omacloud/omarchy-plugin"
  install -Dm644 contrib/omarchy-plugin/i18n/*.json -t "$pkgdir/usr/share/omacloud/omarchy-plugin/i18n"
  # Enabled for every user, so an update turns it on too; the unit's
  # condition skips users who haven't set up Omacloud.
  install -dm755 "$pkgdir/usr/lib/systemd/user/default.target.wants"
  ln -s ../omacloud.service "$pkgdir/usr/lib/systemd/user/default.target.wants/omacloud.service"
  install -Dm644 README.md docs/design.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE THIRD_PARTY_NOTICES.md -t "$pkgdir/usr/share/licenses/$pkgname"
}
