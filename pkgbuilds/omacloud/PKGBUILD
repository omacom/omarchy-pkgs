# Maintainer: Ferdous Bhai <23114244+ferdousbhai@users.noreply.github.com>
pkgname=omacloud
pkgver=0.0.15
pkgrel=1
pkgdesc="Your files and settings on every Omarchy computer, end to end encrypted, in your own storage or optionally on Omacloud storage (CLI, daemon, GTK app)"
arch=('x86_64' 'aarch64')
url="https://github.com/ferdousbhai/omacloud"
license=('MIT')
depends=('glibc' 'libgcc' 'gtk4' 'libadwaita' 'libsecret')
makedepends=('cargo')
options=('!debug' '!lto')
optdepends=('restic: restore without omacloud (see `omacloud export`)')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('14c6954720c099493535296f2f36482abd03502494103242c33950fd2357e317')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  # no builder paths in the binaries, so rebuilds match
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo"
  cargo build --frozen --release -p omacloud -p omacloud-app
}

check() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release -p omacloud-core --lib
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/omacloud "$pkgdir/usr/bin/omacloud"
  install -Dm755 target/release/omacloud-app "$pkgdir/usr/bin/omacloud-app"
  install -Dm644 contrib/com.ferdousbhai.Omacloud.desktop \
    "$pkgdir/usr/share/applications/com.ferdousbhai.Omacloud.desktop"
  install -Dm644 contrib/omacloud.service "$pkgdir/usr/lib/systemd/user/omacloud.service"
  # Enabled for every user, so an update turns it on too; the unit's
  # condition skips users who haven't set up Omacloud.
  install -dm755 "$pkgdir/usr/lib/systemd/user/default.target.wants"
  ln -s ../omacloud.service "$pkgdir/usr/lib/systemd/user/default.target.wants/omacloud.service"
  install -Dm644 README.md docs/design.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
