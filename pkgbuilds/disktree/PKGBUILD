# Maintainer: Tobi Lütke <tobi@lutke.com>

pkgname=disktree
pkgver=0.10.1
pkgrel=1
pkgdesc='Disk space treemap: find what fills a volume, mark what should go, remove it'
arch=('x86_64' 'aarch64')
url='https://github.com/tobi/disktree'
license=('MIT')
# GPUI links fontconfig, libxcb and libxkbcommon(-x11), and opens Wayland,
# EGL and the Vulkan loader at runtime.
depends=(
  'fontconfig'
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
  'libglvnd'
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'vulkan-driver'
  'vulkan-icd-loader'
  'wayland'
)
makedepends=('cargo' 'pkgconf')
optdepends=('xdg-desktop-portal: the Save list… file dialog')
options=('!debug' '!lto')

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('d4f643b578799d0a4f702b64cfa6f180110280cbd8e02d14f7178efe0709f7ce')

prepare() {
  cd "$pkgname-$pkgver"

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"

  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p disktree-app
}

check() {
  cd "$pkgname-$pkgver"

  # The core crate only: the app's tests open real windows, which a
  # headless builder cannot.
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release -p disktree-core
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/disktree "$pkgdir/usr/bin/disktree"
  install -Dm644 assets/disktree.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/disktree.svg"
  install -d "$pkgdir/usr/share/applications"
  sed -e 's|@BINDIR@|/usr/bin|' -e "s|@VERSION@|$pkgver|" \
    packaging/disktree.desktop.in >"$pkgdir/usr/share/applications/disktree.desktop"
  chmod 644 "$pkgdir/usr/share/applications/disktree.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
