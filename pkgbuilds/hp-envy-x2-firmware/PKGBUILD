# Audio DSP, video, modem and sensor DSP firmware for the HP Envy x2. The firmware only runs if it
# is signed for this board by HP, so linux-firmware cannot carry it until the OEM submits it. The
# OEM ships it in the driver bundle it publishes for the machine on Windows Update, whose cabinets
# this recipe fetches with wudrivers and unpacks without running anything. Each file is checked
# against the SHA-256 it was matched to and installed under the name the device tree requests,
# compressed with xz. The kernel tries a plain name, then .zst, then .xz, so once linux-firmware
# ships the same file, its copy is the one loaded, and the two packages never install the same
# path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=hp-envy-x2-firmware
pkgver=20261116
pkgrel=1
pkgdesc='Audio DSP, video, modem and sensor DSP firmware for the HP Envy x2'
arch=('aarch64')
url='https://github.com/birkskyum/wudrivers'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-msm8998-hp-envy-x2')
makedepends=('7zip' 'wudrivers')
options=('!strip' '!debug')
# Windows Update's links are short-lived, so wudrivers fetches a fresh one by update ID, revision and SHA-1.
DLAGENTS+=('wu::/usr/bin/wudrivers fetch %u -o %o')
source=(
  'hp-envy-x2-wu-200.0.5.0-qcsubsys8998.cab::wu://55a6f81d-43c8-4594-9db5-11f82d7e04b5/1/d8f6303cd7cefbb74ff8a784c797b4f133aaf22a'
  'hp-envy-x2-wu-200.0.5.0-qcdx8998.cab::wu://55a6f81d-43c8-4594-9db5-11f82d7e04b5/1/c227709ecf488899d8c95ad12aa1ca0341a570e4'
)
source+=('README.package.md')
noextract=('hp-envy-x2-wu-200.0.5.0-qcsubsys8998.cab' 'hp-envy-x2-wu-200.0.5.0-qcdx8998.cab')
sha256sums=('b3854900c491fd36177b9fa51826a0c609cfbc485868501742be4cbd9d64c671' '94a28ad6da0d185a194792248d2a6b5ea38e99b0deab194d17d0e0d7b9ec6eca')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'hp-envy-x2-wu-200.0.5.0-qcsubsys8998.cab' 'hp-envy-x2-wu-200.0.5.0-qcsubsys8998' 7z
  _unpack 'hp-envy-x2-wu-200.0.5.0-qcdx8998.cab' 'hp-envy-x2-wu-200.0.5.0-qcdx8998' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'hp-envy-x2-wu-200.0.5.0-qcsubsys8998/qcadsp8998.mbn' "$fw"/'qcom/msm8998/hp/envy-x2/qcadsp8998.mbn'
  install -Dm644 'hp-envy-x2-wu-200.0.5.0-qcsubsys8998/qcdsp1v28998.mbn' "$fw"/'qcom/msm8998/hp/envy-x2/qcdsp1v28998.mbn'
  install -Dm644 'hp-envy-x2-wu-200.0.5.0-qcsubsys8998/qcdsp28998.mbn' "$fw"/'qcom/msm8998/hp/envy-x2/qcdsp28998.mbn'
  install -Dm644 'hp-envy-x2-wu-200.0.5.0-qcsubsys8998/qcslpi8998_CLS.mbn' "$fw"/'qcom/msm8998/hp/envy-x2/qcslpi8998_CLS.mbn'
  install -Dm644 'hp-envy-x2-wu-200.0.5.0-qcdx8998/qcvss8998.mbn' "$fw"/'qcom/msm8998/hp/envy-x2/qcvss8998.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
dcd8e66d919a4a1a2b6794627ed3f0a0712af0795dd73ac90169b6fbabc439d1  qcom/msm8998/hp/envy-x2/qcadsp8998.mbn
b729eab69e1a20ed100f35fbd7ab3ccaca3f8077d85221a8225622e765f125e2  qcom/msm8998/hp/envy-x2/qcdsp1v28998.mbn
b7a8fec6292f3fdaf6e40d20eb5158e460928396cd30ed785012146243c9050c  qcom/msm8998/hp/envy-x2/qcdsp28998.mbn
ef97fec85d8400aa77b0366adfa5a931c846df70b1a36586d53a3bd2a7ab6cee  qcom/msm8998/hp/envy-x2/qcslpi8998_CLS.mbn
b74c650eb87e127973e50b185f504e26777c6b13b3a1b237f3a0a38573cca96d  qcom/msm8998/hp/envy-x2/qcvss8998.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
