# Maintainer: Meir Dick <mdick85@gmail.com>
#
# Speakers and microphone for the HP EliteBook X G2i (Panther Lake).
#
# The board pairs an RT712 SDCA codec with four TAS2783 smart amps. The kernel
# changes needed to drive that combination ship in linux-omarchy, the Omarchy
# default kernel: a Panther Lake ACPI match-table entry (0520) and the
# three-patch series that splits the four-amp link across two PDIs (0523-0525)
# so the speakers are stereo rather than four copies of the left channel. The
# TAS2783A component name the card needs for " spk:tas2783" is in 7.2.
#
# With those in place stock alsa-ucm-conf does the rest, and this package is
# only the userspace remainder:
#
#   - the Speaker device definition, at the path HiFi.conf already looks for
#   - firmware filename symlinks the tas2783 driver asks for
#   - two layers of protection against the amp enumeration race at boot
#
# No DKMS. Nothing here overrides a file another package owns.
#
# It carries no vendor tuning data. The perceptual voicing ships separately as
# an Omarchy audio tuning.

pkgname=hp-elitebook-x-g2i-audio
pkgver=1.1.0
pkgrel=8
pkgdesc="Speaker and microphone support for HP EliteBook X G2i (TAS2783 + RT712)"
arch=('x86_64')
url="https://github.com/omacom-io/omarchy-pkgs"
license=('GPL-2.0-or-later')
# alsa-utils for amixer, which both the boot guard and the self-heal use.
#
# The dependency on linux-omarchy is deliberate and is the point of this shape:
# the match-table entry and the stereo series live there, and without them
# everything else in this package is inert. Omarchy installs linux-omarchy on
# every machine, so this only records the requirement.
depends=('alsa-ucm-conf' 'alsa-utils' 'sof-firmware' 'linux-omarchy')
install=hp-elitebook-x-g2i-audio.install
options=('!debug')

source=(
  '50-wait-tas2783.conf'
  'README.package.md'
  'hp-elitebook-x-g2i-audio-recover'
  'hp-elitebook-x-g2i-audio-recover.service'
  'hp-elitebook-x-g2i-audio.install'
  'tas2783-hp-elitebook-x-g2i.conf'
  'HP-HPEliteBookXG2i14inchNotebookNextGenAIPC-SBKPFV3-8E86.conf'
  'wait-tas2783-controls'
)
sha256sums=('da77438d271b1525de88323f834201b0410c9e096e1150d83dda6e63a24d6d71'
            '413e76f73c861d50071199d3c606dbd9017d97a243a73eedb564aab75937e51a'
            '8b1812fb9b8d61ffaed215a66424d1145d5e4b91e09a43c88c9891540f5ffc48'
            'fe3c2febeac04b485cb49f2bc9455f9e053c919c368bb759dcc3f56b9fab4692'
            '38c220e00e8e84cc32319b191616403a48bbb0238357e6d7637247a528658914'
            '23bf45d7ff90d91970c903dab72b583cd94848c69dcab3fc25b48a7dad1e64c2'
            'e30dbb9ee2e4ecf343a92ff3faf196e6d2025451c391010201e1cba7eee202a3'
            'f70455022144cbc267888091caf88b19b93d945204536f3d2c43bf586baa0a5c')

package() {
  # The Speaker device, under a name of our own. The kernel reports
  # " spk:tas2783", so sof-soundwire/HiFi.conf would include
  # "/sof-soundwire/tas2783.conf" -- a path alsa-ucm-conf now ships itself, and
  # two packages cannot own one file. The card override below redirects the
  # include to this copy instead, which carries the per-amp volume caps and the
  # analog gain the upstream file has no reason to know about.
  install -Dm644 tas2783-hp-elitebook-x-g2i.conf \
    "${pkgdir}/usr/share/alsa/ucm2/sof-soundwire/tas2783-hp-elitebook-x-g2i.conf"

  # The card override. UCM probes conf.d/${CardDriver}/${CardLongName}.conf
  # before the driver-wide file, so this applies to this model alone.
  install -Dm644 "HP-HPEliteBookXG2i14inchNotebookNextGenAIPC-SBKPFV3-8E86.conf" \
    "${pkgdir}/usr/share/alsa/ucm2/conf.d/sof-soundwire/HP-HPEliteBookXG2i14inchNotebookNextGenAIPC-SBKPFV3-8E86.conf"

  # Boot race, layer one. WirePlumber can start before the amp kcontrols exist,
  # which leaves the card on profile "off" with no sinks and no sources on a
  # random subset of boots.
  install -Dm755 wait-tas2783-controls "${pkgdir}/usr/bin/wait-tas2783-controls"
  install -Dm644 50-wait-tas2783.conf \
    "${pkgdir}/usr/lib/systemd/user/wireplumber.service.d/50-wait-tas2783.conf"

  # Boot race, layer two. The wait narrows the window without closing it, and
  # one of the two faults it misses looks completely healthy from ALSA.
  install -Dm755 hp-elitebook-x-g2i-audio-recover \
    "${pkgdir}/usr/bin/hp-elitebook-x-g2i-audio-recover"
  install -Dm644 hp-elitebook-x-g2i-audio-recover.service \
    "${pkgdir}/usr/lib/systemd/user/hp-elitebook-x-g2i-audio-recover.service"
  # Enabled by shipping the symlink: a user unit cannot be enabled from a
  # package scriptlet, which runs as root with no user session in reach.
  install -dm755 "${pkgdir}/usr/lib/systemd/user/default.target.wants"
  ln -s ../hp-elitebook-x-g2i-audio-recover.service \
    "${pkgdir}/usr/lib/systemd/user/default.target.wants/hp-elitebook-x-g2i-audio-recover.service"

  install -Dm644 README.package.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
