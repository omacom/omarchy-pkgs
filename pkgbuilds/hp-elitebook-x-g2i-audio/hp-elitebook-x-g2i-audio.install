# The tas2783 driver requests 8E86-2-{9,A,C,D}.bin; linux-firmware ships the
# same per-amp calibration blobs as 8E86-2-0x{9,A,C,D}.bin.zst. Link rather than
# copy so a linux-firmware update still owns the real files, and so removing
# this package leaves nothing stale behind.
_link_firmware() {
  local addr
  for addr in 9 A C D; do
    if [ -e "/lib/firmware/8E86-2-0x$addr.bin.zst" ] &&
       [ ! -e "/lib/firmware/8E86-2-$addr.bin.zst" ]; then
      ln -sf "8E86-2-0x$addr.bin.zst" "/lib/firmware/8E86-2-$addr.bin.zst"
    fi
  done
}

_unlink_firmware() {
  local addr
  for addr in 9 A C D; do
    # only remove OUR symlink, never a real file a package may own
    if [ -L "/lib/firmware/8E86-2-$addr.bin.zst" ]; then
      rm -f "/lib/firmware/8E86-2-$addr.bin.zst"
    fi
  done
}

# A drop-in of the same name in /etc/systemd/user outranks ours in
# /usr/lib/systemd/user and REPLACES it rather than adding to it. If that copy
# points ExecStartPre at a binary that is not there, WirePlumber fails with
# 203/EXEC, burns its restart limit and stops -- which is not "no speakers" but
# no audio at all. Ours tolerates a failing guard; a shadowing copy need not.
# /etc belongs to the administrator, so warn rather than delete.
_warn_shadowed_dropin() {
  local f=/etc/systemd/user/wireplumber.service.d/50-wait-tas2783.conf
  [ -e "$f" ] || return 0
  cat <<MSG

  WARNING: $f
  shadows this package's drop-in of the same name and will be used instead.
  If it points ExecStartPre at a path that does not exist, WirePlumber will
  fail to start and you will have no audio at all. Remove it unless you put it
  there on purpose:

    sudo rm $f && systemctl --user daemon-reload

MSG
}

post_install() {
  _link_firmware
  _warn_shadowed_dropin

  cat <<'MSG'
HP EliteBook X G2i audio installed.

  Reboot required: the speaker support depends on linux-ptl, whose match-table
  entry and TAS2783A component name only take effect on a kernel this package
  did not boot from.

  After rebooting, verify:
    amixer -c 0 info | grep Components       # expect " spk:tas2783"
    pactl list cards | grep 'Active Profile' # expect HiFi
MSG
}

post_upgrade() {
  _link_firmware
  _warn_shadowed_dropin
}

post_remove() {
  _unlink_firmware
  echo "Removed. Speakers and mic will be gone again after the next reboot."
}
