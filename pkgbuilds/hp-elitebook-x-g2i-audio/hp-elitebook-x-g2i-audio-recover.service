[Unit]
Description=HP EliteBook X G2i audio boot-race self-heal
Documentation=file:/usr/share/doc/hp-elitebook-x-g2i-audio/README.md
After=wireplumber.service

[Service]
Type=oneshot
ExecStart=/usr/bin/hp-elitebook-x-g2i-audio-recover
# The script sleeps through settle windows and always exits 0. A hard ceiling
# so a wedged pactl or pw-link can never leave a oneshot hanging in the
# session's dependency graph.
TimeoutStartSec=120

[Install]
WantedBy=default.target
