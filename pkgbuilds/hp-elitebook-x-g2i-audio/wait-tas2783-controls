#!/bin/bash
# HP EliteBook X G2i: delay WirePlumber start until the TAS2783 amp kcontrols
# exist.
#
# The amps download firmware asynchronously at boot. If WirePlumber's ACP
# enumerates the sof_sdw card before 'tas2783-1 Speaker Volume' appears, the
# UCM Speaker device is skipped and the whole HiFi profile comes up unavailable
# -- card stuck on profile "off", no sinks, no sources -- until someone
# restarts WirePlumber by hand.
#
# Waits up to 20s, then proceeds regardless. It must never block login: this
# runs as ExecStartPre for the user's WirePlumber, so a hang here is a session
# with no audio service at all.

# The first amp's kcontrol appearing is necessary but nowhere near sufficient.
# All four controls are created when the components probe, about a second into
# the card coming up, but each amp then applies its factory calibration in
# turn, roughly a second apart, and an amp is not ready until its own pass is
# done. Observed on 7.2.8: controls at 9.6s, calibration finishing at 10.8,
# 11.9, 13.0 and 14.0s. A fixed settle sleep is a guess at that spread and
# loses whenever the spread grows; this lost by 0.4s and the card came up
# silent.
#
# So probe the thing that actually breaks. While an amp is still initialising
# its register cache is synced over the top of anything written, so a write
# does not stick. Write the trim the UCM Speaker sequence will write anyway,
# read it back, and require every amp to hold it on two consecutive passes.
amps_settled() {
  local card="$1" n val stable=0 pass

  for pass in 1 2; do
    for n in 1 2 3 4; do
      amixer -c "$card" cset name="tas2783-$n Speaker Volume" 176 >/dev/null 2>&1 || return 1
    done
    sleep 0.5
    for n in 1 2 3 4; do
      val=$(amixer -c "$card" cget name="tas2783-$n Speaker Volume" 2>/dev/null |
              awk -F= '/: values/ { print $2; exit }')
      [[ $val == 176 ]] || return 1
    done
    stable=$((stable + 1))
  done

  [[ $stable -eq 2 ]]
}

card=""
for _ in $(seq 1 100); do
  # Resolve the card index each pass rather than assuming 0. Card numbering
  # depends on probe order, and on a machine with an external or HDMI-only
  # card enumerated first, index 0 is not sof_sdw.
  if [[ -z $card ]]; then
    card=$(awk '/^ *[0-9]+ \[/ { idx = $1; gsub(/[^0-9]/, "", idx) }
                /sof-soundwire/ { print idx; exit }' /proc/asound/cards)
  fi

  if [[ -n $card ]] && amps_settled "$card"; then
    exit 0
  fi

  sleep 0.2
done

exit 0
