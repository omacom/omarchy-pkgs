#!/bin/bash
# HP EliteBook X G2i: delay WirePlumber start until the TAS2783 amp kcontrols
# exist.
#
# The amps download firmware asynchronously at boot. If WirePlumber's ACP
# enumerates the sof_sdw card before 'tas2783-1 Speaker Volume' appears, the
# UCM Speaker device is skipped and the whole HiFi profile comes up unavailable
# -- card stuck on profile "off", no sinks, no sources -- until someone
# restarts WirePlumber by hand.
#
# Waits up to 12s, then proceeds regardless. It must never block login: this
# runs as ExecStartPre for the user's WirePlumber, so a hang here is a session
# with no audio service at all.

card=""
for _ in $(seq 1 60); do
  # Resolve the card index each pass rather than assuming 0. Card numbering
  # depends on probe order, and on a machine with an external or HDMI-only
  # card enumerated first, index 0 is not sof_sdw.
  if [[ -z $card ]]; then
    card=$(awk '/^ *[0-9]+ \[/ { idx = $1; gsub(/[^0-9]/, "", idx) }
                /sof-soundwire/ { print idx; exit }' /proc/asound/cards)
  fi

  if [[ -n $card ]] &&
     amixer -c "$card" controls 2>/dev/null | grep -q "tas2783-1 Speaker Volume"; then
    # The kcontrol appearing is necessary but not sufficient: the amps are
    # still settling for a moment after it shows up, and enumerating during
    # that window fails the same way.
    sleep 4
    exit 0
  fi

  sleep 0.2
done

exit 0
