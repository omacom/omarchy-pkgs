# Maintainer: Julian Kaiser <julian@kaiserlich.dev>
#
# The release archive from Pastefast's public releases repository. Its
# pastefast-portable.txt marker is left out: without it, Pastefast leaves
# updates to pacman instead of replacing itself.
pkgname=pastefast-bin
pkgver=0.4.2
pkgrel=1
pkgdesc='Clipboard history on a shelf: search, preview and paste anything you copied'
arch=('x86_64')
url='https://pastefast.app'
license=('LicenseRef-Pastefast')
provides=('pastefast')
conflicts=('pastefast')
# Linked: glibc, gcc-libs, libxkbcommon. Loaded at runtime: libEGL (libglvnd),
# libwayland-client and libwayland-egl (wayland). It drives Hyprland through
# hyprctl's socket, reads and writes the clipboard with wl-clipboard, and
# pastes with wtype.
depends=('glibc' 'gcc-libs' 'libxkbcommon' 'libglvnd' 'wayland' 'hyprland' 'wl-clipboard' 'wtype' 'hicolor-icon-theme')
optdepends=('xdg-utils: open links from the shelf')
options=('!strip' '!debug')
source=('pastefast.desktop'
        'pastefast.svg'
        'LICENSE')
source_x86_64=("https://github.com/kaiserlich-dev/pastefast-releases/releases/download/v${pkgver}/pastefast-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('80fd39f2ba0e82c77f9c4792c899780be19024c23fafc94d07d833f87dcac83f'
            '0d05551c475a01e67abdac11cb8ba4b3eab66d1b95ec2f7e88fb1f8a3d05b2b3'
            '5eb27a6e49ae1f5304758a761b822356c4b5d1ac3ac8395d2961c8091751d2d6')
sha256sums_x86_64=('d3d525905cd62fea0730c3a85999668eeaa4dc0e39940376d200d08a6aa81702')

package() {
  install -Dm755 "pastefast-v${pkgver}-x86_64-unknown-linux-gnu/pastefast" "$pkgdir/usr/bin/pastefast"
  install -Dm644 pastefast.desktop "$pkgdir/usr/share/applications/pastefast.desktop"
  install -Dm644 pastefast.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/pastefast.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
