{
  "source": "local",
  "release_ring": "fast",
  "upstream": {
    "watch": {
      "github": "pingdotgg/t3code",
      "pattern": "v(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)-nightly\\.(?P<date>[0-9]{8})\\.(?P<run>[0-9]+)",
      "version": "{version}_nightly.{date}.{run}",
      "allow_prerelease": true
    }
  }
}
