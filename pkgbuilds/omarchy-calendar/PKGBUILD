# Maintainer: Jason Alexander <jason@greatspark.com>
# Generated with packaging/prepare-release.py for AUR and Omarchy submissions.
pkgname=omarchy-calendar
pkgver=1.0.0
pkgrel=1
pkgdesc='A polished native calendar for Omarchy'
arch=('x86_64' 'aarch64')
url='https://lastrefuge.ai/projects/omarchy-calendar'
license=('MIT')
# xdg-utils provides xdg-open, launched by the service for OAuth authorization.
depends=('glib2' 'glibc' 'hicolor-icon-theme' 'libgcc' 'libsecret' 'libstdc++' 'qt6-base>=6.9' 'qt6-declarative>=6.9' 'qt6-networkauth>=6.9' 'xdg-utils')
makedepends=('cmake' 'ninja' 'pkgconf')
optdepends=('qt6-wayland: native Wayland support'
            'gnome-keyring: Secret Service provider for Google account tokens (or another configured provider)')
source=("https://github.com/last-refuge/omarchy-calendar/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
b2sums=('4c712b31b95cfb61b7cff8efb5493a695f2bd4ea6a8eaddfc51defc11dbe8828041d3d1bab5303db4bbfb4ea3dfe91913f6f5b5802652f6f2d9ae2c318d30cd5')

build() {
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DOMARCHY_CALENDAR_OAUTH_ENV_FILE="$srcdir/$pkgname-$pkgver/packaging/google-oauth.env" \
    -Wno-dev
  cmake --build build
}

check() {
  "$srcdir/build/omarchy-calendar-service" --version
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
