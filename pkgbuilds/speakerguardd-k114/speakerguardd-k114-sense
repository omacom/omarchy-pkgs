#!/bin/sh
# Turn on every voltage and current sense switch of the K114 card, by name, and read each back.
# Fails closed: if the controls cannot be listed, fewer than the 12 switches are found, a switch
# cannot be set or does not read back on, the unit does not start and the speakers stay locked.
card=AppleK114
want=12
list=$(amixer -c "$card" controls) || exit 1
names=$(printf '%s\n' "$list" | sed -n "s/.*name='\(.*SENSE.*Switch\)'.*/\1/p")
found=$(printf '%s\n' "$names" | grep -c .)
if [ "$found" -ne "$want" ]; then
    echo "speakerguardd-k114-sense: found $found sense switches on $card, want $want" >&2
    exit 1
fi
while IFS= read -r name; do
    amixer -q -c "$card" cset "name=$name" on || exit 1
    amixer -c "$card" cget "name=$name" | grep -q 'values=on' || exit 1
done <<EOF
$names
EOF
exit 0
