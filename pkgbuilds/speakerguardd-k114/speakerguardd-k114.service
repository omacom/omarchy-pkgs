[Unit]
Description=Speaker Protection Daemon (feed-forward), MacBook Pro K114 (provisional profile)
# Restarts are safe: until the daemon renews the card's volume lock the
# speakers sit at the card's safe level.  A restarted daemon resumes the
# thermal model only after a clean stop, and otherwise starts it at the
# coils' limit.  A crash loop gives up after five attempts and leaves the
# speakers at that level.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# The sense words are zero while a V/I sense switch is off, and the daemon
# would then see no power.
ExecStartPre=/usr/lib/speakerguardd-k114/speakerguardd-k114-sense
# The udev rule starts this unit when the K114's sense PCM appears; the daemon
# also waits for the card, and binds only the K114's card.
ExecStart=/usr/lib/speakerguardd-k114/speakerguardd -c /usr/share/speakerguardd-k114 -C AppleK114 --wait-for-card 30
UMask=0066
# Time the daemon is held up is bounded only by the card's 250 ms lease: run
# ahead of normal tasks (below PipeWire's audio threads, 83-88), keep every
# page resident (the daemon calls mlockall), and stop a runaway loop.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50
LimitMEMLOCK=64M
LimitRTTIME=1s
RuntimeDirectory=speakerguardd
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
