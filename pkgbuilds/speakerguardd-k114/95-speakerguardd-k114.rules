SUBSYSTEM=="sound", DRIVERS=="snd-soc-macaudio", GOTO="speakerguardd_k114"
GOTO="speakerguardd_k114_end"

LABEL="speakerguardd_k114"
# The sense capture belongs to the daemon, not to the desktop's audio stack.
KERNEL=="pcmC*D2c", ATTRS{id}=="AppleK114", ENV{ACP_IGNORE}="1"
KERNEL=="pcmC*D2c", ATTRS{id}=="AppleK114", TAG+="systemd", ENV{SYSTEMD_WANTS}="speakerguardd-k114.service"

LABEL="speakerguardd_k114_end"
