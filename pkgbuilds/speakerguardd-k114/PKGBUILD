pkgname=speakerguardd-k114
pkgver=0.1.12
pkgrel=2
pkgdesc='Speaker feed-forward protection for the MacBook Pro 14-inch (M5 Max, K114), provisional profile'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/aurora-silicon/speakerguardd'
license=('MIT')
# upstream main at 0.1.12; the patch (aurora-silicon/speakerguardd#177) adds sense_format = S16_LE, which the K114's sense PCM needs.
_commit=32389c67b5c291dc9f1c9b32994d0b2f8adb27fd
makedepends=('git' 'rust' 'cargo' 'alsa-lib' 'pkgconf')
depends=('glibc' 'gcc-libs' 'alsa-lib' 'alsa-utils')
source=("speakerguardd::git+$url.git#commit=$_commit"
        0001-sense-format-s16.patch
        k114.conf
        speakerguardd-k114.service
        95-speakerguardd-k114.rules
        50-k114-guard.conf
        use-feedback-guard
        speakerguardd-k114-sense)
sha256sums=('SKIP'
            '17ca074cc91bf048f08aa2241ca6f38a1ee606c9f3d836adc442ef1507e248d8'
            '5f69243da9b53fe23423c1f2f068dedad43f512220154272cd33244af3f1e35d'
            '87f5d7b05dcdb42caf36beb1be2549da1e671b53f9aa705946b10d2a7f5483fe'
            '8078fcd6315cd17e4c3a7fbf300ce659f9d7373b3afd033709f2520eb094f3c6'
            '6285529225fa0ce64115cd7908a47cc134c7533555d8fb1b26f073c347527804'
            '1ba9245e757d27510af718ebd6bbe539af10a303d6d5e7dd31c0283567d3b153'
            '75e21af927a8c8a0acb871ae0056a02f395f5a603519e03d929c329ad3f95d32')
prepare() {
  cd speakerguardd
  patch -Np1 -i ../0001-sense-format-s16.patch
}
build() {
  cd speakerguardd
  cargo build --locked --release ${CARGO_TARGET:+--target "$CARGO_TARGET"}
}
check() {
  cd speakerguardd
  cargo test --locked
}
package() {
  local binary=speakerguardd/target/release/speakerguardd
  if [[ -n ${CARGO_TARGET:-} ]]; then binary=speakerguardd/target/$CARGO_TARGET/release/speakerguardd; fi
  install -Dm755 "$binary" "$pkgdir/usr/lib/speakerguardd-k114/speakerguardd"
  install -Dm755 speakerguardd-k114-sense "$pkgdir/usr/lib/speakerguardd-k114/speakerguardd-k114-sense"
  install -Dm755 use-feedback-guard "$pkgdir/usr/lib/speakerguardd-k114/use-feedback-guard"
  install -Dm644 k114.conf "$pkgdir/usr/share/speakerguardd-k114/apple/k114.conf"
  install -Dm644 speakerguardd-k114.service "$pkgdir/usr/lib/systemd/system/speakerguardd-k114.service"
  install -Dm644 95-speakerguardd-k114.rules "$pkgdir/usr/lib/udev/rules.d/95-speakerguardd-k114.rules"
  install -Dm644 50-k114-guard.conf "$pkgdir/usr/lib/systemd/system/speakersafetyd.service.d/50-k114-guard.conf"
  install -Dm644 speakerguardd/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
