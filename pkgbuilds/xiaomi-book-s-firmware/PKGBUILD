# Audio DSP, compute DSP, GPU and modem firmware for the Xiaomi Book S 12.4. The firmware only
# runs if it is signed for this board by Xiaomi, so linux-firmware cannot carry it until the OEM
# submits it. The OEM ships it in the driver bundle it publishes for the machine on Windows
# Update, whose cabinets this recipe fetches with wudrivers and unpacks without running anything.
# Each file is checked against the SHA-256 it was matched to and installed under the name the
# device tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so
# once linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=xiaomi-book-s-firmware
pkgver=20261116
pkgrel=1
pkgdesc='Audio DSP, compute DSP, GPU and modem firmware for the Xiaomi Book S 12.4'
arch=('aarch64')
url='https://github.com/birkskyum/wudrivers'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-sc8180xp-xiaomi-book-s')
makedepends=('7zip' 'wudrivers')
options=('!strip' '!debug')
# Windows Update's links are short-lived, so wudrivers fetches a fresh one by update ID, revision and SHA-1.
DLAGENTS+=('wu::/usr/bin/wudrivers fetch %u -o %o')
source=(
  'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcwlan8180.cab::wu://b7c0eed1-5795-4369-a9e2-bd3476a9a6f3/1/7c6e2e599cd9e0774188aabd2a224e5a1f511eda'
  'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcsubsys-ext-cdsp8180.cab::wu://b7c0eed1-5795-4369-a9e2-bd3476a9a6f3/1/ca592613684a8221f0679747179930ea10a924fd'
  'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcsubsys-ext-adsp8180.cab::wu://b7c0eed1-5795-4369-a9e2-bd3476a9a6f3/1/c595814c7ed4870c280e0cb9037ba3fd14e1aa8f'
  'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcdx8180.cab::wu://b7c0eed1-5795-4369-a9e2-bd3476a9a6f3/1/4a210ed861b59da3552cba689cd594473892b1d5'
  'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcsubsys-ext-mpss8180.cab::wu://b7c0eed1-5795-4369-a9e2-bd3476a9a6f3/1/011112f8b5a3281cd5738e91e808ed17aaf3468c'
)
source+=('README.package.md')
noextract=('xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcwlan8180.cab' 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcsubsys-ext-cdsp8180.cab' 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcsubsys-ext-adsp8180.cab' 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcdx8180.cab' 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcsubsys-ext-mpss8180.cab')
sha256sums=('38e379b0c47329c1c0e1a0eb35e0c0ac30e5e6040a0fe4b1c987d20001362f86' '845cc8429d503d8e96f6f90d1b6a0baa02748338b4c236fb2182572e64a6eb27' 'b191e39eb7127f918fd85bffaddaa98d9ce8c8ed7f3f8134d72438bf7884870e' '55e519adbba0823619e90853503e91230b5df16b80abcb5fbc3082c9ba52ba36' '056325c564110c1c0c86ac13a2b23a60b54f6196524efbcec2e718eb2b790313')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcwlan8180.cab' 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcwlan8180' 7z
  _unpack 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcsubsys-ext-cdsp8180.cab' 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcsubsys-ext-cdsp8180' 7z
  _unpack 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcsubsys-ext-adsp8180.cab' 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcsubsys-ext-adsp8180' 7z
  _unpack 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcdx8180.cab' 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcdx8180' 7z
  _unpack 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcsubsys-ext-mpss8180.cab' 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcsubsys-ext-mpss8180' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcsubsys-ext-adsp8180/qcadsp8180.mbn' "$fw"/'qcom/sc8180xp/Xiaomi/book-s/qcadsp8180.mbn'
  install -Dm644 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcsubsys-ext-cdsp8180/qccdsp8180.mbn' "$fw"/'qcom/sc8180xp/Xiaomi/book-s/qccdsp8180.mbn'
  install -Dm644 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcdx8180/qcdxkmsuc8180.mbn' "$fw"/'qcom/sc8180xp/Xiaomi/book-s/qcdxkmsuc8180.mbn'
  install -Dm644 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcsubsys-ext-mpss8180/qcmpss8180_nm.mbn' "$fw"/'qcom/sc8180xp/Xiaomi/book-s/qcmpss8180_nm.mbn'
  install -Dm644 'xiaomi-book-s-tm2133-39542-wu-200.0.3.0-qcwlan8180/WLANMDSP.MBN' "$fw"/'qcom/sc8180xp/Xiaomi/book-s/wlanmdsp.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
16cc74a719f6da4ab1a160729e83f7072ade33c139a430c747bbd3a35ebc43a2  qcom/sc8180xp/Xiaomi/book-s/qcadsp8180.mbn
565fdf3ede556725c96e95d630353a3c1d81baf1b907fcd9a6a687f06c4b007f  qcom/sc8180xp/Xiaomi/book-s/qccdsp8180.mbn
660c66fd69ced64004a173978cabfdbe569ec7aea1dc43657033fbf93778328f  qcom/sc8180xp/Xiaomi/book-s/qcdxkmsuc8180.mbn
cbbb0af0cd1249f4dc29dbef909935f0e8009e674ffaf48f3e4f8f17e7c41175  qcom/sc8180xp/Xiaomi/book-s/qcmpss8180_nm.mbn
2f27b0656b7de62859f0dddaa51f4d90d3a5d5357a1db433e1ba360f0a5df0bc  qcom/sc8180xp/Xiaomi/book-s/wlanmdsp.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
