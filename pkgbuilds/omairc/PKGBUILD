# Maintainer: Fredi Machado <fredisoft@gmail.com>
pkgname=omairc
pkgver=0.1.0
pkgrel=1
pkgdesc='Dead-simple IRC client for Omarchy'
arch=('x86_64')
url='https://github.com/fredimachado/omairc'
license=('MIT' 'LGPL-3.0-or-later' 'OFL-1.1')
options=(!debug)
depends=(
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'qt6-wayland'
  'xdg-desktop-portal'
)
makedepends=(
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'qt6-wayland'
  'base-devel'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('53f4743cc2b06b2875e6bf3b736a572e5bc1ba5a0b2ffb8abcf775b70494e4a6')

build() {
  cd "$pkgname-$pkgver"
  qmake6 PREFIX=/usr
  make
}

package() {
  cd "$pkgname-$pkgver"
  make INSTALL_ROOT="$pkgdir" install
}
