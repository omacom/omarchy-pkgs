# Maintainer: Fredi Machado <fredisoft@gmail.com>
pkgname=omairc
pkgver=0.4.0
pkgrel=1
pkgdesc='Dead-simple IRC client for Omarchy'
arch=('x86_64')
url='https://github.com/fredimachado/omairc'
license=('MIT' 'LGPL-3.0-or-later' 'OFL-1.1')
options=(!debug)
depends=(
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'qt6-wayland'
  'qtkeychain-qt6'
  'xdg-desktop-portal'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c5c41a5246453b21b7a386d8c7b25c99dfab731761f7f09ce3dfac6c02cfa7fe')

build() {
  cd "$pkgname-$pkgver"
  qmake6 PREFIX=/usr
  make
}

check() {
  cd "$pkgname-$pkgver"
  ./bin/test
}

package() {
  cd "$pkgname-$pkgver"
  make INSTALL_ROOT="$pkgdir" install
}
