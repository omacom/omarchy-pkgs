# Maintainer: Fredi Machado <fredisoft@gmail.com>
pkgname=omairc
pkgver=1.10.3
pkgrel=5
pkgdesc='Dead-simple IRC client for Omarchy'
arch=('x86_64')
url='https://github.com/fredimachado/omairc'
license=('MIT' 'LGPL-3.0-or-later' 'OFL-1.1')
options=(!debug)
depends=(
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'qt6-wayland'
  'qtkeychain-qt6'
  'xdg-desktop-portal'
)
makedepends=('python')
source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
  'qt6.12-http-header-case.patch'
  'qt6.12-leave-click.patch'
)
sha256sums=(
  '7bed0b68c3736a31a05254b2634844b37e989f625eceb239eff38e3073a82dd1'
  '0676d0a0dfcdfe7bd571d1cb9f86215e02b8fbeafd76b7de11fbb211107c679e'
  '11029c85d6369c52fef00f98f77fd9eefae9b4586c85da96bc54818fd959bd11'
)

prepare() {
  cd "$pkgname-$pkgver"
  # Qt 6.12 writes canonical HTTP header names. The v1.10.3 upload tests
  # still look for the lowercase names Qt 6.11 put on the wire.
  patch -p1 -i "$srcdir/qt6.12-http-header-case.patch"
  # Leave and Close are shown again from width 0. Qt 6.12 offscreen
  # drops those clicks unless the button has been rendered at its new size.
  patch -p1 -i "$srcdir/qt6.12-leave-click.patch"
}

build() {
  cd "$pkgname-$pkgver"
  qmake6 PREFIX=/usr
  make
}

check() {
  cd "$pkgname-$pkgver"
  ./bin/test
}

package() {
  cd "$pkgname-$pkgver"
  make INSTALL_ROOT="$pkgdir" install
}
