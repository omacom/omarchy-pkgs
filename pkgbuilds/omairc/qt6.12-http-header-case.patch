+
+// Qt 6.11 and earlier wrote header names in lowercase. Qt 6.12 uses the
+// canonical spelling, so match the name case-insensitively.
+bool wireHasHeader(const QByteArray &raw, const char *name, const QByteArray &value)
+{
+    const QByteArray expectedName = QByteArray(name).toLower();
+    const int headerEnd = raw.indexOf("\r\n\r\n");
+    const int limit = headerEnd < 0 ? raw.size() : headerEnd;
+    int start = 0;
+    while (start < limit) {
+        int end = raw.indexOf("\r\n", start);
+        if (end < 0 || end > limit)
+            end = limit;
+        const QByteArray line = raw.mid(start, end - start);
+        const int colon = line.indexOf(':');
+        if (colon > 0
+            && line.left(colon).trimmed().toLower() == expectedName
+            && line.mid(colon + 1).contains(value))
+            return true;
+        if (end >= limit)
+            break;
+        start = end + 2;
+    }
+    return false;
 }
 
