{
  "source": "local",
  "rebuild_on": [
    "qt6-base",
    "qt6-declarative",
    "qt6-svg",
    "qt6-wayland"
  ],
  "upstream": {
    "git_tags": "https://github.com/fredimachado/omairc.git",
    "tag_pattern": "v{pkgver}",
    "sources": {
      "any": [
        "https://github.com/fredimachado/omairc/archive/refs/tags/{tag}.tar.gz",
        "file:qt6.12-http-header-case.patch",
        "file:qt6.12-leave-click.patch"
      ]
    }
  },
  "rebuilt_against": {
    "x86_64": {
      "qt6-base": "6.12.0-3",
      "qt6-declarative": "6.12.0-3",
      "qt6-svg": "6.12.0-1",
      "qt6-wayland": "6.12.0-1"
    }
  }
}
