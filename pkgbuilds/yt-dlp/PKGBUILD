# Maintainer: Omarchy
# The official zipapp, run by the system python3. It bundles yt-dlp-ejs (the
# YouTube challenge solver) and installs no Python modules, so it can follow
# upstream on the fast ring. aarch64 only: Arch Linux ARM's yt-dlp falls far
# behind, while Arch's x86_64 build keeps up and has deno.
pkgname=yt-dlp
pkgver=2026.10.26
pkgrel=1
pkgdesc='A youtube-dl fork with additional features and fixes'
arch=('aarch64')
url='https://github.com/yt-dlp/yt-dlp'
license=('Unlicense')
depends=('python' 'nodejs')
optdepends=(
  'ffmpeg: for video post-processing'
  'rtmpdump: for rtmp streams support'
  'atomicparsley: for embedding thumbnails into m4a files'
  'aria2: for using aria2 as external downloader'
)
backup=('etc/yt-dlp.conf')
source=("yt-dlp-${pkgver}::https://github.com/yt-dlp/yt-dlp/releases/download/${pkgver}/yt-dlp"
        'yt-dlp.conf')
sha256sums=('e51e69e89489f199530f13d32a4342da3ddb2cf34842f364603a066db05afbf3'
            'e134b40af4c811b9ed2c34893c9cc1789755922b1375a338bde2048b4f922b43')
noextract=("yt-dlp-${pkgver}")

package() {
  install -Dm755 "yt-dlp-${pkgver}" "${pkgdir}/usr/bin/yt-dlp"
  install -Dm644 yt-dlp.conf "${pkgdir}/etc/yt-dlp.conf"
}
