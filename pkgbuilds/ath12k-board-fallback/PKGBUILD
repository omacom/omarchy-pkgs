# Maintainer: Birk Skyum <birk.skyum@pm.me>

# Board data for Qualcomm Wi-Fi cards linux-firmware does not list yet, taken from the record
# linux-firmware ships for the card's family. The package holds no firmware: a pacman hook
# copies the record from the installed linux-firmware on the machine itself.

pkgname=ath12k-board-fallback
pkgver=1
pkgrel=1
pkgdesc="Board data for Qualcomm Wi-Fi cards linux-firmware does not list yet, from their card family's record"
arch=('any')
url="https://github.com/omacom/omarchy-pkgs"
license=('MIT')
depends=('python' 'zstd')
options=('!debug')
source=(
  'ath12k-board-fallback'
  'cards'
  'README.package.md'
  '60-ath12k-board-fallback.hook'
  '60-ath12k-board-fallback-remove.hook'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 ath12k-board-fallback "${pkgdir}/usr/bin/ath12k-board-fallback"
  install -Dm644 cards "${pkgdir}/usr/share/${pkgname}/cards"
  install -Dm644 README.package.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 -t "${pkgdir}/usr/share/libalpm/hooks" 60-ath12k-board-fallback.hook \
    60-ath12k-board-fallback-remove.hook
}
