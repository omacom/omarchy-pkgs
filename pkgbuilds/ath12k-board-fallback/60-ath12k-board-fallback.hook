# Choose again whenever linux-firmware's ath12k or ath11k files or the card list change.
# Installing this package installs the card list, so it runs then too.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/firmware/ath12k/*
Target = usr/lib/firmware/ath11k/*

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/share/ath12k-board-fallback/cards

[Action]
Description = Giving Qualcomm Wi-Fi cards linux-firmware does not list their family's board data...
When = PostTransaction
Exec = /usr/bin/ath12k-board-fallback
