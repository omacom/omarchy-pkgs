# ISO builds once packaged a source checkout made under umask 002, so installs
# from them have this package's directories at 775. Pacman keeps a directory's
# mode once it exists and warns about each one on every upgrade, so put back
# the 755 the package ships.
_package_dir_modes_repair() {
  local dir
  /usr/bin/pacman -Qlq omarchy-dev 2>/dev/null | while IFS= read -r dir; do
    [[ $dir == */ && -d $dir && ! -L ${dir%/} ]] || continue
    [[ $(/usr/bin/stat -c '%a %u' "$dir") == '775 0' ]] || continue
    /usr/bin/chmod 0755 "$dir"
  done
}

post_upgrade() {
  _package_dir_modes_repair
}
