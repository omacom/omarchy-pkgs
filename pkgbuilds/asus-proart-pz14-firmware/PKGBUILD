# Audio DSP and compute DSP firmware for the ASUS ProArt PZ14. The firmware only runs if it is
# signed for this board by ASUS, so linux-firmware cannot carry it until the OEM submits it. The
# OEM ships it in its Windows driver download, which this recipe unpacks without running. Each
# file is checked against the SHA-256 it was matched to and installed under the name the device
# tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so once
# linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=asus-proart-pz14-firmware
pkgver=20261110
pkgrel=1
pkgdesc='Audio DSP and compute DSP firmware for the ASUS ProArt PZ14'
arch=('aarch64')
url='https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/52286/SOCPackage_forWebSite_Qualcomm_Z_V1.309.4500.0_52286.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-glymur-asustek-ht7407na')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'asus-socpackage-52286.exe::https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/52286/SOCPackage_forWebSite_Qualcomm_Z_V1.309.4500.0_52286.exe'
)
noextract=('asus-socpackage-52286.exe')
sha256sums=('379ff10e604bd5c31c0c649ba473a7b7553ff8c3c351ba1b3cb7ee4b94da13fc')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'asus-socpackage-52286.exe' 'asus-socpackage-52286' 7z-appended
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'asus-socpackage-52286/QualcommBSP/qcsubsys_ext_adsp8480/adsp_dtbs.elf' "$fw"/'qcom/glymur/ASUSTeK/HT7407NA/adsp_dtbs.elf'
  install -Dm644 'asus-socpackage-52286/QualcommBSP/qcsubsys_ext_adsp8480/adspr.jsn' "$fw"/'qcom/glymur/ASUSTeK/HT7407NA/adspr.jsn'
  install -Dm644 'asus-socpackage-52286/QualcommBSP/qcsubsys_ext_adsp8480/adsps.jsn' "$fw"/'qcom/glymur/ASUSTeK/HT7407NA/adsps.jsn'
  install -Dm644 'asus-socpackage-52286/QualcommBSP/qcsubsys_ext_adsp8480/adspua.jsn' "$fw"/'qcom/glymur/ASUSTeK/HT7407NA/adspua.jsn'
  install -Dm644 'asus-socpackage-52286/QualcommBSP/qcnspmcdm8480/cdsp_dtbs.elf' "$fw"/'qcom/glymur/ASUSTeK/HT7407NA/cdsp_dtbs.elf'
  install -Dm644 'asus-socpackage-52286/QualcommBSP/qcsubsys_ext_adsp8480/qcadsp8480.mbn' "$fw"/'qcom/glymur/ASUSTeK/HT7407NA/qcadsp8480.mbn'
  install -Dm644 'asus-socpackage-52286/QualcommBSP/qcnspmcdm8480/qccdsp8480.mbn' "$fw"/'qcom/glymur/ASUSTeK/HT7407NA/qccdsp8480.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
b7a7dcc40fcb50f7a18b26cc452014bd3a54e2d15eb6abfe5c9e7a7b1058c334  qcom/glymur/ASUSTeK/HT7407NA/adsp_dtbs.elf
e9ba7199626b0c03f2ec02822d744f678ad567fe0625a28fe5f5908b7281e9db  qcom/glymur/ASUSTeK/HT7407NA/adspr.jsn
19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e  qcom/glymur/ASUSTeK/HT7407NA/adsps.jsn
d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d  qcom/glymur/ASUSTeK/HT7407NA/adspua.jsn
9bee104a48d4aac647287d6c1454df170c1cff7158a2352711fd1e2163ea6d1d  qcom/glymur/ASUSTeK/HT7407NA/cdsp_dtbs.elf
ef5acd11cbd5127594980e0c1b566f30d74853f26c6d00f1b1f0a511b8d3941a  qcom/glymur/ASUSTeK/HT7407NA/qcadsp8480.mbn
acf13d29288d283793f418a36650e8a261eed927d30de109a59cb2210f458794  qcom/glymur/ASUSTeK/HT7407NA/qccdsp8480.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +
}
