# Maintainer: Caleb Maclennan <caleb@alerque.com>
# Maintainer: Hyacinthe Cartiaux <hyacinthe@archlinux.org>
#
# Arch's btop, built for aarch64 with GPU support. btop's Makefile enables GPU
# support only on x86_64 Linux, so Arch Linux ARM's btop shows no GPU, though
# its NVIDIA (NVML) and AMD (ROCm SMI) collectors are loaded at run time and
# work on aarch64 (NVIDIA N1x). The Linux GPU code always links the Intel
# collector, so INTEL_GPU_SUPPORT must be on too; btop's CMake build already
# enables both on every Linux architecture. LTO stays off, as in Arch Linux
# ARM's recipe.
# Bumped by hand, like aquamarine: the pkgrel suffix must outrank Arch Linux
# ARM's build of the same version, which an upstream watch would reset to 1.
# Drop the carry once btop's Makefile enables GPU support on aarch64
# (aristocratos/btop#1937).

pkgname=btop
pkgver=1.4.8
pkgrel=1.1
pkgdesc='A monitor of system resources, bpytop ported to C++'
arch=(aarch64)
url="https://github.com/aristocratos/$pkgname"
license=(Apache-2.0)
depends=(glibc
         hicolor-icon-theme
         libgcc
         libstdc++)
makedepends=(lowdown)
_archive="$pkgname-$pkgver"
source=("$url/archive/v$pkgver/$_archive.tar.gz")
sha256sums=('67e07c21b770a6d884c5e50ba1d2cfc90732ea57459367d8732ec7ecbeb3be5f')

build() {
	cd "$_archive"
	sed -i 's/-flto\S*//' Makefile
	make all GPU_SUPPORT=true INTEL_GPU_SUPPORT=true
}

package() {
	cd "$_archive"
	make DESTDIR="$pkgdir" PREFIX=/usr install
	make DESTDIR="$pkgdir" PREFIX=/usr setcap
}
