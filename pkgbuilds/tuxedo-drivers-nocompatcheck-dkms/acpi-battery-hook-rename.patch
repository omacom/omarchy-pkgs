From: rand0mdud3 <rand0mdud31@gmail.com>
Subject: tuxedo-drivers: follow the ACPI battery hook API rename

Jordan Brough's applesmc charge-threshold series renames the ACPI battery
hook API (battery_hook_* -> acpi_battery_hook_*, devm_battery_hook_register
-> devm_acpi_battery_hook_register; see "[PATCH v3 1/3] ACPI: battery:
add acpi_ prefix to the battery hook API"). Update the four call sites in
the clevo/uniwill keyboard drivers. Needed once linux-omarchy carries
the rename; do not merge before the kernel side lands.

--- a/src/clevo_keyboard.h	2026-10-09 18:30:50.625614027 -0700
+++ b/src/clevo_keyboard.h	2026-10-09 18:30:50.629427210 -0700
@@ -965,13 +965,13 @@
 
 static void clevo_flexicharger_init(void)
 {
-	battery_hook_register(&battery_hook);
+	acpi_battery_hook_register(&battery_hook);
 }
 
 static void clevo_flexicharger_remove(void)
 {
 	if (charge_control_registered)
-		battery_hook_unregister(&battery_hook);
+		acpi_battery_hook_unregister(&battery_hook);
 }
 
 static void clevo_keyboard_init(void)
--- a/src/uniwill_keyboard.h	2026-10-09 18:30:50.626392395 -0700
+++ b/src/uniwill_keyboard.h	2026-10-09 18:30:50.630003214 -0700
@@ -1289,14 +1289,14 @@
 
 static void uw_battery_init(void)
 {
-	battery_hook_register(&uw_battery_hook);
+	acpi_battery_hook_register(&uw_battery_hook);
 	uw_battery_hook_registered = true;
 }
 
 static void uw_battery_uninit(void)
 {
 	if (uw_battery_hook_registered)
-		battery_hook_unregister(&uw_battery_hook);
+		acpi_battery_hook_unregister(&uw_battery_hook);
 	else
 		TUXEDO_ERROR("attempted to unregister battery hook which was not registered\n");
 }
