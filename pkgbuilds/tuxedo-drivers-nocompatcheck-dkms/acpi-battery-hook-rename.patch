Subject: tuxedo-drivers: build against both battery hook API names

linux-omarchy carries 0803-acpi-battery-hook-api-acpi-prefix.patch, which
renames battery_hook_(un)register to acpi_battery_hook_(un)register. Stock
Arch kernels (linux, linux-lts) keep the old names. Pick the name from the
target kernel's headers so the module builds against either.

--- a/src/Kbuild
+++ b/src/Kbuild
@@ -1,3 +1,11 @@
+# linux-omarchy renames battery_hook_(un)register to the acpi_ prefix while
+# stock kernels keep the old names. Detect the API from the target headers;
+# a version check cannot see a carried patch.
+ifneq ($(shell grep -w acpi_battery_hook_register $(srctree)/include/acpi/battery.h),)
+ccflags-y += -Dbattery_hook_register=acpi_battery_hook_register
+ccflags-y += -Dbattery_hook_unregister=acpi_battery_hook_unregister
+endif
+
 obj-m += clevo_acpi.o
 obj-m += clevo_wmi.o
 obj-m += tuxedo_keyboard.o
