# Maintainer: Matt Wolfgang <mattwolfgang@gmail.com>

pkgname=talkback
pkgver=0.2.0
pkgrel=1
pkgdesc='Pick the Piper or Kokoro voice that reads coding agent replies aloud, and switch spoken replies and dictation'
# piper-tts is x86_64 only: onnxruntime isn't packaged for aarch64.
arch=('x86_64')
url='https://github.com/mattwolfgang/talkback'
license=('MIT')
options=('!debug')
depends=(
  'alsa-utils'
  'curl'
  'hicolor-icon-theme'
  'jq'
  'libnotify'
  'piper-tts'
  'python'
  'python-numpy'
  'python-onnxruntime'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
)
optdepends=('voxtype-bin: dictation switch')
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('eccfb061ad21b539d4c11d2168e50782722f227ed98c16e7e6f474e8e213be26')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/test
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/talkback "$pkgdir/usr/bin/talkback"
  install -Dm755 -t "$pkgdir/usr/bin" \
    bin/talkback-speak bin/talkback-speech-text bin/talkback-kokoro bin/talkback-kokoro-setup
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/talkback.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/talkback.svg"
  install -Dm644 pkgbuild/talkback.desktop "$pkgdir/usr/share/applications/talkback.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
