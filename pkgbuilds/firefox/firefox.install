# pacman updates this build, so Mozilla's updater is turned off. Written, not
# packaged: Omarchy installs its own policies.json here and a packaged one collides.
_policies=/usr/lib/firefox/distribution/policies.json
_ours='{"policies":{"DisableAppUpdate":true}}'

post_install() {
  [[ -e $_policies ]] || install -Dm644 /dev/stdin "$_policies" <<<"$_ours"
}

post_upgrade() {
  post_install
}

post_remove() {
  if [[ -f $_policies && $(<"$_policies") == "$_ours" ]]; then
    rm -f "$_policies"
    rmdir --ignore-fail-on-non-empty "${_policies%/*}" /usr/lib/firefox 2>/dev/null || true
  fi
}
