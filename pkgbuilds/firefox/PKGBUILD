# Mozilla's own build, laid out where Arch's package puts it. It needs only
# glibc 2.17 and bundles NSS, so one file runs on every channel's snapshot.

pkgname=firefox
pkgver=161.0
# Above Arch's 160.0.1-1, so a machine that took Arch's build moves to this one
pkgrel=1
pkgdesc="Fast, Private & Safe Web Browser"
arch=(x86_64 aarch64)
url="https://www.mozilla.org/firefox/"
license=(MPL-2.0)
depends=(
  alsa-lib
  at-spi2-core
  cairo
  dbus
  ffmpeg
  fontconfig
  freetype2
  gdk-pixbuf2
  glib2
  glibc
  gtk3
  hicolor-icon-theme
  libgcc
  libpulse
  libstdc++
  libx11
  libxcb
  libxcomposite
  libxcursor
  libxdamage
  libxext
  libxfixes
  libxi
  libxrandr
  libxrender
  mime-types
  nss
  pango
  ttf-font
)
optdepends=(
  'firefox-i18n: Localizations'
  'hunspell-dictionary: Spell checking'
  'libnotify: Notification integration'
  'networkmanager: Location detection via available WiFi networks'
  'speech-dispatcher: Text-to-Speech'
  'xdg-desktop-portal: Screensharing with Wayland'
)
options=(!strip !debug)
install=firefox.install
_archive="https://archive.mozilla.org/pub/firefox/releases/$pkgver"
source=(
  firefox.desktop
  firefox-symbolic.svg
  org.mozilla.firefox.metainfo.xml
)
source_x86_64=(
  "firefox-$pkgver-x86_64.tar.xz::$_archive/linux-x86_64/en-US/firefox-$pkgver.tar.xz"
  "firefox-$pkgver-x86_64.tar.xz.asc::$_archive/linux-x86_64/en-US/firefox-$pkgver.tar.xz.asc"
)
source_aarch64=(
  "firefox-$pkgver-aarch64.tar.xz::$_archive/linux-aarch64/en-US/firefox-$pkgver.tar.xz"
  "firefox-$pkgver-aarch64.tar.xz.asc::$_archive/linux-aarch64/en-US/firefox-$pkgver.tar.xz.asc"
)
noextract=("firefox-$pkgver-$CARCH.tar.xz")
validpgpkeys=(
  # Mozilla Software Releases <release@mozilla.com>
  14F26682D0916CDD81E37B6D61B7B526D98F0353
)
sha256sums=('2a51d57d98fbda86f094bc991e1ad4dd6e8a9d32fd0836b1183bf70ec4b68915'
            'cb00ea359d6daf37900102307be4f515f1b7ef9c98825c64cc55bb562449d0d8'
            '4e01a62e20026b67466943bad9dfba47874c5e1492375f8293aeb85ecedf2288')
sha256sums_x86_64=('3e9b1e5132d7b53b1ad968c7300281e90e6a0ef57d0656b1516202d686d25733' 'SKIP')
sha256sums_aarch64=('b3c2992292efc4a2f7ab6abe2de0ba6e15a482d41813e469c255a2528cacf10a' 'SKIP')

package() {
  local appdir="$pkgdir/usr/lib/firefox" size

  install -d "$pkgdir/usr/lib"
  bsdtar --no-same-owner -xf "firefox-$pkgver-$CARCH.tar.xz" -C "$pkgdir/usr/lib"

  # As Arch's build has it, so a profile made by one opens in the other
  touch "$appdir/is-packaged-app"

  install -Dm644 /dev/stdin "$appdir/browser/defaults/preferences/vendor.js" <<END
// Use LANG environment variable to choose locale
pref("intl.locale.requested", "");

// Use system-provided dictionaries
pref("spellchecker.dictionary_path", "/usr/share/hunspell");

// Disable default browser checking.
pref("browser.shell.checkDefaultBrowser", false);

// Don't disable extensions in the application directory
pref("extensions.autoDisableScopes", 11);
END

  # The system trust store in place of the built-in roots, as Arch's build has it
  ln -s ../libnssckbi.so "$appdir/libnssckbi.so"

  for size in 16 32 48 64 128; do
    install -Dm644 "$appdir/browser/chrome/icons/default/default$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/firefox.png"
  done
  install -Dm644 firefox-symbolic.svg -t "$pkgdir/usr/share/icons/hicolor/symbolic/apps"
  install -Dm644 firefox.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 org.mozilla.firefox.metainfo.xml -t "$pkgdir/usr/share/metainfo"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/firefox" <<END
#!/bin/sh
exec /usr/lib/firefox/firefox "\$@"
END
}
