# Maintainer: Stably AI <https://github.com/stablyai/orca>
#
# Repackages Orca's official .deb. It already carries the .desktop file (with the orca:// sign-in
# scheme), the icons, and a package-type marker that keeps the in-app updater out of pacman's way.

pkgname=stably-orca-bin
_pkgname=orca-ide
pkgver=1.4.265
pkgrel=1
pkgdesc='Orca, an IDE for running a fleet of parallel coding agents'
arch=('x86_64' 'aarch64')
url='https://github.com/stablyai/orca'
license=('MIT')
# What the Electron binary links, libsecret for the keyring, libnotify for notifications, and
# xdg-open for sign-in and links.
depends=('gtk3' 'nss' 'alsa-lib' 'libcups' 'mesa' 'libnotify' 'libsecret' 'libxss' 'libxtst' 'xdg-utils')
optdepends=(
	'python-gobject: computer use for agents'
	'xdotool: computer use in X11 apps'
)
provides=('stably-orca' "${_pkgname}")
conflicts=('stably-orca' "${_pkgname}")
options=('!strip' '!debug')
_url="${url}/releases/download/v${pkgver}/${_pkgname}_${pkgver}"
# Saved under the pacman architecture name, so package() finds the right one by $CARCH.
source_x86_64=("${_pkgname}-${pkgver}-x86_64.deb::${_url}_amd64.deb")
source_aarch64=("${_pkgname}-${pkgver}-aarch64.deb::${_url}_arm64.deb")
noextract=("${_pkgname}-${pkgver}-x86_64.deb" "${_pkgname}-${pkgver}-aarch64.deb")
sha256sums_x86_64=('2cd80d1104b56485868957c9f23a636ea31ef309cf2abf833f71cded857a0398')
sha256sums_aarch64=('d05a185bb6ab215246c0abf07c42de3dae4750ae48f94014b4955a23673cc323')

package() {
	bsdtar -xOf "${_pkgname}-${pkgver}-${CARCH}.deb" 'data.tar.*' | bsdtar --no-same-owner -xf - -C "${pkgdir}"
	rm -rf "${pkgdir}/usr/share/doc"

	# The deb's install script makes this link, and pacman does not run it. It is the shim, not the
	# Electron binary, so `orca-ide` works as Orca's CLI as well as its launcher.
	install -dm755 "${pkgdir}/usr/bin"
	ln -s "/opt/Orca/resources/bin/${_pkgname}" "${pkgdir}/usr/bin/${_pkgname}"

	install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}"
	# Not `license`: makepkg reads that array after package() returns.
	for file in LICENSE.electron.txt LICENSES.chromium.html; do
		ln -s "/opt/Orca/${file}" "${pkgdir}/usr/share/licenses/${pkgname}/${file}"
	done
}
