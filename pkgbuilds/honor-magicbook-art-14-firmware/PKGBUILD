# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'honor-graphics-31.0.105.0.zip' 'honor-graphics-31.0.105.0' 7z
  _unpack 'honor-audio-1.0.4047.7214.zip' 'honor-audio-1.0.4047.7214' 7z
  _unpack 'honor-audio-1.0.4047.7214/Software/HONOR MagicBook Art 14 Snapdragon_Audio_1.0.4047.7214.zip' 'honor-audio-1.0.4047.7214/Software/HONOR MagicBook Art 14 Snapdragon_Audio_1.0.4047.7214.zip__x' 7z
  _unpack 'honor-audio-1.0.4047.7214/Software/HONOR MagicBook Art 14 Snapdragon_Audio_1.0.4047.7214.zip__x/Audio_1.0.4047.7214.exe' 'honor-audio-1.0.4047.7214/Software/HONOR MagicBook Art 14 Snapdragon_Audio_1.0.4047.7214.zip__x/Audio_1.0.4047.7214.exe__x' 7z
  _unpack 'honor-audio-1.0.4047.7214/Software/HONOR MagicBook Art 14 Snapdragon_Audio_1.0.4047.7214.zip__x/Audio_1.0.4047.7214.exe__x/Audio_1.0.4047.7214.exe' 'honor-audio-1.0.4047.7214/Software/HONOR MagicBook Art 14 Snapdragon_Audio_1.0.4047.7214.zip__x/Audio_1.0.4047.7214.exe__x/Audio_1.0.4047.7214.exe__x' 7z
  _unpack 'honor-graphics-31.0.105.0/Software/MagicBook Art 14_Graphics_31.0.105.0.zip' 'honor-graphics-31.0.105.0/Software/MagicBook Art 14_Graphics_31.0.105.0.zip__x' 7z
  _unpack 'honor-graphics-31.0.105.0/Software/MagicBook Art 14_Graphics_31.0.105.0.zip__x/Graphics_31.0.105.0.exe' 'honor-graphics-31.0.105.0/Software/MagicBook Art 14_Graphics_31.0.105.0.zip__x/Graphics_31.0.105.0.exe__x' 7z
  _unpack 'honor-graphics-31.0.105.0/Software/MagicBook Art 14_Graphics_31.0.105.0.zip__x/Graphics_31.0.105.0.exe__x/Graphics_31.0.105.0.exe' 'honor-graphics-31.0.105.0/Software/MagicBook Art 14_Graphics_31.0.105.0.zip__x/Graphics_31.0.105.0.exe__x/Graphics_31.0.105.0.exe__x' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'honor-audio-1.0.4047.7214/Software/HONOR MagicBook Art 14 Snapdragon_Audio_1.0.4047.7214.zip__x/Audio_1.0.4047.7214.exe__x/Audio_1.0.4047.7214.exe__x/qcsubsys_ext_adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1e80100/HONOR/MRO-XXX/adsp_dtbs.elf'
  install -Dm644 'honor-audio-1.0.4047.7214/Software/HONOR MagicBook Art 14 Snapdragon_Audio_1.0.4047.7214.zip__x/Audio_1.0.4047.7214.exe__x/Audio_1.0.4047.7214.exe__x/qcsubsys_ext_adsp8380/qcadsp8380.mbn' "$fw"/'qcom/x1e80100/HONOR/MRO-XXX/qcadsp8380.mbn'
  install -Dm644 'honor-graphics-31.0.105.0/Software/MagicBook Art 14_Graphics_31.0.105.0.zip__x/Graphics_31.0.105.0.exe__x/Graphics_31.0.105.0.exe__x/qcdx8380/qcdxkmsuc8380.mbn' "$fw"/'qcom/x1e80100/HONOR/MRO-XXX/qcdxkmsuc8380.mbn'
  install -Dm644 'honor-graphics-31.0.105.0/Software/MagicBook Art 14_Graphics_31.0.105.0.zip__x/Graphics_31.0.105.0.exe__x/Graphics_31.0.105.0.exe__x/qcdx8380/qcvss8380.mbn' "$fw"/'qcom/x1e80100/HONOR/MRO-XXX/qcvss8380.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
50f69be96f44e735daee31432e0d6d5455d943b440de0f16386bdeb3c6391320  qcom/x1e80100/HONOR/MRO-XXX/adsp_dtbs.elf
544fc0a4ade82c207c450c42f1baa70864ce46aaa2425979a0bff6974af74994  qcom/x1e80100/HONOR/MRO-XXX/qcadsp8380.mbn
255d848d194d825b21413fbb02e87cb45c2557d1e7de2d5ce15c77eb5c659bdc  qcom/x1e80100/HONOR/MRO-XXX/qcdxkmsuc8380.mbn
e00a8cda55661446425169d8286c9f00ad66f610b7376f6fb8165f6e1c93b24a  qcom/x1e80100/HONOR/MRO-XXX/qcvss8380.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +
}
