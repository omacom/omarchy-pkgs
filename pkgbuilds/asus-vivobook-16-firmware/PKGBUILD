# Audio DSP, compute DSP and GPU firmware for the ASUS Vivobook 16. The firmware only runs if it
# is signed for this board by ASUS, so linux-firmware cannot carry it until the OEM submits it.
# The OEM ships it in its Windows driver download, which this recipe unpacks without running. Each
# file is checked against the SHA-256 it was matched to and installed under the name the device
# tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so once
# linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=asus-vivobook-16-firmware
pkgver=20261106
pkgrel=1
pkgdesc='Audio DSP, compute DSP and GPU firmware for the ASUS Vivobook 16'
arch=('aarch64')
url='https://www.asus.com/laptops/for-home/vivobook/asus-vivobook-16-x1607q/helpdesk_download/?model2Name=X1607QA'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x126100-asustek-vivobook-16')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'asus-socpackage-50068.exe::https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/50068/SOCPackage_forWebSite_Qualcomm_Z_V1.314.8800.0_50068.exe'
)
noextract=('asus-socpackage-50068.exe')
sha256sums=('a7a6545923122b71cedb7fefed0131cb6e67a4e0cfd93d7c45df74fcea6fc063')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'asus-socpackage-50068.exe' 'asus-socpackage-50068' 7z-appended
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'asus-socpackage-50068/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x126100/ASUSTeK/vivobook-16/adsp_dtbs.elf'
  install -Dm644 'asus-socpackage-50068/QualcommBSP/NPU/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x126100/ASUSTeK/vivobook-16/cdsp_dtbs.elf'
  install -Dm644 'asus-socpackage-50068/QualcommBSP/Subsystem/qcsubsys_ext_adsp8380/qcadsp8380.mbn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-16/qcadsp8380.mbn'
  install -Dm644 'asus-socpackage-50068/QualcommBSP/NPU/qcnspmcdm_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-16/qccdsp8380.mbn'
  install -Dm644 'asus-socpackage-50068/QualcommBSP/GFX/qcdx8380/qcdxkmsucpurwa.mbn' "$fw"/'qcom/x126100/ASUSTeK/vivobook-16/qcdxkmsucpurwa.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
4efd01feefccc344874cc8d4d3600231310d228216fa16a8740ac5fcc5357ced  qcom/x126100/ASUSTeK/vivobook-16/adsp_dtbs.elf
d2e81a2430ec9474aa46558a9568262b7fde3ae31bdc523028306454fb11d3b0  qcom/x126100/ASUSTeK/vivobook-16/cdsp_dtbs.elf
5799e03a04e0f66dfec6a6230abd13dc742e6bb347d509e86d826382749c2b8b  qcom/x126100/ASUSTeK/vivobook-16/qcadsp8380.mbn
e7f15a411d59f0aa91cadf3dec0366cd916af240c956731577c53a40d8343e64  qcom/x126100/ASUSTeK/vivobook-16/qccdsp8380.mbn
5b8b1ea1de11b9acc74fdd4919aa4aeac924520e4b11cf27782c593640e11e44  qcom/x126100/ASUSTeK/vivobook-16/qcdxkmsucpurwa.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +
}
