# Maintainer: Christophe Vanlancker <carroarmato0@gmail.com>

pkgname=vitals
pkgver=0.3.1
pkgrel=1
pkgdesc='A system monitor for Omarchy that shows apps, not just processes'
arch=('x86_64' 'aarch64')
url='https://github.com/carroarmato0/vitals'
license=('MIT')
install='vitals.install'
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
  'systemd'
)
makedepends=(
  'gcc'
  'make'
  'qt6-base'
  'qt6-declarative'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('5a38984f4ddccabbafe9e4cc7c45796920699a9b969d5c89173af3931d05079b')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/test
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/vitals "$pkgdir/usr/bin/vitals"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/vitals.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/vitals.svg"
  install -Dm644 pkgbuild/vitals.desktop "$pkgdir/usr/share/applications/vitals.desktop"
  install -Dm644 src/skill.md "$pkgdir/usr/share/vitals/skills/vitals/SKILL.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
