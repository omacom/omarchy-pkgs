#!/bin/bash -p
# Privileged startup must ignore BASH_ENV and exported functions before any command.
set -euo pipefail

[[ $- == *p* ]] || { echo 'Refusing an unsafe Bash startup.' >&2; exit 126; }
(( $# == 0 )) || exit 2
/usr/bin/omarchy-hw-aarch64-raspberrypi || { echo 'This operation needs a Pi 4 Model B.' >&2; exit 1; }
exec /usr/bin/python -I /usr/lib/omarchy/pi/check.py --verify
