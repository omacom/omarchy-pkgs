#!/bin/bash

# omarchy:group=cmd
# omarchy:name=pi-run
# omarchy:summary=Run an agent or build with Pi-friendly CPU and memory limits
# omarchy:args=[--plan] -- <command> [args...]
# omarchy:examples=omarchy-pi-run -- make | omarchy-pi-run --plan -- bash

set -euo pipefail
plan=0
if [[ ${1:-} == "--plan" ]]; then
  plan=1
  shift
fi
[[ ${1:-} != "--" ]] || shift
if (( $# == 0 )); then
  echo "Usage: omarchy-pi-run [--plan] -- <command> [args...]" >&2
  exit 2
fi
omarchy-hw-aarch64-raspberrypi || { echo "This helper is designed for Raspberry Pi." >&2; exit 1; }

source /usr/lib/omarchy/pi/build-budget.sh
cores=$(nproc)
quota=$(( (cores > 1 ? cores - 1 : 1) * 100 ))

# Scope mode preserves the caller's terminal, directory, environment, and exact
# argv. Limits apply to this workload and its children, not the whole desktop.
command=(systemd-run --user --scope --slice=app.slice --quiet --expand-environment=no
  -p "CPUQuota=$quota%" -p CPUWeight=50 -p IOWeight=50
  -p MemoryHigh=50% -p MemoryMax=65%
  -- env "MAKEFLAGS=$MAKEFLAGS" "CARGO_BUILD_JOBS=$CARGO_BUILD_JOBS" "CMAKE_BUILD_PARALLEL_LEVEL=$CMAKE_BUILD_PARALLEL_LEVEL"
  nice -n 5 "$@")
if (( plan )); then
  printf '%q ' "${command[@]}"
  printf '\n'
else
  # Fail rather than silently running unrestricted if the user manager cannot
  # create the scope. MemoryMax can OOM-kill this job; save work accordingly.
  exec "${command[@]}"
fi
