# Maintainer: Preetham Kyanam <37784174+pkyanam@users.noreply.github.com>
pkgbase=raspberrypi-4-support
pkgname=(raspberrypi-4-support raspberrypi-4-desktop)
pkgver=1
pkgrel=3
pkgdesc='Raspberry Pi 4 checks and build limits for the Omarchy aarch64 installer'
arch=('aarch64')
url='https://github.com/omacom/omarchy-pkgs'
license=('MIT')
depends=('bash' 'coreutils' 'gawk' 'grep' 'python' 'systemd' 'util-linux'
         'linux-omarchy' 'linux-omarchy-pi4=1' 'mesa' 'vulkan-broadcom' 'linux-firmware-broadcom' 'firmware-raspberrypi' 'wireless-regdb')
options=('!debug')
source=('omarchy-pi-check' 'omarchy-pi-run' 'check.py' 'build-budget.sh'
        'setup-system' 'update-prepare' 'update-verify' 'raspberrypi.conf'
        'README.package.md' 'LICENSE' '60-omarchy-pi4-ddc.rules')
sha256sums=(
