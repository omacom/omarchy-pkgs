package_raspberrypi-4-support() {
  install -Dm755 -t "$pkgdir/usr/bin" omarchy-pi-check omarchy-pi-run
  install -Dm755 -t "$pkgdir/usr/lib/omarchy/pi" setup-system update-prepare update-verify
  install -Dm644 -t "$pkgdir/usr/lib/omarchy/pi" check.py build-budget.sh
  install -Dm644 60-omarchy-pi4-ddc.rules "$pkgdir/usr/lib/udev/rules.d/60-omarchy-pi4-ddc.rules"
  install -Dm644 raspberrypi.conf "$pkgdir/etc/mkinitcpio.conf.d/omarchy-pi.conf"
  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgbase/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgbase/LICENSE"
  # Omarchy's router discovers packaged commands beside its own symlinks.
  install -d "$pkgdir/usr/share/omarchy/bin"
  ln -s /usr/bin/omarchy-pi-check "$pkgdir/usr/share/omarchy/bin/omarchy-pi-check"
  ln -s /usr/bin/omarchy-pi-run "$pkgdir/usr/share/omarchy/bin/omarchy-pi-run"
}

# The live installer needs the checks without a desktop. Installed Pi systems
# also retain the runtime contract, so a future package cannot erase it.
package_raspberrypi-4-desktop() {
  pkgdesc='Package compatibility contract for an installed Omarchy Pi 4 desktop'
  depends=("raspberrypi-4-support=$pkgver-$pkgrel" 'omarchy-pi-runtime=1')
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/raspberrypi-4-desktop/LICENSE"
}
