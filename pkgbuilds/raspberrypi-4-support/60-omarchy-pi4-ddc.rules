# BCM2711 HDMI DDC only: the usual PCI display-class rule cannot match these
# platform controllers. Keep this before 73-seat-late.rules so logind grants
# access to the active local user, without opening unrelated I2C buses.
SUBSYSTEM=="i2c-dev", KERNEL=="i2c-*", SUBSYSTEMS=="platform", DRIVERS=="brcmstb-i2c", KERNELS=="fef04500.i2c", TAG+="uaccess"
SUBSYSTEM=="i2c-dev", KERNEL=="i2c-*", SUBSYSTEMS=="platform", DRIVERS=="brcmstb-i2c", KERNELS=="fef09500.i2c", TAG+="uaccess"
