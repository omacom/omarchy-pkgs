From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Netmojo Systems <56850867+netmojo@users.noreply.github.com>
Date: Tue, 27 Oct 2026 09:00:00 -0600
Subject: [PATCH 15/16] wifi: brcmfmac: build against 7.1 and 7.2 headers

Linux 7.2 adds rx_addr to cfg80211's remain_on_channel op. The vendored
tree follows 7.2, so without this it builds only against 7.2 headers, and
a machine still on a 7.1 kernel would lose its DKMS module. Take rx_addr
only from 7.2 on. brcmfmac ignores it either way.

Out of tree only: upstream builds against its own headers.
---
 drivers/net/wireless/broadcom/brcm80211/brcmfmac/p2p.c | 8 ++++++--
 drivers/net/wireless/broadcom/brcm80211/brcmfmac/p2p.h | 8 ++++++--
 2 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/p2p.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/p2p.c
index d15f543..5102824 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/p2p.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/p2p.c
@@ -2,6 +2,7 @@
 /*
  * Copyright (c) 2012 Broadcom Corporation
  */
+#include <linux/version.h>
 #include <linux/slab.h>
 #include <linux/netdevice.h>
 #include <linux/etherdevice.h>
@@ -974,8 +975,11 @@ exit:
  */
 int brcmf_p2p_remain_on_channel(struct wiphy *wiphy, struct wireless_dev *wdev,
 				struct ieee80211_channel *channel,
-				unsigned int duration, u64 *cookie,
-				const u8 *rx_addr)
+				unsigned int duration, u64 *cookie
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0)
+				, const u8 *rx_addr
+#endif
+				)
 {
 	struct brcmf_cfg80211_info *cfg = wiphy_to_cfg(wiphy);
 	struct brcmf_p2p_info *p2p = &cfg->p2p;
diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/p2p.h b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/p2p.h
index 9f3f01a..3b29c4a 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/p2p.h
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/p2p.h
@@ -5,6 +5,7 @@
 #ifndef WL_CFGP2P_H_
 #define WL_CFGP2P_H_
 
+#include <linux/version.h>
 #include <net/cfg80211.h>
 
 struct brcmf_cfg80211_info;
@@ -157,8 +158,11 @@ int brcmf_p2p_scan_prep(struct wiphy *wiphy,
 			struct brcmf_cfg80211_vif *vif);
 int brcmf_p2p_remain_on_channel(struct wiphy *wiphy, struct wireless_dev *wdev,
 				struct ieee80211_channel *channel,
-				unsigned int duration, u64 *cookie,
-				const u8 *rx_addr);
+				unsigned int duration, u64 *cookie
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0)
+				, const u8 *rx_addr
+#endif
+				);
 int brcmf_p2p_notify_listen_complete(struct brcmf_if *ifp,
 				     const struct brcmf_event_msg *e,
 				     void *data);
-- 
2.0

