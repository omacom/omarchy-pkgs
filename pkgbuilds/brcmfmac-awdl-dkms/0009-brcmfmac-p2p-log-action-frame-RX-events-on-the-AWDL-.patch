From dc8dfe2c7ba5e60b956bd2e9e3cc19da0ef16d7c Mon Sep 17 00:00:00 2001
From: Brent Kearney <1550934+brentkearney@users.noreply.github.com>
Date: Mon, 7 Sep 2026 13:13:05 -0600
Subject: [PATCH 09/11] brcmfmac: p2p: log action-frame RX events on the AWDL
 interface (probe)

Whether the firmware raises BRCMF_E_ACTION_FRAME_RX for the PSF/MIF frames
the AWDL module receives is unknown. A Mac's AirDrop advert is carried in
its MIF Service Response TLVs, never on the data path, so if these events
exist they are the route to discovering a Mac from Linux. Ratelimited
pr_info of source, chanspec, length, category/action/OUI/AWDL type and the
vif's mgmt_rx_reg, before the early return for unregistered frame types.
---
 .../broadcom/brcm80211/brcmfmac/p2p.c         | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/p2p.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/p2p.c
index 06d2933..4a04b78 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/p2p.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/p2p.c
@@ -1409,6 +1409,26 @@ int brcmf_p2p_notify_action_frame_rx(struct brcmf_if *ifp,
 
 	ch.chspec = be16_to_cpu(rxframe->chanspec);
 	cfg->d11inf.decchspec(&ch);
+	/* The firmware raises this event for the PSF/MIF action frames the
+	 * AWDL module receives. A Mac's AirDrop
+	 * advert lives in its MIF Service Response TLVs (Apple OUI 00:17:f2,
+	 * public action 9, AWDL type byte at +5: 0 PSF, 3 MIF); if these
+	 * arrive here, the browse becomes a TLV lookup instead of mDNS.
+	 */
+	if (ifp->is_awdl) {
+		static DEFINE_RATELIMIT_STATE(awdl_af_rs, HZ, 10);
+
+		if (__ratelimit(&awdl_af_rs))
+			pr_info("brcmfmac: awdl af rx from %pM chanspec=0x%04x len=%u cat=%u act=%u oui=%02x%02x%02x type=%u reg=%04x\n",
+				e->addr, ch.chspec, mgmt_frame_len,
+				mgmt_frame_len > 0 ? frame[0] : 0,
+				mgmt_frame_len > 1 ? frame[1] : 0,
+				mgmt_frame_len > 2 ? frame[2] : 0,
+				mgmt_frame_len > 3 ? frame[3] : 0,
+				mgmt_frame_len > 4 ? frame[4] : 0,
+				mgmt_frame_len > 5 ? frame[5] : 0,
+				ifp->vif ? ifp->vif->mgmt_rx_reg : 0);
+	}
 	/* Check if wpa_supplicant has registered for this frame */
 	brcmf_dbg(INFO, "ifp->vif->mgmt_rx_reg %04x\n", ifp->vif->mgmt_rx_reg);
 	mgmt_type = (IEEE80211_STYPE_ACTION & IEEE80211_FCTL_STYPE) >> 4;
-- 
