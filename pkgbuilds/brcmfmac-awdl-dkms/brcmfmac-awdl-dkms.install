post_install() {
  # NetworkManager reads conf.d only at startup or on a reload, so the
  # unmanaged setting for awdl0 this package installs is not in force on a
  # running system until something rereads it (issue 15). `reload conf` touches
  # no connection. systemctl answers "inactive" in a chroot, which skips it.
  if systemctl is-active --quiet NetworkManager 2>/dev/null; then
    nmcli general reload conf >/dev/null 2>&1 \
      || echo "  Could not reload NetworkManager's configuration. Run: sudo nmcli general reload conf"
  fi
  cat <<'MSG'
  This package replaces the in-tree brcmfmac through DKMS, and rebuilds itself
  on every kernel install. The running kernel still has the module it booted
  with, so finish with one of:

      reboot
      modprobe -r brcmfmac_wcc brcmfmac brcmutil && modprobe brcmfmac

  The second takes the Wi-Fi link down for about fifteen seconds, and 5 GHz may
  need a manual Wi-Fi off/on afterwards: a freshly created wiphy comes back in
  the world regulatory domain, where 5 GHz cannot transmit until a beacon has
  been heard.

  Nothing advertises until something asks. The interface is the omdrop plugin:

      omarchy plugin add https://github.com/netmojo-systems/omdrop-plugin.git
      omarchy plugin enable netmojo.omdrop

  Then turn Omdrop on from its icon in the bar. The first time, it finishes
  setting up and puts the omdrop command on your PATH.

  To have the first window after a boot open in seconds rather than about a
  minute, enable the boot-time warm-up. It creates awdl0 and turns AWDL on at
  boot, but advertises nothing until a window opens:

      sudo systemctl enable awdl-warmup.service
MSG
}

post_upgrade() {
  post_install
  # 0.10.4 to 0.10.6 enabled the warm-up through a vendor link, which this
  # upgrade removes.
  if [ "$(vercmp "$2" 0.10.4)" -ge 0 ] && [ "$(vercmp "$2" 0.10.7)" -lt 0 ]; then
    cat <<'MSG'

  The boot-time warm-up is no longer enabled by the package. To keep it:

      sudo systemctl enable awdl-warmup.service
MSG
  fi
}

post_remove() {
  cat <<'MSG'
  The in-tree brcmfmac takes over again on the next boot or module reload.
  AirDrop stops working; ordinary Wi-Fi is unaffected.
MSG
}
