# Maintainer: Tim Apple <tim@apples.email>

# Pure Python on top of the system PySide6, so the package is arch-independent.
# Upstream tags releases on GitHub without a checksum manifest; the git_tags
# provider in .omarchy/package.json follows those tags and hashes this tarball.

pkgname=omarchy-db
pkgver=0.1.0
pkgrel=1
pkgdesc='Simple desktop database for Omarchy, in the spirit of Microsoft Access (GUI, CLI and MCP server)'
arch=('any')
url='https://github.com/ninepointlabs/omarchy-db'
license=('MIT')
depends=('python' 'pyside6' 'hicolor-icon-theme')
optdepends=('python-openpyxl: Excel (.xlsx) import and export'
            'python-psycopg: PostgreSQL connections'
            'python-pymysql: MySQL and MariaDB connections')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-hatchling')
checkdepends=('desktop-file-utils')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('9fcb31e9f33982c7d6941e60cf04cb46b047e340b05232fb001a6dde9628f01e')

build() {
  cd "${pkgname}-${pkgver}"
  python -m build --wheel --no-isolation
}

check() {
  cd "${pkgname}-${pkgver}"
  desktop-file-validate packaging/omarchy-db.desktop
}

package() {
  cd "${pkgname}-${pkgver}"
  python -m installer --destdir="${pkgdir}" dist/*.whl

  # The desktop entry and icon live in the upstream tree; the wheel does not
  # carry them, so install them beside the console scripts it does provide.
  install -Dm644 packaging/omarchy-db.desktop "${pkgdir}/usr/share/applications/omarchy-db.desktop"
  install -Dm644 packaging/omarchy-db.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/omarchy-db.svg"

  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
