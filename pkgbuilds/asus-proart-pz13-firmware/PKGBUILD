# Maintainer: Birk Skyum <birk.skyum@pm.me>
#
# Audio DSP, compute DSP and GPU firmware for the ASUS ProArt PZ13. The firmware only runs if it
# is signed for this board by ASUS, so linux-firmware cannot carry it until the OEM submits it.
# The OEM ships it in its Windows driver download, which this recipe unpacks without running. The
# files are installed unmodified, under the names the device tree requests, and checked against
# the SHA-256 each was matched to.

pkgname=asus-proart-pz13-firmware
pkgver=20261102
pkgrel=1
pkgdesc='Audio DSP, compute DSP and GPU firmware for the ASUS ProArt PZ13'
arch=('aarch64')
url='https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/43841/SOCPackage_forWebSite_Qualcomm_Z_V1.311.7800.0_43841_1.exe'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1p42100-asustek-proart-pz13')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'asus-socpackage-43841.exe::https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/DriverPackage/43841/SOCPackage_forWebSite_Qualcomm_Z_V1.311.7800.0_43841_1.exe'
)
noextract=('asus-socpackage-43841.exe')
sha256sums=('25c191e84302979ab3510568e2616f9d7b5111a720e23457e86d7c044aa62d6d')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'asus-socpackage-43841.exe' 'asus-socpackage-43841' 7z-appended
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'asus-socpackage-43841/Driver/QualcommBSP/qcsubsys_ext_adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1p42100/ASUSTeK/proart-pz13/adsp_dtbs.elf'
  install -Dm644 'asus-socpackage-43841/Driver/QualcommBSP/qcsubsys_ext_adsp8380/adspr.jsn' "$fw"/'qcom/x1p42100/ASUSTeK/proart-pz13/adspr.jsn'
  install -Dm644 'asus-socpackage-43841/Driver/QualcommBSP/qcsubsys_ext_adsp8380/adsps.jsn' "$fw"/'qcom/x1p42100/ASUSTeK/proart-pz13/adsps.jsn'
  install -Dm644 'asus-socpackage-43841/Driver/QualcommBSP/qcsubsys_ext_adsp8380/adspua.jsn' "$fw"/'qcom/x1p42100/ASUSTeK/proart-pz13/adspua.jsn'
  install -Dm644 'asus-socpackage-43841/Driver/QualcommBSP/qcsubsys_ext_adsp8380/battmgr.jsn' "$fw"/'qcom/x1p42100/ASUSTeK/proart-pz13/battmgr.jsn'
  install -Dm644 'asus-socpackage-43841/Driver/QualcommBSP/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1p42100/ASUSTeK/proart-pz13/cdsp_dtbs.elf'
  install -Dm644 'asus-socpackage-43841/Driver/QualcommBSP/qcnspmcdm_ext_cdsp8380/cdspr.jsn' "$fw"/'qcom/x1p42100/ASUSTeK/proart-pz13/cdspr.jsn'
  install -Dm644 'asus-socpackage-43841/Driver/QualcommBSP/qcsubsys_ext_adsp8380/qcadsp8380.mbn' "$fw"/'qcom/x1p42100/ASUSTeK/proart-pz13/qcadsp8380.mbn'
  install -Dm644 'asus-socpackage-43841/Driver/QualcommBSP/qcnspmcdm_ext_cdsp8380/qccdsp8380.mbn' "$fw"/'qcom/x1p42100/ASUSTeK/proart-pz13/qccdsp8380.mbn'
  install -Dm644 'asus-socpackage-43841/Driver/QualcommBSP/qcdx8380/qcdxkmsucpurwa.mbn' "$fw"/'qcom/x1p42100/ASUSTeK/proart-pz13/qcdxkmsucpurwa.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
bb77120f5f6e545cc5387f8b41f950f00b8200be3e8b58240046489fe51328a7  qcom/x1p42100/ASUSTeK/proart-pz13/adsp_dtbs.elf
e9ba7199626b0c03f2ec02822d744f678ad567fe0625a28fe5f5908b7281e9db  qcom/x1p42100/ASUSTeK/proart-pz13/adspr.jsn
19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e  qcom/x1p42100/ASUSTeK/proart-pz13/adsps.jsn
d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d  qcom/x1p42100/ASUSTeK/proart-pz13/adspua.jsn
b8aad1d149128f414eb1fd6fcbb6e0a5b7dabcd2cba001599e1ce9a0e2e291a4  qcom/x1p42100/ASUSTeK/proart-pz13/battmgr.jsn
1e0535bd2a8adcd14d6079ffa99f6fce5c6561d4759a60f6076dcfbaa4437f8a  qcom/x1p42100/ASUSTeK/proart-pz13/cdsp_dtbs.elf
7e46c515ab1bb012768be6e961eca69b1c8aad9af1cbac886b3b5ae8d4228f64  qcom/x1p42100/ASUSTeK/proart-pz13/cdspr.jsn
c0dd5c1a6da54fb5f5bf0a1c4087423b68b80d19f45026cff53f79b3637be430  qcom/x1p42100/ASUSTeK/proart-pz13/qcadsp8380.mbn
4387fa1a234aacbff50f8a215b96536d17c4b25b6b798392e15a162e4adcd7a0  qcom/x1p42100/ASUSTeK/proart-pz13/qccdsp8380.mbn
f9342cb44a79f5abdd1f0ae888c6c3df8e60f28a6c3a5077591369268d1b5c0a  qcom/x1p42100/ASUSTeK/proart-pz13/qcdxkmsucpurwa.mbn
SUMS
  )
}
