# One guarded AOP and speaker-DAI module load per boot. The loader is fail-closed:
# it runs only on the exact model compatible, only when the running kernel release
# has a manifest at /usr/lib/aop-boot-guard/manifests/<release>/manifest.json pinning
# the sha256 of the stock aop.ko and snd-soc-t8152-aop-audio.ko for that release, and
# only when speakerguardd-k114 is installed at exactly 0.1.12-4. No manifests ship
# here; the kernel build or the machine owner drops them in, and the shipped
# /usr/share/doc/aop-boot-guard-k114/README.md documents the contract.

pkgname=aop-boot-guard-k114
pkgver=0.1.0
pkgrel=1
pkgdesc='One guarded AOP and speaker DAI module load per boot for the MacBook Pro 14-inch (M5 Max, K114)'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url="https://github.com/omacom/omarchy-pkgs"
license=('MIT')
depends=('python')
options=('!debug')
source=(
  'aop-boot-guard-load'
  'aop-boot-guard-wdt-run'
  'aop-boot-guard.service'
  'README.package.md'
)
sha256sums=('5c29ab138c2304c704f911924d693b7481a072faff312727cc80909551586bdf'
            'd4a3bf7cf1dabd936446d1ba37e5d878bcaf25bb59ef641941dc8542b47a3f74'
            'f8800ccb3361edad8926b38d61b7f4fa1362044b32b775dd0ba13d020d8b2dd8'
            '06959c544fd6ba68b4697be72024095988308404f36e8837e571ceb2e56760f6')

package() {
  install -Dm755 aop-boot-guard-load "${pkgdir}/usr/lib/aop-boot-guard/load"
  install -Dm755 aop-boot-guard-wdt-run "${pkgdir}/usr/lib/aop-boot-guard/wdt-run"
  install -Dm644 aop-boot-guard.service "${pkgdir}/usr/lib/systemd/system/aop-boot-guard.service"
  install -Dm644 README.package.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
