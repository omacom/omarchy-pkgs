[Unit]
Description=One guarded AOP + speaker-DAI module load per boot (MacBook Pro 14-inch, M5 Max)
After=local-fs.target

[Service]
Type=oneshot
# StateDirectory creates /var/lib/aop-boot-guard root-owned 0700 before ExecStart;
# the loader fail-closes unless every parent of the inflight latch is trusted.
StateDirectory=aop-boot-guard
StateDirectoryMode=0700
ExecStart=/usr/lib/aop-boot-guard/load
TimeoutStartSec=300
Restart=no
KillMode=control-group

[Install]
WantedBy=multi-user.target
