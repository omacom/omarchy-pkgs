PACKAGE_NAME="@PACKAGE_NAME@"
PACKAGE_VERSION="@PACKAGE_VERSION@"
AUTOINSTALL="yes"
# The pristine Broadcom blob must be patched in the build dir on every build.
# Without this DKMS compiles the unpatched blob: a wl that scans and associates
# but never completes WPA3-SAE.
PRE_BUILD="dkms-prebuild.sh"
MAKE[0]="make KVER=${kernelver}"
CLEAN="make clean"
BUILT_MODULE_NAME[0]="wl"
DEST_MODULE_LOCATION[0]="/updates/dkms"
