# WPA3-SAE and 802.11w (PMF) for the BCM4360 (14e4:43a0), which has no
# stock wl WPA3 support. This recipe targets the closed wl compatibility path.
#
# This is the closed broadcom-sta 6.30.223.271 `wl` blob with a reviewed,
# pinned set of changes that make it, in host software:
#   - accept auth alg=3 (SAE), by byte-patching the blob's auth clamp;
#   - expose the blob's internal auth/RX entry points (objcopy --globalize);
#   - route a few call sites through C hooks (wl_reloc.py);
#   - add BIP-CMAC-128 and management replay protection in the open glue.
# The blob stays proprietary Broadcom code; it is fetched from Broadcom's own
# archive at build time, never committed here, and its SHA-256 is asserted.
#
# This is not a mainline or Rust driver and it does not broaden hardware
# support: it is for BCM4360 only, x86_64 only, and experimental. Next to the
# stock broadcom-wl-dkms, which still serves BCM4331 and the other wl parts.
#
# No install scriptlet, blacklist edit, module unload or service: the package
# lays down sources and DKMS builds them like any other module. The stock
# package remains the documented recovery path:
#   pacman -S broadcom-wl-dkms   (replaces this one; both provide wl)
#
# SKIP free on purpose: the fork snapshot and Broadcom's archive are both
# pinned by checksum, and prepare() re-checks the blob's own SHA-256.

pkgname=broadcom-wl-wpa3-dkms
pkgver=6.30.223.271.r36.g8ea3bc0
pkgrel=1
pkgdesc="WPA3-SAE and PMF for the Broadcom BCM4360 (closed wl blob), experimental DKMS module"
arch=('x86_64')
url="https://github.com/gafgpt-cmd/bcm4360-wpa3-pmf"
license=('GPL-2.0-only' 'custom:Broadcom')
# dkms pulls gcc, make and patch and runs the build against the installed
# headers. The PRE_BUILD step itself is python + objcopy.
depends=('dkms' 'python' 'binutils')
conflicts=('broadcom-wl' 'broadcom-wl-dkms')
provides=("broadcom-wl-dkms=${pkgver}")

# Reviewed source pin. 8ea3bc0 is the last commit whose C/build inputs match
# the candidate that was built and measured; later commits are documentation
# only. Move the pin in a PR once a new candidate is reviewed and rebuilt.
_commit=8ea3bc00c9671ce6991e4cca8863502a4027600e
# The pristine blob this recipe patches: broadcom-sta 6.30.223.271.
_broadcom=6.30.223.271
_blobsha256=352a6e349f74c69b78e76f68c63752c99b8f6b22dc942af531b754211d7f4743

source=(
  "bcm4360-wpa3-pmf-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz"
  "hybrid-v35_64-nodebug-pcoem-${_broadcom//./_}.tar.gz::https://docs.broadcom.com/docs-and-downloads/docs/linux_sta/hybrid-v35_64-nodebug-pcoem-${_broadcom//./_}.tar.gz"
  "dkms.conf.in"
  "broadcom-wl-wpa3-dkms.conf"
)
sha256sums=('4ce52b3afb2273669983ab7ae034a78b90460e1407f5fa07bb1d41f2f0c666ea'
            '5f79774d5beec8f7636b59c0fb07a03108eef1e3fd3245638b20858c714144be'
            '998bf11f6cc5fd98d0d01764e20787024bfbb0000841b0a46bad7f156e189cb3'
            '86aa3e51b8820d5ea3cd2fed768f915a417055d9db0c9df5bf5a1333e8dcd760')

prepare() {
  # The archive's checksum above already covers this, but the blob's identity
  # is what the binary patches are written against. A different blob would
  # patch the wrong bytes (wl_patch.py refuses a mismatch, this fails first).
  echo "${_blobsha256}  ${srcdir}/lib/wlc_hybrid.o_shipped" | sha256sum --check --strict -
}

package() {
  local src="${srcdir}/bcm4360-wpa3-pmf-${_commit}"
  local dest="${pkgdir}/usr/src/${pkgname}-${pkgver}"

  # Flattened tree: DKMS copies this directory into its build dir and runs
  # make with M=<that dir>, so Makefile, src/ and patches/ sit at the root.
  install -d "${dest}/lib" "${dest}/patches"
  cp -a "${src}/wl-src/src" "${dest}/src"
  install -Dm644 "${src}/wl-src/Makefile" "${dest}/Makefile"
  # PRE_BUILD is what makes this a WPA3 driver: every build turns the pristine
  # blob into the hooked one in the DKMS build dir before make runs. The
  # inherited dkms/install.sh is deliberately not used or shipped: it edits
  # live blacklists and services.
  install -Dm755 "${src}/dkms/dkms-prebuild.sh" "${dest}/dkms-prebuild.sh"
  install -Dm644 "${src}/patches/wl_patch.py" "${dest}/patches/wl_patch.py"
  install -Dm644 "${src}/patches/wl_reloc.py" "${dest}/patches/wl_reloc.py"
  sed -e "s/@PACKAGE_NAME@/${pkgname}/" \
      -e "s/@PACKAGE_VERSION@/${pkgver}/" \
      "${srcdir}/dkms.conf.in" > "${dest}/dkms.conf"
  chmod 644 "${dest}/dkms.conf"

  # Broadcom's blob. build.sh names it wlc_hybrid.o_amd64.orig; the prebuild
  # copies it to wlc_hybrid.o_amd64 and patches that copy, so a rebuild always
  # starts from the same bytes.
  install -Dm644 "${srcdir}/lib/wlc_hybrid.o_shipped" "${dest}/lib/wlc_hybrid.o_amd64.orig"

  # Stock-equivalent driver blacklists. Not a service and not an /etc edit:
  # removing this package removes the file again.
  install -Dm644 "${srcdir}/broadcom-wl-wpa3-dkms.conf" \
    "${pkgdir}/usr/lib/modprobe.d/broadcom-wl-wpa3-dkms.conf"

  install -Dm644 "${src}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${srcdir}/lib/LICENSE.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-broadcom.txt"
}
