# Maintainer: Omarchy
# Noto's Chinese, Japanese and Korean fonts as upstream's variable builds:
# one file per family with every weight in it, 116 MB installed where Arch's
# noto-fonts-cjk, with a file per weight, is 299 MB. The same families under
# the same names (Noto Sans CJK, Noto Sans Mono CJK and Noto Serif CJK, each
# JP, KR, SC, TC and HK) and the same named weights, Thin to Black, so
# fontconfig rules and applications that name them need no change.
pkgname=noto-fonts-cjk-vf
# The Sans release; the Serif files are from Serif2.003.
pkgver=2.004
pkgrel=1
pkgdesc='Google Noto CJK fonts, variable'
arch=(any)
url=https://github.com/notofonts/noto-cjk
license=(OFL-1.1)
provides=(noto-fonts-cjk)
conflicts=(noto-fonts-cjk)
_sans="${url}/raw/Sans${pkgver}"
_serif="${url}/raw/Serif2.003"
source=("${_sans}/Sans/Variable/OTC/NotoSansCJK-VF.otf.ttc"
        "${_sans}/Sans/Variable/OTC/NotoSansMonoCJK-VF.otf.ttc"
        "${_serif}/Serif/Variable/OTC/NotoSerifCJK-VF.otf.ttc"
        "LICENSE-${pkgver}::${_sans}/LICENSE")
sha256sums=('d3d8256cdec8dbcb3552284bc6b20c734dd60c2ee9df83b5758e34807c4bac32'
            '3a73c225abcfd5742ab84e613b427fb5b40c9e59b70fe3d1683f9b1da96568a0'
            '24720ea76c8b13e822059d155cefb0f9f6be1cfdee1e2bb67b61c96067de42c9'
            '6a73f9541c2de74158c0e7cf6b0a58ef774f5a780bf191f2d7ec9cc53efe2bf2')

package() {
  install -Dm644 -t "${pkgdir}/usr/share/fonts/noto-cjk" *.ttc
  install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
