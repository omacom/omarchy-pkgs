pkgname=luvus
pkgver=0.14.1
pkgrel=1
pkgdesc="Mission control for your AI coding agents"
arch=('x86_64' 'aarch64')
url="https://luvus.dev"
license=('Apache-2.0')
options=('!debug' '!strip')

optdepends=(
  'git: Git status, worktrees, and repository features'
  'github-cli: GitHub integration'
  'openssh: remote attach over SSH'
  'wl-clipboard: clipboard integration on Wayland'
  'xclip: clipboard integration on X11'
)

source=('LICENSE')
source_x86_64=("luvus-${pkgver}-${CARCH}.tar.gz::https://github.com/RizRiyz/luvus/releases/download/v${pkgver}/luvus-v${pkgver}-${CARCH}-unknown-linux-musl.tar.gz")
source_aarch64=("luvus-${pkgver}-${CARCH}.tar.gz::https://github.com/RizRiyz/luvus/releases/download/v${pkgver}/luvus-v${pkgver}-${CARCH}-unknown-linux-musl.tar.gz")
sha256sums=('c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4')
sha256sums_x86_64=('f8a2f2cf1059cf51cc6db59b152971e0ec64bde0be84c2673180137b00418bd2')
sha256sums_aarch64=('be4a8138d6d53cad8de17b04e303618ac4484aa40059d09388d46f91a94e2c26')

package() {
  install -Dm755 "${srcdir}/luvus" "${pkgdir}/usr/bin/luvus"
  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
