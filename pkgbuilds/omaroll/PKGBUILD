pkgname=omaroll
pkgver=1.19.0
pkgrel=1
pkgdesc='A fast, beautiful image, video, and PDF viewer for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/btsouth/omaroll'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-imageformats'
         'qt6-svg' 'kimageformats' 'libavif' 'libheif' 'libraw' 'hicolor-icon-theme'
         'xdg-desktop-portal' 'ffmpeg' 'ffmpegthumbnailer' 'poppler' 'wl-clipboard'
         'xdg-utils')
optdepends=('darktable: develop camera RAW photos'
            'omacut: trim recordings'
            'sushi: open PDF documents'
            'imagemagick: read photo dates and technical details'
            'tensaku: annotate screenshots'
            'omaframe: annotate and frame existing images'
            'tesseract: copy and search text in pictures'
            'zbar: scan QR codes'
            'pinta: edit images'
            'mpv: play video'
            'imv: view images full size'
            'localsend: send to another device'
            'tailscale: send to another of your machines')
makedepends=('cmake' 'ninja' 'pkgconf')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/btsouth/omaroll/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('3a799f6ed67ee4c384e84609be6a1d226673a9a33fb1c8a9810f3396c8bf807c')

build() {
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
