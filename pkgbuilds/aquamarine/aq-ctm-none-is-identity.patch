From 3ecbaaaf19a331e4cd318f6bcfa242847425cc3a Mon Sep 17 00:00:00 2001
From: outfoxxed <outfoxxed@outfoxxed.me>
Date: Tue, 24 Nov 2026 17:54:43 -0700
Subject: [PATCH] drm: take a CRTC without a CTM as the identity

Before its first CTM commit, a modeset sends an identity CTM blob to clear
whatever CTM the kernel may hold from before us. A CRTC without one applies
none, so the blob changes nothing on screen, but some drivers modeset for a
CTM appearing: msm sets mode_changed and allow_modeset for it
(msm_atomic.c), blanking what the CRTC showed, e.g. a boot splash's last
frame.

Read the CRTC's CTM property first, and skip the blob when the kernel has
none.
---
 src/backend/drm/DRM.cpp | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/backend/drm/DRM.cpp b/src/backend/drm/DRM.cpp
index 754e9c4..d798b58 100644
--- a/src/backend/drm/DRM.cpp
+++ b/src/backend/drm/DRM.cpp
@@ -59,7 +59,16 @@ static bool shouldSubmitCTM(SP<SDRMConnector> connector, const COutputState::SIn
     if (!(state.ctm == Mat3x3::identity()))
         return true;
 
-    return connector->crtc->props.values.ctm && !connector->crtc->atomic.ctmStateKnown;
+    if (!connector->crtc->props.values.ctm || connector->crtc->atomic.ctmStateKnown)
+        return false;
+
+    // No CTM in the kernel is the identity already. A blob would change nothing on screen,
+    // but some drivers modeset for a CTM appearing (msm), blanking what the CRTC shows.
+    uint64_t blob = 0;
+    if (getDRMProp(connector->backend->drmFD(), connector->crtc->id, connector->crtc->props.values.ctm, &blob) && !blob)
+        connector->crtc->atomic.ctmStateKnown = true;
+
+    return !connector->crtc->atomic.ctmStateKnown;
 }
 
 Aquamarine::CDRMBackend::CDRMBackend(SP<CBackend> backend_) : backend(backend_) {
