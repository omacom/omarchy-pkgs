# Maintainer: Caleb Maclennan <caleb@alerque.com>
# Contributor: Aaron Blasko <blaskoazzolaaaron [at] gmail.com>
#
# Arch's aquamarine 0.16.0-1 plus patches:
# - re-read a connector's possible CRTCs when rescanning, so a Type-C port the
#   DCP fabric reroutes to another display pipeline gets a CRTC without
#   restarting the compositor (Apple Silicon);
# - reconnect an output whose connector gained modes after it connected, so a
#   monitor behind a USB4 dock that wakes slowly is not left without a mode
#   (NVIDIA N1x);
# - take a CRTC without a CTM as the identity, so taking over a lit output
#   sends no CTM, which msm would modeset for;
# - with AQ_SPLASH_ADOPT=1, keep the boot splash's last frame, for the login
#   screen or the desktop, whichever comes first, until the first rendered
#   frame. Hyprland's startup hold depends on it;
# - send no all-zero (SDR) HDR metadata to a connector that has none, so
#   taking over a lit HDR-capable monitor turns on no HDR infoframe, which
#   i915 and amdgpu modeset for, and commits no modeset of its own.
# None is upstream yet: drop each once a hyprwm release carries it. hyprwm's
# fc77bd58 and 04bfb7db, carried with 0.15.1, shipped in 0.16.0.

pkgname=aquamarine
pkgver=0.16.0
# Above Arch's 0.16.0-1, so an x86_64 machine that took Arch's build moves to this one
pkgrel=1.2
pkgdesc='a very light linux rendering backend library'
# Built for x86_64 too, so PCs get the boot splash's handoff that Hyprland's startup hold needs
arch=(x86_64 aarch64)
url="https://github.com/hyprwm/$pkgname"
license=(BSD-3-Clause)
depends=(libgcc
         libstdc++
         glibc # libc.so libm.so
         hyprutils libhyprutils.so
         libdisplay-info libdisplay-info.so
         libdrm # libdrm.so
         libglvnd libEGL.so
         libinput # libinput.so
         mesa # libgbm.so
         opengl-driver
         pixman
         seatd libseat.so
         systemd-libs libudev.so
         wayland libwayland-client.so
         wayland-protocols)
makedepends=(cmake
             hyprwayland-scanner)
provides=("lib$pkgname.so")
_archive="$pkgname-$pkgver"
source=("$url/archive/v$pkgver/$_archive.tar.gz"
        0001-drm-re-read-possible-CRTCs-when-rescanning-connectors.patch
        0004-drm-reconnect-an-output-whose-connector-gained-modes.patch
        aq-ctm-none-is-identity.patch
        aq-splash-adopt.patch
        aq-hdr-none-stays-none.patch)
sha256sums=('42339c3096c9de6582c0d71bc86b7e63334a3faf6a2b917d385ad093caf66c3c'
            '50e9e38ff915b18074dc9b5dd1d07d7f24e340e99f254476d6abe578eece7864'
            '7fe7620c222d9f323b6a424301b98176f798f41a97945282ec71b361e742511a'
            '9343550f2663def25b8308370626289123f0669caa31f53851c15c33854c5b3b'
            'c1394631534306178768e8472249b266457a058cd3d15a9015619eb2602206be'
            'b5b6aeaa86a0f93b37682cccafb3930b27b80ac5aa67dfc7937e2c8b497ddef8')

prepare() {
	cd "$_archive"
	patch -Np1 --fuzz=0 -i ../0001-drm-re-read-possible-CRTCs-when-rescanning-connectors.patch
	patch -Np1 --fuzz=0 -i ../0004-drm-reconnect-an-output-whose-connector-gained-modes.patch
	patch -Np1 --fuzz=0 -i ../aq-ctm-none-is-identity.patch
	patch -Np1 --fuzz=0 -i ../aq-splash-adopt.patch
	patch -Np1 --fuzz=0 -i ../aq-hdr-none-stays-none.patch
}

build() {
	cd "$_archive"
	# cc1plus needs more than 8 MiB of stack for DRM.cpp. GCC raises its own
	# limit natively, but under QEMU user-mode emulation (the aarch64 builder)
	# the guest stack is fixed at exec and setrlimit is ignored, so the compiler
	# segfaults. QEMU reads this at exec; native builds ignore it. The object
	# code is identical either way.
	export QEMU_STACK_SIZE=64M
	cmake -B build \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release
	cmake --build build
}

package() {
	cd "$_archive"
	DESTDIR="$pkgdir" cmake --install build
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
