# Maintainer: Caleb Maclennan <caleb@alerque.com>
# Contributor: Aaron Blasko <blaskoazzolaaaron [at] gmail.com>
#
# Arch's aquamarine 0.15.1-1 plus patches, carried on edge for aarch64:
# - re-read a connector's possible CRTCs when rescanning, so a Type-C port the
#   DCP fabric reroutes to another display pipeline gets a CRTC without
#   restarting the compositor (Apple Silicon);
# - hyprwm's post-0.15.1 fixes fc77bd58 and 04bfb7db, without which a
#   compositor crashes on exit when the DRM backend is torn down (the SDDM
#   greeter after every login on the NVIDIA N1x);
# - reconnect an output whose connector gained modes after it connected, so a
#   monitor behind a USB4 dock that wakes slowly is not left without a mode
#   (NVIDIA N1x);
# - hyprwm's post-0.15.1 fix 7bb8bdf4 (#415), without which a nested
#   compositor's first configure can be lost and its window never maps;
# - render a nested compositor at the host's buffer scale, so it is sharp on a
#   HiDPI host instead of upscaled (not upstream: hyprwm takes no AI-written
#   patches, this one was).
# Drop the carry once hyprwm releases the fixes.

pkgname=aquamarine
pkgver=0.15.1
pkgrel=1.4
pkgdesc='a very light linux rendering backend library'
arch=(aarch64)
url="https://github.com/hyprwm/$pkgname"
license=(BSD-3-Clause)
depends=(libgcc
         libstdc++
         glibc # libc.so libm.so
         hyprutils libhyprutils.so
         libdisplay-info libdisplay-info.so
         libdrm # libdrm.so
         libglvnd libEGL.so
         libinput # libinput.so
         mesa # libgbm.so
         opengl-driver
         pixman
         seatd libseat.so
         systemd-libs libudev.so
         wayland libwayland-client.so
         wayland-protocols)
makedepends=(cmake
             hyprwayland-scanner)
provides=("lib$pkgname.so")
_archive="$pkgname-$pkgver"
source=("$url/archive/v$pkgver/$_archive.tar.gz"
        0001-drm-re-read-possible-CRTCs-when-rescanning-connectors.patch
        0002-drm-fix-crash-on-null-connector-in-flush.patch
        0003-drm-guard-backend-in-log.patch
        0004-drm-reconnect-an-output-whose-connector-gained-modes.patch
        0005-wayland-fix-configure-not-applying-sometimes.patch
        0006-wayland-render-at-the-host-buffer-scale.patch)
sha256sums=('2f9de98c0bd1b7b1b09c576e390a2fef436449762fb334163c414f0c300296f2'
            '50e9e38ff915b18074dc9b5dd1d07d7f24e340e99f254476d6abe578eece7864'
            '9bf7035b232f9616f6bb39013c9ec1ad9fbbf460113d726881ada53c77730f35'
            'cb1a5775d0ac2082e47bdb2f8a75597616e32fe3685f7eff944d064dc555fb18'
            '7fe7620c222d9f323b6a424301b98176f798f41a97945282ec71b361e742511a'
            '0921c13ba0dc7c4131f79c2b7498f420520b45841356dcb55949a89bdf0b5943'
            '6cd782988020d4dab4d9aa3aa0ee1b5dd9348942cacb95982e260136ab0df65f')

prepare() {
	cd "$_archive"
	patch -Np1 -i ../0001-drm-re-read-possible-CRTCs-when-rescanning-connectors.patch
	patch -Np1 -i ../0002-drm-fix-crash-on-null-connector-in-flush.patch
	patch -Np1 -i ../0003-drm-guard-backend-in-log.patch
	patch -Np1 -i ../0004-drm-reconnect-an-output-whose-connector-gained-modes.patch
	patch -Np1 -i ../0005-wayland-fix-configure-not-applying-sometimes.patch
	patch -Np1 -i ../0006-wayland-render-at-the-host-buffer-scale.patch
}

build() {
	cd "$_archive"
	# cc1plus needs more than 8 MiB of stack for DRM.cpp. GCC raises its own
	# limit natively, but under QEMU user-mode emulation (the aarch64 builder)
	# the guest stack is fixed at exec and setrlimit is ignored, so the compiler
	# segfaults. QEMU reads this at exec; native builds ignore it. The object
	# code is identical either way.
	export QEMU_STACK_SIZE=64M
	cmake -B build \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release
	cmake --build build
}

package() {
	cd "$_archive"
	DESTDIR="$pkgdir" cmake --install build
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
