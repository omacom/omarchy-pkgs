From 1fc53f7a7702a46fe04b6207b6d0665aeba3fa41 Mon Sep 17 00:00:00 2001
From: Dominic Rubas <1042243+rubas@users.noreply.github.com>
Date: Mon, 16 Nov 2026 17:14:38 +0100
Subject: [PATCH] drm: send the cursor hotspot, so a virtual GPU shows its
 cursor plane

Since Linux 6.8 a driver with DRIVER_CURSOR_HOTSPOT (virtio-gpu,
vmwgfx, qxl, vboxvideo) hides its cursor plane from an atomic client
that has not set DRM_CLIENT_CAP_CURSOR_PLANE_HOTSPOT. In a VM,
aquamarine then sees only the primary plane, and the compositor draws
a software cursor.

Set the cap once atomic is on, and write HOTSPOT_X and HOTSPOT_Y next
to CRTC_X and CRTC_Y for a new cursor image and for a move. Both
properties were in the plane table and never written. Other drivers
refuse the cap and have no such properties, so nothing changes for
them. The legacy path already passes the hotspot.
---
 include/aquamarine/backend/drm/Atomic.hpp |  1 +
 src/backend/drm/DRM.cpp                   |  8 ++++++++
 src/backend/drm/impl/Atomic.cpp           | 23 +++++++++++++++++++++--
 3 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/include/aquamarine/backend/drm/Atomic.hpp b/include/aquamarine/backend/drm/Atomic.hpp
index 735f95d..068614c 100644
--- a/include/aquamarine/backend/drm/Atomic.hpp
+++ b/include/aquamarine/backend/drm/Atomic.hpp
@@ -46,6 +46,7 @@ namespace Aquamarine {
         void         planeProps(Hyprutils::Memory::CSharedPointer<SDRMPlane> plane, Hyprutils::Memory::CSharedPointer<CDRMFB> fb, uint32_t crtc, Hyprutils::Math::Vector2D pos,
                                 eOutputColorRange colorRange = AQ_OUTPUT_COLOR_RANGE_AUTO);
         void         planePropsPos(Hyprutils::Memory::CSharedPointer<SDRMPlane> plane, Hyprutils::Math::Vector2D pos);
+        void         planePropsHotspot(Hyprutils::Memory::CSharedPointer<SDRMPlane> plane, Hyprutils::Math::Vector2D hotspot);
 
         void         rollback(SDRMConnectorCommitData& data);
         void         apply(SDRMConnectorCommitData& data);
diff --git a/src/backend/drm/DRM.cpp b/src/backend/drm/DRM.cpp
index 754e9c4..9def092 100644
--- a/src/backend/drm/DRM.cpp
+++ b/src/backend/drm/DRM.cpp
@@ -759,6 +759,14 @@ bool Aquamarine::CDRMBackend::checkFeatures() {
         impl                         = makeShared<CDRMAtomicImpl>(self.lock());
         drmProps.supportsAsyncCommit = drmGetCap(gpu->fd, DRM_CAP_ATOMIC_ASYNC_PAGE_FLIP, &cap) == 0 && cap == 1;
         atomic                       = true;
+
+        // A virtual GPU (virtio-gpu, vmwgfx, qxl, ...) hides its cursor plane from an atomic client that
+        // does not send cursor hotspots: its host shows the pointer itself and has to know where in the
+        // image it points. We send them (CDRMAtomicRequest::planePropsHotspot), so ask for the plane.
+        // Other drivers, and kernels before 6.8, refuse the cap, and nothing changes there.
+        if (!drmSetClientCap(gpu->fd, DRM_CLIENT_CAP_CURSOR_PLANE_HOTSPOT, 1))
+            backend->log(AQ_LOG_DEBUG, "drm: virtual GPU, sending cursor hotspots");
+
         if (!initCommitThread())
             backend->log(AQ_LOG_WARNING, "drm: Failed to create the asynchronous commit worker");
     }
diff --git a/src/backend/drm/impl/Atomic.cpp b/src/backend/drm/impl/Atomic.cpp
index 350dd95..3b4084c 100644
--- a/src/backend/drm/impl/Atomic.cpp
+++ b/src/backend/drm/impl/Atomic.cpp
@@ -190,6 +190,21 @@ void Aquamarine::CDRMAtomicRequest::planePropsPos(Hyprutils::Memory::CSharedPoin
     add(plane->id, plane->props.values.crtc_y, (uint64_t)(int64_t)pos.y);
 }
 
+void Aquamarine::CDRMAtomicRequest::planePropsHotspot(Hyprutils::Memory::CSharedPointer<SDRMPlane> plane, Hyprutils::Math::Vector2D hotspot) {
+
+    if (failed)
+        return;
+
+    // only the cursor plane of a virtual GPU has these, and only with DRM_CLIENT_CAP_CURSOR_PLANE_HOTSPOT
+    if (!plane->props.values.hotspot_x || !plane->props.values.hotspot_y)
+        return;
+
+    TRACE(backend->log(AQ_LOG_TRACE, std::format("atomic planeProps: hotspot blobs: hotspot_x {}, hotspot_y {}", plane->props.values.hotspot_x, plane->props.values.hotspot_y)));
+
+    add(plane->id, plane->props.values.hotspot_x, (uint64_t)(int64_t)hotspot.x);
+    add(plane->id, plane->props.values.hotspot_y, (uint64_t)(int64_t)hotspot.y);
+}
+
 void Aquamarine::CDRMAtomicRequest::setConnector(Hyprutils::Memory::CSharedPointer<SDRMConnector> connector) {
     conn = connector;
 }
@@ -327,10 +342,14 @@ void Aquamarine::CDRMAtomicRequest::addConnectorCursor(Hyprutils::Memory::CShare
             if (data.committed & COutputState::AQ_OUTPUT_STATE_CURSOR_SHAPE) {
                 if (!data.cursorVisible)
                     planeProps(connector->crtc->cursor, nullptr, 0, {});
-                else
+                else {
                     planeProps(connector->crtc->cursor, data.cursorFB, connector->crtc->id, data.cursorPos - data.cursorHotspot);
-            } else if (data.cursorVisible)
+                    planePropsHotspot(connector->crtc->cursor, data.cursorHotspot);
+                }
+            } else if (data.cursorVisible) {
                 planePropsPos(connector->crtc->cursor, data.cursorPos - data.cursorHotspot);
+                planePropsHotspot(connector->crtc->cursor, data.cursorHotspot);
+            }
         }
     } else
         planeProps(connector->crtc->cursor, nullptr, 0, {});
-- 
2.56.1

