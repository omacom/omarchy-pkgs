@@ -1934,6 +1936,32 @@ drmModeModeInfo* Aquamarine::SDRMConnector::getCurrentMode() {
     return modeInfo;
 }
 
+// With AQ_SPLASH_ADOPT=1, keep the picture our CRTC shows when we start, e.g. a boot splash's last
+// frame, until our first rendered frame. That the picture is ours to keep is the caller's promise:
+// the console after a lastclose would be adopted too. Only connectors found while the backend starts
+// adopt. Atomic only: legacy clients see no ACTIVE, FB_ID or plane CRTC_ID.
+void Aquamarine::SDRMConnector::adoptPicture() {
+    static const bool ADOPT = envEnabled("AQ_SPLASH_ADOPT");
+    if (!ADOPT || backend->backend->ready || !crtc || !backend->sessionActive())
+        return;
+
+    const int FD     = backend->drmFD();
+    uint64_t  active = 0, fb = 0, planeCRTC = 0;
+    getDRMProp(FD, crtc->id, crtc->props.values.active, &active);
+    getDRMProp(FD, crtc->primary->id, crtc->primary->props.values.fb_id, &fb);
+    getDRMProp(FD, crtc->primary->id, crtc->primary->props.values.crtc_id, &planeCRTC);
+    if (!active || !fb || planeCRTC != crtc->id)
+        return;
+
+    auto mode = getCurrentMode();
+    if (!mode)
+        return;
+
+    adoptedMode = *mode;
+    free(mode);
+    backend->backend->log(AQ_LOG_DEBUG, std::format("drm: {} adopts the picture on crtc {} ({}x{})", szName, crtc->id, adoptedMode->hdisplay, adoptedMode->vdisplay));
+}
+
 IOutput::SParsedEDID Aquamarine::SDRMConnector::parseEDID(std::vector<uint8_t> data) {
     auto                 info   = di_info_parse_edid(data.data(), data.size());
     IOutput::SParsedEDID parsed = {};
@@ -2327,6 +2355,7 @@ void Aquamarine::SDRMConnector::setCRTC(SP<SDRMCRTC> newCRTC) {
     invalidateFrame();
 
     crtc = newCRTC;
+    adoptedMode.reset();
 }
 
 void Aquamarine::SDRMConnector::onPresent(bool primary, bool cursor, DRMFBList* deferred) {
@@ -2861,6 +2890,18 @@ bool Aquamarine::CDRMOutput::commitState(bool onlyTest) {
 
     bool ok = connector->commitState(data);
 
+    // A commit that keeps an adopted picture leaves out the primary plane, which a test of the same
+    // state carries. If the kernel refuses it, the adoption ends, and the commit goes again as it would
+    // without one, as a modeset.
+    if (!ok && !onlyTest && connector->adoptedMode) {
+        backend->backend->log(AQ_LOG_DEBUG, std::format("drm: {} could not keep its adopted picture, committing without it", name));
+        connector->adoptedMode.reset();
+        data.modeset  = true;
+        data.blocking = true;
+        data.flags &= ~DRM_MODE_PAGE_FLIP_ASYNC;
+        ok = connector->commitState(data);
+    }
+
     // a buffer acquired only to validate/attempt the modeset isn't consumed by the
     // consumer: rewind the swapchain so the acquire cursor stays in sync with it.
     if (acquiredModesetBuffer && (onlyTest || !ok))
@@ -3129,6 +3170,10 @@ std::optional<std::chrono::steady_clock::time_point> Aquamarine::CDRMOutput::nex
     return std::nullopt;
 }
 
+bool Aquamarine::CDRMOutput::showsAdoptedPicture() const {
+    return connector->adoptedMode.has_value();
+}
+
 uint32_t Aquamarine::CDRMOutput::commitCapabilities() const {
     if (!backend || !backend->commitThread || !backend->atomic)
         return 0;
diff --git a/src/backend/drm/impl/Atomic.cpp b/src/backend/drm/impl/Atomic.cpp
index 350dd95..d7182f0 100644
--- a/src/backend/drm/impl/Atomic.cpp
+++ b/src/backend/drm/impl/Atomic.cpp
@@ -78,9 +78,10 @@ bool Aquamarine::CDRMAtomicRequest::restateConnectors(SP<SDRMConnector> self) {
         add(c->crtc->id, c->crtc->props.values.active, 1);
         add(c->id, c->props.values.crtc_id, c->crtc->id);
 
-        // A head that has not scanned out yet has no buffer to restate; its
-        // existing plane state carries over untouched, which is what we want.
-        if (c->crtc->primary && c->crtc->primary->front) {
+        // A head that has not scanned out yet, or still shows an adopted picture,
+        // has no buffer to restate; its existing plane state carries over untouched,
+        // which is what we want.
+        if (c->crtc->primary && c->crtc->primary->front && !c->adoptedMode) {
             // planeProps reads per-connector state off `conn`, so point it at the
             // head we are restating rather than ours.
             const auto saved = conn;
@@ -271,6 +272,18 @@ void Aquamarine::CDRMAtomicRequest::addConnector(Hyprutils::Memory::CSharedPoint
 
     add(connector->crtc->id, connector->crtc->props.values.active, enable);
 
+    // an adopted picture stays while commits keep its mode and bring no rendered frame
+    bool keepPicture = false;
+    if (connector->adoptedMode && !data.test) {
+        const bool RENDERED = (data.committed & COutputState::AQ_OUTPUT_STATE_BUFFER) && !data.modeset;
+        keepPicture         = enable && !RENDERED && !memcmp(&data.modeInfo, &*connector->adoptedMode, sizeof(drmModeModeInfo));
+        if (!keepPicture) {
+            connector->adoptedMode.reset();
+            const auto WHY = !enable ? "disabled" : (RENDERED ? "a rendered frame" : "another mode");
+            backend->log(AQ_LOG_DEBUG, std::format("atomic drm: {} replaces its adopted picture: {}", connector->szName, WHY));
+        }
+    }
+
     if (enable) {
         if (connector->output->supportsExplicit && data.committed & COutputState::AQ_OUTPUT_STATE_EXPLICIT_OUT_FENCE)
             add(connector->crtc->id, connector->crtc->props.values.out_fence_ptr, (uintptr_t)&data.outputState.explicitOutFence);
@@ -287,13 +300,15 @@ void Aquamarine::CDRMAtomicRequest::addConnector(Hyprutils::Memory::CSharedPoint
         if (connector->crtc->props.values.vrr_enabled)
             add(connector->crtc->id, connector->crtc->props.values.vrr_enabled, (uint64_t)STATE.adaptiveSync);
 
-        planeProps(connector->crtc->primary, data.mainFB, connector->crtc->id, {}, STATE.colorRange);
+        if (!keepPicture) {
+            planeProps(connector->crtc->primary, data.mainFB, connector->crtc->id, {}, STATE.colorRange);
 
-        if (connector->output->supportsExplicit && (data.committed & COutputState::AQ_OUTPUT_STATE_EXPLICIT_IN_FENCE) && STATE.explicitInFence >= 0)
-            add(connector->crtc->primary->id, connector->crtc->primary->props.values.in_fence_fd, STATE.explicitInFence);
+            if (connector->output->supportsExplicit && (data.committed & COutputState::AQ_OUTPUT_STATE_EXPLICIT_IN_FENCE) && STATE.explicitInFence >= 0)
+                add(connector->crtc->primary->id, connector->crtc->primary->props.values.in_fence_fd, STATE.explicitInFence);
 
-        if (connector->crtc->primary->props.values.fb_damage_clips)
-            add(connector->crtc->primary->id, connector->crtc->primary->props.values.fb_damage_clips, data.atomic.fbDamage);
+            if (connector->crtc->primary->props.values.fb_damage_clips)
+                add(connector->crtc->primary->id, connector->crtc->primary->props.values.fb_damage_clips, data.atomic.fbDamage);
+        }
     } else {
         planeProps(connector->crtc->primary, nullptr, 0, {});
     }
