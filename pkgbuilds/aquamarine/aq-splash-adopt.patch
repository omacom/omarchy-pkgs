 include/aquamarine/backend/DRM.hpp   |  6 ++++
 include/aquamarine/output/Output.hpp |  1 +
 src/backend/drm/DRM.cpp              | 45 ++++++++++++++++++++++++++++
 src/backend/drm/impl/Atomic.cpp      | 31 ++++++++++++++-----
 src/output/Output.cpp                |  4 +++
 6 files changed, 80 insertions(+), 8 deletions(-)

