From a8a55c7343babcfcc27a8b312f0eb6c153b6f81f Mon Sep 17 00:00:00 2001
From: Ryan Hughes <ryan@heyoodle.com>
Date: Wed, 14 Oct 2026 00:27:07 -0400
Subject: [PATCH] drm: reconnect an output whose connector gained modes

A driver can report a connector as connected before it can read the
sink's modes and report the modes on a later hotplug, with the connector
connected throughout. On the NVIDIA N1x a monitor behind a USB4 dock
does this when it wakes from deep sleep: its first AUX transactions fail,
the driver offers no modes, and a second or two later it detects the sink
again and offers them all.

Outputs were only created and destroyed on a change of connection state,
so such an output kept the empty mode list it was created with. The
compositor had no mode to set and the monitor stayed black until the
connector was disconnected.

When a connected output has no modes and the connector now reports some,
disconnect it and connect it again so it picks them up.
---
 src/backend/drm/DRM.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/backend/drm/DRM.cpp b/src/backend/drm/DRM.cpp
index 0a6e76d..0a9b765 100644
--- a/src/backend/drm/DRM.cpp
+++ b/src/backend/drm/DRM.cpp
@@ -1214,6 +1214,15 @@ void Aquamarine::CDRMBackend::recheckOutputs() {
             conn->disconnect();
         }
 
+        // a driver may report a sink before it can read its modes, e.g. a monitor behind a USB4 dock that is still
+        // waking up, and report the modes on a later hotplug while the connector stays connected. reconnect the
+        // output so it picks them up, it would otherwise be left without a mode to set.
+        if (conn->status == DRM_MODE_CONNECTED && conn->output && conn->output->modes.empty() && conn->maxMode.x > 0) {
+            backend->log(AQ_LOG_DEBUG, std::format("drm: Connector {} gained modes, reconnecting", conn->szName));
+            conn->disconnect();
+            conn->status = DRM_MODE_CONNECTED;
+        }
+
         // also disconnect redundant tiled connectors that may have been previously connected
         if (conn->tilingRedundant && conn->output) {
             backend->log(AQ_LOG_DEBUG, std::format("drm: Disconnecting tiling-redundant connector {}", conn->szName));
-- 
