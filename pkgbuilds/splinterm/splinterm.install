post_install() {
  echo 'Add com.oldjobobo.splinterm.desktop to ~/.config/xdg-terminals.list when ready to make it preferred.'
  echo 'Optional Omarchy screensaver integration: splinterm integration omarchy-screensaver enable'
}

post_upgrade() {
  echo 'This package does not restart user services. To pick up the new daemon, stop splinterd.service'
  echo 'from an external terminal, run systemctl --user daemon-reload, then start it; stopping ends active Dojos.'
}

post_remove() {
  echo 'User-owned Splinterm configuration and runtime state were preserved.'
  echo 'If enabled, ~/.local/bin/omarchy-launch-screensaver is now a dangling link; remove it.'
}
