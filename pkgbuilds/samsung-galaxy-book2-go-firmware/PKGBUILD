  'samsung-galaxy-book2-go-wu-200.0.12.0-qcipa7280.cab::wu://35adcb86-2ccf-4480-b34d-527ecd301360/1/7670884534fa251bc27d1279bf3108d72ded4716'
  'samsung-galaxy-book2-go-wu-200.0.12.0-qcwlan7280.cab::wu://35adcb86-2ccf-4480-b34d-527ecd301360/1/33cfe55574a1a4717db4d924eff599c9ca0cd25a'
  'samsung-galaxy-book2-go-wu-200.0.12.0-qcsubsys-ext-adsp7280.cab::wu://35adcb86-2ccf-4480-b34d-527ecd301360/1/f4272c8de0ad840085703e657cdd03cfb8de7d56'
  'samsung-galaxy-book2-go-wu-200.0.12.0-qcsubsys-ext-cdsp7280.cab::wu://35adcb86-2ccf-4480-b34d-527ecd301360/1/7a0da6d23160b03b69d6c344c874ea69a860a5b2'
  'samsung-galaxy-book2-go-wu-200.0.12.0-qcsubsys-ext-mpss7280.cab::wu://35adcb86-2ccf-4480-b34d-527ecd301360/1/c3bc702a2daf163e3eae2a91bacec2a5b659814f'
)
