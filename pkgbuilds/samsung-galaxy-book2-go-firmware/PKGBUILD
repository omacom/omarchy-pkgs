sha256sums=('772aaf735947e6db60db98d2608aa91f94906f8fad8179c8f443d61fa095bc7f' '7da90b8c1b2dfbf51dba90a25d6b44363ab2afdc9e87f139912a32e72be0add7' '641870bdccb47a03a42c50755e517bf40515ecceb48f05c8d4f1bb69acd3d8f3' '2f27e9048da265c6a08b5c76b0885838d2d7fd108f7a14537d073140983fd8f4' '2fbc1fa851c83a37e4bdd0a0ae2cb70baa1d1fbd62da1f882b7e568f82ed4cb2' '347c1f5c4e410bbd7b50ff56476017eda9470c768adb16a9f40e4e26c1194145')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'samsung-galaxy-book2-go-wu-200.0.12.0-qcdx7280.cab' 'samsung-galaxy-book2-go-wu-200.0.12.0-qcdx7280' 7z
  _unpack 'samsung-galaxy-book2-go-wu-200.0.12.0-qcipa7280.cab' 'samsung-galaxy-book2-go-wu-200.0.12.0-qcipa7280' 7z
  _unpack 'samsung-galaxy-book2-go-wu-200.0.12.0-qcwlan7280.cab' 'samsung-galaxy-book2-go-wu-200.0.12.0-qcwlan7280' 7z
  _unpack 'samsung-galaxy-book2-go-wu-200.0.12.0-qcsubsys-ext-adsp7280.cab' 'samsung-galaxy-book2-go-wu-200.0.12.0-qcsubsys-ext-adsp7280' 7z
  _unpack 'samsung-galaxy-book2-go-wu-200.0.12.0-qcsubsys-ext-cdsp7280.cab' 'samsung-galaxy-book2-go-wu-200.0.12.0-qcsubsys-ext-cdsp7280' 7z
  _unpack 'samsung-galaxy-book2-go-wu-200.0.12.0-qcsubsys-ext-mpss7280.cab' 'samsung-galaxy-book2-go-wu-200.0.12.0-qcsubsys-ext-mpss7280' 7z
}

