  install -Dm644 'samsung-galaxy-book2-go-wu-200.0.12.0-qcdx7280/qcdxkmsuc7280.mbn' "$fw"/'qcom/sc7280/Samsung/galaxy-book2-go/qcdxkmsuc7280.mbn'
