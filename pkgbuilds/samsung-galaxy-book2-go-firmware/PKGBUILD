4de02d2963101ba4825c58fa29d4452b27300ed65b36bdced8c4a9e9098d370b  qcom/sc7280/Samsung/galaxy-book2-go/qcadsp7280.mbn
278111b1548eab9a78bb0c8c783dedcff5112d213f4e1516d1ae433be25bb8ee  qcom/sc7280/Samsung/galaxy-book2-go/qccdsp7280.mbn
