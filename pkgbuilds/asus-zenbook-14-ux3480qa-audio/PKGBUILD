# Maintainer: Emir Beganovic <emir@omarchy.org>

# Speakers and microphones for the ASUS Zenbook 14 UX3480QA (Snapdragon X
# X1-26-100). alsa-ucm-conf's x1e80100 DMI match covers the Zenbook A14 but not
# this model, so UCM finds no profile and PipeWire offers no speakers or
# microphones. The board's audio is wired like the A14's (ThinkPad T14s
# profile). The UCM profile restates the T14s profile (Syntax 6) and sets the
# WSA digital volumes to 100% on every boot via FixedBootSequence.
#
# The amplifiers' PA Volume, which PipeWire uses as the hardware volume, has no
# effect on this board, so a WirePlumber rule switches the card to software
# volume.

pkgname=asus-zenbook-14-ux3480qa-audio
pkgver=1
pkgrel=4
pkgdesc='UCM profile and WirePlumber volume config for the ASUS Zenbook 14 UX3480QA'
arch=('aarch64')
# Qualcomm-only: the pacman platform guard keeps it off other hardware.
groups=('omarchy-platform-qualcomm')
url="https://github.com/omacom/omarchy-pkgs"
license=('MIT')
depends=('linux-firmware-qcom' 'alsa-ucm-conf')
source=('ucm-asus-zenbook-14-ux3480qa.conf'
        '60-asus-zenbook-14-ux3480qa-soft-volume.conf'
        'README.package.md')
sha256sums=('50438128fc36bfc3518a5e32059ae3364b785abedb16b3965a16f77d042c090a'
            '8c82badf5a2794081b0516bfcc440169c26899885dc76483a30d93c07c9dada0'
            '2ab585fd72e7ea5daee600b667afad70263e8ca822ed809f0373f92a42956c5e')

# UCM looks the profile up by the card's long name, which the kernel builds
# from DMI. The UX3480QAB reads UX3480QAB where the UX3480QA reads UX3480QA.
_longnames=(
  ASUSTeKCOMPUTERINC.-Zenbook14UX3480QA-1.0-UX3480QA
  ASUSTeKCOMPUTERINC.-Zenbook14UX3480QAB-1.0-UX3480QAB
)

package() {
  local longname
  for longname in "${_longnames[@]}"; do
    install -Dm644 ucm-asus-zenbook-14-ux3480qa.conf \
      "$pkgdir/usr/share/alsa/ucm2/conf.d/x1e80100/$longname.conf"
  done

  install -Dm644 60-asus-zenbook-14-ux3480qa-soft-volume.conf \
    "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/60-asus-zenbook-14-ux3480qa-soft-volume.conf"

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
