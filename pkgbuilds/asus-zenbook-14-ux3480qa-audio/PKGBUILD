# Maintainer: Emir Beganovic <emir@omarchy.org>

# Speakers and microphones for the ASUS Zenbook 14 UX3480QA (Snapdragon X
# X1-26-100). alsa-ucm-conf's x1e80100 DMI match covers the Zenbook A14 but not
# this model, so UCM finds no profile and PipeWire offers no speakers or
# microphones. The board's audio is wired like the A14's, so point the card's
# long name at the ThinkPad T14s profile that alsa-ucm-conf gives the A14.

pkgname=asus-zenbook-14-ux3480qa-audio
pkgver=1
pkgrel=1
pkgdesc='UCM profile for the ASUS Zenbook 14 UX3480QA speakers and microphones'
arch=('aarch64')
# Qualcomm-only: the pacman platform guard keeps it off other hardware.
groups=('omarchy-platform-qualcomm')
url="https://github.com/omacom/omarchy-pkgs"
license=('MIT')
depends=('linux-firmware-qcom' 'alsa-ucm-conf')
source=('ucm-asus-zenbook-14-ux3480qa.conf'
        'README.package.md')
sha256sums=('d42983204121bb03251311c732a0c3c6280ee950ffda796e842a4501eb68b055'
            'b1c2125889fa2cbbfc6fefc5852692882170225aed5dba0c87a67fc46e7abeab')

# UCM looks the profile up by the card's long name, which the kernel builds
# from DMI.
_longname=ASUSTeKCOMPUTERINC.-Zenbook14UX3480QA-1.0-UX3480QA

package() {
  install -Dm644 ucm-asus-zenbook-14-ux3480qa.conf \
    "$pkgdir/usr/share/alsa/ucm2/conf.d/x1e80100/$_longname.conf"

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
