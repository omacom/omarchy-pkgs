# Maintainer: mmalmi
# Contributor: Gino O. <aur@1337.io> (original AUR recipe)
pkgname=nostr-vpn-bin
pkgver=4.1.18
pkgrel=1
pkgdesc='Private mesh VPN with a Bitcoin-paid exit bandwidth marketplace (GTK4 desktop)'
arch=('x86_64')
url='https://github.com/mmalmi/nostr-vpn'
license=('MIT')
depends=('gtk4' 'libadwaita' 'glib2' 'cairo' 'dbus' 'libgcc' 'glibc>=2.39' 'zbar' 'curl' 'xdg-utils' 'polkit' "nostr-vpn-cli=$pkgver")
provides=("nostr-vpn=$pkgver")
conflicts=('nostr-vpn' 'nostr-vpn-git')
# Preserve the published executable byte-for-byte.
options=('!strip' '!debug')
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/mmalmi/nostr-vpn/v$pkgver/LICENSE")
source_x86_64=("$url/releases/download/v$pkgver/nostr-vpn-v$pkgver-linux-x64.deb")
sha256sums=('0db560024163fbcc5ee5cff1971684ca448da90088f341db083a38548846c3d5')
sha256sums_x86_64=('433f99d78ffa252c5a11bc86bbc41a442cd08f9f439ceae3ec2a1568c6fb2330')
noextract=("nostr-vpn-v$pkgver-linux-x64.deb")

prepare() {
  mkdir -p "$srcdir/data"
  bsdtar -xOf "$srcdir/nostr-vpn-v$pkgver-linux-x64.deb" data.tar.xz | bsdtar -xf - -C "$srcdir/data"
}

package() {
  cd "$srcdir/data"
  install -Dm755 usr/bin/nostr-vpn "$pkgdir/usr/bin/nostr-vpn"
  install -Dm644 usr/share/applications/nostr-vpn.desktop "$pkgdir/usr/share/applications/nostr-vpn.desktop"
  mkdir -p "$pkgdir/usr/share/icons"
  cp -a usr/share/icons/hicolor "$pkgdir/usr/share/icons/"
  install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
