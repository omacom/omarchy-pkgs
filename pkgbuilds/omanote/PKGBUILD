# Maintainer: Sam <https://github.com/sam-f-gh>

pkgname=omanote
pkgver=0.1.0
pkgrel=1
pkgdesc='Handwritten notes and PDF annotation for pen, touch and keyboard'
arch=('x86_64' 'aarch64')
url='https://github.com/sam-f-gh/omanote'
license=('MIT')
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'poppler-qt6'
  'qpdf'
  'qt6-base'
  'qt6-declarative'
  'wayland'
  'xdg-desktop-portal'
)
makedepends=(
  'gcc'
  'make'
  'pkgconf'
  'wayland-protocols'
)
# The PDF round-trip test writes text and reads it back, which needs a font.
checkdepends=(
  'ttf-liberation'
)
optdepends=(
  'xdg-desktop-portal-gtk: open and save dialogs on desktops whose portal has no file chooser'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f66b78cb70508fdeba97f0e1c080a29d9c9ca0c6c2ecf62b48064b07de2cb578')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/test
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 build/omanote "$pkgdir/usr/bin/omanote"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/omanote.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omanote.svg"
  install -Dm644 pkgbuild/omanote.desktop "$pkgdir/usr/share/applications/omanote.desktop"
}
