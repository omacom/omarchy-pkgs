# Maintainer: Christoffer Hallas <oss@christofferhallas.com>

pkgname=omarchy-atmos
pkgver=0.1.0
pkgrel=1
pkgdesc='Preferences app for Omarchy: themes, the bar, network, power, and the rest of the machine'
arch=('x86_64' 'aarch64')
url='https://github.com/csfh/atmos'
license=('MIT')

depends=(
  'bash'
  'gcc-libs'
  'glibc'
  'hyprland'
  'jq'
  'nodejs'
  'omarchy'
  'python'
  'quickshell'
  'systemd'
  'util-linux'
  'xdg-utils'
)
makedepends=('cargo')
optdepends=(
  'bluez-utils: Bluetooth page'
  'desktop-file-utils: refresh the application menu after adding a launcher'
  'hyprsunset: night light'
  'libpulse: Sound page'
  'networkmanager: Network page'
  'snapper: snapshot policy and rollback'
  'tailscale: Tailscale status'
  'wireplumber: Sound page'
  'wl-clipboard: copy diagnostics reports'
)
conflicts=('atmos-bin')
options=('!debug')

source=(
  "$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/atmos-v$pkgver.tar.gz"
)
sha256sums=('cc6829eb6740d785750b67da3d0c5516bdd3ea32c640105aa146819d9a34cd86')

prepare() {
  cd "atmos-$pkgver/backend"
  export CARGO_TARGET_DIR=target
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "atmos-$pkgver/backend"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "atmos-$pkgver/backend"
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "atmos-$pkgver"

  local root="$pkgdir/usr/lib/atmos"
  install -dm755 "$root"
  cp -r --no-preserve=ownership bin components pages services scripts packaging icons shell.qml "$root/"
  rm -rf "$root/scripts/stubs"
  # Same modes atmos_stage sets for the XDG install.
  chmod 755 "$root/bin/atmos"
  find "$root/scripts" -maxdepth 1 -type f \( -name '*.sh' -o -name '*.py' \) -exec chmod 755 {} +
  install -Dm755 backend/target/release/ratmos "$root/bin/ratmos"

  # Marks the install as owned by pacman: no in-app Update, atmos --setup is opt-in.
  printf '%s-%s\n' "$pkgver" "$pkgrel" > "$root/PACKAGED"

  install -dm755 "$pkgdir/usr/bin"
  ln -s /usr/lib/atmos/bin/atmos "$pkgdir/usr/bin/atmos"

  install -Dm644 packaging/atmos.desktop \
    "$pkgdir/usr/share/applications/atmos.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 icons/NOTICE "$pkgdir/usr/share/licenses/$pkgname/icons-NOTICE"
  install -Dm644 packaging/atmos.hook -t "$pkgdir/usr/share/libalpm/hooks"
}
