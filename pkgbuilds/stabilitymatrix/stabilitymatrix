#!/bin/bash
set -euo pipefail

if [[ $(id -u) == 0 ]]; then
  echo 'Run Stability Matrix as your desktop user, without sudo.' >&2
  exit 1
fi

app_dir=/opt/stabilitymatrix
# Upstream uses APPIMAGE to locate itself even when extracted. Its generated
# desktop entry must invoke this wrapper, and its updater must target a
# package-owned directory, never the user's model library.
export APPIMAGE=/usr/bin/stabilitymatrix

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
[[ $config_home == /* ]] || config_home=$HOME/.config
app_home=$config_home/StabilityMatrix
explicit_data=false
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  case ${args[i]} in
    --data-dir|--home-dir)
      if ((i + 1 >= ${#args[@]})); then
        echo "${args[i]} requires a directory." >&2
        exit 1
      fi
      args[i+1]=$(realpath -m -- "${args[i+1]}")
      if [[ ${args[i]} == --data-dir ]]; then
        explicit_data=true
      else
        app_home=${args[i+1]}
      fi
      i=$((i + 1))
      ;;
    --data-dir=*)
      explicit_data=true
      args[i]=--data-dir=$(realpath -m -- "${args[i]#*=}")
      ;;
    --home-dir=*)
      app_home=$(realpath -m -- "${args[i]#*=}")
      args[i]=--home-dir=$app_home
      ;;
  esac
done

if [[ $explicit_data == false ]]; then
  library_file=$app_home/library.json
  if [[ -e $library_file ]]; then
    # Do not silently switch to an empty library when a saved config is broken
    # or a drive is not mounted. --data-dir remains an explicit recovery path.
    if ! data_dir=$(jq -er '.LibraryPath | select(type == "string" and startswith("/"))' "$library_file"); then
      echo "Cannot read the library path in $library_file. Repair it or use --data-dir." >&2
      exit 1
    fi
    if [[ ! -d $data_dir ]]; then
      echo "Library directory is unavailable: $data_dir. Mount it or use --data-dir." >&2
      exit 1
    fi
  elif [[ -f $HOME/StabilityMatrix/settings.json ]]; then
    data_dir=$HOME/StabilityMatrix
  else
    data_home=${XDG_DATA_HOME:-$HOME/.local/share}
    [[ $data_home == /* ]] || data_home=$HOME/.local/share
    data_dir=$data_home/StabilityMatrix
    mkdir -p -- "$data_dir"
  fi
  args=(--data-dir "$data_dir" "${args[@]}")
fi

# Avoid taking configuration from the directory the launcher was invoked in.
cd "$app_dir"
exec "$app_dir/StabilityMatrix.Avalonia" "${args[@]}"
