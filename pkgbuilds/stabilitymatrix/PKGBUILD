# Package the official Linux release without modifying its executable.
pkgname=stabilitymatrix
pkgver=2.16.4
pkgrel=1
pkgdesc='Package manager and inference UI for local generative AI tools'
arch=('x86_64')
url='https://github.com/LykosAI/StabilityMatrix'
license=('LicenseRef-Lykos-EULA')
depends=('bash' 'jq' 'glibc' 'gcc-libs' 'icu' 'openssl' 'zlib' 'krb5'
         'fontconfig' 'libx11' 'libice' 'libsm' 'libxrandr' 'libxi'
         'libxcursor' 'libxext' 'libxrender' 'libglvnd' 'libxcrypt-compat'
         'hicolor-icon-theme' 'xdg-utils')
makedepends=('7zip')
checkdepends=('desktop-file-utils' 'python')
options=('!strip' '!debug')
source=('stabilitymatrix' 'stabilitymatrix-app.desktop' 'EULA.md' 'README.package.md' 'test-launcher.py')
source_x86_64=("stabilitymatrix-${pkgver}-linux-x64.zip::$url/releases/download/v${pkgver}/StabilityMatrix-linux-x64.zip")
sha256sums=(
  'c6bd4b2a44b93c9ac6945f56d87ce21afade8b0995f01eec0372d0d103022a67'
  'bf7c8d35ee8b2c07bcce1480efdec5e43524a649cc4a2f35ee3919d59a336603'
  '2584cf7fd5c07537e5e96007052ade1a74bf872845e6fe7041015ac70ba696a9'
  '27fd75453b5877991812299dd444e920c85382e93d1f767a8a4b5b8c262ab752'
  '305d3ca11001d65774979dc9a76f1c59a4980dd9574514890ec81e630b07e80f'
)
sha256sums_x86_64=('379381025ded32a9875b6195130b4442cd85f19dbb7bdbca6120043362d3055c')

prepare() {
  # Extract the AppImage as data; neither the runtime nor the app runs at build time.
  rm -rf "$srcdir/squashfs-root"
  7z x "$srcdir/StabilityMatrix.AppImage" -o"$srcdir/squashfs-root" >/dev/null
}

check() {
  desktop-file-validate "$srcdir/stabilitymatrix-app.desktop"
  python "$srcdir/test-launcher.py" "$srcdir/stabilitymatrix"
}

package() {
  install -Dm755 "$srcdir/squashfs-root/usr/bin/StabilityMatrix.Avalonia" \
    "$pkgdir/opt/stabilitymatrix/StabilityMatrix.Avalonia"
  install -Dm755 "$srcdir/stabilitymatrix" "$pkgdir/usr/bin/stabilitymatrix"
  install -Dm644 "$srcdir/stabilitymatrix-app.desktop" \
    "$pkgdir/usr/share/applications/stabilitymatrix-app.desktop"
  install -Dm644 "$srcdir/squashfs-root/zone.lykos.stabilitymatrix.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/stabilitymatrix.png"
  install -Dm644 "$srcdir/squashfs-root/usr/bin/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/AGPL-3.0.txt"
  install -Dm644 "$srcdir/EULA.md" "$pkgdir/usr/share/licenses/$pkgname/EULA.md"
  install -Dm644 "$srcdir/README.package.md" "$pkgdir/usr/share/doc/$pkgname/README.package.md"
}
