From d85381e66b26e19c3172f74af6958428d572111b Mon Sep 17 00:00:00 2001
From: Ryan <ryan@localhost>
Date: Thu, 1 Oct 2026 23:49:58 -0400
Subject: [PATCH] HID: asus: host-controlled Fn-lock for the 0B05:4B42 keyboard

The 0B05:4B42 I2C keyboard leaves Fn-lock to the host: Fn+Esc only
reports the vendor usage 0x4e (KEY_FN_ESC) and the keyboard switches the
F1-F12 row between function keys and media keys when the host writes
feature report 5a d0 4e <state> (1: function keys, 0: media keys). So
Fn+Esc did nothing. Enable QUIRK_HID_FN_LOCK for it so hid-asus toggles
the state on KEY_FN_ESC.

Add an fnlock_default module parameter, matching asus-wmi's, so the
boot-time state can be chosen; it defaults to function keys as before.
Restore the state on resume as the backlight level already is.
---
 drivers/hid/hid-asus.c | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/drivers/hid/hid-asus.c b/drivers/hid/hid-asus.c
index b71c0624c..1b28a5d9f 100644
--- a/drivers/hid/hid-asus.c
+++ b/drivers/hid/hid-asus.c
@@ -41,6 +41,11 @@ MODULE_AUTHOR("Victor Vlasenko <victor.vlasenko@sysgears.com>");
 MODULE_AUTHOR("Frederik Wenigwieser <frederik.wenigwieser@gmail.com>");
 MODULE_DESCRIPTION("Asus HID Keyboard and TouchPad");
 
+static bool fnlock_default = true;
+module_param(fnlock_default, bool, 0444);
+MODULE_PARM_DESC(fnlock_default,
+		 "Default Fn-lock state: true makes F1-F12 send function keys (default: true)");
+
 #define T100_TPAD_INTF 2
 #define MEDION_E1239T_TPAD_INTF 1
 
@@ -1065,9 +1070,9 @@ static int asus_input_configured(struct hid_device *hdev, struct hid_input *hi)
 	drvdata->input = input;
 
 	if (drvdata->quirks & QUIRK_HID_FN_LOCK) {
-		drvdata->fn_lock = true;
+		drvdata->fn_lock = fnlock_default;
 		INIT_WORK(&drvdata->fn_lock_sync_work, asus_sync_fn_lock);
-		asus_kbd_set_fn_lock(hdev, true);
+		asus_kbd_set_fn_lock(hdev, drvdata->fn_lock);
 	}
 
 	return 0;
@@ -1246,6 +1251,12 @@ static int __maybe_unused asus_resume(struct hid_device *hdev)
 		}
 	}
 
+	if (drvdata->quirks & QUIRK_HID_FN_LOCK) {
+		ret = asus_kbd_set_fn_lock(hdev, drvdata->fn_lock);
+		if (ret < 0)
+			hid_err(hdev, "Asus failed to restore Fn-lock: %d\n", ret);
+	}
+
 asus_resume_err:
 	return ret;
 }
@@ -1539,7 +1550,8 @@ static const struct hid_device_id asus_devices[] = {
 	{ HID_I2C_DEVICE(USB_VENDOR_ID_ASUSTEK,
 		USB_DEVICE_ID_ASUSTEK_I2C_ZENBOOK_KEYBOARD),
 	  I2C_KEYBOARD_QUIRKS | QUIRK_FILTER_CAMERA_COMPANION |
-	  QUIRK_USE_KBD_BACKLIGHT | QUIRK_PAD_FEATURE_REPORTS },
+	  QUIRK_USE_KBD_BACKLIGHT | QUIRK_PAD_FEATURE_REPORTS |
+	  QUIRK_HID_FN_LOCK },
 	{ HID_I2C_DEVICE(USB_VENDOR_ID_ASUSTEK,
 		USB_DEVICE_ID_ASUSTEK_I2C_TOUCHPAD), I2C_TOUCHPAD_QUIRKS },
 	{ HID_USB_DEVICE(USB_VENDOR_ID_ASUSTEK,
