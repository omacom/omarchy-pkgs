export KBUILD_BUILD_HOST=archlinux
export KBUILD_BUILD_USER=$pkgbase
export KBUILD_BUILD_TIMESTAMP="$(date -Ru${SOURCE_DATE_EPOCH:+d @$SOURCE_DATE_EPOCH})"
export ARCH=arm64

_assert_config() {
  local option=$1 expected=$2 actual

  actual=$(scripts/config -s "$option")
  if [[ $actual != "$expected" ]]; then
    error "$option must be $expected for N1x (found ${actual:-unset})"
    return 1
  fi
}

prepare() {
  cd "$_srcname"

  echo "Verifying signed NVIDIA tag binds the pinned source..."
  local signed_commit signed_tag
  signed_commit=$(sed -n 's/^object //p' "../${_nvidia_tag}.tag")
  signed_tag=$(sed -n 's/^tag //p' "../${_nvidia_tag}.tag")
  if [[ $signed_commit != "$_commit" || $signed_tag != "$_nvidia_tag" ]]; then
    error "Signed tag payload does not bind $_nvidia_tag to $_commit"
    return 1
  fi

  echo "Verifying pinned NVIDIA source release..."
  local source_release
  source_release=$(sed -n \
    '1s/^linux-nvidia-7\.0 (\([^)]*\)).*/\1/p' \
    debian.nvidia-7.0/changelog)
  if [[ $source_release != "$_ubuntu_release" ]]; then
    error "Pinned source is $source_release, expected $_nvidia_tag"
    return 1
  fi

  echo "Applying N1x platform patches..."
  local n1x_patch
  for n1x_patch in "${_n1x_patches[@]}"; do
    echo "  $n1x_patch"
    patch -Np1 --no-backup-if-mismatch < "../$n1x_patch"
  done
  if ! grep -Fq '"NVDA0200"' drivers/i2c/busses/i2c-mt65xx.c ||
    ! grep -Fq 'acpi_gpio_set_debounce_timeout(desc, info.debounce);' drivers/gpio/gpiolib-acpi-core.c ||
    ! grep -Fq '"ARML0002"' drivers/platform/arm64/nvidia-ffa-ec.c ||
    ! grep -Fq 'USB_DEVICE_ID_ASUSTEK_I2C_ZENBOOK_KEYBOARD' drivers/hid/hid-asus.c ||
    ! grep -Fq 'QUIRK_PAD_FEATURE_REPORTS' drivers/hid/hid-asus.c ||
    ! grep -Fq 'fnlock_default' drivers/hid/hid-asus.c; then
    error "N1x platform support is missing from the source tree"
    return 1
  fi

  echo "Setting version..."
  echo "-$pkgrel" > localversion.10-pkgrel
  echo "${pkgbase#linux}" > localversion.20-pkgname

  echo "Exporting NVIDIA's 4 KiB N1x-era arm64 config..."
  python3 debian/scripts/misc/annotations \
    --file debian.nvidia-7.0/config/annotations \
    --arch arm64 \
    --flavour nvidia \
    --export > .config

  # Ubuntu's packaging generates these files from Canonical certificates.
  # Omarchy's unsigned development kernel must not reference missing keys.
  scripts/config --set-str SYSTEM_TRUSTED_KEYS ''
  scripts/config --set-str SYSTEM_REVOCATION_KEYS ''
  scripts/config --set-str VERSION_SIGNATURE \
    "Omarchy $pkgver-$pkgrel-n1x ($_nvidia_tag)"

  make olddefconfig

  echo "Checking N1x bring-up platform requirements..."
  _assert_config ARM64_4K_PAGES y
  _assert_config ARM64_64K_PAGES n
  _assert_config PAGE_SIZE_4KB y
  _assert_config CMA_SIZE_MBYTES 0
  _assert_config CPU_FREQ_DEFAULT_GOV_PERFORMANCE y
  _assert_config PREEMPT n
  _assert_config PREEMPT_LAZY y
  _assert_config PREEMPT_DYNAMIC y
  _assert_config LOCALVERSION_AUTO n
  _assert_config NO_PAGE_MAPCOUNT n
  _assert_config ACPI y
  _assert_config ARCH_TEGRA y
  _assert_config ARM64_ERRATUM_4118414 y
  _assert_config DRM y
  _assert_config DRM_NOUVEAU n
  _assert_config DRM_SIMPLEDRM y
  _assert_config FRAMEBUFFER_CONSOLE y
  _assert_config EFI y
  _assert_config EFI_CAPSULE_LOADER y
  _assert_config EFI_ZBOOT y
  _assert_config IOMMU_DEFAULT_PASSTHROUGH y
  _assert_config INFINIBAND m
  _assert_config MLX5_CORE m
  _assert_config MLX5_CORE_EN y
  _assert_config MLX5_INFINIBAND m
  _assert_config MT7925E m
  _assert_config MTK_PCIE_HOTPLUG m
  _assert_config R8127 m
  _assert_config I2C_HID_ACPI m
  _assert_config I2C_MT65XX m
  _assert_config PINCTRL_MT8901 y
  _assert_config GPIO_ACPI y
  _assert_config HID_MULTITOUCH m
  _assert_config HID_ASUS m
  _assert_config ARM_FFA_TRANSPORT y
  _assert_config NVIDIA_FFA_EC y
  _assert_config ACPI_BATTERY y
  _assert_config MTK_POWER_WRAP y
  _assert_config SOUNDWIRE_MTK m
  _assert_config SND_SOC_MT8901 m
  _assert_config SND_SOC_SOF_MT8901 m
  _assert_config SERIAL_AMBA_PL011 y
  _assert_config SERIAL_AMBA_PL011_CONSOLE y
  _assert_config MODULE_SIG y
  _assert_config MODULE_SIG_ALL y
  _assert_config MODULE_SIG_FORCE n
  _assert_config MODULE_SIG_SHA512 y

  make -s kernelrelease > version
  echo "Prepared $pkgbase version $(<version) from $_nvidia_tag"
}

build() {
  cd "$_srcname"

  # Current N1x test systems boot through ACPI and this package does not ship
  # device trees, so avoid building every arm64 DTB. Use every core: this is
  # built natively on aarch64 hosts (Coleman, the N1x itself).
  make -j"$(nproc)" Image modules
  make -j"$(nproc)" -C tools/bpf/bpftool vmlinux.h feature-clang-bpf-co-re=1
}

_package() {
  pkgdesc="The $pkgdesc kernel and modules"
  depends=(
    coreutils
    initramfs
    kmod
  )
  optdepends=(
    "$pkgbase-headers: headers and scripts for building external modules"
    'linux-firmware: firmware images needed for platform devices'
    'wireless-regdb: correct wireless channels for the configured country'
  )
  provides=(
    KSMBD-MODULE
    NTSYNC-MODULE
    WIREGUARD-MODULE
  )

  cd "$_srcname"
  local modulesdir="$pkgdir/usr/lib/modules/$(<version)"

  echo "Installing boot image..."
  # Limine's aarch64 Linux protocol expects the native arm64 Image header at
  # offset zero. CONFIG_EFI_ZBOOT changes image_name to the PE/COFF-wrapped
  # vmlinuz.efi, which is bootable as an EFI application but not as a Limine
  # Linux-protocol kernel.
  install -Dm644 arch/arm64/boot/Image "$modulesdir/vmlinuz"

  # Used by mkinitcpio to name the kernel.
  echo "$pkgbase" | install -Dm644 /dev/stdin "$modulesdir/pkgbase"

  echo "Installing modules..."
  ZSTD_CLEVEL=19 make INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
    DEPMOD=/doesnt/exist modules_install

  rm "$modulesdir/build"
}

_package-headers() {
  pkgdesc="Headers and scripts for building modules for the $pkgdesc kernel"
  depends=(
    binutils
    glibc
    libelf
    libgcc
    openssl
    pahole
    xxhash
    zlib
    zstd
  )
  provides=(LINUX-HEADERS)

  cd "$_srcname"
  local builddir="$pkgdir/usr/lib/modules/$(<version)/build"
  local karch

  case $CARCH in
    aarch64) karch=arm64 ;;
    *) error "Unknown CARCH $CARCH"; return 1 ;;
  esac

  echo "Installing build files..."
  install -Dt "$builddir" -m644 .config Makefile Module.symvers System.map \
    localversion.* version vmlinux tools/bpf/bpftool/vmlinux.h
  install -Dt "$builddir/kernel" -m644 kernel/Makefile
  install -Dt "$builddir/arch/$karch" -m644 arch/$karch/Makefile
  cp -t "$builddir" -a scripts
  ln -srt "$builddir" "$builddir/scripts/gdb/vmlinux-gdb.py"

  if [[ $(scripts/config -s CONFIG_HAVE_STACK_VALIDATION) = y ]]; then
    install -Dt "$builddir/tools/objtool" tools/objtool/objtool
  fi

  if [[ $(scripts/config -s CONFIG_DEBUG_INFO_BTF_MODULES) = y ]]; then
    install -Dt "$builddir/tools/bpf/resolve_btfids" \
      tools/bpf/resolve_btfids/resolve_btfids
  fi

  echo "Installing headers..."
  cp -t "$builddir" -a include
  cp -t "$builddir/arch/$karch" -a "arch/$karch/include"
  install -Dt "$builddir/arch/$karch/kernel" -m644 \
    "arch/$karch/kernel/asm-offsets.s"

  install -Dt "$builddir/drivers/md" -m644 drivers/md/*.h
  install -Dt "$builddir/net/mac80211" -m644 net/mac80211/*.h
  install -Dt "$builddir/drivers/media/i2c" -m644 \
    drivers/media/i2c/msp3400-driver.h
  install -Dt "$builddir/drivers/media/usb/dvb-usb" -m644 \
    drivers/media/usb/dvb-usb/*.h
  install -Dt "$builddir/drivers/media/dvb-frontends" -m644 \
    drivers/media/dvb-frontends/*.h
  install -Dt "$builddir/drivers/media/tuners" -m644 \
    drivers/media/tuners/*.h
  install -Dt "$builddir/drivers/iio/common/hid-sensors" -m644 \
    drivers/iio/common/hid-sensors/*.h

  echo "Installing KConfig files..."
  find . -name 'Kconfig*' -exec install -Dm644 {} "$builddir/{}" \;

  echo "Installing Rust files..."
  if [[ $(scripts/config -s CONFIG_RUST) = y ]]; then
    install -Dt "$builddir/rust" -m644 rust/*.rmeta
    install -Dt "$builddir/rust" rust/*.so
  fi

  echo "Installing unstripped VDSO..."
  make INSTALL_MOD_PATH="$pkgdir/usr" vdso_install link=

  echo "Removing unneeded architectures..."
  local kernel_arch
  for kernel_arch in "$builddir"/arch/*/; do
    [[ $kernel_arch = */$karch/ ]] && continue
    rm -r "$kernel_arch"
  done

  rm -r "$builddir/Documentation"
  find -L "$builddir" -type l -delete
  find "$builddir" -type f -name '*.o' -delete

  echo "Stripping build tools..."
  local file
  while read -rd '' file; do
    case "$(file -Sib "$file")" in
      application/x-sharedlib\;*) strip -v $STRIP_SHARED "$file" ;;
      application/x-archive\;*) strip -v $STRIP_STATIC "$file" ;;
      application/x-executable\;*) strip -v $STRIP_BINARIES "$file" ;;
      application/x-pie-executable\;*) strip -v $STRIP_SHARED "$file" ;;
    esac
  done < <(find "$builddir" -type f -perm -u+x ! -name vmlinux -print0)

  strip -v $STRIP_STATIC "$builddir/vmlinux"

  mkdir -p "$pkgdir/usr/src"
  ln -sr "$builddir" "$pkgdir/usr/src/$pkgbase"
}

pkgname=(
  "$pkgbase"
  "$pkgbase-headers"
)
for _p in "${pkgname[@]}"; do
  eval "package_$_p() {
    $(declare -f "_package${_p#$pkgbase}")
    _package${_p#$pkgbase}
  }"
done

