# Maintainer: Spencer Bull <Spencer.Bull@Dell.com>
# Based on Arch Linux's kernel packaging and Omarchy's linux-ptl package.

pkgbase=linux-n1x
pkgver=7.0.14.nvidia1018
pkgrel=2
pkgdesc='Experimental NVIDIA N1x kernel based on the Ubuntu NVIDIA 7.0 lineage'
url='https://github.com/NVIDIA/NV-Kernels'
arch=(
  aarch64
)
license=(GPL-2.0-only)
makedepends=(
  bc
  binutils
  bison
  cpio
  flex
  gettext
  glibc
  libelf
  libgcc
  openssl
  pahole
  perl
  python
  rust
  rust-bindgen
  rust-src
  tar
  xxhash
  xz
  zlib
  zstd
)
options=(
  !debug
  !lto
  !strip
)

_ubuntu_release='7.0.0-1018.18~24.04.1'
_nvidia_tag=Ubuntu-nvidia-7.0-7.0.0-1018.18_24.04.1
# Signed tag object 5a6b09b7d33204dcd973b1b509137e509b28309b, verified with
# Canonical key BAD396E78A0BF72975CEE465080EB68D5EF5CA1D.
_commit=d76db97d0a41dba9bdacca29ff22a0bb511854a9
_srcname=NV-Kernels-${_commit}
# NVIDIA SAUCE commits from the 26.04_linux-nvidia branch, which is this pinned
# base plus three commits. The Dell N1x (XPS 16 DX16263) exposes its MediaTek
# MT8901 I2C controllers as ACPI NVDA0200; without these the internal keyboard,
# touchpad, and touch panel (all HID-over-I2C) never enumerate.
#   1e2a75fb7d0f925eab94fd32e62fe6147d954ea1 i2c: mediatek: Add ACPI/MT8901 support
#   c8ca6b82aeb7c0bd94f1b76e9c1880255114faed gpiolib: acpi: warn-only debounce
_n1x_patches=(
  0001-i2c-mediatek-Add-ACPI-MT8901-support-and-firmware-managed-clocks.patch
  0002-gpiolib-acpi-warn-only-debounce-in-irq-wake-get.patch
)
source=(
  "${pkgbase}-${_commit}.tar.gz::https://codeload.github.com/NVIDIA/NV-Kernels/tar.gz/${_commit}"
  "${_nvidia_tag}.tag"
  "${_nvidia_tag}.tag.sig"
  "${_n1x_patches[@]}"
)
validpgpkeys=(
  BAD396E78A0BF72975CEE465080EB68D5EF5CA1D  # Abdur Rahman (Canonical)
)
b2sums=(
