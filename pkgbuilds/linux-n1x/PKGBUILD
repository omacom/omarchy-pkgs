# Maintainer: Spencer Bull <Spencer.Bull@Dell.com>
# Based on Arch Linux's kernel packaging and Omarchy's linux-ptl package.

pkgbase=linux-n1x
pkgver=7.0.14.nvidia1021
pkgrel=3
pkgdesc='Experimental NVIDIA N1x kernel based on the Ubuntu NVIDIA 7.0 lineage'
url='https://github.com/NVIDIA/NV-Kernels'
arch=(
  aarch64
)
license=(GPL-2.0-only)
makedepends=(
  bc
  binutils
  bison
  cpio
  flex
  gettext
  glibc
  libelf
  libgcc
  openssl
  pahole
  perl
  python
  rust
  rust-bindgen
  rust-src
  tar
  xxhash
  xz
  zlib
  zstd
)
options=(
  !debug
  !lto
  !strip
)

_ubuntu_release='7.0.0-1021.21~24.04.1'
_nvidia_tag=Ubuntu-nvidia-7.0-7.0.0-1021.21_24.04.1
# Signed tag object ed7f113ad0f665909967aa4e14a4341d0d88949b, verified with
# Canonical key AE7D31FF19C227A5D7D425B1A08D6CD18E2BC802.
_commit=dd99802c8b0c384169bb36293c9517fa67238e47
_srcname=NV-Kernels-${_commit}
# This release carries NVIDIA's MediaTek MT8901 ACPI I2C and gpiolib debounce
# SAUCE (internal keyboard, touchpad, touch panel) and the ARML0002 FF-A EC
# driver (battery, AC, lid, thermal, UCSI on the ASUS ProArt P14). On top:
#   206107536018272a9c786fab74cdd90ee748ac2f HID: asus: Zenbook A16 keyboard
#     (upstream in 7.3; the 0B05:4B42 keyboard's Fn keys)
#   the 0B05:4B42 keyboard backlight, which needs hid-asus to expose its own
#     LED where asus-wmi does not exist and to send full-length reports
#   host-controlled Fn-lock (Fn+Esc) for the same keyboard
_n1x_patches=(
  0001-HID-asus-support-the-Zenbook-A16-UX3607OA-keyboard.patch
  0002-HID-asus-drive-the-0B05-4B42-keyboard-backlight-without-asus-wmi.patch
  0003-HID-asus-host-controlled-Fn-lock-for-the-0B05-4B42-keyboard.patch
  0004-HID-asus-disable-OOBE-mode-on-the-ProArt-P14-keyboard-too.patch
)
source=(
  "${pkgbase}-${_commit}.tar.gz::https://codeload.github.com/NVIDIA/NV-Kernels/tar.gz/${_commit}"
  "${_nvidia_tag}.tag"
  "${_nvidia_tag}.tag.sig"
  "${_n1x_patches[@]}"
)
validpgpkeys=(
  AE7D31FF19C227A5D7D425B1A08D6CD18E2BC802  # Jacob Martin (Canonical)
)
