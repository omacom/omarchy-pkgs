# Audio DSP, compute DSP, GPU and modem firmware for the Samsung Galaxy Book Go 5G. The firmware
# only runs if it is signed for this board by Samsung, so linux-firmware cannot carry it until the
# OEM submits it. The OEM ships it in the driver bundle it publishes for the machine on Windows
# Update, whose cabinets this recipe fetches with wudrivers and unpacks without running anything.
# Each file is checked against the SHA-256 it was matched to and installed under the name the
# device tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so
# once linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=samsung-galaxy-book-go-5g-firmware
pkgver=20261116
pkgrel=1
pkgdesc='Audio DSP, compute DSP, GPU and modem firmware for the Samsung Galaxy Book Go 5G'
arch=('aarch64')
url='https://github.com/birkskyum/wudrivers'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-sc8180xp-samsung-galaxy-book-go-5g')
makedepends=('7zip' 'wudrivers')
options=('!strip' '!debug')
# Windows Update's links are short-lived, so wudrivers fetches a fresh one by update ID, revision and SHA-1.
DLAGENTS+=('wu::/usr/bin/wudrivers fetch %u -o %o')
source=(
  'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcsubsys-ext-cdsp8180.cab::wu://c1683501-e39b-43ea-9ed7-760628657129/1/6c7c5c53ec9572114ee007f3783895ef7a326e0d'
  'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcsubsys-ext-adsp8180.cab::wu://c1683501-e39b-43ea-9ed7-760628657129/1/6ae4450dec4009519f7aec7832a2b9176c187212'
  'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcdx8180.cab::wu://c1683501-e39b-43ea-9ed7-760628657129/1/0b15d3f4f3b663ae0d4e77addbc418d72af8738e'
  'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcsubsys-ext-mpss8180.cab::wu://c1683501-e39b-43ea-9ed7-760628657129/1/1c2218b3e8ad9991124be524f1d7e40d8414159a'
)
source+=('README.package.md')
noextract=('samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcsubsys-ext-cdsp8180.cab' 'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcsubsys-ext-adsp8180.cab' 'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcdx8180.cab' 'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcsubsys-ext-mpss8180.cab')
sha256sums=('fa047caf3d3e7351751befb0ebbc071f5ff4483d19fbf457529c4cb13b87eed2' '857039f77660ebd73b4a7164afa346dc917a135f1f3443b2d92dc80bf254eb8e' '2a594be549a3f1dc525775fee7ac222f260f8fbe91b52da731c84784b9957941' 'e62bc5b5822302caad327515240fb3b0ca828dca0318bdf59c89ce13e93816ab')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcsubsys-ext-cdsp8180.cab' 'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcsubsys-ext-cdsp8180' 7z
  _unpack 'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcsubsys-ext-adsp8180.cab' 'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcsubsys-ext-adsp8180' 7z
  _unpack 'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcdx8180.cab' 'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcdx8180' 7z
  _unpack 'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcsubsys-ext-mpss8180.cab' 'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcsubsys-ext-mpss8180' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcsubsys-ext-adsp8180/qcadsp8180.mbn' "$fw"/'qcom/sc8180xp/Samsung/galaxy-book-go-5g/qcadsp8180.mbn'
  install -Dm644 'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcsubsys-ext-cdsp8180/qccdsp8180.mbn' "$fw"/'qcom/sc8180xp/Samsung/galaxy-book-go-5g/qccdsp8180.mbn'
  install -Dm644 'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcdx8180/qcdxkmsuc8180.mbn' "$fw"/'qcom/sc8180xp/Samsung/galaxy-book-go-5g/qcdxkmsuc8180.mbn'
  install -Dm644 'samsung-galaxy-book-go-5g-paka-wu-200.0.27.0-qcsubsys-ext-mpss8180/qcmpss8180_nm.mbn' "$fw"/'qcom/sc8180xp/Samsung/galaxy-book-go-5g/qcmpss8180_nm.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
e1c9613ea1fd584b9243c13a41d036d172e375c94d2eda8daf1ee789e660ecbb  qcom/sc8180xp/Samsung/galaxy-book-go-5g/qcadsp8180.mbn
8f5dc6b7f26d7c5aeca5660d1c6df71d18da4f4420b1cebea6e2f576ff81291a  qcom/sc8180xp/Samsung/galaxy-book-go-5g/qccdsp8180.mbn
faaeac2c537e70053bf05b7ff6a7fb3462331c970dc55a7d2aa9fb5c4e8cc939  qcom/sc8180xp/Samsung/galaxy-book-go-5g/qcdxkmsuc8180.mbn
ec8668b360c215dd4a14d09e56f6b2f2e2fd7cf602a4a3d912cde746099c9bb8  qcom/sc8180xp/Samsung/galaxy-book-go-5g/qcmpss8180_nm.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
