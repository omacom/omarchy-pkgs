#!/bin/bash

# Start iptsd for the Surface Laptop 7 touchpad (15" and 13.8") when its start at boot was
# lost. Run by iptsd-romulus15-boot.service.
#
# At boot the touchpad's HID device is bound to hid-generic and then re-bound
# to hid-multitouch. iptsd starts on the first binding and is stopped by the
# re-bind, and on some boots the pad then stops answering for about five
# seconds (spi_hid logs "failed to set report" and "Response timed out").
# iptsd's udev rule runs iptsd-check-device against the silent pad, gets no
# answer and does not ask for iptsd again, so the pad stays in its mouse mode.
# Re-running the rule once the pad answers starts iptsd.

touchpad_id="045E:0C77"

touchpad_hidraw() {
  local node
  for node in /sys/class/hidraw/hidraw*; do
    if [[ $(readlink -f "$node/device") == *":$touchpad_id."* ]]; then
      echo "${node##*/}"
      return 0
    fi
  done
  return 1
}

# An iptsd started on the hid-generic binding is stopped by the re-bind, so it
# only counts once the pad is on hid-multitouch. Should the pad never get
# there, take the binding it has after ten seconds.
touchpad_settled() {
  [[ $(readlink -f "/sys/class/hidraw/$1/device/driver") == */hid-multitouch ]] || ((SECONDS >= 10))
}

# Check twice a second for up to a minute, and re-run the rule every two
# seconds while iptsd is missing. The first re-run waits two seconds after
# the pad settles, so the rule's own run can finish. The service doesn't
# hold up the boot.
retries=0
last_run=
while ((SECONDS < 60)); do
  if hidraw=$(touchpad_hidraw) && touchpad_settled "$hidraw"; then
    if systemctl is-active --quiet "iptsd@dev-$hidraw.service"; then
      echo "iptsd is running for the touchpad ($hidraw) after $retries retries (${SECONDS}s)"
      exit 0
    fi
    last_run=${last_run:-$SECONDS}
    if ((SECONDS - last_run >= 2)); then
      retries=$((retries + 1))
      last_run=$SECONDS
      echo "iptsd is not running for the touchpad ($hidraw); re-running its udev rule (attempt $retries)"
      timeout 10 udevadm trigger --settle --action=change "/dev/$hidraw"
      continue
    fi
  fi
  sleep 0.5
done

echo "iptsd did not start for the touchpad" >&2
exit 1
