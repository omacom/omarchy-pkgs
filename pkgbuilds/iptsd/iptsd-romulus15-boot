#!/bin/bash

# Start iptsd for the Surface Laptop 7 15" touchpad when its start at boot was
# lost. Run by iptsd-romulus15-boot.service.
#
# At boot the touchpad's HID device is bound to hid-generic and then re-bound
# to hid-multitouch. iptsd starts on the first binding and is stopped by the
# re-bind, and on some boots the pad then stops answering for about five
# seconds (spi_hid logs "failed to set report" and "Response timed out").
# iptsd's udev rule runs iptsd-check-device against the silent pad, gets no
# answer and does not ask for iptsd again, so the pad stays in its mouse mode.
# Re-running the rule once the pad answers starts iptsd.

touchpad_id="045E:0C77"

touchpad_hidraw() {
  local node
  for node in /sys/class/hidraw/hidraw*; do
    if [[ $(readlink -f "$node/device") == *":$touchpad_id."* ]]; then
      echo "${node##*/}"
      return 0
    fi
  done
  return 1
}

for attempt in {1..8}; do
  sleep 5
  hidraw=$(touchpad_hidraw) || continue
  if systemctl is-active --quiet "iptsd@dev-$hidraw.service"; then
    echo "iptsd is running for the touchpad ($hidraw) after $((attempt - 1)) retries"
    exit 0
  fi
  echo "iptsd is not running for the touchpad ($hidraw); re-running its udev rule (attempt $attempt)"
  udevadm trigger --action=change "/dev/$hidraw"
done

echo "iptsd did not start for the touchpad" >&2
exit 1
