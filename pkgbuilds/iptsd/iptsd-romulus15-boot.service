# On some boots of the Surface Laptop 7 (15" and 13.8") iptsd's udev rule finds the
# touchpad not answering and never starts iptsd, so the pad stays in its mouse
# mode. This starts it once the pad answers again. See iptsd-romulus15-boot.
[Unit]
Description=Start iptsd for the touchpad after boot on the Surface Laptop 7
ConditionFirmware=|device-tree-compatible(microsoft,romulus15)
ConditionFirmware=|device-tree-compatible(microsoft,romulus13)

[Service]
# multi-user.target waits for the units it wants to start. As a oneshot this
# held it, power-profiles-daemon and graphical.target until the script ended,
# 15 s on a 13.8". With exec it counts as started once the script runs.
Type=exec
ExecStart=/usr/lib/iptsd/iptsd-romulus15-boot
