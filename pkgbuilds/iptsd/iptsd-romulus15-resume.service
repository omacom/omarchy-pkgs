# The Surface Laptop 7 15" touchpad resets during resume and comes back in its
# mouse mode. The HID device stays, so a running iptsd never notices, and only
# sets multitouch again when it starts. The delay lets the reset finish.
[Unit]
Description=Restart iptsd after resume on the Surface Laptop 7 15"
ConditionFirmware=device-tree-compatible(microsoft,romulus15)
After=suspend.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 2
ExecStart=/usr/bin/systemctl restart iptsd@*.service
