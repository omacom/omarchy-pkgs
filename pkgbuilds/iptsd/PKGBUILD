prepare() {
  # Upstream starts iptsd only on "add". A later "change" event, such as the
  # udev reload pacman runs whenever a package ships udev rules, clears the
  # device's SYSTEMD_WANTS and StopWhenUnneeded stops iptsd until the next
  # boot (linux-surface/iptsd#163). Apply the rule to every event but removal.
  sed -i 's/ACTION=="add"/ACTION!="remove"/' iptsd/etc/udev/50-iptsd.rules.in
  grep -q 'ACTION!="remove"' iptsd/etc/udev/50-iptsd.rules.in

  # The Surface Laptop 7 15"'s touchpad measures force and reports its click
  # in a report iptsd ignores, so pressing it did nothing
  # (linux-surface/iptsd#237).
  patch -d iptsd -Np1 -i ../0001-ipts-Handle-the-button-report-of-force-touchpads.patch

  # A tap on that laptop's touchscreen shifts as the finger lands and was
  # taken for a drag. This adds the PositionSlop option that
  # surface-laptop-7-15.conf turns on (linux-surface/iptsd#238).
  patch -d iptsd -Np1 -i ../0002-contacts-Add-a-position-slop-for-new-contacts.patch

  # The Surface Laptop 7 touchpad's positions jitter, so slow movements
  # stepped back and forth. This adds the position filter that
  # surface-laptop-7-touchpad.conf turns on.
  patch -d iptsd -Np1 -i ../0003-contacts-Add-a-speed-adaptive-position-filter.patch
}

build() {
  arch-meson iptsd build --wrap-mode=nofallback \
    -Ddebug_tools= -Dsample_config=false -Dwerror=false
  meson compile -C build
}

check() {
  # Upstream has no tests, so run the position slop and the position filter
  # against a few contacts.
  g++ -std=c++20 -Iiptsd/src -I/usr/include/eigen3 \
    test-position-slop.cpp -o test-position-slop
  ./test-position-slop
  g++ -std=c++20 -Iiptsd/src -I/usr/include/eigen3 \
    test-position-filter.cpp -o test-position-filter
  ./test-position-filter
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 surface-laptop-7-15.conf surface-laptop-7-13.conf -t "$pkgdir/usr/share/iptsd"
  install -Dm644 surface-laptop-7-touchpad.conf -t "$pkgdir/usr/share/iptsd"
  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.package.md"
  install -Dm644 iptsd-romulus15-resume.service -t "$pkgdir/usr/lib/systemd/system"
  install -d "$pkgdir/usr/lib/systemd/system/suspend.target.wants"
  ln -s ../iptsd-romulus15-resume.service \
    "$pkgdir/usr/lib/systemd/system/suspend.target.wants/iptsd-romulus15-resume.service"
  install -Dm755 iptsd-romulus15-boot -t "$pkgdir/usr/lib/iptsd"
  install -Dm644 iptsd-romulus15-boot.service -t "$pkgdir/usr/lib/systemd/system"
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../iptsd-romulus15-boot.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/iptsd-romulus15-boot.service"
}
