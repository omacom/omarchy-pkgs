# Maintainer: Brandon Williams <turbine.bmw@gmail.com>

# Touch and pen daemon for Surface digitizers, for the Snapdragon Surface Pro
# 11 and Surface Laptop 7. Intel Surfaces get iptsd from the linux-surface repository instead.

pkgname=iptsd
pkgver=3.1.0
pkgrel=3
pkgdesc="Userspace daemon for Surface touchscreens and pens (Intel Precise Touch & Stylus and SPI digitizers)"
arch=('aarch64')
url="https://github.com/linux-surface/iptsd"
license=('GPL-2.0-only')
depends=('fmt' 'gcc-libs' 'glibc' 'libinih' 'spdlog' 'systemd')
makedepends=('cli11' 'cmake' 'eigen' 'git' 'meson' 'microsoft-gsl' 'ninja')
options=('!debug')
_commit=a83bc1232f7096f8b33b50fdbda249cd640de670
source=("iptsd::git+https://github.com/linux-surface/iptsd.git#commit=${_commit}"
  'README.package.md'
  'iptsd-romulus15-resume.service')
sha256sums=('13b805164b0ae60901dd1f2a36ea62b661367fe6e00676d9487a0584fc6adbda'
            'f8f291ad19d3ece0e9ffde852146ea2d3bface410af79746959ed03802d30a41'
            'dd0380e4d4faa10c0cc70cbf25791e6dee7ad9df1582b17151d3a20ef9784c12')

prepare() {
  # Upstream starts iptsd only on "add". A later "change" event, such as the
  # udev reload pacman runs whenever a package ships udev rules, clears the
  # device's SYSTEMD_WANTS and StopWhenUnneeded stops iptsd until the next
  # boot (linux-surface/iptsd#163). Apply the rule to every event but removal.
  sed -i 's/ACTION=="add"/ACTION!="remove"/' iptsd/etc/udev/50-iptsd.rules.in
  grep -q 'ACTION!="remove"' iptsd/etc/udev/50-iptsd.rules.in
}

build() {
  arch-meson iptsd build --wrap-mode=nofallback \
    -Ddebug_tools= -Dsample_config=false -Dwerror=false
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.package.md"
  install -Dm644 iptsd-romulus15-resume.service -t "$pkgdir/usr/lib/systemd/system"
  install -d "$pkgdir/usr/lib/systemd/system/suspend.target.wants"
  ln -s ../iptsd-romulus15-resume.service \
    "$pkgdir/usr/lib/systemd/system/suspend.target.wants/iptsd-romulus15-resume.service"
}
