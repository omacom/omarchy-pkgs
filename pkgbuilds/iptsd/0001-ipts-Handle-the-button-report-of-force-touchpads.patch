From efc4ca7ef84dcdd0ba92fda45cede7baeb7fc4ff Mon Sep 17 00:00:00 2001
From: fidecastro <18445184+fidecastro@users.noreply.github.com>
Date: Sun, 15 Nov 2026 14:32:48 -0500
Subject: [PATCH] ipts: Handle the button report of force touchpads

The touchpad of the Surface Laptop 7 15" (045E:0C77) has no moving parts.
It measures force and decides by itself when that amounts to a click, with
a higher threshold for pressing than for releasing. It does not send the
button report (0x90). Instead, every heatmap comes with a report of type
0x96 that carries the force and the state of the button, so pressing the
touchpad did nothing while iptsd was running.

Parse that report and pass it on as a button sample.
---
 src/ipts/parser.hpp          | 28 +++++++++++++++++++++++++++
 src/ipts/protocol/button.hpp | 37 ++++++++++++++++++++++++++++++++++++
 src/ipts/protocol/report.hpp |  1 +
 3 files changed, 66 insertions(+)

diff --git a/src/ipts/parser.hpp b/src/ipts/parser.hpp
index 9489e07..6f29900 100644
--- a/src/ipts/parser.hpp
+++ b/src/ipts/parser.hpp
@@ -23,6 +23,7 @@
 
 #include <gsl/gsl>
 
+#include <algorithm>
 #include <functional>
 #include <optional>
 
@@ -234,6 +235,9 @@ private:
 		case protocol::report::Type::Button:
 			this->parse_button(sub);
 			break;
+		case protocol::report::Type::ForceButton:
+			this->parse_force_button(sub);
+			break;
 		default:
 			// TODO: Add handler for unknown data and wire up debug tools
 			break;
@@ -477,6 +481,30 @@ private:
 		if (this->on_button)
 			this->on_button(button);
 	}
+
+	/*!
+	 * Parses a button report from a touchpad that measures force.
+	 *
+	 * @param[in] reader The chunk of data allocated to the report frame.
+	 */
+	void parse_force_button(Reader &reader) const
+	{
+		// Leave reports of an unknown layout alone.
+		if (reader.size() != sizeof(protocol::button::ForceSample))
+			return;
+
+		const auto sample = reader.read<protocol::button::ForceSample>();
+
+		samples::Button button {};
+
+		button.pressure = sample.pressure;
+		button.pressure = std::min(button.pressure / protocol::button::MAX_PRESSURE, 1.0);
+
+		button.active = sample.button;
+
+		if (this->on_button)
+			this->on_button(button);
+	}
 };
 
 } // namespace iptsd::ipts
diff --git a/src/ipts/protocol/button.hpp b/src/ipts/protocol/button.hpp
index 16a27c1..5275fad 100644
--- a/src/ipts/protocol/button.hpp
+++ b/src/ipts/protocol/button.hpp
@@ -36,6 +36,43 @@ struct [[gnu::packed]] Sample {
 };
 static_assert(sizeof(Sample) == 16);
 
+/*!
+ * The state of the button on a touchpad that has no moving parts and measures force instead.
+ *
+ * Seen on the Surface Laptop 7 15" (045E:0C77), which sends one of these with every heatmap
+ * instead of the button report above. The device decides by itself when the force amounts
+ * to a click, with a higher threshold for pressing than for releasing.
+ */
+struct [[gnu::packed]] ForceSample {
+	//! How hard the user is pressing on the touchpad.
+	u16 pressure;
+
+	//! ...
+	u16 reserved1;
+
+	//! Six floating point values that rise with the force. Probably the individual sensors.
+	std::array<f32, 6> reserved2;
+
+	//! Whether any force is measured.
+	bool contact;
+
+	//! Whether the user is pressing hard enough to trigger a button press.
+	bool button;
+
+	//! How hard the user is pressing on the touchpad (follows @ref pressure closely).
+	u16 pressure2;
+
+	//! The force above which the button counts as pressed.
+	u16 press_threshold;
+
+	//! The force below which the button counts as released.
+	u16 release_threshold;
+
+	//! ...
+	std::array<u8, 12> reserved3;
+};
+static_assert(sizeof(ForceSample) == 48);
+
 } // namespace iptsd::ipts::protocol::button
 
 #endif // IPTSD_IPTS_PROTOCOL_BUTTON_HPP
diff --git a/src/ipts/protocol/report.hpp b/src/ipts/protocol/report.hpp
index ae749be..fecffb2 100644
--- a/src/ipts/protocol/report.hpp
+++ b/src/ipts/protocol/report.hpp
@@ -29,6 +29,7 @@ enum class Type : u8 {
 	DftLift = 0x63,
 
 	Button = 0x90,
+	ForceButton = 0x96,
 };
 
 /*!
-- 
2.56.1

