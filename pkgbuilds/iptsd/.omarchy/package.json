{
  "source": "local",
  "upstream": {
    "watch": {
      "github": "linux-surface/iptsd",
      "pattern": "v(?P<version>[0-9]+(?:\\.[0-9]+)*)",
      "variables": {
        "_commit": "{commit}"
      }
    }
  },
  "rebuild_on": [
    "fmt",
    "spdlog"
  ],
  "rebuilt_against": {
    "aarch64": {
      "fmt": "12.2.0-1",
      "spdlog": "1.17.0-2"
    }
  }
}
