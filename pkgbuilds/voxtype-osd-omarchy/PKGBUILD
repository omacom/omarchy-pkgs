# Maintainer: Temur Lee <temur.lee@gmail.com>

pkgname=voxtype-osd-omarchy
pkgver=0.3.1
pkgrel=1
pkgdesc="Compact audio-reactive Quickshell OSD for Voxtype, designed for Omarchy"
arch=('any')
url="https://github.com/temurlee/voxtype-osd-omarchy"
license=('MIT')
depends=('voxtype' 'quickshell' 'ttf-jetbrains-mono-nerd')
install=voxtype-osd-omarchy.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('0e871dc360282f5eb82e8c48b689903c85b79a4590e35acd15e3076576b6edfa')

package() {
  cd "$pkgname-$pkgver"

  install -Dm644 VoiceOsd.qml \
    "$pkgdir/usr/share/voxtype/osd/$pkgname/VoiceOsd.qml"
  install -Dm644 voxtype-osd.toml \
    "$pkgdir/usr/share/voxtype/osd/$pkgname/voxtype-osd.toml"
  install -Dm755 packaging/voxtype-osd-omarchy \
    "$pkgdir/usr/bin/voxtype-osd-omarchy"
  install -Dm755 scripts/osd_config.py \
    "$pkgdir/usr/lib/voxtype-osd-omarchy/osd_config.py"
  install -Dm644 README.md \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
