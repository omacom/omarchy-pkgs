post_install() {
  echo "Run 'voxtype-osd-omarchy enable' as your desktop user to activate the OSD."
}

post_upgrade() {
  echo "Restart Voxtype to load the updated OSD: systemctl --user restart voxtype.service"
}

pre_remove() {
  echo "Run 'voxtype-osd-omarchy disable' as your desktop user before removing the package."
}
