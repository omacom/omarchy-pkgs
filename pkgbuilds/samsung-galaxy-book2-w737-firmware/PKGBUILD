# Audio DSP, compute DSP, video and modem firmware for the Samsung Galaxy Book2 W737. The firmware
# only runs if it is signed for this board by Samsung, so linux-firmware cannot carry it until the
# OEM submits it. The OEM ships it in the driver bundle it publishes for the machine on Windows
# Update, whose cabinets this recipe fetches with wudrivers and unpacks without running anything.
# Each file is checked against the SHA-256 it was matched to and installed under the name the
# device tree requests, compressed with xz. The kernel tries a plain name, then .zst, then .xz, so
# once linux-firmware ships the same file, its copy is the one loaded, and the two packages never
# install the same path.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=samsung-galaxy-book2-w737-firmware
pkgver=20261116
pkgrel=1
pkgdesc='Audio DSP, compute DSP, video and modem firmware for the Samsung Galaxy Book2 W737'
arch=('aarch64')
url='https://github.com/birkskyum/wudrivers'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-sdm850-samsung-w737')
makedepends=('7zip' 'wudrivers')
options=('!strip' '!debug')
# Windows Update's links are short-lived, so wudrivers fetches a fresh one by update ID, revision and SHA-1.
DLAGENTS+=('wu::/usr/bin/wudrivers fetch %u -o %o')
source=(
  'samsung-galaxy-book2-w737-wu-200.0.4.0-qcsubsys850.cab::wu://1a2c5ce3-a607-4cb8-a591-f44bd0ee2d04/1/2e6995528154d0763c5467fd1d5d27781f0d6c69'
  'samsung-galaxy-book2-w737-wu-200.0.4.0-qcipa850.cab::wu://1a2c5ce3-a607-4cb8-a591-f44bd0ee2d04/1/7b3d16931525815e8dffbb4ae3359a57dafd6ea6'
  'samsung-galaxy-book2-w737-wu-200.0.4.0-qcdx850.cab::wu://1a2c5ce3-a607-4cb8-a591-f44bd0ee2d04/1/da7594df9670906b3016ffcb5c70283bbe66c197'
)
source+=('README.package.md')
noextract=('samsung-galaxy-book2-w737-wu-200.0.4.0-qcsubsys850.cab' 'samsung-galaxy-book2-w737-wu-200.0.4.0-qcipa850.cab' 'samsung-galaxy-book2-w737-wu-200.0.4.0-qcdx850.cab')
sha256sums=('1d0660a2fbcbb9907aa69d3199a98816ca3fc82ab44154a0259d32d0b8c8f162' '544f0b2ff642846a2bf0754600be57ef8277c4ebd9dcf72b61cb3d1f463bfec8' '949f9fa256d036d829a1429451514c4f6aa3fcb228078a36a0bc4c6d569be3f9')
sha256sums+=('SKIP')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'samsung-galaxy-book2-w737-wu-200.0.4.0-qcsubsys850.cab' 'samsung-galaxy-book2-w737-wu-200.0.4.0-qcsubsys850' 7z
  _unpack 'samsung-galaxy-book2-w737-wu-200.0.4.0-qcipa850.cab' 'samsung-galaxy-book2-w737-wu-200.0.4.0-qcipa850' 7z
  _unpack 'samsung-galaxy-book2-w737-wu-200.0.4.0-qcdx850.cab' 'samsung-galaxy-book2-w737-wu-200.0.4.0-qcdx850' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'samsung-galaxy-book2-w737-wu-200.0.4.0-qcipa850/ipa_fws.elf' "$fw"/'qcom/sdm850/samsung/w737/ipa_fws.elf'
  install -Dm644 'samsung-galaxy-book2-w737-wu-200.0.4.0-qcsubsys850/qcadsp850.mbn' "$fw"/'qcom/sdm850/samsung/w737/qcadsp850.mbn'
  install -Dm644 'samsung-galaxy-book2-w737-wu-200.0.4.0-qcsubsys850/qccdsp850.mbn' "$fw"/'qcom/sdm850/samsung/w737/qccdsp850.mbn'
  install -Dm644 'samsung-galaxy-book2-w737-wu-200.0.4.0-qcsubsys850/qcdsp1v2850.mbn' "$fw"/'qcom/sdm850/samsung/w737/qcdsp1v2850.mbn'
  install -Dm644 'samsung-galaxy-book2-w737-wu-200.0.4.0-qcsubsys850/qcdsp2850.mbn' "$fw"/'qcom/sdm850/samsung/w737/qcdsp2850.mbn'
  install -Dm644 'samsung-galaxy-book2-w737-wu-200.0.4.0-qcdx850/qcvss850.mbn' "$fw"/'qcom/sdm850/samsung/w737/qcvss850.mbn'

  # The bytes each file was matched to in the OEM's download.
  (
    cd "$fw"
    sha256sum -c --quiet <<'SUMS'
c3ebf4d6191a09d661ad3ea7c0dde823f13765c93d9d22f5d6d56f1ef670a39a  qcom/sdm850/samsung/w737/ipa_fws.elf
852a27951da525bb5988551bdcb35558750f3ef3d251d217b3a8d336d58a8254  qcom/sdm850/samsung/w737/qcadsp850.mbn
11d49daaa8cc0fe5d699185ce38a656766d0e912cbc68faa8ebb605bb7d53dee  qcom/sdm850/samsung/w737/qccdsp850.mbn
8b12520a1456112a8766e0b81c4879516ac8e1164b70184304ba103d6101e130  qcom/sdm850/samsung/w737/qcdsp1v2850.mbn
1f8a0f38cf92c393dbe5d69f7811eb5adb5e2884efc4703ec624f1cdd6b589f1  qcom/sdm850/samsung/w737/qcdsp2850.mbn
1e36a269697c9ce5115f1d78935b9433d2883ef05cd47181067f01fa9fe7964a  qcom/sdm850/samsung/w737/qcvss850.mbn
SUMS
  )

  find "$fw" -type f -exec xz -C crc32 {} +

  install -Dm644 README.package.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
