# Maintainer: Container Conrad <containerconrad26@proton.me>
#
# Firmware for Broadcom b43 chips whose ucode is not in linux-firmware.
# BCM43228 (PCI 14e4:4359, 802.11 core revision 30) binds to in-tree b43 and
# then probe fails closed without b43/ucode30_mimo.fw. The 5.100.138 cut does
# not contain that file; 6.30.163.46 does.
#
# The AUR recipe depends on linux>=3.2. linux-omarchy does not provide linux,
# so installing that recipe also pulls the stock Arch kernel. This package is
# firmware only and depends on nothing.

pkgname=b43-firmware
pkgver=6.30.163.46
pkgrel=1
pkgdesc='Firmware for Broadcom b43 wireless chips, including ucode30 for BCM43228'
arch=('any')
url='https://wireless.docs.kernel.org/en/latest/en/users/drivers/b43/developers.html'
license=('LicenseRef-Broadcom-proprietary')
makedepends=('b43-fwcutter')
conflicts=('b43-firmware-classic')
options=('!strip' '!debug' '!emptydirs')
source=("https://github.com/minios-linux/b43-firmware/releases/download/b43-firmware/broadcom-wl-${pkgver}.tar.bz2"
        'LICENSE')
sha256sums=('a07c3b6b277833c7dbe61daa511f908cd66c5e2763eb7a0859abc36cd9335c2d'
            'bf4ec999b4f7636f7c2a9eb304bea4052a936a30bdb7ef6a826de08ed995892c')

package() {
  local firmware=$pkgdir/usr/lib/firmware

  install -dm755 "$firmware"
  b43-fwcutter -w "$firmware" "$srcdir/broadcom-wl-${pkgver}.wl_apsta.o"
  chmod 755 "$firmware/b43"
  chmod 644 "$firmware/b43"/*.fw

  [[ -f $firmware/b43/ucode30_mimo.fw ]]

  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
