pkgname=klicky
pkgver=0.7.0
pkgrel=1
pkgdesc="Low-latency mechanical keyboard sounds for Linux"
arch=('x86_64')
url="https://github.com/Muneer320/klicky"
license=('MIT')
depends=('alsa-lib' 'curl' 'gcc-libs' 'glibc' 'systemd')
makedepends=('cargo')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver-source.tar.gz" 'check-stopped.sh' 'klicky-stopped.hook')
sha256sums=('7b66ba231fef19bbc0a7c09843f90e989a0b77731f9983285a7cb893cc0c1577' '57cd734c7c633d140a8c78ccce1e5c5698fbe3a4a9b7e64cc28a9b5d4d028df3' '937c7da1853e3b5a89fea09ae8c72ee49c731a26ce74b15a7100fc5a6428d0d0')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/klicky "$pkgdir/usr/bin/klicky"
  install -Dm755 "$srcdir/check-stopped.sh" "$pkgdir/usr/share/libalpm/scripts/klicky-check-stopped"
  install -Dm644 "$srcdir/klicky-stopped.hook" "$pkgdir/usr/share/libalpm/hooks/klicky-stopped.hook"
  install -Dm644 packaging/systemd/klicky-packaged.service "$pkgdir/usr/lib/systemd/user/klicky.service"
  install -Dm644 packaging/udev/70-klicky.rules "$pkgdir/usr/lib/udev/rules.d/70-klicky.rules"
  install -dm755 "$pkgdir/usr/share/klicky/sounds"
  cp -a sounds/. "$pkgdir/usr/share/klicky/sounds/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/klicky/LICENSE"
  install -Dm644 sounds/LICENSE.md "$pkgdir/usr/share/licenses/klicky/SOUND_RECORDINGS.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/klicky/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/klicky/CHANGELOG.md"
  install -Dm644 docs/klicky.1 "$pkgdir/usr/share/man/man1/klicky.1"
}
