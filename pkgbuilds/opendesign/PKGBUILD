pkgname=opendesign
pkgver=0.27.2
pkgrel=1
pkgdesc='Collaborative AI design agent workspace'
arch=('x86_64')
url='https://github.com/nexu-io/open-design'
license=('Apache-2.0')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'gcc-libs'
         'glib2' 'glibc' 'gtk3' 'hicolor-icon-theme' 'libcups' 'libdrm'
         'libx11' 'libxcb' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes'
         'libxkbcommon' 'libxrandr' 'mesa' 'nspr' 'nss' 'pango'
         'systemd-libs' 'xdg-utils' 'bash' 'git')
makedepends=('nodejs-lts-krypton' 'npm' 'pnpm' 'python')
optdepends=('poppler: PDF processing')
# Preserve the bundled Electron/Node runtimes and native module binaries.
options=('!strip' '!debug')
_srcdir="open-design-open-design-v$pkgver"
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/open-design-v$pkgver.tar.gz"
        'opendesign' 'opendesign.desktop')
sha256sums=('97aacbcff3925575ab56c738a278dfaa59ac8899256e41b5098cd9dc8ce62140'
            '80d74bdd7954a10c01000daf5ec9b5299ca8075296296bf48d8519983847e41e'
            'ba5474724e13cd29238cf01dd5034226bd367a675e2cd7f00ca72a20205280fb')

prepare() {
  cd "$_srcdir"
  export npm_config_store_dir="$srcdir/pnpm-store"
  export SHARP_IGNORE_GLOBAL_LIBVIPS=1
  export ONNXRUNTIME_NODE_INSTALL_CUDA=skip
  pnpm install --frozen-lockfile
}

build() {
  cd "$_srcdir"
  export npm_config_store_dir="$srcdir/pnpm-store"
  export SHARP_IGNORE_GLOBAL_LIBVIPS=1
  # The CPU runtime is bundled; its optional CUDA download is unavailable.
  export ONNXRUNTIME_NODE_INSTALL_CUDA=skip
  # Portable mode keeps the build machine's runtime paths out of the package.
  # The release tag is newer than upstream's workspace package.json version.
  pnpm tools-pack linux build --to dir --portable --namespace default --app-version "$pkgver"
}

package() {
  cd "$_srcdir"
  install -d "$pkgdir/opt/opendesign"
  cp -a --no-preserve=ownership \
    .tmp/tools-pack/out/linux/namespaces/default/builder/linux-unpacked/. \
    "$pkgdir/opt/opendesign/"
  # Next serves the compiled .next tree. Shipping web sources makes its config
  # try to recompute a build-time fingerprint from an absent monorepo root.
  rm -rf "$pkgdir/opt/opendesign/resources/app/node_modules/@open-design/web/"{app,src}
  chmod 4755 "$pkgdir/opt/opendesign/chrome-sandbox"
  install -Dm755 "$srcdir/opendesign" "$pkgdir/usr/bin/opendesign"
  install -Dm644 "$srcdir/opendesign.desktop" "$pkgdir/usr/share/applications/opendesign.desktop"
  install -Dm644 tools/pack/resources/linux/icon.png \
    "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/opendesign.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
