# Audio DSP, compute DSP and GPU firmware for the Acer Aspire 16 AI. The firmware only runs if it
# is signed for this board by Acer, so linux-firmware cannot carry it until the OEM submits it.
# The OEM ships it in its Windows driver download, which this recipe unpacks without running. The
# files are installed unmodified, under the names the device tree requests, and checked against
# the SHA-256 each was matched to.
#
# Generated from https://arewearmyet.com/firmware-sources.json by
# https://github.com/birkskyum/arewearmyet/blob/main/scripts/snapdragon-firmware-recipes.py;
# change the table, not this file.

pkgname=acer-aspire-16-ai-firmware
pkgver=20261102
pkgrel=1
pkgdesc='Audio DSP, compute DSP and GPU firmware for the Acer Aspire 16 AI'
arch=('aarch64')
url='https://www.acer.com/us-en/support/product-support/A16-11M'
license=('LicenseRef-proprietary')
provides=('qcom-firmware-x1p42100-acer-a16-11m')
makedepends=('7zip')
options=('!strip' '!debug')
source=(
  'acer-a16-11m-qualcomm-base-driver-0.9100.1.zip::https://global-download.acer.com/GDFiles/Driver/Base%20Driver/Base%20Driver_Qualcomm_0.9100.1_W11ARM64_A.zip?acerid=639240902299708134&Step1=&Step2=&Step3=ASPIRE%20A16-11M&OS=ALL&LC=en&BC=ACER&SC=PA_6'
  'acer-a16-11m-multimedia-driver-31.0.152.0.zip::https://global-download.acer.com/GDFiles/Driver/Base%20Driver/Base%20Driver_Qualcomm_31.0.152.0_W11ARM64_A.zip?acerid=639240900297209757&Step1=&Step2=&Step3=ASPIRE%20A16-11M&OS=ALL&LC=en&BC=ACER&SC=PA_6'
)
noextract=('acer-a16-11m-qualcomm-base-driver-0.9100.1.zip' 'acer-a16-11m-multimedia-driver-31.0.152.0.zip')
sha256sums=('a0244eb84019a5ee0fe6edb411440116b1a2b3420f8a5f587a4663050a95f91c' 'e0450e73a8c5709d5d1604bd42eba61496276809591ead1739a3c2fcf8f6da86')

# Unpack an OEM download the way it is packed: MSIs with msiextract, Lenovo's installers with
# innoextract, ASUS's installers from the 7-Zip archive appended to them, the rest with 7z.
_unpack() {
  local file=$1 dir=$2 kind=$3 offset
  rm -rf "$dir"
  mkdir -p "$dir"
  case $kind in
    msi) msiextract -C "$dir" "$file" >/dev/null ;;
    inno) innoextract -s -d "$dir" "$file" ;;
    7z-appended)
      offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$file" | head -1 | cut -d: -f1)
      [[ -n $offset ]] || { echo "no 7z archive in $file" >&2; return 1; }
      tail -c +$((offset + 1)) "$file" >"$dir.7z"
      7z x -y -o"$dir" "$dir.7z" >/dev/null
      ;;
    *) 7z x -y -o"$dir" "$file" >/dev/null ;;
  esac
}

prepare() {
  _unpack 'acer-a16-11m-qualcomm-base-driver-0.9100.1.zip' 'acer-a16-11m-qualcomm-base-driver-0.9100.1' 7z
  _unpack 'acer-a16-11m-multimedia-driver-31.0.152.0.zip' 'acer-a16-11m-multimedia-driver-31.0.152.0' 7z
}

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -Dm644 'acer-a16-11m-qualcomm-base-driver-0.9100.1/Base Driver_Qualcomm_0.9100.1_W11ARM64_(Qualcomm Base Driver)/qcsubsys_ext_adsp8380/adsp_dtbs.elf' "$fw"/'qcom/x1p42100/ACER/A16-11M/adsp_dtbs.elf'
  install -Dm644 'acer-a16-11m-qualcomm-base-driver-0.9100.1/Base Driver_Qualcomm_0.9100.1_W11ARM64_(Qualcomm Base Driver)/qcsubsys_ext_adsp8380/adspr.jsn' "$fw"/'qcom/x1p42100/ACER/A16-11M/adspr.jsn'
  install -Dm644 'acer-a16-11m-qualcomm-base-driver-0.9100.1/Base Driver_Qualcomm_0.9100.1_W11ARM64_(Qualcomm Base Driver)/qcsubsys_ext_adsp8380/adsps.jsn' "$fw"/'qcom/x1p42100/ACER/A16-11M/adsps.jsn'
  install -Dm644 'acer-a16-11m-qualcomm-base-driver-0.9100.1/Base Driver_Qualcomm_0.9100.1_W11ARM64_(Qualcomm Base Driver)/qcsubsys_ext_adsp8380/adspua.jsn' "$fw"/'qcom/x1p42100/ACER/A16-11M/adspua.jsn'
  install -Dm644 'acer-a16-11m-qualcomm-base-driver-0.9100.1/Base Driver_Qualcomm_0.9100.1_W11ARM64_(Qualcomm Base Driver)/qcsubsys_ext_adsp8380/battmgr.jsn' "$fw"/'qcom/x1p42100/ACER/A16-11M/battmgr.jsn'
  install -Dm644 'acer-a16-11m-qualcomm-base-driver-0.9100.1/Base Driver_Qualcomm_0.9100.1_W11ARM64_(Qualcomm Base Driver)/qcnspmcdm_ext_cdsp8380/cdsp_dtbs.elf' "$fw"/'qcom/x1p42100/ACER/A16-11M/cdsp_dtbs.elf'
  install -Dm644 'acer-a16-11m-qualcomm-base-driver-0.9100.1/Base Driver_Qualcomm_0.9100.1_W11ARM64_(Qualcomm Base Driver)/qcnspmcdm_ext_cdsp8380/cdspr.jsn' "$fw"/'qcom/x1p42100/ACER/A16-11M/cdspr.jsn'
