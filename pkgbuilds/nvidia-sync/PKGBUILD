pkgname=nvidia-sync
pkgver=0.117.3_12
pkgrel=1
pkgdesc='Connect to NVIDIA DGX Spark over SSH and launch development tools'
arch=('x86_64' 'aarch64')
url='https://build.nvidia.com/spark/connect-to-your-spark/sync'
license=('LicenseRef-NVIDIA')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gcc-libs'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libnotify'
  'libsecret'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'libxss'
  'libxtst'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'util-linux-libs'
  'xdg-terminal-exec'
  'xdg-utils'
)
optdepends=(
  'libappindicator-gtk3: system tray integration'
  'org.freedesktop.secrets: store credentials in a system keyring'
  'xorg-xwayland: run the upstream X11 launcher on Wayland'
)
makedepends=('libarchive')
options=('!debug' '!strip')

_debver="${pkgver/_/-}"
_revision=3798
_base='https://workbench.download.nvidia.com/stable'
_pool="${_base}/linux/debian/pool/proprietary/n/nvidia-sync"
source=(
  'NVIDIA-Software-License-Agreement.md'
  'NVIDIA-AI-Product-Terms.md'
  "nvidia-sync-${_debver}-NOTICES::${_base}/nvidia-sync/${_debver}/NOTICES"
)
source_x86_64=("${_pool}/nvidia-sync_${_debver}_amd64.deb")
source_aarch64=("${_pool}/nvidia-sync_${_debver}_arm64.deb")
noextract=("nvidia-sync_${_debver}_amd64.deb" "nvidia-sync_${_debver}_arm64.deb")
sha256sums=('0adc8ee18709ad61494f177305083d0d26d0d8cf9b4454b8228406ae419eb292' 'e1f70a5b433d00637f488140b487e8c6084309e979e5842d3df13cbc89914745'
            '29568dc6add59693fbf9636d756fb6e060ec49cdadef9a1d4d4c3a41b470cd48')
sha256sums_x86_64=('a227570a55de92827b40e13782d4a074c6bd0a4a31d9b84c0fd7bf943f86a92f')
sha256sums_aarch64=('acfaeb97fa8ff91b44603ee91ca705e6ba8d256ce7372fbcb2a52054fed7ad40')

package() {
  local debarch
  case "$CARCH" in
    x86_64) debarch=amd64 ;;
    aarch64) debarch=arm64 ;;
  esac

  bsdtar -xOf "${srcdir}/nvidia-sync_${_debver}_${debarch}.deb" data.tar.xz |
    bsdtar --no-same-owner -xf - -C "$pkgdir"

  # Some upstream assets are world-writable; installed files must not be.
  chmod -R go-w "$pkgdir"

  install -d "$pkgdir/usr/bin"
  ln -s '/opt/NVIDIA Sync/nvidia-sync' "$pkgdir/usr/bin/nvidia-sync"

  # Arch kernels support Chromium's user-namespace sandbox.
  chmod 755 "$pkgdir/opt/NVIDIA Sync/chrome-sandbox"

  local licenses="$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 "$srcdir/NVIDIA-Software-License-Agreement.md" "$licenses/NVIDIA-Software-License-Agreement.md"
  install -Dm644 "$srcdir/NVIDIA-AI-Product-Terms.md" "$licenses/NVIDIA-AI-Product-Terms.md"
  install -Dm644 "$srcdir/nvidia-sync-${_debver}-NOTICES" "$licenses/NOTICES"
  install -Dm644 "$pkgdir/opt/NVIDIA Sync/LICENSE.electron.txt" "$licenses/LICENSE.electron.txt"
  install -Dm644 "$pkgdir/opt/NVIDIA Sync/LICENSES.chromium.html" "$licenses/LICENSES.chromium.html"
}
