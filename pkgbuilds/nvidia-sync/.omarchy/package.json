{
  "source": "local",
  "upstream": {
    "watch": {
      "debian": "https://workbench.download.nvidia.com/stable/linux/debian/dists/default/proprietary/binary-arm64/Packages",
      "package": "nvidia-sync",
      "pattern": "(?P<version>[0-9]+(?:\\.[0-9]+)*)~(?P<build>[0-9]+)-(?P<revision>[0-9]+)",
      "version": "{version}_{build}",
      "variables": { "_revision": "{revision}" },
      "revision": "{revision}",
      "revision_variable": "_revision",
      "mutable_sources": ["source:2", "source_x86_64:0", "source_aarch64:0"]
    }
  }
}
