# Maintainer: Kira35s <https://github.com/Kira35s>

pkgname=zap-iptv
pkgver=0.1.0
pkgrel=1
pkgdesc='IPTV player: live TV with its guide, movies and series from Xtream Codes and M3U'
arch=('x86_64' 'aarch64')
url='https://github.com/Kira35s/Zap'
license=('MIT')
install='zap-iptv.install'
options=('!debug')
depends=(
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-multimedia'
  'qt6-multimedia-ffmpeg'
  'qt6-wayland'
  'zlib'
)
optdepends=('mpv: open a stream in mpv')
makedepends=('gcc' 'make')
conflicts=('zap')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('d4161c2f8b73db12dbd8d1b6431b086b7595c9486a73824e9c55873808ef1315')

build() {
  cd "$srcdir/Zap-$pkgver"
  ./bin/build
}

package() {
  cd "$srcdir/Zap-$pkgver"

  install -Dm755 build/zap "$pkgdir/usr/bin/zap"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/zap.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/zap.svg"
  install -Dm644 pkgbuild/zap.desktop "$pkgdir/usr/share/applications/zap.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
